        <Item class="ModuleScript" referent="116">
          <Properties>
            <string name="Name">CloudLayerController</string>
            <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared", 10)
if not Shared then
	error("[CloudLayerController] Shared not found")
end

local CloudConfig = require(Shared:WaitForChild("CloudConfig"))

local CloudLayerController = {}

local initialized = false
local container: Folder? = nil
local containerConnections: { RBXScriptConnection } = {}
local workspaceConnections: { RBXScriptConnection } = {}
local animatedTextures: { [Texture]: { baseU: number, baseV: number, speedU: number, speedV: number, wrapU: number, wrapV: number } } = {}
local elapsedTime = 0

local function disconnectConnections(connections)
	for _, connection in ipairs(connections) do
		connection:Disconnect()
	end
	table.clear(connections)
end

local function wrapOffset(value: number, wrapAmount: number): number
	if wrapAmount <= 0 then
		return value
	end
	local wrapped = value % wrapAmount
	if wrapped < 0 then
		wrapped += wrapAmount
	end
	return wrapped
end

local function unregisterTexture(descendant: Instance)
	if descendant:IsA("Texture") then
		animatedTextures[descendant] = nil
	end
end

local function applyTextureOffset(texture: Texture, data, elapsed: number)
	texture.OffsetStudsU = wrapOffset(data.baseU + elapsed * data.speedU, data.wrapU)
	texture.OffsetStudsV = wrapOffset(data.baseV + elapsed * data.speedV, data.wrapV)
end

local function registerTexture(descendant: Instance)
	if not descendant:IsA("Texture") then
		return
	end
	if descendant:GetAttribute("CloudAnimated") ~= true then
		return
	end

	animatedTextures[descendant] = {
		baseU = tonumber(descendant:GetAttribute("BaseOffsetU")) or descendant.OffsetStudsU,
		baseV = tonumber(descendant:GetAttribute("BaseOffsetV")) or descendant.OffsetStudsV,
		speedU = tonumber(descendant:GetAttribute("ScrollSpeedU")) or 0,
		speedV = tonumber(descendant:GetAttribute("ScrollSpeedV")) or 0,
		wrapU = tonumber(descendant:GetAttribute("WrapU")) or descendant.StudsPerTileU,
		wrapV = tonumber(descendant:GetAttribute("WrapV")) or descendant.StudsPerTileV,
	}

	applyTextureOffset(descendant, animatedTextures[descendant], elapsedTime)
end

local function bindContainer(nextContainer: Instance?)
	if container == nextContainer then
		return
	end

	container = nil
	table.clear(animatedTextures)
	disconnectConnections(containerConnections)

	if not nextContainer or not nextContainer:IsA("Folder") then
		return
	end

	container = nextContainer
	for _, descendant in ipairs(nextContainer:GetDescendants()) do
		registerTexture(descendant)
	end

	table.insert(containerConnections, nextContainer.DescendantAdded:Connect(registerTexture))
	table.insert(containerConnections, nextContainer.DescendantRemoving:Connect(unregisterTexture))
end

local function trackWorkspaceContainer()
	local existing = Workspace:FindFirstChild(CloudConfig.ContainerName)
	if existing then
		bindContainer(existing)
	end

	table.insert(workspaceConnections, Workspace.ChildAdded:Connect(function(child)
		if child.Name == CloudConfig.ContainerName then
			bindContainer(child)
		end
	end))

	table.insert(workspaceConnections, Workspace.ChildRemoved:Connect(function(child)
		if child == container then
			bindContainer(nil)
		end
	end))
end

function CloudLayerController.Init()
	if initialized or not CloudConfig.Enabled then
		return
	end
	initialized = true
	elapsedTime = 0

	trackWorkspaceContainer()

	task.spawn(function()
		while initialized do
			local dt = task.wait(CloudConfig.UpdateInterval)
			elapsedTime += dt
			for texture, data in pairs(animatedTextures) do
				if texture.Parent then
					applyTextureOffset(texture, data, elapsedTime)
				else
					animatedTextures[texture] = nil
				end
			end
		end
	end)
end

function CloudLayerController.Destroy()
	initialized = false
	container = nil
	elapsedTime = 0
	table.clear(animatedTextures)
	disconnectConnections(containerConnections)
	disconnectConnections(workspaceConnections)
end

return CloudLayerController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="117">
          <Properties>
            <string name="Name">CoinPickupController</string>
            <string name="Source"><![CDATA[--[[
	CoinPickupController
	Client-side hover + rotation animation for round coins.

	Reuses the SAME animation constants as BrainrotPickupController
	(BOB_AMPLITUDE, BOB_SPEED, ROTATION_SPEED) so coins hover and
	spin identically to brainrot pickups.

	Watches Workspace.RoundCoins for children with a "CoinValue" attribute.

	API:
		Init()
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace  = game:GetService("Workspace")

local SoundUtil = require(script.Parent:WaitForChild("UI"):WaitForChild("SoundUtil"))

local CoinPickupController = {}

local initialized = false

local FOLDER_NAME     = "RoundCoins"
local COLLECT_REMOTE_NAME = "RoundCoinCollected"
local BOB_AMPLITUDE   = 0.4
local BOB_SPEED       = 2.5
local ROTATION_SPEED  = 25

local activeAnimations = {}
local collectRemoteConnected = false

local function startAnimation(model)
	if activeAnimations[model] then return end

	local allParts = {}
	if model:IsA("BasePart") then
		table.insert(allParts, model)
	else
		for _, desc in ipairs(model:GetDescendants()) do
			if desc:IsA("BasePart") then
				table.insert(allParts, desc)
			end
		end
	end

	if #allParts == 0 then return end

	local refPart = allParts[1]
	local refCF = refPart.CFrame
	local refInv = refCF:Inverse()

	local relatives = {}
	for _, part in ipairs(allParts) do
		relatives[part] = refInv * part.CFrame
	end

	local basePos = refCF.Position
	local baseTilt = refCF.Rotation

	local startTime = tick()

	local conn = RunService.Heartbeat:Connect(function()
		if not model or not model.Parent then return end

		local elapsed = tick() - startTime
		local bobY = math.sin(elapsed * BOB_SPEED) * BOB_AMPLITUDE
		local rotAngle = elapsed * ROTATION_SPEED

		local newRefCF = CFrame.new(basePos + Vector3.new(0, bobY, 0))
			* CFrame.Angles(0, math.rad(rotAngle), 0)
			* baseTilt

		for _, part in ipairs(allParts) do
			if part and part.Parent then
				part.CFrame = newRefCF * relatives[part]
			end
		end
	end)

	activeAnimations[model] = {
		connection = conn,
		startTime = startTime,
	}
end

local function stopAnimation(model)
	local anim = activeAnimations[model]
	if anim then
		if anim.connection and anim.connection.Connected then
			anim.connection:Disconnect()
		end
		activeAnimations[model] = nil
	end
end

local function onModelAdded(model)
	if not model:GetAttribute("CoinValue") then return end
	task.defer(function()
		if model and model.Parent then
			startAnimation(model)
		end
	end)
end

local function onModelRemoved(model)
	stopAnimation(model)
end

local function watchFolder(folder)
	for _, child in ipairs(folder:GetChildren()) do
		onModelAdded(child)
	end
	folder.ChildAdded:Connect(onModelAdded)
	folder.ChildRemoved:Connect(onModelRemoved)
end

local function connectCollectRemote()
	if collectRemoteConnected then
		return
	end

	local remotes = ReplicatedStorage:WaitForChild("Remotes", 15)
	if not remotes then
		warn("[CoinPickupController] Remotes folder not found for pickup audio")
		return
	end

	local remote = remotes:WaitForChild(COLLECT_REMOTE_NAME, 15)
	if not remote or not remote:IsA("RemoteEvent") then
		warn("[CoinPickupController] Round coin collect remote missing")
		return
	end

	collectRemoteConnected = true
	remote.OnClientEvent:Connect(function()
		SoundUtil.CoinCollectPrimary()
	end)
	print("[CoinPickupController] Connected pickup audio remote")
end

function CoinPickupController.Init()
	if initialized then return end
	initialized = true
	SoundUtil.Init()

	task.spawn(function()
		connectCollectRemote()

		local folder = Workspace:FindFirstChild(FOLDER_NAME)
		if folder then
			watchFolder(folder)
			print("[CoinPickup] Watching folder")
		end

		Workspace.ChildAdded:Connect(function(child)
			if child.Name == FOLDER_NAME and child:IsA("Folder") then
				watchFolder(child)
				print("[CoinPickup] Folder appeared — watching")
			end
		end)
	end)

	print("[CoinPickupController] Initialized")
end

return CoinPickupController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="118">
          <Properties>
            <string name="Name">EffectsController</string>
            <string name="Source"><![CDATA[--[[
	EffectsController
	Client-only match impact visuals:
	  - Camera shake
	  - Screen flash
	  - Elimination burst
	  - Round start text
]]

local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local EffectsConfig = require(Shared:WaitForChild("EffectsConfig"))
local MatchState = require(Shared:WaitForChild("MatchState"))
local PlayerState = require(Shared:WaitForChild("PlayerState"))

local LocalPlayer = Players.LocalPlayer
local randomGenerator = Random.new()

type ShakeSpec = {
	Intensity: number,
	Frequency: number,
	Duration: number?,
	AttackTime: number?,
	HoldTime: number?,
	DecayTime: number?,
	Sustain: boolean?,
}

type ActiveShake = {
	StartedAt: number,
	Intensity: number,
	Frequency: number,
	AttackTime: number,
	HoldTime: number,
	DecayTime: number,
	Sustain: boolean,
	MaxDuration: number,
	ReleaseAt: number?,
	ExpiresAt: number?,
	Id: string?,
	SeedX: number,
	SeedY: number,
	SeedZ: number,
}

local EffectsController = {}

local initialized = false
local effectsGui: ScreenGui? = nil
local flashFrame: Frame? = nil
local roundLabel: TextLabel? = nil
local roundLabelStroke: UIStroke? = nil
local roundLabelScale: UIScale? = nil

local matchStateValue: StringValue? = nil
local roundValue: IntValue? = nil
local roundPhaseValue: StringValue? = nil
local killFeedEvent: RemoteEvent? = nil

local activeShakes: { ActiveShake } = {}
local namedShakes: { [string]: ActiveShake } = {}
local shakeRenderBound = false
local roundBannerToken = 0
local flashToken = 0
local lastRoundAnnouncementRound = 0
local lastObservedRound = 0
local lastBeamPreStrikeRound = 0
local lastBeamStrikeRound = 0
local lastBeamDecayRound = 0
local recentEliminationTimes: { [string]: number } = {}
local playerConnections: { [Player]: { RBXScriptConnection } } = {}
local humanoidConnections: { [Player]: RBXScriptConnection } = {}
local eliminationSignalsBound = false
local killFeedRemoteBound = false

local BEAM_PRE_STRIKE_SHAKE_ID = "BeamPreStrikeRumble"

local function log(message: string)
	if EffectsConfig.DebugLogs then
		print("[EffectsController] " .. message)
	end
end

local function getRoundScale(roundNumber: number): number
	local scaling = EffectsConfig.RoundScaling
	if roundNumber <= scaling.LightRoundsMax then
		return scaling.LightMultiplier
	end
	if roundNumber <= scaling.MediumRoundsMax then
		return scaling.MediumMultiplier
	end
	return math.min(scaling.LateMultiplier, scaling.MaxMultiplier or scaling.LateMultiplier)
end

local function getCurrentRound(): number
	return if roundValue then roundValue.Value else 0
end

local function isEligibleForEffects(): boolean
	if LocalPlayer:GetAttribute("PlayerState") ~= PlayerState.States.InMatch then
		return false
	end
	if matchStateValue and matchStateValue.Value ~= MatchState.States.Playing then
		return false
	end
	return true
end

local function stopShakeRenderStep()
	if not shakeRenderBound then
		return
	end
	RunService:UnbindFromRenderStep(EffectsConfig.CameraShake.RenderStepName)
	shakeRenderBound = false
end

local function clearShakes()
	table.clear(activeShakes)
	table.clear(namedShakes)
	stopShakeRenderStep()
end

local function unregisterNamedShake(shake: ActiveShake)
	if shake.Id and namedShakes[shake.Id] == shake then
		namedShakes[shake.Id] = nil
	end
end

local function removeShakeAt(index: number)
	local shake = activeShakes[index]
	if not shake then
		return
	end

	unregisterNamedShake(shake)
	table.remove(activeShakes, index)
end

local function getAttackEnvelope(age: number, attackTime: number): number
	if attackTime <= 0 then
		return 1
	end
	return math.clamp(age / attackTime, 0, 1)
end

local function releaseShake(shake: ActiveShake, releaseAt: number)
	if shake.ReleaseAt then
		return
	end

	shake.ReleaseAt = releaseAt
	shake.ExpiresAt = releaseAt + shake.DecayTime
end

local function maybeAutoReleaseShake(shake: ActiveShake, now: number)
	if not shake.Sustain or shake.ReleaseAt or shake.MaxDuration <= 0 then
		return
	end

	local releaseAt = shake.StartedAt + shake.MaxDuration
	if now >= releaseAt then
		releaseShake(shake, releaseAt)
	end
end

local function computeShakeEnvelope(shake: ActiveShake, now: number): number
	maybeAutoReleaseShake(shake, now)

	local age = now - shake.StartedAt
	if age <= 0 then
		return 0
	end

	if shake.Sustain then
		if shake.ReleaseAt then
			local releaseLevel = getAttackEnvelope(shake.ReleaseAt - shake.StartedAt, shake.AttackTime)
			if shake.DecayTime <= 0 then
				return 0
			end
			local releaseAge = math.max(0, now - shake.ReleaseAt)
			local decayAlpha = math.clamp(releaseAge / shake.DecayTime, 0, 1)
			return releaseLevel * (1 - decayAlpha) * (1 - decayAlpha)
		end

		return getAttackEnvelope(age, shake.AttackTime)
	end

	if age < shake.AttackTime then
		return getAttackEnvelope(age, shake.AttackTime)
	end

	local holdEnd = shake.AttackTime + shake.HoldTime
	if age < holdEnd then
		return 1
	end

	if shake.DecayTime <= 0 then
		return 0
	end

	local decayAge = age - holdEnd
	local decayAlpha = math.clamp(decayAge / shake.DecayTime, 0, 1)
	return (1 - decayAlpha) * (1 - decayAlpha)
end

local function pruneExpiredShakes(now: number)
	for index = #activeShakes, 1, -1 do
		local shake = activeShakes[index]
		maybeAutoReleaseShake(shake, now)

		local expired = false
		if shake.Sustain then
			expired = shake.ExpiresAt ~= nil and now >= shake.ExpiresAt
		else
			expired = now >= (shake.StartedAt + shake.AttackTime + shake.HoldTime + shake.DecayTime)
		end

		if expired then
			removeShakeAt(index)
		end
	end
end

local function computeShakeOffset(now: number): Vector3
	local cameraShakeConfig = EffectsConfig.CameraShake
	local offset = Vector3.zero
	for _, shake in ipairs(activeShakes) do
		local age = now - shake.StartedAt
		local envelope = computeShakeEnvelope(shake, now)
		if envelope <= 0 then
			continue
		end

		local sampleTime = age * shake.Frequency

		local x = math.noise(shake.SeedX, sampleTime, 0) * 2
		local y = math.noise(shake.SeedY, 0, sampleTime) * 2
		local z = math.noise(shake.SeedZ, sampleTime, shake.SeedX) * 2 * cameraShakeConfig.DepthMultiplier

		offset += Vector3.new(x, y, z) * shake.Intensity * envelope
	end

	local maxOffset = cameraShakeConfig.MaxOffsetStuds
	local maxDepth = maxOffset * cameraShakeConfig.DepthMultiplier
	return Vector3.new(
		math.clamp(offset.X, -maxOffset, maxOffset),
		math.clamp(offset.Y, -maxOffset, maxOffset),
		math.clamp(offset.Z, -maxDepth, maxDepth)
	)
end

local function ensureShakeRenderStep()
	if shakeRenderBound then
		return
	end

	shakeRenderBound = true

	-- Bind after the default Roblox camera update so each offset applies to the fresh camera pose.
	RunService:BindToRenderStep(EffectsConfig.CameraShake.RenderStepName, Enum.RenderPriority.Camera.Value + 1, function()
		if not isEligibleForEffects() then
			clearShakes()
			return
		end

		local now = os.clock()
		pruneExpiredShakes(now)
		if #activeShakes == 0 then
			stopShakeRenderStep()
			return
		end

		local camera = Workspace.CurrentCamera
		if not camera then
			return
		end

		local offset = computeShakeOffset(now)
		camera.CFrame = camera.CFrame * CFrame.new(offset)
	end)
end

local function addShake(baseShake: ShakeSpec, roundNumber: number, shakeId: string?)
	local scale = getRoundScale(roundNumber)
	local cameraShakeConfig = EffectsConfig.CameraShake
	local intensity = math.min(baseShake.Intensity * scale, cameraShakeConfig.MaxPerShakeIntensity)
	local attackTime = math.max(0, (baseShake.AttackTime or cameraShakeConfig.DefaultAttackTime or 0) * scale)
	local decayTime = math.max(0, (baseShake.DecayTime or cameraShakeConfig.DefaultDecayTime or cameraShakeConfig.MinDuration) * scale)
	local isSustain = baseShake.Sustain == true
	local holdTime = 0
	local maxDuration = 0

	if isSustain then
		maxDuration = math.clamp(
			(baseShake.Duration or cameraShakeConfig.MaxSustainDuration) * scale,
			cameraShakeConfig.MinDuration,
			cameraShakeConfig.MaxSustainDuration
		)
	else
		if baseShake.HoldTime ~= nil then
			holdTime = math.max(0, baseShake.HoldTime * scale)
		else
			local requestedDuration = math.max(0, (baseShake.Duration or 0) * scale)
			holdTime = math.max(0, requestedDuration - attackTime - decayTime)
		end

		local totalDuration = attackTime + holdTime + decayTime
		if totalDuration > cameraShakeConfig.MaxPulseDuration then
			local ratio = cameraShakeConfig.MaxPulseDuration / totalDuration
			attackTime *= ratio
			holdTime *= ratio
			decayTime *= ratio
			totalDuration = cameraShakeConfig.MaxPulseDuration
		end
		if totalDuration < cameraShakeConfig.MinDuration then
			decayTime += (cameraShakeConfig.MinDuration - totalDuration)
		end
	end

	if shakeId then
		local existing = namedShakes[shakeId]
		if existing then
			releaseShake(existing, os.clock())
		end
	end

	local activeShake: ActiveShake = {
		StartedAt = os.clock(),
		Intensity = intensity,
		Frequency = baseShake.Frequency,
		AttackTime = attackTime,
		HoldTime = holdTime,
		DecayTime = decayTime,
		Sustain = isSustain,
		MaxDuration = maxDuration,
		ReleaseAt = nil,
		ExpiresAt = nil,
		Id = shakeId,
		SeedX = randomGenerator:NextNumber(0, 256),
		SeedY = randomGenerator:NextNumber(256, 512),
		SeedZ = randomGenerator:NextNumber(512, 768),
	}

	table.insert(activeShakes, activeShake)
	if shakeId then
		namedShakes[shakeId] = activeShake
	end

	while #activeShakes > cameraShakeConfig.MaxSimultaneous do
		removeShakeAt(1)
	end

	ensureShakeRenderStep()
end

local function releaseNamedShake(shakeId: string)
	local shake = namedShakes[shakeId]
	if not shake then
		return
	end

	releaseShake(shake, os.clock())
	ensureShakeRenderStep()
end

local function playFlash(flashSpec, roundNumber: number)
	if not flashFrame then
		return
	end

	local scale = getRoundScale(roundNumber)
	flashToken += 1
	local token = flashToken

	flashFrame.Visible = true
	flashFrame.BackgroundColor3 = flashSpec.Color
	flashFrame.BackgroundTransparency = math.max(
		flashSpec.MinimumTransparency or 0,
		1 - (flashSpec.Intensity * scale)
	)

	local flashTween = TweenService:Create(
		flashFrame,
		TweenInfo.new(flashSpec.FadeOutTime, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ BackgroundTransparency = 1 }
	)
	flashTween:Play()

	task.spawn(function()
		flashTween.Completed:Wait()
		if flashFrame and token == flashToken then
			flashFrame.Visible = false
		end
	end)
end

local function showRoundBanner(roundNumber: number)
	if not roundLabel or not roundLabelStroke or not roundLabelScale then
		return
	end

	local roundTextConfig = EffectsConfig.RoundText
	local scale = getRoundScale(roundNumber)
	local scaleBoost = 1 + ((scale - 1) * 0.45)

	roundBannerToken += 1
	local token = roundBannerToken

	roundLabel.Visible = true
	roundLabel.Text = string.format("ROUND %d", roundNumber)
	roundLabel.TextTransparency = 1
	roundLabelStroke.Transparency = 1
	roundLabelScale.Scale = roundTextConfig.StartScale * scaleBoost

	local fadeInTween = TweenService:Create(
		roundLabel,
		TweenInfo.new(roundTextConfig.FadeInTime, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ TextTransparency = 0 }
	)
	local strokeInTween = TweenService:Create(
		roundLabelStroke,
		TweenInfo.new(roundTextConfig.FadeInTime, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ Transparency = 0.08 }
	)
	local scaleInTween = TweenService:Create(
		roundLabelScale,
		TweenInfo.new(roundTextConfig.FadeInTime, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
		{ Scale = roundTextConfig.EndScale * scaleBoost }
	)
	fadeInTween:Play()
	strokeInTween:Play()
	scaleInTween:Play()

	task.spawn(function()
		task.wait(roundTextConfig.FadeInTime + roundTextConfig.HoldTime)
		if token ~= roundBannerToken or not roundLabel or not roundLabelStroke or not roundLabelScale then
			return
		end

		local fadeOutTween = TweenService:Create(
			roundLabel,
			TweenInfo.new(roundTextConfig.FadeOutTime, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
			{ TextTransparency = 1 }
		)
		local strokeOutTween = TweenService:Create(
			roundLabelStroke,
			TweenInfo.new(roundTextConfig.FadeOutTime, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
			{ Transparency = 1 }
		)
		local scaleOutTween = TweenService:Create(
			roundLabelScale,
			TweenInfo.new(roundTextConfig.FadeOutTime, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
			{ Scale = roundTextConfig.ExitScale * scaleBoost }
		)
		fadeOutTween:Play()
		strokeOutTween:Play()
		scaleOutTween:Play()

		task.wait(roundTextConfig.FadeOutTime + 0.03)
		if token == roundBannerToken and roundLabel then
			roundLabel.Visible = false
		end
	end)
end

local function getEffectsFolder(): Folder
	local existing = Workspace:FindFirstChild("ClientEffects")
	if existing and existing:IsA("Folder") then
		return existing
	end

	local folder = Instance.new("Folder")
	folder.Name = "ClientEffects"
	folder.Parent = Workspace
	return folder
end

local function resolveCharacterPosition(player: Player?): Vector3?
	if not player or not player.Character then
		return nil
	end

	local rootPart = player.Character:FindFirstChild("HumanoidRootPart")
	if rootPart and rootPart:IsA("BasePart") then
		return rootPart.Position
	end

	local primaryPart = player.Character.PrimaryPart
	if primaryPart then
		return primaryPart.Position
	end

	local fallbackPart = player.Character:FindFirstChildWhichIsA("BasePart")
	return if fallbackPart then fallbackPart.Position else nil
end

local function spawnEliminationBurst(position: Vector3, roundNumber: number)
	local burstConfig = EffectsConfig.EliminationBurst
	local scale = getRoundScale(roundNumber)
	local emitCount = math.clamp(
		math.floor((burstConfig.EmitCount * scale) + 0.5),
		burstConfig.MinEmitCount,
		burstConfig.MaxEmitCount
	)

	local anchor = Instance.new("Part")
	anchor.Name = "EliminationBurstAnchor"
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.CanTouch = false
	anchor.Transparency = 1
	anchor.Size = Vector3.new(0.2, 0.2, 0.2)
	anchor.CFrame = CFrame.new(position)
	anchor.Parent = getEffectsFolder()

	local attachment = Instance.new("Attachment")
	attachment.Parent = anchor

	local emitter = Instance.new("ParticleEmitter")
	emitter.Name = "EliminationBurst"
	emitter.Texture = burstConfig.Texture
	emitter.Color = ColorSequence.new(burstConfig.ColorStart, burstConfig.ColorEnd)
	emitter.LightEmission = burstConfig.LightEmission
	emitter.LightInfluence = burstConfig.LightInfluence
	emitter.Brightness = burstConfig.Brightness
	emitter.Lifetime = NumberRange.new(burstConfig.LifetimeMin, burstConfig.LifetimeMax)
	emitter.Speed = NumberRange.new(burstConfig.SpeedMin * scale, burstConfig.SpeedMax * scale)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Acceleration = Vector3.new(0, -12, 0)
	emitter.Drag = burstConfig.Drag
	emitter.Rate = 0
	emitter.LockedToPart = true
	emitter.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, burstConfig.SizeStart),
		NumberSequenceKeypoint.new(0.45, burstConfig.SizeMid),
		NumberSequenceKeypoint.new(1, 0),
	})
	emitter.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0),
		NumberSequenceKeypoint.new(0.6, 0.18),
		NumberSequenceKeypoint.new(1, 1),
	})
	emitter.Parent = attachment
	emitter:Emit(emitCount)

	Debris:AddItem(anchor, burstConfig.CleanupSeconds)
end

local function shouldSuppressEliminationEffect(effectKey: string): boolean
	local now = os.clock()
	local lastTriggeredAt = recentEliminationTimes[effectKey]
	if lastTriggeredAt and (now - lastTriggeredAt) < EffectsConfig.EliminationWindowSeconds then
		return true
	end

	recentEliminationTimes[effectKey] = now
	return false
end

local function triggerBeamPreStrikeEffect(roundNumber: number, triggerSource: string)
	if not isEligibleForEffects() then
		return
	end

	addShake(EffectsConfig.CameraShake.BeamPreStrike, roundNumber, BEAM_PRE_STRIKE_SHAKE_ID)
	log(string.format(
		"beam pre-strike rumble start round=%d phase=BeamWarning trigger=%s scale=%.2f",
		roundNumber,
		triggerSource,
		getRoundScale(roundNumber)
	))
end

local function triggerBeamStrikeEffect(roundNumber: number, triggerSource: string)
	if not isEligibleForEffects() then
		return
	end

	releaseNamedShake(BEAM_PRE_STRIKE_SHAKE_ID)
	addShake(EffectsConfig.CameraShake.BeamStrike, roundNumber)
	playFlash(EffectsConfig.ScreenFlash.BeamStrike, roundNumber)
	log(string.format(
		"beam strike pulse start round=%d phase=Strike trigger=%s scale=%.2f",
		roundNumber,
		triggerSource,
		getRoundScale(roundNumber)
	))
end

local function triggerBeamDecayEffect(roundNumber: number, triggerSource: string)
	if not isEligibleForEffects() then
		return
	end

	addShake(EffectsConfig.CameraShake.BeamDecay, roundNumber)
	log(string.format(
		"beam decay start round=%d phase=Recovery trigger=%s scale=%.2f",
		roundNumber,
		triggerSource,
		getRoundScale(roundNumber)
	))
end

local function triggerRoundStartEffect(roundNumber: number)
	if not isEligibleForEffects() then
		return
	end

	showRoundBanner(roundNumber)
	log(string.format("round start effect round=%d scale=%.2f", roundNumber, getRoundScale(roundNumber)))
end

local function triggerEliminationEffect(player: Player?, rawReason: any, source: string, knownPosition: Vector3?)
	if not isEligibleForEffects() then
		return
	end

	local roundNumber = getCurrentRound()
	if roundNumber <= 0 then
		return
	end

	local effectKey = if player then tostring(player.UserId) else tostring(player and player.Name or rawReason or source)
	if shouldSuppressEliminationEffect(effectKey) then
		return
	end

	addShake(EffectsConfig.CameraShake.Elimination, roundNumber)

	local burstPosition = knownPosition or resolveCharacterPosition(player)
	if burstPosition then
		spawnEliminationBurst(burstPosition, roundNumber)
	end

	log(string.format(
		"elimination effect player=%s source=%s reason=%s burst=%s round=%d",
		if player then player.Name else "unknown",
		source,
		tostring(rawReason),
		tostring(burstPosition ~= nil),
		roundNumber
	))
end

local function evaluateRoundStartEffect()
	local roundNumber = getCurrentRound()
	if roundNumber <= 0 then
		lastRoundAnnouncementRound = 0
		return
	end
	if lastRoundAnnouncementRound == roundNumber then
		return
	end
	if not isEligibleForEffects() then
		return
	end

	lastRoundAnnouncementRound = roundNumber
	triggerRoundStartEffect(roundNumber)
end

local function resetBeamImpactState(clearActiveEffects: boolean)
	lastObservedRound = math.max(getCurrentRound(), 0)
	lastBeamPreStrikeRound = 0
	lastBeamStrikeRound = 0
	lastBeamDecayRound = 0
	if clearActiveEffects then
		clearShakes()
	else
		releaseNamedShake(BEAM_PRE_STRIKE_SHAKE_ID)
	end
end

local function evaluateBeamImpactEffects(triggerSource: string)
	local roundNumber = getCurrentRound()
	local phaseName = if roundPhaseValue then roundPhaseValue.Value else ""

	if roundNumber <= 0 then
		resetBeamImpactState(true)
		return
	end

	if lastObservedRound ~= roundNumber then
		resetBeamImpactState(true)
		lastObservedRound = roundNumber
	end

	if phaseName ~= "BeamWarning" then
		releaseNamedShake(BEAM_PRE_STRIKE_SHAKE_ID)
	end

	if not isEligibleForEffects() then
		return
	end

	if phaseName == "BeamWarning" and lastBeamPreStrikeRound ~= roundNumber then
		lastBeamPreStrikeRound = roundNumber
		triggerBeamPreStrikeEffect(roundNumber, triggerSource)
	end

	if phaseName == "Strike" and lastBeamStrikeRound ~= roundNumber then
		lastBeamStrikeRound = roundNumber
		triggerBeamStrikeEffect(roundNumber, triggerSource)
	end

	if phaseName == "Recovery" and lastBeamDecayRound ~= roundNumber then
		lastBeamDecayRound = roundNumber
		triggerBeamDecayEffect(roundNumber, triggerSource)
	end
end

local function createGui()
	local playerGui = LocalPlayer:WaitForChild("PlayerGui", 10)
	if not playerGui then
		return
	end

	effectsGui = Instance.new("ScreenGui")
	effectsGui.Name = "EffectsGui"
	effectsGui.ResetOnSpawn = false
	effectsGui.IgnoreGuiInset = true
	effectsGui.DisplayOrder = EffectsConfig.DisplayOrder
	effectsGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	effectsGui.Parent = playerGui

	flashFrame = Instance.new("Frame")
	flashFrame.Name = "StrikeFlash"
	flashFrame.Size = UDim2.fromScale(1, 1)
	flashFrame.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	flashFrame.BackgroundTransparency = 1
	flashFrame.BorderSizePixel = 0
	flashFrame.Visible = false
	flashFrame.ZIndex = 1
	flashFrame.Parent = effectsGui

	roundLabel = Instance.new("TextLabel")
	roundLabel.Name = "RoundImpactText"
	roundLabel.AnchorPoint = Vector2.new(0.5, 0.5)
	roundLabel.Position = UDim2.new(0.5, 0, EffectsConfig.RoundText.PositionYScale, 0)
	roundLabel.Size = UDim2.new(0.8, 0, 0, 72)
	roundLabel.BackgroundTransparency = 1
	roundLabel.Font = Enum.Font.GothamBlack
	roundLabel.Text = ""
	roundLabel.TextColor3 = EffectsConfig.RoundText.Color
	roundLabel.TextScaled = true
	roundLabel.TextTransparency = 1
	roundLabel.Visible = false
	roundLabel.ZIndex = 2
	roundLabel.Parent = effectsGui

	local sizeConstraint = Instance.new("UITextSizeConstraint")
	sizeConstraint.MaxTextSize = EffectsConfig.RoundText.MaxTextSize
	sizeConstraint.MinTextSize = EffectsConfig.RoundText.MinTextSize
	sizeConstraint.Parent = roundLabel

	roundLabelStroke = Instance.new("UIStroke")
	roundLabelStroke.Color = EffectsConfig.RoundText.StrokeColor
	roundLabelStroke.Thickness = 2.6
	roundLabelStroke.Transparency = 1
	roundLabelStroke.Parent = roundLabel

	roundLabelScale = Instance.new("UIScale")
	roundLabelScale.Scale = 1
	roundLabelScale.Parent = roundLabel
end

local function disconnectHumanoid(player: Player)
	local connection = humanoidConnections[player]
	if connection then
		connection:Disconnect()
		humanoidConnections[player] = nil
	end
end

local function wireCharacter(player: Player, character: Model)
	disconnectHumanoid(player)

	local humanoid = character:FindFirstChildOfClass("Humanoid") or character:WaitForChild("Humanoid", 5)
	if not humanoid then
		return
	end

	humanoidConnections[player] = humanoid.Died:Connect(function()
		triggerEliminationEffect(player, "HumanoidDied", "HumanoidDied", resolveCharacterPosition(player))
	end)
end

local function unwirePlayer(player: Player)
	disconnectHumanoid(player)

	local connections = playerConnections[player]
	if not connections then
		return
	end

	for _, connection in ipairs(connections) do
		connection:Disconnect()
	end
	playerConnections[player] = nil
end

local function wirePlayer(player: Player)
	unwirePlayer(player)

	local connections = {}
	table.insert(connections, player.CharacterAdded:Connect(function(character)
		wireCharacter(player, character)
	end))
	table.insert(connections, player.CharacterRemoving:Connect(function()
		disconnectHumanoid(player)
	end))

	if player.Character then
		wireCharacter(player, player.Character)
	end

	playerConnections[player] = connections
end

local function bindEliminationSignals()
	if not eliminationSignalsBound then
		eliminationSignalsBound = true
		for _, player in ipairs(Players:GetPlayers()) do
			wirePlayer(player)
		end

		Players.PlayerAdded:Connect(function(player)
			wirePlayer(player)
		end)

		Players.PlayerRemoving:Connect(function(player)
			unwirePlayer(player)
		end)
	end

	if killFeedEvent and not killFeedRemoteBound then
		killFeedRemoteBound = true
		killFeedEvent.OnClientEvent:Connect(function(playerName, rawReason)
			local victim = Players:FindFirstChild(tostring(playerName))
			triggerEliminationEffect(victim, rawReason, "KillFeedEvent", resolveCharacterPosition(victim))
		end)
	end
end

function EffectsController.Init()
	if initialized then
		return
	end
	initialized = true

	createGui()
	bindEliminationSignals()

	task.spawn(function()
		local remotes = ReplicatedStorage:WaitForChild("Remotes", 15)
		if not remotes then
			warn("[EffectsController] Remotes folder not found")
			return
		end

		local event = remotes:WaitForChild("KillFeedEvent", 10)
		if event and event:IsA("RemoteEvent") then
			killFeedEvent = event
			bindEliminationSignals()
		else
			warn("[EffectsController] KillFeedEvent not found")
		end
	end)

	task.spawn(function()
		local matchStatus = ReplicatedStorage:WaitForChild("MatchStatus", 15)
		if not matchStatus then
			warn("[EffectsController] MatchStatus not found")
			return
		end

		matchStateValue = matchStatus:WaitForChild("State", 10)
		roundValue = matchStatus:WaitForChild("Round", 10)
		roundPhaseValue = matchStatus:WaitForChild("RoundPhase", 10)

		lastRoundAnnouncementRound = math.max(getCurrentRound(), 0)
		resetBeamImpactState(false)

		if matchStateValue then
			matchStateValue.Changed:Connect(function()
				if not isEligibleForEffects() then
					clearShakes()
				end
				evaluateRoundStartEffect()
				evaluateBeamImpactEffects("MatchStateChanged")
			end)
		end

		if roundValue then
			roundValue.Changed:Connect(function()
				if roundValue.Value <= 0 then
					lastRoundAnnouncementRound = 0
					resetBeamImpactState(true)
					return
				end

				evaluateRoundStartEffect()
				evaluateBeamImpactEffects("RoundChanged")
			end)
		end

		if roundPhaseValue then
			roundPhaseValue.Changed:Connect(function()
				evaluateBeamImpactEffects("RoundPhaseChanged")
			end)
		end

		evaluateBeamImpactEffects("InitSync")
	end)

	LocalPlayer:GetAttributeChangedSignal("PlayerState"):Connect(function()
		if not isEligibleForEffects() then
			clearShakes()
		end
		evaluateRoundStartEffect()
		evaluateBeamImpactEffects("PlayerStateChanged")
	end)

	print("[EffectsController] Initialized")
end

return EffectsController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="119">
          <Properties>
            <string name="Name">FireworksController</string>
            <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")

local FireworksController = {}

local BUTTON_TO_GROUP = {
	["8"]  = "G1",
	["9"]  = "G2",
	["10"] = "G3",
	["11"] = "G4",
	["12"] = "G5",
}

local SHOW_ORDER = { "8", "9", "10", "11", "12" }
local SHOW_DELAY_MIN = 0.20
local SHOW_DELAY_MAX = 0.35
local PARTICLE_DURATION = 0.2

local fireFolder: Folder? = nil

local function getFireFolder(): Folder?
	if fireFolder then return fireFolder end
	fireFolder = workspace:FindFirstChild("firework")
	return fireFolder
end

local function TriggerFirework(patternId: string)
	local groupName = BUTTON_TO_GROUP[patternId]
	if not groupName then
		warn("[Fireworks] Unknown pattern:", patternId)
		return
	end

	local folder = getFireFolder()
	if not folder then
		warn("[Fireworks] firework folder not found")
		return
	end

	print("[Fireworks] Triggering pattern", patternId, "→", groupName)

	for _, child in ipairs(folder:GetChildren()) do
		if child.Name == groupName then
			local boom = child:FindFirstChild("boom")
			if boom and boom:IsA("Sound") then
				boom:Play()
			end

			local shot = child:FindFirstChild("Shot")
			local shot2 = child:FindFirstChild("Shot2")
			local smoke = child:FindFirstChild("Smoke")
			if shot then shot.Enabled = true end
			if shot2 then shot2.Enabled = true end
			if smoke then smoke.Enabled = true end
		end
	end

	task.delay(PARTICLE_DURATION, function()
		local f = getFireFolder()
		if not f then return end
		for _, child in ipairs(f:GetChildren()) do
			if child.Name == groupName then
				local shot = child:FindFirstChild("Shot")
				local shot2 = child:FindFirstChild("Shot2")
				local smoke = child:FindFirstChild("Smoke")
				if shot then shot.Enabled = false end
				if shot2 then shot2.Enabled = false end
				if smoke then smoke.Enabled = false end
			end
		end
	end)
end

local function playShow()
	print("[Fireworks] Starting fireworks show sequence")
	task.spawn(function()
		for i, btnName in ipairs(SHOW_ORDER) do
			TriggerFirework(btnName)
			if i < #SHOW_ORDER then
				local d = SHOW_DELAY_MIN + math.random() * (SHOW_DELAY_MAX - SHOW_DELAY_MIN)
				task.wait(d)
			end
		end
		print("[Fireworks] Show sequence complete")
	end)
end

local function connectButtons()
	local folder = getFireFolder()
	if not folder then return end

	local panel = folder:FindFirstChild("fireworkPanel")
	if not panel then return end

	local surfaceGui = panel:FindFirstChildWhichIsA("SurfaceGui")
	if not surfaceGui then return end

	local pyro1 = surfaceGui:FindFirstChild("Pyro1")
	if not pyro1 then return end

	for _, btn in ipairs(pyro1:GetChildren()) do
		if btn:IsA("TextButton") and BUTTON_TO_GROUP[btn.Name] then
			btn.MouseButton1Click:Connect(function()
				print("[Fireworks] Manual button click:", btn.Name)
				TriggerFirework(btn.Name)
			end)
		end
	end
	print("[Fireworks] Connected", #SHOW_ORDER, "Pyro1 buttons")
end

local function connectRemote()
	local remotes = ReplicatedStorage:WaitForChild("Remotes", 15)
	if not remotes then
		warn("[Fireworks] Remotes folder not found")
		return
	end

	local remote = remotes:WaitForChild("PlayFireworks", 15)
	if not remote then
		warn("[Fireworks] PlayFireworks remote not found")
		return
	end

	remote.OnClientEvent:Connect(function()
		print("[Fireworks] PlayFireworks received")

		-- Validate firework hierarchy before triggering
		local folder = workspace:FindFirstChild("firework")
		if not folder then
			warn("[Fireworks] MISSING: Workspace.firework")
			return
		end
		local panel = folder:FindFirstChild("fireworkPanel")
		if not panel then
			warn("[Fireworks] MISSING: Workspace.firework.fireworkPanel")
		end
		local surfGui = panel and panel:FindFirstChildWhichIsA("SurfaceGui")
		if panel and not surfGui then
			warn("[Fireworks] MISSING: fireworkPanel SurfaceGui")
		end
		local pyro1 = surfGui and surfGui:FindFirstChild("Pyro1")
		if surfGui and not pyro1 then
			warn("[Fireworks] MISSING: SurfaceGui.Pyro1")
		end
		if pyro1 then
			for _, name in ipairs({"8","9","10","11","12"}) do
				if not pyro1:FindFirstChild(name) then
					warn("[Fireworks] MISSING: Pyro1 button", name)
				end
			end
			print("[Fireworks] All Pyro1 buttons validated")
		end

		playShow()
	end)
	print("[Fireworks] Remote listener connected")
end

function FireworksController.Init()
	print("[Fireworks] Initializing FireworksController")
	connectButtons()
	connectRemote()
	print("[Fireworks] Init complete")
end

return FireworksController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="120">
          <Properties>
            <string name="Name">FnafIndicatorWiring</string>
            <string name="Source"><![CDATA[local FnafIndicatorWiring = {}
local initialized = false
local wireInProgress = false
local fnafPromptConn: RBXScriptConnection? = nil
local fnafPromptLastOpenAt = 0

local function getShopPanel()
	local ui = script.Parent:FindFirstChild("UI")
	if not ui then
		return nil
	end
	local shopPanelModule = ui:FindFirstChild("ShopPanel")
	if not shopPanelModule then
		return nil
	end
	local ok, result = pcall(require, shopPanelModule)
	if ok then
		return result
	end
	return nil
end

local function findBrainrotIndicator(): BillboardGui?
	for _, inst in ipairs(workspace:GetDescendants()) do
		if inst:IsA("BillboardGui") then
			local label = inst:FindFirstChild("Badge")
			label = label and label:FindFirstChild("Label")
			if label and label:IsA("TextLabel") and label.Text == "BRAINROT BUNDLE" then
				return inst
			end
		end
	end
	return nil
end

local function findBrainrotPrompt(): ProximityPrompt?
	local brainrot = workspace:FindFirstChild("Brainrot Game Bun")
	if not brainrot then
		return nil
	end
	for _, inst in ipairs(brainrot:GetDescendants()) do
		if inst:IsA("ProximityPrompt") then
			return inst
		end
	end
	return nil
end

local function findFnafModel(): Instance?
	local exact = workspace:FindFirstChild("FNAFGameBun") or workspace:FindFirstChild("FNAF Game Bun")
	if exact then
		if exact:IsA("Model") or exact:IsA("Folder") then
			return exact
		end
		local ancestorContainer = exact:FindFirstAncestorWhichIsA("Model") or exact:FindFirstAncestorWhichIsA("Folder")
		if ancestorContainer then
			return ancestorContainer
		end
	end
	for _, d in ipairs(workspace:GetDescendants()) do
		local n = string.lower(d.Name)
		if (d:IsA("Model") or d:IsA("Folder")) and string.find(n, "fnaf", 1, true) and string.find(n, "bun", 1, true) then
			return d
		end
	end
	return nil
end

local function findFnafAnchorPart(model: Instance): BasePart?
	local explicit = model:FindFirstChild("PromptPart")
	if explicit and explicit:IsA("BasePart") then
		return explicit
	end

	local preferredNames = {
		"freddyfzber",
		"freddyfazber",
		"freddyfazbear",
		"poster",
		"sign",
	}
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			local lower = string.lower(d.Name)
			for _, needle in ipairs(preferredNames) do
				if string.find(lower, needle, 1, true) then
					return d
				end
			end
		end
	end

	local poster = model:FindFirstChild("Poster")
	if poster then
		local posterPart = poster:FindFirstChildWhichIsA("BasePart", true)
		if posterPart then return posterPart end
	end

	local bestPart: BasePart? = nil
	local bestY = -math.huge
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") and d.Position.Y > bestY then
			bestY = d.Position.Y
			bestPart = d
		end
	end
	if bestPart then
		return bestPart
	end

	return model:FindFirstChildWhichIsA("BasePart", true)
end

local function createPromptPart(model: Instance): BasePart?
	local parent: Instance = model
	if not (parent:IsA("Model") or parent:IsA("Folder")) then
		local ancestorContainer = model:FindFirstAncestorWhichIsA("Model") or model:FindFirstAncestorWhichIsA("Folder")
		if ancestorContainer then
			parent = ancestorContainer
		else
			parent = workspace
		end
	end
	if not parent then
		return nil
	end

	local minX, minY, minZ = math.huge, math.huge, math.huge
	local maxX, maxY, maxZ = -math.huge, -math.huge, -math.huge
	local found = false
	local refPart: BasePart? = nil
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") and d.Transparency < 1 then
			local ln = string.lower(d.Name)
			if string.find(ln, "freddy", 1, true)
				or string.find(ln, "bonnie", 1, true)
				or string.find(ln, "chica", 1, true)
				or string.find(ln, "poster", 1, true)
				or string.find(ln, "sign", 1, true)
			then
				refPart = d
				break
			end
		end
	end
	if model:IsA("BasePart") then
		found = true
		local p = model.Position
		local h = model.Size * 0.5
		minX = math.min(minX, p.X - h.X)
		minY = math.min(minY, p.Y - h.Y)
		minZ = math.min(minZ, p.Z - h.Z)
		maxX = math.max(maxX, p.X + h.X)
		maxY = math.max(maxY, p.Y + h.Y)
		maxZ = math.max(maxZ, p.Z + h.Z)
	end
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			found = true
			local p = d.Position
			local h = d.Size * 0.5
			minX = math.min(minX, p.X - h.X)
			minY = math.min(minY, p.Y - h.Y)
			minZ = math.min(minZ, p.Z - h.Z)
			maxX = math.max(maxX, p.X + h.X)
			maxY = math.max(maxY, p.Y + h.Y)
			maxZ = math.max(maxZ, p.Z + h.Z)
		end
	end
	-- Place interaction anchor above the bundle display (head/chest readable zone).
	local origin = found and Vector3.new((minX + maxX) * 0.5, maxY + 1.5, (minZ + maxZ) * 0.5) or Vector3.new(0, 6, 0)
	if refPart then
		origin = refPart.Position + Vector3.new(0, 3.5, 0)
	end

	local promptPart = parent:FindFirstChild("PromptPart")
	local created = false
	if not (promptPart and promptPart:IsA("BasePart")) then
		promptPart = Instance.new("Part")
		promptPart.Name = "PromptPart"
		promptPart.Parent = parent
		created = true
	end
	promptPart.Name = "PromptPart"
	promptPart.Size = Vector3.new(2, 2, 2)
	promptPart.Anchored = true
	promptPart.CanCollide = false
	promptPart.CanQuery = true
	promptPart.CanTouch = false
	promptPart.Transparency = 1
	-- Keep anchor stable once created; do not keep re-positioning every rewire cycle.
	-- Reposition only when first created or currently invalid.
	if created or (promptPart.Position.X ~= promptPart.Position.X) then
		promptPart.Position = origin
	end
	return promptPart
end

local function copyPromptWiring(sourcePrompt: ProximityPrompt?, model: Instance, anchor: BasePart): ProximityPrompt?
	local targetPrompt: ProximityPrompt? = nil
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("ProximityPrompt") then
			targetPrompt = d
			break
		end
	end

	if not targetPrompt then
		if sourcePrompt then
			targetPrompt = sourcePrompt:Clone()
		else
			targetPrompt = Instance.new("ProximityPrompt")
			targetPrompt.Name = "FNAFBundlePrompt"
			targetPrompt.HoldDuration = 0
			targetPrompt.MaxActivationDistance = 10
			targetPrompt.RequiresLineOfSight = false
			targetPrompt.KeyboardKeyCode = Enum.KeyCode.E
			targetPrompt.GamepadKeyCode = Enum.KeyCode.ButtonX
			targetPrompt.Style = Enum.ProximityPromptStyle.Default
		end
	end

	if sourcePrompt then
		targetPrompt.ActionText = sourcePrompt.ActionText
		targetPrompt.ObjectText = sourcePrompt.ObjectText
		targetPrompt.HoldDuration = sourcePrompt.HoldDuration
		targetPrompt.MaxActivationDistance = sourcePrompt.MaxActivationDistance
		targetPrompt.RequiresLineOfSight = sourcePrompt.RequiresLineOfSight
		targetPrompt.KeyboardKeyCode = sourcePrompt.KeyboardKeyCode
		targetPrompt.GamepadKeyCode = sourcePrompt.GamepadKeyCode
		targetPrompt.Style = sourcePrompt.Style
	end
	targetPrompt.Enabled = true

	-- Requested text override only.
	targetPrompt.ActionText = "Buy"
	targetPrompt.ObjectText = "Animatronic Pets"
	targetPrompt.MaxActivationDistance = math.max(10, targetPrompt.MaxActivationDistance)
	targetPrompt.RequiresLineOfSight = false
	targetPrompt.HoldDuration = 0
	targetPrompt.Parent = anchor

	return targetPrompt
end

local function copyIndicatorWiring(sourceIndicator: BillboardGui?, model: Instance, anchor: BasePart): BillboardGui?
	local existing: BillboardGui? = nil
	for _, child in ipairs(model:GetDescendants()) do
		if child:IsA("BillboardGui") then
			local lbl = child:FindFirstChild("Badge")
			lbl = lbl and lbl:FindFirstChild("Label")
			if lbl and lbl:IsA("TextLabel") and lbl.Text == "Animatronic Pets" then
				existing = child
				break
			end
		end
	end

	local target = existing
	if not target then
		if sourceIndicator then
			target = sourceIndicator:Clone()
		else
			target = Instance.new("BillboardGui")
			target.Name = "FNAFBundleIndicator"
			target.Size = UDim2.fromOffset(240, 70)
			target.StudsOffset = Vector3.new(0, 3, 0)
			target.AlwaysOnTop = true
			target.LightInfluence = 0
			target.MaxDistance = 100

			local badge = Instance.new("Frame")
			badge.Name = "Badge"
			badge.Size = UDim2.fromScale(1, 1)
			badge.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
			badge.BackgroundTransparency = 0.35
			badge.BorderSizePixel = 0
			badge.Parent = target
			Instance.new("UICorner", badge).CornerRadius = UDim.new(0, 10)

			local label2 = Instance.new("TextLabel")
			label2.Name = "Label"
			label2.BackgroundTransparency = 1
			label2.Size = UDim2.fromScale(1, 1)
			label2.Font = Enum.Font.GothamBold
			label2.Text = "Animatronic Pets"
			label2.TextScaled = true
			label2.TextColor3 = Color3.fromRGB(255, 255, 255)
			label2.Parent = badge
		end
	end
	local badge = target:FindFirstChild("Badge")
	if not (badge and badge:IsA("Frame")) then
		badge = Instance.new("Frame")
		badge.Name = "Badge"
		badge.Size = UDim2.fromScale(1, 1)
		badge.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
		badge.BackgroundTransparency = 0.35
		badge.BorderSizePixel = 0
		badge.Parent = target
		Instance.new("UICorner", badge).CornerRadius = UDim.new(0, 10)
	end
	local label = badge:FindFirstChild("Label")
	if not (label and label:IsA("TextLabel")) then
		label = Instance.new("TextLabel")
		label.Name = "Label"
		label.BackgroundTransparency = 1
		label.Size = UDim2.fromScale(1, 1)
		label.Font = Enum.Font.GothamBold
		label.TextScaled = true
		label.TextColor3 = Color3.fromRGB(255, 255, 255)
		label.Parent = badge
	end
	label.Text = "Animatronic Pets"
	target.Enabled = true
	target.Active = false
	if sourceIndicator then
		target.AlwaysOnTop = sourceIndicator.AlwaysOnTop
		target.LightInfluence = sourceIndicator.LightInfluence
		target.MaxDistance = sourceIndicator.MaxDistance
		target.Size = sourceIndicator.Size
		target.StudsOffset = Vector3.new(
			sourceIndicator.StudsOffset.X,
			sourceIndicator.StudsOffset.Y + 2,
			sourceIndicator.StudsOffset.Z
		)
		target.ExtentsOffsetWorldSpace = sourceIndicator.ExtentsOffsetWorldSpace
	else
		target.AlwaysOnTop = true
		target.LightInfluence = 0
		target.MaxDistance = 200
		target.Size = UDim2.fromOffset(170, 50)
		target.StudsOffset = Vector3.new(0, 4, 0)
	end
	target.Adornee = anchor
	if target.Parent ~= anchor then
		target.Parent = anchor
	end
	return target
end

local function bindFnafPrompt(prompt: ProximityPrompt?)
	if not prompt then
		return
	end
	if fnafPromptConn then
		fnafPromptConn:Disconnect()
		fnafPromptConn = nil
	end
	fnafPromptConn = prompt.Triggered:Connect(function(playerWhoTriggered)
		local Players = game:GetService("Players")
		local localPlayer = Players.LocalPlayer
		if playerWhoTriggered and playerWhoTriggered ~= localPlayer then
			return
		end
		local now = os.clock()
		if (now - fnafPromptLastOpenAt) < 0.75 then
			return
		end
		fnafPromptLastOpenAt = now
		local ShopPanel = getShopPanel()
		if not ShopPanel then
			return
		end
		print("[ShopOpen] source=FNAFPrompt action=OPEN")
		if ShopPanel.Show then
			ShopPanel.Show()
		end
		if ShopPanel.ActivateBundleTab then
			ShopPanel.ActivateBundleTab("fnaf_pets_bundle")
		end
	end)
end

local function wireNow()
	if wireInProgress then
		return
	end
	wireInProgress = true
	local ok, err = pcall(function()
		local sourcePrompt: ProximityPrompt? = nil
		for _ = 1, 5 do
			sourcePrompt = findBrainrotPrompt()
			if sourcePrompt then break end
			task.wait(0.2)
		end

		local sourceIndicator: BillboardGui? = nil
		for _ = 1, 5 do
			sourceIndicator = findBrainrotIndicator()
			if sourceIndicator then break end
			task.wait(0.2)
		end

		local fnafModel: Instance? = nil
		for _ = 1, 30 do
			fnafModel = findFnafModel()
			if fnafModel then break end
			task.wait(1)
		end
		if not fnafModel then
			warn("[Indicator] FNAF bundle model not found")
			return
		end
		print(string.format("[FNAFWire] ModelResolved=%s class=%s", fnafModel:GetFullName(), fnafModel.ClassName))

		-- Always use a dedicated explicit anchor at Workspace.FNAFGameBun.PromptPart.
		local anchor = createPromptPart(fnafModel) or findFnafAnchorPart(fnafModel)
		if not anchor then
			warn("[FNAFWire] FNAF anchor part not found")
			return
		end

		print(string.format("[FNAFAnchor] Using anchor=%s pos=%s",
			anchor:GetFullName(), tostring(anchor.Position)))

		local prompt = copyPromptWiring(sourcePrompt, fnafModel, anchor)
		local indicator = copyIndicatorWiring(sourceIndicator, fnafModel, anchor)
		bindFnafPrompt(prompt)
		local promptParentPath = prompt and prompt.Parent and prompt.Parent:GetFullName() or "nil"
		local indicatorParentPath = indicator and indicator.Parent and indicator.Parent:GetFullName() or "nil"
		print(string.format("[FNAFAnchor] PromptParent=%s IndicatorParent=%s",
			promptParentPath, indicatorParentPath))
		if indicator then
			print(string.format("[BundleIndicator] bundle=fnaf visible=true part=%s", anchor:GetFullName()))
		end
	end)
	if not ok then
		warn("[FNAFWire] wireNow failed:", err)
	end
	wireInProgress = false
end

function FnafIndicatorWiring.Init()
	if initialized then
		return
	end
	initialized = true
	task.spawn(function()
		while true do
			wireNow()
			task.wait(8)
		end
	end)
	workspace.DescendantAdded:Connect(function(inst)
		local n = string.lower(inst.Name)
		if string.find(n, "fnaf", 1, true)
			or string.find(n, "bun", 1, true)
			or string.find(n, "prompt", 1, true)
			or inst:IsA("BillboardGui")
		then
			task.delay(0.2, wireNow)
		end
	end)
end

return FnafIndicatorWiring
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="121">
          <Properties>
            <string name="Name">FreezeIndicatorController</string>
            <string name="Source"><![CDATA[--[[
	FreezeIndicatorController
	Clean 2D HUD overlay: shows "FREEZE" when the local player is frozen.
	Listens for FreezeIndicator RemoteEvent from server.

	The ScreenGui starts Enabled=false so nothing is visible on join.
	Only enabled when a "Freeze" event fires, disabled after fade-out.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local FreezeIndicatorController = {}

local FADE_IN_TIME = 0.2
local HOLD_TIME = 1.0
local FADE_OUT_TIME = 0.5

local screenGui: ScreenGui = nil
local freezeLabel: TextLabel = nil
local glowLabel: TextLabel = nil
local freezeScale: UIScale = nil
local glowScale: UIScale = nil
local textStroke: UIStroke = nil
local glowStroke: UIStroke = nil
local fadeThread: thread? = nil

local function cancelPending()
	if fadeThread then
		pcall(task.cancel, fadeThread)
		fadeThread = nil
	end
end

local function createGui()
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui", 10)
	if not playerGui then return end

	screenGui = Instance.new("ScreenGui")
	screenGui.Name = "FreezeGui"
	screenGui.ResetOnSpawn = false
	screenGui.DisplayOrder = 80
	screenGui.IgnoreGuiInset = true
	screenGui.Enabled = false
	screenGui.Parent = playerGui

	glowLabel = Instance.new("TextLabel")
	glowLabel.Name = "FreezeGlow"
	glowLabel.AnchorPoint = Vector2.new(0.5, 0.5)
	glowLabel.Position = UDim2.new(0.5, 0, 0.36, 0)
	glowLabel.Size = UDim2.new(0.9, 0, 0, 72)
	glowLabel.BackgroundTransparency = 1
	glowLabel.Font = Enum.Font.GothamBlack
	glowLabel.Text = "FREEZE"
	glowLabel.TextSize = 58
	glowLabel.TextColor3 = Color3.fromRGB(255, 160, 30)
	glowLabel.TextTransparency = 1
	glowLabel.TextScaled = false
	glowLabel.ZIndex = 2
	glowLabel.Parent = screenGui

	glowStroke = Instance.new("UIStroke")
	glowStroke.Color = Color3.fromRGB(200, 100, 0)
	glowStroke.Thickness = 5
	glowStroke.Transparency = 1
	glowStroke.Parent = glowLabel

	glowScale = Instance.new("UIScale")
	glowScale.Scale = 1
	glowScale.Parent = glowLabel

	freezeLabel = Instance.new("TextLabel")
	freezeLabel.Name = "FreezeText"
	freezeLabel.AnchorPoint = Vector2.new(0.5, 0.5)
	freezeLabel.Position = UDim2.new(0.5, 0, 0.36, 0)
	freezeLabel.Size = UDim2.new(0.9, 0, 0, 72)
	freezeLabel.BackgroundTransparency = 1
	freezeLabel.Font = Enum.Font.GothamBlack
	freezeLabel.Text = "FREEZE"
	freezeLabel.TextSize = 58
	freezeLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
	freezeLabel.TextTransparency = 1
	freezeLabel.TextScaled = false
	freezeLabel.ZIndex = 3
	freezeLabel.Parent = screenGui

	textStroke = Instance.new("UIStroke")
	textStroke.Color = Color3.fromRGB(255, 140, 0)
	textStroke.Thickness = 2.5
	textStroke.Transparency = 1
	textStroke.Parent = freezeLabel

	freezeScale = Instance.new("UIScale")
	freezeScale.Scale = 1
	freezeScale.Parent = freezeLabel
end

local function showFreeze(freezeDuration: number?)
	if not screenGui or not freezeLabel or not glowLabel then return end
	cancelPending()

	local totalDuration = freezeDuration or 5
	local holdTime = math.clamp(totalDuration - FADE_IN_TIME - FADE_OUT_TIME - 0.2, 0.3, HOLD_TIME)

	freezeLabel.TextTransparency = 1
	glowLabel.TextTransparency = 1
	if textStroke then textStroke.Transparency = 1 end
	if glowStroke then glowStroke.Transparency = 1 end
	if freezeScale then freezeScale.Scale = 1.2 end
	if glowScale then glowScale.Scale = 1.25 end

	screenGui.Enabled = true

	local fadeIn = TweenInfo.new(FADE_IN_TIME, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
	TweenService:Create(freezeLabel, fadeIn, { TextTransparency = 0 }):Play()
	TweenService:Create(glowLabel, fadeIn, { TextTransparency = 0.5 }):Play()
	if textStroke then TweenService:Create(textStroke, fadeIn, { Transparency = 0.05 }):Play() end
	if glowStroke then TweenService:Create(glowStroke, fadeIn, { Transparency = 0.35 }):Play() end
	if freezeScale then TweenService:Create(freezeScale, fadeIn, { Scale = 1 }):Play() end
	if glowScale then TweenService:Create(glowScale, fadeIn, { Scale = 1.04 }):Play() end

	fadeThread = task.spawn(function()
		task.wait(FADE_IN_TIME + holdTime)

		local fadeOut = TweenInfo.new(FADE_OUT_TIME, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		TweenService:Create(freezeLabel, fadeOut, { TextTransparency = 1 }):Play()
		TweenService:Create(glowLabel, fadeOut, { TextTransparency = 1 }):Play()
		if textStroke then TweenService:Create(textStroke, fadeOut, { Transparency = 1 }):Play() end
		if glowStroke then TweenService:Create(glowStroke, fadeOut, { Transparency = 1 }):Play() end
		if freezeScale then TweenService:Create(freezeScale, fadeOut, { Scale = 0.9 }):Play() end
		if glowScale then TweenService:Create(glowScale, fadeOut, { Scale = 0.9 }):Play() end

		task.wait(FADE_OUT_TIME + 0.05)
		if screenGui then screenGui.Enabled = false end
		fadeThread = nil
	end)
end

local function hideFreeze()
	if not screenGui or not freezeLabel or not glowLabel then return end
	cancelPending()

	local fadeOut = TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	TweenService:Create(freezeLabel, fadeOut, { TextTransparency = 1 }):Play()
	TweenService:Create(glowLabel, fadeOut, { TextTransparency = 1 }):Play()
	if textStroke then TweenService:Create(textStroke, fadeOut, { Transparency = 1 }):Play() end
	if glowStroke then TweenService:Create(glowStroke, fadeOut, { Transparency = 1 }):Play() end

	fadeThread = task.spawn(function()
		task.wait(0.3)
		if screenGui then screenGui.Enabled = false end
		fadeThread = nil
	end)
end

function FreezeIndicatorController.Init()
	createGui()

	local remotes = ReplicatedStorage:WaitForChild("Remotes", 10)
	if not remotes then
		warn("[FreezeIndicator] Remotes folder not found")
		return
	end

	local remote = remotes:WaitForChild("FreezeIndicator", 10)
	if not remote then
		warn("[FreezeIndicator] FreezeIndicator remote not found")
		return
	end

	remote.OnClientEvent:Connect(function(action: string, arg1: any)
		if action == "Freeze" then
			showFreeze(arg1)
		elseif action == "Unfreeze" then
			hideFreeze()
		end
	end)

	print("[FreezeIndicator] Initialized — GUI hidden until freeze event")
end

return FreezeIndicatorController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="122">
          <Properties>
            <string name="Name">FreezePlayerPromptController</string>
            <string name="Source"><![CDATA[--[[
	FreezePlayerPromptController
	Local-only targeted proximity prompt for the Freeze Player developer product flow.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer
local FreezePlayerPromptController = {}

local UPDATE_INTERVAL = 0.2
local MAX_DISTANCE = 10

local requestRemote: RemoteEvent? = nil
local prompt: ProximityPrompt? = nil
local currentTargetUserId: number? = nil
local updateAccum = 0

local matchStatusFolder: Instance? = nil
local matchStateValue: StringValue? = nil
local roundValue: IntValue? = nil
local modeValue: StringValue? = nil

local function log(message: string)
	print("[FreezePrompt] " .. message)
end

local function ensureMatchStatusRefs()
	if matchStatusFolder and matchStatusFolder.Parent and matchStateValue and roundValue and modeValue then
		return
	end

	matchStatusFolder = ReplicatedStorage:FindFirstChild("MatchStatus")
	if not matchStatusFolder then
		matchStatusFolder = ReplicatedStorage:WaitForChild("MatchStatus", 10)
	end
	if not matchStatusFolder then
		return
	end

	local stateInst = matchStatusFolder:FindFirstChild("State")
	local roundInst = matchStatusFolder:FindFirstChild("Round")
	local modeInst = matchStatusFolder:FindFirstChild("Mode")
	if stateInst and stateInst:IsA("StringValue") then
		matchStateValue = stateInst
	end
	if roundInst and roundInst:IsA("IntValue") then
		roundValue = roundInst
	end
	if modeInst and modeInst:IsA("StringValue") then
		modeValue = modeInst
	end
end

local function getMatchState(): string
	ensureMatchStatusRefs()
	return matchStateValue and matchStateValue.Value or "Intermission"
end

local function getRound(): number
	ensureMatchStatusRefs()
	return roundValue and roundValue.Value or 0
end

local function getMode(): string
	ensureMatchStatusRefs()
	return modeValue and modeValue.Value or "Normal"
end

local function isLocalValidActor(): boolean
	local localState = LocalPlayer:GetAttribute("PlayerState")
	if localState ~= "InMatch" then
		return false
	end
	if getMatchState() ~= "Playing" then
		return false
	end
	local round = getRound()
	if round <= 0 or round >= 7 then
		return false
	end
	if getMode() == "Brainrot" then
		return false
	end
	return true
end

local function getRootPart(player: Player): BasePart?
	local character = player.Character
	if not character then
		return nil
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return nil
	end
	local root = character:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		return root
	end
	return nil
end

local function isValidTarget(player: Player): boolean
	if player == LocalPlayer then
		return false
	end
	if player:GetAttribute("PlayerState") ~= "InMatch" then
		return false
	end
	if player:GetAttribute("RoundLockedFreeze") == true then
		return false
	end
	return true
end

local function ensurePrompt()
	if prompt then
		return
	end
	prompt = Instance.new("ProximityPrompt")
	prompt.Name = "FreezePlayerPrompt"
	prompt.ActionText = "Freeze"
	prompt.ObjectText = "Player"
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = MAX_DISTANCE
	prompt.RequiresLineOfSight = false
	prompt.Enabled = false
	prompt.Style = Enum.ProximityPromptStyle.Default

	prompt.Triggered:Connect(function()
		if not requestRemote then
			return
		end
		if not currentTargetUserId then
			return
		end
		requestRemote:FireServer(currentTargetUserId)
		log(string.format("purchase_requested targetUserId=%d state=%s round=%d",
			currentTargetUserId,
			getMatchState(),
			getRound()
		))
	end)
end

local function hidePrompt()
	if prompt then
		prompt.Enabled = false
		prompt.Parent = nil
	end
	currentTargetUserId = nil
end

local function updatePrompt()
	if not prompt then
		return
	end
	if not isLocalValidActor() then
		hidePrompt()
		return
	end

	local localRoot = getRootPart(LocalPlayer)
	if not localRoot then
		hidePrompt()
		return
	end

	local nearestPlayer: Player? = nil
	local nearestRoot: BasePart? = nil
	local nearestDistance = math.huge

	for _, other in ipairs(Players:GetPlayers()) do
		if isValidTarget(other) then
			local otherRoot = getRootPart(other)
			if otherRoot then
				local dist = (otherRoot.Position - localRoot.Position).Magnitude
				if dist <= MAX_DISTANCE and dist < nearestDistance then
					nearestDistance = dist
					nearestPlayer = other
					nearestRoot = otherRoot
				end
			end
		end
	end

	if not nearestPlayer or not nearestRoot then
		hidePrompt()
		return
	end

	currentTargetUserId = nearestPlayer.UserId
	prompt.ObjectText = nearestPlayer.Name
	prompt.Parent = nearestRoot
	prompt.Enabled = true
end

function FreezePlayerPromptController.Init()
	local remotes = ReplicatedStorage:WaitForChild("Remotes", 10)
	if not remotes then
		warn("[FreezePrompt] Remotes folder not found")
		return
	end
	local remote = remotes:WaitForChild("FreezePlayerPromptRequest", 10)
	if not remote or not remote:IsA("RemoteEvent") then
		warn("[FreezePrompt] FreezePlayerPromptRequest remote missing")
		return
	end
	requestRemote = remote

	ensurePrompt()
	ensureMatchStatusRefs()

	RunService.RenderStepped:Connect(function(dt: number)
		updateAccum += dt
		if updateAccum < UPDATE_INTERVAL then
			return
		end
		updateAccum = 0
		updatePrompt()
	end)

	log("initialized")
end

return FreezePlayerPromptController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="123">
          <Properties>
            <string name="Name">GroupSignController</string>
            <string name="Source">-- Disabled: group join is now handled natively via GroupService:PromptJoinAsync on the server.
return {}</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="124">
          <Properties>
            <string name="Name">IconFollowerController</string>
            <string name="Source">--[[
	IconFollowerController
	Client-side Icon Image follower -- spawns equipped icon image models
	for ALL visible players, with smooth follow + bobble animation.

	Mirrors PetFollowerController but uses the OPPOSITE side offset
	so pet and icon image can coexist without overlapping.

	Pet uses +X (right side), Icon Image uses -X (left side).

	Reads: player:GetAttribute("EquippedIconImage")
	Catalog: ItemCatalog.IconImages[iconId]
	Registry: ItemModelRegistry.Get(modelPath)

	API:
	  IconFollowerController.Init()
]]

local Players           = game:GetService("Players")
local RunService        = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService       = game:GetService("HttpService")

local Shared            = ReplicatedStorage:WaitForChild("Shared")
local ItemCatalog       = require(Shared:WaitForChild("ItemCatalog"))
local ItemModelRegistry = require(Shared:WaitForChild("ItemModelRegistry"))

local TAG = "[IconFollower]"
local ICON_INSTANCE_NAME = "_EquippedIconImage"

local IconFollowerController = {}

-- =====================================================================
-- FOLLOW TUNING  (mirrors pet but on opposite X side)
-- =====================================================================

local ICON_OFFSET         = CFrame.new(-3, 2.5, 2)  -- left side (pet is +3)
local LERP_ALPHA          = 0.08
local BOBBLE_SPEED        = 3.0
local BOBBLE_AMPLITUDE    = 0.4
local YAW_WOBBLE_SPEED    = 1.5
local YAW_WOBBLE_AMP      = 5
local ROLL_WOBBLE_SPEED   = 2.0
local ROLL_WOBBLE_AMP     = 3

-- =====================================================================
-- SIZE NORMALIZATION
-- =====================================================================

local TARGET_MAX_DIM = 3.0
local SCALE_FLOOR    = 0.02
local SCALE_CEIL     = 1.0

-- =====================================================================
-- STATE (per-player icon tracking)
-- =====================================================================

local _activeIcons: { [Player]: {
	icon: Instance,
	conn: RBXScriptConnection?,
	cf: CFrame,
	t0: number,
} } = {}

local _playerConns: { [Player]: { RBXScriptConnection } } = {}

local function log(...)
	print(TAG, ...)
end

local function ensureValidBeam(beam: Beam): boolean
	local function invalidate()
		if beam.Parent then
			beam:Destroy()
		end
	end
	local function isAttachmentValid(att: Attachment?): boolean
		return att ~= nil and att.Parent ~= nil and att:IsDescendantOf(game)
	end
	local function validateNow()
		if not beam.Parent then
			return false
		end
		local a0 = beam.Attachment0
		local a1 = beam.Attachment1
		if not isAttachmentValid(a0) or not isAttachmentValid(a1) then
			invalidate()
			return false
		end
		return true
	end

	if not validateNow() then
		return false
	end

	beam:GetPropertyChangedSignal("Attachment0"):Connect(validateNow)
	beam:GetPropertyChangedSignal("Attachment1"):Connect(validateNow)
	local a0 = beam.Attachment0
	local a1 = beam.Attachment1
	if a0 then
		a0.AncestryChanged:Connect(validateNow)
	end
	if a1 then
		a1.AncestryChanged:Connect(validateNow)
	end
	beam.AncestryChanged:Connect(function()
		if beam.Parent then
			validateNow()
		end
	end)

	return true
end

-- =====================================================================
-- HELPERS
-- =====================================================================

local function getBBoxSize(inst: Instance): Vector3?
	if inst:IsA("Model") then
		local ok, _, sz = pcall(inst.GetBoundingBox, inst)
		if ok and typeof(sz) == "Vector3" then return sz end
		local ok2, ext = pcall(inst.GetExtentsSize, inst)
		if ok2 and typeof(ext) == "Vector3" then return ext end
		return nil
	elseif inst:IsA("BasePart") then
		return inst.Size
	end
	return nil
end

local function applyScale(inst: Instance, factor: number): boolean
	if factor == 1 then return true end
	if inst:IsA("Model") then
		local ok = pcall(function()
			local cur = inst:GetScale()
			inst:ScaleTo(cur * factor)
		end)
		if ok then return true end
		for _, d in ipairs(inst:GetDescendants()) do
			if d:IsA("BasePart") then
				d.Size = d.Size * factor
			elseif d:IsA("DataModelMesh") then
				d.Scale = d.Scale * factor
				if d:FindFirstAncestorWhichIsA("BasePart") then
					d.Offset = d.Offset * factor
				end
			elseif d:IsA("Attachment") then
				d.Position = d.Position * factor
			end
		end
		return true
	elseif inst:IsA("BasePart") then
		inst.Size = inst.Size * factor
		for _, d in ipairs(inst:GetDescendants()) do
			if d:IsA("DataModelMesh") then
				d.Scale = d.Scale * factor
				d.Offset = d.Offset * factor
			elseif d:IsA("Attachment") then
				d.Position = d.Position * factor
			end
		end
		return true
	end
	return false
end

local function yawOnly(cf: CFrame): number
	local _, ry, _ = cf:ToEulerAnglesYXZ()
	return ry
end

-- =====================================================================
-- ICON SPAWN / DESTROY
-- =====================================================================

local function getIconDef(iconId: string)
	if not iconId or iconId == "" then return nil end
	return ItemCatalog.IconImages and ItemCatalog.IconImages[iconId]
end

local function getOwnedIconImageSet(player: Player): { [string]: boolean }
	local raw = player:GetAttribute("OwnedIconImages")
	if type(raw) ~= "string" or raw == "" then
		return {}
	end
	local ok, decoded = pcall(function()
		return HttpService:JSONDecode(raw)
	end)
	if not ok or type(decoded) ~= "table" then
		return {}
	end
	local set = {}
	for _, id in ipairs(decoded) do
		if type(id) == "string" and id ~= "" then
			set[id] = true
		end
	end
	return set
end

local function destroyIconFor(player: Player)
	local entry = _activeIcons[player]
	if not entry then return end
	if entry.conn then entry.conn:Disconnect() end
	if entry.icon and entry.icon.Parent then entry.icon:Destroy() end
	_activeIcons[player] = nil
end

local function spawnIconFor(player: Player, iconId: string)
	local existing = _activeIcons[player]
	if existing and existing.icon and existing.icon.Parent then
		if existing.icon:GetAttribute("_iconImageId") == iconId then return end
	end

	destroyIconFor(player)

	if not iconId or iconId == "" then return end

	local iconDef = getIconDef(iconId)
	if not iconDef then
		warn(TAG, "Icon image not in catalog:", iconId)
		return
	end

	local modelPath = iconDef.modelPath
	if not modelPath or modelPath == "" then
		warn(TAG, "No modelPath for icon image:", iconId,
			"| catalogEntry:", iconDef.name or "?", "rarity:", iconDef.rarity or "?",
			"| image:", iconDef.image or "nil", "| modelName:", iconDef.modelName or "nil")
		log(string.format("[Resolve] iconId=%s modelPath=%s success=false reason=missing_modelPath",
			tostring(iconId), tostring(modelPath)))
		return
	end

	log("Resolving model for", iconId, "| modelPath:", modelPath, "| registry count:", ItemModelRegistry.GetCount())
	local sourceModel = ItemModelRegistry.Get(modelPath)
	if not sourceModel then
		warn(TAG, "modelPath exists but model NOT FOUND in registry:", modelPath,
			"| iconId:", iconId, "| Try checking ReplicatedStorage.ItemModels hierarchy")
		log(string.format("[Resolve] iconId=%s modelPath=%s success=false reason=registry_miss",
			tostring(iconId), tostring(modelPath)))
		log("Dumping registry keys for debug:")
		ItemModelRegistry.DumpKeys()
		return
	end
	log(string.format("[Resolve] iconId=%s modelPath=%s success=true",
		tostring(iconId), tostring(modelPath)))
	log("Model resolved OK:", sourceModel:GetFullName(), "for icon:", iconId)

	local character = player.Character
	local rootPart = character and character:FindFirstChild("HumanoidRootPart")
	if not rootPart then return end

	log("Spawning icon image for", player.Name .. ":", iconId, "path:", modelPath)

	local clone = sourceModel:Clone()

	-- Unwrap Accessory
	if clone:IsA("Accessory") then
		local wrapper = Instance.new("Model")
		wrapper.Name = clone.Name
		local handle = clone:FindFirstChild("Handle")
		for _, child in ipairs(clone:GetChildren()) do
			child.Parent = wrapper
		end
		if handle and handle:IsA("BasePart") then
			wrapper.PrimaryPart = handle
		else
			local firstPart = wrapper:FindFirstChildWhichIsA("BasePart", true)
			if firstPart then wrapper.PrimaryPart = firstPart end
		end
		clone:Destroy()
		clone = wrapper
	end

	-- Wrap bare BaseParts into a Model
	if clone:IsA("BasePart") and not clone:IsA("Model") then
		local wrapper = Instance.new("Model")
		wrapper.Name = clone.Name
		clone.Parent = wrapper
		wrapper.PrimaryPart = clone
		clone = wrapper
	end

	-- Make all parts non-interactive and anchored
	local function prepPart(part: BasePart)
		part.Anchored = true
		part.CanCollide = false
		part.CanQuery = false
		part.CanTouch = false
		part.Massless = true
	end

	if clone:IsA("BasePart") then prepPart(clone) end
	for _, d in ipairs(clone:GetDescendants()) do
		if d:IsA("BasePart") then prepPart(d) end
	end

	-- Enable VFX
	for _, d in ipairs(clone:GetDescendants()) do
		if d:IsA("ParticleEmitter") or d:IsA("Fire") or d:IsA("Sparkles")
			or d:IsA("Smoke") or d:IsA("Beam") or d:IsA("Trail") then
			if d:IsA("Beam") then
				if ensureValidBeam(d) then
					d.Enabled = true
				end
			else
				d.Enabled = true
			end
		elseif d:IsA("Script") or d:IsA("LocalScript") then
			d:Destroy()
		end
	end

	-- SIZE NORMALIZATION
	local preBBox = getBBoxSize(clone)
	local iconScale = 1

	do
		if preBBox then
			local maxDim = math.max(preBBox.X, preBBox.Y, preBBox.Z, 0.01)
			if maxDim &gt; TARGET_MAX_DIM then
				iconScale = TARGET_MAX_DIM / maxDim
			end
		end

		iconScale = math.clamp(iconScale, SCALE_FLOOR, SCALE_CEIL)

		if iconScale &lt; 1 then
			applyScale(clone, iconScale)
		end

		-- Post-scale verification
		local postBBox = getBBoxSize(clone)
		if postBBox then
			local postMax = math.max(postBBox.X, postBBox.Y, postBBox.Z)
			if postMax &gt; TARGET_MAX_DIM then
				local correction = (TARGET_MAX_DIM / postMax) * 0.95
				correction = math.max(correction, SCALE_FLOOR)
				applyScale(clone, correction)
				iconScale = iconScale * correction
				log("Post-scale correction for", iconId,
					string.format("extra %.3fx (was %.1f studs)", correction, postMax))
			end
		end
	end

	log("Scaled icon image", iconId, string.format("%.3fx", iconScale),
		preBBox and string.format("(pre-bbox: %.1f x %.1f x %.1f)", preBBox.X, preBBox.Y, preBBox.Z) or "(no bbox)")

	-- FOLLOW OFFSET (scaled to icon size)
	local offsetMul = 0.4 + 0.6 * iconScale
	local iconOffset = CFrame.new(
		ICON_OFFSET.X * offsetMul,
		ICON_OFFSET.Y * offsetMul,
		ICON_OFFSET.Z * offsetMul
	)
	local iconBobbleAmp = BOBBLE_AMPLITUDE * math.max(iconScale, 0.4)

	-- INITIAL POSITION
	local hrpYaw = yawOnly(rootPart.CFrame)
	local startPos = (rootPart.CFrame * iconOffset).Position
	local startCF = CFrame.new(startPos) * CFrame.Angles(0, hrpYaw, 0)

	if clone:IsA("Model") then
		clone:PivotTo(startCF)
	elseif clone:IsA("BasePart") then
		clone.CFrame = startCF
	end

	clone.Name = ICON_INSTANCE_NAME
	clone:SetAttribute("_iconImageId", iconId)
	clone:SetAttribute("_owner", player.Name)
	clone.Parent = workspace

	-- FOLLOW + BOBBLE LOOP
	local currentCF = startCF
	local t0 = tick()

	local followConn = RunService.Heartbeat:Connect(function()
		if not clone or not clone.Parent then
			destroyIconFor(player)
			return
		end
		local char = player.Character
		if not char then return end
		local hrp = char:FindFirstChild("HumanoidRootPart")
		if not hrp then return end

		local t = tick() - t0

		local targetPos = (hrp.CFrame * iconOffset).Position
		local bobbleY = math.sin(t * BOBBLE_SPEED) * iconBobbleAmp
		targetPos = targetPos + Vector3.new(0, bobbleY, 0)

		local playerYaw = yawOnly(hrp.CFrame)

		local yawW = math.sin(t * YAW_WOBBLE_SPEED) * math.rad(YAW_WOBBLE_AMP)
		local rollW = math.sin(t * ROLL_WOBBLE_SPEED) * math.rad(ROLL_WOBBLE_AMP)
		local finalYaw = playerYaw + yawW

		local targetCF = CFrame.new(targetPos) * CFrame.Angles(0, finalYaw, rollW)

		currentCF = currentCF:Lerp(targetCF, LERP_ALPHA)

		if clone:IsA("Model") then
			clone:PivotTo(currentCF)
		elseif clone:IsA("BasePart") then
			clone.CFrame = currentCF
		end
	end)

	_activeIcons[player] = {
		icon = clone,
		conn = followConn,
		cf = currentCF,
		t0 = t0,
	}

	log("Icon image spawned for", player.Name .. ":", iconId)
end

-- =====================================================================
-- PER-PLAYER LIFECYCLE
-- =====================================================================

local function updateIconFor(player: Player)
	local iconId = player:GetAttribute("EquippedIconImage")
	log("updateIconFor", player.Name, "| EquippedIconImage attr =", tostring(iconId))
	if iconId and iconId ~= "" then
		local ownedSet = getOwnedIconImageSet(player)
		if not ownedSet[iconId] then
			warn(string.format(
				"%s Skip invalid equipped icon spawn player=%s equipped=%s reason=not_owned",
				TAG,
				player.Name,
				tostring(iconId)
			))
			destroyIconFor(player)
			return
		end
		spawnIconFor(player, iconId)
	else
		log("No equipped icon image for", player.Name, "-- destroying any active icon")
		destroyIconFor(player)
	end
end

local function setupPlayer(player: Player)
	local conns: { RBXScriptConnection } = {}

	table.insert(conns, player:GetAttributeChangedSignal("EquippedIconImage"):Connect(function()
		local newVal = player:GetAttribute("EquippedIconImage")
		log("EquippedIconImage CHANGED for", player.Name, "-&gt;", tostring(newVal))
		updateIconFor(player)
	end))
	table.insert(conns, player:GetAttributeChangedSignal("OwnedIconImages"):Connect(function()
		updateIconFor(player)
	end))

	table.insert(conns, player.CharacterAdded:Connect(function(character)
		character:WaitForChild("HumanoidRootPart", 10)
		task.wait(0.5)
		updateIconFor(player)
	end))

	table.insert(conns, player.CharacterRemoving:Connect(function()
		destroyIconFor(player)
	end))

	_playerConns[player] = conns

	if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
		task.spawn(function()
			task.wait(0.3)
			updateIconFor(player)
		end)
	end
end

local function cleanupPlayer(player: Player)
	destroyIconFor(player)
	if _playerConns[player] then
		for _, conn in ipairs(_playerConns[player]) do
			conn:Disconnect()
		end
		_playerConns[player] = nil
	end
end

-- =====================================================================
-- PUBLIC API
-- =====================================================================

function IconFollowerController.Init()
	log("Initializing...")

	Players.PlayerAdded:Connect(setupPlayer)
	Players.PlayerRemoving:Connect(cleanupPlayer)

	for _, player in ipairs(Players:GetPlayers()) do
		task.spawn(setupPlayer, player)
	end

	log("Ready -- tracking icon images for all players")
end

return IconFollowerController</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="125">
          <Properties>
            <string name="Name">LocomotionController</string>
            <string name="Source"><![CDATA[--[[
	LocomotionController
	Reusable Humanoid + Animator movement controller copied from the TungTungSahur
	chase pipeline in `src/server/TungTungSahurService.luau`.

	TungTung parity points:
	  - Target loop cadence: `ChaseInterval = 0.2`
	  - MoveTo repath gate: `RepathInterval = 0.45`
	  - Repath on target movement: `RepathTargetMoveDelta = 4.0`
	  - Animator loading flow: Animator -> LoadAnimation -> Loop -> Play
]]

local LocomotionController = {}
LocomotionController.__index = LocomotionController

local DEFAULTS = {
	WalkSpeed = 14,
	HipHeight = 2.0,
	RepathInterval = 0.18,
	RepathTargetMoveDelta = 1.5,
	WalkAnimId = "rbxassetid://507777826", -- TungTung walk
	IdleAnimId = "rbxassetid://507766666", -- default Roblox idle
}

local function ensureRoot(model: Model): BasePart?
	local root = model:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		model.PrimaryPart = root
		return root
	end

	local primary = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart", true)
	if not primary then
		return nil
	end

	-- Create a lightweight HumanoidRootPart and weld it to existing primary.
	local hrp = Instance.new("Part")
	hrp.Name = "HumanoidRootPart"
	hrp.Size = Vector3.new(2, 2, 1)
	hrp.Transparency = 1
	hrp.CanCollide = true
	hrp.CanQuery = false
	hrp.CanTouch = false
	hrp.Massless = false
	hrp.Anchored = false
	hrp.CFrame = primary.CFrame
	hrp.Parent = model

	local weld = Instance.new("WeldConstraint")
	weld.Part0 = hrp
	weld.Part1 = primary
	weld.Parent = hrp

	model.PrimaryPart = hrp
	return hrp
end

local function ensureHumanoid(model: Model, root: BasePart?, walkSpeed: number, hipHeight: number): Humanoid?
	local hum = model:FindFirstChildOfClass("Humanoid")
	if not hum then
		hum = Instance.new("Humanoid")
		hum.Name = "Humanoid"
		hum.Parent = model
	end
	hum.WalkSpeed = walkSpeed
	local minHip = 2.0
	if root then
		minHip = math.max(2.0, (root.Size.Y * 0.5) + 0.5)
	end
	hum.HipHeight = math.max(hipHeight, minHip)
	hum.AutoRotate = true
	hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	hum.BreakJointsOnDeath = false
	hum.RequiresNeck = false
	hum.PlatformStand = false
	hum.MaxHealth = math.max(hum.MaxHealth, 1000)
	hum.Health = hum.MaxHealth
	pcall(function()
		hum:ChangeState(Enum.HumanoidStateType.Running)
	end)
	return hum
end

local function ensureAnimator(humanoid: Humanoid): Animator
	local animator = humanoid:FindFirstChildOfClass("Animator")
	if animator then return animator end
	animator = Instance.new("Animator")
	animator.Parent = humanoid
	return animator
end

local function tryLoadTrack(animator: Animator, animId: string): AnimationTrack?
	if animId == "" then return nil end
	local anim = Instance.new("Animation")
	anim.AnimationId = animId
	local ok, track = pcall(function()
		return animator:LoadAnimation(anim)
	end)
	anim:Destroy()
	if ok and track then
		track.Looped = true
		return track
	end
	return nil
end

local function resolveAnimId(model: Model, wanted: string, fallbackId: string): string
	if typeof(wanted) == "string" and wanted ~= "" then
		return wanted
	end
	local wantedLower = string.lower(fallbackId)
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("Animation") then
			local n = string.lower(d.Name)
			local p = d.Parent and string.lower(d.Parent.Name) or ""
			if string.find(n, wantedLower, 1, true) or string.find(p, wantedLower, 1, true) then
				if d.AnimationId and d.AnimationId ~= "" then
					return d.AnimationId
				end
			end
		end
	end
	return ""
end

function LocomotionController.new(model: Model, opts)
	local self = setmetatable({}, LocomotionController)
	opts = opts or {}
	self._model = model
	self._cfg = {
		WalkSpeed = opts.WalkSpeed or DEFAULTS.WalkSpeed,
		HipHeight = opts.HipHeight or DEFAULTS.HipHeight,
		RepathInterval = opts.RepathInterval or DEFAULTS.RepathInterval,
		RepathTargetMoveDelta = opts.RepathTargetMoveDelta or DEFAULTS.RepathTargetMoveDelta,
		WalkAnimId = opts.WalkAnimId or DEFAULTS.WalkAnimId,
		IdleAnimId = opts.IdleAnimId or DEFAULTS.IdleAnimId,
	}

	self._root = ensureRoot(model)
	if not self._root then
		return self
	end
	if self._root then
		self._root.Anchored = false
		self._root.CanCollide = true
		self._root.Massless = false
	end
	self._humanoid = ensureHumanoid(model, self._root, self._cfg.WalkSpeed, self._cfg.HipHeight)
	self._animator = self._humanoid and ensureAnimator(self._humanoid) or nil
	local walkAnimId = resolveAnimId(model, self._cfg.WalkAnimId, "walk")
	local idleAnimId = resolveAnimId(model, self._cfg.IdleAnimId, "idle")
	self._walkTrack = self._animator and tryLoadTrack(self._animator, walkAnimId) or nil
	self._idleTrack = self._animator and tryLoadTrack(self._animator, idleAnimId) or nil
	self._moving = false
	self._lastMoveToAt = 0
	self._lastMoveTarget = nil
	self._runConn = nil
	if self._humanoid then
		self._runConn = self._humanoid.Running:Connect(function(speed)
			self:_setMoving(speed > 0.1)
		end)
	end
	self:_setMoving(false)
	return self
end

function LocomotionController:_setMoving(moving: boolean)
	if self._moving == moving then return end
	self._moving = moving
	if moving then
		if self._idleTrack then pcall(function() self._idleTrack:Stop() end) end
		if self._walkTrack then pcall(function() self._walkTrack:Play() end) end
	else
		if self._walkTrack then pcall(function() self._walkTrack:Stop() end) end
		if self._idleTrack then pcall(function() self._idleTrack:Play() end) end
	end
end

function LocomotionController:GetPosition(): Vector3?
	if self._root and self._root.Parent then
		return self._root.Position
	end
	if self._model and self._model.PrimaryPart then
		return self._model.PrimaryPart.Position
	end
	return nil
end

function LocomotionController:MoveTo(targetPos: Vector3)
	if not self._humanoid or not self._root then return end
	local now = tick()
	local lastTarget = self._lastMoveTarget
	local shouldRepath = false
	if (now - self._lastMoveToAt) >= self._cfg.RepathInterval then
		shouldRepath = true
	elseif lastTarget and (targetPos - lastTarget).Magnitude >= self._cfg.RepathTargetMoveDelta then
		shouldRepath = true
	elseif not lastTarget then
		shouldRepath = true
	end
	if not shouldRepath then return end
	self._humanoid:MoveTo(targetPos)
	self._lastMoveToAt = now
	self._lastMoveTarget = targetPos
end

function LocomotionController:Stop()
	if not self._humanoid then return end
	local pos = self:GetPosition()
	if pos then
		self._humanoid:MoveTo(pos)
	end
	self:_setMoving(false)
end

function LocomotionController:Teleport(targetCF: CFrame)
	if not self._model then return end
	self._model:PivotTo(targetCF)
	self:Stop()
end

function LocomotionController:Destroy()
	self:Stop()
	if self._walkTrack then pcall(function() self._walkTrack:Stop() end) end
	if self._idleTrack then pcall(function() self._idleTrack:Stop() end) end
	if self._runConn then
		self._runConn:Disconnect()
		self._runConn = nil
	end
	self._walkTrack = nil
	self._idleTrack = nil
	self._animator = nil
	self._humanoid = nil
	self._root = nil
end

function LocomotionController:IsWalkAnimLoaded(): boolean
	return self._walkTrack ~= nil
end

function LocomotionController:IsIdleAnimLoaded(): boolean
	return self._idleTrack ~= nil
end

return LocomotionController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="126">
          <Properties>
            <string name="Name">MatchAudioController</string>
            <string name="Source"><![CDATA[--[[
	MatchAudioController
	Client-side round feedback audio.

	Adds subtle match-only cues for:
	  - Freeze activation
	  - Late-round tension
	  - Active beam phase

	Playback is driven by existing replicated match signals plus the
	existing FreezeIndicator remote, so no gameplay logic changes.
]]

local ContentProvider = game:GetService("ContentProvider")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local MatchState = require(Shared:WaitForChild("MatchState"))
local PlayerState = require(Shared:WaitForChild("PlayerState"))

local LocalPlayer = Players.LocalPlayer

local MatchAudioController = {}

local FREEZE_SOUND_ID = "rbxassetid://76550802183957"
local TENSION_SOUND_ID = "rbxassetid://132014926399178"
local BEAM_SOUND_ID = "rbxassetid://112553783607296"

local FREEZE_VOLUME = 0.65
local TENSION_VOLUME = 0.40
local BEAM_VOLUME = 0.32

local FREEZE_FADE_IN = 0.12
local FREEZE_FADE_OUT = 0.24
local TENSION_FADE_IN = 0.24
local TENSION_FADE_OUT = 0.36
local BEAM_FADE_IN = 0.25
local BEAM_FADE_OUT = 0.22

local TENSION_TRIGGER_REMAINING = 4.5
local FREEZE_DUPLICATE_WINDOW = 0.35
local ONE_SHOT_TIME_LENGTH_WAIT = 3.0

local initialized = false
local matchStateValue: StringValue? = nil
local roundValue: IntValue? = nil
local roundPhaseValue: StringValue? = nil
local movementCountdownVisibleValue: BoolValue? = nil
local movementCountdownEndTimeValue: NumberValue? = nil
local lastFreezeTriggerAt = 0
local lastTensionRoundPlayed = -1

type Track = {
	name: string,
	sound: Sound,
	targetVolume: number,
	fadeIn: number,
	fadeOut: number,
	looped: boolean,
	active: boolean,
	token: number,
	tween: Tween?,
}

local freezeTrack: Track? = nil
local tensionTrack: Track? = nil
local beamTrack: Track? = nil

local function isLocalPlayerInMatch(): boolean
	return LocalPlayer:GetAttribute("PlayerState") == PlayerState.States.InMatch
end

local function canPlayMatchAudio(): boolean
	if not isLocalPlayerInMatch() then
		return false
	end
	if not matchStateValue then
		return false
	end
	return matchStateValue.Value == MatchState.States.Playing
end

local function createTrack(container: Instance, name: string, soundId: string, looped: boolean, volume: number, fadeIn: number, fadeOut: number): Track
	local sound = Instance.new("Sound")
	sound.Name = name
	sound.SoundId = soundId
	sound.Looped = looped
	sound.Volume = 0
	sound.RollOffMode = Enum.RollOffMode.InverseTapered
	sound.Parent = container

	return {
		name = name,
		sound = sound,
		targetVolume = volume,
		fadeIn = fadeIn,
		fadeOut = fadeOut,
		looped = looped,
		active = false,
		token = 0,
		tween = nil,
	}
end

local function cancelTween(track: Track)
	if track.tween then
		track.tween:Cancel()
		track.tween = nil
	end
end

local function tweenVolume(track: Track, goalVolume: number, duration: number, onComplete: (() -> ())?)
	cancelTween(track)
	if duration <= 0 then
		track.sound.Volume = goalVolume
		if onComplete then
			onComplete()
		end
		return
	end

	local tween = TweenService:Create(
		track.sound,
		TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ Volume = goalVolume }
	)
	track.tween = tween
	tween:Play()

	task.spawn(function()
		tween.Completed:Wait()
		if track.tween == tween then
			track.tween = nil
			if onComplete then
				onComplete()
			end
		end
	end)
end

local function stopTrack(track: Track, fadeDuration: number?)
	track.active = false
	track.token += 1
	local token = track.token
	local duration = fadeDuration
	if duration == nil then
		duration = track.fadeOut
	end

	tweenVolume(track, 0, duration, function()
		if track.token ~= token then
			return
		end
		track.sound:Stop()
		track.sound.TimePosition = 0
	end)
end

local function scheduleOneShotFadeOut(track: Track, token: number)
	task.spawn(function()
		local waited = 0
		while track.token == token and track.sound.Parent and track.sound.TimeLength <= 0 and waited < ONE_SHOT_TIME_LENGTH_WAIT do
			task.wait(0.05)
			waited += 0.05
		end

		if track.token ~= token or not track.sound.Parent then
			return
		end

		local duration = track.sound.TimeLength
		if duration <= 0 then
			return
		end

		local fadeLead = math.min(track.fadeOut, math.max(duration * 0.35, 0.15))
		local waitTime = math.max(0, duration - fadeLead)
		if waitTime > 0 then
			task.wait(waitTime)
		end

		if track.token ~= token or not track.sound.Parent then
			return
		end

		tweenVolume(track, 0, fadeLead, function()
			if track.token ~= token then
				return
			end
			track.sound:Stop()
			track.sound.TimePosition = 0
			track.active = false
		end)
	end)
end

local function playOneShot(track: Track)
	track.active = true
	track.token += 1
	local token = track.token

	cancelTween(track)
	track.sound.Looped = false
	track.sound.Volume = 0
	track.sound:Stop()
	track.sound.TimePosition = 0
	track.sound:Play()

	tweenVolume(track, track.targetVolume, track.fadeIn, nil)
	scheduleOneShotFadeOut(track, token)
end

local function startLoopTrack(track: Track)
	if track.active and track.sound.Playing then
		return
	end

	track.active = true
	track.token += 1
	track.sound.Looped = true
	if not track.sound.Playing then
		track.sound.Volume = 0
		track.sound.TimePosition = 0
		track.sound:Play()
	end
	tweenVolume(track, track.targetVolume, track.fadeIn, nil)
end

local function syncBeamTrack()
	if not beamTrack then
		return
	end

	local phaseName = roundPhaseValue and roundPhaseValue.Value or ""
	local beamShouldBeActive = canPlayMatchAudio()
		and (phaseName == "BeamWarning" or phaseName == "Strike")

	if beamShouldBeActive then
		startLoopTrack(beamTrack)
	else
		stopTrack(beamTrack)
	end
end

local function stopNonLoopingMatchAudio()
	if freezeTrack and freezeTrack.sound.Playing then
		stopTrack(freezeTrack, 0.15)
	end
	if tensionTrack and tensionTrack.sound.Playing then
		stopTrack(tensionTrack, 0.18)
	end
end

local function updateEligibility()
	if matchStateValue and matchStateValue.Value ~= MatchState.States.Playing then
		lastTensionRoundPlayed = -1
	end
	if canPlayMatchAudio() then
		syncBeamTrack()
		return
	end

	syncBeamTrack()
	stopNonLoopingMatchAudio()
end

local function maybePlayFreezeCue()
	if not freezeTrack then
		return
	end
	local now = os.clock()
	if now - lastFreezeTriggerAt < FREEZE_DUPLICATE_WINDOW then
		return
	end
	lastFreezeTriggerAt = now
	playOneShot(freezeTrack)
end

local function maybePlayTensionCue()
	if not tensionTrack or not roundValue or not movementCountdownVisibleValue or not movementCountdownEndTimeValue then
		return
	end
	if not canPlayMatchAudio() then
		return
	end

	local currentRound = roundValue.Value
	if currentRound <= 0 or lastTensionRoundPlayed == currentRound then
		return
	end
	if not movementCountdownVisibleValue.Value then
		return
	end

	local remaining = movementCountdownEndTimeValue.Value - workspace:GetServerTimeNow()
	if remaining <= 0 or remaining > TENSION_TRIGGER_REMAINING then
		return
	end

	lastTensionRoundPlayed = currentRound
	playOneShot(tensionTrack)
end

function MatchAudioController.Init()
	if initialized then
		return
	end
	initialized = true

	local folder = SoundService:FindFirstChild("MatchAudio")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "MatchAudio"
		folder.Parent = SoundService
	end

	freezeTrack = createTrack(folder, "FreezeCue", FREEZE_SOUND_ID, false, FREEZE_VOLUME, FREEZE_FADE_IN, FREEZE_FADE_OUT)
	tensionTrack = createTrack(folder, "RoundTensionCue", TENSION_SOUND_ID, false, TENSION_VOLUME, TENSION_FADE_IN, TENSION_FADE_OUT)
	beamTrack = createTrack(folder, "BeamActiveCue", BEAM_SOUND_ID, true, BEAM_VOLUME, BEAM_FADE_IN, BEAM_FADE_OUT)

	task.spawn(function()
		pcall(function()
			ContentProvider:PreloadAsync({
				freezeTrack.sound,
				tensionTrack.sound,
				beamTrack.sound,
			})
		end)
	end)

	task.spawn(function()
		local remotes = ReplicatedStorage:WaitForChild("Remotes", 15)
		if not remotes then
			warn("[MatchAudioController] Remotes folder not found")
			return
		end

		local freezeRemote = remotes:WaitForChild("FreezeIndicator", 15)
		if freezeRemote and freezeRemote:IsA("RemoteEvent") then
			freezeRemote.OnClientEvent:Connect(function(action: string)
				if action == "Freeze" then
					maybePlayFreezeCue()
				end
			end)
		else
			warn("[MatchAudioController] FreezeIndicator remote missing")
		end
	end)

	task.spawn(function()
		local matchStatus = ReplicatedStorage:WaitForChild("MatchStatus", 15)
		if not matchStatus then
			warn("[MatchAudioController] MatchStatus not found")
			return
		end

		matchStateValue = matchStatus:WaitForChild("State", 10)
		roundValue = matchStatus:WaitForChild("Round", 10)
		roundPhaseValue = matchStatus:WaitForChild("RoundPhase", 10)
		movementCountdownVisibleValue = matchStatus:WaitForChild("MovementCountdownVisible", 10)
		movementCountdownEndTimeValue = matchStatus:WaitForChild("MovementCountdownEndTime", 10)

		if roundValue then
			roundValue.Changed:Connect(function()
				if roundValue.Value <= 0 then
					lastTensionRoundPlayed = -1
				end
				if tensionTrack and tensionTrack.sound.Playing then
					stopTrack(tensionTrack, 0.18)
				end
				syncBeamTrack()
			end)
		end
		if matchStateValue then
			matchStateValue.Changed:Connect(function()
				updateEligibility()
			end)
		end
		if roundPhaseValue then
			roundPhaseValue.Changed:Connect(function()
				syncBeamTrack()
			end)
		end
		if movementCountdownVisibleValue then
			movementCountdownVisibleValue.Changed:Connect(function()
				maybePlayTensionCue()
			end)
		end
		if movementCountdownEndTimeValue then
			movementCountdownEndTimeValue.Changed:Connect(function()
				maybePlayTensionCue()
			end)
		end

		updateEligibility()
		maybePlayTensionCue()
	end)

	LocalPlayer:GetAttributeChangedSignal("PlayerState"):Connect(function()
		updateEligibility()
	end)

	RunService.Heartbeat:Connect(function()
		maybePlayTensionCue()
	end)

	print("[MatchAudioController] Initialized")
end

return MatchAudioController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="127">
          <Properties>
            <string name="Name">MusicController</string>
            <string name="Source"><![CDATA[--[[
	MusicController
	Centralized client-side music & SFX system.

	CROSSFADE enforcement: on context switch the new track begins fading in
	while the old track is simultaneously fading out.  Both overlap during
	the crossfade window so there is never a silent gap.

	Music:
	  • Lobby  — 70% original track / 30% alt track
	  • Map    — single track, starts at 32s, looped

	SFX (layered, does NOT replace music):
	  • Win / ObbyComplete via PlaySFX RemoteEvent
	  • Intermission 5-second countdown warning

	Integrates with SettingsPanel via SoundGroup "BGM" in SoundService.

	Called from: init.client.luau via MusicController.Init()
]]

local SoundService      = game:GetService("SoundService")
local TweenService      = game:GetService("TweenService")
local RunService        = game:GetService("RunService")
local Players           = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local LocalPlayer = Players.LocalPlayer
local Shared = ReplicatedStorage:WaitForChild("Shared")
local MusicConfig = require(Shared:WaitForChild("MusicConfig"))
local PlayerState = require(Shared:WaitForChild("PlayerState"))

local MusicController = {}

-- ═══════════════════════════════════════════════════════════════════
-- CONFIG
-- ═══════════════════════════════════════════════════════════════════

-- Lobby track A: original lobby music (10%)
local LOBBY_TRACK_A_ID      = MusicConfig.LobbyTracks.Primary.Id
local LOBBY_TRACK_A_START   = MusicConfig.LobbyTracks.Primary.Start
local LOBBY_TRACK_A_VOLUME  = MusicConfig.LobbyTracks.Primary.Volume
local LOBBY_TRACK_A_CHANCE  = MusicConfig.LobbyTracks.Primary.Chance

-- Lobby track B: alt lobby music (90%)
local LOBBY_TRACK_B_ID      = MusicConfig.LobbyTracks.Alternate.Id
local LOBBY_TRACK_B_START   = MusicConfig.LobbyTracks.Alternate.Start
local LOBBY_TRACK_B_VOLUME  = MusicConfig.LobbyTracks.Alternate.Volume

local function buildTrackSequence(trackConfig)
	local tracks = {}
	local playlist = trackConfig.Playlist
	if typeof(playlist) == "table" and #playlist > 0 then
		for _, track in ipairs(playlist) do
			table.insert(tracks, {
				Id = track.Id,
				Start = track.Start or 0,
			})
		end
	elseif trackConfig.Id then
		table.insert(tracks, {
			Id = trackConfig.Id,
			Start = trackConfig.Start or 0,
		})
	end
	return tracks
end

local function describeTrackSequence(tracks): string
	local parts = table.create(#tracks)
	for index, track in ipairs(tracks) do
		parts[index] = string.format("%s@%.2f", track.Id, track.Start or 0)
	end
	return table.concat(parts, ",")
end

-- Match music (mode-aware)
local NORMAL_MAP_TRACKS         = buildTrackSequence(MusicConfig.MapTracks.Normal)
local NORMAL_MAP_TRACK_VOLUME   = MusicConfig.MapTracks.Normal.Volume

-- Save a Brainrot mode track (new)
local BRAINROT_MAP_TRACK_ID     = MusicConfig.MapTracks.Brainrot.Id
local BRAINROT_MAP_TRACK_START  = MusicConfig.MapTracks.Brainrot.Start
local BRAINROT_MAP_TRACK_VOLUME = MusicConfig.MapTracks.Brainrot.Volume

-- Crossfade transition (both tracks overlap — no silent gap)
local CROSSFADE_TIME        = 1.2

-- SFX
local SFX_VOLUME            = MusicConfig.SFX.Win.Volume
local COUNTDOWN_VOLUME      = MusicConfig.SFX.IntermissionCountdown.Volume
local COUNTDOWN_THRESHOLD   = MusicConfig.SFX.IntermissionCountdown.Threshold
local WIN_SFX_ID            = MusicConfig.SFX.Win.Id
local INTERMISSION_SFX_ID   = MusicConfig.SFX.IntermissionCountdown.Id

-- Legacy sounds to purge (old map music + any leftovers)
local LEGACY_SOUND_IDS = {
	["rbxassetid://99521953914772"]  = true,  -- old MapMusicA
	["rbxassetid://140496937016968"] = true,  -- old MapMusicB
}
local LEGACY_SOUND_NAMES = {
	MapMusicA = true,
	MapMusicB = true,
}

-- ═══════════════════════════════════════════════════════════════════
-- INTERNAL STATE
-- ═══════════════════════════════════════════════════════════════════

local bgmGroup: SoundGroup       = nil
local activeSound: Sound?        = nil   -- the ONE playing music Sound
local activeFadeTween: Tween?    = nil
local currentContext: string?    = nil   -- "lobby" | "normal_match" | "brainrot_match"
local lastLoggedPlayerState: string? = nil
local lastLoggedAudioState: string? = nil
local _initialized               = false
local matchStatusModeValue: StringValue? = nil
local matchStatusStateValue: StringValue? = nil
local matchStatusPhaseEndValue: NumberValue? = nil
local modeVoteActiveValue: BoolValue? = nil
local lastWarnedPhaseEnd: number? = nil
local normalPlaylistToken = 0

-- SFX sounds (persistent, not part of single-channel)
local winSfx: Sound?             = nil
local intermissionSfx: Sound?    = nil
local log

-- Hard-stop intermission countdown SFX and reset playback position
local function stopIntermissionSfx()
	if intermissionSfx and intermissionSfx.Playing then
		intermissionSfx:Stop()
		intermissionSfx.TimePosition = 0
	end
end

local function clearIntermissionWarning(reason: string, remaining: number?, phaseEnd: number?, clearWarnedPhase: boolean?)
	local hadWarning = lastWarnedPhaseEnd ~= nil
	local wasPlaying = intermissionSfx ~= nil and intermissionSfx.Playing
	if wasPlaying or hadWarning then
		log(string.format(
			"[IntermissionCountdownSFX] action=stop reason=%s remaining=%.2f phaseEnd=%.2f warned=%s playing=%s",
			reason,
			remaining or -1,
			phaseEnd or -1,
			tostring(hadWarning),
			tostring(wasPlaying)
		))
	end
	stopIntermissionSfx()
	if clearWarnedPhase ~= false then
		lastWarnedPhaseEnd = nil
	end
end

local function syncIntermissionCountdownSfx(reason: string)
	local stateVal = matchStatusStateValue
	local phaseEndVal = matchStatusPhaseEndValue
	if not stateVal or not phaseEndVal then
		return
	end

	local phaseEnd = phaseEndVal.Value
	local remaining = phaseEnd - workspace:GetServerTimeNow()
	local playerState = LocalPlayer:GetAttribute("PlayerState")

	if stateVal.Value ~= "Intermission" then
		clearIntermissionWarning(reason .. "_not_intermission", remaining, phaseEnd, true)
		return
	end

	if playerState == "AFK" then
		clearIntermissionWarning(reason .. "_player_afk", remaining, phaseEnd, true)
		return
	end

	if remaining <= 0.5 then
		clearIntermissionWarning(reason .. "_expired", remaining, phaseEnd, true)
		return
	end

	if remaining > COUNTDOWN_THRESHOLD then
		clearIntermissionWarning(reason .. "_above_threshold", remaining, phaseEnd, true)
		return
	end

	if lastWarnedPhaseEnd == phaseEnd then
		return
	end

	lastWarnedPhaseEnd = phaseEnd
	if intermissionSfx then
		intermissionSfx.Volume = COUNTDOWN_VOLUME
		intermissionSfx:Stop()
		intermissionSfx.TimePosition = 0
		intermissionSfx:Play()
	end
	log(string.format(
		"[IntermissionCountdownSFX] action=start reason=%s remaining=%.2f phaseEnd=%.2f",
		reason,
		remaining,
		phaseEnd
	))
end

-- ═══════════════════════════════════════════════════════════════════
-- LOGGING
-- ═══════════════════════════════════════════════════════════════════

log = function(...)
	print("[MusicController]", ...)
end

local function logState()
	local id = activeSound and activeSound.SoundId or "none"
	local tp = activeSound and string.format("%.1f", activeSound.TimePosition) or "0"
	local vol = activeSound and string.format("%.3f", activeSound.Volume) or "0"
	local soundCount = 0
	for _, child in ipairs(SoundService:GetChildren()) do
		if child:IsA("Sound") then soundCount += 1 end
	end
	local groupCount = 0
	if bgmGroup then
		for _, child in ipairs(bgmGroup:GetChildren()) do
			if child:IsA("Sound") then groupCount += 1 end
		end
	end
	log(string.format("Context=%s nowPlaying=%s timePos=%s volume=%s | SoundService sounds=%d, BGM group sounds=%d",
		tostring(currentContext), id, tp, vol, soundCount, groupCount))
end

local function getInstancePath(instance: Instance?): string
	if not instance then
		return "nil"
	end

	local path = instance.Name
	local current = instance.Parent
	while current do
		path = current.Name .. "." .. path
		current = current.Parent
	end
	return path
end

local function logMusicDiagnostics(stage: string, sound: Sound?, extra: string?)
	if not sound then
		log(string.format("[MapMusicAudit] stage=%s sound=nil %s", stage, extra or ""))
		return
	end

	log(string.format(
		"[MapMusicAudit] stage=%s name=%s id=%s loaded=%s playing=%s time=%.2f volume=%.2f parent=%s %s",
		stage,
		sound.Name,
		sound.SoundId,
		tostring(sound.IsLoaded),
		tostring(sound.Playing),
		sound.TimePosition,
		sound.Volume,
		getInstancePath(sound.Parent),
		extra or ""
	))
end

local function logPossiblePermissionIssue(sound: Sound, stage: string)
	warn(string.format(
		"[MusicController][MapMusicAudit] stage=%s likelyPermissionOrOwnershipIssue=true name=%s id=%s loaded=%s playing=%s volume=%.2f parent=%s",
		stage,
		sound.Name,
		sound.SoundId,
		tostring(sound.IsLoaded),
		tostring(sound.Playing),
		sound.Volume,
		getInstancePath(sound.Parent)
	))
end

-- ═══════════════════════════════════════════════════════════════════
-- LEGACY CLEANUP
-- ═══════════════════════════════════════════════════════════════════

local function purgeLegacySounds()
	local containers = { SoundService, workspace }
	for _, container in ipairs(containers) do
		for _, child in ipairs(container:GetChildren()) do
			if child:IsA("Sound") then
				local isLegacy = LEGACY_SOUND_NAMES[child.Name] or LEGACY_SOUND_IDS[child.SoundId]
				if isLegacy then
					log(string.format("Removed legacy sound: %s %s", child.Name, child.SoundId))
					child:Stop()
					child:Destroy()
				end
			end
			-- Also check inside SoundGroups
			if child:IsA("SoundGroup") then
				for _, sub in ipairs(child:GetChildren()) do
					if sub:IsA("Sound") then
						local isLegacy = LEGACY_SOUND_NAMES[sub.Name] or LEGACY_SOUND_IDS[sub.SoundId]
						if isLegacy then
							log(string.format("Removed legacy sound (in group %s): %s %s", child.Name, sub.Name, sub.SoundId))
							sub:Stop()
							sub:Destroy()
						end
					end
				end
			end
		end
	end
end

-- ═══════════════════════════════════════════════════════════════════
-- CROSSFADE SOUND MANAGEMENT
-- New track fades in while old track fades out simultaneously.
-- Both overlap during the crossfade window → no silent gap.
-- ═══════════════════════════════════════════════════════════════════

local _fadeOutTween: Tween? = nil
local _fadingOutSound: Sound? = nil

local function killActiveSound()
	if activeFadeTween then
		activeFadeTween:Cancel()
		activeFadeTween = nil
	end
	if activeSound then
		activeSound:Stop()
		activeSound:Destroy()
		activeSound = nil
	end
end

local function killFadingOutSound()
	if _fadeOutTween then
		_fadeOutTween:Cancel()
		_fadeOutTween = nil
	end
	if _fadingOutSound then
		_fadingOutSound:Stop()
		_fadingOutSound:Destroy()
		_fadingOutSound = nil
	end
end

local function createMusicSound(name: string, soundId: string, looped: boolean): Sound
	local sound = Instance.new("Sound")
	sound.Name = name
	sound.SoundId = soundId
	sound.Looped = looped
	sound.Volume = 0
	sound.SoundGroup = bgmGroup
	sound.Parent = SoundService
	logMusicDiagnostics("created", sound, string.format("looped=%s", tostring(looped)))
	return sound
end

local function crossfadeTo(newName: string, newId: string, newStart: number, newVolume: number, looped: boolean)
	-- If there's already a sound fading out from a previous crossfade, kill it immediately
	killFadingOutSound()

	-- Cancel any in-progress fade-in on the current active sound
	if activeFadeTween then
		activeFadeTween:Cancel()
		activeFadeTween = nil
	end

	-- Move the current active sound to "fading out" slot
	local oldSound = activeSound
	activeSound = nil

	if oldSound and oldSound.Parent then
		log(string.format("Previous track stopping: name=%s id=%s", oldSound.Name, oldSound.SoundId))
		_fadingOutSound = oldSound
		local fadeOut = TweenService:Create(oldSound, TweenInfo.new(CROSSFADE_TIME, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
			Volume = 0,
		})
		_fadeOutTween = fadeOut
		fadeOut:Play()

		local capturedSound = oldSound
		task.spawn(function()
			fadeOut.Completed:Wait()
			if capturedSound and capturedSound.Parent then
				capturedSound:Stop()
				capturedSound:Destroy()
			end
			if _fadingOutSound == capturedSound then
				_fadingOutSound = nil
				_fadeOutTween = nil
			end
		end)
	end

	-- Create and fade in the new sound immediately (overlaps with old fade-out)
	local newSound = createMusicSound(newName, newId, looped)
	newSound.TimePosition = newStart
	newSound.Volume = 0
	activeSound = newSound

	logMusicDiagnostics("before_play", newSound, string.format("requestedStart=%.2f targetVolume=%.2f", newStart, newVolume))
	newSound:Play()
	logMusicDiagnostics("after_play_call", newSound, string.format("requestedStart=%.2f targetVolume=%.2f", newStart, newVolume))

	if not newSound.IsLoaded then
		task.spawn(function()
			newSound.Loaded:Wait()
			if newSound.Parent then
				logMusicDiagnostics("loaded", newSound, "loaded_event=true")
			end
		end)
	end

	task.delay(2, function()
		if activeSound ~= newSound or not newSound.Parent then
			return
		end
		logMusicDiagnostics("post_play_check", newSound, string.format("requestedStart=%.2f targetVolume=%.2f", newStart, newVolume))
		if not newSound.IsLoaded then
			logPossiblePermissionIssue(newSound, "post_play_check")
		end
	end)

	local fadeIn = TweenService:Create(newSound, TweenInfo.new(CROSSFADE_TIME, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Volume = newVolume,
	})
	activeFadeTween = fadeIn
	fadeIn:Play()

	task.spawn(function()
		fadeIn.Completed:Wait()
		if activeFadeTween == fadeIn then
			activeFadeTween = nil
		end
	end)

	log(string.format("Crossfade → %s (%s at %.0fs vol=%.2f)", newName, newId, newStart, newVolume))
	logState()
end

-- ═══════════════════════════════════════════════════════════════════
-- LOBBY MUSIC
-- ═══════════════════════════════════════════════════════════════════

local function cancelNormalMapPlaylist(reason: string)
	normalPlaylistToken += 1
	if currentContext == "normal_match" then
		log(string.format("[MapMusicAudit] context=normal_match playlistCancelled reason=%s token=%d", reason, normalPlaylistToken))
	end
end

local playNormalMapPlaylistTrack

local function scheduleNormalMapPlaylistAdvance(token: number, trackIndex: number, sound: Sound)
	if #NORMAL_MAP_TRACKS <= 1 then
		return
	end

	task.spawn(function()
		if not sound.IsLoaded then
			sound.Loaded:Wait()
		end
		if normalPlaylistToken ~= token or activeSound ~= sound or currentContext ~= "normal_match" or not sound.Parent then
			return
		end

		local remaining = sound.TimeLength - sound.TimePosition
		if remaining <= 0 then
			remaining = CROSSFADE_TIME
		end
		local advanceDelay = math.max(remaining - CROSSFADE_TIME, 0.1)
		log(string.format(
			"[MapMusicAudit] context=normal_match playlistScheduled track=%d/%d soundId=%s delay=%.2f",
			trackIndex,
			#NORMAL_MAP_TRACKS,
			sound.SoundId,
			advanceDelay
		))

		task.wait(advanceDelay)
		if normalPlaylistToken ~= token or activeSound ~= sound or currentContext ~= "normal_match" or not sound.Parent then
			return
		end

		local nextTrackIndex = (trackIndex % #NORMAL_MAP_TRACKS) + 1
		local nextTrack = NORMAL_MAP_TRACKS[nextTrackIndex]
		log(string.format(
			"[MapMusicAudit] context=normal_match playlistAdvance from=%d to=%d nextSoundId=%s",
			trackIndex,
			nextTrackIndex,
			nextTrack.Id
		))
		playNormalMapPlaylistTrack(token, nextTrackIndex)
	end)
end

playNormalMapPlaylistTrack = function(token: number, trackIndex: number)
	if normalPlaylistToken ~= token or currentContext ~= "normal_match" then
		return
	end

	local track = NORMAL_MAP_TRACKS[trackIndex]
	if not track then
		return
	end

	log(string.format(
		"[MapMusicAudit] context=normal_match playlistTrack=%d/%d selectedSoundId=%s start=%.2f volume=%.2f",
		trackIndex,
		#NORMAL_MAP_TRACKS,
		track.Id,
		track.Start or 0,
		NORMAL_MAP_TRACK_VOLUME
	))
	crossfadeTo(string.format("MapMusic_Normal_%d", trackIndex), track.Id, track.Start or 0, NORMAL_MAP_TRACK_VOLUME, false)

	local scheduledSound = activeSound
	if scheduledSound then
		scheduleNormalMapPlaylistAdvance(token, trackIndex, scheduledSound)
	end
end

local function pickLobbyTrack(): (string, number, number)
	if math.random() < LOBBY_TRACK_A_CHANCE then
		return LOBBY_TRACK_A_ID, LOBBY_TRACK_A_START, LOBBY_TRACK_A_VOLUME
	else
		return LOBBY_TRACK_B_ID, LOBBY_TRACK_B_START, LOBBY_TRACK_B_VOLUME
	end
end

local function startLobby()
	if currentContext == "lobby" then return end
	cancelNormalMapPlaylist("switch_to_lobby")
	currentContext = "lobby"
	log("Context → lobby")

	local trackId, startPos, volume = pickLobbyTrack()
	log(string.format("[MapMusicAudit] context=lobby selectedSoundId=%s start=%.2f volume=%.2f", trackId, startPos, volume))
	crossfadeTo("LobbyMusic", trackId, startPos, volume, true)
end

-- ═══════════════════════════════════════════════════════════════════
-- MAP MUSIC
-- ═══════════════════════════════════════════════════════════════════

local function startNormalMap()
	if currentContext == "normal_match" then return end
	cancelNormalMapPlaylist("restart_normal_playlist")
	currentContext = "normal_match"
	log("Context → normal_match")
	normalPlaylistToken += 1
	log(string.format(
		"[MapMusicAudit] context=normal_match playlistStart tracks=%s volume=%.2f token=%d",
		describeTrackSequence(NORMAL_MAP_TRACKS),
		NORMAL_MAP_TRACK_VOLUME,
		normalPlaylistToken
	))
	if #NORMAL_MAP_TRACKS <= 1 then
		local onlyTrack = NORMAL_MAP_TRACKS[1]
		if onlyTrack then
			crossfadeTo("MapMusic_Normal", onlyTrack.Id, onlyTrack.Start or 0, NORMAL_MAP_TRACK_VOLUME, true)
		end
		return
	end
	playNormalMapPlaylistTrack(normalPlaylistToken, 1)
end

local function startBrainrotMap()
	if currentContext == "brainrot_match" then return end
	cancelNormalMapPlaylist("switch_to_brainrot")
	currentContext = "brainrot_match"
	log("Context → brainrot_match")
	log(string.format("[MapMusicAudit] context=brainrot_match selectedSoundId=%s start=%.2f volume=%.2f", BRAINROT_MAP_TRACK_ID, BRAINROT_MAP_TRACK_START, BRAINROT_MAP_TRACK_VOLUME))
	-- Smooth transition requirement: fade from lobby -> brainrot (and any context switch) via crossfade.
	crossfadeTo("MapMusic_Brainrot", BRAINROT_MAP_TRACK_ID, BRAINROT_MAP_TRACK_START, BRAINROT_MAP_TRACK_VOLUME, true)
end

-- ═══════════════════════════════════════════════════════════════════
-- CONTEXT DETECTION
-- ═══════════════════════════════════════════════════════════════════

local function resolveAudioStateFromContext(state: string?): string
	-- Only players actively in the match hear match music.
	local matchState = matchStatusStateValue and matchStatusStateValue.Value or nil
	local modeVoteActive = modeVoteActiveValue and modeVoteActiveValue.Value == true or false
	if state == PlayerState.States.InMatch and matchState == "Playing" and not modeVoteActive then
		local mode = matchStatusModeValue and matchStatusModeValue.Value or "Normal"
		if mode == "Brainrot" then
			return "BrainrotMatch"
		end
		return "NormalMatch"
	end
	-- Lobby/Waiting/AFK/Spectating/default: lobby music only.
	return "Lobby"
end

local function updateContext()
	local state = LocalPlayer:GetAttribute("PlayerState")
	local audioState = resolveAudioStateFromContext(state)
	if audioState == "NormalMatch" then
		startNormalMap()
	elseif audioState == "BrainrotMatch" then
		startBrainrotMap()
	else
		startLobby()
	end

	if state ~= lastLoggedPlayerState or audioState ~= lastLoggedAudioState then
		lastLoggedPlayerState = state
		lastLoggedAudioState = audioState
		local selectedMusicId = activeSound and activeSound.SoundId or "none"
		log(string.format(
			"[MusicState] player=%s audioState=%s playerState=%s selectedMusicId=%s",
			LocalPlayer.Name,
			audioState,
			tostring(state),
			tostring(selectedMusicId)
		))
	end
end

-- ═══════════════════════════════════════════════════════════════════
-- SFX (persistent, not single-channel)
-- ═══════════════════════════════════════════════════════════════════

local function initSFX()
	-- Win SFX
	winSfx = SoundService:FindFirstChild("WinSFX")
	if not winSfx then
		winSfx = Instance.new("Sound")
		winSfx.Name = "WinSFX"
		winSfx.SoundId = WIN_SFX_ID
		winSfx.Looped = false
		winSfx.Volume = SFX_VOLUME
		winSfx.Parent = SoundService
	end

	-- Intermission countdown SFX
	intermissionSfx = SoundService:FindFirstChild("IntermissionSFX")
	if not intermissionSfx then
		intermissionSfx = Instance.new("Sound")
		intermissionSfx.Name = "IntermissionSFX"
		intermissionSfx.SoundId = INTERMISSION_SFX_ID
		intermissionSfx.Looped = false
		intermissionSfx.Volume = COUNTDOWN_VOLUME
		intermissionSfx.Parent = SoundService
	end

	-- PlaySFX remote
	task.spawn(function()
		local remotes = ReplicatedStorage:WaitForChild("Remotes", 15)
		if not remotes then return end
		local sfxRemote = remotes:WaitForChild("PlaySFX", 15)
		if not sfxRemote then return end

		sfxRemote.OnClientEvent:Connect(function(sfxType: string)
			if (sfxType == "Win" or sfxType == "ObbyComplete") and winSfx then
				winSfx.Volume = SFX_VOLUME
				winSfx:Stop()
				winSfx:Play()
				log("SFX → " .. sfxType)
			end
		end)
	end)
end

-- ═══════════════════════════════════════════════════════════════════
-- INIT
-- ═══════════════════════════════════════════════════════════════════

function MusicController.Init()
	if _initialized then return end
	_initialized = true

	-- 1. Create BGM SoundGroup (SettingsPanel finds this)
	bgmGroup = SoundService:FindFirstChild("BGM")
	if not bgmGroup then
		bgmGroup = Instance.new("SoundGroup")
		bgmGroup.Name = "BGM"
		bgmGroup.Volume = 1
		bgmGroup.Parent = SoundService
	end

	-- 2. Purge ALL legacy sounds (old map music, duplicates)
	purgeLegacySounds()

	-- 3. Init SFX (win + intermission — these are persistent, NOT single-channel)
	initSFX()

	-- 4. Listen for PlayerState changes (primary context signal)
	LocalPlayer:GetAttributeChangedSignal("PlayerState"):Connect(function()
		updateContext()
		syncIntermissionCountdownSfx("player_state_changed")
	end)

	-- 5. Listen for MatchStatus (secondary signal + intermission countdown)
	task.spawn(function()
		local matchStatus = ReplicatedStorage:FindFirstChild("MatchStatus")
		if not matchStatus then
			matchStatus = ReplicatedStorage:WaitForChild("MatchStatus", 15)
		end
		if not matchStatus then
			warn("[MusicController] MatchStatus not found — using PlayerState only")
			return
		end

		local stateVal    = matchStatus:WaitForChild("State", 10)
		local phaseEndVal = matchStatus:WaitForChild("PhaseEndTime", 10)
		local modeVal     = matchStatus:WaitForChild("Mode", 10)
		local voteActiveVal = matchStatus:WaitForChild("ModeVoteActive", 10)
		if stateVal and stateVal:IsA("StringValue") then
			matchStatusStateValue = stateVal
		end
		if phaseEndVal and phaseEndVal:IsA("NumberValue") then
			matchStatusPhaseEndValue = phaseEndVal
		end
		if modeVal and modeVal:IsA("StringValue") then
			matchStatusModeValue = modeVal
			modeVal.Changed:Connect(function()
				-- Re-evaluate per-player routing when selected match mode changes.
				updateContext()
			end)
		end
		if voteActiveVal and voteActiveVal:IsA("BoolValue") then
			modeVoteActiveValue = voteActiveVal
			voteActiveVal.Changed:Connect(function()
				updateContext()
			end)
		end

		if stateVal then
			stateVal.Changed:Connect(function()
				-- MatchStatus is global; do not drive per-player music from it.
				-- Re-evaluate using local authoritative PlayerState only.
				updateContext()
				syncIntermissionCountdownSfx("match_state_changed")
			end)
		end

		if phaseEndVal then
			phaseEndVal.Changed:Connect(function()
				syncIntermissionCountdownSfx("phase_end_changed")
			end)
		end

		-- Intermission countdown SFX stays in sync with replicated state/end time.
		if phaseEndVal and stateVal then
			RunService.Heartbeat:Connect(function()
				syncIntermissionCountdownSfx("heartbeat")
			end)
		end

		syncIntermissionCountdownSfx("match_status_ready")
	end)

	-- 6. Start with correct context immediately
	updateContext()
	log(string.format(
		"[MapMusicAudit] configuredIds lobbyA=%s lobbyB=%s normalMap=%s brainrotMap=%s",
		LOBBY_TRACK_A_ID,
		LOBBY_TRACK_B_ID,
		describeTrackSequence(NORMAL_MAP_TRACKS),
		BRAINROT_MAP_TRACK_ID
	))

	log("Initialized — legacy sounds purged, crossfade active")
	logState()
end

return MusicController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="128">
          <Properties>
            <string name="Name">NextGoalPopupController</string>
            <string name="Source"><![CDATA[--[[
	NextGoalPopupController
	Lightweight lobby/intermission popup for the live next Fate Coin goal.
]]

local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

local Shared = ReplicatedStorage:WaitForChild("Shared", 10)
local MatchState = require(Shared:WaitForChild("MatchState", 10))
local PlayerData = require(Shared:WaitForChild("PlayerData", 10))
local PlayerState = require(Shared:WaitForChild("PlayerState", 10))
local ProgressionGoalResolver = require(Shared:WaitForChild("ProgressionGoalResolver", 10))
local UIConfig = require(Shared:WaitForChild("UIConfig", 10))

local NextGoalPopupController = {}

local POPUP_NAME = "NextGoalPopupGui"
local POPUP_COOLDOWN_SECONDS = 15
local OPEN_Y_OFFSET = UserInputService.TouchEnabled and 84 or 92
local POPUP_WIDTH = UserInputService.TouchEnabled and 316 or 360
local POPUP_HEIGHT = UserInputService.TouchEnabled and 84 or 92
local CLOSED_Y_OFFSET = -(POPUP_HEIGHT + 20)

local initialized = false
local screenGui: ScreenGui? = nil
local popupFrame: Frame? = nil
local titleLabel: TextLabel? = nil
local detailLabel: TextLabel? = nil
local activeTween: Tween? = nil
local matchStateValue: StringValue? = nil
local connectedRemoteNames: { [string]: boolean } = {}
local nextAllowedOpenAt = 0
local reopenToken = 0
local lastLoggedResolutionKey: string? = nil
local scheduleRefresh: (reason: string) -> ()

local function log(message: string)
	print("[NextGoalPopup] " .. message)
end

local function formatCoinCount(value: number): string
	local rounded = math.max(0, math.floor(tonumber(value) or 0))
	local reversed = string.reverse(tostring(rounded))
	local withCommas = string.reverse(reversed:gsub("(%d%d%d)", "%1,"))
	return withCommas:gsub("^,", "")
end

local function formatGoalName(name: string): string
	local formatted = tostring(name or "")
	formatted = formatted:gsub("(%l)(%u)", "%1 %2")
	formatted = formatted:gsub("(%u)(%u%l)", "%1 %2")
	formatted = formatted:gsub("(%d)(%u%l)", "%1 %2")
	formatted = formatted:gsub("%s+", " ")
	formatted = formatted:gsub("^%s+", ""):gsub("%s+$", "")
	return string.upper(formatted)
end

local function decodeOwnedList(attributeName: string): any
	local rawValue = LocalPlayer:GetAttribute(attributeName)
	if type(rawValue) ~= "string" or rawValue == "" then
		return {}
	end

	local ok, decoded = pcall(HttpService.JSONDecode, HttpService, rawValue)
	if ok and type(decoded) == "table" then
		return decoded
	end

	return {}
end

local function resolveNextGoal()
	local attributes = PlayerData.Attributes
	local goal = ProgressionGoalResolver.ResolveNextGoal({
		coins = LocalPlayer:GetAttribute(attributes.Coins) or 0,
		ownedCrowns = decodeOwnedList(attributes.OwnedCrowns),
		ownedPets = decodeOwnedList(attributes.OwnedPets),
	})

	local coins = goal and goal.currentCoins or math.max(0, math.floor(tonumber(LocalPlayer:GetAttribute(attributes.Coins) or 0) or 0))
	local resolutionKey = goal and string.format("%s:%d:%d", goal.id, goal.price, coins) or ("none:" .. tostring(coins))
	if resolutionKey ~= lastLoggedResolutionKey then
		lastLoggedResolutionKey = resolutionKey
		if goal then
			log(string.format("resolved item=%s price=%d coins=%d", goal.id, goal.price, coins))
		else
			log(string.format("resolved item=none coins=%d", coins))
		end
	end

	return goal
end

local function getPopupOpenPosition(): UDim2
	return UDim2.new(0.5, 0, 0, OPEN_Y_OFFSET)
end

local function getPopupClosedPosition(): UDim2
	return UDim2.new(0.5, 0, 0, CLOSED_Y_OFFSET)
end

local function isPopupEligible(): boolean
	local playerState = tostring(LocalPlayer:GetAttribute("PlayerState") or "")
	local matchState = matchStateValue and matchStateValue.Value or ""

	if playerState == PlayerState.States.InMatch then
		return false
	end

	if matchState == MatchState.States.Playing or matchState == MatchState.States.Ending then
		return false
	end

	if matchState == MatchState.States.Intermission then
		return true
	end

	return playerState == PlayerState.States.Lobby
end

local function destroyPopup()
	if activeTween then
		activeTween:Cancel()
		activeTween = nil
	end

	if popupFrame then
		popupFrame:Destroy()
		popupFrame = nil
	end

	titleLabel = nil
	detailLabel = nil
end

local function ensureScreenGui()
	if screenGui and screenGui.Parent then
		return
	end

	screenGui = PlayerGui:FindFirstChild(POPUP_NAME) :: ScreenGui?
	if screenGui then
		screenGui:ClearAllChildren()
	else
		screenGui = Instance.new("ScreenGui")
		screenGui.Name = POPUP_NAME
		screenGui.ResetOnSpawn = false
		screenGui.IgnoreGuiInset = true
		screenGui.DisplayOrder = 55
		screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
		screenGui.Parent = PlayerGui
	end
end

local function updatePopupContent(goal)
	if not titleLabel or not detailLabel then
		return
	end

	titleLabel.Text = "NEXT GOAL: " .. formatGoalName(goal.name)
	detailLabel.Text = string.format(
		"%sF - YOU HAVE %s",
		formatCoinCount(goal.price),
		formatCoinCount(goal.currentCoins)
	)
	detailLabel.TextColor3 = if goal.remainingCoins > 0
		then Color3.fromRGB(255, 224, 122)
		else Color3.fromRGB(146, 244, 176)
end

local function closePopup(manualClose: boolean, reason: string)
	if manualClose then
		nextAllowedOpenAt = math.max(nextAllowedOpenAt, os.clock() + POPUP_COOLDOWN_SECONDS)
		reopenToken += 1
		local token = reopenToken
		task.delay(POPUP_COOLDOWN_SECONDS, function()
			if reopenToken ~= token or popupFrame then
				return
			end
			scheduleRefresh("manual_close_cooldown")
		end)
	end

	if not popupFrame then
		if manualClose then
			log(string.format("popup_closed reason=%s cooldown=%.1fs", reason, POPUP_COOLDOWN_SECONDS))
		end
		return
	end

	if activeTween then
		activeTween:Cancel()
		activeTween = nil
	end

	local frameToClose = popupFrame
	activeTween = TweenService:Create(
		frameToClose,
		TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
		{ Position = getPopupClosedPosition() }
	)
	activeTween:Play()
	activeTween.Completed:Connect(function()
		if popupFrame == frameToClose then
			destroyPopup()
		end
	end)

	log(string.format("popup_closed reason=%s cooldown=%.1fs", reason, manualClose and POPUP_COOLDOWN_SECONDS or 0))
end

local function buildPopup()
	ensureScreenGui()
	destroyPopup()

	local frame = Instance.new("Frame")
	frame.Name = "NextGoalPopup"
	frame.AnchorPoint = Vector2.new(0.5, 0)
	frame.Position = getPopupClosedPosition()
	frame.Size = UDim2.fromOffset(POPUP_WIDTH, POPUP_HEIGHT)
	frame.BackgroundColor3 = Color3.fromRGB(24, 30, 58)
	frame.BackgroundTransparency = 0.06
	frame.BorderSizePixel = 0
	frame.ZIndex = 40
	frame.Parent = screenGui
	popupFrame = frame

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 18)
	corner.Parent = frame

	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(255, 210, 88)
	stroke.Thickness = 1.8
	stroke.Transparency = 0.18
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent = frame

	local gradient = Instance.new("UIGradient")
	gradient.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(48, 60, 104)),
		ColorSequenceKeypoint.new(0.55, Color3.fromRGB(24, 30, 58)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(14, 18, 34)),
	})
	gradient.Rotation = 90
	gradient.Parent = frame

	local shadow = Instance.new("ImageLabel")
	shadow.Name = "Shadow"
	shadow.AnchorPoint = Vector2.new(0.5, 0.5)
	shadow.Position = UDim2.fromScale(0.5, 0.5)
	shadow.Size = UDim2.new(1, 36, 1, 36)
	shadow.BackgroundTransparency = 1
	shadow.Image = "rbxassetid://1316045217"
	shadow.ImageColor3 = Color3.new(0, 0, 0)
	shadow.ImageTransparency = 0.42
	shadow.ScaleType = Enum.ScaleType.Slice
	shadow.SliceCenter = Rect.new(10, 10, 118, 118)
	shadow.ZIndex = 39
	shadow.Parent = frame

	local title = Instance.new("TextLabel")
	title.Name = "Title"
	title.BackgroundTransparency = 1
	title.Position = UDim2.fromOffset(16, 14)
	title.Size = UDim2.new(1, -64, 0, 24)
	title.Font = Enum.Font.GothamBlack
	title.TextColor3 = UIConfig.Colors.TextWhite
	title.TextSize = UserInputService.TouchEnabled and 18 or 20
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.TextTruncate = Enum.TextTruncate.AtEnd
	title.ZIndex = 41
	title.Parent = frame
	titleLabel = title

	local titleStroke = Instance.new("UIStroke")
	titleStroke.Color = Color3.new(0, 0, 0)
	titleStroke.Thickness = 1.5
	titleStroke.Transparency = 0.25
	titleStroke.Parent = title

	local detail = Instance.new("TextLabel")
	detail.Name = "Detail"
	detail.BackgroundTransparency = 1
	detail.Position = UDim2.fromOffset(16, 44)
	detail.Size = UDim2.new(1, -32, 0, 22)
	detail.Font = Enum.Font.GothamBold
	detail.TextColor3 = Color3.fromRGB(255, 224, 122)
	detail.TextSize = UserInputService.TouchEnabled and 13 or 15
	detail.TextXAlignment = Enum.TextXAlignment.Left
	detail.TextTruncate = Enum.TextTruncate.AtEnd
	detail.ZIndex = 41
	detail.Parent = frame
	detailLabel = detail

	local detailStroke = Instance.new("UIStroke")
	detailStroke.Color = Color3.new(0, 0, 0)
	detailStroke.Thickness = 1.2
	detailStroke.Transparency = 0.28
	detailStroke.Parent = detail

	local closeButton = Instance.new("TextButton")
	closeButton.Name = "CloseButton"
	closeButton.AnchorPoint = Vector2.new(1, 0)
	closeButton.Position = UDim2.new(1, -10, 0, 10)
	closeButton.Size = UDim2.fromOffset(28, 28)
	closeButton.BackgroundColor3 = Color3.fromRGB(48, 56, 96)
	closeButton.AutoButtonColor = true
	closeButton.BorderSizePixel = 0
	closeButton.Font = Enum.Font.GothamBlack
	closeButton.Text = "X"
	closeButton.TextColor3 = Color3.fromRGB(255, 255, 255)
	closeButton.TextSize = 14
	closeButton.ZIndex = 42
	closeButton.Parent = frame

	local closeCorner = Instance.new("UICorner")
	closeCorner.CornerRadius = UDim.new(1, 0)
	closeCorner.Parent = closeButton

	local closeStroke = Instance.new("UIStroke")
	closeStroke.Color = Color3.fromRGB(255, 218, 124)
	closeStroke.Thickness = 1.2
	closeStroke.Transparency = 0.28
	closeStroke.Parent = closeButton

	closeButton.MouseButton1Click:Connect(function()
		closePopup(true, "manual_close")
	end)
end

local function openPopup(goal, reason: string)
	buildPopup()
	updatePopupContent(goal)

	if not popupFrame then
		return
	end

	if activeTween then
		activeTween:Cancel()
		activeTween = nil
	end

	activeTween = TweenService:Create(
		popupFrame,
		TweenInfo.new(0.24, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
		{ Position = getPopupOpenPosition() }
	)
	activeTween:Play()
	log(string.format(
		"popup_opened item=%s cost=%d coins=%d reason=%s",
		goal.id,
		goal.price,
		goal.currentCoins,
		reason
	))
end

function scheduleRefresh(reason: string)
	local delaySeconds = math.max(0, nextAllowedOpenAt - os.clock())
	if delaySeconds <= 0 then
		task.defer(function()
			local goal = resolveNextGoal()
			if popupFrame and goal then
				updatePopupContent(goal)
			end

			if not goal or not isPopupEligible() then
				closePopup(false, goal and ("blocked_" .. reason) or ("no_goal_" .. reason))
				return
			end

			if popupFrame then
				return
			end

			openPopup(goal, reason)
		end)
		return
	end

	reopenToken += 1
	local token = reopenToken
	task.delay(delaySeconds, function()
		if reopenToken ~= token or popupFrame then
			return
		end
		scheduleRefresh("cooldown_complete")
	end)
end

local function connectRemote(remotes: Instance, remoteName: string)
	if connectedRemoteNames[remoteName] then
		return
	end

	local remote = remotes:FindFirstChild(remoteName)
	if not remote or not remote:IsA("RemoteEvent") then
		return
	end

	connectedRemoteNames[remoteName] = true
	remote.OnClientEvent:Connect(function()
		scheduleRefresh(remoteName)
	end)
end

function NextGoalPopupController.Init()
	if initialized then
		return
	end
	initialized = true

	ensureScreenGui()

	LocalPlayer:GetAttributeChangedSignal(PlayerData.Attributes.Coins):Connect(function()
		scheduleRefresh("coins_changed")
	end)
	LocalPlayer:GetAttributeChangedSignal(PlayerData.Attributes.OwnedCrowns):Connect(function()
		scheduleRefresh("owned_crowns_changed")
	end)
	LocalPlayer:GetAttributeChangedSignal(PlayerData.Attributes.OwnedPets):Connect(function()
		scheduleRefresh("owned_pets_changed")
	end)
	LocalPlayer:GetAttributeChangedSignal("PlayerState"):Connect(function()
		scheduleRefresh("player_state_changed")
	end)

	task.spawn(function()
		local matchStatus = ReplicatedStorage:WaitForChild("MatchStatus", 15)
		if not matchStatus then
			warn("[NextGoalPopup] MatchStatus not found")
			return
		end

		matchStateValue = matchStatus:WaitForChild("State", 10) :: StringValue?
		if matchStateValue then
			matchStateValue.Changed:Connect(function()
				scheduleRefresh("match_state_changed")
			end)
		end

		scheduleRefresh("match_status_ready")
	end)

	task.spawn(function()
		local remotes = ReplicatedStorage:WaitForChild("Remotes", 15)
		if not remotes then
			warn("[NextGoalPopup] Remotes not found")
			return
		end

		connectRemote(remotes, "InventoryUpdated")
		connectRemote(remotes, "PurchaseGranted")

		remotes.ChildAdded:Connect(function(child)
			if child.Name == "InventoryUpdated" or child.Name == "PurchaseGranted" then
				connectRemote(remotes, child.Name)
			end
		end)
	end)

	scheduleRefresh("init")
end

return NextGoalPopupController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="129">
          <Properties>
            <string name="Name">PaidFreezeNoticeController</string>
            <string name="Source"><![CDATA[--[[
	PaidFreezeNoticeController
	Dedicated UI path for developer-product targeted freeze notice.
	Separated from FreezeIndicatorController so gameplay freeze UI cannot interrupt it.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local PaidFreezeNoticeController = {}

local screenGui: ScreenGui? = nil
local noticeLabel: TextLabel? = nil
local countdownLabel: TextLabel? = nil
local noticeStroke: UIStroke? = nil
local noticeThread: thread? = nil

local function cancelNoticeThread()
	if noticeThread then
		pcall(task.cancel, noticeThread)
		noticeThread = nil
	end
end

local function ensureGui()
	if screenGui and screenGui.Parent and noticeLabel then
		return
	end
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui", 10)
	if not playerGui then
		return
	end

	screenGui = Instance.new("ScreenGui")
	screenGui.Name = "PaidFreezeNoticeGui"
	screenGui.ResetOnSpawn = false
	screenGui.DisplayOrder = 81
	screenGui.IgnoreGuiInset = true
	screenGui.Enabled = false
	screenGui.Parent = playerGui

	noticeLabel = Instance.new("TextLabel")
	noticeLabel.Name = "PaidFreezeNotice"
	noticeLabel.AnchorPoint = Vector2.new(0.5, 0)
	noticeLabel.Position = UDim2.new(0.5, 0, 0.44, 0)
	noticeLabel.Size = UDim2.new(0.9, 0, 0, 42)
	noticeLabel.BackgroundTransparency = 1
	noticeLabel.Font = Enum.Font.GothamBold
	noticeLabel.Text = ""
	noticeLabel.TextSize = 30
	noticeLabel.TextColor3 = Color3.fromRGB(175, 220, 255)
	noticeLabel.TextTransparency = 1
	noticeLabel.TextScaled = false
	noticeLabel.ZIndex = 2
	noticeLabel.Parent = screenGui

	countdownLabel = Instance.new("TextLabel")
	countdownLabel.Name = "PaidFreezeCountdown"
	countdownLabel.AnchorPoint = Vector2.new(0.5, 0)
	countdownLabel.Position = UDim2.new(0.5, 0, 0.50, 0)
	countdownLabel.Size = UDim2.new(0.5, 0, 0, 32)
	countdownLabel.BackgroundTransparency = 1
	countdownLabel.Font = Enum.Font.GothamBlack
	countdownLabel.Text = ""
	countdownLabel.TextSize = 26
	countdownLabel.TextColor3 = Color3.fromRGB(235, 245, 255)
	countdownLabel.TextTransparency = 1
	countdownLabel.TextScaled = false
	countdownLabel.ZIndex = 2
	countdownLabel.Parent = screenGui

	noticeStroke = Instance.new("UIStroke")
	noticeStroke.Color = Color3.fromRGB(25, 55, 85)
	noticeStroke.Thickness = 2
	noticeStroke.Transparency = 1
	noticeStroke.Parent = noticeLabel
end

local function showNotice(freezerName: string?, durationSeconds: number?)
	if not screenGui or not noticeLabel then
		return
	end
	cancelNoticeThread()

	local freezer = tostring(freezerName or "Someone")
	local duration = math.max(0.5, tonumber(durationSeconds) or 13.6)

	noticeLabel.Text = string.format("%s has frozen you!", freezer)
	if countdownLabel then
		countdownLabel.Text = string.format("Unfreezes in %ds", math.ceil(duration))
	end
	noticeLabel.TextTransparency = 1
	if countdownLabel then
		countdownLabel.TextTransparency = 1
	end
	if noticeStroke then
		noticeStroke.Transparency = 1
	end
	screenGui.Enabled = true

	local fadeIn = TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	TweenService:Create(noticeLabel, fadeIn, { TextTransparency = 0 }):Play()
	if countdownLabel then
		TweenService:Create(countdownLabel, fadeIn, { TextTransparency = 0 }):Play()
	end
	if noticeStroke then
		TweenService:Create(noticeStroke, fadeIn, { Transparency = 0.1 }):Play()
	end
	print(string.format("[PaidFreezeUI] shown freezer=%s duration=%.2fs", freezer, duration))

	noticeThread = task.spawn(function()
		local startAt = tick()
		local endAt = startAt + duration
		while tick() < endAt do
			local remaining = math.max(0, endAt - tick())
			if countdownLabel then
				countdownLabel.Text = string.format("Unfreezes in %ds", math.ceil(remaining))
			end
			task.wait(0.1)
		end
		local fadeOut = TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		TweenService:Create(noticeLabel, fadeOut, { TextTransparency = 1 }):Play()
		if countdownLabel then
			TweenService:Create(countdownLabel, fadeOut, { TextTransparency = 1 }):Play()
		end
		if noticeStroke then
			TweenService:Create(noticeStroke, fadeOut, { Transparency = 1 }):Play()
		end
		task.wait(0.3)
		if screenGui then
			screenGui.Enabled = false
		end
		noticeThread = nil
		print("[PaidFreezeUI] hidden reason=duration_elapsed")
	end)
end

local function hideNotice(reason: string?)
	if not screenGui or not noticeLabel then
		return
	end
	cancelNoticeThread()
	local hideReason = tostring(reason or "server")
	local fadeOut = TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	TweenService:Create(noticeLabel, fadeOut, { TextTransparency = 1 }):Play()
	if countdownLabel then
		TweenService:Create(countdownLabel, fadeOut, { TextTransparency = 1 }):Play()
	end
	if noticeStroke then
		TweenService:Create(noticeStroke, fadeOut, { Transparency = 1 }):Play()
	end
	task.spawn(function()
		task.wait(0.25)
		if screenGui then
			screenGui.Enabled = false
		end
	end)
	print(string.format("[PaidFreezeUI] hidden reason=%s", hideReason))
end

function PaidFreezeNoticeController.Init()
	ensureGui()
	local remotes = ReplicatedStorage:WaitForChild("Remotes", 10)
	if not remotes then
		warn("[PaidFreezeUI] Remotes folder not found")
		return
	end
	local remote = remotes:WaitForChild("PaidFreezeNotice", 10)
	if not remote or not remote:IsA("RemoteEvent") then
		warn("[PaidFreezeUI] PaidFreezeNotice remote missing")
		return
	end

	remote.OnClientEvent:Connect(function(action: string, arg1: any, arg2: any)
		if action == "Show" then
			showNotice(arg1, arg2)
		elseif action == "Hide" then
			hideNotice(arg1)
		end
	end)

	print("[PaidFreezeUI] Initialized")
end

return PaidFreezeNoticeController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="130">
          <Properties>
            <string name="Name">PaidFreezeOverheadController</string>
            <string name="Source"><![CDATA[--[[
	PaidFreezeOverheadController
	Shows a small overhead freeze icon above players frozen by the paid freeze product.
	Visibility is driven by replicated player attribute RoundLockedFreeze.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local PaidFreezeOverheadController = {}

local ICON_GUI_NAME = "PaidFreezeOverheadIcon"
local localPlayer = Players.LocalPlayer

local matchStatusFolder: Folder? = nil
local matchStateValue: StringValue? = nil

local playerConns: { [Player]: { RBXScriptConnection } } = {}

local function ensureMatchStatusRefs()
	if matchStatusFolder and matchStatusFolder.Parent and matchStateValue then
		return
	end
	local inst = ReplicatedStorage:FindFirstChild("MatchStatus")
	if not inst then
		inst = ReplicatedStorage:WaitForChild("MatchStatus", 10)
	end
	if not inst then
		return
	end
	matchStatusFolder = inst :: Folder
	local state = matchStatusFolder:FindFirstChild("State")
	if state and state:IsA("StringValue") then
		matchStateValue = state
	end
end

local function shouldRenderForLocalPlayer(): boolean
	ensureMatchStatusRefs()
	if localPlayer:GetAttribute("PlayerState") ~= "InMatch" then
		return false
	end
	if matchStateValue and matchStateValue.Value ~= "Playing" then
		return false
	end
	return true
end

local function getAttachmentPart(player: Player): BasePart?
	local character = player.Character
	if not character then
		return nil
	end
	local head = character:FindFirstChild("Head")
	if head and head:IsA("BasePart") then
		return head
	end
	local hrp = character:FindFirstChild("HumanoidRootPart")
	if hrp and hrp:IsA("BasePart") then
		return hrp
	end
	return nil
end

local function removeIcon(player: Player)
	local part = getAttachmentPart(player)
	if not part then
		return
	end
	local existing = part:FindFirstChild(ICON_GUI_NAME)
	if existing then
		existing:Destroy()
	end
end

local function applyIcon(player: Player)
	local part = getAttachmentPart(player)
	if not part then
		return
	end
	local existing = part:FindFirstChild(ICON_GUI_NAME)
	if existing and existing:IsA("BillboardGui") then
		return
	end
	if existing then
		existing:Destroy()
	end

	local billboard = Instance.new("BillboardGui")
	billboard.Name = ICON_GUI_NAME
	billboard.Size = UDim2.fromOffset(36, 36)
	billboard.StudsOffset = Vector3.new(0, 2.8, 0)
	billboard.AlwaysOnTop = true
	billboard.MaxDistance = 120
	billboard.LightInfluence = 0
	billboard.Parent = part

	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.GothamBlack
	label.Text = "❄"
	label.TextScaled = true
	label.TextColor3 = Color3.fromRGB(170, 225, 255)
	label.TextStrokeColor3 = Color3.fromRGB(20, 55, 85)
	label.TextStrokeTransparency = 0.1
	label.Parent = billboard
end

local function updatePlayerIcon(player: Player)
	if player == localPlayer then
		removeIcon(player)
		return
	end

	local isFrozenByPaid = player:GetAttribute("RoundLockedFreeze") == true
	if not isFrozenByPaid then
		removeIcon(player)
		return
	end
	if player:GetAttribute("PlayerState") ~= "InMatch" then
		removeIcon(player)
		return
	end
	if not shouldRenderForLocalPlayer() then
		removeIcon(player)
		return
	end
	applyIcon(player)
end

local function connectPlayer(player: Player)
	local conns = {}
	playerConns[player] = conns

	table.insert(conns, player:GetAttributeChangedSignal("RoundLockedFreeze"):Connect(function()
		updatePlayerIcon(player)
	end))
	table.insert(conns, player:GetAttributeChangedSignal("PlayerState"):Connect(function()
		updatePlayerIcon(player)
	end))
	table.insert(conns, player.CharacterAdded:Connect(function()
		task.delay(0.1, function()
			updatePlayerIcon(player)
		end)
	end))
	table.insert(conns, player.CharacterRemoving:Connect(function()
		removeIcon(player)
	end))

	updatePlayerIcon(player)
end

local function disconnectPlayer(player: Player)
	removeIcon(player)
	local conns = playerConns[player]
	if not conns then
		return
	end
	for _, conn in ipairs(conns) do
		conn:Disconnect()
	end
	playerConns[player] = nil
end

function PaidFreezeOverheadController.Init()
	ensureMatchStatusRefs()

	Players.PlayerAdded:Connect(connectPlayer)
	Players.PlayerRemoving:Connect(disconnectPlayer)

	for _, player in ipairs(Players:GetPlayers()) do
		connectPlayer(player)
	end

	if localPlayer then
		localPlayer:GetAttributeChangedSignal("PlayerState"):Connect(function()
			for _, player in ipairs(Players:GetPlayers()) do
				updatePlayerIcon(player)
			end
		end)
	end
	if matchStateValue then
		matchStateValue.Changed:Connect(function()
			for _, player in ipairs(Players:GetPlayers()) do
				updatePlayerIcon(player)
			end
		end)
	end

	print("[PaidFreezeOverhead] Initialized")
end

return PaidFreezeOverheadController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="131">
          <Properties>
            <string name="Name">PetFollowController</string>
            <string name="Source"><![CDATA[--[[
	PetFollowController
	Owner-follow brain that reuses LocomotionController (TungTung-style MoveTo flow).
]]

local RunService = game:GetService("RunService")
local LocomotionController = require(script.Parent:WaitForChild("LocomotionController"))

local PetFollowController = {}

local DEFAULTS = {
	FollowDistance = 5,
	SideOffset = 0,
	BackOffset = 0,
	StopDistance = 3.0,
	RepathThreshold = 1.5,
	UpdateInterval = 0.15,
	TeleportDistance = 60,
	WalkSpeed = 14,
	HipHeight = 2.0,
}

export type FollowHandle = {
	Destroy: (self: FollowHandle) -> (),
	IsWalkAnimLoaded: (self: FollowHandle) -> boolean,
	IsIdleAnimLoaded: (self: FollowHandle) -> boolean,
}

function PetFollowController.Start(model: Model, owner: Player, petId: string, opts): FollowHandle?
	if not model or not owner then return nil end
	opts = opts or {}

	local cfg = {
		FollowDistance = opts.FollowDistance or DEFAULTS.FollowDistance,
		SideOffset = opts.SideOffset or DEFAULTS.SideOffset,
		BackOffset = opts.BackOffset or DEFAULTS.BackOffset,
		StopDistance = opts.StopDistance or DEFAULTS.StopDistance,
		RepathThreshold = opts.RepathThreshold or DEFAULTS.RepathThreshold,
		UpdateInterval = opts.UpdateInterval or DEFAULTS.UpdateInterval,
		TeleportDistance = opts.TeleportDistance or DEFAULTS.TeleportDistance,
		WalkSpeed = opts.WalkSpeed or DEFAULTS.WalkSpeed,
		HipHeight = opts.HipHeight or DEFAULTS.HipHeight,
		WalkAnimId = opts.WalkAnimId,
		IdleAnimId = opts.IdleAnimId,
	}

	local loco = LocomotionController.new(model, cfg)
	local acc = 0

	local conn = RunService.Heartbeat:Connect(function(dt)
		acc += dt
		if acc < cfg.UpdateInterval then
			return
		end
		acc = 0

		if not model.Parent then
			return
		end

		local char = owner.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		if not hrp or not hrp:IsA("BasePart") then
			loco:Stop()
			return
		end

		local followPos =
			hrp.Position
			+ (hrp.CFrame.LookVector * -cfg.FollowDistance)
			+ (hrp.CFrame.RightVector * cfg.SideOffset)
			+ Vector3.new(0, 0, cfg.BackOffset)

		local petPos = loco:GetPosition()
		if not petPos then
			return
		end

		local dist = (followPos - petPos).Magnitude
		if dist > cfg.TeleportDistance or petPos.Y < -50 then
			loco:Teleport(CFrame.new(followPos))
			return
		end

		if dist > cfg.StopDistance then
			-- TungTung-style pipeline: brain requests target at interval;
			-- locomotion controller handles repath throttling and target-move delta.
			loco:MoveTo(followPos)
		else
			loco:Stop()
		end
	end)


	local handle = {}
	function handle:Destroy()
		if conn then conn:Disconnect() end
		if loco then loco:Destroy() end
	end
	function handle:IsWalkAnimLoaded(): boolean
		return loco and loco:IsWalkAnimLoaded() or false
	end
	function handle:IsIdleAnimLoaded(): boolean
		return loco and loco:IsIdleAnimLoaded() or false
	end
	return handle
end

return PetFollowController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="132">
          <Properties>
            <string name="Name">PetFollowerController</string>
            <string name="Source"><![CDATA[--[[
	PetFollowerController
	Client-side pet follower — spawns equipped pet models for ALL visible
	players, with smooth follow + bobble animation.

	Each client renders pets for every player (reads their EquippedPet
	attribute). This keeps movement smooth while remaining server-authoritative
	for what is equipped.

	Follow behavior:
	  - Position = HumanoidRootPart * scaled offset + vertical bobble
	  - Orientation = HRP yaw (so pet faces same direction as player)
	  - Per-pet YawOffset for models whose forward axis differs
	  - Lerp each frame for smooth motion

	Pet models:
	  - Cloned from ItemModelRegistry (same source as thumbnails)
	  - All parts Anchored, CanCollide/CanQuery/CanTouch = false
	  - VFX (ParticleEmitters etc.) kept enabled (they work in Workspace)
	  - Forced to a max bounding-box size at spawn (smaller than player)

	Handles:
	  - Equip / unequip / swap (only one pet per player)
	  - Character respawn (re-spawns pet after respawn)
	  - Player leaving (cleans up pet)

	API:
	  PetFollowerController.Init()
]]

local Players           = game:GetService("Players")
local RunService        = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared            = ReplicatedStorage:WaitForChild("Shared")
local UIConfig          = require(Shared:WaitForChild("UIConfig"))
local ItemCatalog       = require(Shared:WaitForChild("ItemCatalog"))
local ItemModelRegistry = require(Shared:WaitForChild("ItemModelRegistry"))
local PetVisualConfig   = require(Shared:WaitForChild("PetVisualConfig"))
local ItemModelsFolder  = ReplicatedStorage:WaitForChild("ItemModels")

-- Walker pet remotes — server owns all physics/animation for walkers.
local _remotes       = ReplicatedStorage:WaitForChild("Remotes")
local _equipRemote   = _remotes:WaitForChild("EquipWalkerPet")
local _unequipRemote = _remotes:WaitForChild("UnequipWalkerPet")

local TAG = "[PetFollower]"
local PET_INSTANCE_NAME = "_EquippedPet"
local TUNGTUNG_PET_ID = "pet_tungtungsahur"
local FURRYHUGS_PET_ID = "pet_huggy_wuggy"

local PetFollowerController = {}

-- =====================================================================
-- FOLLOW TUNING
-- =====================================================================

local PET_OFFSET          = CFrame.new(3, 2.5, 2)   -- offset from HumanoidRootPart
local LERP_ALPHA          = 0.08                      -- interpolation speed per frame
local BOBBLE_SPEED        = 3.0                       -- vertical sine frequency
local BOBBLE_AMPLITUDE    = 0.4                       -- vertical sine amplitude (studs)
local YAW_WOBBLE_SPEED    = 1.5
local YAW_WOBBLE_AMP      = 5                         -- degrees
local ROLL_WOBBLE_SPEED   = 2.0
local ROLL_WOBBLE_AMP     = 3                         -- degrees

-- =====================================================================
-- PER-PET OVERRIDES
-- =====================================================================

-- Yaw correction (degrees) for models whose local "face" points the wrong way.
-- When a pet looks backwards while the player faces the camera, add 180 here.
-- When sideways, add 90 or -90, etc.  Default (absent) = 0.
-- Most Blender-exported models face +Z; Roblox forward is -Z → 180° flip.
local PET_YAW_OFFSET_DEG: { [string]: number } = {
	pet_dog              = 180,
	pet_crocodile        = 180,
	pet_rabbit           = 180,
	pet_eagle            = 180,
	pet_scorpion         = 180,
	pet_shark            = -90,  -- faces along X-axis, not Z
	pet_bat              = 180,
	pet_dolphin          = 180,
	pet_pink_butterfly   = -90,  -- faces along X-axis, not Z
	-- Steve rig forward axis requires inverse yaw to face forward in float mode.
	pet_steve            = -90,
	-- Chica float rig forward axis differs; lock with explicit yaw correction.
	pet_chica            = -90,
	-- NOTE: pet_the_puppet rotation handled via PetVisualConfig.OVERRIDES
}

-- Pets that should not receive roll wobble (keeps large/rigged models visually stable).
local PET_NO_ROLL_WOBBLE: { [string]: boolean } = {
	pet_chica            = true,
	pet_foxy             = true,
	pet_bonnie           = true,
	pet_freddy_fazbear   = true,
	pet_golden_freddy    = true,
	pet_the_puppet       = true,
	pet_cupcake          = true,
}

-- Scale override: bypasses auto-scaling for models that need special treatment.
-- Value is used as a raw multiplier on the model's original scale.
local PET_SCALE_OVERRIDES: { [string]: number } = {
	-- Keep base normalization path unchanged for these; massive scaling is applied
	-- later at final spawn stage so it cannot be re-normalized back down.
	pet_huggy_wuggy = 1.0,
	pet_glitched_dragon = 1.0,
	pet_dark_falcon = 1.0,        -- Dark Goblem
	pet_pink_butterfly = 1.0,
	pet_dark_winged_dragon = 1.0, -- Music Winged Dragon
}

local PET_MASSIVE_SCALE_TARGETS: { [string]: boolean } = {
	pet_glitched_dragon = true,
	pet_dark_falcon = true,
	pet_pink_butterfly = true,
	pet_dark_winged_dragon = true,
}

local PET_FINAL_SPAWN_SCALE_MULTIPLIER: { [string]: number } = {
	pet_huggy_wuggy = 1.8,
	pet_glitched_dragon = 3.5, -- slight shrink only
	pet_dark_falcon = 2.8,        -- Dark Goblem
	pet_pink_butterfly = 2.6,
	pet_dark_winged_dragon = 2.8, -- Music Winged Dragon
}

local MOVEMENT_HOVER = "HOVER"
local MOVEMENT_WALKER = "WALKER_R15"
local MOVEMENT_SERVER_MOTOR = "SERVER_MOTOR_RIG"

local SERVER_MOTOR_PET_IDS: { [string]: boolean } = {
	pet_pink_butterfly = true,
	pet_glitched_dragon = true,
	pet_dark_winged_dragon = true, -- Music Winged Dragon
	pet_dark_falcon = true, -- Dark Goblem
}

local PET_MOVEMENT_TYPE: { [string]: string } = {
	-- Reverted to floating/bobble path
	Bonnie = MOVEMENT_HOVER,
	Chica = MOVEMENT_HOVER,
	Foxy = MOVEMENT_HOVER,
	FreddyFazbear = MOVEMENT_HOVER,

	-- HOVERS (must remain existing bobble path)
	GoldenFreddy = MOVEMENT_HOVER,
	ThePuppet = MOVEMENT_HOVER,
	Cupcake = MOVEMENT_HOVER,
}

-- FNAF pets explicitly reverted to floating companions.
local FNAF_REVERTED_FLOAT_IDS: { [string]: boolean } = {
	-- Keep empty: reverted float pets should use the normal anchored hover
	-- follower path for runtime stability during match transitions.
}

-- Final follow-transform rotation fixes for hover-only path.
local PET_ROTATION_FIX: { [string]: CFrame } = {
	-- Chica tilt is lateral in float mode; correct on roll axis.
	pet_chica = CFrame.Angles(0, 0, math.rad(14)),
}

-- Explicit equip offsets for outlier models only.
-- Mirrors the existing "finalCF = uprightCF * perPetOffset" pattern.
local PET_EQUIP_OFFSET_CFRAME: { [string]: CFrame } = {
	-- Huggy also needs a small vertical settle to avoid appearing offset.
	pet_huggy_wuggy = CFrame.new(0, -0.35, 0) * CFrame.Angles(0, math.rad(180), 0),
}

-- Deterministic orientation target list (ONLY these pets).
local DETERMINISTIC_PET_IDS: { [string]: boolean } = {
	pet_crocodile = true,
	pet_shark = true,
	pet_dog = true,
	pet_parrot = true,
	pet_penguin = true,
	pet_rabbit = true,
	pet_eagle = true,
	pet_ray_fish = true,
	pet_scorpion = true,
	pet_spider = true,
	pet_axolotl = true,
	pet_bat = true,
	pet_fredbear_plush = true,
	pet_steve = true,
	pet_huggy_wuggy = true,
	pet_glitched_dragon = true,
	pet_dark_falcon = true,
	pet_pink_butterfly = true,
	pet_dark_winged_dragon = true,
}

-- Per-pet deterministic rotation overrides (identity by default).
-- Only listed pets are allowed here.
local PET_DETERMINISTIC_ROTATION_OVERRIDES: { [string]: CFrame } = {
	pet_crocodile = CFrame.new(),
	pet_shark = CFrame.new(),
	pet_dog = CFrame.new(),
	pet_parrot = CFrame.new(),
	pet_penguin = CFrame.new(),
	pet_rabbit = CFrame.new(),
	pet_eagle = CFrame.new(),
	pet_ray_fish = CFrame.new(),
	pet_scorpion = CFrame.Angles(0, math.rad(180), 0),
	pet_spider = CFrame.new(),
	pet_axolotl = CFrame.new(),
	pet_bat = CFrame.new(),
	pet_fredbear_plush = CFrame.Angles(0, math.rad(-90), 0),
	pet_steve = CFrame.new(),
	pet_huggy_wuggy = CFrame.Angles(0, math.rad(180), 0),
	pet_glitched_dragon = CFrame.Angles(0, math.rad(90), 0),
	pet_dark_falcon = CFrame.Angles(0, math.rad(180), 0),
	pet_pink_butterfly = CFrame.new(),
	pet_dark_winged_dragon = CFrame.new(),
}

-- =====================================================================
-- SIZE NORMALIZATION
-- =====================================================================

local TARGET_MAX_DIM = 3.0   -- max bounding-box dimension (studs); player is ~5
local SCALE_FLOOR    = 0.02  -- never scale below this (prevents invisible pets)
local SCALE_CEIL     = 1.0   -- never scale above original size

local TUNGTUNG_EMOTE_INTERVAL_MIN = 10
local TUNGTUNG_EMOTE_INTERVAL_MAX = 18
local TUNGTUNG_EMOTE_PRIORITY = Enum.AnimationPriority.Action4
local TUNGTUNG_DEBUG_TAG = "[TungTungPetEmote]"
local TUNGTUNG_TRACK_READY_TIMEOUT = 1.0
local TUNGTUNG_EMOTE_FADE_IN = 0.28
local TUNGTUNG_EMOTE_FADE_OUT = 0.24
local TUNGTUNG_EMOTE_PRE_BLEND_WAIT = 0.08
local TUNGTUNG_EMOTE_POST_BLEND_HOLD = 0.16
local TUNGTUNG_EMOTE_ROOT_LERP_ALPHA = 0.32
local TUNGTUNG_LAUGH_ALIASES = { "laugh", "laughing", "emote_laugh" }
local TUNGTUNG_LAUGH_FALLBACK_IDS = {
	"rbxassetid://507770818",
}
local TUNGTUNG_LAUGH_FADE_IN = 0.15
local TUNGTUNG_LAUGH_FADE_OUT = 0.18
local TUNGTUNG_LAUGH_DEFAULT_DURATION = 2.2
local TUNGTUNG_EMOTE_SPECS = {
	{
		label = "Dance1",
		aliases = { "dance1", "dance" },
		fallbackIds = {
			"rbxassetid://507771019",
			"rbxassetid://507771955",
			"rbxassetid://507772104",
		},
		looped = true,
		duration = 4.8,
	},
	{
		label = "Dance2",
		aliases = { "dance2" },
		fallbackIds = {
			"rbxassetid://507776043",
			"rbxassetid://507776720",
			"rbxassetid://507776879",
		},
		looped = true,
		duration = 4.8,
	},
	{
		label = "Dance3",
		aliases = { "dance3" },
		fallbackIds = {
			"rbxassetid://507777268",
			"rbxassetid://507777451",
			"rbxassetid://507777623",
		},
		looped = true,
		duration = 4.8,
	},
}
local SHARED_PET_EMOTE_IDS = {
	[TUNGTUNG_PET_ID] = true,
	[FURRYHUGS_PET_ID] = true,
}
local PET_EMOTE_ROOT_DRIVE_IDS = {
	[TUNGTUNG_PET_ID] = true,
}

-- =====================================================================
-- STATE (per-player pet tracking)
-- =====================================================================

local _activePets: { [Player]: {
	pet: Instance?,
	conn: RBXScriptConnection?,
	pos: Vector3,
	t0: number,
	mover: any?,
	emoteThread: thread?,
	emoteActive: boolean?,
	emoteTrack: AnimationTrack?,
	emoteRoot: BasePart?,
	_isWalker: boolean?,
	_walkerPetId: string?,
	_isServerMotor: boolean?,
	_serverMotorPetId: string?,
} } = {}

local _playerConns: { [Player]: { RBXScriptConnection } } = {}
local _matchRoundConn: RBXScriptConnection? = nil
local _killFeedConn: RBXScriptConnection? = nil
local _trackedRoundNumber = 0
local _sawDeathThisRound = false
local _laughedThisRound = false

local DEBUG_LOGS = RunService:IsStudio() and UIConfig.DebugLogs == true
local LOG_RATE_SECONDS = tonumber(UIConfig.LogRateSeconds) or 20
local _lastLogByKey: { [string]: number } = {}
local _countByKey: { [string]: number } = {}

local function shouldLog(key: string, everySeconds: number?, everyN: number?): boolean
	if not DEBUG_LOGS then
		return false
	end
	local now = tick()
	local minInterval = everySeconds or LOG_RATE_SECONDS
	local last = _lastLogByKey[key] or 0
	if now - last >= minInterval then
		_lastLogByKey[key] = now
		_countByKey[key] = (_countByKey[key] or 0) + 1
		return true
	end
	if everyN and everyN > 0 then
		local count = (_countByKey[key] or 0) + 1
		_countByKey[key] = count
		if count % everyN == 0 then
			_lastLogByKey[key] = now
			return true
		end
	end
	return false
end

local function log(key: string, ...)
	if shouldLog(key) then
		print(TAG, ...)
	end
end

-- =====================================================================
-- HELPERS
-- =====================================================================

--- Get the bounding-box size of a model (or BasePart).
--- Returns nil on failure.
local function getBBoxSize(inst: Instance): Vector3?
	if inst:IsA("Model") then
		local ok, _, sz = pcall(inst.GetBoundingBox, inst)
		if ok and typeof(sz) == "Vector3" then return sz end
		-- Fallback to GetExtentsSize
		local ok2, ext = pcall(inst.GetExtentsSize, inst)
		if ok2 and typeof(ext) == "Vector3" then return ext end
		return nil
	elseif inst:IsA("BasePart") then
		return inst.Size
	end
	return nil
end

--- Apply uniform scale to a model or part.  Returns true on success.
--- For Models: prefers ScaleTo, falls back to manual descendant scaling.
--- For BaseParts: scales Size + SpecialMesh.Scale + Attachment positions.
local function applyScale(inst: Instance, factor: number): boolean
	if factor == 1 then return true end
	if inst:IsA("Model") then
		local ok = pcall(function()
			local cur = inst:GetScale()
			inst:ScaleTo(cur * factor)
		end)
		if ok then return true end
		-- Fallback: scale descendants manually
		for _, d in ipairs(inst:GetDescendants()) do
			if d:IsA("BasePart") then
				d.Size = d.Size * factor
			elseif d:IsA("DataModelMesh") then
				d.Scale = d.Scale * factor
				if d:FindFirstAncestorWhichIsA("BasePart") then
					d.Offset = d.Offset * factor
				end
			elseif d:IsA("Attachment") then
				d.Position = d.Position * factor
			end
		end
		return true
	elseif inst:IsA("BasePart") then
		inst.Size = inst.Size * factor
		-- Also scale child meshes (SpecialMesh etc.) and attachments
		for _, d in ipairs(inst:GetDescendants()) do
			if d:IsA("DataModelMesh") then
				d.Scale = d.Scale * factor
				d.Offset = d.Offset * factor
			elseif d:IsA("Attachment") then
				d.Position = d.Position * factor
			end
		end
		return true
	end
	return false
end

--- Extract yaw-only (Y-axis rotation) from a CFrame.
local function yawOnly(cf: CFrame): number
	local _, ry, _ = cf:ToEulerAnglesYXZ()
	return ry
end

-- =====================================================================
-- PET SPAWN / DESTROY
-- =====================================================================

local function getPetDef(petId: string)
	if not petId or petId == "" then return nil end
	return ItemCatalog.Pets and ItemCatalog.Pets[petId]
end

local function getConfiguredPetModelName(petId: string, petDef): string
	if petDef and typeof(petDef.modelName) == "string" and petDef.modelName ~= "" then
		return petDef.modelName
	end
	if petDef and typeof(petDef.name) == "string" and petDef.name ~= "" then
		return petDef.name
	end
	return petId
end

local function getMovementType(petId: string, petDef): string
	if SERVER_MOTOR_PET_IDS[petId] then
		return MOVEMENT_SERVER_MOTOR
	end
	local modelName = getConfiguredPetModelName(petId, petDef)
	local explicit = PET_MOVEMENT_TYPE[modelName]
	if explicit then return explicit end
	if petDef and petDef.collection == "FNAF" then
		-- Explicit safety: unspecified FNAF defaults to hover, not walker.
		return MOVEMENT_HOVER
	end
	return MOVEMENT_HOVER
end

local function useWalkingFollower(petId: string, petDef): boolean
	return getMovementType(petId, petDef) == MOVEMENT_WALKER
end

local function shouldUseExactNameLookup(modelName: string): boolean
	-- Reverted FNAF float pets must resolve via explicit modelPath to avoid
	-- exact-name collisions with unrelated large world/NPC assets.
	if modelName == "Bonnie"
		or modelName == "Chica"
		or modelName == "Foxy"
		or modelName == "FreddyFazbear"
	then
		return false
	end
	return PET_MOVEMENT_TYPE[modelName] ~= nil
end

local function findHumanoidInModel(model: Model): Humanoid?
	local direct = model:FindFirstChildOfClass("Humanoid")
	if direct then
		return direct
	end
	local nested = model:FindFirstChild("Humanoid", true)
	if nested and nested:IsA("Humanoid") then
		return nested
	end
	return nil
end

local function findAnimationControllerInModel(model: Model): AnimationController?
	local direct = model:FindFirstChildOfClass("AnimationController")
	if direct then
		return direct
	end
	local nested = model:FindFirstChild("AnimationController", true)
	if nested and nested:IsA("AnimationController") then
		return nested
	end
	return nil
end

local function findTungTungDriveRoot(model: Model, humanoid: Humanoid?): BasePart?
	local hrp = model:FindFirstChild("HumanoidRootPart", true)
	if hrp and hrp:IsA("BasePart") then
		return hrp
	end
	if humanoid and humanoid.RootPart then
		return humanoid.RootPart
	end
	if model.PrimaryPart then
		return model.PrimaryPart
	end
	return model:FindFirstChildWhichIsA("BasePart", true)
end

local function isSharedPetEmoteEnabled(petId: string?): boolean
	return petId ~= nil and SHARED_PET_EMOTE_IDS[petId] == true
end

local function shouldUseEmoteRootDrive(petId: string?): boolean
	return petId ~= nil and PET_EMOTE_ROOT_DRIVE_IDS[petId] == true
end

local function modelHasMotor6D(model: Model): boolean
	return model:FindFirstChildWhichIsA("Motor6D", true) ~= nil
end

local function sanitizeFollowerRigArtifacts(model: Model, petId: string)
	if petId ~= FURRYHUGS_PET_ID then
		return
	end
	if modelHasMotor6D(model) then
		return
	end
	local humanoid = findHumanoidInModel(model)
	if humanoid then
		humanoid:Destroy()
	end
	local hrp = model:FindFirstChild("HumanoidRootPart", true)
	if hrp and hrp:IsA("BasePart") then
		hrp:Destroy()
	end
	if not model.PrimaryPart then
		local firstPart = model:FindFirstChildWhichIsA("BasePart", true)
		if firstPart then
			model.PrimaryPart = firstPart
		end
	end
	print(string.format(
		"[FurryHugsPetEmote] event=rig_sanitized_for_follow clone=%s motorsPresent=false",
		model:GetFullName()
	))
end

local function ensureAnimatorForPet(model: Model): (Humanoid?, Animator?, string)
	local humanoid = findHumanoidInModel(model)
	if humanoid then
		local animator = humanoid:FindFirstChildOfClass("Animator")
		if not animator then
			animator = Instance.new("Animator")
			animator.Parent = humanoid
		end
		return humanoid, animator, "Humanoid"
	end

	local controller = findAnimationControllerInModel(model)
	if not controller then
		controller = Instance.new("AnimationController")
		controller.Name = "PetAnimationController"
		controller.Parent = model
	end

	local animator = controller:FindFirstChildOfClass("Animator")
	if not animator then
		animator = Instance.new("Animator")
		animator.Parent = controller
	end
	return nil, animator, "AnimationController"
end

local function collectAnimationIdsByAliases(model: Model, aliases: { string }): { string }
	local found: { string } = {}
	local seen: { [string]: boolean } = {}
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("Animation") and type(d.AnimationId) == "string" and d.AnimationId ~= "" then
			local lowerName = string.lower(d.Name)
			local lowerParent = d.Parent and string.lower(d.Parent.Name) or ""
			for _, alias in ipairs(aliases) do
				local lowerAlias = string.lower(alias)
				if string.find(lowerName, lowerAlias, 1, true) or string.find(lowerParent, lowerAlias, 1, true) then
					if not seen[d.AnimationId] then
						seen[d.AnimationId] = true
						table.insert(found, d.AnimationId)
					end
					break
				end
			end
		end
	end
	return found
end

local function loadPetAnimationTrack(
	animator: Animator,
	animationIds: { string },
	looped: boolean
): (AnimationTrack?, string?)
	for _, animationId in ipairs(animationIds) do
		if type(animationId) == "string" and animationId ~= "" then
			local anim = Instance.new("Animation")
			anim.AnimationId = animationId
			local ok, track = pcall(function()
				return animator:LoadAnimation(anim)
			end)
			anim:Destroy()
			if ok and track then
				track.Looped = looped
				track.Priority = TUNGTUNG_EMOTE_PRIORITY
				return track, animationId
			end
		end
	end
	return nil, nil
end

local function waitForTrackReady(track: AnimationTrack, timeoutSeconds: number): number
	local startedAt = tick()
	local length = track.Length
	while length <= 0 and (tick() - startedAt) < timeoutSeconds do
		task.wait(0.05)
		length = track.Length
	end
	return length
end

local function isTrackPlaying(animator: Animator, track: AnimationTrack): (boolean, number)
	local playing = animator:GetPlayingAnimationTracks()
	for _, activeTrack in ipairs(playing) do
		if activeTrack == track then
			return true, #playing
		end
	end
	return false, #playing
end

local function setTungTungDriveRoot(root: BasePart, targetCF: CFrame)
	root.CFrame = root.CFrame:Lerp(targetCF, TUNGTUNG_EMOTE_ROOT_LERP_ALPHA)
	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero
end

local function setTungTungEmoteState(player: Player, clone: Model, isActive: boolean, track: AnimationTrack?, root: BasePart?)
	local entry = _activePets[player]
	if entry and entry.pet == clone then
		entry.emoteActive = isActive
		entry.emoteTrack = if isActive then track else nil
		entry.emoteRoot = root
	end
end

local function buildTungTungEmoteTracks(model: Model, animator: Animator, player: Player, petId: string)
	local loaded = {}
	for _, spec in ipairs(TUNGTUNG_EMOTE_SPECS) do
		local animationIds = collectAnimationIdsByAliases(model, spec.aliases)
		local source = "model"
		if #animationIds == 0 then
			animationIds = spec.fallbackIds
			source = "fallback"
		end
		local track, animationId = loadPetAnimationTrack(animator, animationIds, spec.looped)
		local trackLength = 0
		if track then
			trackLength = waitForTrackReady(track, TUNGTUNG_TRACK_READY_TIMEOUT)
		end
		print(string.format(
			"%s owner=%s event=track_loaded pet=%s emote=%s animationId=%s source=%s loadSucceeded=%s trackLength=%.3f",
			TUNGTUNG_DEBUG_TAG,
			player.Name,
			petId,
			spec.label,
			tostring(animationId or "nil"),
			source,
			tostring(track ~= nil),
			trackLength
		))
		if track then
			table.insert(loaded, {
				label = spec.label,
				track = track,
				duration = spec.duration,
				animationId = animationId,
				source = source,
				trackLength = trackLength,
			})
		end
	end
	return loaded
end

local function stopTungTungEmoteTracks(loadedTracks)
	for _, entry in ipairs(loadedTracks) do
		if entry.track then
			pcall(function()
				entry.track:Stop(TUNGTUNG_EMOTE_FADE_OUT)
			end)
		end
	end
end

local function startTungTungPetEmoteLoop(clone: Model, player: Player, petIdOverride: string?): thread?
	local petId = petIdOverride or TUNGTUNG_PET_ID
	local humanoid = findHumanoidInModel(clone)
	local ensuredHumanoid, animator, animationDriver = ensureAnimatorForPet(clone)
	humanoid = ensuredHumanoid or humanoid
	local driveRoot = findTungTungDriveRoot(clone, humanoid)
	local hasAnimator = animator ~= nil

	print(string.format(
		"%s owner=%s event=spawn pet=%s humanoid=%s animator=%s driver=%s clone=%s root=%s",
		TUNGTUNG_DEBUG_TAG,
		player.Name,
		petId,
		tostring(humanoid ~= nil),
		tostring(hasAnimator),
		tostring(animationDriver),
		clone:GetFullName(),
		tostring(driveRoot and driveRoot:GetFullName() or "nil")
	))

	if not animator then
		warn(string.format(
			"%s owner=%s event=loop_not_started reason=missing_animator",
			TUNGTUNG_DEBUG_TAG,
			player.Name
		))
		return nil
	end

	local loadedTracks = buildTungTungEmoteTracks(clone, animator, player, petId)
	if #loadedTracks == 0 then
		warn(string.format(
			"%s owner=%s event=loop_not_started reason=no_tracks_loaded humanoid=%s animator=%s driver=%s",
			TUNGTUNG_DEBUG_TAG,
			player.Name,
			tostring(humanoid ~= nil),
			tostring(hasAnimator),
			tostring(animationDriver)
		))
		return nil
	end

	if humanoid then
		humanoid.AutoRotate = false
		humanoid.PlatformStand = false
	end
	if petId == FURRYHUGS_PET_ID then
		print(string.format(
			"[FurryHugsPetEmote] owner=%s event=initialized_for_emotes clone=%s humanoid=%s animator=%s driver=%s root=%s",
			player.Name,
			clone:GetFullName(),
			tostring(humanoid ~= nil),
			tostring(hasAnimator),
			tostring(animationDriver),
			tostring(driveRoot and driveRoot:GetFullName() or "nil")
		))
	end

	print(string.format(
		"%s owner=%s event=loop_started humanoid=%s animator=%s driver=%s clone=%s root=%s tracks=%d builtinEmoteUsed=false",
		TUNGTUNG_DEBUG_TAG,
		player.Name,
		tostring(humanoid ~= nil),
		tostring(hasAnimator),
		tostring(animationDriver),
		clone:GetFullName(),
		tostring(driveRoot and driveRoot:GetFullName() or "nil"),
		#loadedTracks
	))

	return task.spawn(function()
		local rng = Random.new()
		while clone.Parent do
			local interval = rng:NextInteger(TUNGTUNG_EMOTE_INTERVAL_MIN, TUNGTUNG_EMOTE_INTERVAL_MAX)
			task.wait(interval)
			if not clone.Parent then
				break
			end

			local order = {}
			for index = 1, #loadedTracks do
				order[index] = index
			end
			for index = #order, 2, -1 do
				local swapIndex = rng:NextInteger(1, index)
				order[index], order[swapIndex] = order[swapIndex], order[index]
			end

			local playedTrack = nil
			for _, index in ipairs(order) do
				local chosen = loadedTracks[index]
				stopTungTungEmoteTracks(loadedTracks)
				setTungTungEmoteState(player, clone, true, chosen.track, driveRoot)
				task.wait(TUNGTUNG_EMOTE_PRE_BLEND_WAIT)

				local okPlayTrack, errPlayTrack = pcall(function()
					chosen.track.TimePosition = 0
					chosen.track:Play(TUNGTUNG_EMOTE_FADE_IN, 1, 1)
				end)
				local trackLength = waitForTrackReady(chosen.track, TUNGTUNG_TRACK_READY_TIMEOUT)
				task.wait(math.max(0.18, TUNGTUNG_EMOTE_FADE_IN * 0.8))
				local trackStillPlaying, playingTrackCount = isTrackPlaying(animator, chosen.track)
				local trackActuallyPlayed = okPlayTrack and chosen.track.IsPlaying and trackLength > 0
				local replacedImmediately = okPlayTrack and not trackStillPlaying

				print(string.format(
					"%s owner=%s event=play_emote pet=%s baseWait=%d emote=%s animationId=%s source=%s loadSucceeded=%s trackLength=%.3f trackPlayed=%s replacedImmediately=%s followerDrivenByRoot=%s clone=%s",
					TUNGTUNG_DEBUG_TAG,
					player.Name,
					petId,
					interval,
					tostring(chosen.label),
					tostring(chosen.animationId or "nil"),
					tostring(chosen.source or "unknown"),
					tostring(okPlayTrack),
					trackLength,
					tostring(trackActuallyPlayed),
					tostring(replacedImmediately and playingTrackCount > 0),
					tostring(driveRoot ~= nil),
					clone:GetFullName()
				))

				if not okPlayTrack then
					warn(string.format(
						"%s owner=%s event=play_track_failed emote=%s animationId=%s error=%s",
						TUNGTUNG_DEBUG_TAG,
						player.Name,
						tostring(chosen.label),
						tostring(chosen.animationId or "nil"),
						tostring(errPlayTrack)
					))
					setTungTungEmoteState(player, clone, false, nil, driveRoot)
				elseif trackActuallyPlayed then
					playedTrack = chosen
					if petId == FURRYHUGS_PET_ID then
						print(string.format(
							"[FurryHugsPetEmote] owner=%s event=play_success emote=%s animationId=%s",
							player.Name,
							tostring(chosen.label),
							tostring(chosen.animationId or "nil")
						))
					end
					break
				else
					pcall(function()
						chosen.track:Stop(TUNGTUNG_EMOTE_FADE_OUT)
					end)
					task.wait(TUNGTUNG_EMOTE_POST_BLEND_HOLD)
					setTungTungEmoteState(player, clone, false, nil, driveRoot)
				end
			end

			if playedTrack then
				task.wait(playedTrack.duration)
				pcall(function()
					playedTrack.track:Stop(TUNGTUNG_EMOTE_FADE_OUT)
				end)
				task.wait(TUNGTUNG_EMOTE_POST_BLEND_HOLD)
				setTungTungEmoteState(player, clone, false, nil, driveRoot)
			else
				warn(string.format(
					"%s owner=%s event=no_visible_emote reason=no_track_played clone=%s",
					TUNGTUNG_DEBUG_TAG,
					player.Name,
					clone:GetFullName()
				))
			end
		end

		setTungTungEmoteState(player, clone, false, nil, driveRoot)
		stopTungTungEmoteTracks(loadedTracks)
		print(string.format(
			"%s owner=%s event=loop_stopped reason=pet_removed",
			TUNGTUNG_DEBUG_TAG,
			player.Name
		))
	end)
end

local function resetTungTungLaughStateForRound(newRoundNumber: number, source: string)
	if newRoundNumber == _trackedRoundNumber then
		return
	end
	_trackedRoundNumber = newRoundNumber
	_sawDeathThisRound = false
	_laughedThisRound = false
	print(string.format(
		"[TungTungPetEmote] owner=%s event=round_reset_cleared_laugh_state round=%d source=%s",
		Players.LocalPlayer.Name,
		newRoundNumber,
		source
	))
end

local function tryPlayTungTungLaughOnceThisRound(triggerReason: string): boolean
	local localPlayer = Players.LocalPlayer
	if _laughedThisRound then
		return false
	end
	if localPlayer:GetAttribute("EquippedPet") ~= TUNGTUNG_PET_ID then
		return false
	end

	local entry = _activePets[localPlayer]
	if not entry or not entry.pet or not entry.pet:IsA("Model") then
		return false
	end
	local clone = entry.pet
	if clone:GetAttribute("_petId") ~= TUNGTUNG_PET_ID then
		return false
	end

	if entry.emoteThread then
		task.cancel(entry.emoteThread)
		entry.emoteThread = nil
	end
	if entry.emoteTrack then
		pcall(function()
			entry.emoteTrack:Stop(TUNGTUNG_EMOTE_FADE_OUT)
		end)
	end
	setTungTungEmoteState(localPlayer, clone, false, nil, entry.emoteRoot)

	local humanoid = findHumanoidInModel(clone)
	local _, animator = ensureAnimatorForPet(clone)
	if not animator then
		return false
	end
	local driveRoot = entry.emoteRoot or findTungTungDriveRoot(clone, humanoid)
	local animationIds = collectAnimationIdsByAliases(clone, TUNGTUNG_LAUGH_ALIASES)
	local source = "model"
	if #animationIds == 0 then
		animationIds = TUNGTUNG_LAUGH_FALLBACK_IDS
		source = "fallback"
	end
	local track, animationId = loadPetAnimationTrack(animator, animationIds, false)
	if not track then
		warn(string.format(
			"[TungTungPetEmote] owner=%s event=laugh_failed reason=no_track_loaded source=%s",
			localPlayer.Name,
			source
		))
		entry.emoteThread = startTungTungPetEmoteLoop(clone, localPlayer)
		return false
	end

	track.Priority = TUNGTUNG_EMOTE_PRIORITY
	track.Looped = false
	setTungTungEmoteState(localPlayer, clone, true, track, driveRoot)
	local okPlay = pcall(function()
		track.TimePosition = 0
		track:Play(TUNGTUNG_LAUGH_FADE_IN, 1, 1)
	end)
	if not okPlay then
		setTungTungEmoteState(localPlayer, clone, false, nil, driveRoot)
		entry.emoteThread = startTungTungPetEmoteLoop(clone, localPlayer)
		return false
	end

	_laughedThisRound = true
	print(string.format(
		"[TungTungPetEmote] owner=%s event=pet_laughed_this_round round=%d reason=%s animationId=%s source=%s",
		localPlayer.Name,
		_trackedRoundNumber,
		triggerReason,
		tostring(animationId or "nil"),
		source
	))

	local duration = waitForTrackReady(track, TUNGTUNG_TRACK_READY_TIMEOUT)
	if duration <= 0 then
		duration = TUNGTUNG_LAUGH_DEFAULT_DURATION
	end

	task.spawn(function()
		task.wait(duration + 0.08)
		local liveEntry = _activePets[localPlayer]
		if not liveEntry or liveEntry.pet ~= clone then
			return
		end
		pcall(function()
			track:Stop(TUNGTUNG_LAUGH_FADE_OUT)
		end)
		setTungTungEmoteState(localPlayer, clone, false, nil, driveRoot)
		if clone.Parent then
			liveEntry.emoteThread = startTungTungPetEmoteLoop(clone, localPlayer)
		end
	end)

	return true
end

local function bindKillFeedFirstDeathHook()
	if _killFeedConn then
		return
	end
	local remotes = ReplicatedStorage:FindFirstChild("Remotes")
	local killFeedEvent = remotes and remotes:FindFirstChild("KillFeedEvent")
	if not (killFeedEvent and killFeedEvent:IsA("RemoteEvent")) then
		return
	end
	_killFeedConn = killFeedEvent.OnClientEvent:Connect(function(_victimName, _reasonOrKiller)
		if _trackedRoundNumber <= 0 then
			return
		end
		if _sawDeathThisRound then
			return
		end
		_sawDeathThisRound = true
		tryPlayTungTungLaughOnceThisRound("FirstDeathInRound")
	end)
end

local function bindRoundResetHook()
	if _matchRoundConn then
		return
	end
	local matchStatus = ReplicatedStorage:FindFirstChild("MatchStatus")
	local roundValue = matchStatus and matchStatus:FindFirstChild("Round")
	if not (roundValue and roundValue:IsA("IntValue")) then
		return
	end
	resetTungTungLaughStateForRound(roundValue.Value, "Init")
	_matchRoundConn = roundValue:GetPropertyChangedSignal("Value"):Connect(function()
		resetTungTungLaughStateForRound(roundValue.Value, "RoundValueChanged")
	end)
end

local function findHrpInModel(model: Model): BasePart?
	local hrp = model:FindFirstChild("HumanoidRootPart", true)
	if hrp and hrp:IsA("BasePart") then
		return hrp
	end
	return nil
end

local ROOT_NAME_PRIORITY = {
	"HumanoidRootPart",
	"Root",
	"RootPart",
	"Handle",
	"UpperTorso",
	"LowerTorso",
	"Torso",
}

local function ensureDeterministicPrimaryPart(model: Model): BasePart?
	local current = model.PrimaryPart
	if current and current:IsA("BasePart") then
		return current
	end

	for _, name in ipairs(ROOT_NAME_PRIORITY) do
		local candidate = model:FindFirstChild(name, true)
		if candidate and candidate:IsA("BasePart") then
			model.PrimaryPart = candidate
			return candidate
		end
	end

	local allParts = {}
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			table.insert(allParts, d)
		end
	end
	table.sort(allParts, function(a, b)
		return a:GetFullName() < b:GetFullName()
	end)
	local first = allParts[1]
	if first then
		model.PrimaryPart = first
		return first
	end
	return nil
end

local function pickDeterministicVisualRoot(model: Model): BasePart?
	for _, name in ipairs({ "Root", "Handle", "HumanoidRootPart" }) do
		local part = model:FindFirstChild(name, true)
		if part and part:IsA("BasePart") then
			model.PrimaryPart = part
			return part
		end
	end

	local best: BasePart? = nil
	local bestVolume = -math.huge
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			local v = d.Size.X * d.Size.Y * d.Size.Z
			if v > bestVolume then
				bestVolume = v
				best = d
			end
		end
	end
	if best then
		model.PrimaryPart = best
		return best
	end
	return nil
end

local function ensureInternalWeldsToRoot(model: Model, root: BasePart)
	local hasInternalJoints = false
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("WeldConstraint") or d:IsA("Motor6D") then
			hasInternalJoints = true
			break
		end
	end
	if hasInternalJoints then
		return
	end
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") and d ~= root then
			local weld = Instance.new("WeldConstraint")
			weld.Name = "_PetInternalWeld"
			weld.Part0 = root
			weld.Part1 = d
			weld.Parent = root
		end
	end
end

local function moveModelByRootDelta(model: Model, targetRootCF: CFrame): boolean
	local root = model.PrimaryPart
	if not root then
		return false
	end
	local delta = targetRootCF * root.CFrame:Inverse()
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			d.CFrame = delta * d.CFrame
		end
	end
	return true
end

local function findWalkerRootPart(model: Model, humanoid: Humanoid?): (BasePart?, boolean)
	local hrp = findHrpInModel(model)
	if hrp then
		return hrp, true
	end
	if humanoid and humanoid.RootPart then
		return humanoid.RootPart, false
	end
	if model.PrimaryPart then
		return model.PrimaryPart, false
	end
	local anyPart = model:FindFirstChildWhichIsA("BasePart", true)
	if anyPart then
		return anyPart, false
	end
	return nil, false
end

local function ensureWalkerHumanoid(model: Model): Humanoid
	local hum = findHumanoidInModel(model)
	if hum then
		return hum
	end
	hum = Instance.new("Humanoid")
	hum.Name = "Humanoid"
	hum.Parent = model
	return hum
end

local function ensureWalkerHrp(model: Model, humanoid: Humanoid?): BasePart?
	local existing = findHrpInModel(model)
	if existing then
		return existing
	end

	local base = nil :: BasePart?
	if humanoid and humanoid.RootPart then
		base = humanoid.RootPart
	elseif model.PrimaryPart then
		base = model.PrimaryPart
	else
		base = model:FindFirstChildWhichIsA("BasePart", true)
	end
	if not base then
		return nil
	end

	local hrp = Instance.new("Part")
	hrp.Name = "HumanoidRootPart"
	hrp.Size = Vector3.new(2, 2, 1)
	hrp.Transparency = 1
	hrp.CanCollide = true
	hrp.CanQuery = false
	hrp.CanTouch = false
	hrp.Massless = false
	hrp.Anchored = false
	hrp.CFrame = base.CFrame
	hrp.Parent = model

	local weld = Instance.new("WeldConstraint")
	weld.Part0 = hrp
	weld.Part1 = base
	weld.Parent = hrp

	model.PrimaryPart = hrp
	return hrp
end

local function destroyPetFor(player: Player, reason: string?)
	local entry = _activePets[player]
	if not entry then return end

	if DEBUG_LOGS and shouldLog("pet_destroy_" .. tostring(player.UserId), 3) then
		print(string.format(
			"%s destroy owner=%s reason=%s equippedAttr=%s isWalker=%s isServerMotor=%s activePetId=%s",
			TAG,
			player.Name,
			tostring(reason or "unspecified"),
			tostring(player:GetAttribute("EquippedPet")),
			tostring(entry._isWalker == true),
			tostring(entry._isServerMotor == true),
			tostring(entry.pet and entry.pet:GetAttribute("_petId") or entry._walkerPetId or entry._serverMotorPetId or "nil")
		))
	end

	-- Walker pets live on the server; notify it to clean up.
	if entry._isWalker or entry._isServerMotor then
		if player == Players.LocalPlayer then
			pcall(function() _unequipRemote:FireServer() end)
		end
		_activePets[player] = nil
		return
	end

	if entry.conn then entry.conn:Disconnect() end
	if entry.emoteTrack then
		pcall(function()
			entry.emoteTrack:Stop(TUNGTUNG_EMOTE_FADE_OUT)
		end)
	end
	if entry.emoteThread then
		local activePetId = entry.pet and tostring(entry.pet:GetAttribute("_petId")) or nil
		if isSharedPetEmoteEnabled(activePetId) then
			print(string.format(
				"%s owner=%s event=loop_stop_requested reason=%s",
				TUNGTUNG_DEBUG_TAG,
				player.Name,
				tostring(reason or "unspecified")
			))
		end
		task.cancel(entry.emoteThread)
	end
	if entry.mover and entry.mover.Destroy then
		pcall(function() entry.mover:Destroy() end)
	end
	if entry.pet and entry.pet.Parent then entry.pet:Destroy() end
	_activePets[player] = nil
end

local function spawnPetFor(player: Player, petId: string)
	-- Already tracking this pet? Skip (handles both hover model and walker sentinel).
	local existing = _activePets[player]
	if existing then
		if existing._isWalker and existing._walkerPetId == petId then return end
		if existing._isServerMotor and existing._serverMotorPetId == petId then return end
		if not existing._isWalker and existing.pet and existing.pet.Parent
			and existing.pet:GetAttribute("_petId") == petId then return end
	end

	destroyPetFor(player, "respawn_or_swap")

	if not petId or petId == "" then return end

	local petDef = getPetDef(petId)
	if not petDef then
		warn(TAG, "Pet not in catalog:", petId)
		return
	end

	local movementType = getMovementType(petId, petDef)
	local character = player.Character
	local rootPart = character and character:FindFirstChild("HumanoidRootPart")
	if not rootPart then
		return
	end

	local modelName = getConfiguredPetModelName(petId, petDef)
	local sourceModel: Instance? = nil
	local resolutionMode = "none"
	if shouldUseExactNameLookup(modelName) then
		sourceModel = ItemModelRegistry.GetByExactName(modelName)
		if sourceModel then
			resolutionMode = "exact_name"
		end
	end
	if not sourceModel and petDef.modelPath and petDef.modelPath ~= "" then
		sourceModel = ItemModelRegistry.Get(petDef.modelPath)
		if sourceModel then
			resolutionMode = "model_path"
		end
	end
	if not sourceModel and modelName ~= "" then
		sourceModel = ItemModelRegistry.Get(modelName)
		if sourceModel then
			resolutionMode = "model_name_path"
		end
	end
	if DEBUG_LOGS and shouldLog("pet_spawn_lookup_" .. petId, 20) then
		local registryPath = sourceModel and sourceModel:GetFullName() or ItemModelsFolder:GetFullName()
		print(string.format("[PetSpawn] petId=%s petName=%s displayName=%s mode=%s modelPath=%s modelFound=%s registry=%s",
			tostring(petId),
			tostring(modelName),
			tostring(petDef.name),
			tostring(resolutionMode),
			tostring(petDef.modelPath),
			tostring(sourceModel ~= nil),
			registryPath))
	end
	if not sourceModel then
		warn(TAG, "Model not found for pet:", petId, "| displayName:", tostring(petDef.name), "| modelName:", modelName, "| modelPath:", tostring(petDef.modelPath), "| mode:", resolutionMode)
		return
	end

	log("spawn_begin", "Spawning pet for", player.Name .. ":", petId, "modelName:", modelName)
	local movementType = getMovementType(petId, petDef)

	-- ── WALKER PETS ────────────────────────────────────────────────────────────
	if movementType == MOVEMENT_WALKER then
		-- Non-Freddy walker fallback (currently unused): server-owned path.
		if DEBUG_LOGS and shouldLog("walker_pet_client_equip_" .. petId, 20) then
			print(string.format("[WalkerPetCL] equip petId=%s modelName=%s → firing server", petId, modelName))
		end
		_equipRemote:FireServer(petId)
		_activePets[player] = {
			pet          = nil,
			conn         = nil,
			pos          = rootPart.Position,
			t0           = tick(),
			mover        = nil,
			_isWalker    = true,
			_walkerPetId = petId,
		}
		return
	end

	-- ── SERVER MOTOR-RIG PETS (special 4 only) ────────────────────────────────
	if movementType == MOVEMENT_SERVER_MOTOR then
		if player == Players.LocalPlayer then
			_equipRemote:FireServer(petId)
		end
		_activePets[player] = {
			pet              = nil,
			conn             = nil,
			pos              = rootPart.Position,
			t0               = tick(),
			mover            = nil,
			_isServerMotor   = true,
			_serverMotorPetId = petId,
		}
		return
	end

	local clone = sourceModel:Clone()
	local deterministicTarget = DETERMINISTIC_PET_IDS[petId] == true
	if clone:IsA("Model") then
		sanitizeFollowerRigArtifacts(clone, petId)
	end

	-- Unwrap Accessory → extract children into a Model wrapper
	if clone:IsA("Accessory") then
		local wrapper = Instance.new("Model")
		wrapper.Name = clone.Name
		local handle = clone:FindFirstChild("Handle")
		for _, child in ipairs(clone:GetChildren()) do
			child.Parent = wrapper
		end
		if handle and handle:IsA("BasePart") then
			wrapper.PrimaryPart = handle
		else
			local firstPart = wrapper:FindFirstChildWhichIsA("BasePart", true)
			if firstPart then wrapper.PrimaryPart = firstPart end
		end
		clone:Destroy()
		clone = wrapper
	end

	-- Wrap bare BaseParts into a Model so ScaleTo / PivotTo work uniformly.
	if clone:IsA("BasePart") and not clone:IsA("Model") then
		local wrapper = Instance.new("Model")
		wrapper.Name = clone.Name
		clone.Parent = wrapper
		wrapper.PrimaryPart = clone
		clone = wrapper
	end

	-- Ensure consistent pivot behavior for per-pet offsets.
	if clone:IsA("Model") then
		if deterministicTarget then
			local root = pickDeterministicVisualRoot(clone) or ensureDeterministicPrimaryPart(clone)
			if root then
				ensureInternalWeldsToRoot(clone, root)
			end
		elseif not clone.PrimaryPart then
			local preferredRoot = clone:FindFirstChild("HumanoidRootPart", true)
			if preferredRoot and preferredRoot:IsA("BasePart") then
				clone.PrimaryPart = preferredRoot
			else
				local firstPart = clone:FindFirstChildWhichIsA("BasePart", true)
				if firstPart then
					clone.PrimaryPart = firstPart
				end
			end
		end
	end
	local spawnBoundsBeforeStr: string? = nil
	local spawnPrimaryPartName: string = "nil"
	if PET_MASSIVE_SCALE_TARGETS[petId] then
		local b = getBBoxSize(clone)
		spawnBoundsBeforeStr = b and string.format("%.2f,%.2f,%.2f", b.X, b.Y, b.Z) or "nil"
		spawnPrimaryPartName = (clone:IsA("Model") and clone.PrimaryPart and clone.PrimaryPart.Name) or "nil"
	end

	local useUnanchoredFloat = FNAF_REVERTED_FLOAT_IDS[petId] == true or petId == TUNGTUNG_PET_ID

	-- Hover pets: default anchored; reverted FNAF floats are unanchored.
	local function prepPart(part: BasePart)
		part.Anchored   = not useUnanchoredFloat
		part.CanCollide = false
		part.CanQuery   = false
		part.CanTouch   = false
		part.Massless   = true
	end

	if clone:IsA("BasePart") then prepPart(clone) end
	for _, d in ipairs(clone:GetDescendants()) do
		if d:IsA("BasePart") then prepPart(d) end
	end

	-- Enable VFX; destroy embedded scripts (hover pets need no scripting).
	for _, d in ipairs(clone:GetDescendants()) do
		if d:IsA("ParticleEmitter") or d:IsA("Fire") or d:IsA("Sparkles")
			or d:IsA("Smoke") or d:IsA("Beam") or d:IsA("Trail") then
			d.Enabled = true
		elseif d:IsA("Script") or d:IsA("LocalScript") then
			d:Destroy()
		end
	end

	-- ── SIZE NORMALIZATION ─────────────────────────────────────────
	-- Goal: every pet ends up with max bounding-box dim <= TARGET_MAX_DIM.
	local preBBox = getBBoxSize(clone)
	local petScale = 1

	do
		local scaleOverride = PET_SCALE_OVERRIDES[petId]

		if scaleOverride then
			-- Use the explicit override
			petScale = scaleOverride
		elseif preBBox then
			local maxDim = math.max(preBBox.X, preBBox.Y, preBBox.Z, 0.01)
			if maxDim > TARGET_MAX_DIM then
				petScale = TARGET_MAX_DIM / maxDim
			end
		end

		local scaleCeil = SCALE_CEIL
		if scaleOverride and scaleOverride > SCALE_CEIL then
			scaleCeil = scaleOverride
		end
		petScale = math.clamp(petScale, SCALE_FLOOR, scaleCeil)

		-- Apply the primary scale
		if petScale < 1 then
			applyScale(clone, petScale)
		end

		-- POST-SCALE VERIFICATION: re-measure and correct if still too big
		local postBBox = getBBoxSize(clone)
		if postBBox then
			local postMax = math.max(postBBox.X, postBBox.Y, postBBox.Z)
			if postMax > TARGET_MAX_DIM then
				local correction = (TARGET_MAX_DIM / postMax) * 0.95 -- 5% safety margin
				correction = math.max(correction, SCALE_FLOOR)
				applyScale(clone, correction)
				petScale = petScale * correction
				log("post_scale", "Post-scale correction for", petId,
					string.format("extra %.3fx (was %.1f studs)", correction, postMax))
			end
		end
		if PET_MASSIVE_SCALE_TARGETS[petId] then
			local beforeStr = preBBox and string.format("%.2f,%.2f,%.2f", preBBox.X, preBBox.Y, preBBox.Z) or "nil"
			local after = getBBoxSize(clone)
			local afterStr = after and string.format("%.2f,%.2f,%.2f", after.X, after.Y, after.Z) or "nil"
			print(string.format("[PetScale] pet=%s appliedScale=%.2f bounds=%s/%s",
				tostring(petDef and petDef.name or petId),
				petScale,
				beforeStr,
				afterStr))
		end
	end

	log("scaled_pet", "Scaled pet", petId, string.format("%.3fx", petScale),
		preBBox and string.format("(pre-bbox: %.1f x %.1f x %.1f)", preBBox.X, preBBox.Y, preBBox.Z) or "(no bbox)")

	local visual = PetVisualConfig.Get(petId, petDef)

	-- Apply visual scale ONCE per spawn (never in follow loop).
	if visual.scale ~= 1 then
		applyScale(clone, visual.scale)
		petScale = petScale * visual.scale
	end

	if RunService:IsStudio() and visual.debugTag and shouldLog("pet_visual_fix_" .. petId, 20) then
		print(string.format(
			"[PetVisualFix] pet=%s appliedRot=<%.1f,%.1f,%.1f>",
			petId,
			visual.rotDeg.X,
			visual.rotDeg.Y,
			visual.rotDeg.Z
		))
	end

	-- ── FOLLOW OFFSET (scaled to pet size) ─────────────────────────
	local offsetMul = 0.4 + 0.6 * petScale
	local petOffset = CFrame.new(
		PET_OFFSET.X * offsetMul,
		PET_OFFSET.Y * offsetMul,
		PET_OFFSET.Z * offsetMul
	)
	local petBobbleAmp = BOBBLE_AMPLITUDE * math.max(petScale, 0.4)

	-- Per-pet yaw offset in radians (from table + PetVisualConfig rotation).
	-- PetVisualConfig.rotation is a pure-yaw CFrame for backwards-facing models.
	local petYawRad = math.rad(PET_YAW_OFFSET_DEG[petId] or 0)
	do
		-- Extract additional yaw from visual.rotation (ignore any pitch/roll).
		local _, vy, _ = visual.rotation:ToEulerAnglesYXZ()
		petYawRad = petYawRad + vy
	end

	if RunService:IsStudio() and shouldLog("pet_upright_" .. petId, 20) then
		print(string.format("[PetUpright] petId=%s yawOffsetDeg=%.0f",
			petId, math.deg(petYawRad)))
	end

	clone.Name = PET_INSTANCE_NAME
	clone:SetAttribute("IsPet", true)
	clone:SetAttribute("_petId", petId)
	clone:SetAttribute("_owner", player.Name)
	clone.Parent = workspace

	-- Final in-game scale pass for the four tiny legendary pets.
	-- Runs AFTER normalization and parent, BEFORE final attach transform.
	local finalSpawnMult = PET_FINAL_SPAWN_SCALE_MULTIPLIER[petId]
	if finalSpawnMult and finalSpawnMult > 1 then
		print(string.format("[PetSpawnModel] pet=%s modelPath=%s primaryPart=%s boundsBefore=%s",
			tostring(petDef and petDef.name or petId),
			tostring(clone:GetFullName()),
			tostring(spawnPrimaryPartName),
			tostring(spawnBoundsBeforeStr or "nil")))
		applyScale(clone, finalSpawnMult)
		petScale = petScale * finalSpawnMult
		local after = getBBoxSize(clone)
		local afterStr = after and string.format("%.2f,%.2f,%.2f", after.X, after.Y, after.Z) or "nil"
		print(string.format("[PetScaleApplied] pet=%s multiplier=%.2f boundsAfter=%s",
			tostring(petDef and petDef.name or petId),
			finalSpawnMult,
			afterStr))
	end

	-- ── INITIAL POSITION ───────────────────────────────────────────
	local startPos = (rootPart.CFrame * petOffset).Position
	local look0 = rootPart.CFrame.LookVector
	local yaw0  = math.atan2(-look0.X, -look0.Z) + petYawRad
	local startCF = CFrame.new(startPos) * CFrame.Angles(0, yaw0, 0)
	local deterministicOverride = deterministicTarget and (PET_DETERMINISTIC_ROTATION_OVERRIDES[petId] or CFrame.new()) or CFrame.new()
	local attachCF = startCF
		* (PET_EQUIP_OFFSET_CFRAME[petId] or CFrame.new())
		* (PET_ROTATION_FIX[petId] or CFrame.new())
		* deterministicOverride

	if deterministicTarget and clone:IsA("Model") then
		task.wait()
		local root = pickDeterministicVisualRoot(clone) or ensureDeterministicPrimaryPart(clone)
		if not root then
			clone:PivotTo(attachCF)
		else
			ensureInternalWeldsToRoot(clone, root)
			if not moveModelByRootDelta(clone, attachCF) then
				clone:PivotTo(attachCF)
			end
		end
	elseif clone:IsA("Model") then
		clone:PivotTo(attachCF)
	elseif clone:IsA("BasePart") then
		clone.CFrame = attachCF
	end

	if deterministicTarget then
		local rootPath = "nil"
		if clone:IsA("Model") and clone.PrimaryPart then
			rootPath = clone.PrimaryPart:GetFullName()
		elseif clone:IsA("BasePart") then
			rootPath = clone:GetFullName()
		end
		local parts = 0
		local anchored = 0
		local transparent = 0
		local ltmNonZero = 0
		local samplePos = Vector3.new(0, 0, 0)
		for _, d in ipairs(clone:GetDescendants()) do
			if d:IsA("BasePart") then
				parts += 1
				if d.Anchored then anchored += 1 end
				if d.Transparency >= 1 then transparent += 1 end
				if d.LocalTransparencyModifier > 0 then ltmNonZero += 1 end
				samplePos = d.Position
			end
		end
		print(string.format(
			"[PetAttach] pet=%s root=%s parts=%d anchored=%d transparent=%d ltmNonZero=%d samplePos=<%.2f,%.2f,%.2f> finalLook=<%.3f,%.3f,%.3f> finalUp=<%.3f,%.3f,%.3f> overrideApplied=%s",
			tostring(petDef and petDef.name or petId),
			tostring(rootPath),
			parts, anchored, transparent, ltmNonZero,
			samplePos.X, samplePos.Y, samplePos.Z,
			attachCF.LookVector.X, attachCF.LookVector.Y, attachCF.LookVector.Z,
			attachCF.UpVector.X, attachCF.UpVector.Y, attachCF.UpVector.Z,
			tostring(PET_DETERMINISTIC_ROTATION_OVERRIDES[petId] ~= nil)
		))
	end

	-- ── FOLLOW + BOBBLE LOOP ───────────────────────────────────────
	-- Position is lerped for smooth motion; orientation is rebuilt fresh
	-- every frame from the player's LookVector so pitch/roll are ALWAYS 0.
	local currentPos = startPos
	local t0 = tick()
	local sharedEmoteEnabled = isSharedPetEmoteEnabled(petId)
	local useEmoteRootDrive = shouldUseEmoteRootDrive(petId)
	local tungtungDriveRoot = if useEmoteRootDrive and clone:IsA("Model") then findTungTungDriveRoot(clone, findHumanoidInModel(clone)) else nil

	local followConn = RunService.Heartbeat:Connect(function()
		if not clone or not clone.Parent then
			destroyPetFor(player)
			return
		end
		local char = player.Character
		if not char then return end
		local hrp = char:FindFirstChild("HumanoidRootPart")
		if not hrp then return end

		local t = tick() - t0

		-- 1) Target position: offset from HRP + vertical bobble (position only, no rotation)
		local rawTarget = (hrp.CFrame * petOffset).Position
		local bobbleY   = math.sin(t * BOBBLE_SPEED) * petBobbleAmp
		local targetPos = Vector3.new(rawTarget.X, rawTarget.Y + bobbleY, rawTarget.Z)

		-- 2) Lerp position only (no lerp on rotation — orientation is always fresh)
		currentPos = currentPos:Lerp(targetPos, LERP_ALPHA)

		-- 3) Compute yaw from player LookVector — guaranteed pitch=0, roll=0
		local lookVec = hrp.CFrame.LookVector
		local yaw = math.atan2(-lookVec.X, -lookVec.Z) + petYawRad
		-- Small yaw wobble (wobble is yaw-only, no tilt introduced)
		yaw = yaw + math.sin(t * YAW_WOBBLE_SPEED) * math.rad(YAW_WOBBLE_AMP)

		-- 4) Upright CFrame: ONLY yaw rotation, pitch=0, roll=0 always
		local uprightCF = CFrame.new(currentPos) * CFrame.Angles(0, yaw, 0)
		local finalCF = uprightCF
			* (PET_EQUIP_OFFSET_CFRAME[petId] or CFrame.new())
			* (PET_ROTATION_FIX[petId] or CFrame.new())
		if deterministicTarget then
			finalCF = finalCF * (PET_DETERMINISTIC_ROTATION_OVERRIDES[petId] or CFrame.new())
		end

		local activeEntry = _activePets[player]

		-- 5) Apply
		if useEmoteRootDrive and tungtungDriveRoot and activeEntry and activeEntry.pet == clone and activeEntry.emoteActive then
			setTungTungDriveRoot(tungtungDriveRoot, finalCF)
			currentPos = tungtungDriveRoot.Position
		elseif deterministicTarget and clone:IsA("Model") then
			local root = clone.PrimaryPart or pickDeterministicVisualRoot(clone) or ensureDeterministicPrimaryPart(clone)
			if not root then
				clone:PivotTo(finalCF)
			elseif not moveModelByRootDelta(clone, finalCF) then
				clone:PivotTo(finalCF)
			end
		elseif clone:IsA("Model") then
			clone:PivotTo(finalCF)
		elseif clone:IsA("BasePart") then
			clone.CFrame = finalCF
		end
	end)

	local emoteThread
	if sharedEmoteEnabled and clone:IsA("Model") then
		print(string.format(
			"%s owner=%s event=equip pet=%s clone=%s",
			TUNGTUNG_DEBUG_TAG,
			player.Name,
			petId,
			clone:GetFullName()
		))
		emoteThread = startTungTungPetEmoteLoop(clone, player, petId)
	end

	_activePets[player] = {
		pet = clone,
		conn = followConn,
		pos = currentPos,
		t0 = t0,
		mover = nil,
		emoteThread = emoteThread,
		emoteActive = false,
		emoteTrack = nil,
		emoteRoot = tungtungDriveRoot,
	}

	log("spawn_done", "Pet spawned for", player.Name .. ":", petId)
	if DEBUG_LOGS and shouldLog("pet_spawn_" .. tostring(player.UserId), 3) then
		print(string.format(
			"%s spawn owner=%s petId=%s movement=%s anchoredMode=%s equippedAttr=%s",
			TAG,
			player.Name,
			petId,
			movementType,
			useUnanchoredFloat and "unanchored" or "anchored",
			tostring(player:GetAttribute("EquippedPet"))
		))
	end
end

-- =====================================================================
-- PER-PLAYER LIFECYCLE
-- =====================================================================

local function updatePetFor(player: Player)
	local petId = player:GetAttribute("EquippedPet")
	if petId and petId ~= "" then
		spawnPetFor(player, petId)
	else
		destroyPetFor(player, "equipped_attr_empty")
	end
end

local function setupPlayer(player: Player)
	local conns: { RBXScriptConnection } = {}

	table.insert(conns, player:GetAttributeChangedSignal("EquippedPet"):Connect(function()
		updatePetFor(player)
	end))

	table.insert(conns, player.CharacterAdded:Connect(function(character)
		character:WaitForChild("HumanoidRootPart", 10)
		task.wait(0.5)
		updatePetFor(player)
	end))

	table.insert(conns, player.CharacterRemoving:Connect(function()
		destroyPetFor(player, "character_removing")
	end))

	_playerConns[player] = conns

	if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
		task.spawn(function()
			task.wait(0.3)
			updatePetFor(player)
		end)
	end
end

local function cleanupPlayer(player: Player)
	destroyPetFor(player, "player_cleanup")
	if _playerConns[player] then
		for _, conn in ipairs(_playerConns[player]) do
			conn:Disconnect()
		end
		_playerConns[player] = nil
	end
end

-- =====================================================================
-- PUBLIC API
-- =====================================================================

function PetFollowerController.Init()
	log("init", "Initializing...")

	Players.PlayerAdded:Connect(setupPlayer)
	Players.PlayerRemoving:Connect(cleanupPlayer)

	for _, player in ipairs(Players:GetPlayers()) do
		task.spawn(setupPlayer, player)
	end

	bindKillFeedFirstDeathHook()
	bindRoundResetHook()
	task.spawn(function()
		for _ = 1, 30 do
			if _killFeedConn and _matchRoundConn then
				return
			end
			bindKillFeedFirstDeathHook()
			bindRoundResetHook()
			task.wait(1)
		end
	end)

	log("ready", "Ready — tracking pets for all players")
end

return PetFollowerController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="133">
          <Properties>
            <string name="Name">PetNpcFollower</string>
            <string name="Source"><![CDATA[-- Thin client-side resolver for walker follower implementation.
-- Prefers ReplicatedStorage.Pets.PetNpcFollower when available; falls back
-- to legacy client walker follow so pet spawning never hard-blocks.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local function tryRequireNpcFollower()
	local petsFolder = ReplicatedStorage:FindFirstChild("Pets")
	if not petsFolder then
		return nil
	end
	local moduleInst = petsFolder:FindFirstChild("PetNpcFollower")
	if not moduleInst then
		return nil
	end
	local ok, mod = pcall(function()
		return require(moduleInst)
	end)
	if ok then
		return mod
	end
	return nil
end

local remoteImpl = tryRequireNpcFollower()
if remoteImpl and typeof(remoteImpl.Start) == "function" then
	return remoteImpl
end

local Legacy = require(script.Parent:WaitForChild("PetWalkerFollowController"))

local Fallback = {}
function Fallback.Start(model: Model, owner: Player, opts)
	-- PetFollowController signature includes petId in arg3; it is not used.
	return Legacy.Start(model, owner, "", opts)
end

return Fallback
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="134">
          <Properties>
            <string name="Name">PetWalkerFollowController</string>
            <string name="Source"><![CDATA[-- Wrapper module for explicit walker-follow routing.
-- Keeps naming aligned with the walker-only behavior used by FNAF walker pets.
return require(script.Parent:WaitForChild("PetFollowController"))
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="135">
          <Properties>
            <string name="Name">QuestFeedbackController</string>
            <string name="Source"><![CDATA[--[[
	QuestFeedbackController
	Client-only presentation layer for quest intro prompts, quest notifications,
	and quest completion announcements.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

local Shared = ReplicatedStorage:WaitForChild("Shared", 10)
local DailyQuestConfig = require(Shared:WaitForChild("DailyQuestConfig", 10))
local MatchState = require(Shared:WaitForChild("MatchState", 10))
local PlayerState = require(Shared:WaitForChild("PlayerState", 10))

local QuestFeedbackController = {}

local GUI_NAME = "QuestFeedbackGui"
local HUD_GUI_NAME = "HUDGui"
local PANEL_GUI_NAME = "PanelGui"
local QUEST_BUTTON_NAME = "QuestsBtn"
local QUEST_PANEL_NAME = "QuestsPanel"
local STARTER_QUEST = DailyQuestConfig.StarterQuest
local STARTER_QUEST_ID = tostring(STARTER_QUEST and STARTER_QUEST.id or "starter_survive_1_round")

local MOBILE = UserInputService.TouchEnabled
local INTRO_WIDTH = MOBILE and 300 or 348
local INTRO_HEIGHT = MOBILE and 74 or 82
local INTRO_START_Y_SCALE = MOBILE and 0.6 or 0.56
local INTRO_HOLD_SECONDS = 1.15
local INTRO_MOVE_SECONDS = 0.45
local ANNOUNCEMENT_WIDTH = MOBILE and 340 or 420
local ANNOUNCEMENT_HEIGHT = MOBILE and 50 or 58
local ANNOUNCEMENT_HOLD_SECONDS = 1.75

local initialized = false
local screenGui: ScreenGui? = nil
local questButton: GuiButton? = nil
local questPanel: GuiObject? = nil
local questCountBadge: Frame? = nil
local questCountBadgeLabel: TextLabel? = nil
local bellUnread = false
local currentIntro: CanvasGroup? = nil
local currentAnnouncement: CanvasGroup? = nil
local currentFlash: Frame? = nil
local currentPresentationToken = 0
local queuePumpToken = 0
local matchStateValue: StringValue? = nil
local getStatusRemote: RemoteFunction? = nil
local updateRemote: RemoteEvent? = nil
local connectedQuestPanel: GuiObject? = nil
local activeQuestCount = 0
local lastLoggedBadgeCount: number? = nil
local lastLoggedAuthoritativeStatusSignature: string? = nil

local knownQuestStates: { [string]: { completed: boolean, progress: number, target: number } } = {}
local queuedIntroIds: { [string]: boolean } = {}
local shownIntroIds: { [string]: boolean } = {}
local announcedCompletionIds: { [string]: boolean } = {}
local introQueue: { [number]: { [string]: any } } = {}
local completionQueue: { [number]: { [string]: any } } = {}

local function log(message: string)
	print("[QuestFeedback] " .. message)
end

local function formatNumber(value: number): string
	local rounded = math.max(0, math.floor(tonumber(value) or 0))
	local reversed = string.reverse(tostring(rounded))
	local withCommas = string.reverse(reversed:gsub("(%d%d%d)", "%1,"))
	return withCommas:gsub("^,", "")
end

local function normalizeLabel(value: string): string
	local normalized = tostring(value or "")
	normalized = normalized:gsub("(%l)(%u)", "%1 %2")
	normalized = normalized:gsub("(%u)(%u%l)", "%1 %2")
	normalized = normalized:gsub("_", " ")
	normalized = normalized:gsub("%s+", " ")
	normalized = normalized:gsub("^%s+", ""):gsub("%s+$", "")
	return string.upper(normalized)
end

local function getQuestObjectiveText(quest): string
	local questType = tostring(quest.type or "")
	local target = math.max(1, math.floor(tonumber(quest.target) or 1))

	if tostring(quest.id or "") == STARTER_QUEST_ID or questType == "StarterSurviveRound" then
		return "SURVIVE 1 ROUND"
	elseif questType == "TimePlayed" then
		local minutes = math.max(1, math.floor(target / 60 + 0.5))
		return string.format("PLAY FOR %d MINUTE%s", minutes, minutes == 1 and "" or "S")
	elseif questType == "WinsToday" then
		return string.format("WIN %d MATCH%s", target, target == 1 and "" or "ES")
	elseif questType == "SwordKillsToday" then
		return string.format("GET %d SWORD KILL%s", target, target == 1 and "" or "S")
	elseif questType == "EliminationsToday" then
		return string.format("ELIMINATE %d PLAYER%s", target, target == 1 and "" or "S")
	elseif questType == "SurviveRoundsToday" then
		return string.format("SURVIVE %d ROUND%s", target, target == 1 and "" or "S")
	elseif questType == "TTSSurvivalsToday" then
		return string.format("SURVIVE TUNGTUNG %d TIME%s", target, target == 1 and "" or "S")
	elseif questType == "BrainrotIShowSpeedPickupsToday" then
		return string.format("PICK UP ISHOWSPEED %d TIME%s", target, target == 1 and "" or "S")
	elseif questType == "SurviveRoundsSingleMatch12" or questType == "SurviveRoundsSingleMatch15" then
		return string.format("SURVIVE %d ROUNDS IN ONE MATCH", target)
	end

	local desc = tostring(quest.description or quest.label or "")
	desc = desc:gsub("%.?%s*[Rr]eward:%s*.+$", "")
	if desc ~= "" then
		return normalizeLabel(desc)
	end

	return normalizeLabel(tostring(quest.label or "NEW QUEST"))
end

local function isQuestFeedbackEligible(): boolean
	local playerState = tostring(LocalPlayer:GetAttribute("PlayerState") or "")
	local matchState = matchStateValue and tostring(matchStateValue.Value or "") or ""

	if playerState == PlayerState.States.InMatch then
		return false
	end

	if matchState == MatchState.States.Playing or matchState == MatchState.States.Ending then
		return false
	end

	if matchState == MatchState.States.Intermission then
		return true
	end

	return playerState == PlayerState.States.Lobby
		or playerState == PlayerState.States.Waiting
		or playerState == PlayerState.States.TutorialLocked
end

local function isQuestPanelVisible(): boolean
	return questPanel ~= nil and questPanel.Visible == true
end

local function destroyInstanceSafely(instance: Instance?)
	if instance and instance.Parent then
		instance:Destroy()
	end
end

local function ensureScreenGui()
	if screenGui and screenGui.Parent then
		return
	end

	local existing = PlayerGui:FindFirstChild(GUI_NAME)
	if existing and existing:IsA("ScreenGui") then
		existing:ClearAllChildren()
		screenGui = existing
	else
		screenGui = Instance.new("ScreenGui")
		screenGui.Name = GUI_NAME
		screenGui.ResetOnSpawn = false
		screenGui.IgnoreGuiInset = false
		screenGui.DisplayOrder = 60
		screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
		screenGui.Parent = PlayerGui
	end
end

local function ensureQuestButton()
	if questButton and questButton.Parent then
		return questButton
	end

	local hudGui = PlayerGui:FindFirstChild(HUD_GUI_NAME)
	if not hudGui then
		return nil
	end

	local button = hudGui:FindFirstChild(QUEST_BUTTON_NAME, true)
	if button and button:IsA("GuiButton") then
		questButton = button
	end

	return questButton
end

local function ensureQuestPanel()
	if questPanel and questPanel.Parent then
		return questPanel
	end

	local panelGui = PlayerGui:FindFirstChild(PANEL_GUI_NAME)
	if not panelGui then
		return nil
	end

	local panel = panelGui:FindFirstChild(QUEST_PANEL_NAME, true)
	if panel and panel:IsA("GuiObject") then
		questPanel = panel
	end

	return questPanel
end

local function clearTransientUi(reason: string)
	currentPresentationToken += 1
	local hadTransientUi = currentIntro ~= nil or currentAnnouncement ~= nil or currentFlash ~= nil
	destroyInstanceSafely(currentIntro)
	destroyInstanceSafely(currentAnnouncement)
	destroyInstanceSafely(currentFlash)
	currentIntro = nil
	currentAnnouncement = nil
	currentFlash = nil

	if hadTransientUi and reason ~= "" then
		log("presentation_cleared reason=" .. reason)
	end
end

local function ensureQuestCountBadge()
	local button = ensureQuestButton()
	if not button then
		return nil
	end

	if questCountBadge and questCountBadge.Parent == button then
		return questCountBadge
	end

	destroyInstanceSafely(questCountBadge)

	local badge = Instance.new("Frame")
	badge.Name = "QuestCountBadge"
	badge.AnchorPoint = Vector2.new(0.5, 0.5)
	badge.Position = UDim2.new(1, -8, 0, 8)
	badge.Size = UDim2.fromOffset(MOBILE and 22 or 24, MOBILE and 22 or 24)
	badge.BackgroundColor3 = Color3.fromRGB(255, 235, 92)
	badge.BackgroundTransparency = 0.02
	badge.BorderSizePixel = 0
	badge.Visible = false
	badge.ZIndex = button.ZIndex + 4
	badge.Parent = button
	questCountBadge = badge

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(1, 0)
	corner.Parent = badge

	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(120, 18, 18)
	stroke.Thickness = 1.6
	stroke.Transparency = 0.1
	stroke.Parent = badge

	local shadow = Instance.new("ImageLabel")
	shadow.Name = "Shadow"
	shadow.AnchorPoint = Vector2.new(0.5, 0.5)
	shadow.Position = UDim2.fromScale(0.5, 0.5)
	shadow.Size = UDim2.new(1, 12, 1, 12)
	shadow.BackgroundTransparency = 1
	shadow.Image = "rbxassetid://1316045217"
	shadow.ImageColor3 = Color3.new(0, 0, 0)
	shadow.ImageTransparency = 0.58
	shadow.ScaleType = Enum.ScaleType.Slice
	shadow.SliceCenter = Rect.new(10, 10, 118, 118)
	shadow.ZIndex = badge.ZIndex - 1
	shadow.Parent = badge

	local label = Instance.new("TextLabel")
	label.Name = "Count"
	label.AnchorPoint = Vector2.new(0.5, 0.5)
	label.Position = UDim2.fromScale(0.5, 0.5)
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBlack
	label.Text = ""
	label.TextColor3 = Color3.fromRGB(110, 12, 12)
	label.TextSize = MOBILE and 12 or 13
	label.ZIndex = badge.ZIndex + 1
	label.Parent = badge
	questCountBadgeLabel = label

	log("quest_count_badge_attached button=" .. button.Name)
	return badge
end

local function refreshQuestCountBadge(reason: string)
	local badge = ensureQuestCountBadge()
	if not badge or not questCountBadgeLabel then
		return
	end

	local nextVisible = activeQuestCount > 0
	badge.Visible = nextVisible
	questCountBadgeLabel.Text = nextVisible and tostring(math.min(activeQuestCount, 99)) or ""

	if lastLoggedBadgeCount ~= activeQuestCount then
		lastLoggedBadgeCount = activeQuestCount
		log(string.format("quest_count_badge_updated count=%d reason=%s", activeQuestCount, reason))
		if activeQuestCount == 0 then
			log("quest_count_badge_hidden reason=count_zero")
		end
	end
end

local function updateActiveQuestCount(status, reason: string)
	if type(status) ~= "table" or type(status.quests) ~= "table" then
		return
	end
	activeQuestCount = #status.quests
	refreshQuestCountBadge(reason)
end

local function setBellUnread(active: boolean, reason: string)
	if bellUnread == active then
		return
	end

	bellUnread = active
end

local function stopBellAnimation()
	return
end

local function startBellAnimation()
	return
end

local function ensureBell()
	return nil
end

local function refreshBell()
	return
end

local function playCompletionFlash()
	ensureScreenGui()
	if not screenGui then
		return
	end

	destroyInstanceSafely(currentFlash)

	local flash = Instance.new("Frame")
	flash.Name = "QuestCompletionFlash"
	flash.Size = UDim2.fromScale(1, 1)
	flash.BackgroundColor3 = Color3.fromRGB(255, 244, 176)
	flash.BackgroundTransparency = 1
	flash.BorderSizePixel = 0
	flash.ZIndex = 49
	flash.Parent = screenGui
	currentFlash = flash

	local fadeIn = TweenService:Create(
		flash,
		TweenInfo.new(0.07, Enum.EasingStyle.Sine, Enum.EasingDirection.Out),
		{ BackgroundTransparency = 0.84 }
	)
	local fadeOut = TweenService:Create(
		flash,
		TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
		{ BackgroundTransparency = 1 }
	)

	fadeIn:Play()
	fadeIn.Completed:Connect(function()
		if flash.Parent then
			fadeOut:Play()
		end
	end)
	fadeOut.Completed:Connect(function()
		if currentFlash == flash then
			destroyInstanceSafely(flash)
			currentFlash = nil
		end
	end)
end

local function createBannerFrame(name: string, size: UDim2, position: UDim2): CanvasGroup
	ensureScreenGui()

	local frame = Instance.new("CanvasGroup")
	frame.Name = name
	frame.AnchorPoint = Vector2.new(0.5, 0.5)
	frame.Position = position
	frame.Size = size
	frame.BackgroundColor3 = Color3.fromRGB(118, 20, 20)
	frame.BackgroundTransparency = 0.05
	frame.BorderSizePixel = 0
	frame.GroupTransparency = 1
	frame.ZIndex = 50
	frame.Parent = screenGui

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, MOBILE and 16 or 18)
	corner.Parent = frame

	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(255, 219, 92)
	stroke.Thickness = 2
	stroke.Transparency = 0.1
	stroke.Parent = frame

	local gradient = Instance.new("UIGradient")
	gradient.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(220, 46, 46)),
		ColorSequenceKeypoint.new(0.45, Color3.fromRGB(158, 24, 24)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(92, 12, 12)),
	})
	gradient.Rotation = 90
	gradient.Parent = frame

	local shadow = Instance.new("ImageLabel")
	shadow.Name = "Shadow"
	shadow.AnchorPoint = Vector2.new(0.5, 0.5)
	shadow.Position = UDim2.fromScale(0.5, 0.5)
	shadow.Size = UDim2.new(1, 28, 1, 28)
	shadow.BackgroundTransparency = 1
	shadow.Image = "rbxassetid://1316045217"
	shadow.ImageColor3 = Color3.new(0, 0, 0)
	shadow.ImageTransparency = 0.44
	shadow.ScaleType = Enum.ScaleType.Slice
	shadow.SliceCenter = Rect.new(10, 10, 118, 118)
	shadow.ZIndex = frame.ZIndex - 1
	shadow.Parent = frame

	return frame
end

local function addLabel(parent: Instance, name: string, text: string, position: UDim2, size: UDim2, textSize: number, color: Color3): TextLabel
	local label = Instance.new("TextLabel")
	label.Name = name
	label.BackgroundTransparency = 1
	label.Position = position
	label.Size = size
	label.Font = Enum.Font.LuckiestGuy
	label.Text = text
	label.TextColor3 = color
	label.TextSize = textSize
	label.TextWrapped = true
	label.TextXAlignment = Enum.TextXAlignment.Center
	label.TextYAlignment = Enum.TextYAlignment.Center
	label.ZIndex = 51
	label.Parent = parent

	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.new(0, 0, 0)
	stroke.Thickness = 2
	stroke.Transparency = 0.18
	stroke.Parent = label

	return label
end

local function getQuestButtonTargetCenter(): Vector2?
	local button = ensureQuestButton()
	if not button then
		return nil
	end

	local absolutePosition = button.AbsolutePosition
	local absoluteSize = button.AbsoluteSize
	return absolutePosition + (absoluteSize * 0.5)
end

local function pumpQueues(reason: string)
	queuePumpToken += 1
	local token = queuePumpToken

	task.defer(function()
		if token ~= queuePumpToken then
			return
		end

		refreshBell()

		if currentIntro or currentAnnouncement then
			return
		end

		if not isQuestFeedbackEligible() or isQuestPanelVisible() then
			return
		end

		local nextIntro = table.remove(introQueue, 1)
		if not nextIntro then
			return
		end

		local targetCenter = getQuestButtonTargetCenter()
		if not targetCenter then
			table.insert(introQueue, 1, nextIntro)
			return
		end
		queuedIntroIds[nextIntro.id] = nil

		local presentationToken = currentPresentationToken + 1
		currentPresentationToken = presentationToken

		local intro = createBannerFrame(
			"QuestIntroPopup",
			UDim2.fromOffset(INTRO_WIDTH, INTRO_HEIGHT),
			UDim2.new(0.5, 0, INTRO_START_Y_SCALE, 0)
		)
		currentIntro = intro

		addLabel(
			intro,
			"QuestObjective",
			getQuestObjectiveText(nextIntro),
			UDim2.fromOffset(18, 8),
			UDim2.new(1, -36, 0, MOBILE and 30 or 34),
			MOBILE and 18 or 20,
			Color3.fromRGB(255, 255, 255)
		)

		addLabel(
			intro,
			"QuestReward",
			"REWARD: " .. string.upper(DailyQuestConfig.GetRewardLabel(nextIntro.reward)),
			UDim2.fromOffset(18, MOBILE and 42 or 48),
			UDim2.new(1, -36, 0, 24),
			MOBILE and 11 or 12,
			Color3.fromRGB(255, 234, 162)
		)

		local fadeIn = TweenService:Create(
			intro,
			TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
			{ GroupTransparency = 0 }
		)
		fadeIn:Play()
		log(string.format(
			"quest_intro_shown quest=%s reward=%s",
			tostring(nextIntro.id),
			DailyQuestConfig.GetRewardLabel(nextIntro.reward)
		))

		task.delay(INTRO_HOLD_SECONDS, function()
			if currentPresentationToken ~= presentationToken or currentIntro ~= intro then
				return
			end

			local moveTween = TweenService:Create(
				intro,
				TweenInfo.new(INTRO_MOVE_SECONDS, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut),
				{
					Position = UDim2.fromOffset(targetCenter.X, targetCenter.Y),
					Size = UDim2.fromOffset(128, 34),
					GroupTransparency = 0.12,
				}
			)
			moveTween:Play()
			moveTween.Completed:Connect(function()
				if currentPresentationToken ~= presentationToken or currentIntro ~= intro then
					return
				end

				log(string.format(
					"quest_intro_docked quest=%s target=%s",
					tostring(nextIntro.id),
					QUEST_BUTTON_NAME
				))
				setBellUnread(true, "quest_intro_" .. tostring(nextIntro.id))
				refreshBell()
				destroyInstanceSafely(intro)
				currentIntro = nil
				pumpQueues("intro_finished")
			end)
		end)
	end)
end

local function queueIntro(quest, reason: string)
	if tostring(quest.id or "") ~= STARTER_QUEST_ID then
		return
	end
	if shownIntroIds[quest.id] or queuedIntroIds[quest.id] or quest.completed then
		return
	end

	shownIntroIds[quest.id] = true
	queuedIntroIds[quest.id] = true
	table.insert(introQueue, quest)
	log(string.format("intro_queued quest=%s reason=%s source=authoritative_status", tostring(quest.id), reason))
	pumpQueues("intro_queued")
end

local function queueCompletion(quest)
	if announcedCompletionIds[quest.id] then
		return
	end

	announcedCompletionIds[quest.id] = true
	if tostring(quest.id or "") ~= STARTER_QUEST_ID then
		setBellUnread(true, "quest_complete_" .. tostring(quest.id))
	end
	refreshBell()
	log(string.format("completion_seen quest=%s routed=AnnouncementController", tostring(quest.id)))
end

local function logAuthoritativeStatus(status, reason: string)
	if type(status) ~= "table" or type(status.quests) ~= "table" then
		return
	end

	local entries = table.create(#status.quests)
	local starterPresent = false
	for _, quest in ipairs(status.quests) do
		local questId = tostring(quest.id or "")
		if questId == STARTER_QUEST_ID then
			starterPresent = true
		end
		table.insert(entries, questId)
	end

	local payloadSignature = tostring(#status.quests) .. "::" .. table.concat(entries, "|")
	if lastLoggedAuthoritativeStatusSignature == payloadSignature then
		return
	end
	lastLoggedAuthoritativeStatusSignature = payloadSignature

	log(string.format(
		"authoritative_status_received reason=%s activeQuestCount=%d starterPresent=%s quests=%s",
		reason,
		#status.quests,
		tostring(starterPresent),
		table.concat(entries, ",")
	))
end

local function applyStatus(status, reason: string)
	if type(status) ~= "table" or status.dataLoaded ~= true or type(status.quests) ~= "table" then
		return
	end

	logAuthoritativeStatus(status, reason)
	updateActiveQuestCount(status, reason)

	local seenQuestIds = {}

	for _, quest in ipairs(status.quests) do
		if type(quest) == "table" and type(quest.id) == "string" then
			seenQuestIds[quest.id] = true

			local previous = knownQuestStates[quest.id]
			local completed = quest.completed == true
			local progress = math.floor(tonumber(quest.progress) or 0)
			local target = math.floor(tonumber(quest.target) or 0)
			knownQuestStates[quest.id] = {
				completed = completed,
				progress = progress,
				target = target,
			}

			if previous and previous.completed ~= true and completed then
				queueCompletion(quest)
			end

			if not previous then
				queueIntro(quest, reason .. "_new")
			end
		end
	end

	for questId in pairs(knownQuestStates) do
		if not seenQuestIds[questId] then
			knownQuestStates[questId] = nil
		end
	end

	refreshBell()
end

local function requestCurrentStatus(reason: string)
	if not getStatusRemote then
		return
	end

	local ok, status = pcall(getStatusRemote.InvokeServer, getStatusRemote)
	if ok and status then
		applyStatus(status, reason)
	end
end

local function connectQuestPanelVisibility()
	local panel = ensureQuestPanel()
	if not panel or connectedQuestPanel == panel then
		return
	end
	connectedQuestPanel = panel

	panel:GetPropertyChangedSignal("Visible"):Connect(function()
		if panel.Visible then
			setBellUnread(false, "quests_opened")
			refreshBell()
			clearTransientUi("quests_opened")
		else
			pumpQueues("quests_closed")
		end
	end)

	if panel.Visible then
		setBellUnread(false, "quests_opened")
		refreshBell()
	end
end

function QuestFeedbackController.Init()
	if initialized then
		return
	end
	initialized = true

	ensureScreenGui()
	ensureBell()

	task.spawn(function()
		local remotes = ReplicatedStorage:WaitForChild("Remotes", 15)
		if not remotes then
			warn("[QuestFeedback] Remotes not found")
			return
		end

		local statusRemote = remotes:WaitForChild("DailyQuest_GetStatus", 15)
		if statusRemote and statusRemote:IsA("RemoteFunction") then
			getStatusRemote = statusRemote
		end

		local dailyUpdate = remotes:WaitForChild("DailyQuest_Update", 15)
		if dailyUpdate and dailyUpdate:IsA("RemoteEvent") then
			updateRemote = dailyUpdate
			updateRemote.OnClientEvent:Connect(function(status)
				applyStatus(status, "remote_update")
			end)
		end

		requestCurrentStatus("init")
	end)

	task.spawn(function()
		local matchStatus = ReplicatedStorage:WaitForChild("MatchStatus", 15)
		if not matchStatus then
			warn("[QuestFeedback] MatchStatus not found")
			return
		end

		matchStateValue = matchStatus:WaitForChild("State", 10) :: StringValue?
		if matchStateValue then
			matchStateValue.Changed:Connect(function()
				if not isQuestFeedbackEligible() then
					clearTransientUi("match_state_changed")
				end
				refreshBell()
				pumpQueues("match_state_changed")
			end)
		end
	end)

	LocalPlayer:GetAttributeChangedSignal("PlayerState"):Connect(function()
		if not isQuestFeedbackEligible() then
			clearTransientUi("player_state_changed")
		end
		refreshBell()
		pumpQueues("player_state_changed")
	end)

	task.spawn(function()
		local hudGui = PlayerGui:WaitForChild(HUD_GUI_NAME, 15)
		if hudGui then
			hudGui.DescendantAdded:Connect(function(descendant)
				if descendant.Name == QUEST_BUTTON_NAME and descendant:IsA("GuiButton") then
					questButton = descendant
					ensureBell()
					refreshBell()
					pumpQueues("quest_button_ready")
				end
			end)
		end
		ensureQuestButton()
		ensureBell()
		refreshQuestCountBadge("quest_button_ready")
		refreshBell()
		pumpQueues("quest_button_ready")
	end)

	task.spawn(function()
		local panelGui = PlayerGui:WaitForChild(PANEL_GUI_NAME, 15)
		if panelGui then
			panelGui.DescendantAdded:Connect(function(descendant)
				if descendant.Name == QUEST_PANEL_NAME and descendant:IsA("GuiObject") then
					questPanel = descendant
					connectQuestPanelVisibility()
					pumpQueues("quest_panel_ready")
				end
			end)
		end
		ensureQuestPanel()
		connectQuestPanelVisibility()
	end)

	refreshBell()
	pumpQueues("init")
end

return QuestFeedbackController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="136">
          <Properties>
            <string name="Name">RewardGrantListener</string>
            <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")

local RewardGrantListener = {}
local initialized = false
local shownBundleTokens: { [string]: number } = {}
local shownBundleCooldownSeconds = 10
local recentlyShownRewards: { [string]: number } = {}
local rewardDedupWindowSeconds = 2

local function getRewardPopup()
	local ui = script.Parent:FindFirstChild("UI")
	if not ui then return nil end
	local mod = ui:FindFirstChild("RewardPopup")
	if not mod then return nil end
	local ok, result = pcall(require, mod)
	if ok then return result end
	return nil
end

local function mapSinglePayload(payload)
	local rewardType = tostring(payload.type or "")
	if rewardType == "Currency" then
		local amount = tonumber(payload.amount) or 0
		return {
			title = "PURCHASED!",
			name = string.format("+%d Fate Coins", amount),
			itemType = "Coins",
			itemId = "fate_coins",
			rarityText = "Common",
			icon = payload.popupImageOverride or "rbxassetid://81959864063463",
			okText = "NICE!",
			popupSource = tostring(payload.source or ""),
		}
	elseif rewardType == "Spin" then
		local amount = tonumber(payload.amount) or 0
		return {
			title = "PURCHASED!",
			name = string.format("+%d Spins", amount),
			itemType = "Spin",
			itemId = "spin_purchased",
			rarityText = "Rare",
			icon = payload.popupImageOverride or "",
			okText = "NICE!",
			popupSource = tostring(payload.source or ""),
		}
	end
	local iconAsset = payload.imageAssetId or payload.popupImageOverride or ""
	return {
		title = "PURCHASED!",
		name = payload.name or payload.id or "Reward",
		itemType = rewardType,
		itemId = payload.id or "",
		category = payload.category or "",
		rarityText = payload.rarity or "Common",
		icon = iconAsset,
		okText = "NICE!",
		popupSource = tostring(payload.source or ""),
	}
end

local function isShopRewardPayload(payload): boolean
	if type(payload) ~= "table" then
		return false
	end
	local source = tostring(payload.source or "")
	if source ~= "Shop" and source ~= "GamePass" and source ~= "DevProduct" then
		return false
	end
	local pType = tostring(payload.type or payload.grantType or "")
	return pType == "Crown"
		or pType == "Pet"
		or pType == "IconImage"
		or pType == "Currency"
		or pType == "Spin"
end

local function shouldShowRewardPayload(payload): boolean
	if not isShopRewardPayload(payload) then
		return false
	end
	local source = tostring(payload.source or "")
	local pType = tostring(payload.type or payload.grantType or "")
	local id = tostring(payload.id or "")
	if id == "" then
		return true
	end
	local key = string.format("%s|%s|%s", source, pType, id)
	local now = os.clock()
	local last = recentlyShownRewards[key]
	if last and (now - last) <= rewardDedupWindowSeconds then
		return false
	end
	recentlyShownRewards[key] = now
	return true
end

function RewardGrantListener.Init()
	if initialized then return end
	initialized = true

	local remotes = ReplicatedStorage:WaitForChild("Remotes", 15)
	local rewardRE = remotes and remotes:WaitForChild("RewardGranted", 15)
	local bundleConfirmedRE = remotes and remotes:WaitForChild("BundlePurchaseConfirmed", 15)
	local purchaseGrantedRE = remotes and remotes:FindFirstChild("PurchaseGranted")
	if not rewardRE or not rewardRE:IsA("RemoteEvent") then
		warn("[RewardGrantListener] RewardGranted remote missing")
		return
	end

	rewardRE.OnClientEvent:Connect(function(payload)
		local RewardPopup = getRewardPopup()
		if not RewardPopup then
			warn("[RewardGrantListener] RewardPopup unavailable")
			return
		end
		if type(payload) ~= "table" then
			return
		end
		if tostring(payload.type or "") == "Bundle" then
			print("[BundlePopup] BLOCKED reason=INIT_OR_OWNED_STATE")
			return
		end
		-- Deduplicate shop/devproduct-style rewards when both RewardGranted
		-- and fallback purchase/inventory events arrive close together.
		if isShopRewardPayload(payload) and not shouldShowRewardPayload(payload) then
			return
		end
		local source = tostring(payload.source or "")
		local pType = tostring(payload.type or payload.grantType or "")
		if (source == "Shop" or source == "GamePass" or source == "DevProduct")
			and (pType == "Crown" or pType == "Pet" or pType == "IconImage" or pType == "Currency" or pType == "Spin")
		then
			print(string.format("[ShopGrantPopup] type=%s id=%s image=%s rarity=%s",
				pType,
				tostring(payload.id or ""),
				tostring(payload.imageAssetId or payload.popupImageOverride or ""),
				tostring(payload.rarity or "Common")))
		end

		if type(payload.batchItems) == "table" and #payload.batchItems > 0 then
			local items = {}
			for _, item in ipairs(payload.batchItems) do
				table.insert(items, mapSinglePayload(item))
			end
			RewardPopup.ShowBatch(items)
		else
			RewardPopup.Show(mapSinglePayload(payload))
		end
	end)

	local purchaseListenerConnected = false
	local function connectPurchaseGranted(remote: Instance?)
		if purchaseListenerConnected then
			return
		end
		if not remote or not remote:IsA("RemoteEvent") then
			return
		end
		purchaseListenerConnected = true
		remote.OnClientEvent:Connect(function(payload)
			local RewardPopup = getRewardPopup()
			if not RewardPopup then
				warn("[RewardGrantListener] RewardPopup unavailable")
				return
			end
			if type(payload) ~= "table" then
				return
			end
			if not shouldShowRewardPayload(payload) then
				return
			end
			if not payload.source or payload.source == "" then
				payload.source = "Shop"
			end
			local pType = tostring(payload.type or payload.grantType or "")
			print(string.format("[ShopGrantPopup] type=%s id=%s image=%s",
				pType,
				tostring(payload.id or ""),
				tostring(payload.imageAssetId or payload.popupImageOverride or "")))
			RewardPopup.Show(mapSinglePayload(payload))
		end)
	end

	connectPurchaseGranted(purchaseGrantedRE)
	if remotes then
		remotes.ChildAdded:Connect(function(child)
			if child.Name == "PurchaseGranted" then
				connectPurchaseGranted(child)
			end
		end)
	end

	local inventoryUpdateRE = remotes and remotes:FindFirstChild("InventoryUpdated")
	if inventoryUpdateRE and inventoryUpdateRE:IsA("RemoteEvent") then
		inventoryUpdateRE.OnClientEvent:Connect(function(reason, payload)
			if reason ~= "GrantConfirmed" then
				return
			end
			if not shouldShowRewardPayload(payload) then
				return
			end
			local RewardPopup = getRewardPopup()
			if not RewardPopup then
				warn("[RewardGrantListener] RewardPopup unavailable")
				return
			end
			local pType = tostring(payload.type or payload.grantType or "")
			print(string.format("[ShopGrantPopupFallback] type=%s id=%s source=%s",
				pType,
				tostring(payload.id or ""),
				tostring(payload.source or "")))
			RewardPopup.Show(mapSinglePayload(payload))
		end)
	end

	if not bundleConfirmedRE or not bundleConfirmedRE:IsA("RemoteEvent") then
		warn("[RewardGrantListener] BundlePurchaseConfirmed remote missing")
		return
	end

	bundleConfirmedRE.OnClientEvent:Connect(function(bundleId, payload)
		local RewardPopup = getRewardPopup()
		if not RewardPopup then
			warn("[RewardGrantListener] RewardPopup unavailable")
			return
		end
		local bundleKey = tostring(bundleId or "")
		local data = (type(payload) == "table") and payload or {}
		local token = tostring(data.token or bundleKey)
		local now = os.clock()
		local prior = shownBundleTokens[token]
		if prior and (now - prior) <= shownBundleCooldownSeconds then
			return
		end
		shownBundleTokens[token] = now
		print(string.format("[BundlePopup] SHOW bundle=%s reason=SERVER_CONFIRMED", bundleKey))
		RewardPopup.Show({
			title = tostring(data.title or "PURCHASED!"),
			name = tostring(data.name or "Bundle purchase completed"),
			itemType = tostring(data.itemType or "Bundle"),
			itemId = tostring(data.itemId or bundleKey),
			rarityText = tostring(data.rarityText or "Common"),
			icon = data.icon or "",
			okText = tostring(data.okText or "NICE!"),
		})
	end)
end

return RewardGrantListener
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="137">
          <Properties>
            <string name="Name">RigNormalizer</string>
            <string name="Source"><![CDATA[-- Client-side resolver for RigNormalizer.
-- Uses ReplicatedStorage.Pets.RigNormalizer when available.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local function tryRemote()
	local petsFolder = ReplicatedStorage:FindFirstChild("Pets")
	if not petsFolder then
		return nil
	end
	local moduleInst = petsFolder:FindFirstChild("RigNormalizer")
	if not moduleInst then
		return nil
	end
	local ok, mod = pcall(function()
		return require(moduleInst)
	end)
	if ok then
		return mod
	end
	return nil
end

local remote = tryRemote()
if remote and typeof(remote.EnsureHumanoidRootPart) == "function" then
	return remote
end

local Fallback = {}

local function findFirstBasePart(model: Model): BasePart?
	return model:FindFirstChildWhichIsA("BasePart", true)
end

local function findTorsoRoot(model: Model): BasePart?
	local lower = model:FindFirstChild("LowerTorso", true)
	if lower and lower:IsA("BasePart") then
		return lower
	end
	local upper = model:FindFirstChild("UpperTorso", true)
	if upper and upper:IsA("BasePart") then
		return upper
	end
	return nil
end

function Fallback.EnsureHumanoidRootPart(model: Model): BasePart?
	local existing = model:FindFirstChild("HumanoidRootPart", true)
	if existing and existing:IsA("BasePart") then
		model.PrimaryPart = existing
		return existing
	end

	local torso = findTorsoRoot(model)
	local rootRef = torso or model.PrimaryPart or findFirstBasePart(model)
	if not rootRef then
		return nil
	end

	local hrp = Instance.new("Part")
	hrp.Name = "HumanoidRootPart"
	hrp.Size = Vector3.new(2, 2, 1)
	hrp.Transparency = 1
	hrp.CanCollide = false
	hrp.CanQuery = false
	hrp.CanTouch = false
	hrp.Massless = false
	hrp.Anchored = false
	hrp.CFrame = rootRef.CFrame
	hrp.Parent = model

	local jointTarget = torso or rootRef
	local rootJoint = Instance.new("Motor6D")
	rootJoint.Name = "RootJoint"
	rootJoint.Part0 = hrp
	rootJoint.Part1 = jointTarget
	rootJoint.C0 = CFrame.new()
	rootJoint.C1 = jointTarget.CFrame:ToObjectSpace(hrp.CFrame)
	rootJoint.Parent = hrp

	model.PrimaryPart = hrp
	return hrp
end

return Fallback
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="138">
          <Properties>
            <string name="Name">SpectateController</string>
            <string name="Source"><![CDATA[--[[
	SpectateController
	Client-side camera control for spectating.
	
	When player is eliminated:
	- Server fires SpectateTarget with target UserId
	- Client attaches camera to target's character
	- When target is nil (no one alive), reverts to own character
	
	Future: Add next/prev cycling keybinds
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

-- Wait for remotes
local Remotes = ReplicatedStorage:WaitForChild("Remotes", 10)
if not Remotes then
	warn("[SpectateController] Remotes folder not found — spectating disabled")
	return {} -- Must return a value (ModuleScript requirement)
end

local SpectateTarget = Remotes:WaitForChild("SpectateTarget", 5)
if not SpectateTarget then
	warn("[SpectateController] SpectateTarget remote not found — spectating disabled")
	return {} -- Must return a value (ModuleScript requirement)
end

-- State
local isSpectating = false
local currentTarget: Player? = nil
local originalCameraSubject = nil

--[[ HELPERS ]]

local function log(...)
	print("[SpectateController]", ...)
end

local function getHumanoid(player: Player): Humanoid?
	local character = player.Character
	if not character then return nil end
	return character:FindFirstChildOfClass("Humanoid")
end

local function attachCameraToTarget(target: Player?)
	if not target then
		-- Revert to own character
		if originalCameraSubject then
			Camera.CameraSubject = originalCameraSubject
		else
			local myHumanoid = getHumanoid(LocalPlayer)
			if myHumanoid then
				Camera.CameraSubject = myHumanoid
			end
		end
		currentTarget = nil
		isSpectating = false
		log("Stopped spectating - camera reverted")
		return
	end
	
	local targetHumanoid = getHumanoid(target)
	if targetHumanoid then
		Camera.CameraSubject = targetHumanoid
		currentTarget = target
		isSpectating = true
		log("Now spectating:", target.Name)
	else
		-- Target has no humanoid yet, wait and retry
		task.spawn(function()
			for _ = 1, 10 do
				task.wait(0.2)
				local humanoid = getHumanoid(target)
				if humanoid then
					Camera.CameraSubject = humanoid
					currentTarget = target
					isSpectating = true
					log("Now spectating:", target.Name)
					return
				end
			end
			log("Failed to find target humanoid for:", target.Name)
		end)
	end
end

--[[ EVENT HANDLERS ]]

SpectateTarget.OnClientEvent:Connect(function(targetUserId: number?)
	-- Store original camera subject if not already spectating
	if not isSpectating and not originalCameraSubject then
		originalCameraSubject = Camera.CameraSubject
	end
	
	if not targetUserId then
		-- No target - revert camera
		attachCameraToTarget(nil)
		return
	end
	
	-- Find player by UserId
	local target = Players:GetPlayerByUserId(targetUserId)
	if target then
		attachCameraToTarget(target)
	else
		log("Target player not found for UserId:", targetUserId)
		attachCameraToTarget(nil)
	end
end)

-- Handle target leaving
Players.PlayerRemoving:Connect(function(player)
	if currentTarget == player then
		log("Spectate target left, finding new target...")
		-- Server should send new target, but as fallback revert
		task.delay(0.5, function()
			if currentTarget == player then
				attachCameraToTarget(nil)
			end
		end)
	end
end)

-- Reset on respawn
LocalPlayer.CharacterAdded:Connect(function(character)
	if isSpectating then
		-- Keep spectating if we were spectating
		return
	end
	
	-- Reset original camera subject
	local humanoid = character:WaitForChild("Humanoid", 5)
	if humanoid then
		originalCameraSubject = humanoid
	end
end)

log("Initialized")

return {} -- ModuleScript must return exactly one value
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="139">
          <Properties>
            <string name="Name">StormFXController</string>
            <string name="Source"><![CDATA[--[[
	StormFXController
	Client-side storm atmosphere when camera or player is outside the barrier.
	
	Decision:
	  shouldStorm = (cameraOutside OR playerOutside)
	  - cameraOutside: camera XZ position past arena bounds + CamOutsideMargin
	  - playerOutside: HumanoidRootPart XZ position past arena bounds
	  Both use POSITION only — no look-vector, FOV, pitch, or zoom distance.
	
	Effects (screen-space, no character particles):
	  ON  → tween Atmosphere to storm values (0.15s smooth entry), enable CC + Bloom
	  OFF → INSTANT SNAP Atmosphere to original, disable CC + Bloom
	        Snap-OFF ensures no stuck/dark/half-tween lighting states.
	
	Evaluated at 20 Hz (MinUpdateInterval = 0.05s) via RenderStepped.
	Uses hysteresis enter/exit band to prevent flicker — no time delay.
	
	InMatch only. Lobby/spectators: no effects.
	
	Logging:
	  - Init/Destroy: always print (one-time)
	  - ON/OFF state changes: only when DebugLogs = true (with reason + distances)
	  - Periodic state dump (~1/s): only when DebugTickLogs = true
	
	API:
		Init()      → Start the controller (call once from client bootstrap)
		Destroy()   → Stop and clean up everything
]]

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local StormFXConfig = require(Shared:WaitForChild("StormFXConfig"))

local LocalPlayer = Players.LocalPlayer

--[[ INTERNAL STATE ]]
local initialized = false
local fxEnabled = false
local activeBarrierPresentationProfile = "Unknown"
local lastAppliedStormProfileAttr: string? = nil
local lastAppliedPresentationProfileAttr: string? = nil
local lastAppliedPresentationRevision: number = -1

-- Effects (created once at Init, destroyed at Destroy)
local colorCorrection: ColorCorrectionEffect? = nil
local bloom: BloomEffect? = nil

-- Atmosphere
local atmosphere: Atmosphere? = nil
local origAtmoValues: {
	Density: number,
	Haze: number,
	Color: Color3,
	Decay: Color3,
	Offset: number,
	Glare: number,
}? = nil
local activeTween: Tween? = nil

-- Connections
local renderConnection: RBXScriptConnection? = nil
local characterRemovingConnection: RBXScriptConnection? = nil

-- Hysteresis (per-trigger boolean)
local hystCameraOutside: boolean = false
local hystPlayerOutside: boolean = false

-- Timing
local lastUpdate: number = 0
local lastDebugLog: number = 0
local lastBoundsLogKey: string = ""

-- Bounds cache (refreshed periodically — walls only move on shrink)
local cachedBounds: {
	centerX: number,
	centerZ: number,
	halfX: number,
	halfZ: number,
}? = nil
local lastBoundsRefresh: number = 0

local StormFXController = {}

--[[ HELPERS ]]

local function debugLog(...)
	if StormFXConfig.DebugLogs then
		print("[StormFX]", ...)
	end
end

--[[
	Remove any stale StormFX_* instances from the local player's character.
	Safety net for old code versions that attached particles to HumanoidRootPart.
]]
local function cleanupStaleCharacterFX()
	local character = LocalPlayer.Character
	if not character then return end

	local cleaned = 0
	for _, descendant in ipairs(character:GetDescendants()) do
		if typeof(descendant) == "Instance" and string.find(descendant.Name, "StormFX_") then
			descendant:Destroy()
			cleaned += 1
		end
	end

	if cleaned > 0 then
		print(string.format("[StormFX] Cleaned %d stale StormFX_ instances from character", cleaned))
	end
end

--[[
	Remove duplicate StormFX effects from Lighting (hot-reload safety).
]]
local function cleanupStaleLightingFX()
	local cleaned = 0
	for _, child in ipairs(Lighting:GetChildren()) do
		if child.Name == "StormFX_CC" or child.Name == "StormFX_Bloom" then
			child:Destroy()
			cleaned += 1
		end
	end
	if cleaned > 0 then
		print(string.format("[StormFX] Cleaned %d stale effects from Lighting", cleaned))
	end
end

local function isInstanceInLighting(inst: Instance?): boolean
	if not inst then return false end
	local ok, parent = pcall(function()
		return inst.Parent
	end)
	return ok and parent == Lighting
end

local function captureAtmosphereOriginalValues(atmo: Atmosphere)
	origAtmoValues = {
		Density = atmo.Density,
		Haze = atmo.Haze,
		Color = atmo.Color,
		Decay = atmo.Decay,
		Offset = atmo.Offset,
		Glare = atmo.Glare,
	}
end

--[[
	Ensure storm FX instances are still valid after server-side Lighting swaps.
	This self-heals references if mode lighting replaced Lighting children.
]]
local function ensureEffectsAlive()
	if not isInstanceInLighting(atmosphere) then
		local atmo = Lighting:FindFirstChildOfClass("Atmosphere")
		if atmo then
			atmosphere = atmo
			captureAtmosphereOriginalValues(atmo)
		else
			local newAtmo = Instance.new("Atmosphere")
			newAtmo.Name = "StormFX_Atmosphere"
			newAtmo.Density = 0
			newAtmo.Haze = 0
			newAtmo.Offset = 0
			newAtmo.Color = Color3.fromRGB(199, 170, 107)
			newAtmo.Decay = Color3.fromRGB(92, 60, 13)
			newAtmo.Glare = 0
			newAtmo.Parent = Lighting
			atmosphere = newAtmo
			captureAtmosphereOriginalValues(newAtmo)
		end
	end

	if not isInstanceInLighting(colorCorrection) then
		local cc = Instance.new("ColorCorrectionEffect")
		cc.Name = "StormFX_CC"
		cc.Enabled = false
		cc.TintColor = StormFXConfig.CCTintColor
		cc.Brightness = StormFXConfig.CCBrightness
		cc.Contrast = StormFXConfig.CCContrast
		cc.Saturation = StormFXConfig.CCSaturation
		cc.Parent = Lighting
		colorCorrection = cc
	end

	if not isInstanceInLighting(bloom) then
		local bl = Instance.new("BloomEffect")
		bl.Name = "StormFX_Bloom"
		bl.Enabled = false
		bl.Intensity = StormFXConfig.BloomIntensity
		bl.Size = StormFXConfig.BloomSize
		bl.Threshold = StormFXConfig.BloomThreshold
		bl.Parent = Lighting
		bloom = bl
	end
end

local function applyProfileToFxInstances()
	-- Apply current profile colors/settings to already-created FX instances.
	if colorCorrection then
		colorCorrection.TintColor = StormFXConfig.CCTintColor
		colorCorrection.Brightness = StormFXConfig.CCBrightness
		colorCorrection.Contrast = StormFXConfig.CCContrast
		colorCorrection.Saturation = StormFXConfig.CCSaturation
	end
	if bloom then
		bloom.Intensity = StormFXConfig.BloomIntensity
		bloom.Size = StormFXConfig.BloomSize
		bloom.Threshold = StormFXConfig.BloomThreshold
	end
	if atmosphere and fxEnabled and origAtmoValues then
		atmosphere.Density = math.max(origAtmoValues.Density, StormFXConfig.AtmosphereDensity)
		atmosphere.Haze = math.max(origAtmoValues.Haze, StormFXConfig.AtmosphereHaze)
		atmosphere.Color = StormFXConfig.AtmosphereColor
	end
end

local function applyReplicatedPresentationProfile(context: string)
	local presentationProfile = Lighting:GetAttribute("BarrierPresentationProfile")
	if type(presentationProfile) == "string" and presentationProfile ~= "" then
		activeBarrierPresentationProfile = presentationProfile
	end

	local stormProfile = Lighting:GetAttribute("StormVfxProfile")
	if type(stormProfile) ~= "string" or stormProfile == "" then
		-- Live-safe fallback: treat missing/late StormVfxProfile as Normal
		-- unless an explicit valid presentation profile indicates otherwise.
		if activeBarrierPresentationProfile == "Brainrot" then
			stormProfile = "Brainrot"
		else
			stormProfile = "Normal"
		end
		warn(string.format(
			"[StormFX] Missing StormVfxProfile attribute (context=%s presentation=%s) -> fallback=%s",
			context,
			activeBarrierPresentationProfile,
			stormProfile
		))
	end
	if not StormFXConfig.IsValidProfile(stormProfile) then
		warn(string.format(
			"[StormFX] Invalid StormVfxProfile '%s' (context=%s presentation=%s)",
			stormProfile,
			context,
			activeBarrierPresentationProfile
		))
		return
	end

	lastAppliedStormProfileAttr = stormProfile
	lastAppliedPresentationProfileAttr = activeBarrierPresentationProfile
	lastAppliedPresentationRevision = tonumber(Lighting:GetAttribute("BarrierPresentationRevision")) or lastAppliedPresentationRevision
	StormFXConfig.ApplyProfile(stormProfile)
	applyProfileToFxInstances()
	print(string.format(
		"[StormFX] PresentationApplied context=%s presentation=%s stormProfile=%s farViewBranchEnabled=true profileFound=%s normalProfileApplied=%s revision=%s",
		context,
		activeBarrierPresentationProfile,
		StormFXConfig.GetActiveProfileName(),
		tostring(StormFXConfig.IsValidProfile(stormProfile)),
		tostring(StormFXConfig.GetActiveProfileName() == "Normal"),
		tostring(lastAppliedPresentationRevision)
	))
end

local function syncReplicatedPresentationProfile()
	local stormProfile = Lighting:GetAttribute("StormVfxProfile")
	local presentationProfile = Lighting:GetAttribute("BarrierPresentationProfile")
	local revision = tonumber(Lighting:GetAttribute("BarrierPresentationRevision")) or -1
	local stormStr = if type(stormProfile) == "string" then stormProfile else nil
	local presentationStr = if type(presentationProfile) == "string" and presentationProfile ~= "" then presentationProfile else nil

	-- Keep sync comparisons aligned with applyReplicatedPresentationProfile() fallback behavior.
	-- Without this, nil attributes can mismatch cached applied values every frame and spam logs.
	local effectivePresentation = presentationStr or activeBarrierPresentationProfile
	local effectiveStorm = stormStr
	if not effectiveStorm or effectiveStorm == "" then
		if effectivePresentation == "Brainrot" then
			effectiveStorm = "Brainrot"
		else
			effectiveStorm = "Normal"
		end
	end

	if effectiveStorm ~= lastAppliedStormProfileAttr
		or effectivePresentation ~= lastAppliedPresentationProfileAttr
		or revision ~= lastAppliedPresentationRevision
	then
		applyReplicatedPresentationProfile("RenderSync")
	end
end

--[[
	Refresh cached bounds from the replicated StormWall parts.
	Called every BoundsCacheInterval seconds (not every evaluation).
]]
local function refreshBoundsCache()
	local function logBoundsResolvedOnce(source: string, found: boolean, cx: number?, cz: number?, hx: number?, hz: number?)
		local key = string.format("%s|%s|%s|%s|%s|%s|%s",
			source,
			tostring(found),
			tostring(cx),
			tostring(cz),
			tostring(hx),
			tostring(hz),
			StormFXConfig.GetActiveProfileName()
		)
		if key == lastBoundsLogKey then
			return
		end
		lastBoundsLogKey = key
		if found then
			print(string.format(
				"[StormFX] BoundsResolved source=%s found=true center=(%.1f,%.1f) half=(%.1f,%.1f) profile=%s",
				source,
				cx or 0, cz or 0, hx or 0, hz or 0,
				StormFXConfig.GetActiveProfileName()
			))
		else
			print(string.format(
				"[StormFX] BoundsResolved source=%s found=false profile=%s",
				source,
				StormFXConfig.GetActiveProfileName()
			))
		end
	end

	local function applyAttributeBoundsFallback()
		local cx = Lighting:GetAttribute("StormBoundsCenterX")
		local cz = Lighting:GetAttribute("StormBoundsCenterZ")
		local hx = Lighting:GetAttribute("StormBoundsHalfX")
		local hz = Lighting:GetAttribute("StormBoundsHalfZ")
		if type(cx) ~= "number" or type(cz) ~= "number" or type(hx) ~= "number" or type(hz) ~= "number" then
			cachedBounds = nil
			logBoundsResolvedOnce("Attributes", false, nil, nil, nil, nil)
			return
		end
		cachedBounds = {
			centerX = cx,
			centerZ = cz,
			halfX = hx,
			halfZ = hz,
		}
		logBoundsResolvedOnce("Attributes", true, cx, cz, hx, hz)
	end

	local arenaEffects = Workspace:FindFirstChild("ArenaEffects")
	if not arenaEffects then
		applyAttributeBoundsFallback()
		return
	end

	local bounds = arenaEffects:FindFirstChild("Bounds")
	if not bounds then
		applyAttributeBoundsFallback()
		return
	end

	local north, south, east, west = nil, nil, nil, nil

	for _, wall in ipairs(bounds:GetChildren()) do
		if not wall:IsA("BasePart") then continue end
		if wall.Name == "StormWall_North" then north = wall
		elseif wall.Name == "StormWall_South" then south = wall
		elseif wall.Name == "StormWall_East" then east = wall
		elseif wall.Name == "StormWall_West" then west = wall
		end
	end

	if not (north and south and east and west) then
		applyAttributeBoundsFallback()
		return
	end

	-- Inner faces define the active play rectangle
	local maxZ = north.Position.Z - north.Size.Z / 2
	local minZ = south.Position.Z + south.Size.Z / 2
	local maxX = east.Position.X - east.Size.X / 2
	local minX = west.Position.X + west.Size.X / 2

	cachedBounds = {
		centerX = (minX + maxX) / 2,
		centerZ = (minZ + maxZ) / 2,
		halfX = (maxX - minX) / 2,
		halfZ = (maxZ - minZ) / 2,
	}
	logBoundsResolvedOnce(
		"StormWalls",
		true,
		cachedBounds.centerX,
		cachedBounds.centerZ,
		cachedBounds.halfX,
		cachedBounds.halfZ
	)
end

--[[
	Signed distance from a point (XZ only) to the arena bounds edge.
	Positive = outside bounds by that many studs.
	Negative = inside bounds by that many studs.
	Returns -math.huge if bounds unavailable.
]]
local function getSignedDistanceToBounds(x: number, z: number): number
	if not cachedBounds then return -math.huge end
	local b = cachedBounds
	local dx = math.abs(x - b.centerX) - b.halfX
	local dz = math.abs(z - b.centerZ) - b.halfZ
	return math.max(dx, dz)
end

--[[
	Camera signed distance to bounds edge (XZ plane).
	Positive = camera is OUTSIDE bounds.
]]
local function getCameraOutsideDistance(): number
	local cam = Workspace.CurrentCamera
	if not cam then return -math.huge end
	local p = cam.CFrame.Position
	return getSignedDistanceToBounds(p.X, p.Z)
end

--[[
	Player signed distance to bounds edge (XZ plane).
	Positive = player is OUTSIDE bounds.
]]
local function getPlayerOutsideDistance(): number
	local character = LocalPlayer.Character
	if not character then return -math.huge end
	local rootPart = character:FindFirstChild("HumanoidRootPart")
	if not rootPart then return -math.huge end
	local p = rootPart.Position
	return getSignedDistanceToBounds(p.X, p.Z)
end

--[[
	Tween atmosphere toward target values (used for ON transition only).
	Cancels any previously running atmosphere tween first.
]]
local function tweenAtmosphereOn(targetProps: { Density: number, Haze: number, Color: Color3 })
	if not atmosphere then return end
	if activeTween then activeTween:Cancel(); activeTween = nil end

	activeTween = TweenService:Create(
		atmosphere,
		TweenInfo.new(StormFXConfig.TweenDuration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		targetProps
	)
	activeTween:Play()
end

--[[
	Snap atmosphere to exact values INSTANTLY (no tween).
	Used for OFF and forceReset to guarantee no stuck half-state.
]]
local function snapAtmosphereToOriginal()
	if activeTween then activeTween:Cancel(); activeTween = nil end

	if atmosphere and origAtmoValues then
		atmosphere.Density = origAtmoValues.Density
		atmosphere.Haze = origAtmoValues.Haze
		atmosphere.Color = origAtmoValues.Color
	end
end

--[[
	Enable storm FX (smooth ON).
	Tweens atmosphere to storm values, enables CC + Bloom.
]]
local function enableFX(reason: string, camDist: number, plyDist: number)
	if fxEnabled then return end
	fxEnabled = true
	print(string.format(
		"[StormFX] ON profile=%s reason=%s camDist=%.1f plyDist=%.1f",
		StormFXConfig.GetActiveProfileName(), reason, camDist, plyDist
	))
	debugLog(string.format("ON  reason=%s camDist=%.1f plyDist=%.1f", reason, camDist, plyDist))

	-- Smooth tween atmosphere to storm overlay
	if origAtmoValues then
		tweenAtmosphereOn({
			Density = math.max(origAtmoValues.Density, StormFXConfig.AtmosphereDensity),
			Haze = math.max(origAtmoValues.Haze, StormFXConfig.AtmosphereHaze),
			Color = StormFXConfig.AtmosphereColor,
		})
	end

	-- Enable post-processing instantly
	if colorCorrection then colorCorrection.Enabled = true end
	if bloom then bloom.Enabled = true end
end

--[[
	Disable storm FX (INSTANT OFF).
	Snaps atmosphere to original values, disables CC + Bloom.
	No tween — no risk of competing tweens or half-states.
]]
local function disableFX(camDist: number, plyDist: number)
	if not fxEnabled then return end
	fxEnabled = false
	print(string.format(
		"[StormFX] OFF profile=%s camDist=%.1f plyDist=%.1f",
		StormFXConfig.GetActiveProfileName(), camDist, plyDist
	))
	debugLog(string.format("OFF reason=BothInside camDist=%.1f plyDist=%.1f", camDist, plyDist))

	-- SNAP atmosphere to exact original values — no tween, no drift
	snapAtmosphereToOriginal()

	-- Disable post-processing instantly
	if colorCorrection then colorCorrection.Enabled = false end
	if bloom then bloom.Enabled = false end
end

--[[
	Force OFF + reset all hysteresis (used on state exit, character remove, etc.).
	Also cleans up any stale character particles.
]]
local function forceReset()
	snapAtmosphereToOriginal()

	if colorCorrection then colorCorrection.Enabled = false end
	if bloom then bloom.Enabled = false end

	cleanupStaleCharacterFX()

	fxEnabled = false
	hystCameraOutside = false
	hystPlayerOutside = false
end

--[[
	Main evaluation loop — runs on RenderStepped, throttled to MinUpdateInterval.
	
	Two-trigger system:
	  1. Camera outside arena bounds (position-based, pitch-independent)
	  2. Player outside arena bounds (position-based)
	  shouldStorm = (1) OR (2)
	
	Hysteresis is a clean enter/exit band per trigger:
	  Camera: ON at +Margin, OFF at +(Margin - Hyst)
	  Player: ON at 0,       OFF at -Hyst
]]
local function onRenderStep()
	ensureEffectsAlive()
	syncReplicatedPresentationProfile()
	applyProfileToFxInstances()

	-- Throttle: skip if called faster than MinUpdateInterval
	local now = tick()
	if now - lastUpdate < StormFXConfig.MinUpdateInterval then return end
	lastUpdate = now

	-- Master switch
	if not StormFXConfig.Enabled then
		if fxEnabled then forceReset() end
		return
	end

	-- InMatch only — lobby/spectators get nothing
	local state = LocalPlayer:GetAttribute("PlayerState")
	if state ~= "InMatch" then
		if fxEnabled or hystCameraOutside or hystPlayerOutside then
			forceReset()
		end
		return
	end

	-- Refresh bounds cache periodically (walls only move on shrink)
	if now - lastBoundsRefresh >= StormFXConfig.BoundsCacheInterval then
		refreshBoundsCache()
		lastBoundsRefresh = now
	end

	if not cachedBounds then
		if fxEnabled then forceReset() end
		return
	end

	-- Compute signed distances: positive = outside bounds, negative = inside
	local camDist = getCameraOutsideDistance()
	local plyDist = getPlayerOutsideDistance()

	local margin = StormFXConfig.CameraOutsideMarginStuds
	local hyst = StormFXConfig.HysteresisStuds

	----------- HYSTERESIS: Camera outside bounds -----------
	-- ON  when camDist >= margin          (camera is 5+ studs past edge)
	-- OFF when camDist <  margin - hyst   (camera is back at edge or inside)
	if hystCameraOutside then
		if camDist < (margin - hyst) then
			hystCameraOutside = false
		end
	else
		if camDist >= margin then
			hystCameraOutside = true
		end
	end

	----------- HYSTERESIS: Player outside bounds -----------
	-- ON  when plyDist >= 0       (player just crossed outside)
	-- OFF when plyDist <  -hyst   (player is 5+ studs back inside)
	if hystPlayerOutside then
		if plyDist < -hyst then
			hystPlayerOutside = false
		end
	else
		if plyDist >= 0 then
			hystPlayerOutside = true
		end
	end

	-- Single authoritative decision
	local shouldStorm = hystCameraOutside or hystPlayerOutside

	----------- TOGGLE -----------
	if shouldStorm and not fxEnabled then
		local reasons = {}
		if hystCameraOutside then table.insert(reasons, "CameraOutside") end
		if hystPlayerOutside then table.insert(reasons, "PlayerOutside") end
		enableFX(table.concat(reasons, "+"), camDist, plyDist)
	elseif not shouldStorm and fxEnabled then
		disableFX(camDist, plyDist)
	end

	----------- PERIODIC DEBUG LOG (every ~1s, only if enabled) -----------
	if StormFXConfig.DebugTickLogs and now - lastDebugLog >= 1 then
		lastDebugLog = now
		print(string.format(
			"[StormFX:state] camDist=%.1f plyDist=%.1f hystCam=%s hystPly=%s fx=%s",
			camDist, plyDist,
			tostring(hystCameraOutside), tostring(hystPlayerOutside),
			tostring(fxEnabled)
		))
	end
end

--[[ PUBLIC API ]]

function StormFXController.Init()
	if initialized then return end

	if not StormFXConfig.Enabled then
		print("[StormFX] Disabled via config")
		return
	end

	-- Safety: clean up stale effects from previous code versions / hot-reloads
	cleanupStaleCharacterFX()
	cleanupStaleLightingFX()
	applyReplicatedPresentationProfile("Init")

	ensureEffectsAlive()

	-- Evaluate on RenderStepped (throttled to MinUpdateInterval inside handler)
	renderConnection = RunService.RenderStepped:Connect(onRenderStep)

	-- Server pushes active storm profile via Lighting attribute.
	Lighting:GetAttributeChangedSignal("StormVfxProfile"):Connect(function()
		applyReplicatedPresentationProfile("StormVfxProfileChanged")
		debugLog(string.format("Profile changed -> %s", StormFXConfig.GetActiveProfileName()))
	end)

	Lighting:GetAttributeChangedSignal("BarrierPresentationProfile"):Connect(function()
		applyReplicatedPresentationProfile("BarrierPresentationProfileChanged")
		debugLog(string.format("Presentation changed -> %s", activeBarrierPresentationProfile))
	end)

	Lighting:GetAttributeChangedSignal("BarrierPresentationRevision"):Connect(function()
		local revision = tonumber(Lighting:GetAttribute("BarrierPresentationRevision")) or -1
		local source = tostring(Lighting:GetAttribute("BarrierPresentationSource") or "Unknown")
		print(string.format(
			"[StormFX] BarrierRefreshTriggered source=%s revision=%d activeProfile=%s",
			source,
			revision,
			StormFXConfig.GetActiveProfileName()
		))
		applyReplicatedPresentationProfile("BarrierPresentationRevisionChanged")
	end)

	-- Force-reset on character removed (death / respawn)
	characterRemovingConnection = LocalPlayer.CharacterRemoving:Connect(function()
		forceReset()
	end)

	initialized = true
	print(string.format(
		"[StormFX] Init — CamMargin=%d Hyst=%d Tween=%.2fs EvalHz=%.0f",
		StormFXConfig.CameraOutsideMarginStuds,
		StormFXConfig.HysteresisStuds,
		StormFXConfig.TweenDuration,
		1 / StormFXConfig.MinUpdateInterval
	))
end

function StormFXController.Destroy()
	forceReset()

	if renderConnection then
		renderConnection:Disconnect()
		renderConnection = nil
	end

	if characterRemovingConnection then
		characterRemovingConnection:Disconnect()
		characterRemovingConnection = nil
	end

	if colorCorrection then
		colorCorrection:Destroy()
		colorCorrection = nil
	end

	if bloom then
		bloom:Destroy()
		bloom = nil
	end

	if atmosphere and atmosphere.Name == "StormFX_Atmosphere" then
		atmosphere:Destroy()
	end
	atmosphere = nil
	origAtmoValues = nil

	initialized = false
	cachedBounds = nil

	print("[StormFX] Destroyed")
end

return StormFXController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="140">
          <Properties>
            <string name="Name">SwordPickupController</string>
            <string name="Source"><![CDATA[--[[
	SwordPickupController
	Client-side hover animation + spawn announcement for sword pickups.

	Watches Workspace.SwordPickups for models with "SwordPickup" attribute.
	Animates hover + rotation identical to CoinPickupController / BrainrotPickupController.
	Shows "A SWORD HAS RANDOMLY SPAWNED" announcement + plays sound cue on remote.

	API:
		Init()
]]

local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local PlayerState = require(Shared:WaitForChild("PlayerState"))
local FeedbackConfig = require(Shared:WaitForChild("FeedbackConfig"))
local AnnouncementController = require(script.Parent:WaitForChild("AnnouncementController"))

local SwordPickupController = {}

local initialized = false

local FOLDER_NAME = "SwordPickups"
local BOB_AMPLITUDE = 0.4
local BOB_SPEED = 2.5
local ROTATION_SPEED = 25

local activeAnimations = {}

local function startAnimation(model)
	if activeAnimations[model] then return end

	local allParts = {}
	if model:IsA("BasePart") then
		if not model:GetAttribute("NoAnimate") then
			table.insert(allParts, model)
		end
	else
		for _, desc in ipairs(model:GetDescendants()) do
			if desc:IsA("BasePart") and not desc:GetAttribute("NoAnimate") then
				table.insert(allParts, desc)
			end
		end
	end

	if #allParts == 0 then return end

	local refPart = allParts[1]
	local refCF = refPart.CFrame
	local refInv = refCF:Inverse()

	local relatives = {}
	for _, part in ipairs(allParts) do
		relatives[part] = refInv * part.CFrame
	end

	local basePos = refCF.Position
	local baseTilt = refCF.Rotation

	local startTime = tick()

	local conn = RunService.Heartbeat:Connect(function()
		if not model or not model.Parent then return end

		local elapsed = tick() - startTime
		local bobY = math.sin(elapsed * BOB_SPEED) * BOB_AMPLITUDE
		local rotAngle = elapsed * ROTATION_SPEED

		local newRefCF = CFrame.new(basePos + Vector3.new(0, bobY, 0))
			* CFrame.Angles(0, math.rad(rotAngle), 0)
			* baseTilt

		for _, part in ipairs(allParts) do
			if part and part.Parent then
				part.CFrame = newRefCF * relatives[part]
			end
		end
	end)

	activeAnimations[model] = {
		connection = conn,
		startTime = startTime,
	}
end

local function stopAnimation(model)
	local anim = activeAnimations[model]
	if anim then
		if anim.connection and anim.connection.Connected then
			anim.connection:Disconnect()
		end
		activeAnimations[model] = nil
	end
end

local function onModelAdded(model)
	if not model:GetAttribute("SwordPickup") then return end
	task.defer(function()
		if model and model.Parent then
			startAnimation(model)
		end
	end)
end

local function onModelRemoved(model)
	stopAnimation(model)
end

local function watchFolder(folder)
	for _, child in ipairs(folder:GetChildren()) do
		onModelAdded(child)
	end
	folder.ChildAdded:Connect(onModelAdded)
	folder.ChildRemoved:Connect(onModelRemoved)
end

local function showAnnouncement(data)
	AnnouncementController.QueueLocal({
		text = "A SWORD HAS RANDOMLY SPAWNED",
		style = "Sword",
		priority = FeedbackConfig.Announcements.Priorities.Sword,
		durationSeconds = FeedbackConfig.Announcements.DisplayDurationSeconds,
		dedupeKey = "sword_spawn_announcement",
		cooldownSeconds = 1,
		requiresInMatch = data.matchOnly == true,
		soundId = data.soundId,
	})
end

local function isLocalPlayerInMatch(): boolean
	return Players.LocalPlayer:GetAttribute("PlayerState") == PlayerState.States.InMatch
end

local function showDeniedMessage()
	AnnouncementController.QueueLocal({
		text = "You already have a sword!",
		style = "Reward",
		priority = FeedbackConfig.Announcements.Priorities.Reward,
		durationSeconds = 1.35,
		dedupeKey = "sword_denied",
		cooldownSeconds = 1.25,
		requiresInMatch = true,
	})
end

function SwordPickupController.Init()
	if initialized then return end
	initialized = true
	AnnouncementController.Init()

	task.spawn(function()
		local folder = Workspace:FindFirstChild(FOLDER_NAME)
		if folder then
			watchFolder(folder)
		end

		Workspace.ChildAdded:Connect(function(child)
			if child.Name == FOLDER_NAME and child:IsA("Folder") then
				watchFolder(child)
			end
		end)
	end)

	task.spawn(function()
		local remotes = ReplicatedStorage:WaitForChild("Remotes", 15)
		if not remotes then return end
		local remote = remotes:WaitForChild("SwordSpawned", 15)
		if not remote then return end

		remote.OnClientEvent:Connect(function(data)
			if type(data) == "table" then
				if data.denied then
					showDeniedMessage()
				else
					if data.matchOnly and not isLocalPlayerInMatch() then
						return
					end
					showAnnouncement(data)
				end
			end
		end)
	end)

	print("[SwordPickupController] Initialized")
end

return SwordPickupController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="141">
          <Properties>
            <string name="Name">TungTungSahurController</string>
            <string name="Source"><![CDATA[--[[
	TungTungSahurController
	Client-side UI for TungTungSahur hazard.

	Styled to match sword announcement exactly:
	  - IgnoreGuiInset = true (absolute screen coordinates)
	  - No box/pill backgrounds — plain text only
	  - Font GothamBold, TextSize 22, red #FF5050 + dark stroke

	Layout (absolute Y from screen top, IgnoreGuiInset=true):
	  Y=8:   TTS countdown text  (ABOVE round badge ~Y52)
	  Y=150: Sword announcement  (unchanged, this script does NOT touch it)
	  Y=195: TTS spawn text      (BELOW sword, no overlap)

	Survival text: center-screen, text-only, green — no box.

	Remote events received from TungTungSahurEvent:
	  "Spawn",   durationSeconds        -> show banner + start countdown
	  "Despawn", showSurvival:boolean   -> hide UI; if true + player alive -> popup
]]

local Players           = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService      = game:GetService("TweenService")
local Shared            = ReplicatedStorage:WaitForChild("Shared")
local PlayerState       = require(Shared:WaitForChild("PlayerState"))

local ANNOUNCEMENT_HOLD      = 3.0    -- seconds banner stays solid
local FADE_TIME              = 0.35
local STACK_DISPLAY_ORDER    = 85
local SURVIVAL_DISPLAY_ORDER = 90

-- Absolute Y positions (IgnoreGuiInset = true)
local TIMER_Y    = 8    -- above round badge (~Y52 absolute)
local ANNOUNCE_Y = 195  -- below sword (sword: Y150, height 40 → bottom at Y190)

-- Sword-matching text style
local TEXT_COLOR   = Color3.fromRGB(255, 80, 80)
local STROKE_COLOR = Color3.fromRGB(50, 0, 0)
local TEXT_FONT    = Enum.Font.GothamBold
local TEXT_SIZE    = 22

-- --- STATE -------------------------------------------------------------------
local localPlayer              = Players.LocalPlayer
local stackGui: ScreenGui?     = nil
local countdownLabel: TextLabel? = nil
local announceLabel: TextLabel?  = nil
local survivalGui: ScreenGui?  = nil
local survivalLabel: TextLabel?  = nil

local countdownThread: thread? = nil
local announceThread: thread?  = nil

local TungTungSahurController = {}

-- --- HELPERS -----------------------------------------------------------------

local function cancelThread(t: thread?)
	if t then pcall(task.cancel, t) end
end

local function checkDisableGui()
	if countdownLabel and countdownLabel.Visible then return end
	if announceLabel  and announceLabel.Visible  then return end
	if stackGui then stackGui.Enabled = false end
end

local function makeSwordLabel(parent: Instance, text: string, yPos: number): TextLabel
	local lbl = Instance.new("TextLabel")
	lbl.Name                   = "TTSLabel"
	lbl.Size                   = UDim2.new(1, 0, 0, 28)
	lbl.Position               = UDim2.new(0.5, 0, 0, yPos)
	lbl.AnchorPoint            = Vector2.new(0.5, 0)
	lbl.BackgroundTransparency = 1
	lbl.Font                   = TEXT_FONT
	lbl.Text                   = text
	lbl.TextColor3             = TEXT_COLOR
	lbl.TextSize               = TEXT_SIZE
	lbl.TextScaled             = false
	lbl.TextXAlignment         = Enum.TextXAlignment.Center
	lbl.TextTransparency       = 1  -- hidden until shown
	lbl.Visible                = false
	lbl.Parent                 = parent

	local stroke = Instance.new("UIStroke")
	stroke.Color          = STROKE_COLOR
	stroke.Thickness      = 2
	stroke.Transparency   = 1  -- synced with TextTransparency
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
	stroke.Parent         = lbl

	return lbl
end

local function showLabel(lbl: TextLabel?)
	if not lbl then return end
	lbl.Visible = true
	lbl.TextTransparency = 0
	local s = lbl:FindFirstChildOfClass("UIStroke")
	if s then s.Transparency = 0.3 end
end

local function hideLabel(lbl: TextLabel?)
	if not lbl then return end
	lbl.Visible = false
end

local function fadeOutLabel(lbl: TextLabel?, onDone: (() -> ())?)
	if not lbl then if onDone then onDone() end return end
	local info = TweenInfo.new(FADE_TIME, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	TweenService:Create(lbl, info, { TextTransparency = 1 }):Play()
	local s = lbl:FindFirstChildOfClass("UIStroke")
	if s then TweenService:Create(s, info, { Transparency = 1 }):Play() end
	task.delay(FADE_TIME + 0.05, function()
		lbl.Visible = false
		if onDone then onDone() end
	end)
end

-- --- GUI BUILD ---------------------------------------------------------------

local function buildStackGui()
	local playerGui = localPlayer:WaitForChild("PlayerGui", 10)
	if not playerGui then return end

	local old = playerGui:FindFirstChild("TungTungStatusStack")
	if old then old:Destroy() end

	stackGui = Instance.new("ScreenGui")
	stackGui.Name           = "TungTungStatusStack"
	stackGui.ResetOnSpawn   = false
	stackGui.DisplayOrder   = STACK_DISPLAY_ORDER
	stackGui.IgnoreGuiInset = true   -- absolute coords, same as sword announcement
	stackGui.Enabled        = false
	stackGui.Parent         = playerGui

	countdownLabel = makeSwordLabel(stackGui, "TUNGTUNGSAHUR: 30", TIMER_Y)
	countdownLabel.Name = "CountdownText"

	announceLabel = makeSwordLabel(stackGui, "TUNGTUNGSAHUR HAS SPAWNED", ANNOUNCE_Y)
	announceLabel.Name = "AnnounceText"

	print("[TTS UI] TopCenterStack mounted -- TimerY=" .. TIMER_Y
		.. " AnnounceY=" .. ANNOUNCE_Y .. " IgnoreGuiInset=true (no boxes)")
end

local function buildSurvivalGui()
	local playerGui = localPlayer:WaitForChild("PlayerGui", 10)
	if not playerGui then return end

	local old = playerGui:FindFirstChild("TungTungSurvivalGui")
	if old then old:Destroy() end

	survivalGui = Instance.new("ScreenGui")
	survivalGui.Name           = "TungTungSurvivalGui"
	survivalGui.ResetOnSpawn   = false
	survivalGui.DisplayOrder   = SURVIVAL_DISPLAY_ORDER
	survivalGui.IgnoreGuiInset = true
	survivalGui.Enabled        = false
	survivalGui.Parent         = playerGui

	-- Text-only survival message, no background box
	survivalLabel = Instance.new("TextLabel")
	survivalLabel.Name                   = "SurvivalText"
	survivalLabel.AnchorPoint            = Vector2.new(0.5, 0.5)
	survivalLabel.Position               = UDim2.new(0.5, 0, 0.45, 0)
	survivalLabel.Size                   = UDim2.new(0.9, 0, 0, 34)
	survivalLabel.BackgroundTransparency = 1
	survivalLabel.Font                   = Enum.Font.GothamBold
	survivalLabel.Text                   = "YOU HAVE SURVIVED TUNGTUNGSAHUR!"
	survivalLabel.TextColor3             = Color3.fromRGB(80, 255, 80)
	survivalLabel.TextSize               = 22
	survivalLabel.TextScaled             = false
	survivalLabel.TextWrapped            = true
	survivalLabel.TextXAlignment         = Enum.TextXAlignment.Center
	survivalLabel.TextTransparency       = 1
	survivalLabel.Parent                 = survivalGui

	local stroke = Instance.new("UIStroke")
	stroke.Color          = Color3.fromRGB(0, 50, 0)
	stroke.Thickness      = 2
	stroke.Transparency   = 1
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
	stroke.Parent         = survivalLabel
end

-- --- SHOW / HIDE -------------------------------------------------------------

local function showCountdown()
	if stackGui then stackGui.Enabled = true end
	showLabel(countdownLabel)
end

local function hideCountdown()
	hideLabel(countdownLabel)
	checkDisableGui()
end

local function showAnnounce()
	if stackGui then stackGui.Enabled = true end
	showLabel(announceLabel)
end

local function hideAnnounce()
	hideLabel(announceLabel)
	checkDisableGui()
end

local function startCountdown(duration: number)
	hideCountdown()
	cancelThread(countdownThread)
	if not countdownLabel then return end

	showCountdown()

	countdownThread = task.spawn(function()
		local startTime = tick()
		while true do
			local elapsed   = tick() - startTime
			local remaining = math.max(0, math.ceil(duration - elapsed))
			if countdownLabel then
				countdownLabel.Text = string.format("TUNGTUNGSAHUR: %d", remaining)
			end
			if remaining <= 0 then
				hideCountdown()
				countdownThread = nil
				return
			end
			task.wait(0.25)
		end
	end)
end

local function runShowAnnouncement()
	cancelThread(announceThread)
	if not announceLabel then return end

	showAnnounce()

	announceThread = task.spawn(function()
		task.wait(ANNOUNCEMENT_HOLD)
		fadeOutLabel(announceLabel, function()
			hideAnnounce()
			announceThread = nil
		end)
	end)
end

local function showSurvivalPopup()
	if not survivalGui or not survivalLabel then return end

	local char = localPlayer.Character
	if char then
		local hum = char:FindFirstChildOfClass("Humanoid")
		if not hum or hum.Health <= 0 then return end
	end

	survivalGui.Enabled = true
	survivalLabel.TextTransparency = 1
	local stroke = survivalLabel:FindFirstChildOfClass("UIStroke")
	if stroke then stroke.Transparency = 1 end

	local inInfo = TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	TweenService:Create(survivalLabel, inInfo, { TextTransparency = 0 }):Play()
	if stroke then TweenService:Create(stroke, inInfo, { Transparency = 0.3 }):Play() end

	task.delay(3.5, function()
		if not survivalGui or not survivalGui.Parent then return end
		local outInfo = TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		TweenService:Create(survivalLabel, outInfo, { TextTransparency = 1 }):Play()
		if stroke then TweenService:Create(stroke, outInfo, { Transparency = 1 }):Play() end
		task.wait(0.6)
		survivalGui.Enabled = false
	end)
end

local function onDespawn(showSurvival: boolean)
	cancelThread(countdownThread)
	cancelThread(announceThread)
	countdownThread = nil
	announceThread  = nil
	hideCountdown()
	hideAnnounce()
	if stackGui then stackGui.Enabled = false end

	if showSurvival then
		showSurvivalPopup()
	end
end

local function isLocalPlayerInMatch(): boolean
	return localPlayer:GetAttribute("PlayerState") == PlayerState.States.InMatch
end

-- --- INIT --------------------------------------------------------------------

function TungTungSahurController.Init()
	buildStackGui()
	buildSurvivalGui()

	local remotes = ReplicatedStorage:WaitForChild("Remotes", 10)
	if not remotes then
		warn("[TungTungSahurController] Remotes folder not found")
		return
	end

	local remote = remotes:WaitForChild("TungTungSahurEvent", 10)
	if not remote then
		warn("[TungTungSahurController] TungTungSahurEvent remote not found")
		return
	end

	remote.OnClientEvent:Connect(function(action: string, extraArg)
		if action == "Spawn" then
			if not isLocalPlayerInMatch() then
				return
			end
			local dur = (type(extraArg) == "number") and extraArg or 30
			runShowAnnouncement()
			startCountdown(dur)
		elseif action == "Despawn" then
			if not isLocalPlayerInMatch() then
				onDespawn(false)
				return
			end
			local showSurvival = extraArg == true
			onDespawn(showSurvival)
		end
	end)

	-- Safety: if local player leaves InMatch (results/lobby transition), force-hide any
	-- lingering TTS UI immediately even if a despawn packet was missed.
	localPlayer:GetAttributeChangedSignal("PlayerState"):Connect(function()
		if not isLocalPlayerInMatch() then
			onDespawn(false)
		end
	end)
end

return TungTungSahurController
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="142">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="ModuleScript" referent="143">
            <Properties>
              <string name="Name">AnimUtil</string>
              <string name="Source"><![CDATA[--[[
	AnimUtil
	Reusable tween / animation helpers for the UI system.

	Every visual interaction (open, close, hover, click, bump) is
	funnelled through this module so timing and easing stay consistent.

	RULES:
	  • NEVER use Tween:Wait() — always use tween.Completed:Wait()
	  • Returns tweens so callers can yield if needed

	POLISH:
	  • WireButton now includes BackgroundColor3 brightness feedback:
	    hover = brighten 12% toward white, press = darken 10% toward black.
	    Transparent buttons (BackgroundTransparency > 0.9) are skipped.

	Used by: HUDPanel, ShopPanel, FateCrownsPanel, PetsPanel,
	         CrateShopPanel, IndexPanel, Components
]]

local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local UIConfig = require(Shared:WaitForChild("UIConfig"))

local cfg = UIConfig.Anim

-- Lazy-loaded reference to SoundUtil (avoids circular dependency)
local _SoundUtil = nil
local function getSoundUtil()
	if not _SoundUtil then
		local ok, mod = pcall(function()
			return require(script.Parent:WaitForChild("SoundUtil", 2))
		end)
		if ok then _SoundUtil = mod end
	end
	return _SoundUtil
end

local AnimUtil = {}

-- ───────────────────────────────────────────────
-- CORE TWEEN
-- ───────────────────────────────────────────────

--[[
	Generic tween wrapper.  Returns the Tween so callers can
	yield on it via tween.Completed:Wait().
]]
function AnimUtil.Tween(
	instance: Instance,
	props: { [string]: any },
	duration: number,
	style: Enum.EasingStyle?,
	direction: Enum.EasingDirection?
): Tween
	style = style or Enum.EasingStyle.Quad
	direction = direction or Enum.EasingDirection.Out
	local info = TweenInfo.new(duration, style, direction)
	local tween = TweenService:Create(instance, info, props)
	tween:Play()
	return tween
end

-- ───────────────────────────────────────────────
-- PANEL OPEN / CLOSE
-- ───────────────────────────────────────────────

--[[
	Animate a panel open.
	`canvas`  – the CanvasGroup (or Frame) root of the panel
	`uiScale` – UIScale child used for the scale pop effect
]]
function AnimUtil.OpenPanel(canvas: CanvasGroup, uiScale: UIScale)
	-- Starting state
	canvas.GroupTransparency = 1
	uiScale.Scale = cfg.OpenStartScale
	canvas.Visible = true

	-- Tween in (fade + scale)
	AnimUtil.Tween(canvas, { GroupTransparency = 0 }, cfg.OpenDuration, Enum.EasingStyle.Quad)
	AnimUtil.Tween(uiScale, { Scale = 1 }, cfg.OpenDuration, cfg.OpenEase)
end

--[[
	Animate a panel closed.  Returns the closing tween so the caller can
	yield via tween.Completed:Wait() before setting Visible = false.
]]
function AnimUtil.ClosePanel(canvas: CanvasGroup, uiScale: UIScale): Tween
	AnimUtil.Tween(uiScale, { Scale = cfg.OpenStartScale }, cfg.CloseDuration, cfg.CloseEase, Enum.EasingDirection.In)
	local t = AnimUtil.Tween(canvas, { GroupTransparency = 1 }, cfg.CloseDuration, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	return t
end

-- ───────────────────────────────────────────────
-- BUTTON EFFECTS  (hover, click, hover SFX, color feedback)
-- ───────────────────────────────────────────────

--[[
	Call once per button to wire up hover + click animations + hover sound
	+ BackgroundColor3 brightness feedback.
	`btn` – any GuiButton
	`onClick` – optional callback fired after click animation
]]
function AnimUtil.WireButton(btn: GuiButton, onClick: (() -> ())?)
	-- Ensure a UIScale exists for animation
	local scale = btn:FindFirstChildOfClass("UIScale")
	if not scale then
		scale = Instance.new("UIScale")
		scale.Parent = btn
	end

	-- Skip color changes for transparent buttons (overlays, invisible hit areas)
	local skipColor = btn.BackgroundTransparency > 0.9

	-- IMPORTANT:
	-- Buttons like toggles/tabs change BackgroundColor3 over time.
	-- So we must not cache "origColor" once, otherwise MouseLeave snaps
	-- back to the wrong state color.
	local baseColor = btn.BackgroundColor3
	local hoverColor = baseColor
	local pressColor = baseColor

	local function recomputeColors()
		baseColor = btn.BackgroundColor3
		hoverColor = baseColor:Lerp(Color3.new(1, 1, 1), 0.12)
		pressColor = baseColor:Lerp(Color3.new(0, 0, 0), 0.10)
	end

	recomputeColors()

	btn.MouseEnter:Connect(function()
		AnimUtil.Tween(scale, { Scale = cfg.HoverScale }, cfg.HoverDuration, cfg.BtnEase)
		if not skipColor then
			recomputeColors()
			AnimUtil.Tween(btn, { BackgroundColor3 = hoverColor }, cfg.HoverDuration, cfg.BtnEase)
		end
		local su = getSoundUtil()
		if su then su.Hover() end
	end)

	btn.MouseLeave:Connect(function()
		AnimUtil.Tween(scale, { Scale = 1 }, cfg.HoverDuration, cfg.BtnEase)
		if not skipColor then
			-- Restore to the current "base" color for this interaction.
			AnimUtil.Tween(btn, { BackgroundColor3 = baseColor }, cfg.HoverDuration, cfg.BtnEase)
		end
	end)

	btn.MouseButton1Down:Connect(function()
		AnimUtil.Tween(scale, { Scale = cfg.ClickScale }, cfg.ClickDuration, cfg.BtnEase, Enum.EasingDirection.Out)
		if not skipColor then
			recomputeColors()
			AnimUtil.Tween(btn, { BackgroundColor3 = pressColor }, cfg.ClickDuration, cfg.BtnEase)
		end
	end)

	btn.MouseButton1Up:Connect(function()
		AnimUtil.Tween(scale, { Scale = cfg.HoverScale }, cfg.BounceDuration, Enum.EasingStyle.Back)
		if not skipColor then
			-- Defer so if the click handler changes BackgroundColor3 (tabs/toggles),
			-- we recompute from the NEW state color and don't snap back.
			task.defer(function()
				if not btn or not btn.Parent then return end
				recomputeColors()
				AnimUtil.Tween(btn, { BackgroundColor3 = hoverColor }, cfg.BounceDuration, Enum.EasingStyle.Back)
			end)
		end
	end)

	if onClick then
		btn.MouseButton1Click:Connect(onClick)
	end
end

-- ───────────────────────────────────────────────
-- MODAL POPUP OPEN / CLOSE  (Brainrot-style)
-- ───────────────────────────────────────────────

--[[
	Animate a modal popup card open via UIScale.
	Creates a UIScale child if one doesn't already exist.
	Returns the UIScale instance for callers that need it later.

	The card's AnchorPoint + Position must already be set before calling.
]]
function AnimUtil.PopupOpen(card: GuiObject): UIScale
	local sc = card:FindFirstChildOfClass("UIScale")
	if not sc then
		sc = Instance.new("UIScale")
		sc.Parent = card
	end
	sc.Scale = cfg.PopupOpenStartScale
	AnimUtil.Tween(sc, { Scale = 1 }, cfg.PopupOpenDuration, cfg.PopupOpenEase, Enum.EasingDirection.Out)
	return sc
end

--[[
	Animate a modal popup card closed, then destroy the given container
	(usually the overlay ScreenGui/Frame that holds the card).
	`container` – the instance to :Destroy() after the tween; pass nil to skip.

	Scales down subtly (0.9) instead of shrinking to zero, avoiding jank.
	Position is never touched — stays locked at AnchorPoint center.
]]
function AnimUtil.PopupClose(card: GuiObject, container: Instance?)
	local sc = card:FindFirstChildOfClass("UIScale")
	if sc then
		local tween = AnimUtil.Tween(sc, { Scale = cfg.PopupCloseTargetScale }, cfg.PopupCloseDuration, cfg.PopupCloseEase, Enum.EasingDirection.In)
		AnimUtil.Tween(card, { BackgroundTransparency = 1 }, cfg.PopupCloseDuration, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		task.spawn(function()
			tween.Completed:Wait()
			card.Visible = false
			if container and container.Parent then container:Destroy() end
		end)
	elseif container then
		task.delay(cfg.PopupDestroyDelay, function()
			if container and container.Parent then container:Destroy() end
		end)
	end
end

-- ───────────────────────────────────────────────
-- UTILITY ANIMATIONS
-- ───────────────────────────────────────────────

--[[
	Quick scale "bump" (e.g. coin counter update).
	Scales up then back to a caller-defined rest scale.
]]
function AnimUtil.Bump(uiScale: UIScale, peakScale: number?, duration: number?, restScale: number?)
	peakScale = peakScale or cfg.CoinBumpScale
	duration = duration or cfg.CoinBumpDuration
	restScale = restScale or 1

	local half = duration * 0.4
	local t = AnimUtil.Tween(uiScale, { Scale = peakScale }, half, Enum.EasingStyle.Back)
	task.spawn(function()
		t.Completed:Wait()
		AnimUtil.Tween(uiScale, { Scale = restScale }, duration - half, Enum.EasingStyle.Quad)
	end)
end

--[[
	Fade-slide in a frame from an offset (e.g. round badge).
	`frame` – target frame
	`finalPos` – final UDim2 position
	`offsetY` – starting Y offset in pixels
]]
function AnimUtil.SlideIn(frame: GuiObject, finalPos: UDim2, offsetY: number?)
	offsetY = offsetY or -30
	frame.Position = UDim2.new(finalPos.X.Scale, finalPos.X.Offset, finalPos.Y.Scale, finalPos.Y.Offset + offsetY)
	AnimUtil.Tween(frame, { Position = finalPos }, cfg.RoundSlideDuration, Enum.EasingStyle.Back)
end

--[[
	Smooth frame appear (scale + fade for intermission UI etc.)
]]
function AnimUtil.PopIn(frame: GuiObject, uiScale: UIScale?)
	if uiScale then
		uiScale.Scale = 0.85
		AnimUtil.Tween(uiScale, { Scale = 1 }, 0.35, Enum.EasingStyle.Back)
	end
	if frame:IsA("CanvasGroup") then
		frame.GroupTransparency = 1
		AnimUtil.Tween(frame, { GroupTransparency = 0 }, 0.25, Enum.EasingStyle.Quad)
	end
	frame.Visible = true
end

function AnimUtil.PopOut(frame: GuiObject, uiScale: UIScale?): Tween?
	if uiScale then
		AnimUtil.Tween(uiScale, { Scale = 0.85 }, 0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	end
	if frame:IsA("CanvasGroup") then
		return AnimUtil.Tween(frame, { GroupTransparency = 1 }, 0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	end
	return nil
end

return AnimUtil
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="144">
            <Properties>
              <string name="Name">BundlePanel</string>
              <string name="Source"><![CDATA[--[[
	BundlePanel
	Hero-style bundle content rendered INSIDE ShopPanel's content area.

	Not a standalone panel — populates into a parent ScrollingFrame when
	the Bundles tab is selected, and clears itself when another tab is chosen.
	This keeps the ShopPanel tab bar visible and clickable at all times.

	Layout:
	  * Left 68%: Hero cover art + title overlay + View/Buy buttons
	  * Right 30%: Vertical selector strip listing all bundles
	  * Detail View: Replaces hero area with item grid on "View" click

	Data-driven via BundleCatalog — supports future bundles automatically.

	API:
	  BundlePanel.Init()                    — no-op (modules loaded at require time)
	  BundlePanel.PopulateInto(parent)      — build bundle UI inside parent
	  BundlePanel.ClearContent()            — destroy bundle UI, restore parent
	  BundlePanel.Show/Hide/IsVisible/Toggle — stubs for compatibility
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ContentProvider = game:GetService("ContentProvider")
local HttpService = game:GetService("HttpService")

local STUB = {
	Init = function() end,
	PopulateInto = function() end,
	ClearContent = function() end,
	Show = function() end,
	Hide = function() end,
	IsVisible = function() return false end,
	Toggle = function() end,
}

local Shared = ReplicatedStorage:WaitForChild("Shared", 60)
if not Shared then
	warn("[BundlePanel] Shared not found after 60s -- disabled")
	return STUB
end

local CDPModule = Shared:WaitForChild("ClientDepsProvider", 60)
if not CDPModule then
	warn("[BundlePanel] ClientDepsProvider MISSING")
	return STUB
end

local ok, Deps = pcall(require, CDPModule)
if not ok or not Deps then
	warn("[BundlePanel] require(ClientDepsProvider) FAILED:", Deps)
	return STUB
end

local UIConfig = Deps.UIConfig
local ItemCatalog = Deps.ItemCatalog

local BundleCatalogModule = Shared:WaitForChild("BundleCatalog", 10)
if not BundleCatalogModule then
	warn("[BundlePanel] BundleCatalog not found in Shared")
	return STUB
end
local BundleCatalog = require(BundleCatalogModule)

local ItemModelRegistryModule = Shared:WaitForChild("ItemModelRegistry", 10)
local ItemModelRegistry = ItemModelRegistryModule and require(ItemModelRegistryModule) or nil

local Client = script.Parent
local AnimUtil   = require(Client:WaitForChild("AnimUtil"))
local SoundUtil  = require(Client:WaitForChild("SoundUtil"))
local Components = require(Client:WaitForChild("Components"))

local C = UIConfig.Colors
local S = UIConfig.Sizes

local LocalPlayer = Players.LocalPlayer
local COIN_BUNDLE_REQUEST_IDS: { [string]: string } = {
	fnaf_pets_bundle = "fnaf_all",
	brainrot_bundle = "brainrot_all",
}
local FNAF_BUNDLE_ID = "fnaf_pets_bundle"
local BRAINROT_BUNDLE_ID = "brainrot_bundle"
local VIP_BUNDLE_PREVIEW_DISABLED_ITEM_IDS: { [string]: boolean } = {
	pet_all_knowing_eye = true,
	crown_vip = true,
	crown_whiteeyed = true,
}
local FNAF_ITEM_PRICE = 70000
local BRAINROT_ITEM_PRICE = 75000
local COIN_BUNDLE_BASE_COST = 150000
local COIN_BUNDLE_PER_OWNED_DISCOUNT = 0.10
local ROBUX_ICON_IMAGE = "rbxassetid://138917867019056"

local ACCENT_COLOR   = Color3.fromRGB(245, 48, 72)
local SELECTED_GLOW  = Color3.fromRGB(255, 210, 50)
local BG_DARK        = Color3.fromRGB(22, 24, 42)
local BG_LIGHTER     = Color3.fromRGB(36, 40, 64)
local COVER_BG       = Color3.fromRGB(10, 12, 24)
local STRIP_BG       = Color3.fromRGB(18, 20, 38)
local ENTRY_SELECTED = Color3.fromRGB(44, 48, 78)

local contentParent: ScrollingFrame? = nil
local bundleContainer: Frame? = nil
local selectedBundleId: string = ""
local _bundleOwnedLocal: { [string]: boolean } = {}
local inDetailView = false

local coverImage: ImageLabel? = nil
local fnafCreditLabel: TextLabel? = nil
local titleLabel: TextLabel? = nil
local viewBtn: TextButton? = nil
local buyBtn: TextButton? = nil
local heroFrame: Frame? = nil
local detailFrame: Frame? = nil
local selectorStrip: ScrollingFrame? = nil
local selectorEntries: { [string]: Frame } = {}

local previewOverlay: Frame? = nil
local previewRotConn: RBXScriptConnection? = nil
local externalPreviewHost: Instance? = nil
local panelOptions: {[string]: any}? = nil

local function enlargeCardImage(card: Instance, scale: number)
	local iconFrame = card:FindFirstChild("Icon")
	if not iconFrame or not iconFrame:IsA("Frame") then
		return
	end
	local itemImage = iconFrame:FindFirstChild("ItemImage")
	if not itemImage or not itemImage:IsA("ImageLabel") then
		return
	end
	itemImage.AnchorPoint = Vector2.new(0.5, 0.5)
	itemImage.Position = UDim2.fromScale(0.5, 0.5)
	itemImage.Size = UDim2.fromScale(scale, scale)
end

local function getOwnedSetFromAttribute(attributeName: string): { [string]: boolean }
	local raw = LocalPlayer:GetAttribute(attributeName)
	if type(raw) ~= "string" or raw == "" then
		return {}
	end
	local okDecode, list = pcall(HttpService.JSONDecode, HttpService, raw)
	if not okDecode or type(list) ~= "table" then
		return {}
	end
	local set = {}
	for _, id in ipairs(list) do
		if type(id) == "string" then
			set[id] = true
		end
	end
	return set
end

local function getOwnedSetForCategory(category: string): { [string]: boolean }
	if category == "Pets" then
		return getOwnedSetFromAttribute("OwnedPets")
	elseif category == "Crowns" then
		return getOwnedSetFromAttribute("OwnedCrowns")
	elseif category == "IconImages" then
		return getOwnedSetFromAttribute("OwnedIconImages")
	end
	return {}
end

local function getCoinBundleState(bundle): { totalCount: number, ownedCount: number, missingCount: number, finalCost: number, coins: number }
	local totalCount = 0
	local ownedCount = 0
	local ownedByCategory: { [string]: { [string]: boolean } } = {}

	for _, inc in ipairs(bundle.includes or {}) do
		if inc.category and inc.itemId and COIN_BUNDLE_REQUEST_IDS[bundle.id] then
			if not ownedByCategory[inc.category] then
				ownedByCategory[inc.category] = getOwnedSetForCategory(inc.category)
			end
			totalCount += 1
			if ownedByCategory[inc.category][inc.itemId] == true then
				ownedCount += 1
			end
		end
	end

	local missingCount = math.max(0, totalCount - ownedCount)
	local finalCost = math.floor(COIN_BUNDLE_BASE_COST * (1 - (ownedCount * COIN_BUNDLE_PER_OWNED_DISCOUNT)))
	finalCost = math.max(0, finalCost)
	local coins = tonumber(LocalPlayer:GetAttribute("Coins")) or 0

	return {
		totalCount = totalCount,
		ownedCount = ownedCount,
		missingCount = missingCount,
		finalCost = math.max(0, math.floor(finalCost)),
		coins = math.max(0, math.floor(coins)),
	}
end

local function isVipBundleOwnedForUI(context: string?): boolean
	local persistedVip = LocalPlayer:GetAttribute("VIPBundleOwned") == true
	local runtimeVip = LocalPlayer:GetAttribute("OwnsVIP") == true
	local owned = _bundleOwnedLocal.bundle_vip == true or persistedVip or runtimeVip
	print(string.format(
		"[VIPPersistence] player=%s vipBundleUIOwned=%s context=%s persisted=%s runtime=%s",
		LocalPlayer.Name,
		tostring(owned),
		tostring(context or "unknown"),
		tostring(persistedVip),
		tostring(runtimeVip)
	))
	return owned
end

local function isBundleOwned(bundle, context: string?): boolean
	if not bundle then
		return false
	end

	local isCoinBundle = COIN_BUNDLE_REQUEST_IDS[bundle.id] ~= nil
	if isCoinBundle then
		return getCoinBundleState(bundle).missingCount <= 0
	end

	if bundle.id == "bundle_vip" then
		return isVipBundleOwnedForUI(context)
	end

	if _bundleOwnedLocal[bundle.id] == true then
		return true
	end

	if bundle.gamepassId then
		local okOwned, ownsPass = pcall(function()
			return MarketplaceService:UserOwnsGamePassAsync(LocalPlayer.UserId, bundle.gamepassId)
		end)
		return okOwned and ownsPass == true
	end

	return false
end

local function getBundlesForPanel()
	local bundles = BundleCatalog.GetAll()
	if not panelOptions or not panelOptions.bundleIds then
		return bundles
	end
	local allow = {}
	for _, id in ipairs(panelOptions.bundleIds) do
		allow[id] = true
	end
	local filtered = {}
	for _, bundle in ipairs(bundles) do
		if allow[bundle.id] then
			table.insert(filtered, bundle)
		end
	end
	return filtered
end

local function createStyledButton(parent: Instance, text: string, color: Color3, size: UDim2, position: UDim2): TextButton
	local btn = Instance.new("TextButton")
	btn.Name = text:gsub("%s", "") .. "Btn"
	btn.Size = size
	btn.Position = position
	btn.BackgroundColor3 = color
	btn.Font = Enum.Font.GothamBold
	btn.TextColor3 = Color3.fromRGB(255, 255, 255)
	btn.TextTransparency = 0
	btn.TextSize = 18
	btn.Text = text
	btn.BorderSizePixel = 0
	btn.AutoButtonColor = false
	btn.ZIndex = 8
	btn.Parent = parent

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 8)
	corner.Parent = btn

	local borderStroke = Instance.new("UIStroke")
	borderStroke.Color = Color3.fromRGB(255, 255, 255)
	borderStroke.Thickness = 1.5
	borderStroke.Transparency = 0.35
	borderStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	borderStroke.Parent = btn

	local textStroke = Instance.new("UIStroke")
	textStroke.Color = Color3.fromRGB(0, 0, 0)
	textStroke.Thickness = 2
	textStroke.Transparency = 0.05
	textStroke.Parent = btn

	return btn
end

local function updateSelectorHighlight()
	for id, entry in pairs(selectorEntries) do
		local entryStroke = entry:FindFirstChildOfClass("UIStroke")
		if id == selectedBundleId then
			if entryStroke then
				entryStroke.Color = SELECTED_GLOW
				entryStroke.Thickness = 2.5
				entryStroke.Transparency = 0
			end
			entry.BackgroundColor3 = ENTRY_SELECTED
		else
			if entryStroke then
				entryStroke.Color = C.CardStroke
				entryStroke.Thickness = 1.5
				entryStroke.Transparency = 0.3
			end
			entry.BackgroundColor3 = C.CardBg
		end
	end
end

local function selectBundle(bundleId: string)
	local bundle = BundleCatalog.Get(bundleId)
	if not bundle then return end

	selectedBundleId = bundleId

	if coverImage then
		if bundle.coverImage and bundle.coverImage ~= "" then
			coverImage.Image = bundle.coverImage
			coverImage.Visible = true
			if bundle.id == FNAF_BUNDLE_ID then
				print(string.format("[BundleCover] bundleId=%s displayName=%s coverImage=%s",
					tostring(bundle.id), tostring(bundle.displayName), tostring(bundle.coverImage)))
			end
		else
			coverImage.Image = ""
			coverImage.Visible = false
		end
	end

	if fnafCreditLabel then
		fnafCreditLabel.Visible = (bundle.id == FNAF_BUNDLE_ID) and (coverImage and coverImage.Visible == true)
	end

	if titleLabel then
		titleLabel.Text = bundle.displayName
	end

	if buyBtn then
		local isCoinBundle = COIN_BUNDLE_REQUEST_IDS[bundle.id] ~= nil
		local isOwned = isBundleOwned(bundle, "selectBundle")
		local existingBuyGroup = buyBtn:FindFirstChild("RobuxBuyGroup")

		if isOwned then
			if existingBuyGroup then
				existingBuyGroup:Destroy()
			end
			buyBtn.Text = "OWNED"
			buyBtn.BackgroundColor3 = C.DisabledBtn
			buyBtn.Active = false
		elseif not bundle.isAvailable then
			if existingBuyGroup then
				existingBuyGroup:Destroy()
			end
			buyBtn.Text = "COMING SOON"
			buyBtn.BackgroundColor3 = C.DisabledBtn
			buyBtn.Active = false
		else
			if isCoinBundle then
				if existingBuyGroup then
					existingBuyGroup:Destroy()
				end
				local state = getCoinBundleState(bundle)
				if state.missingCount <= 0 then
					buyBtn.Text = "OWNED"
					buyBtn.BackgroundColor3 = C.DisabledBtn
					buyBtn.Active = false
				elseif bundle.id ~= BRAINROT_BUNDLE_ID and state.coins < state.finalCost then
					buyBtn.Text = "GET MORE FATE COINS"
					buyBtn.BackgroundColor3 = Color3.fromRGB(255, 170, 55)
					buyBtn.Active = true
				else
					buyBtn.Text = string.format("BUY - %d F", state.finalCost)
					buyBtn.BackgroundColor3 = Color3.fromRGB(255, 200, 30)
					buyBtn.Active = true
				end
			else
				buyBtn.Text = string.format("%d ROBUX", bundle.priceRobux)
				buyBtn.BackgroundColor3 = C.BuyButton
				buyBtn.Active = true
				Components.ApplyRobuxBuyStyle(buyBtn, tostring(bundle.priceRobux), ROBUX_ICON_IMAGE)
			end
		end
	end

	if viewBtn then
		local canView = #bundle.includes > 0
		viewBtn.Active = canView
		viewBtn.BackgroundColor3 = canView and C.Blue or C.DisabledBtn
	end

	updateSelectorHighlight()

	if inDetailView then
		if heroFrame then heroFrame.Visible = true end
		if detailFrame then detailFrame.Visible = false end
		inDetailView = false
	end
end

local function clearDetailGrid()
	if not detailFrame then return end
	for _, child in ipairs(detailFrame:GetChildren()) do
		if child:IsA("ScrollingFrame") then
			child:Destroy()
		end
	end
end

-- ═══════════════════════════════════════════════════════════════════
-- VIEWPORT PREVIEW HELPERS
-- ═══════════════════════════════════════════════════════════════════

local MIN_CAM_DIST = 4
local CAM_FOV = 50

local function cloneForViewport(modelInstance: Instance): Instance
	local clone = modelInstance:Clone()
	for _, d in ipairs(clone:GetDescendants()) do
		if d:IsA("Script") or d:IsA("LocalScript") or d:IsA("ModuleScript") then
			d:Destroy()
		elseif d:IsA("Humanoid") or d:IsA("Animator") or d:IsA("AnimationController") then
			d:Destroy()
		elseif d:IsA("BasePart") then
			d.Anchored = true
			d.CanCollide = false
		end
	end
	if clone:IsA("BasePart") then
		clone.Anchored = true
		clone.CanCollide = false
	end
	return clone
end

local function collectEffectEmitters(root: Instance)
	local emitters = {}
	for _, d in ipairs(root:GetDescendants()) do
		if d:IsA("ParticleEmitter") then
			d.Enabled = true
			table.insert(emitters, d)
		elseif d:IsA("Trail") or d:IsA("Beam") or d:IsA("PointLight") or d:IsA("SpotLight") or d:IsA("SurfaceLight") then
			d.Enabled = true
		end
	end
	return emitters
end

local function getVisibleBounds(root: Instance): (Vector3, Vector3, number)
	local minB = Vector3.new(math.huge, math.huge, math.huge)
	local maxB = Vector3.new(-math.huge, -math.huge, -math.huge)
	local count = 0
	local function addPart(p: BasePart)
		if p.Transparency >= 1 then return end
		count += 1
		local cf = p.CFrame
		local sz = p.Size
		for _, sxm in ipairs({-0.5, 0.5}) do
			for _, sym in ipairs({-0.5, 0.5}) do
				for _, szm in ipairs({-0.5, 0.5}) do
					local corner = cf:PointToWorldSpace(Vector3.new(sz.X * sxm, sz.Y * sym, sz.Z * szm))
					minB = Vector3.new(math.min(minB.X, corner.X), math.min(minB.Y, corner.Y), math.min(minB.Z, corner.Z))
					maxB = Vector3.new(math.max(maxB.X, corner.X), math.max(maxB.Y, corner.Y), math.max(maxB.Z, corner.Z))
				end
			end
		end
	end
	if root:IsA("BasePart") then addPart(root) end
	for _, d in ipairs(root:GetDescendants()) do
		if d:IsA("BasePart") then addPart(d) end
	end
	if count == 0 then
		return Vector3.zero, Vector3.new(2, 2, 2), 0
	end
	return minB, maxB, count
end

local function pivotToOrigin(root: Instance)
	local minB, maxB = getVisibleBounds(root)
	local center = (minB + maxB) / 2
	if center.Magnitude < 0.001 then return end
	if root:IsA("BasePart") then
		root.CFrame = root.CFrame - center
	end
	for _, d in ipairs(root:GetDescendants()) do
		if d:IsA("BasePart") then
			d.CFrame = d.CFrame - center
		end
	end
end

local function setupPreviewCamera(viewport: ViewportFrame, model: Instance, distanceMultiplier: number?)
	local minB, maxB = getVisibleBounds(model)
	local center = (minB + maxB) / 2
	local extents = maxB - minB
	local maxDim = math.max(extents.X, extents.Y, extents.Z, 0.1)
	local distance = math.max(maxDim * (distanceMultiplier or 1.8), MIN_CAM_DIST)
	local camPos = center + Vector3.new(distance * 0.5, distance * 0.35, distance * 0.8)

	local cam = Instance.new("Camera")
	cam.CameraType = Enum.CameraType.Scriptable
	cam.CFrame = CFrame.lookAt(camPos, center)
	cam.FieldOfView = CAM_FOV
	cam.Parent = viewport
	viewport.CurrentCamera = cam
end

-- ═══════════════════════════════════════════════════════════════════
-- ITEM PREVIEW OVERLAY
-- ═══════════════════════════════════════════════════════════════════

local function closeItemPreview()
	if previewRotConn then
		previewRotConn:Disconnect()
		previewRotConn = nil
	end
	if previewOverlay then
		previewOverlay:Destroy()
		previewOverlay = nil
	end
end

local function showFallbackPreview(card: Frame, itemData)
	local fallbackImg = Instance.new("ImageLabel")
	fallbackImg.Name = "FallbackImage"
	fallbackImg.Size = UDim2.new(0.7, 0, 0.7, 0)
	fallbackImg.AnchorPoint = Vector2.new(0.5, 0.5)
	fallbackImg.Position = UDim2.new(0.5, 0, 0.5, 10)
	fallbackImg.BackgroundTransparency = 1
	fallbackImg.ScaleType = Enum.ScaleType.Fit
	fallbackImg.ZIndex = 53
	fallbackImg.Parent = card

	if itemData.image and itemData.image ~= "" then
		fallbackImg.Image = itemData.image
	else
		fallbackImg.Visible = false
		local noLbl = Instance.new("TextLabel")
		noLbl.Size = UDim2.new(0.8, 0, 0, 30)
		noLbl.AnchorPoint = Vector2.new(0.5, 0.5)
		noLbl.Position = UDim2.fromScale(0.5, 0.55)
		noLbl.BackgroundTransparency = 1
		noLbl.Font = Enum.Font.GothamBold
		noLbl.TextColor3 = Color3.fromRGB(130, 140, 170)
		noLbl.TextSize = 16
		noLbl.Text = "Preview unavailable"
		noLbl.ZIndex = 53
		noLbl.Parent = card
	end
end

local function canPreviewItem(itemData): boolean
	if not itemData or itemData.previewMode == "none" then
		return false
	end
	local hasModel = type(itemData.modelPath) == "string" and itemData.modelPath ~= ""
	local hasImage = type(itemData.image) == "string" and itemData.image ~= ""
	return hasModel or hasImage
end

local function showItemPreview(itemData)
	if not canPreviewItem(itemData) then
		return
	end

	closeItemPreview()
	local previewHost = bundleContainer or externalPreviewHost
	if not previewHost then return end

	local itemName = itemData.name or "unknown"
	local modelPath = itemData.modelPath

	local modelInstance = nil
	if modelPath and ItemModelRegistry then
		modelInstance = ItemModelRegistry.Get(modelPath)
	end

	previewOverlay = Instance.new("Frame")
	previewOverlay.Name = "ItemPreviewOverlay"
	previewOverlay.Size = UDim2.fromScale(1, 1)
	previewOverlay.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
	previewOverlay.BackgroundTransparency = 0.35
	previewOverlay.BorderSizePixel = 0
	previewOverlay.ZIndex = 50
	previewOverlay.Parent = previewHost

	local dimBtn = Instance.new("TextButton")
	dimBtn.Name = "DimClose"
	dimBtn.Size = UDim2.fromScale(1, 1)
	dimBtn.BackgroundTransparency = 1
	dimBtn.Text = ""
	dimBtn.ZIndex = 50
	dimBtn.Parent = previewOverlay
	dimBtn.MouseButton1Click:Connect(function()
		SoundUtil.Close()
		closeItemPreview()
	end)

	local card = Instance.new("Frame")
	card.Name = "PreviewCard"
	card.AnchorPoint = Vector2.new(0.5, 0.5)
	card.Size = UDim2.new(0.55, 0, 0.8, 0)
	card.Position = UDim2.fromScale(0.5, 0.5)
	card.BackgroundColor3 = Color3.fromRGB(22, 24, 42)
	card.BackgroundTransparency = 0
	card.BorderSizePixel = 0
	card.ZIndex = 52
	card.Parent = previewOverlay

	local cardCorner = Instance.new("UICorner")
	cardCorner.CornerRadius = UDim.new(0, 14)
	cardCorner.Parent = card

	local cardStroke = Instance.new("UIStroke")
	cardStroke.Color = SELECTED_GLOW
	cardStroke.Thickness = 2
	cardStroke.Transparency = 0.1
	cardStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	cardStroke.Parent = card

	local header = Instance.new("Frame")
	header.Name = "Header"
	header.Size = UDim2.new(1, 0, 0, 44)
	header.BackgroundTransparency = 1
	header.BorderSizePixel = 0
	header.ZIndex = 53
	header.Parent = card

	local nameLabel = Instance.new("TextLabel")
	nameLabel.Name = "ItemName"
	nameLabel.Size = UDim2.new(1, -60, 0, 36)
	nameLabel.Position = UDim2.fromOffset(14, 4)
	nameLabel.BackgroundTransparency = 1
	nameLabel.Font = Enum.Font.GothamBold
	nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
	nameLabel.TextTransparency = 0
	nameLabel.TextSize = 20
	nameLabel.TextXAlignment = Enum.TextXAlignment.Left
	nameLabel.TextTruncate = Enum.TextTruncate.AtEnd
	nameLabel.Text = itemName
	nameLabel.ZIndex = 54
	nameLabel.Parent = header

	local nameStroke = Instance.new("UIStroke")
	nameStroke.Color = Color3.fromRGB(0, 0, 0)
	nameStroke.Thickness = 2
	nameStroke.Transparency = 0.1
	nameStroke.Parent = nameLabel

	local closeBtn = createStyledButton(
		header, "X", C.CloseBtn,
		UDim2.fromOffset(36, 36),
		UDim2.new(1, -42, 0, 4)
	)
	closeBtn.ZIndex = 55
	closeBtn.TextSize = 16
	AnimUtil.WireButton(closeBtn, function()
		SoundUtil.Close()
		closeItemPreview()
	end)

	local hasCoinPurchase = panelOptions
		and panelOptions.itemCoinPrice
		and itemData.itemId
		and itemData.itemType

	local purchaseBtn: TextButton? = nil
	if hasCoinPurchase then
		purchaseBtn = createStyledButton(
			card,
			string.format("BUY - %dK F", math.floor(panelOptions.itemCoinPrice / 1000)),
			Color3.fromRGB(255, 200, 30),
			UDim2.new(1, -20, 0, 42),
			UDim2.new(0, 10, 1, -50)
		)
		purchaseBtn.ZIndex = 55

		local function isOwned(): boolean
			local attrKey = (itemData.itemType == "ExclusivePet") and "OwnedPets" or "OwnedCrowns"
			local raw = LocalPlayer:GetAttribute(attrKey)
			if type(raw) ~= "string" or raw == "" then return false end
			local okDec, list = pcall(HttpService.JSONDecode, HttpService, raw)
			if not okDec or type(list) ~= "table" then return false end
			for _, id in ipairs(list) do
				if id == itemData.itemId then return true end
			end
			return false
		end

		local function refreshPurchaseState()
			if not purchaseBtn then return end
			if isOwned() then
				purchaseBtn.Text = "OWNED"
				purchaseBtn.BackgroundColor3 = C.DisabledBtn
				purchaseBtn.Active = false
				purchaseBtn.AutoButtonColor = false
			else
				purchaseBtn.Text = string.format("BUY - %dK F", math.floor(panelOptions.itemCoinPrice / 1000))
				purchaseBtn.BackgroundColor3 = Color3.fromRGB(255, 200, 30)
				purchaseBtn.Active = true
				purchaseBtn.AutoButtonColor = true
			end
		end
		refreshPurchaseState()
		AnimUtil.WireButton(purchaseBtn, function()
			if isOwned() then
				refreshPurchaseState()
				return
			end
			local remotes = ReplicatedStorage:FindFirstChild("Remotes")
			local buyRF = remotes and remotes:FindFirstChild("Shop_BuyWithCoins")
			if not buyRF then
				return
			end
			local okBuy, result = pcall(buyRF.InvokeServer, buyRF, itemData.itemId, itemData.itemType)
			if okBuy and result and result.success then
				refreshPurchaseState()
				if panelOptions and panelOptions.onItemPurchased then
					pcall(panelOptions.onItemPurchased, itemData.itemId)
				end
			elseif okBuy and result and result.reason == "INSUFFICIENT_COINS" then
				local productId = tonumber(result.productId)
				if productId and productId > 0 then
					MarketplaceService:PromptProductPurchase(LocalPlayer, productId)
				end
			else
				refreshPurchaseState()
			end
		end)
	end

	if not modelInstance then
		showFallbackPreview(card, itemData)
		return
	end

	local clone = cloneForViewport(modelInstance)
	if clone:IsA("Accessory") then
		local wrapper = Instance.new("Model")
		wrapper.Name = clone.Name
		for _, child in ipairs(clone:GetChildren()) do
			child.Parent = wrapper
		end
		local handle = wrapper:FindFirstChild("Handle")
		if handle and handle:IsA("BasePart") then
			wrapper.PrimaryPart = handle
		end
		clone:Destroy()
		clone = wrapper
	end

	pivotToOrigin(clone)
	local minB, maxB, partCount = getVisibleBounds(clone)
	if partCount == 0 then
		showFallbackPreview(card, itemData)
		clone:Destroy()
		return
	end

	local vpFrame = Instance.new("ViewportFrame")
	vpFrame.Name = "ModelPreview"
	vpFrame.Size = hasCoinPurchase and UDim2.new(1, -20, 1, -110) or UDim2.new(1, -20, 1, -54)
	vpFrame.Position = UDim2.fromOffset(10, 48)
	vpFrame.BackgroundColor3 = Color3.fromRGB(14, 16, 32)
	vpFrame.BackgroundTransparency = 0
	vpFrame.BorderSizePixel = 0
	vpFrame.ZIndex = 53
	vpFrame.Ambient = Color3.fromRGB(180, 180, 180)
	vpFrame.LightColor = Color3.fromRGB(255, 255, 255)
	vpFrame.LightDirection = Vector3.new(-1, -1, -1)
	vpFrame.Parent = card

	local vpCorner = Instance.new("UICorner")
	vpCorner.CornerRadius = UDim.new(0, 10)
	vpCorner.Parent = vpFrame

	local worldModel = Instance.new("WorldModel")
	worldModel.Parent = vpFrame
	clone.Parent = worldModel

	local emitters = collectEffectEmitters(clone)
	local hasEffects = #emitters > 0
	local distanceMult = hasEffects and 2.2 or 1.8
	setupPreviewCamera(vpFrame, clone, distanceMult)

	task.spawn(function()
		ContentProvider:PreloadAsync(clone:GetDescendants())
	end)

	local center = (minB + maxB) / 2
	local extents = maxB - minB
	local maxDim = math.max(extents.X, extents.Y, extents.Z, 0.1)
	local baseDist = math.max(maxDim * distanceMult, MIN_CAM_DIST)
	local angle = 0
	local timeSinceEmit = 0

	previewRotConn = RunService.RenderStepped:Connect(function(dt)
		angle += dt * 30
		if hasEffects then
			timeSinceEmit += dt
			if timeSinceEmit >= 0.25 then
				timeSinceEmit = 0
				for _, emitter in ipairs(emitters) do
					pcall(function()
						emitter:Emit(3)
					end)
				end
			end
		end
		local rad = math.rad(angle)
		local camPos = center + Vector3.new(
			math.sin(rad) * baseDist * 0.8,
			baseDist * 0.35,
			math.cos(rad) * baseDist * 0.8
		)
		local cam = vpFrame.CurrentCamera
		if cam then
			cam.CFrame = CFrame.lookAt(camPos, center)
		end
	end)
end

-- ═══════════════════════════════════════════════════════════════════
-- DETAIL VIEW
-- ═══════════════════════════════════════════════════════════════════

local function showDetailView()
	local bundle = BundleCatalog.Get(selectedBundleId)
	if not bundle or #bundle.includes == 0 then return end

	inDetailView = true
	if heroFrame then heroFrame.Visible = false end
	if detailFrame then
		clearDetailGrid()
		detailFrame.Visible = true
	end

	local gridFrame = Instance.new("ScrollingFrame")
	gridFrame.Name = "IncludesGrid"
	gridFrame.Size = UDim2.new(1, 0, 1, -50)
	gridFrame.Position = UDim2.fromOffset(0, 46)
	gridFrame.BackgroundTransparency = 1
	gridFrame.BorderSizePixel = 0
	gridFrame.ScrollBarThickness = 4
	gridFrame.ScrollBarImageColor3 = Color3.fromRGB(75, 82, 108)
	gridFrame.CanvasSize = UDim2.fromScale(0, 0)
	gridFrame.AutomaticCanvasSize = Enum.AutomaticSize.Y
	gridFrame.ScrollingDirection = Enum.ScrollingDirection.Y
	gridFrame.ZIndex = 12
	gridFrame.Parent = detailFrame

	Components.AddGridLayout(gridFrame, Vector2.new(S.CardWidth, S.CardHeight), S.CardPad)
	local isFnafBundle = (bundle.id == FNAF_BUNDLE_ID)
	local isBrainrotBundle = (bundle.id == BRAINROT_BUNDLE_ID)
	local hasPerItemCoinBuy = isFnafBundle or isBrainrotBundle
	local ownedByCategory: { [string]: { [string]: boolean } } = {}

	for i, inc in ipairs(bundle.includes) do
		local itemData = ItemCatalog.Get(inc.category, inc.itemId)
		if not itemData then
			warn("[BundlePanel] Missing catalog entry:", inc.category, inc.itemId)
			continue
		end
		if not ownedByCategory[inc.category] then
			ownedByCategory[inc.category] = getOwnedSetForCategory(inc.category)
		end
		local isOwned = ownedByCategory[inc.category][inc.itemId] == true
		if isBrainrotBundle then
			print(string.format("[BrainrotCard] Render item=%s owned=%s", tostring(inc.itemId), tostring(isOwned)))
		end
		local actionText = nil
		local actionColor = nil
		local onAction = nil
		if isBrainrotBundle then
			if isOwned then
				actionText = "OWNED"
				actionColor = C.DisabledBtn
			else
				actionText = "BUY - 75,000 F"
				actionColor = Color3.fromRGB(255, 200, 30)
				onAction = function()
					print(string.format("[BrainrotCard] ClickBuy item=%s", tostring(inc.itemId)))
					local remotes = ReplicatedStorage:FindFirstChild("Remotes")
					local buyRF = remotes and remotes:FindFirstChild("BuyBrainrotItem")
					if not buyRF then
						warn("[BundlePanel] BuyBrainrotItem remote missing")
						return
					end
					local okBuy, result = pcall(buyRF.InvokeServer, buyRF, inc.itemId)
					if okBuy and result and result.success then
						selectBundle(selectedBundleId)
						showDetailView()
					elseif okBuy and result and result.reason == "INSUFFICIENT_COINS" then
						local productId = tonumber(result.productId)
						if productId and productId > 0 then
							MarketplaceService:PromptProductPurchase(LocalPlayer, productId)
						else
							warn("[BundlePanel] Missing top-up productId for insufficient bundle item coins")
						end
					elseif okBuy and result and result.reason == "ALREADY_OWNED" then
						selectBundle(selectedBundleId)
						showDetailView()
					end
				end
			end
		elseif isFnafBundle and inc.category == "Pets" then
			if isOwned then
				actionText = "OWNED"
				actionColor = C.DisabledBtn
			else
				actionText = "BUY - 70,000 F"
				actionColor = Color3.fromRGB(255, 200, 30)
				onAction = function()
					local remotes = ReplicatedStorage:FindFirstChild("Remotes")
					local buyRF = remotes and remotes:FindFirstChild("Shop_BuyWithCoins")
					if not buyRF then
						warn("[BundlePanel] Shop_BuyWithCoins remote missing for animatronic item buy")
						return
					end
					local okBuy, result = pcall(buyRF.InvokeServer, buyRF, inc.itemId, "ExclusivePet")
					if okBuy and result and result.success then
						selectBundle(selectedBundleId)
						showDetailView()
					elseif okBuy and result and result.reason == "INSUFFICIENT_COINS" then
						local productId = tonumber(result.productId)
						if productId and productId > 0 then
							MarketplaceService:PromptProductPurchase(LocalPlayer, productId)
						else
							warn("[BundlePanel] Missing top-up productId for insufficient animatronic item coins")
						end
					elseif okBuy and result and tostring(result.reason or "") == "Already owned" then
						selectBundle(selectedBundleId)
						showDetailView()
					end
				end
			end
		end

		local cardData = {
			name = itemData.name or inc.itemId,
			rarity = itemData.rarity or "Common",
			iconColor = itemData.iconColor,
			iconText = itemData.iconText,
			image = ItemCatalog.GetImage and ItemCatalog.GetImage(itemData) or itemData.image or "",
			modelPath = itemData.modelPath,
			previewMode = (bundle.id == "bundle_vip" and VIP_BUNDLE_PREVIEW_DISABLED_ITEM_IDS[inc.itemId] == true)
				and "none"
				or itemData.previewMode,
			locked = nil,
			owned = hasPerItemCoinBuy and isOwned or nil,
			actionText = actionText,
			actionColor = actionColor,
			onAction = onAction,
			itemId = inc.itemId,
			itemType = panelOptions and panelOptions.itemType or nil,
			coinPrice = panelOptions and panelOptions.itemCoinPrice or nil,
		}

		local card = Components.CreateItemCard(gridFrame, cardData)
		card.LayoutOrder = i
		if bundle.id == "bundle_vip" and inc.category == "BundleRewards" and inc.itemId == "fate_coins_8000" then
			enlargeCardImage(card, 1.22)
		end

		if canPreviewItem(cardData) then
			-- Preview is always available regardless of ownership.
			-- For Brainrot, keep overlay off CTA row so BUY remains clickable.
			local clickOverlay = Instance.new("TextButton")
			clickOverlay.Name = "PreviewClick"
			clickOverlay.Size = if hasPerItemCoinBuy then UDim2.new(1, 0, 1, -50) else UDim2.fromScale(1, 1)
			clickOverlay.BackgroundTransparency = 1
			clickOverlay.Text = ""
			clickOverlay.ZIndex = 20
			clickOverlay.Parent = card
			clickOverlay.MouseButton1Click:Connect(function()
				if isBrainrotBundle then
					print(string.format("[BrainrotCard] ClickPreview item=%s", tostring(inc.itemId)))
				end
				SoundUtil.Click()
				showItemPreview(cardData)
			end)
		end

		if hasPerItemCoinBuy and isOwned then
			local btn = card:FindFirstChild("ActionBtn")
			if btn and btn:IsA("TextButton") then
				btn.Active = false
				btn.AutoButtonColor = false
			end
		end
	end
end

local function hideDetailView()
	inDetailView = false
	if heroFrame then heroFrame.Visible = true end
	if detailFrame then detailFrame.Visible = false end
end

local BundlePanel = {}

function BundlePanel.Init()
end

function BundlePanel.PopulateInto(parent: ScrollingFrame, options)
	BundlePanel.ClearContent()
	contentParent = parent
	panelOptions = options or nil

	for _, child in ipairs(parent:GetChildren()) do
		if child:IsA("UIGridLayout") then
			child:Destroy()
		end
	end

	parent.AutomaticCanvasSize = Enum.AutomaticSize.None
	parent.CanvasSize = UDim2.fromScale(0, 0)
	parent.ScrollBarThickness = 0
	parent.ScrollingDirection = Enum.ScrollingDirection.XY

	bundleContainer = Instance.new("Frame")
	bundleContainer.Name = "BundleContent"
	bundleContainer.Size = UDim2.fromScale(1, 1)
	bundleContainer.BackgroundColor3 = BG_DARK
	bundleContainer.BackgroundTransparency = 0.1
	bundleContainer.BorderSizePixel = 0
	bundleContainer.ZIndex = 4
	bundleContainer.Parent = parent

	local containerCorner = Instance.new("UICorner")
	containerCorner.CornerRadius = UDim.new(0, 10)
	containerCorner.Parent = bundleContainer

	local bgGrad = Instance.new("UIGradient")
	bgGrad.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, BG_DARK),
		ColorSequenceKeypoint.new(1, BG_LIGHTER),
	})
	bgGrad.Rotation = 110
	bgGrad.Parent = bundleContainer

	heroFrame = Instance.new("Frame")
	heroFrame.Name = "HeroArea"
	heroFrame.Size = UDim2.new(0.68, -8, 1, -8)
	heroFrame.Position = UDim2.fromOffset(4, 4)
	heroFrame.BackgroundTransparency = 1
	heroFrame.BorderSizePixel = 0
	heroFrame.ZIndex = 5
	heroFrame.Parent = bundleContainer

	local coverContainer = Instance.new("Frame")
	coverContainer.Name = "CoverContainer"
	coverContainer.Size = UDim2.new(1, 0, 1, -56)
	coverContainer.Position = UDim2.fromOffset(0, 0)
	coverContainer.BackgroundColor3 = COVER_BG
	coverContainer.BorderSizePixel = 0
	coverContainer.ClipsDescendants = true
	coverContainer.ZIndex = 5
	coverContainer.Parent = heroFrame

	local ccCorner = Instance.new("UICorner")
	ccCorner.CornerRadius = UDim.new(0, 12)
	ccCorner.Parent = coverContainer

	local ccStroke = Instance.new("UIStroke")
	ccStroke.Color = ACCENT_COLOR
	ccStroke.Thickness = 2
	ccStroke.Transparency = 0.2
	ccStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	ccStroke.Parent = coverContainer

	coverImage = Instance.new("ImageLabel")
	coverImage.Name = "CoverImage"
	coverImage.Size = UDim2.fromScale(1, 1)
	coverImage.Position = UDim2.fromScale(0, 0)
	coverImage.BackgroundTransparency = 1
	coverImage.ScaleType = Enum.ScaleType.Crop
	coverImage.ZIndex = 6
	coverImage.Parent = coverContainer

	fnafCreditLabel = Instance.new("TextLabel")
	fnafCreditLabel.Name = "AnimatronicCreditLabel"
	fnafCreditLabel.AnchorPoint = Vector2.new(1, 1)
	fnafCreditLabel.Position = UDim2.new(1, -10, 1, -10)
	fnafCreditLabel.Size = UDim2.new(0.68, 0, 0, 20)
	fnafCreditLabel.BackgroundTransparency = 1
	fnafCreditLabel.Font = Enum.Font.Gotham
	fnafCreditLabel.Text = "ALL credits to Scott Cawthon."
	fnafCreditLabel.TextColor3 = Color3.fromRGB(220, 220, 220)
	fnafCreditLabel.TextTransparency = 0.28
	fnafCreditLabel.TextSize = 15
	fnafCreditLabel.TextScaled = false
	fnafCreditLabel.TextXAlignment = Enum.TextXAlignment.Right
	fnafCreditLabel.TextYAlignment = Enum.TextYAlignment.Bottom
	fnafCreditLabel.ZIndex = 8
	fnafCreditLabel.Visible = false
	fnafCreditLabel.Parent = coverContainer

	local creditStroke = Instance.new("UIStroke")
	creditStroke.Color = Color3.fromRGB(0, 0, 0)
	creditStroke.Thickness = 1.2
	creditStroke.Transparency = 0.25
	creditStroke.Parent = fnafCreditLabel

	local titleBg = Instance.new("Frame")
	titleBg.Name = "TitleGradientBg"
	titleBg.Size = UDim2.new(1, 0, 0, 60)
	titleBg.Position = UDim2.fromScale(0, 0)
	titleBg.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
	titleBg.BackgroundTransparency = 0.3
	titleBg.BorderSizePixel = 0
	titleBg.ZIndex = 7
	titleBg.Parent = coverContainer

	local titleBgGrad = Instance.new("UIGradient")
	titleBgGrad.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.1),
		NumberSequenceKeypoint.new(1, 1),
	})
	titleBgGrad.Rotation = 90
	titleBgGrad.Parent = titleBg

	titleLabel = Instance.new("TextLabel")
	titleLabel.Name = "TitleLabel"
	titleLabel.AnchorPoint = Vector2.new(0, 0)
	titleLabel.Position = UDim2.fromOffset(14, 12)
	titleLabel.Size = UDim2.new(0.8, 0, 0, 36)
	titleLabel.BackgroundTransparency = 1
	titleLabel.Font = Enum.Font.GothamBold
	titleLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
	titleLabel.TextTransparency = 0
	titleLabel.TextSize = 28
	titleLabel.TextXAlignment = Enum.TextXAlignment.Left
	titleLabel.TextYAlignment = Enum.TextYAlignment.Top
	titleLabel.Text = ""
	titleLabel.ZIndex = 9
	titleLabel.Parent = coverContainer

	local titleStroke = Instance.new("UIStroke")
	titleStroke.Color = Color3.fromRGB(0, 0, 0)
	titleStroke.Thickness = 2.5
	titleStroke.Transparency = 0.05
	titleStroke.Parent = titleLabel

	local btnRow = Instance.new("Frame")
	btnRow.Name = "ButtonRow"
	btnRow.Size = UDim2.new(1, 0, 0, 50)
	btnRow.AnchorPoint = Vector2.new(0, 1)
	btnRow.Position = UDim2.new(0, 0, 1, 0)
	btnRow.BackgroundTransparency = 1
	btnRow.BorderSizePixel = 0
	btnRow.ZIndex = 7
	btnRow.Parent = heroFrame

	viewBtn = createStyledButton(
		btnRow, "VIEW", C.Blue,
		UDim2.new(0.48, 0, 0, 42),
		UDim2.fromOffset(0, 4)
	)
	AnimUtil.WireButton(viewBtn, function()
		SoundUtil.Click()
		showDetailView()
	end)

	buyBtn = createStyledButton(
		btnRow, "BUY", C.BuyButton,
		UDim2.new(0.48, 0, 0, 42),
		UDim2.new(0.52, 0, 0, 4)
	)
	AnimUtil.WireButton(buyBtn, function()
		SoundUtil.Click()
		local bundle = BundleCatalog.Get(selectedBundleId)
		if not bundle then return end
		if not bundle.isAvailable then return end
		if isBundleOwned(bundle, "buyClick") then
			if bundle.id == "bundle_vip" then
				_bundleOwnedLocal.bundle_vip = true
			else
				_bundleOwnedLocal[bundle.id] = true
			end
			selectBundle(selectedBundleId)
			return
		end
		local coinRequestId = COIN_BUNDLE_REQUEST_IDS[bundle.id]
		if coinRequestId then
			local stateBefore = getCoinBundleState(bundle)
			if stateBefore.missingCount <= 0 then
				_bundleOwnedLocal[bundle.id] = true
				selectBundle(selectedBundleId)
				return
			end

			local remotes = ReplicatedStorage:FindFirstChild("Remotes")
			local buyRF = remotes and remotes:FindFirstChild("Shop_BuyWithCoins")
			if not buyRF then
				warn("[BundlePanel] Shop_BuyWithCoins remote missing for coin bundle")
				return
			end
			local okBuy, result = pcall(buyRF.InvokeServer, buyRF, coinRequestId, "Bundle")
			if okBuy and result and result.success then
				selectBundle(selectedBundleId)
			elseif okBuy and result and result.reason == "INSUFFICIENT_COINS" then
				local productId = tonumber(result.productId)
				if productId and productId > 0 then
					MarketplaceService:PromptProductPurchase(LocalPlayer, productId)
				else
					warn("[BundlePanel] Missing top-up productId for insufficient bundle coins")
				end
			elseif okBuy and result and result.reason == "ALREADY_OWNED" then
				_bundleOwnedLocal[bundle.id] = true
				selectBundle(selectedBundleId)
			end
		elseif bundle.gamepassId then
			local remotes = ReplicatedStorage:FindFirstChild("Remotes")
			local canPurchaseRF = remotes and remotes:FindFirstChild("CanPurchaseGamepassReward")
			if canPurchaseRF then
				local okCheck, gateResult = pcall(canPurchaseRF.InvokeServer, canPurchaseRF, bundle.gamepassId)
				if okCheck and type(gateResult) == "table" and gateResult.allowed == false then
					if bundle.id == "bundle_vip" and gateResult.alreadyOwned == true then
						_bundleOwnedLocal.bundle_vip = true
					end
					warn(string.format(
						"[VIPPurchaseGateClient] player=%s bundle=%s allowed=false reason=%s alreadyOwned=%s",
						LocalPlayer.Name,
						tostring(bundle.id),
						tostring(gateResult.reason or "UNKNOWN"),
						tostring(gateResult.alreadyOwned == true)
					))
					selectBundle(selectedBundleId)
					return
				end
			end
			MarketplaceService:PromptGamePassPurchase(LocalPlayer, bundle.gamepassId)
		elseif bundle.productId then
			MarketplaceService:PromptProductPurchase(LocalPlayer, bundle.productId)
		else
			print(string.format("[BundlePanel] Buy clicked: %s (%d ROBUX) -- no purchase ID set",
				bundle.id, bundle.priceRobux))
		end
	end)

	detailFrame = Instance.new("Frame")
	detailFrame.Name = "DetailView"
	detailFrame.Size = UDim2.new(0.68, -8, 1, -8)
	detailFrame.Position = UDim2.fromOffset(4, 4)
	detailFrame.BackgroundColor3 = Color3.fromRGB(20, 22, 40)
	detailFrame.BackgroundTransparency = 0.1
	detailFrame.BorderSizePixel = 0
	detailFrame.Visible = false
	detailFrame.ZIndex = 10
	detailFrame.Parent = bundleContainer

	local dfCorner = Instance.new("UICorner")
	dfCorner.CornerRadius = UDim.new(0, 12)
	dfCorner.Parent = detailFrame

	local detailHeader = Instance.new("Frame")
	detailHeader.Name = "DetailHeader"
	detailHeader.Size = UDim2.new(1, 0, 0, 42)
	detailHeader.BackgroundTransparency = 1
	detailHeader.ZIndex = 11
	detailHeader.Parent = detailFrame

	local backBtn = createStyledButton(
		detailHeader, "BACK", C.CloseBtn,
		UDim2.fromOffset(80, 34),
		UDim2.fromOffset(8, 4)
	)
	AnimUtil.WireButton(backBtn, function()
		SoundUtil.Click()
		hideDetailView()
	end)

	local detailTitle = Instance.new("TextLabel")
	detailTitle.Name = "DetailTitle"
	detailTitle.Size = UDim2.new(1, -100, 0, 34)
	detailTitle.Position = UDim2.fromOffset(96, 4)
	detailTitle.BackgroundTransparency = 1
	detailTitle.Font = Enum.Font.GothamBold
	detailTitle.TextColor3 = Color3.fromRGB(255, 255, 255)
	detailTitle.TextTransparency = 0
	detailTitle.TextSize = 18
	detailTitle.TextXAlignment = Enum.TextXAlignment.Left
	detailTitle.Text = "BUNDLE CONTENTS"
	detailTitle.ZIndex = 11
	detailTitle.Parent = detailHeader

	local dtStroke = Instance.new("UIStroke")
	dtStroke.Color = Color3.fromRGB(0, 0, 0)
	dtStroke.Thickness = 1.5
	dtStroke.Transparency = 0.1
	dtStroke.Parent = detailTitle

	selectorStrip = Instance.new("ScrollingFrame")
	selectorStrip.Name = "SelectorStrip"
	selectorStrip.Size = UDim2.new(0.30, -4, 1, -8)
	selectorStrip.Position = UDim2.new(0.70, 0, 0, 4)
	selectorStrip.BackgroundColor3 = STRIP_BG
	selectorStrip.BackgroundTransparency = 0.2
	selectorStrip.BorderSizePixel = 0
	selectorStrip.ScrollBarThickness = 4
	selectorStrip.ScrollBarImageColor3 = Color3.fromRGB(90, 95, 130)
	selectorStrip.CanvasSize = UDim2.fromScale(0, 0)
	selectorStrip.AutomaticCanvasSize = Enum.AutomaticSize.Y
	selectorStrip.ScrollingDirection = Enum.ScrollingDirection.Y
	selectorStrip.ZIndex = 5
	selectorStrip.Parent = bundleContainer

	local ssCorner = Instance.new("UICorner")
	ssCorner.CornerRadius = UDim.new(0, 12)
	ssCorner.Parent = selectorStrip

	local ssStroke = Instance.new("UIStroke")
	ssStroke.Color = Color3.fromRGB(55, 60, 90)
	ssStroke.Thickness = 1
	ssStroke.Transparency = 0.4
	ssStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	ssStroke.Parent = selectorStrip

	local ssPad = Instance.new("UIPadding")
	ssPad.PaddingTop = UDim.new(0, 6)
	ssPad.PaddingBottom = UDim.new(0, 6)
	ssPad.PaddingLeft = UDim.new(0, 6)
	ssPad.PaddingRight = UDim.new(0, 6)
	ssPad.Parent = selectorStrip

	local ssLayout = Instance.new("UIListLayout")
	ssLayout.FillDirection = Enum.FillDirection.Vertical
	ssLayout.Padding = UDim.new(0, 6)
	ssLayout.SortOrder = Enum.SortOrder.LayoutOrder
	ssLayout.Parent = selectorStrip

	selectorEntries = {}
	local allBundles = getBundlesForPanel()
	for i, bundle in ipairs(allBundles) do
		local entry = Instance.new("Frame")
		entry.Name = "Entry_" .. bundle.id
		entry.Size = UDim2.new(1, 0, 0, 72)
		entry.BackgroundColor3 = C.CardBg
		entry.BackgroundTransparency = 0
		entry.BorderSizePixel = 0
		entry.LayoutOrder = i
		entry.ZIndex = 6
		entry.Parent = selectorStrip

		local entryCorner = Instance.new("UICorner")
		entryCorner.CornerRadius = UDim.new(0, 8)
		entryCorner.Parent = entry

		local entryStroke = Instance.new("UIStroke")
		entryStroke.Color = C.CardStroke
		entryStroke.Thickness = 1.5
		entryStroke.Transparency = 0.3
		entryStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		entryStroke.Parent = entry

		local thumb = Instance.new("ImageLabel")
		thumb.Name = "Thumb"
		thumb.Size = UDim2.fromOffset(56, 56)
		thumb.Position = UDim2.fromOffset(8, 8)
		thumb.BackgroundColor3 = Color3.fromRGB(12, 14, 28)
		thumb.BorderSizePixel = 0
		thumb.ScaleType = Enum.ScaleType.Fit
		thumb.ZIndex = 7
		thumb.Parent = entry

		if bundle.coverImage and bundle.coverImage ~= "" then
			thumb.Image = bundle.coverImage
		else
			thumb.Image = ""
			local placeholder = Instance.new("TextLabel")
			placeholder.Size = UDim2.fromScale(1, 1)
			placeholder.BackgroundTransparency = 1
			placeholder.Font = Enum.Font.GothamBold
			placeholder.Text = "?"
			placeholder.TextColor3 = Color3.fromRGB(75, 80, 110)
			placeholder.TextSize = 28
			placeholder.ZIndex = 8
			placeholder.Parent = thumb
		end

		local thumbCorner = Instance.new("UICorner")
		thumbCorner.CornerRadius = UDim.new(0, 6)
		thumbCorner.Parent = thumb

		local nameLabel = Instance.new("TextLabel")
		nameLabel.Name = "BundleName"
		nameLabel.Size = UDim2.new(1, -76, 0, 20)
		nameLabel.Position = UDim2.fromOffset(70, 10)
		nameLabel.BackgroundTransparency = 1
		nameLabel.Font = Enum.Font.GothamBold
		nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
		nameLabel.TextTransparency = 0
		nameLabel.TextSize = 13
		nameLabel.TextXAlignment = Enum.TextXAlignment.Left
		nameLabel.TextTruncate = Enum.TextTruncate.AtEnd
		nameLabel.Text = bundle.displayName
		nameLabel.ZIndex = 7
		nameLabel.Parent = entry

		local ns = Instance.new("UIStroke")
		ns.Color = Color3.fromRGB(0, 0, 0)
		ns.Thickness = 1.2
		ns.Transparency = 0.15
		ns.Parent = nameLabel

		local tagText = ""
		if not bundle.isAvailable then
			tagText = "COMING SOON"
		elseif bundle.tag and bundle.tag ~= "" then
			tagText = bundle.tag
		end

		if tagText ~= "" then
			local tagBadge = Instance.new("TextLabel")
			tagBadge.Name = "Tag"
			tagBadge.Size = UDim2.new(1, -76, 0, 18)
			tagBadge.Position = UDim2.fromOffset(70, 34)
			tagBadge.BackgroundTransparency = 1
			tagBadge.Font = Enum.Font.GothamBold
			tagBadge.TextSize = 11
			tagBadge.TextXAlignment = Enum.TextXAlignment.Left
			tagBadge.TextTransparency = 0
			tagBadge.ZIndex = 7
			tagBadge.Parent = entry

			if not bundle.isAvailable then
				tagBadge.TextColor3 = C.TextMuted
				tagBadge.Text = "COMING SOON"
			else
				tagBadge.TextColor3 = C.Gold
				tagBadge.Text = bundle.tag
			end
		end

		local priceLabel = Instance.new("TextLabel")
		priceLabel.Name = "Price"
		priceLabel.Size = UDim2.new(1, -76, 0, 16)
		priceLabel.Position = UDim2.fromOffset(70, 52)
		priceLabel.BackgroundTransparency = 1
		priceLabel.Font = Enum.Font.GothamBold
		priceLabel.TextColor3 = C.Green
		priceLabel.TextTransparency = 0
		priceLabel.TextSize = 11
		priceLabel.TextXAlignment = Enum.TextXAlignment.Left
		local selectorOwned = false
		local isCoinBundle = COIN_BUNDLE_REQUEST_IDS[bundle.id] ~= nil
		if isCoinBundle then
			local state = getCoinBundleState(bundle)
			selectorOwned = state.missingCount <= 0
		elseif bundle.gamepassId then
			selectorOwned = isBundleOwned(bundle, "selectorEntry")
		end
		if selectorOwned then
			priceLabel.Text = "OWNED"
		elseif isCoinBundle then
			local state = getCoinBundleState(bundle)
			priceLabel.Text = string.format("%d F", state.finalCost)
		else
			priceLabel.Text = string.format("%d R$", bundle.priceRobux)
		end
		if selectorOwned then priceLabel.TextColor3 = C.TextMuted end
		priceLabel.ZIndex = 7
		priceLabel.Parent = entry

		local clickBtn = Instance.new("TextButton")
		clickBtn.Name = "ClickArea"
		clickBtn.Size = UDim2.fromScale(1, 1)
		clickBtn.BackgroundTransparency = 1
		clickBtn.Text = ""
		clickBtn.ZIndex = 10
		clickBtn.Parent = entry

		clickBtn.MouseButton1Click:Connect(function()
			SoundUtil.Click()
			selectBundle(bundle.id)
		end)

		selectorEntries[bundle.id] = entry
	end

	if allBundles[1] then
		selectBundle(allBundles[1].id)
	end
end

function BundlePanel.SelectBundle(bundleId: string)
	selectBundle(bundleId)
end

function BundlePanel.ShowItemPreviewIn(parent: Instance, itemData)
	externalPreviewHost = parent
	showItemPreview(itemData)
end

function BundlePanel.ClearContent()
	closeItemPreview()

	if bundleContainer then
		bundleContainer:Destroy()
		bundleContainer = nil
	end

	coverImage = nil
	titleLabel = nil
	viewBtn = nil
	buyBtn = nil
	heroFrame = nil
	detailFrame = nil
	selectorStrip = nil
	selectorEntries = {}
	selectedBundleId = ""
	inDetailView = false

	if contentParent then
		contentParent.AutomaticCanvasSize = Enum.AutomaticSize.Y
		contentParent.CanvasSize = UDim2.fromScale(0, 0)
		contentParent.ScrollBarThickness = 6
		contentParent.ScrollingDirection = Enum.ScrollingDirection.Y
	end
	contentParent = nil
	panelOptions = nil
	externalPreviewHost = nil
end

function BundlePanel.Show() end
function BundlePanel.Hide() end
function BundlePanel.IsVisible() return false end
function BundlePanel.Toggle() end

MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(a, b, c)
	local gamepassId: number? = nil
	local wasPurchased: boolean? = nil
	if typeof(a) == "Instance" and a:IsA("Player") then
		gamepassId = tonumber(b)
		wasPurchased = (c == true)
	else
		gamepassId = tonumber(a)
		wasPurchased = (b == true)
	end
	if wasPurchased and selectedBundleId and selectedBundleId ~= "" then
		task.wait(0.5)
		local remotes = ReplicatedStorage:FindFirstChild("Remotes")
		local verifyRF = remotes and remotes:FindFirstChild("VerifyGamepassPurchase")
		if verifyRF and gamepassId and gamepassId > 0 then
			local okVerify, verifyResult = pcall(function()
				return verifyRF:InvokeServer(gamepassId)
			end)
			if okVerify and verifyResult and verifyResult.success then
				if selectedBundleId == "bundle_vip" then
					_bundleOwnedLocal.bundle_vip = true
				end
				selectBundle(selectedBundleId)
			end
		end
	end
end)

LocalPlayer:GetAttributeChangedSignal("VIPBundleOwned"):Connect(function()
	print(string.format("[VIPPersistence] player=%s vipBundleUIOwned=%s context=attr:VIPBundleOwned",
		LocalPlayer.Name, tostring(isVipBundleOwnedForUI("attr:VIPBundleOwned"))))
	if bundleContainer and selectedBundleId == "bundle_vip" then
		selectBundle(selectedBundleId)
	end
end)

LocalPlayer:GetAttributeChangedSignal("OwnsVIP"):Connect(function()
	print(string.format("[VIPPersistence] player=%s vipBundleUIOwned=%s context=attr:OwnsVIP",
		LocalPlayer.Name, tostring(isVipBundleOwnedForUI("attr:OwnsVIP"))))
	if bundleContainer and selectedBundleId == "bundle_vip" then
		selectBundle(selectedBundleId)
	end
end)

return BundlePanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="145">
            <Properties>
              <string name="Name">Components</string>
              <string name="Source"><![CDATA[--[[
	Components
	Reusable UI element factory functions.

	DARK + VIBRANT theme — front-page Roblox quality:
	  • Dark opaque panel backgrounds
	  • Visible stud texture overlay (lighter pattern on dark)
	  • PER-PANEL unique background animations (via UIStyle themes)
	  • Centered radial glow (soft bright circle, color from theme)
	  • Refined coloured borders (subtle, consistent)
	  • Glossy gradient on headers & buttons
	  • High-contrast text with dark strokes
	  • Close button hover/press feedback (via UIStyle)

	Used by: every panel + HUDPanel + UIController
]]

local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local Shared = ReplicatedStorage:FindFirstChild("Shared") or ReplicatedStorage:WaitForChild("Shared", 5)
local UIConfig = require(Shared:WaitForChild("UIConfig"))
local ItemCatalog = require(Shared:WaitForChild("ItemCatalog"))
local ItemModelRegistry = require(Shared:WaitForChild("ItemModelRegistry"))

local Client = script.Parent
local AnimUtil  = require(Client:WaitForChild("AnimUtil"))
local SoundUtil = require(Client:WaitForChild("SoundUtil"))

-- UIStyle: instant load (NO blocking WaitForChild — never wait for UIStyle)
local _styleStart = tick()
local UIStyleModule = Client:FindFirstChild("UIStyle")
local UIStyle
if UIStyleModule then
	local ok, mod = pcall(require, UIStyleModule)
	if ok then
		UIStyle = mod
		print(string.format("[Components] UIStyle loaded instantly (%.0fms)", (tick() - _styleStart) * 1000))
	else
		warn("[Components] UIStyle failed to load:", mod, "— using built-in defaults")
	end
end
if not UIStyle then
	print(string.format("[Components] UIStyle not present — using built-in defaults (%.0fms, non-blocking)", (tick() - _styleStart) * 1000))
	UIStyle = {
		GetTheme = function(_themeName)
			return {
				accentColor   = Color3.fromRGB(72, 180, 255),
				glowColor     = Color3.fromRGB(75, 105, 195),
				glowAlpha     = 0.84,
				glowSize      = 1.4,
				bgAnimation   = "sunburst",
				sunburstSpeed = 8,
				sunburstAlpha = 0.85,
				sparkleCount  = 6,
				sparkleColor  = Color3.fromRGB(255, 255, 255),
			}
		end,
		ApplyBgAnimation = function() end,
		WireCloseButton = function() end,
	}
	-- Async: if UIStyle loads later, hot-swap it (non-blocking)
	task.spawn(function()
		local laterModule = Client:WaitForChild("UIStyle", 30)
		if laterModule then
			local ok2, mod2 = pcall(require, laterModule)
			if ok2 and mod2 then
				UIStyle = mod2
				print("[Components] UIStyle hot-swapped (loaded asynchronously)")
			end
		end
	end)
end

local C = UIConfig.Colors
local S = UIConfig.Sizes
local ROBUX_BUY_ICON_IMAGE = "rbxassetid://138917867019056"
local ROBUX_ICON_SIZE = 28
local DEBUG_LOGS = RunService:IsStudio() and UIConfig.DebugLogs == true
local LOG_RATE_SECONDS = tonumber(UIConfig.LogRateSeconds) or 20
local _lastLogByKey: {[string]: number} = {}

local function shouldLog(key: string, minInterval: number?): boolean
	if not DEBUG_LOGS then
		return false
	end
	local now = tick()
	local interval = minInterval or LOG_RATE_SECONDS
	local last = _lastLogByKey[key] or 0
	if now - last >= interval then
		_lastLogByKey[key] = now
		return true
	end
	return false
end

local Components = {}

function Components.ApplyRobuxBuyStyle(button: TextButton, amountText: string?, iconImage: string?, subText: string?)
	local buyGroup = button:FindFirstChild("RobuxBuyGroup")
	if buyGroup then
		buyGroup:Destroy()
	end

	local sourceText = button.Text or ""
	button.Text = ""

	local group = Instance.new("Frame")
	group.Name = "RobuxBuyGroup"
	group.AnchorPoint = Vector2.new(0.5, 0.5)
	group.Position = UDim2.fromScale(0.5, 0.5)
	group.Size = UDim2.new(1, -12, 1, -6)
	group.BackgroundTransparency = 1
	group.ZIndex = button.ZIndex + 1
	group.Parent = button

	local topRow = Instance.new("Frame")
	topRow.Name = "TopRow"
	topRow.AnchorPoint = Vector2.new(0.5, 0.5)
	topRow.Position = UDim2.new(0.5, 0, (subText and subText ~= "") and 0.38 or 0.5, 0)
	topRow.Size = UDim2.new(1, 0, 0, ROBUX_ICON_SIZE)
	topRow.BackgroundTransparency = 1
	topRow.ZIndex = group.ZIndex
	topRow.Parent = group

	local layout = Instance.new("UIListLayout")
	layout.FillDirection = Enum.FillDirection.Horizontal
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.VerticalAlignment = Enum.VerticalAlignment.Center
	layout.Padding = UDim.new(0, 5)
	layout.Parent = topRow

	local icon = Instance.new("ImageLabel")
	icon.Name = "Icon"
	icon.Size = UDim2.fromOffset(ROBUX_ICON_SIZE, ROBUX_ICON_SIZE)
	icon.BackgroundTransparency = 1
	icon.Image = iconImage or ROBUX_BUY_ICON_IMAGE
	icon.ImageColor3 = Color3.fromRGB(255, 255, 255)
	icon.ScaleType = Enum.ScaleType.Fit
	icon.ZIndex = topRow.ZIndex
	icon.Parent = topRow

	local iconSizeConstraint = Instance.new("UISizeConstraint")
	iconSizeConstraint.MinSize = Vector2.new(ROBUX_ICON_SIZE, ROBUX_ICON_SIZE)
	iconSizeConstraint.MaxSize = Vector2.new(ROBUX_ICON_SIZE, ROBUX_ICON_SIZE)
	iconSizeConstraint.Parent = icon

	local iconAspect = Instance.new("UIAspectRatioConstraint")
	iconAspect.AspectRatio = 1
	iconAspect.AspectType = Enum.AspectType.FitWithinMaxSize
	iconAspect.DominantAxis = Enum.DominantAxis.Width
	iconAspect.Parent = icon

	local amount = tostring(amountText or "")
	if amount == "" then
		local parsed = string.match(string.upper(sourceText), "(%d[%d,]*)%s*ROBUX")
		amount = parsed or "?"
	end

	local label = Instance.new("TextLabel")
	label.Name = "Label"
	label.AutomaticSize = Enum.AutomaticSize.X
	label.Size = UDim2.fromOffset(0, 18)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.LuckiestGuy
	label.Text = amount
	label.TextColor3 = button.TextColor3
	label.TextTransparency = 0.2
	label.TextSize = math.max(16, button.TextSize)
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.ZIndex = topRow.ZIndex
	label.Parent = topRow

	local labelStroke = Instance.new("UIStroke")
	labelStroke.Color = Color3.fromRGB(0, 0, 0)
	labelStroke.Thickness = 1.3
	labelStroke.Transparency = 0.18
	labelStroke.Parent = label

	if subText and subText ~= "" then
		local qtyLabel = Instance.new("TextLabel")
		qtyLabel.Name = "SubLabel"
		qtyLabel.AnchorPoint = Vector2.new(0.5, 0.5)
		qtyLabel.Position = UDim2.new(0.5, 0, 0.78, 0)
		qtyLabel.Size = UDim2.new(1, -6, 0, 14)
		qtyLabel.BackgroundTransparency = 1
		qtyLabel.Font = Enum.Font.GothamBold
		qtyLabel.Text = tostring(subText)
		qtyLabel.TextColor3 = button.TextColor3
		qtyLabel.TextTransparency = 0.08
		qtyLabel.TextSize = 10
		qtyLabel.ZIndex = group.ZIndex
		qtyLabel.Parent = group

		local qtyStroke = Instance.new("UIStroke")
		qtyStroke.Color = Color3.fromRGB(0, 0, 0)
		qtyStroke.Thickness = 1.1
		qtyStroke.Transparency = 0.25
		qtyStroke.Parent = qtyLabel
	end
end

-- ═══════════════════════════════════════════════════════════════════
-- INTERNAL HELPERS
-- ═══════════════════════════════════════════════════════════════════

--[[
	Subtle glossy sheen — white highlight at top, NO black darkening.
	This preserves the actual background color so buttons stay vibrant.
	topAlpha = how visible the white sheen is (lower = more visible)
]]
local function addGloss(frame: GuiObject, topAlpha: number?, _bottomAlpha: number?)
	topAlpha = topAlpha or 0.72
	local grad = Instance.new("UIGradient")
	grad.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 255)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 255, 255)),
	})
	grad.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, topAlpha),
		NumberSequenceKeypoint.new(0.4, 1),
		NumberSequenceKeypoint.new(1, 1),
	})
	grad.Rotation = 90
	grad.Parent = frame
end

--[[
	Strong glossy sheen for HEADER bars (brighter highlight).
]]
local function addHeaderGloss(frame: GuiObject)
	local grad = Instance.new("UIGradient")
	grad.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 255)),
		ColorSequenceKeypoint.new(0.5, Color3.fromRGB(220, 225, 240)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(0, 0, 0)),
	})
	grad.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.52),
		NumberSequenceKeypoint.new(0.35, 0.88),
		NumberSequenceKeypoint.new(0.65, 0.95),
		NumberSequenceKeypoint.new(1, 0.82),
	})
	grad.Rotation = 90
	grad.Parent = frame
end

--[[
	Offset drop-shadow behind a frame.
]]
local function addShadow(parent: GuiObject, radius: number?, ox: number?, oy: number?)
	radius = radius or S.PanelCorner + 8
	ox = ox or 3
	oy = oy or 6
	local shadow = Instance.new("Frame")
	shadow.Name = "DropShadow"
	shadow.AnchorPoint = Vector2.new(0.5, 0.5)
	shadow.Position = UDim2.new(0.5, ox, 0.5, oy)
	shadow.Size = UDim2.new(1, 20, 1, 20)
	shadow.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
	shadow.BackgroundTransparency = 0.48
	shadow.BorderSizePixel = 0
	shadow.ZIndex = 0
	shadow.Parent = parent
	local sc = Instance.new("UICorner")
	sc.CornerRadius = UDim.new(0, radius)
	sc.Parent = shadow
end

--[[
	Tileable stud texture overlay (lighter than dark bg = clearly visible).
]]
local function addStudTexture(parent: GuiObject, radius: number?)
	local tex = UIConfig.StudTexture
	local stud = Instance.new("ImageLabel")
	stud.Name = "StudTexture"
	stud.Size = UDim2.fromScale(1, 1)
	stud.BackgroundTransparency = 1
	stud.Image = tex.AssetId
	stud.ScaleType = Enum.ScaleType.Tile
	stud.TileSize = tex.TileSize
	stud.ImageTransparency = tex.Transparency
	stud.ImageColor3 = tex.Color
	stud.ZIndex = 1
	stud.Parent = parent
	if radius then
		local c = Instance.new("UICorner")
		c.CornerRadius = UDim.new(0, radius)
		c.Parent = stud
	end
end

-- Expose addStudTexture so other modules can add stud texture to backgrounds
Components.AddStudTexture = addStudTexture

--[[
	Centered radial glow — a big soft bright circle behind content.
	Creates a warm "spotlight" effect on the dark panel.
	Now accepts optional alpha and size from theme.
]]
local function addCenterGlow(parent: GuiObject, color: Color3?, alpha: number?, glowSize: number?)
	color = color or Color3.fromRGB(75, 105, 195)
	alpha = alpha or 0.84
	glowSize = glowSize or 1.4
	local glow = Instance.new("Frame")
	glow.Name = "CenterGlow"
	glow.Size = UDim2.new(glowSize, 0, glowSize * 0.85, 0)
	glow.AnchorPoint = Vector2.new(0.5, 0.5)
	glow.Position = UDim2.fromScale(0.5, 0.5)
	glow.BackgroundColor3 = color
	glow.BackgroundTransparency = alpha
	glow.BorderSizePixel = 0
	glow.ZIndex = 1
	glow.Parent = parent
	local gc = Instance.new("UICorner")
	gc.CornerRadius = UDim.new(0.5, 0)
	gc.Parent = glow

	-- Pulse
	local expandSize = glowSize + 0.1
	local shrinkSize = glowSize - 0.1
	task.spawn(function()
		while glow and glow.Parent do
			local t1 = TweenService:Create(glow, TweenInfo.new(3, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
				BackgroundTransparency = alpha,
				Size = UDim2.new(expandSize, 0, expandSize * 0.85, 0),
			})
			t1:Play()
			t1.Completed:Wait()
			local t2 = TweenService:Create(glow, TweenInfo.new(3, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
				BackgroundTransparency = alpha + 0.04,
				Size = UDim2.new(shrinkSize, 0, shrinkSize * 0.85, 0),
			})
			t2:Play()
			t2.Completed:Wait()
		end
	end)
end

--[[
	Slow-rotating "sunburst" light rays behind content.
	Now accepts optional speed and alpha from theme.
]]
local function addSunburst(parent: GuiObject, speed: number?, alpha: number?)
	speed = speed or (UIConfig.Anim.SunburstSpeed or 10)
	alpha = alpha or 0.85

	local burst = Instance.new("Frame")
	burst.Name = "Sunburst"
	burst.Size = UDim2.new(2.5, 0, 2.5, 0)
	burst.AnchorPoint = Vector2.new(0.5, 0.5)
	burst.Position = UDim2.fromScale(0.5, 0.5)
	burst.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	burst.BackgroundTransparency = alpha
	burst.BorderSizePixel = 0
	burst.ZIndex = 2
	burst.Parent = parent

	local grad = Instance.new("UIGradient")
	grad.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.58),
		NumberSequenceKeypoint.new(0.08, 0.96),
		NumberSequenceKeypoint.new(0.16, 0.62),
		NumberSequenceKeypoint.new(0.24, 0.96),
		NumberSequenceKeypoint.new(0.33, 0.58),
		NumberSequenceKeypoint.new(0.41, 0.96),
		NumberSequenceKeypoint.new(0.50, 0.62),
		NumberSequenceKeypoint.new(0.58, 0.96),
		NumberSequenceKeypoint.new(0.66, 0.58),
		NumberSequenceKeypoint.new(0.75, 0.96),
		NumberSequenceKeypoint.new(0.83, 0.62),
		NumberSequenceKeypoint.new(0.91, 0.96),
		NumberSequenceKeypoint.new(1, 0.58),
	})
	grad.Parent = burst

	local conn
	conn = RunService.Heartbeat:Connect(function(dt)
		if not burst.Parent then
			conn:Disconnect()
			return
		end
		grad.Rotation = (grad.Rotation + dt * speed) % 360
	end)
end

--[[
	Floating sparkle dots that fade in/out at random positions.
	Now accepts optional sparkle color from theme.
]]
local function addSparkles(parent: GuiObject, count: number?, sparkleColor: Color3?)
	count = count or 6
	sparkleColor = sparkleColor or Color3.fromRGB(255, 255, 255)
	for i = 1, count do
		local sparkle = Instance.new("Frame")
		sparkle.Name = "Sparkle" .. i
		sparkle.Size = UDim2.fromOffset(3, 3)
		sparkle.AnchorPoint = Vector2.new(0.5, 0.5)
		sparkle.Position = UDim2.fromScale(math.random() * 0.8 + 0.1, math.random() * 0.8 + 0.1)
		sparkle.BackgroundColor3 = sparkleColor
		sparkle.BackgroundTransparency = 1
		sparkle.BorderSizePixel = 0
		sparkle.ZIndex = 3
		sparkle.Parent = parent

		local sc = Instance.new("UICorner")
		sc.CornerRadius = UDim.new(1, 0)
		sc.Parent = sparkle

		task.spawn(function()
			task.wait(math.random() * 2)
			while sparkle and sparkle.Parent do
				sparkle.Position = UDim2.fromScale(math.random() * 0.8 + 0.1, math.random() * 0.8 + 0.1)
				local fadeIn = TweenService:Create(sparkle, TweenInfo.new(0.6, Enum.EasingStyle.Quad), {
					BackgroundTransparency = 0.20,
					Size = UDim2.fromOffset(6, 6),
				})
				fadeIn:Play()
				fadeIn.Completed:Wait()
				local fadeOut = TweenService:Create(sparkle, TweenInfo.new(0.6, Enum.EasingStyle.Quad), {
					BackgroundTransparency = 1,
					Size = UDim2.fromOffset(3, 3),
				})
				fadeOut:Play()
				fadeOut.Completed:Wait()
				task.wait(math.random() * 2 + 0.8)
			end
		end)
	end
end

-- ═══════════════════════════════════════════════════════════════════
-- SCREEN GUI
-- ═══════════════════════════════════════════════════════════════════

function Components.CreateScreenGui(name: string, displayOrder: number): ScreenGui
	local gui = Instance.new("ScreenGui")
	gui.Name = name
	gui.ResetOnSpawn = false
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.DisplayOrder = displayOrder
	gui.IgnoreGuiInset = false
	gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
	return gui
end

-- ═══════════════════════════════════════════════════════════════════
-- DIM OVERLAY
-- ═══════════════════════════════════════════════════════════════════

function Components.CreateDimOverlay(parent: Instance, onClose: () -> ()): Frame
	-- Invisible full-screen click blocker that sits ABOVE all HUD elements
	-- (ZIndex 4) but BELOW the panel canvas (ZIndex 5).
	-- This prevents stray clicks on HUD buttons from reaching through to the
	-- underlying HUD while any panel is open, which would trigger a panel switch
	-- mid-purchase and fire the close animation on the wrong frame.
	local overlay = Instance.new("TextButton")
	overlay.Name = "DimOverlay"
	overlay.Size = UDim2.fromScale(1, 1)
	overlay.Position = UDim2.fromScale(0, 0)
	overlay.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
	overlay.BackgroundTransparency = 1  -- invisible but fully blocks input
	overlay.BorderSizePixel = 0
	overlay.Text = ""
	overlay.AutoButtonColor = false
	overlay.Active = true               -- must be true to intercept clicks
	overlay.ZIndex = 4                  -- above HUD (2-3), below canvas (5)
	overlay.Visible = false
	overlay.Parent = parent
	overlay.MouseButton1Click:Connect(function()
		SoundUtil.Close()
		if onClose then onClose() end
	end)
	return overlay
end

-- ═══════════════════════════════════════════════════════════════════
-- PANEL  (dark opaque bg + stud texture + coloured border + theme-specific animation)
-- 4th param: themeName (optional) — e.g. "Shop", "Crate", "Spectate"
-- Uses UIStyle to select unique background animation per panel.
-- Returns: canvasGroup, uiScale, contentScroll, closeBtn
-- ═══════════════════════════════════════════════════════════════════

function Components.CreatePanel(parent: Instance, title: string, headerColor: Color3?, themeName: string?)
	-- Resolve theme from UIStyle (defaults to "Default" if not provided)
	local theme = UIStyle.GetTheme(themeName or "Default")

	-- Use theme accent if no explicit headerColor was passed
	headerColor = headerColor or theme.accentColor or C.HeaderShop

	-- Canvas root (dark, opaque)
	local canvas = Instance.new("CanvasGroup")
	canvas.Name = title:gsub("[^%w]", "") .. "Panel"
	canvas.AnchorPoint = Vector2.new(0.5, 0.5)
	canvas.Position = UDim2.fromScale(0.5, 0.5)
	canvas.Size = UDim2.fromScale(S.PanelWidth, S.PanelHeight)
	canvas.BackgroundColor3 = C.PanelBg
	canvas.BackgroundTransparency = 0
	canvas.BorderSizePixel = 0
	canvas.GroupTransparency = 1
	canvas.Visible = false
	canvas.ZIndex = 5
	canvas.ClipsDescendants = true
	canvas.Parent = parent

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, S.PanelCorner)
	corner.Parent = canvas

	-- Refined coloured border (thinner, more transparent)
	local stroke = Instance.new("UIStroke")
	stroke.Color = headerColor
	stroke.Thickness = S.PanelStroke
	stroke.Transparency = 0.1
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent = canvas

	-- Drop shadow
	addShadow(canvas, S.PanelCorner + 8, 4, 8)

	-- Stud texture (visible on dark)
	addStudTexture(canvas, S.PanelCorner)

	-- Center glow (color + alpha from theme)
	addCenterGlow(canvas, theme.glowColor, theme.glowAlpha, theme.glowSize)

	-- ─── THEME-SPECIFIC BACKGROUND ANIMATION ───
	-- Instead of always sunburst+sparkles, each panel gets its own animation.
	local bgAnim = theme.bgAnimation or "sunburst"

	if bgAnim == "sunburst" then
		-- Classic rotating light rays
		addSunburst(canvas, theme.sunburstSpeed, theme.sunburstAlpha)
		addSparkles(canvas, theme.sparkleCount, theme.sparkleColor)
	elseif bgAnim == "none" then
		-- Clean / minimal — no animated background (Settings)
	else
		-- Use UIStyle's animated variants (shimmer, waves, stars, bubbles)
		UIStyle.ApplyBgAnimation(canvas, theme)
		-- Still add themed sparkles for most panels (except "none")
		if theme.sparkleCount and theme.sparkleCount > 0 then
			addSparkles(canvas, theme.sparkleCount, theme.sparkleColor)
		end
	end

	-- UIScale for open/close animation
	local uiScale = Instance.new("UIScale")
	uiScale.Scale = UIConfig.Anim.OpenStartScale
	uiScale.Parent = canvas

	-- ─── GLOSSY HEADER ───
	local header = Instance.new("Frame")
	header.Name = "Header"
	header.Size = UDim2.new(1, 0, 0, S.PanelHeaderHeight)
	header.Position = UDim2.fromScale(0, 0)
	header.BackgroundColor3 = headerColor
	header.BorderSizePixel = 0
	header.ZIndex = 6
	header.Parent = canvas

	local hCorner = Instance.new("UICorner")
	hCorner.CornerRadius = UDim.new(0, S.PanelCorner)
	hCorner.Parent = header

	-- Mask bottom corners of header (so top corners round, bottom stays flat)
	local hMask = Instance.new("Frame")
	hMask.Name = "BottomMask"
	hMask.Size = UDim2.new(1, 0, 0, S.PanelCorner)
	hMask.Position = UDim2.new(0, 0, 1, -S.PanelCorner)
	hMask.BackgroundColor3 = headerColor
	hMask.BorderSizePixel = 0
	hMask.ZIndex = 6
	hMask.Parent = header

	addHeaderGloss(header)

	-- Header bottom highlight line (softer)
	local hLine = Instance.new("Frame")
	hLine.Name = "HighlightLine"
	hLine.Size = UDim2.new(1, -28, 0, 1)
	hLine.Position = UDim2.new(0, 14, 1, -1)
	hLine.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	hLine.BackgroundTransparency = 0.6
	hLine.BorderSizePixel = 0
	hLine.ZIndex = 7
	hLine.Parent = header

	-- Title text
	local titleLabel = Instance.new("TextLabel")
	titleLabel.Name = "Title"
	titleLabel.Size = UDim2.new(1, -S.CloseBtnSize - 32, 1, 0)
	titleLabel.Position = UDim2.fromOffset(22, 0)
	titleLabel.BackgroundTransparency = 1
	titleLabel.Font = Enum.Font.GothamBold
	titleLabel.TextColor3 = C.TextWhite
	titleLabel.TextSize = 30
	titleLabel.TextXAlignment = Enum.TextXAlignment.Left
	titleLabel.Text = title
	titleLabel.ZIndex = 7
	titleLabel.Parent = header
	local ts = Instance.new("UIStroke")
	ts.Color = Color3.fromRGB(0, 0, 0)
	ts.Thickness = 1.8
	ts.Transparency = 0.18
	ts.Parent = titleLabel

	-- Close button (red circle with white X)
	local closeBtn = Instance.new("TextButton")
	closeBtn.Name = "CloseBtn"
	closeBtn.AnchorPoint = Vector2.new(1, 0.5)
	closeBtn.Position = UDim2.new(1, -10, 0.5, 0)
	closeBtn.Size = UDim2.fromOffset(S.CloseBtnSize, S.CloseBtnSize)
	closeBtn.BackgroundColor3 = C.CloseBtn
	closeBtn.Font = Enum.Font.GothamBold
	closeBtn.Text = "X"
	closeBtn.TextColor3 = C.TextWhite
	closeBtn.TextSize = 26
	closeBtn.BorderSizePixel = 0
	closeBtn.AutoButtonColor = false
	closeBtn.ZIndex = 8
	closeBtn.Parent = header
	local cbCorner = Instance.new("UICorner")
	cbCorner.CornerRadius = UDim.new(0, S.CloseBtnSize / 2)
	cbCorner.Parent = closeBtn
	local cbStroke = Instance.new("UIStroke")
	cbStroke.Color = Color3.fromRGB(255, 255, 255)
	cbStroke.Thickness = 2
	cbStroke.Transparency = 0.35
	cbStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	cbStroke.Parent = closeBtn

	-- Close button hover/press feedback (via UIStyle)
	UIStyle.WireCloseButton(closeBtn, theme)

	-- Content scrolling area
	local content = Instance.new("ScrollingFrame")
	content.Name = "Content"
	content.Size = UDim2.new(1, -24, 1, -(S.PanelHeaderHeight + 18))
	content.Position = UDim2.new(0, 12, 0, S.PanelHeaderHeight + 8)
	content.BackgroundTransparency = 1
	content.BorderSizePixel = 0
	content.ScrollBarThickness = 5
	content.ScrollBarImageColor3 = Color3.fromRGB(75, 82, 108)
	content.CanvasSize = UDim2.fromScale(0, 0)
	content.AutomaticCanvasSize = Enum.AutomaticSize.Y
	content.ScrollingDirection = Enum.ScrollingDirection.Y
	content.ZIndex = 5
	content.Parent = canvas

	-- Safe padding at top/bottom to prevent content clipping at edges
	local contentPadding = Instance.new("UIPadding")
	contentPadding.PaddingTop = UDim.new(0, 4)
	contentPadding.PaddingBottom = UDim.new(0, 12)
	contentPadding.Parent = content

	return canvas, uiScale, content, closeBtn
end

-- ═══════════════════════════════════════════════════════════════════
-- TAB BAR  (for Premium Shop categories, Index tabs, etc.)
-- Returns: Frame, updateActive(index) function
-- ═══════════════════════════════════════════════════════════════════

function Components.CreateTabBar(parent: Instance, tabs: {{label: string}}, onSelect: (number) -> ()): (Frame, (number) -> ())
	local bar = Instance.new("Frame")
	bar.Name = "TabBar"
	bar.Size = UDim2.new(1, -20, 0, S.TabHeight + 8)
	bar.BackgroundTransparency = 1
	bar.BorderSizePixel = 0
	bar.ZIndex = 6
	bar.Parent = parent

	local layout = Instance.new("UIListLayout")
	layout.FillDirection = Enum.FillDirection.Horizontal
	layout.Padding = UDim.new(0, 6)
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.VerticalAlignment = Enum.VerticalAlignment.Center
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = bar

	local tabButtons: {TextButton} = {}

	for i, tab in ipairs(tabs) do
		local btn = Instance.new("TextButton")
		btn.Name = "Tab_" .. tab.label
		btn.Size = UDim2.fromOffset(math.max(#tab.label * 9 + 26, 72), S.TabHeight)
		btn.BackgroundColor3 = C.TabInactive
		btn.Font = Enum.Font.GothamBold
		btn.TextColor3 = C.TabTextInactive
		btn.TextSize = 15
		btn.Text = tab.label
		btn.BorderSizePixel = 0
		btn.AutoButtonColor = false
		btn.LayoutOrder = i
		btn.ZIndex = 6
		btn.Parent = bar

		local btnCorner = Instance.new("UICorner")
		btnCorner.CornerRadius = UDim.new(0, S.TabCorner)
		btnCorner.Parent = btn

		local btnStroke = Instance.new("UIStroke")
		btnStroke.Color = Color3.fromRGB(255, 255, 255)
		btnStroke.Thickness = 1.5
		btnStroke.Transparency = 0.7
		btnStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		btnStroke.Parent = btn

		tabButtons[i] = btn

		AnimUtil.WireButton(btn, function()
			SoundUtil.Click()
			onSelect(i)
		end)
	end

	local function updateActive(activeIdx: number)
		for i, btn in ipairs(tabButtons) do
			local stroke = btn:FindFirstChildWhichIsA("UIStroke")
			if i == activeIdx then
				btn.BackgroundColor3 = C.TabActive
				btn.TextColor3 = C.TabTextActive
				if stroke then
					stroke.Color = Color3.fromRGB(255, 255, 255)
					stroke.Transparency = 0.2
					stroke.Thickness = 2
				end
			else
				btn.BackgroundColor3 = C.TabInactive
				btn.TextColor3 = C.TabTextInactive
				if stroke then
					stroke.Color = Color3.fromRGB(255, 255, 255)
					stroke.Transparency = 0.75
					stroke.Thickness = 1.5
				end
			end
		end
	end

	return bar, updateActive
end

-- ═══════════════════════════════════════════════════════════════════
-- ITEM CARD  (dark bg, vibrant rarity border, glossy icon, white text)
-- Now supports optional `image` field — shows ImageLabel when provided,
-- falls back to text icon otherwise.
-- ═══════════════════════════════════════════════════════════════════

export type CardConfig = {
	name: string,
	rarity: string,
	iconColor: Color3,
	iconText: string?,
	image: string?,
	locked: boolean?,
	owned: boolean?,
	equipped: boolean?,
	actionText: string?,
	actionColor: Color3?,
	tag: string?,
	onAction: (() -> ())?,
}

function Components.CreateItemCard(parent: Instance, data: CardConfig): Frame
	local rarityInfo = UIConfig.RarityInfo[data.rarity] or UIConfig.RarityInfo.Common
	local rarityColor = rarityInfo.color

	local card = Instance.new("Frame")
	card.Name = "Card_" .. data.name
	card.Size = UDim2.fromOffset(S.CardWidth, S.CardHeight)
	card.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
	card.BackgroundTransparency = 0
	card.BorderSizePixel = 0
	card.Parent = parent

	local cc = Instance.new("UICorner")
	cc.CornerRadius = UDim.new(0, S.CardCorner)
	cc.Parent = card

	local cStroke = Instance.new("UIStroke")
	cStroke.Color = data.locked and Color3.fromRGB(42, 45, 62) or rarityColor
	cStroke.Thickness = data.locked and 1.5 or 2.5
	cStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	cStroke.Transparency = data.locked and 0.4 or 0.1
	cStroke.Parent = card


	local iconFrame = Instance.new("Frame")
	iconFrame.Name = "Icon"
	iconFrame.Size = UDim2.new(1, -16, 0, 90)
	iconFrame.Position = UDim2.fromOffset(8, 8)
	iconFrame.BorderSizePixel = 0
	iconFrame.ClipsDescendants = true
	iconFrame.Parent = card
	local iCorner = Instance.new("UICorner")
	iCorner.CornerRadius = UDim.new(0, 10)
	iCorner.Parent = iconFrame

	-- Consistent internal padding for the thumbnail window
	local iPadding = Instance.new("UIPadding")
	iPadding.PaddingLeft   = UDim.new(0, 6)
	iPadding.PaddingRight  = UDim.new(0, 6)
	iPadding.PaddingTop    = UDim.new(0, 6)
	iPadding.PaddingBottom = UDim.new(0, 6)
	iPadding.Parent = iconFrame

	local displayText = data.iconText or string.sub(data.name, 1, 1)

	if data.locked then
		iconFrame.BackgroundColor3 = Color3.fromRGB(0, 0, 0)

		if data.image and data.image ~= "" then
			-- Locked item with a static asset-id image: show it dimmed
			local img = Instance.new("ImageLabel")
			img.Name = "ItemImage"
			img.Size = UDim2.fromScale(1, 1)
			img.Position = UDim2.fromScale(0, 0)
			img.BackgroundTransparency = 1
			img.Image = data.image
			img.ScaleType = Enum.ScaleType.Crop
			img.ImageColor3 = Color3.fromRGB(80, 80, 80)
			img.ImageTransparency = 0.15
			img.ZIndex = 2
			img.Parent = iconFrame
			local imgCorner = Instance.new("UICorner")
			imgCorner.CornerRadius = UDim.new(0, 6)
			imgCorner.Parent = img

			-- Lock icon overlay
			local lockLabel = Instance.new("TextLabel")
			lockLabel.Name = "LockIcon"
			lockLabel.Size = UDim2.fromOffset(32, 32)
			lockLabel.AnchorPoint = Vector2.new(0.5, 0.5)
			lockLabel.Position = UDim2.fromScale(0.5, 0.5)
			lockLabel.BackgroundTransparency = 1
			lockLabel.Font = Enum.Font.GothamBold
			lockLabel.Text = ""
			lockLabel.TextColor3 = Color3.fromRGB(160, 165, 190)
			lockLabel.TextSize = 28
			lockLabel.ZIndex = 3
			lockLabel.Parent = iconFrame
		else
			local q = Instance.new("TextLabel")
			q.Size = UDim2.fromScale(1, 1)
			q.BackgroundTransparency = 1
			q.Font = Enum.Font.GothamBold
			q.Text = "?"
			q.TextColor3 = Color3.fromRGB(55, 58, 80)
			q.TextSize = 42
			q.Parent = iconFrame
			local qs = Instance.new("UIStroke")
			qs.Color = Color3.fromRGB(0, 0, 0)
			qs.Thickness = 1.5
			qs.Transparency = 0.35
			qs.Parent = q
		end
	else
		-- Fully black icon area — rarity only shown via card border stroke
		iconFrame.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
		iconFrame.BackgroundTransparency = 0

		if data.image and data.image ~= "" then
			local img = Instance.new("ImageLabel")
			img.Name = "ItemImage"
			img.Size = UDim2.fromScale(1, 1)
			img.Position = UDim2.fromScale(0, 0)
			img.BackgroundTransparency = 1
			img.Image = data.image
			img.ScaleType = Enum.ScaleType.Crop
			img.ZIndex = 2
			img.Parent = iconFrame
			-- Round the image corners to match the thumbnail window
			local imgCorner = Instance.new("UICorner")
			imgCorner.CornerRadius = UDim.new(0, 6)
			imgCorner.Parent = img
		else
			local letter = Instance.new("TextLabel")
			letter.Name = "Letter"
			letter.Size = UDim2.fromScale(1, 1)
			letter.BackgroundTransparency = 1
			letter.Font = Enum.Font.GothamBold
			letter.Text = displayText
			letter.TextColor3 = Color3.fromRGB(255, 255, 255)
			letter.TextSize = 34
			letter.TextTransparency = 0.02
			letter.Parent = iconFrame
			local ls = Instance.new("UIStroke")
			ls.Color = Color3.fromRGB(0, 0, 0)
			ls.Thickness = 1.8
			ls.Transparency = 0.2
			ls.Parent = letter
		end
	end

	if data.tag and data.tag ~= "" then
		local tagBadge = Instance.new("TextLabel")
		tagBadge.Name = "Tag"
		tagBadge.AnchorPoint = Vector2.new(0.5, 0)
		tagBadge.Position = UDim2.new(0.5, 0, 0, -8)
		tagBadge.Size = UDim2.fromOffset(math.max(#data.tag * 8 + 18, 48), 22)
		tagBadge.BackgroundColor3 = C.Gold
		tagBadge.Font = Enum.Font.GothamBold
		tagBadge.TextColor3 = Color3.fromRGB(62, 40, 0)
		tagBadge.TextSize = 12
		tagBadge.Text = data.tag
		tagBadge.BorderSizePixel = 0
		tagBadge.ZIndex = 10
		tagBadge.Parent = card
		local tc = Instance.new("UICorner")
		tc.CornerRadius = UDim.new(0, 7)
		tc.Parent = tagBadge
		local tcs = Instance.new("UIStroke")
		tcs.Color = Color3.fromRGB(175, 138, 0)
		tcs.Thickness = 1.5
		tcs.Transparency = 0.35
		tcs.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		tcs.Parent = tagBadge
	end

	if data.equipped then
		local check = Instance.new("TextLabel")
		check.Name = "Equipped"
		check.AnchorPoint = Vector2.new(1, 0)
		check.Position = UDim2.new(1, -4, 0, 4)
		check.Size = UDim2.fromOffset(26, 26)
		check.BackgroundColor3 = C.Green
		check.Font = Enum.Font.GothamBold
		check.Text = "\xe2\x9c\x93"
		check.TextColor3 = C.TextWhite
		check.TextSize = 15
		check.BorderSizePixel = 0
		check.ZIndex = 10
		check.Parent = card
		local chc = Instance.new("UICorner")
		chc.CornerRadius = UDim.new(1, 0)
		chc.Parent = check
		local chs = Instance.new("UIStroke")
		chs.Color = Color3.fromRGB(255, 255, 255)
		chs.Thickness = 1.5
		chs.Transparency = 0.3
		chs.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		chs.Parent = check
	end

	local nameLabel = Instance.new("TextLabel")
	nameLabel.Name = "ItemName"
	nameLabel.Size = UDim2.new(1, -10, 0, 18)
	nameLabel.Position = UDim2.new(0, 5, 0, 100)
	nameLabel.BackgroundTransparency = 1
	nameLabel.Font = Enum.Font.GothamBold
	nameLabel.TextColor3 = data.locked and Color3.fromRGB(130, 135, 155) or C.TextWhite
	nameLabel.TextSize = 12
	nameLabel.TextScaled = false
	nameLabel.TextWrapped = false
	nameLabel.TextTruncate = Enum.TextTruncate.AtEnd
	nameLabel.TextXAlignment = Enum.TextXAlignment.Center
	nameLabel.Text = data.name or "MISSING ITEM"
	nameLabel.Parent = card
	do
		local ns = Instance.new("UIStroke")
		ns.Color = Color3.fromRGB(0, 0, 0)
		ns.Thickness = 1.5
		ns.Transparency = 0.15
		ns.Parent = nameLabel
	end

	local rarLabel = Instance.new("TextLabel")
	rarLabel.Name = "Rarity"
	rarLabel.Size = UDim2.new(1, -10, 0, 16)
	rarLabel.Position = UDim2.new(0, 5, 0, 119)
	rarLabel.BackgroundTransparency = 1
	rarLabel.Font = Enum.Font.GothamBold
	rarLabel.TextColor3 = data.locked and Color3.fromRGB(100, 105, 125) or rarityColor
	rarLabel.TextSize = 12
	rarLabel.TextXAlignment = Enum.TextXAlignment.Center
	rarLabel.Text = rarityInfo.label
	rarLabel.Parent = card

	if data.subLabel and data.subLabel ~= "" then
		local subLbl = Instance.new("TextLabel")
		subLbl.Name = "SubLabel"
		subLbl.Size = UDim2.new(1, -10, 0, 14)
		subLbl.Position = UDim2.new(0, 5, 0, 135)
		subLbl.BackgroundTransparency = 1
		subLbl.Font = Enum.Font.GothamBold
		subLbl.TextColor3 = data.locked and Color3.fromRGB(100, 105, 135) or C.TextMuted
		subLbl.TextSize = 11
		subLbl.TextXAlignment = Enum.TextXAlignment.Center
		subLbl.Text = data.subLabel
		subLbl.Parent = card
	end

	if data.actionText and not data.locked then
		local btnColor = data.actionColor or C.BuyButton
		local btn = Instance.new("TextButton")
		btn.Name = "ActionBtn"
		btn.AnchorPoint = Vector2.new(0.5, 1)
		btn.Position = UDim2.new(0.5, 0, 1, -8)
		btn.Size = UDim2.new(1, -16, 0, 42)
		btn.BackgroundColor3 = btnColor
		btn.Font = Enum.Font.GothamBold
		btn.TextColor3 = C.TextWhite
		btn.TextSize = 15
		btn.Text = data.actionText
		btn.BorderSizePixel = 0
		btn.AutoButtonColor = false
		btn.Parent = card
		local bc = Instance.new("UICorner")
		bc.CornerRadius = UDim.new(0, S.SmBtnCorner)
		bc.Parent = btn

		local abr, abg, abb = btnColor.R, btnColor.G, btnColor.B
		local lighterAB = Color3.new(
			math.min(abr + 0.20, 1),
			math.min(abg + 0.20, 1),
			math.min(abb + 0.20, 1)
		)
		local darkerAB = Color3.new(
			math.max(abr - 0.10, 0),
			math.max(abg - 0.10, 0),
			math.max(abb - 0.10, 0)
		)
		local abGrad = Instance.new("UIGradient")
		abGrad.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, lighterAB),
			ColorSequenceKeypoint.new(0.5, btnColor),
			ColorSequenceKeypoint.new(1, darkerAB),
		})
		abGrad.Rotation = 90
		abGrad.Parent = btn

		local bs = Instance.new("UIStroke")
		bs.Color = Color3.fromRGB(255, 255, 255)
		bs.Thickness = 1.5
		bs.Transparency = 0.4
		bs.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		bs.Parent = btn

		local bts = Instance.new("UIStroke")
		bts.Color = Color3.fromRGB(0, 0, 0)
		bts.Thickness = 1.5
		bts.Transparency = 0.12
		bts.Parent = btn

		if type(data.actionText) == "string" and string.find(string.upper(data.actionText), "ROBUX", 1, true) then
			local amount = string.match(string.upper(data.actionText), "(%d[%d,]*)%s*ROBUX")
			Components.ApplyRobuxBuyStyle(btn, amount)
		end

		AnimUtil.WireButton(btn, function()
			SoundUtil.Click()
			if data.onAction then data.onAction() end
		end)
	end

	return card
end

-- ═══════════════════════════════════════════════════════════════════
-- CRATE SECTION  (for walk-up Crate Shop — big icon, drops, buy buttons)
-- ═══════════════════════════════════════════════════════════════════

export type CrateData = {
	name: string,
	iconColor: Color3,
	accentColor: Color3?,
	drops: {{ name: string, chance: number, rarity: string }},
	prices: {{ label: string, cost: number, currency: string }},
	onBuy: ((priceIndex: number) -> ())?,
}

function Components.CreateCrateSection(parent: Instance, data: CrateData): Frame
	local accent = data.accentColor or data.iconColor

	local section = Instance.new("Frame")
	section.Name = "Crate_" .. data.name
	section.Size = UDim2.new(1, -20, 0, S.CrateSectionHeight)
	section.BackgroundColor3 = C.CardBg
	section.BorderSizePixel = 0
	section.Parent = parent
	local sc = Instance.new("UICorner")
	sc.CornerRadius = UDim.new(0, S.CardCorner)
	sc.Parent = section
	local ss = Instance.new("UIStroke")
	ss.Color = accent
	ss.Thickness = 2.5
	ss.Transparency = 0.12
	ss.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	ss.Parent = section

	addGloss(section, 0.82, 0.94)

	addStudTexture(section, S.CardCorner)

	local iconArea = Instance.new("Frame")
	iconArea.Name = "IconArea"
	iconArea.Size = UDim2.new(0, 120, 1, -14)
	iconArea.Position = UDim2.fromOffset(7, 7)
	iconArea.BackgroundColor3 = data.iconColor
	iconArea.BorderSizePixel = 0
	iconArea.Parent = section
	local iac = Instance.new("UICorner")
	iac.CornerRadius = UDim.new(0, 14)
	iac.Parent = iconArea
	addGloss(iconArea, 0.38, 0.75)
	local ias = Instance.new("UIStroke")
	ias.Color = Color3.fromRGB(255, 255, 255)
	ias.Thickness = 1.5
	ias.Transparency = 0.5
	ias.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	ias.Parent = iconArea

	local crateImg = Instance.new("ImageLabel")
	crateImg.Name = "CrateImage"
	crateImg.AnchorPoint = Vector2.new(0.5, 0)
	crateImg.Size = UDim2.new(0.78, 0, 0, 70)
	crateImg.Position = UDim2.new(0.5, 0, 0, 12)
	crateImg.BackgroundTransparency = 1
	crateImg.Image = "rbxassetid://102125624504903"
	crateImg.ScaleType = Enum.ScaleType.Fit
	crateImg.ImageTransparency = 0
	crateImg.ZIndex = 2
	crateImg.Parent = iconArea

	local crateName = Instance.new("TextLabel")
	crateName.Name = "Name"
	crateName.AnchorPoint = Vector2.new(0.5, 1)
	crateName.Position = UDim2.new(0.5, 0, 1, -10)
	crateName.Size = UDim2.new(1, -8, 0, 34)
	crateName.BackgroundTransparency = 1
	crateName.Font = Enum.Font.GothamBold
	crateName.TextColor3 = C.TextWhite
	crateName.TextSize = 15
	crateName.Text = data.name
	crateName.TextWrapped = true
	crateName.Parent = iconArea
	local cns = Instance.new("UIStroke")
	cns.Color = Color3.fromRGB(0, 0, 0)
	cns.Thickness = 1.5
	cns.Transparency = 0.22
	cns.Parent = crateName

	local titleR = Instance.new("TextLabel")
	titleR.Name = "Title"
	titleR.Size = UDim2.new(1, -150, 0, 28)
	titleR.Position = UDim2.fromOffset(138, 10)
	titleR.BackgroundTransparency = 1
	titleR.Font = Enum.Font.GothamBold
	titleR.TextColor3 = C.TextWhite
	titleR.TextSize = 19
	titleR.TextXAlignment = Enum.TextXAlignment.Left
	titleR.Text = data.name
	titleR.Parent = section
	local trs = Instance.new("UIStroke")
	trs.Color = Color3.fromRGB(0, 0, 0)
	trs.Thickness = 1.5
	trs.Transparency = 0.22
	trs.Parent = titleR

	for i, drop in ipairs(data.drops) do
		local dRarity = UIConfig.RarityInfo[drop.rarity] or UIConfig.RarityInfo.Common
		local dLabel = Instance.new("TextLabel")
		dLabel.Name = "Drop" .. i
		dLabel.Size = UDim2.new(0, 220, 0, 20)
		dLabel.Position = UDim2.fromOffset(138, 36 + (i - 1) * 22)
		dLabel.BackgroundTransparency = 1
		dLabel.Font = Enum.Font.GothamBold
		dLabel.TextColor3 = dRarity.color
		dLabel.TextSize = 14
		dLabel.TextXAlignment = Enum.TextXAlignment.Left
		dLabel.Text = string.format("%d%%  %s", drop.chance, drop.name)
		dLabel.Parent = section
		local ds = Instance.new("UIStroke")
		ds.Color = Color3.fromRGB(0, 0, 0)
		ds.Thickness = 1.2
		ds.Transparency = 0.18
		ds.Parent = dLabel
	end

	local btnRow = Instance.new("Frame")
	btnRow.Name = "BuyButtons"
	btnRow.AnchorPoint = Vector2.new(0, 1)
	btnRow.Position = UDim2.new(0, 138, 1, -10)
	btnRow.Size = UDim2.new(1, -150, 0, 54)
	btnRow.BackgroundTransparency = 1
	btnRow.BorderSizePixel = 0
	btnRow.Parent = section

	local bLayout = Instance.new("UIListLayout")
	bLayout.FillDirection = Enum.FillDirection.Horizontal
	bLayout.Padding = UDim.new(0, 8)
	bLayout.SortOrder = Enum.SortOrder.LayoutOrder
	bLayout.VerticalAlignment = Enum.VerticalAlignment.Bottom
	bLayout.Parent = btnRow

	for pi, price in ipairs(data.prices) do
		local isRobux = price.currency == "Robux"
		local priceText = isRobux and string.format("%d ROBUX", price.cost) or string.format("F %d", price.cost)
		local btnColor = isRobux and C.RobuxButton or C.BuyButton

		local pBtn = Instance.new("TextButton")
		pBtn.Name = "Price" .. pi
		pBtn.Size = UDim2.fromOffset(110, 54)
		pBtn.BackgroundColor3 = btnColor
		pBtn.Font = Enum.Font.GothamBold
		pBtn.TextColor3 = C.TextWhite
		pBtn.TextSize = 15
		pBtn.Text = priceText .. "\n" .. price.label
		pBtn.TextYAlignment = Enum.TextYAlignment.Center
		pBtn.BorderSizePixel = 0
		pBtn.AutoButtonColor = false
		pBtn.LayoutOrder = pi
		pBtn.Parent = btnRow
		local pbc = Instance.new("UICorner")
		pbc.CornerRadius = UDim.new(0, S.SmBtnCorner)
		pbc.Parent = pBtn

		local br, bg, bb = btnColor.R, btnColor.G, btnColor.B
		local lighterBtn = Color3.new(
			math.min(br + 0.20, 1),
			math.min(bg + 0.20, 1),
			math.min(bb + 0.20, 1)
		)
		local darkerBtn = Color3.new(
			math.max(br - 0.12, 0),
			math.max(bg - 0.12, 0),
			math.max(bb - 0.12, 0)
		)
		local pbGrad = Instance.new("UIGradient")
		pbGrad.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, lighterBtn),
			ColorSequenceKeypoint.new(0.5, btnColor),
			ColorSequenceKeypoint.new(1, darkerBtn),
		})
		pbGrad.Rotation = 90
		pbGrad.Parent = pBtn

		local pbs = Instance.new("UIStroke")
		pbs.Color = Color3.fromRGB(255, 255, 255)
		pbs.Thickness = 1.5
		pbs.Transparency = 0.4
		pbs.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		pbs.Parent = pBtn

		local pbts = Instance.new("UIStroke")
		pbts.Color = Color3.fromRGB(0, 0, 0)
		pbts.Thickness = 1.2
		pbts.Transparency = 0.18
		pbts.Parent = pBtn

		if isRobux then
			Components.ApplyRobuxBuyStyle(pBtn, tostring(price.cost), nil, tostring(price.label or ""))
		end

		AnimUtil.WireButton(pBtn, function()
			SoundUtil.Click()
			if data.onBuy then data.onBuy(pi) end
		end)
	end

	return section
end

-- ═══════════════════════════════════════════════════════════════════
-- GRID LAYOUT  (for item cards)
-- ═══════════════════════════════════════════════════════════════════

function Components.AddGridLayout(parent: Instance, cellSize: Vector2?, padding: number?): UIGridLayout
	cellSize = cellSize or Vector2.new(S.CardWidth, S.CardHeight)
	padding = padding or S.CardPad
	local grid = Instance.new("UIGridLayout")
	grid.CellSize = UDim2.fromOffset(cellSize.X, cellSize.Y)
	grid.CellPadding = UDim2.fromOffset(padding, padding)
	grid.SortOrder = Enum.SortOrder.LayoutOrder
	grid.FillDirection = Enum.FillDirection.Horizontal
	grid.HorizontalAlignment = Enum.HorizontalAlignment.Center
	grid.Parent = parent
	local pad = Instance.new("UIPadding")
	pad.PaddingTop = UDim.new(0, 10)
	pad.PaddingBottom = UDim.new(0, 10)
	pad.PaddingLeft = UDim.new(0, 8)
	pad.PaddingRight = UDim.new(0, 8)
	pad.Parent = parent
	return grid
end

-- ═══════════════════════════════════════════════════════════════════
-- LIST LAYOUT  (for crate sections, stacked vertically)
-- ═══════════════════════════════════════════════════════════════════

function Components.AddListLayout(parent: Instance, padding: number?)
	padding = padding or 14
	local list = Instance.new("UIListLayout")
	list.SortOrder = Enum.SortOrder.LayoutOrder
	list.Padding = UDim.new(0, padding)
	list.FillDirection = Enum.FillDirection.Vertical
	list.HorizontalAlignment = Enum.HorizontalAlignment.Center
	list.Parent = parent
	local pad = Instance.new("UIPadding")
	pad.PaddingTop = UDim.new(0, 10)
	pad.PaddingBottom = UDim.new(0, 10)
	pad.PaddingLeft = UDim.new(0, 8)
	pad.PaddingRight = UDim.new(0, 8)
	pad.Parent = parent
end

-- ═══════════════════════════════════════════════════════════════════
-- SIDEBAR BUTTON  (dark, chunky, glossy — refined strokes)
-- ═══════════════════════════════════════════════════════════════════

function Components.CreateSideButton(parent: Instance, label: string, iconText: string, bgColor: Color3, layoutOrder: number, onClick: () -> (), iconImage: string?): TextButton
	local btn = Instance.new("TextButton")
	btn.Name = "Side_" .. label
	btn.Size = UDim2.fromOffset(S.SideBtnW, S.SideBtnH)
	btn.BackgroundColor3 = bgColor
	btn.BorderSizePixel = 0
	btn.AutoButtonColor = false
	btn.Text = ""
	btn.LayoutOrder = layoutOrder
	btn.Parent = parent

	local co = Instance.new("UICorner")
	co.CornerRadius = UDim.new(0, S.SideBtnCorner)
	co.Parent = btn

	local st = Instance.new("UIStroke")
	st.Color = Color3.fromRGB(255, 255, 255)
	st.Thickness = 2.5
	st.Transparency = 0.28
	st.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	st.Parent = btn

	local r, g, b = bgColor.R, bgColor.G, bgColor.B
	local lighterColor = Color3.new(
		math.min(r + 0.22, 1),
		math.min(g + 0.22, 1),
		math.min(b + 0.22, 1)
	)
	local darkerColor = Color3.new(
		math.max(r - 0.10, 0),
		math.max(g - 0.10, 0),
		math.max(b - 0.10, 0)
	)
	local sideGrad = Instance.new("UIGradient")
	sideGrad.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, lighterColor),
		ColorSequenceKeypoint.new(0.5, bgColor),
		ColorSequenceKeypoint.new(1, darkerColor),
	})
	sideGrad.Rotation = 90
	sideGrad.Parent = btn

	local shadow = Instance.new("Frame")
	shadow.Name = "Shadow"
	shadow.AnchorPoint = Vector2.new(0.5, 0.5)
	shadow.Position = UDim2.new(0.5, 2, 0.5, 4)
	shadow.Size = UDim2.new(1, 10, 1, 10)
	shadow.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
	shadow.BackgroundTransparency = 0.5
	shadow.BorderSizePixel = 0
	shadow.ZIndex = 0
	shadow.Parent = btn
	local shc = Instance.new("UICorner")
	shc.CornerRadius = UDim.new(0, S.SideBtnCorner + 4)
	shc.Parent = shadow

	if iconImage and iconImage ~= "" then
		local icon = Instance.new("ImageLabel")
		icon.Name = "Icon"
		icon.AnchorPoint = Vector2.new(0.5, 0.5)
		icon.Size = UDim2.fromOffset(math.floor(S.SideBtnW * 0.68), math.floor(S.SideBtnH * 0.68))
		icon.Position = UDim2.fromScale(0.5, 0.45)
		icon.BackgroundTransparency = 1
		icon.Image = iconImage
		icon.ImageColor3 = Color3.fromRGB(255, 255, 255)
		icon.ScaleType = Enum.ScaleType.Fit
		icon.ResampleMode = Enum.ResamplerMode.Default
		icon.ZIndex = 2
		icon.Parent = btn
		local ar = Instance.new("UIAspectRatioConstraint")
		ar.AspectRatio = 1
		ar.Parent = icon
	else
		local icon = Instance.new("TextLabel")
		icon.Name = "Icon"
		icon.Size = UDim2.new(1, 0, 0, 40)
		icon.Position = UDim2.fromOffset(0, 6)
		icon.BackgroundTransparency = 1
		icon.Font = Enum.Font.GothamBold
		icon.TextColor3 = C.TextWhite
		icon.TextSize = 36
		icon.Text = iconText
		icon.ZIndex = 2
		icon.Parent = btn
		local is = Instance.new("UIStroke")
		is.Color = Color3.fromRGB(0, 0, 0)
		is.Thickness = 2
		is.Transparency = 0.15
		is.Parent = icon
	end

	local lbl = Instance.new("TextLabel")
	lbl.Name = "Label"
	lbl.Size = UDim2.new(1, 0, 0, 20)
	lbl.Position = UDim2.new(0, 0, 1, -24)
	lbl.BackgroundTransparency = 1
	lbl.Font = Enum.Font.GothamBold
	lbl.TextColor3 = C.TextWhite
	lbl.TextSize = 14
	lbl.Text = label
	lbl.ZIndex = 2
	lbl.Parent = btn
	local ls = Instance.new("UIStroke")
	ls.Color = Color3.fromRGB(0, 0, 0)
	ls.Thickness = 1.5
	ls.Transparency = 0.2
	ls.Parent = lbl

	AnimUtil.WireButton(btn, function()
		SoundUtil.Click()
		onClick()
	end)

	return btn
end

-- ═══════════════════════════════════════════════════════════════════
-- VIEWPORT ITEM CARD  (3D model preview via ViewportFrame)
-- ═══════════════════════════════════════════════════════════════════

--[[
	Creates an item card with a ViewportFrame showing the 3D model.
	Falls back to emoji/text if model not found in ReplicatedStorage.

	config fields (extends CardConfig):
	  modelPath: string  — dot-separated path in ReplicatedStorage
	  All other fields from CardConfig are supported.
]]

-- Model resolution via ItemModelRegistry (single source of truth, case-insensitive)
local function resolveModelPath(modelPath: string): Instance?
	if not modelPath or modelPath == "" then return nil end
	return ItemModelRegistry.Get(modelPath)
end

local function isInsideThumbnailVFX(part: Instance, root: Instance): boolean
	local parent = part.Parent
	while parent and parent ~= root do
		if parent:IsA("Folder") and parent.Name == "ThumbnailVFX" then return true end
		parent = parent.Parent
	end
	return false
end

local function getModelBounds(model: Instance): (Vector3, Vector3)
	-- Priority A: ThumbnailCameraTarget overrides everything
	local camTarget = model:FindFirstChild("ThumbnailCameraTarget", true)
	if camTarget and camTarget:IsA("BasePart") then
		local p, h = camTarget.Position, camTarget.Size / 2
		return
			Vector3.new(p.X - h.X, p.Y - h.Y, p.Z - h.Z),
			Vector3.new(p.X + h.X, p.Y + h.Y, p.Z + h.Z)
	end

	-- Priority B: PrimaryPart if model has one
	if model:IsA("Model") and model.PrimaryPart then
		local pp = model.PrimaryPart
		local p, h = pp.Position, pp.Size / 2
		return
			Vector3.new(p.X - h.X, p.Y - h.Y, p.Z - h.Z),
			Vector3.new(p.X + h.X, p.Y + h.Y, p.Z + h.Z)
	end

	-- Priority C: All visible BaseParts, excluding ThumbnailVFX contents
	local minBound = Vector3.new(math.huge, math.huge, math.huge)
	local maxBound = Vector3.new(-math.huge, -math.huge, -math.huge)

	local function proc(part: BasePart)
		local pos = part.Position
		local halfSize = part.Size / 2
		minBound = Vector3.new(
			math.min(minBound.X, pos.X - halfSize.X),
			math.min(minBound.Y, pos.Y - halfSize.Y),
			math.min(minBound.Z, pos.Z - halfSize.Z)
		)
		maxBound = Vector3.new(
			math.max(maxBound.X, pos.X + halfSize.X),
			math.max(maxBound.Y, pos.Y + halfSize.Y),
			math.max(maxBound.Z, pos.Z + halfSize.Z)
		)
	end

	if model:IsA("BasePart") then proc(model) end
	for _, desc in ipairs(model:GetDescendants()) do
		if desc:IsA("BasePart") and not isInsideThumbnailVFX(desc, model) then
			proc(desc)
		end
	end

	if minBound.X == math.huge then
		return Vector3.zero, Vector3.new(2, 2, 2)
	end

	return minBound, maxBound
end

local function setupViewportCamera(viewport: ViewportFrame, model: Instance, distanceMult: number?)
	local minB, maxB = getModelBounds(model)
	local center = (minB + maxB) / 2
	local size = maxB - minB
	local maxDim = math.max(size.X, size.Y, size.Z, 1)

	-- Wider framing: pull camera back so items are not overly zoomed in
	local distance = maxDim * (distanceMult or 2.0)
	local cameraPos = center + Vector3.new(distance * 0.5, distance * 0.35, distance * 0.8)

	local cam = Instance.new("Camera")
	cam.CameraType = Enum.CameraType.Scriptable
	cam.CFrame = CFrame.lookAt(cameraPos, center)
	cam.FieldOfView = 50
	cam.Parent = viewport

	viewport.CurrentCamera = cam
end

--- Safe clone: strips unsafe instances, anchors parts, keeps VFX for viewport rendering
local function cloneModelForViewport(modelInstance: Instance): Instance
	local clone = modelInstance:Clone()
	local descendants = clone:GetDescendants()

	for _, d in ipairs(descendants) do
		-- Strip scripts (can run code, cause errors)
		if d:IsA("Script") or d:IsA("LocalScript") or d:IsA("ModuleScript") then
			d:Destroy()
		-- Strip humanoids / animation controllers
		elseif d:IsA("Humanoid") or d:IsA("Animator") or d:IsA("AnimationController") then
			d:Destroy()
		-- Anchor all parts and disable collision
		elseif d:IsA("BasePart") then
			d.Anchored = true
			d.CanCollide = false
		end
	end

	return clone
end

-- VFX classes that indicate an item has visual effects
-- (VFX detect/proxy removed — static images with baked VFX are used instead)

--- Reposition a cloned model to the origin for proper framing in a ViewportFrame
local function resetModelPosition(clone: Instance)
	if clone:IsA("Model") and clone.PrimaryPart then
		clone:PivotTo(CFrame.new())
	elseif clone:IsA("BasePart") then
		clone.Position = Vector3.zero
	elseif clone:IsA("Model") then
		local firstPart = clone:FindFirstChildWhichIsA("BasePart", true)
		if firstPart then
			local offset = firstPart.Position
			for _, desc in ipairs(clone:GetDescendants()) do
				if desc:IsA("BasePart") then
					desc.Position = desc.Position - offset
				end
			end
		end
	end
end

-- Per-item thumbnail yaw correction (degrees) for viewport cards.
-- Rotates the model so its "face" points toward the camera. ONLY for thumbnails.
local CARD_THUMBNAIL_YAW: { [string]: number } = {
	pet_dog = 180,
}

-- Keep card thumbnails aligned with ThumbnailRenderer behavior.
local CARD_THUMBNAIL_OFFSET_CFRAME: { [string]: CFrame } = {
	pet_foxy_plush = CFrame.Angles(0, math.rad(180), 0),
	pet_chica_plush = CFrame.Angles(0, math.rad(180), 0),
	pet_freddy_plush = CFrame.Angles(0, math.rad(180), 0),
	pet_bonnie_plush = CFrame.Angles(0, math.rad(180), 0),
	pet_fredbear_plush = CFrame.new(),
	pet_huggy_wuggy = CFrame.new(),
}

local CARD_THUMBNAIL_DISTANCE_MULT: { [string]: number } = {
	pet_fredbear_plush = 2.8,
}

function Components.CreateViewportItemCard(parent: Instance, data): Frame
	local petEntry = (data and data.id and ItemCatalog.GetPet) and ItemCatalog.GetPet(data.id) or nil
	local isFNAFPet = petEntry and petEntry.collection == "FNAF"
	-- Hard rule: FNAF pets are always static-image cards (no ThumbnailRenderer).
	if isFNAFPet then
		local staticImage = data.image
		if staticImage == nil or staticImage == "" then
			staticImage = ItemCatalog.GetImage(petEntry)
		end
		local safeData = table.clone(data)
		safeData.image = staticImage or ""
		safeData.modelPath = nil
		if shouldLog("fnaf_static_components", 20) then
			print("[FNAFImages] Using static images (ThumbnailRenderer disabled for FNAF).")
		end
		return Components.CreateItemCard(parent, safeData)
	end

	-- ── Prefer explicit image (static screenshots with VFX baked in) ──
	-- If the catalog entry has an image, use CreateItemCard (ImageLabel) instead
	-- of the heavier 3D viewport path. This gives the best visual fidelity and
	-- eliminates the need for VFX proxy hacks.
	local hasExplicitImage = data.image and data.image ~= ""
	if hasExplicitImage then
		if shouldLog("components_static_image", 20) then
			print(string.format("[Components] STATIC image for %s", data.name or data.id or "?"))
		end
		return Components.CreateItemCard(parent, data)
	end

	-- Try to resolve the model for 3D rendering fallback
	local modelInstance = data.modelPath and resolveModelPath(data.modelPath) or nil
	local hasModel = modelInstance ~= nil

	-- If no model either, fall back to regular CreateItemCard
	if not hasModel then
		return Components.CreateItemCard(parent, data)
	end

	local rarityInfo = UIConfig.RarityInfo[data.rarity] or UIConfig.RarityInfo.Common
	local rarityColor = rarityInfo.color

	local card = Instance.new("Frame")
	card.Name = "Card_" .. (data.name or "Item")
	card.Size = UDim2.fromOffset(S.CardWidth, S.CardHeight)
	card.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
	card.BackgroundTransparency = 0
	card.BorderSizePixel = 0
	card.Parent = parent

	local cc = Instance.new("UICorner")
	cc.CornerRadius = UDim.new(0, S.CardCorner)
	cc.Parent = card

	local cStroke = Instance.new("UIStroke")
	cStroke.Color = data.locked and Color3.fromRGB(42, 45, 62) or rarityColor
	cStroke.Thickness = data.locked and 1.5 or 2.5
	cStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	cStroke.Transparency = data.locked and 0.4 or 0.1
	cStroke.Parent = card


	-- ── ViewportFrame for 3D model preview (no-image fallback only) ──
	local vpFrame = Instance.new("ViewportFrame")
	vpFrame.Name = "ModelPreview"
	vpFrame.Size = UDim2.new(1, -16, 0, 90)
	vpFrame.Position = UDim2.fromOffset(8, 8)
	vpFrame.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
	vpFrame.BackgroundTransparency = 0
	vpFrame.BorderSizePixel = 0
	vpFrame.Ambient = Color3.fromRGB(180, 180, 200)
	vpFrame.LightColor = Color3.fromRGB(255, 255, 255)
	vpFrame.LightDirection = Vector3.new(-1, -1, -1)
	vpFrame.Parent = card

	local vpCorner = Instance.new("UICorner")
	vpCorner.CornerRadius = UDim.new(0, 10)
	vpCorner.Parent = vpFrame

	-- Clone model into viewport (no VFX proxy — images with VFX are preferred)
	do
		local clone = cloneModelForViewport(modelInstance)
		resetModelPosition(clone)

		-- Per-item thumbnail yaw correction (only rotates specific items).
		local thumbYaw = CARD_THUMBNAIL_YAW[data.id or ""] or 0
		if thumbYaw ~= 0 then
			local rot = CFrame.Angles(0, math.rad(thumbYaw), 0)
			if clone:IsA("Model") then
				for _, d in ipairs(clone:GetDescendants()) do
					if d:IsA("BasePart") then
						d.CFrame = rot * d.CFrame
					end
				end
			elseif clone:IsA("BasePart") then
				clone.CFrame = rot * clone.CFrame
			end
		end

		local thumbOffset = CARD_THUMBNAIL_OFFSET_CFRAME[data.id or ""]
		if thumbOffset then
			if clone:IsA("Model") then
				for _, d in ipairs(clone:GetDescendants()) do
					if d:IsA("BasePart") then
						d.CFrame = thumbOffset * d.CFrame
					end
				end
			elseif clone:IsA("BasePart") then
				clone.CFrame = thumbOffset * clone.CFrame
			end
		end
		local distMult = CARD_THUMBNAIL_DISTANCE_MULT[data.id or ""] or 2.0
		if data.id == "pet_fredbear_plush" or data.id == "pet_huggy_wuggy" then
			print(string.format("[ThumbRender] pet=%s yaw=%d scale=%.2f",
				tostring(data.name or data.id),
				thumbYaw,
				distMult))
		end

		clone.Parent = vpFrame
		setupViewportCamera(vpFrame, clone, distMult)
	end

	if data.locked then
		-- Desaturate the viewport for locked items
		vpFrame.ImageColor3 = Color3.fromRGB(90, 90, 90)
		vpFrame.ImageTransparency = 0.15

		-- Semi-transparent dark overlay
		local lockOverlay = Instance.new("Frame")
		lockOverlay.Name = "LockOverlay"
		lockOverlay.Size = UDim2.fromScale(1, 1)
		lockOverlay.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
		lockOverlay.BackgroundTransparency = 0.55
		lockOverlay.BorderSizePixel = 0
		lockOverlay.ZIndex = 2
		lockOverlay.Parent = vpFrame
		local olCorner = Instance.new("UICorner")
		olCorner.CornerRadius = UDim.new(0, 10)
		olCorner.Parent = lockOverlay

		-- Lock icon on top
		local lockLabel = Instance.new("TextLabel")
		lockLabel.Size = UDim2.fromOffset(32, 32)
		lockLabel.AnchorPoint = Vector2.new(0.5, 0.5)
		lockLabel.Position = UDim2.fromScale(0.5, 0.5)
		lockLabel.BackgroundTransparency = 1
		lockLabel.Font = Enum.Font.GothamBold
		lockLabel.Text = ""
		lockLabel.TextColor3 = Color3.fromRGB(160, 165, 190)
		lockLabel.TextSize = 28
		lockLabel.ZIndex = 3
		lockLabel.Parent = vpFrame
	end

	-- Equipped badge
	if data.equipped then
		local check = Instance.new("TextLabel")
		check.Name = "Equipped"
		check.AnchorPoint = Vector2.new(1, 0)
		check.Position = UDim2.new(1, -4, 0, 4)
		check.Size = UDim2.fromOffset(26, 26)
		check.BackgroundColor3 = C.Green
		check.Font = Enum.Font.GothamBold
		check.Text = "\xe2\x9c\x93"
		check.TextColor3 = C.TextWhite
		check.TextSize = 15
		check.BorderSizePixel = 0
		check.ZIndex = 10
		check.Parent = card
		local chc = Instance.new("UICorner")
		chc.CornerRadius = UDim.new(1, 0)
		chc.Parent = check
	end

	-- Tag badge
	if data.tag and data.tag ~= "" then
		local tagBadge = Instance.new("TextLabel")
		tagBadge.Name = "Tag"
		tagBadge.AnchorPoint = Vector2.new(0.5, 0)
		tagBadge.Position = UDim2.new(0.5, 0, 0, -8)
		tagBadge.Size = UDim2.fromOffset(math.max(#data.tag * 8 + 18, 48), 22)
		tagBadge.BackgroundColor3 = C.Gold
		tagBadge.Font = Enum.Font.GothamBold
		tagBadge.TextColor3 = Color3.fromRGB(62, 40, 0)
		tagBadge.TextSize = 12
		tagBadge.Text = data.tag
		tagBadge.BorderSizePixel = 0
		tagBadge.ZIndex = 10
		tagBadge.Parent = card
		local tc = Instance.new("UICorner")
		tc.CornerRadius = UDim.new(0, 7)
		tc.Parent = tagBadge
	end

	-- Name label
	local nameLabel = Instance.new("TextLabel")
	nameLabel.Name = "ItemName"
	nameLabel.Size = UDim2.new(1, -10, 0, 18)
	nameLabel.Position = UDim2.new(0, 5, 0, 100)
	nameLabel.BackgroundTransparency = 1
	nameLabel.Font = Enum.Font.GothamBold
	nameLabel.TextColor3 = data.locked and Color3.fromRGB(130, 135, 155) or C.TextWhite
	nameLabel.TextSize = 12
	nameLabel.TextScaled = false
	nameLabel.TextWrapped = false
	nameLabel.TextTruncate = Enum.TextTruncate.AtEnd
	nameLabel.TextXAlignment = Enum.TextXAlignment.Center
	nameLabel.Text = data.name or "MISSING ITEM"
	nameLabel.Parent = card
	do
		local ns = Instance.new("UIStroke")
		ns.Color = Color3.fromRGB(0, 0, 0)
		ns.Thickness = 1.5
		ns.Transparency = 0.15
		ns.Parent = nameLabel
	end

	-- Rarity label
	local rarLabel = Instance.new("TextLabel")
	rarLabel.Name = "Rarity"
	rarLabel.Size = UDim2.new(1, -10, 0, 16)
	rarLabel.Position = UDim2.new(0, 5, 0, 119)
	rarLabel.BackgroundTransparency = 1
	rarLabel.Font = Enum.Font.GothamBold
	rarLabel.TextColor3 = data.locked and Color3.fromRGB(100, 105, 125) or rarityColor
	rarLabel.TextSize = 12
	rarLabel.TextXAlignment = Enum.TextXAlignment.Center
	rarLabel.Text = rarityInfo.label
	rarLabel.Parent = card

	-- Sub-label (e.g. "20 Wins", "Crown Crate", "Shop Only")
	if data.subLabel and data.subLabel ~= "" then
		local subLbl = Instance.new("TextLabel")
		subLbl.Name = "SubLabel"
		subLbl.Size = UDim2.new(1, -10, 0, 14)
		subLbl.Position = UDim2.new(0, 5, 0, 135)
		subLbl.BackgroundTransparency = 1
		subLbl.Font = Enum.Font.GothamBold
		subLbl.TextColor3 = data.locked and Color3.fromRGB(100, 105, 135) or C.TextMuted
		subLbl.TextSize = 11
		subLbl.TextXAlignment = Enum.TextXAlignment.Center
		subLbl.Text = data.subLabel
		subLbl.Parent = card
	end

	-- Action button
	if data.actionText and not data.locked then
		local btnColor = data.actionColor or C.BuyButton
		local btn = Instance.new("TextButton")
		btn.Name = "ActionBtn"
		btn.AnchorPoint = Vector2.new(0.5, 1)
		btn.Position = UDim2.new(0.5, 0, 1, -8)
		btn.Size = UDim2.new(1, -16, 0, 42)
		btn.BackgroundColor3 = btnColor
		btn.Font = Enum.Font.GothamBold
		btn.TextColor3 = C.TextWhite
		btn.TextSize = 15
		btn.Text = data.actionText
		btn.BorderSizePixel = 0
		btn.AutoButtonColor = false
		btn.Parent = card
		local bc = Instance.new("UICorner")
		bc.CornerRadius = UDim.new(0, S.SmBtnCorner)
		bc.Parent = btn

		local abr, abg, abb = btnColor.R, btnColor.G, btnColor.B
		local lighterAB = Color3.new(
			math.min(abr + 0.20, 1), math.min(abg + 0.20, 1), math.min(abb + 0.20, 1)
		)
		local darkerAB = Color3.new(
			math.max(abr - 0.10, 0), math.max(abg - 0.10, 0), math.max(abb - 0.10, 0)
		)
		local abGrad = Instance.new("UIGradient")
		abGrad.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, lighterAB),
			ColorSequenceKeypoint.new(0.5, btnColor),
			ColorSequenceKeypoint.new(1, darkerAB),
		})
		abGrad.Rotation = 90
		abGrad.Parent = btn

		local bs = Instance.new("UIStroke")
		bs.Color = Color3.fromRGB(255, 255, 255)
		bs.Thickness = 1.5
		bs.Transparency = 0.4
		bs.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		bs.Parent = btn

		if type(data.actionText) == "string" and string.find(string.upper(data.actionText), "ROBUX", 1, true) then
			local amount = string.match(string.upper(data.actionText), "(%d[%d,]*)%s*ROBUX")
			Components.ApplyRobuxBuyStyle(btn, amount)
		end

		AnimUtil.WireButton(btn, function()
			SoundUtil.Click()
			if data.onAction then data.onAction() end
		end)
	end

	return card
end

--- Create a small ViewportFrame thumbnail (for crate preview slots)
function Components.CreateViewportThumbnail(parent: Instance, modelPath: string, size: UDim2?, bgColor: Color3?, fallbackText: string?): ViewportFrame
	local vpFrame = Instance.new("ViewportFrame")
	vpFrame.Name = "Thumbnail"
	vpFrame.Size = size or UDim2.fromOffset(60, 60)
	vpFrame.BackgroundColor3 = bgColor or C.CardBgDark
	vpFrame.BackgroundTransparency = 0.2
	vpFrame.BorderSizePixel = 0
	vpFrame.Ambient = Color3.fromRGB(180, 180, 200)
	vpFrame.LightColor = Color3.fromRGB(255, 255, 255)
	vpFrame.LightDirection = Vector3.new(-1, -1, -1)
	vpFrame.Parent = parent

	local vpCorner = Instance.new("UICorner")
	vpCorner.CornerRadius = UDim.new(0, 8)
	vpCorner.Parent = vpFrame

	local modelInstance = resolveModelPath(modelPath)
	if modelInstance then
		local clone = cloneModelForViewport(modelInstance)
		resetModelPosition(clone)
		clone.Parent = vpFrame
		setupViewportCamera(vpFrame, clone)
	else
		-- Fallback: show text/emoji if model not found
		local fb = Instance.new("TextLabel")
		fb.Name = "Fallback"
		fb.Size = UDim2.fromScale(1, 1)
		fb.BackgroundTransparency = 1
		fb.Font = Enum.Font.GothamBold
		fb.Text = fallbackText or "?"
		fb.TextColor3 = C.TextMuted
		fb.TextSize = 24
		fb.TextXAlignment = Enum.TextXAlignment.Center
		fb.TextYAlignment = Enum.TextYAlignment.Center
		fb.Parent = vpFrame
	end

	return vpFrame
end

-- ═══════════════════════════════════════════════════════════════════
-- RESPONSIVE SCALE  (viewport-adaptive UIScale on ScreenGuis)
-- Width-only baseline so PC (1920) stays at scale 1.0.
-- Mobile touch devices get a slight boost so tap targets remain large.
-- ═══════════════════════════════════════════════════════════════════

function Components.SetupResponsiveScale(screenGui: ScreenGui)
	local existing = screenGui:FindFirstChild("ResponsiveScale")
	if existing then return end
	local uiScale = Instance.new("UIScale")
	uiScale.Name = "ResponsiveScale"
	uiScale.Scale = 1
	uiScale.Parent = screenGui
end

return Components
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="146">
            <Properties>
              <string name="Name">CrateRevealUI</string>
              <string name="Source"><![CDATA[--[[
	CrateRevealUI
	Thin wrapper around RewardPopup (sibling in Client.UI folder).
	Preserves existing API so CrateShopPanel doesn't need changes.

	API:
	  CrateRevealUI.Init(screenGui)      -- no-op
	  CrateRevealUI.ShowReward(data)      -- single reward → RewardPopup.Show
	  CrateRevealUI.ShowRewards(items)    -- batch rewards → RewardPopup.ShowBatch

	Used by: CrateShopPanel
]]

local RewardPopup = nil
pcall(function()
	RewardPopup = require(script.Parent:WaitForChild("RewardPopup", 5))
end)

if not RewardPopup then
	warn("[CrateRevealUI] RewardPopup module not found in Client.UI — crate reveal disabled")
end

local CrateRevealUI = {}

function CrateRevealUI.Init(_screenGui)
	-- No-op: RewardPopup creates its own ScreenGui
end

function CrateRevealUI.ShowReward(data)
	if not data then return end
	if not RewardPopup then
		warn("[CrateRevealUI] RewardPopup not available")
		return
	end
	RewardPopup.Show({
		icon       = data.image or "",
		title      = "YOU WON!",
		name       = data.name or "MISSING ITEM",
		rarityText = data.rarity or "Common",
		okText     = "CLAIM",
		onDismiss  = nil,
		itemId     = data.itemId or "",
		itemType   = data.itemType or "",
		category   = data.category or "",
		iconText   = data.iconText or "",
		iconColor  = data.iconColor,
	})
end

-- Batch reveal for multi-crate purchases (3 or 6 crates)
function CrateRevealUI.ShowRewards(items)
	if not items or #items == 0 then return end
	if not RewardPopup then
		warn("[CrateRevealUI] RewardPopup not available")
		return
	end

	local mapped = {}
	for _, data in ipairs(items) do
		table.insert(mapped, {
			icon       = data.image or "",
			title      = "YOU WON!",
			name       = data.name or "MISSING ITEM",
			rarityText = data.rarity or "Common",
			itemId     = data.itemId or "",
			itemType   = data.itemType or "",
			category   = data.category or "",
			iconText   = data.iconText or "",
			iconColor  = data.iconColor,
			isDuplicate = data.isDuplicate or false,
		})
	end

	RewardPopup.ShowBatch(mapped)
end

return CrateRevealUI
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="147">
            <Properties>
              <string name="Name">CrateShopPanel</string>
              <string name="Source"><![CDATA[--[[
	CrateShopPanel
	Lobby crate shop UI — redesigned with 4 crate sections:
	  • Crown Crate (purple) — all Findable crowns
	  • Common Crate (green) — Common pets
	  • Rare Crate (blue) — Rare pets
	  • Epic Crate (purple) — Epic pets

	Each section shows:
	  • Left: Big ViewportFrame showing a representative model
	  • Right-top: All preview thumbnails with item names + drop % (horizontal scroll)
	  • Right-bottom: 3 buy buttons

	Reward popups are shown only from server-confirmed RewardGranted events.

	Used by: UIController (walk-up proximity or OpenCrateShop RemoteEvent)
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local MarketplaceService = game:GetService("MarketplaceService")

local Shared = ReplicatedStorage:WaitForChild("Shared", 60)
if not Shared then
	warn("[CrateShopPanel] Shared not found after 60s -- disabled")
	return { Init = function() end, Show = function() end, Hide = function() end,
		IsVisible = function() return false end, Toggle = function() end }
end

local CDPModule = Shared:WaitForChild("ClientDepsProvider", 60)
if not CDPModule then
	warn("[CrateShopPanel] ClientDepsProvider MISSING")
	return { Init = function() end, Show = function() end, Hide = function() end,
		IsVisible = function() return false end, Toggle = function() end }
end

local ok, Deps = pcall(require, CDPModule)
if not ok or not Deps then
	warn("[CrateShopPanel] require(ClientDepsProvider) FAILED:", Deps)
	return { Init = function() end, Show = function() end, Hide = function() end,
		IsVisible = function() return false end, Toggle = function() end }
end
local UIConfig = Deps.UIConfig
local ItemCatalog = Deps.ItemCatalog

local Client = script.Parent
local AnimUtil          = require(Client:WaitForChild("AnimUtil"))
local SoundUtil         = require(Client:WaitForChild("SoundUtil"))
local Components        = require(Client:WaitForChild("Components"))
local ThumbnailRenderer = require(Client:WaitForChild("ThumbnailRenderer"))

-- Lazy-load CrateRevealUI (created in same folder)
local _CrateRevealUI = nil
local function getRevealUI()
	if _CrateRevealUI then return _CrateRevealUI end
	local mod = Client:FindFirstChild("CrateRevealUI")
	if mod then
		local okReq, result = pcall(require, mod)
		if okReq then _CrateRevealUI = result end
	end
	return _CrateRevealUI
end

local C = UIConfig.Colors
local S = UIConfig.Sizes
local ROBUX_ICON_IMAGE = "rbxassetid://138917867019056"

local canvas: CanvasGroup = nil
local uiScale: UIScale = nil
local overlay: Frame = nil
local visible = false
local closeCallback: (() -> ())? = nil
local _inventoryUpdatedConn: RBXScriptConnection? = nil
local _crateCountLabels: { [string]: TextLabel } = {}
local _crateCounts: { [string]: number } = {}
local _pendingRobuxCrateBuys: { [string]: number } = {}
local _pendingRobuxCrateBuyExpiresAt: { [string]: number } = {}
local _buyOpenBusyByCrate: { [string]: boolean } = {}

local CrateShopPanel = {}

-- ═══════════════════════════════════════════════════════════════════
-- HELPERS
-- ═══════════════════════════════════════════════════════════════════

local function getOpenCrateFunc(): RemoteFunction?
	local remotes = ReplicatedStorage:FindFirstChild("Remotes")
	if not remotes then return nil end
	return remotes:FindFirstChild("OpenCrate")
end

local function getBuyCrateFunc(): RemoteFunction?
	local remotes = ReplicatedStorage:FindFirstChild("Remotes")
	if not remotes then return nil end
	return remotes:FindFirstChild("BuyCrate")
end

local function getOwnedCratesFunc(): RemoteFunction?
	local remotes = ReplicatedStorage:FindFirstChild("Remotes")
	if not remotes then return nil end
	return remotes:FindFirstChild("GetOwnedCrates")
end

local function getOpenOwnedCratesFunc(): RemoteFunction?
	local remotes = ReplicatedStorage:FindFirstChild("Remotes")
	if not remotes then return nil end
	return remotes:FindFirstChild("OpenOwnedCrates")
end

local function showToast(msg: string, okStyle: boolean?)
	if not canvas then return end
	local toast = Instance.new("TextLabel")
	toast.Name = "CrateToast"
	toast.AnchorPoint = Vector2.new(0.5, 0)
	toast.Position = UDim2.new(0.5, 0, 0, 10)
	toast.Size = UDim2.new(0.75, 0, 0, 30)
	toast.BackgroundColor3 = okStyle and Color3.fromRGB(40, 145, 75) or Color3.fromRGB(145, 45, 45)
	toast.BackgroundTransparency = 0.1
	toast.BorderSizePixel = 0
	toast.Font = Enum.Font.GothamBold
	toast.Text = msg
	toast.TextColor3 = Color3.fromRGB(255, 255, 255)
	toast.TextSize = 14
	toast.ZIndex = 200
	toast.Parent = canvas
	Instance.new("UICorner", toast).CornerRadius = UDim.new(0, 8)
	task.delay(2.2, function()
		if toast and toast.Parent then
			toast:Destroy()
		end
	end)
end

local function updateCrateCountLabel(crateId: string, count: number)
	_crateCounts[crateId] = count
	local lbl = _crateCountLabels[crateId]
	if lbl and lbl.Parent then
		lbl.Text = string.format("Owned: %d", math.max(0, math.floor(count)))
	end
end

local function getCrateDisplayName(crateId: string): string
	for _, crate in ipairs(UIConfig.MockCrates or {}) do
		if crate.id == crateId then
			return tostring(crate.name or crateId)
		end
	end
	local stripped = string.gsub(tostring(crateId or "Crate"), "^crate_", "")
	stripped = string.gsub(stripped, "_", " ")
	local titled = string.gsub(stripped, "(%a)([%w_]*)", function(first, rest)
		return string.upper(first) .. string.lower(rest)
	end)
	return titled .. " Crate"
end

local function pluralizeCrateName(displayName: string, qty: number): string
	if qty == 1 then
		return displayName
	end
	if string.sub(displayName, -5) == "Crate" then
		return string.sub(displayName, 1, -2) .. "s"
	end
	return displayName .. "s"
end

local function formatCratePurchaseToast(crateId: string, qty: number, ownedCount: number?): string
	local n = math.max(1, math.floor(tonumber(qty) or 1))
	local name = pluralizeCrateName(getCrateDisplayName(crateId), n)
	local msg = string.format("Purchased %d %s", n, name)
	if ownedCount ~= nil then
		msg = string.format("%s (Owned: %d)", msg, math.max(0, math.floor(ownedCount)))
	end
	return msg
end

--- Get random preview items for a crate from its drop table
local function getPreviewItems(crateId: string, count: number): { any }
	-- Find the MockCrates entry for this crateId
	for _, crate in ipairs(UIConfig.MockCrates) do
		if crate.id == crateId and crate.drops then
			local drops = {}
			for _, d in ipairs(crate.drops) do
				table.insert(drops, d)
			end
			-- Shuffle
			for i = #drops, 2, -1 do
				local j = math.random(1, i)
				drops[i], drops[j] = drops[j], drops[i]
			end
			local result = {}
			for i = 1, math.min(count, #drops) do
				table.insert(result, drops[i])
			end
			return result
		end
	end
	return {}
end

local function showCrateRewards(results)
	local revealUI = getRevealUI()
	if not revealUI then
		return false
	end
	local rawCount = type(results) == "table" and #results or 0
	local revealItems = {}
	for _, r in ipairs(results or {}) do
		if type(r) ~= "table" then
			continue
		end
		if tostring(r.itemId or "") == "" then
			continue
		end
		local entry = ItemCatalog.Get(r.category, r.itemId)
		table.insert(revealItems, {
			name = entry and entry.name or r.itemId,
			rarity = entry and entry.rarity or "Common",
			modelPath = entry and entry.modelPath,
			iconColor = entry and entry.iconColor,
			isDuplicate = r.isDuplicate or false,
			itemId = r.itemId,
			category = r.category,
			itemType = entry and entry.type or "",
			iconText = entry and entry.iconText or "",
			image = entry and entry.image or "",
		})
	end
	print(string.format(
		"[CrateUIAudit] rewardsRaw=%d rewardsDisplayed=%d",
		rawCount,
		#revealItems
	))
	if #revealItems > 1 and revealUI.ShowRewards then
		revealUI.ShowRewards(revealItems)
		return true
	elseif #revealItems == 1 and revealUI.ShowReward then
		revealUI.ShowReward(revealItems[1])
		return true
	end
	return false
end

local function openPurchasedCrates(crateId: string, qty: number): boolean
	local openOwned = getOpenOwnedCratesFunc()
	if not openOwned then
		warn("[CrateShop] OpenOwnedCrates RemoteFunction not found")
		return false
	end
	local ok, result = pcall(openOwned.InvokeServer, openOwned, crateId, qty)
	if not ok or not result or not result.success then
		warn("[CrateShop] OpenOwnedCrates failed:", ok and (result.error or result.reason) or result)
		return false
	end
	if type(result.newCount) == "number" then
		updateCrateCountLabel(crateId, result.newCount)
	end
	local rewardsCount = type(result.results) == "table" and #result.results or 0
	print(string.format(
		"[CrateUIAudit] crateType=%s qtyRequested=%d rewardsReturned=%d",
		crateId,
		qty,
		rewardsCount
	))
	print(string.format("[CrateUI] ShowingRewardModal crateType=%s qty=%d", crateId, qty))
	return showCrateRewards(result.results)
end

-- ═══════════════════════════════════════════════════════════════════
-- CRATE SECTION BUILDER
-- ═══════════════════════════════════════════════════════════════════

local function createCrateSection(parent: ScrollingFrame, crateData: { [string]: any }, layoutOrder: number)
	local accent = crateData.accentColor or crateData.iconColor

	local section = Instance.new("Frame")
	section.Name = "Crate_" .. crateData.id
	section.Size = UDim2.new(1, -20, 0, 230)
	section.BackgroundColor3 = C.CardBg
	section.BorderSizePixel = 0
	section.LayoutOrder = layoutOrder
	section.Parent = parent

	local sc = Instance.new("UICorner")
	sc.CornerRadius = UDim.new(0, S.CardCorner)
	sc.Parent = section

	local ss = Instance.new("UIStroke")
	ss.Color = accent
	ss.Thickness = 2.5
	ss.Transparency = 0.12
	ss.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	ss.Parent = section

	-- Colored left bar accent
	local leftBar = Instance.new("Frame")
	leftBar.Name = "AccentBar"
	leftBar.Size = UDim2.new(0, 4, 1, -8)
	leftBar.Position = UDim2.fromOffset(2, 4)
	leftBar.BackgroundColor3 = accent
	leftBar.BorderSizePixel = 0
	leftBar.Parent = section
	local lbc = Instance.new("UICorner")
	lbc.CornerRadius = UDim.new(0, 2)
	lbc.Parent = leftBar

	-- ── Left: Big model preview ──
	local bigPreview = Instance.new("Frame")
	bigPreview.Name = "BigPreview"
	bigPreview.Size = UDim2.new(0, 120, 1, -14)
	bigPreview.Position = UDim2.fromOffset(12, 7)
	bigPreview.BackgroundColor3 = crateData.iconColor
	bigPreview.BorderSizePixel = 0
	bigPreview.Parent = section

	local bpc = Instance.new("UICorner")
	bpc.CornerRadius = UDim.new(0, 14)
	bpc.Parent = bigPreview

	local bps = Instance.new("UIStroke")
	bps.Color = Color3.fromRGB(255, 255, 255)
	bps.Thickness = 1.5
	bps.Transparency = 0.5
	bps.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	bps.Parent = bigPreview

	-- All drops for this crate (show every item, no limit)
	local allDrops = crateData.drops or {}
	print(string.format("[CrateShop] %s: %d items to display", crateData.name, #allDrops))

	-- Big preview: show crate box representation (not a random drop item)
	do
		local crateModelPath = crateData.modelPath
		local rendered = false
		if crateModelPath and crateModelPath ~= "" then
			local vp = Components.CreateViewportThumbnail(
				bigPreview,
				crateModelPath,
				UDim2.new(1, -8, 0, 120),
				crateData.iconColor, "")
			vp.Position = UDim2.fromOffset(4, 10)
			vp.BackgroundTransparency = 1
			rendered = ThumbnailRenderer.RenderItemToViewport(vp, { modelPath = crateModelPath })
		end
		if not rendered then
			local crateImg = Instance.new("ImageLabel")
			crateImg.Name = "CrateImage"
			crateImg.AnchorPoint = Vector2.new(0.5, 0)
			crateImg.Size = UDim2.new(0.78, 0, 0, 84)
			crateImg.Position = UDim2.new(0.5, 0, 0, 14)
			crateImg.BackgroundTransparency = 1
			crateImg.Image = "rbxassetid://102125624504903"
			crateImg.ScaleType = Enum.ScaleType.Fit
			crateImg.ImageTransparency = 0
			crateImg.ZIndex = 2
			crateImg.Parent = bigPreview
		end
	end

	-- Crate name under big preview
	local crateName = Instance.new("TextLabel")
	crateName.Name = "Name"
	crateName.AnchorPoint = Vector2.new(0.5, 1)
	crateName.Position = UDim2.new(0.5, 0, 1, -8)
	crateName.Size = UDim2.new(1, -8, 0, 34)
	crateName.BackgroundTransparency = 1
	crateName.Font = Enum.Font.GothamBold
	crateName.TextColor3 = C.TextWhite
	crateName.TextSize = 14
	crateName.Text = crateData.name
	crateName.TextWrapped = true
	crateName.Parent = bigPreview
	local cns = Instance.new("UIStroke")
	cns.Color = Color3.fromRGB(0, 0, 0)
	cns.Thickness = 1.5
	cns.Transparency = 0.22
	cns.Parent = crateName

	-- ── Right side: Title ──
	local titleR = Instance.new("TextLabel")
	titleR.Name = "Title"
	titleR.Size = UDim2.new(1, -155, 0, 24)
	titleR.Position = UDim2.fromOffset(143, 8)
	titleR.BackgroundTransparency = 1
	titleR.Font = Enum.Font.GothamBold
	titleR.TextColor3 = C.TextWhite
	titleR.TextSize = 18
	titleR.TextXAlignment = Enum.TextXAlignment.Left
	titleR.Text = crateData.name
	titleR.Parent = section
	local trs = Instance.new("UIStroke")
	trs.Color = Color3.fromRGB(0, 0, 0)
	trs.Thickness = 1.5
	trs.Transparency = 0.22
	trs.Parent = titleR

	-- ── Right: Preview thumbnails row (horizontal scroll) ──
	local thumbRow = Instance.new("ScrollingFrame")
	thumbRow.Name = "Thumbnails"
	thumbRow.Size = UDim2.new(1, -155, 0, 104)
	thumbRow.Position = UDim2.fromOffset(143, 32)
	thumbRow.BackgroundTransparency = 1
	thumbRow.BorderSizePixel = 0
	thumbRow.ScrollingDirection = Enum.ScrollingDirection.X
	thumbRow.ScrollBarThickness = 4
	thumbRow.ScrollBarImageColor3 = Color3.fromRGB(180, 180, 180)
	thumbRow.ScrollBarImageTransparency = 0.3
	thumbRow.AutomaticCanvasSize = Enum.AutomaticSize.X
	thumbRow.CanvasSize = UDim2.fromScale(0, 0)
	thumbRow.Parent = section

	local thumbLayout = Instance.new("UIListLayout")
	thumbLayout.FillDirection = Enum.FillDirection.Horizontal
	thumbLayout.Padding = UDim.new(0, 6)
	thumbLayout.SortOrder = Enum.SortOrder.LayoutOrder
	thumbLayout.VerticalAlignment = Enum.VerticalAlignment.Top
	thumbLayout.Parent = thumbRow

	-- Compute total chances for percentage display
	local totalChance = 0
	for _, drop in ipairs(allDrops) do
		totalChance = totalChance + (drop.chance or 0)
	end

	local cardsCreated = 0
	for i, item in ipairs(allDrops) do
		local thumbContainer = Instance.new("Frame")
		thumbContainer.Name = "Thumb" .. i
		thumbContainer.Size = UDim2.fromOffset(68, 96)
		thumbContainer.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
		thumbContainer.BackgroundTransparency = 0
		thumbContainer.BorderSizePixel = 0
		thumbContainer.LayoutOrder = i
		thumbContainer.Parent = thumbRow
		Instance.new("UICorner", thumbContainer).CornerRadius = UDim.new(0, 6)

		-- THUMBNAIL_RENDERER_RULES:
		-- 1) explicit image -> STATIC
		-- 2) no explicit image -> ThumbnailRenderer
		local staticImage = ""
		local rendererKey = item.modelPath
		local itemType = if crateData.id == "crate_crown" then "CROWN" else "PET"
		if item.itemId and type(item.itemId) == "string" and string.match(item.itemId, "^crown_") then
			itemType = "CROWN"
		end
		if ItemCatalog.ResolveCrownOrPetImage and item.itemId then
			local resolved = ItemCatalog.ResolveCrownOrPetImage(item.itemId, itemType)
			if resolved and resolved.mode == "STATIC" then
				staticImage = resolved.image or ""
			elseif resolved and resolved.mode == "RENDERER" then
				rendererKey = resolved.rendererKey or rendererKey
			end
		end
		if staticImage == "" and type(item.image) == "string" and item.image ~= "" then
			staticImage = item.image
		end

		if staticImage ~= "" then
			local imgLbl = Instance.new("ImageLabel")
			imgLbl.Name = "ThumbImage"
			imgLbl.Position = UDim2.fromOffset(4, 0)
			imgLbl.Size = UDim2.fromOffset(60, 52)
			imgLbl.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
			imgLbl.BackgroundTransparency = 0
			imgLbl.BorderSizePixel = 0
			imgLbl.Image = staticImage
			imgLbl.ScaleType = Enum.ScaleType.Fit
			imgLbl.ZIndex = 3
			imgLbl.Parent = thumbContainer
			Instance.new("UICorner", imgLbl).CornerRadius = UDim.new(0, 6)
		elseif rendererKey and rendererKey ~= "" then
			local vp = Components.CreateViewportThumbnail(
				thumbContainer,
				rendererKey,
				UDim2.fromOffset(60, 52),
				Color3.fromRGB(0, 0, 0),
				item.name and string.sub(item.name, 1, 2) or "?"
			)
			vp.Position = UDim2.fromOffset(4, 0)
			ThumbnailRenderer.RenderItemToViewport(vp, {
				id = item.itemId,
				name = item.name,
				type = itemType,
				modelPath = rendererKey,
				rarity = item.rarity,
			})
		end

		-- Item name label (truncated)
		local nameLbl = Instance.new("TextLabel")
		nameLbl.Size = UDim2.new(1, 0, 0, 14)
		nameLbl.Position = UDim2.fromOffset(0, 54)
		nameLbl.BackgroundTransparency = 1
		nameLbl.Font = Enum.Font.GothamBold
		nameLbl.TextColor3 = C.TextWhite
		nameLbl.TextSize = 9
		nameLbl.Text = item.name or "MISSING ITEM"
		nameLbl.TextTruncate = Enum.TextTruncate.AtEnd
		nameLbl.TextXAlignment = Enum.TextXAlignment.Center
		nameLbl.Parent = thumbContainer

		-- Drop chance label
		local chancePercent = 0
		if totalChance > 0 and item.chance then
			chancePercent = item.chance
		end

		local rarColor = ItemCatalog.GetRarityColor(item.rarity)
		local chanceLbl = Instance.new("TextLabel")
		chanceLbl.Size = UDim2.new(1, 0, 0, 14)
		chanceLbl.Position = UDim2.fromOffset(0, 68)
		chanceLbl.BackgroundTransparency = 1
		chanceLbl.Font = Enum.Font.GothamBold
		chanceLbl.TextColor3 = rarColor or C.TextMuted
		chanceLbl.TextSize = 11
		chanceLbl.Text = string.format("%d%%", chancePercent)
		chanceLbl.TextXAlignment = Enum.TextXAlignment.Center
		chanceLbl.Parent = thumbContainer

		-- Rarity label
		local rarLbl = Instance.new("TextLabel")
		rarLbl.Size = UDim2.new(1, 0, 0, 12)
		rarLbl.Position = UDim2.fromOffset(0, 82)
		rarLbl.BackgroundTransparency = 1
		rarLbl.Font = Enum.Font.Gotham
		rarLbl.TextColor3 = rarColor or C.TextMuted
		rarLbl.TextSize = 9
		rarLbl.Text = item.rarity or ""
		rarLbl.TextXAlignment = Enum.TextXAlignment.Center
		rarLbl.Parent = thumbContainer
		cardsCreated += 1
	end
	print(string.format("[CrateShop] %s: %d cards created", crateData.name, cardsCreated))

	-- ── Buy buttons row ──
	local btnRow = Instance.new("Frame")
	btnRow.Name = "BuyButtons"
	btnRow.AnchorPoint = Vector2.new(0, 1)
	btnRow.Position = UDim2.new(0, 143, 1, -10)
	btnRow.Size = UDim2.new(1, -155, 0, 54)
	btnRow.BackgroundTransparency = 1
	btnRow.BorderSizePixel = 0
	btnRow.Parent = section

	local bLayout = Instance.new("UIListLayout")
	bLayout.FillDirection = Enum.FillDirection.Horizontal
	bLayout.Padding = UDim.new(0, 8)
	bLayout.SortOrder = Enum.SortOrder.LayoutOrder
	bLayout.VerticalAlignment = Enum.VerticalAlignment.Bottom
	bLayout.Parent = btnRow

	for pi, price in ipairs(crateData.prices) do
		local isRobux = price.currency == "Robux"
		local priceText = isRobux and string.format("%d ROBUX", price.cost) or string.format("F %d", price.cost)
		local btnColor = isRobux and C.RobuxButton or C.BuyButton

		local pBtn = Instance.new("TextButton")
		pBtn.Name = "Price" .. pi
		pBtn.Size = UDim2.fromOffset(105, 50)
		pBtn.BackgroundColor3 = btnColor
		pBtn.Font = Enum.Font.GothamBlack
		pBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
		pBtn.TextSize = 14
		pBtn.Text = priceText .. "\n" .. price.label
		pBtn.TextYAlignment = Enum.TextYAlignment.Center
		pBtn.BorderSizePixel = 0
		pBtn.AutoButtonColor = false
		pBtn.LayoutOrder = pi
		pBtn.Parent = btnRow

		local pbc = Instance.new("UICorner")
		pbc.CornerRadius = UDim.new(0, S.SmBtnCorner)
		pbc.Parent = pBtn

		-- Gradient
		local br, bg, bb = btnColor.R, btnColor.G, btnColor.B
		local pbGrad = Instance.new("UIGradient")
		pbGrad.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.new(math.min(br+0.2,1), math.min(bg+0.2,1), math.min(bb+0.2,1))),
			ColorSequenceKeypoint.new(0.5, btnColor),
			ColorSequenceKeypoint.new(1, Color3.new(math.max(br-0.12,0), math.max(bg-0.12,0), math.max(bb-0.12,0))),
		})
		pbGrad.Rotation = 90
		pbGrad.Parent = pBtn

		local pbs = Instance.new("UIStroke")
		pbs.Color = Color3.fromRGB(0, 0, 0)
		pbs.Thickness = 1.75
		pbs.Transparency = 0.05
		pbs.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
		pbs.Parent = pBtn

		if isRobux then
			Components.ApplyRobuxBuyStyle(pBtn, tostring(price.cost), ROBUX_ICON_IMAGE, tostring(price.label or ""))
		end

		-- Determine quantity from label
		local qty = tonumber(string.match(price.label, "(%d+)")) or 1

		AnimUtil.WireButton(pBtn, function()
			SoundUtil.Click()
			print(string.format("[CrateShopUI] Click buy crateType=%s qty=%d currency=%s",
				tostring(crateData.id), qty, isRobux and "Robux" or "F"))

			if isRobux then
				if price.productId and price.productId > 0 then
					_pendingRobuxCrateBuys[crateData.id] = (_pendingRobuxCrateBuys[crateData.id] or 0) + qty
					_pendingRobuxCrateBuyExpiresAt[crateData.id] = os.clock() + 45
					MarketplaceService:PromptProductPurchase(Players.LocalPlayer, price.productId)
				else
					print(string.format("[CrateShop] Robux purchase: %s — %s (no productId)", crateData.name, price.label))
				end
				return
			end

			-- Validate crate ID exists in catalog before firing remote
			if not ItemCatalog.Crates or not ItemCatalog.Crates[crateData.id] then
				warn("[CrateShop] Crate not configured:", crateData.id)
				return
			end

			local buyCrate = getBuyCrateFunc()
			if not buyCrate then
				warn("[CrateShop] BuyCrate RemoteFunction not found")
				return
			end

			local result = buyCrate:InvokeServer(crateData.id, qty, "Coins")
			if result and result.success then
				local newCount = tonumber(result.newCount) or (_crateCounts[crateData.id] or 0)
				if _buyOpenBusyByCrate[crateData.id] then
					return
				end
				_buyOpenBusyByCrate[crateData.id] = true
				local opened = openPurchasedCrates(crateData.id, qty)
				_buyOpenBusyByCrate[crateData.id] = nil
				if not opened then
					-- Keep the crate balance accurate if auto-open fails after purchase.
					updateCrateCountLabel(crateData.id, newCount)
					showToast(formatCratePurchaseToast(crateData.id, qty, newCount), true)
				end
			elseif result then
				if tostring(result.reason) == "INSUFFICIENT_FUNDS" then
					showToast("Not enough Fate Coins", false)
				else
					showToast("Purchase failed", false)
				end
				warn("[CrateShop] Failed:", result.error or result.reason or "unknown")
			end
		end)
	end

	return section
end

-- ═══════════════════════════════════════════════════════════════════
-- PANEL LIFECYCLE
-- ═══════════════════════════════════════════════════════════════════

function CrateShopPanel.Init(screenGui: ScreenGui, onClose: () -> ())
	closeCallback = onClose
	_crateCountLabels = {}
	_crateCounts = {}
	_pendingRobuxCrateBuys = {}
	_pendingRobuxCrateBuyExpiresAt = {}
	_buyOpenBusyByCrate = {}

	overlay = Components.CreateDimOverlay(screenGui, function()
		CrateShopPanel.Hide()
	end)

	local content, closeBtn
	canvas, uiScale, content, closeBtn = Components.CreatePanel(screenGui, "CRATE SHOP", C.HeaderCrate, "Crate")

	closeBtn.MouseButton1Click:Connect(function()
		SoundUtil.Close()
		CrateShopPanel.Hide()
	end)

	-- Override stud texture to Fate Beams asset (only this panel)
	do
		local stud = canvas:FindFirstChild("StudTexture")
		if stud then
			stud.Image = "rbxassetid://84772207963553"
			stud.TileSize = UDim2.fromOffset(96, 96)
			stud.ImageTransparency = 0.88
			stud.ImageColor3 = Color3.fromRGB(255, 255, 255)
		end
	end

	Components.AddListLayout(content, 16)

	do
		local getOwned = getOwnedCratesFunc()
		if getOwned then
			local ok, counts = pcall(getOwned.InvokeServer, getOwned)
			if ok and type(counts) == "table" then
				for crateId, n in pairs(counts) do
					_crateCounts[crateId] = tonumber(n) or 0
				end
			end
		end
	end

	-- Build crate sections from UIConfig.MockCrates (now has 4 entries)
	for i, crate in ipairs(UIConfig.MockCrates) do
		createCrateSection(content, crate, i)
	end

	if not _inventoryUpdatedConn then
		task.spawn(function()
			local remotes = ReplicatedStorage:WaitForChild("Remotes", 10)
			local invUpdate = remotes and remotes:FindFirstChild("InventoryUpdated")
			if invUpdate and invUpdate:IsA("RemoteEvent") then
				_inventoryUpdatedConn = invUpdate.OnClientEvent:Connect(function(reason, data)
					if reason == "CrateBalance" and type(data) == "table" then
						if type(data.counts) == "table" then
							for crateId, n in pairs(data.counts) do
								updateCrateCountLabel(crateId, tonumber(n) or 0)
							end
						elseif type(data.crateId) == "string" then
							updateCrateCountLabel(data.crateId, tonumber(data.newCount) or 0)
						end
						if visible and tonumber(data.qty) and tonumber(data.qty) > 0 and type(data.crateId) == "string" then
							local pending = tonumber(_pendingRobuxCrateBuys[data.crateId]) or 0
							local expiresAt = tonumber(_pendingRobuxCrateBuyExpiresAt[data.crateId]) or 0
							if pending > 0 and os.clock() <= expiresAt then
								local qty = tonumber(data.qty) or 1
								_pendingRobuxCrateBuys[data.crateId] = math.max(0, pending - qty)
								if _pendingRobuxCrateBuys[data.crateId] <= 0 then
									_pendingRobuxCrateBuyExpiresAt[data.crateId] = nil
								end
								if not _buyOpenBusyByCrate[data.crateId] then
									_buyOpenBusyByCrate[data.crateId] = true
									local opened = openPurchasedCrates(data.crateId, qty)
									_buyOpenBusyByCrate[data.crateId] = nil
									if not opened then
										showToast(formatCratePurchaseToast(data.crateId, qty, tonumber(data.newCount)), true)
									end
								end
							end
						end
					end
				end)
			end
		end)
	end
end

function CrateShopPanel.Show()
	if visible then return end
	visible = true
	overlay.Visible = true
	SoundUtil.Open()
	AnimUtil.OpenPanel(canvas, uiScale)
end

function CrateShopPanel.Hide()
	if not visible then return end
	visible = false
	overlay.Visible = false
	local t = AnimUtil.ClosePanel(canvas, uiScale)
	task.spawn(function()
		t.Completed:Wait()
		canvas.Visible = false
	end)
	if closeCallback then closeCallback() end
end

function CrateShopPanel.IsVisible(): boolean
	return visible
end

function CrateShopPanel.Toggle()
	if visible then CrateShopPanel.Hide() else CrateShopPanel.Show() end
end

return CrateShopPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="148">
            <Properties>
              <string name="Name">CustomSwordComingSoonPanel</string>
              <string name="Source"><![CDATA[--[[
	CustomSwordComingSoonPanel
	Purple coming-soon modal for the CustomSwords lobby interaction.

	API:
	  Init(screenGui, onClose)
	  Show() / Hide() / IsVisible() / Toggle()
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared", 60)
if not Shared then
	warn("[CustomSwordComingSoonPanel] Shared not found")
	return {
		Init = function() end,
		Show = function() end,
		Hide = function() end,
		IsVisible = function() return false end,
		Toggle = function() end,
	}
end

local ok, Deps = pcall(require, Shared:WaitForChild("ClientDepsProvider", 60))
if not ok or not Deps then
	warn("[CustomSwordComingSoonPanel] ClientDepsProvider failed:", Deps)
	return {
		Init = function() end,
		Show = function() end,
		Hide = function() end,
		IsVisible = function() return false end,
		Toggle = function() end,
	}
end

local Client = script.Parent
local AnimUtil = require(Client:WaitForChild("AnimUtil"))
local SoundUtil = require(Client:WaitForChild("SoundUtil"))

local CustomSwordComingSoonPanel = {}

local HEADER_COLOR = Color3.fromRGB(140, 74, 220)
local HEADER_TOP = Color3.fromRGB(198, 128, 255)
local HEADER_BOT = Color3.fromRGB(88, 44, 156)
local INNER_BG = Color3.fromRGB(20, 10, 34)
local CARD_BG = Color3.fromRGB(34, 18, 58)
local CARD_TOP = Color3.fromRGB(72, 40, 120)
local CARD_BOT = Color3.fromRGB(24, 12, 40)
local CARD_STROKE = Color3.fromRGB(206, 164, 255)
local MESSAGE_COLOR = Color3.fromRGB(236, 215, 255)
local TEXT_WHITE = Color3.fromRGB(255, 255, 255)
local TEXT_MUTED = Color3.fromRGB(202, 184, 226)
local CLOSE_COLOR = Color3.fromRGB(110, 52, 170)

local canvas: CanvasGroup? = nil
local uiScale: UIScale? = nil
local overlay: Frame? = nil
local visible = false
local initialized = false
local closeCallback = nil

local function buildPanel(parent: Instance)
	canvas = Instance.new("CanvasGroup")
	canvas.Name = "CustomSwordComingSoonPanel"
	canvas.AnchorPoint = Vector2.new(0.5, 0.5)
	canvas.Position = UDim2.fromScale(0.5, 0.5)
	canvas.Size = UDim2.fromScale(0.56, 0.44)
	canvas.BackgroundColor3 = INNER_BG
	canvas.BackgroundTransparency = 0
	canvas.BorderSizePixel = 0
	canvas.GroupTransparency = 1
	canvas.Visible = false
	canvas.ZIndex = 5
	canvas.ClipsDescendants = true
	canvas.Parent = parent

	Instance.new("UICorner", canvas).CornerRadius = UDim.new(0, 14)

	local stroke = Instance.new("UIStroke")
	stroke.Color = HEADER_COLOR
	stroke.Thickness = 3
	stroke.Transparency = 0.08
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent = canvas

	local shadow = Instance.new("Frame")
	shadow.AnchorPoint = Vector2.new(0.5, 0.5)
	shadow.Position = UDim2.new(0.5, 5, 0.5, 8)
	shadow.Size = UDim2.new(1, 20, 1, 20)
	shadow.BackgroundColor3 = Color3.new(0, 0, 0)
	shadow.BackgroundTransparency = 0.45
	shadow.BorderSizePixel = 0
	shadow.ZIndex = 4
	shadow.Parent = canvas
	Instance.new("UICorner", shadow).CornerRadius = UDim.new(0, 20)

	uiScale = Instance.new("UIScale")
	uiScale.Scale = 0.9
	uiScale.Parent = canvas

	overlay = Instance.new("Frame")
	overlay.Name = "Overlay"
	overlay.AnchorPoint = Vector2.new(0.5, 0.5)
	overlay.Position = UDim2.fromScale(0.5, 0.5)
	overlay.Size = UDim2.fromScale(1, 1)
	overlay.BackgroundColor3 = Color3.new(0, 0, 0)
	overlay.BackgroundTransparency = 1
	overlay.BorderSizePixel = 0
	overlay.ZIndex = 1
	overlay.Visible = false
	overlay.Parent = parent

	local studTex = Instance.new("ImageLabel")
	studTex.Name = "StudTexture"
	studTex.AnchorPoint = Vector2.new(0, 0)
	studTex.Position = UDim2.fromScale(0, 0)
	studTex.Size = UDim2.fromScale(1, 1)
	studTex.BackgroundTransparency = 1
	studTex.Image = "rbxassetid://84772207963553"
	studTex.ImageTransparency = 0.93
	studTex.ScaleType = Enum.ScaleType.Tile
	studTex.TileSize = UDim2.fromOffset(64, 64)
	studTex.ImageColor3 = Color3.fromRGB(220, 180, 255)
	studTex.ZIndex = 6
	studTex.Parent = canvas

	local glow = Instance.new("ImageLabel")
	glow.AnchorPoint = Vector2.new(0.5, 0.5)
	glow.Position = UDim2.fromScale(0.5, 0.5)
	glow.Size = UDim2.fromScale(1.35, 1.35)
	glow.BackgroundTransparency = 1
	glow.Image = "rbxassetid://5607835947"
	glow.ImageColor3 = HEADER_COLOR
	glow.ImageTransparency = 0.84
	glow.ZIndex = 2
	glow.Parent = canvas

	local header = Instance.new("Frame")
	header.Name = "Header"
	header.AnchorPoint = Vector2.new(0, 0)
	header.Position = UDim2.fromOffset(0, 0)
	header.Size = UDim2.new(1, 0, 0, 54)
	header.BackgroundColor3 = HEADER_COLOR
	header.BorderSizePixel = 0
	header.ZIndex = 8
	header.Parent = canvas

	local hCorner = Instance.new("UICorner")
	hCorner.CornerRadius = UDim.new(0, 14)
	hCorner.Parent = header

	local hMask = Instance.new("Frame")
	hMask.Position = UDim2.new(0, 0, 0.5, 0)
	hMask.Size = UDim2.new(1, 0, 0.5, 0)
	hMask.BackgroundColor3 = HEADER_COLOR
	hMask.BorderSizePixel = 0
	hMask.ZIndex = 8
	hMask.Parent = header

	local hGrad = Instance.new("UIGradient")
	hGrad.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, HEADER_TOP),
		ColorSequenceKeypoint.new(0.5, HEADER_COLOR),
		ColorSequenceKeypoint.new(1, HEADER_BOT),
	})
	hGrad.Rotation = 90
	hGrad.Parent = header

	local titleLabel = Instance.new("TextLabel")
	titleLabel.AnchorPoint = Vector2.new(0, 0.5)
	titleLabel.Position = UDim2.new(0, 18, 0.5, 0)
	titleLabel.Size = UDim2.new(1, -56, 1, 0)
	titleLabel.BackgroundTransparency = 1
	titleLabel.Font = Enum.Font.GothamBold
	titleLabel.Text = "CUSTOMIZE SWORD"
	titleLabel.TextColor3 = TEXT_WHITE
	titleLabel.TextSize = 22
	titleLabel.TextXAlignment = Enum.TextXAlignment.Left
	titleLabel.ZIndex = 9
	titleLabel.Parent = header

	local titleStroke = Instance.new("UIStroke")
	titleStroke.Color = Color3.new(0, 0, 0)
	titleStroke.Thickness = 1.8
	titleStroke.Transparency = 0.15
	titleStroke.Parent = titleLabel

	local closeBtn = Instance.new("TextButton")
	closeBtn.Name = "CloseBtn"
	closeBtn.AnchorPoint = Vector2.new(1, 0.5)
	closeBtn.Position = UDim2.new(1, -12, 0.5, 0)
	closeBtn.Size = UDim2.fromOffset(36, 36)
	closeBtn.BackgroundColor3 = CLOSE_COLOR
	closeBtn.BorderSizePixel = 0
	closeBtn.Font = Enum.Font.GothamBold
	closeBtn.Text = "X"
	closeBtn.TextColor3 = TEXT_WHITE
	closeBtn.TextSize = 22
	closeBtn.ZIndex = 9
	closeBtn.Parent = header
	Instance.new("UICorner", closeBtn).CornerRadius = UDim.new(1, 0)

	local closeStroke = Instance.new("UIStroke")
	closeStroke.Color = Color3.fromRGB(72, 28, 120)
	closeStroke.Thickness = 1.5
	closeStroke.Parent = closeBtn

	AnimUtil.WireButton(closeBtn, function()
		if closeCallback then
			closeCallback()
		end
		CustomSwordComingSoonPanel.Hide()
	end)

	local subtitle = Instance.new("TextLabel")
	subtitle.AnchorPoint = Vector2.new(0.5, 0)
	subtitle.Position = UDim2.new(0.5, 0, 0, 56)
	subtitle.Size = UDim2.new(1, -40, 0, 18)
	subtitle.BackgroundTransparency = 1
	subtitle.Font = Enum.Font.GothamSemibold
	subtitle.Text = "Sword customization will be available here soon."
	subtitle.TextColor3 = TEXT_MUTED
	subtitle.TextSize = 13
	subtitle.TextXAlignment = Enum.TextXAlignment.Center
	subtitle.ZIndex = 7
	subtitle.Parent = canvas

	local messageCard = Instance.new("Frame")
	messageCard.Name = "MessageCard"
	messageCard.AnchorPoint = Vector2.new(0.5, 0.5)
	messageCard.Position = UDim2.new(0.5, 0, 0.62, 0)
	messageCard.Size = UDim2.new(1, -56, 0, 148)
	messageCard.BackgroundColor3 = CARD_BG
	messageCard.BorderSizePixel = 0
	messageCard.ZIndex = 7
	messageCard.Parent = canvas
	Instance.new("UICorner", messageCard).CornerRadius = UDim.new(0, 14)

	local cardStroke = Instance.new("UIStroke")
	cardStroke.Color = CARD_STROKE
	cardStroke.Thickness = 2
	cardStroke.Transparency = 0.22
	cardStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	cardStroke.Parent = messageCard

	local cardGrad = Instance.new("UIGradient")
	cardGrad.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, CARD_TOP),
		ColorSequenceKeypoint.new(0.5, CARD_BG),
		ColorSequenceKeypoint.new(1, CARD_BOT),
	})
	cardGrad.Rotation = 90
	cardGrad.Parent = messageCard

	local badge = Instance.new("TextLabel")
	badge.Name = "Badge"
	badge.AnchorPoint = Vector2.new(0.5, 0)
	badge.Position = UDim2.new(0.5, 0, 0, 18)
	badge.Size = UDim2.fromOffset(170, 28)
	badge.BackgroundColor3 = Color3.fromRGB(90, 48, 146)
	badge.BorderSizePixel = 0
	badge.Font = Enum.Font.GothamBold
	badge.Text = "SWORD CUSTOMIZER"
	badge.TextColor3 = TEXT_WHITE
	badge.TextSize = 13
	badge.ZIndex = 8
	badge.Parent = messageCard
	Instance.new("UICorner", badge).CornerRadius = UDim.new(0, 12)

	local badgeStroke = Instance.new("UIStroke")
	badgeStroke.Color = Color3.fromRGB(225, 196, 255)
	badgeStroke.Thickness = 1.5
	badgeStroke.Transparency = 0.25
	badgeStroke.Parent = badge

	local comingSoonLabel = Instance.new("TextLabel")
	comingSoonLabel.Name = "ComingSoonLabel"
	comingSoonLabel.AnchorPoint = Vector2.new(0.5, 0.5)
	comingSoonLabel.Position = UDim2.new(0.5, 0, 0.58, 0)
	comingSoonLabel.Size = UDim2.new(1, -24, 0, 48)
	comingSoonLabel.BackgroundTransparency = 1
	comingSoonLabel.Font = Enum.Font.GothamBlack
	comingSoonLabel.Text = "Coming Soon"
	comingSoonLabel.TextColor3 = MESSAGE_COLOR
	comingSoonLabel.TextSize = 30
	comingSoonLabel.TextScaled = true
	comingSoonLabel.ZIndex = 8
	comingSoonLabel.Parent = messageCard

	local comingSoonStroke = Instance.new("UIStroke")
	comingSoonStroke.Color = Color3.new(0, 0, 0)
	comingSoonStroke.Thickness = 2
	comingSoonStroke.Transparency = 0.12
	comingSoonStroke.Parent = comingSoonLabel

end

function CustomSwordComingSoonPanel.Show()
	if not canvas or not uiScale then
		return
	end
	if visible then
		return
	end

	visible = true
	canvas.Visible = true

	if overlay then
		overlay.Visible = true
		TweenService:Create(overlay, TweenInfo.new(0.18), { BackgroundTransparency = 0.55 }):Play()
	end

	uiScale.Scale = 0.88
	TweenService:Create(canvas, TweenInfo.new(0.18), { GroupTransparency = 0 }):Play()
	TweenService:Create(uiScale, TweenInfo.new(0.28, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()

	SoundUtil.Open()
end

function CustomSwordComingSoonPanel.Hide()
	if not canvas or not uiScale then
		return
	end
	if not visible then
		return
	end

	visible = false

	TweenService:Create(
		canvas,
		TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
		{ GroupTransparency = 1 }
	):Play()
	TweenService:Create(
		uiScale,
		TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
		{ Scale = 0.92 }
	):Play()

	if overlay then
		TweenService:Create(overlay, TweenInfo.new(0.18), { BackgroundTransparency = 1 }):Play()
	end

	task.delay(0.2, function()
		if not visible and canvas then
			canvas.Visible = false
			if overlay then
				overlay.Visible = false
			end
		end
	end)

	SoundUtil.Close()
end

function CustomSwordComingSoonPanel.IsVisible(): boolean
	return visible
end

function CustomSwordComingSoonPanel.Toggle()
	if visible then
		CustomSwordComingSoonPanel.Hide()
	else
		CustomSwordComingSoonPanel.Show()
	end
end

function CustomSwordComingSoonPanel.Init(screenGui, onClose)
	if initialized then
		closeCallback = onClose
		return
	end

	initialized = true
	closeCallback = onClose
	buildPanel(screenGui)
end

return CustomSwordComingSoonPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="149">
            <Properties>
              <string name="Name">DailyRewardsPanel</string>
              <string name="Source"><![CDATA[--[[
	DailyRewardsPanel
	Standard-size panel (matches Crate Shop) with 7-day reward grid.
	Uses Components.CreatePanel for consistent sizing/styling.

	Layout:
	  - Standard panel header ("DAILY REWARDS") — light blue theme
	  - Progress bar: "Day X / 7"
	  - Left: 3×2 grid of Day 1–6 cards
	  - Right: Large featured Day 7 card
	  - Bottom: Timer + Claim button

	API:
	  Init(screenGui, onClose)
	  Show() / Hide() / IsVisible() / Toggle()
	  TryAutoShow()
]]

local FORCE_OPEN_DAILY_ON_JOIN = false

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared", 60)
if not Shared then
	warn("[DailyRewardsPanel] Shared not found")
	return { Init = function() end, Show = function() end, Hide = function() end,
		IsVisible = function() return false end, Toggle = function() end, TryAutoShow = function() end }
end

local CDPModule = Shared:WaitForChild("ClientDepsProvider", 60)
if not CDPModule then
	warn("[DailyRewardsPanel] ClientDepsProvider MISSING")
	return { Init = function() end, Show = function() end, Hide = function() end,
		IsVisible = function() return false end, Toggle = function() end, TryAutoShow = function() end }
end

local ok, Deps = pcall(require, CDPModule)
if not ok or not Deps then
	warn("[DailyRewardsPanel] require(ClientDepsProvider) FAILED:", Deps)
	return { Init = function() end, Show = function() end, Hide = function() end,
		IsVisible = function() return false end, Toggle = function() end, TryAutoShow = function() end }
end

local UIConfig = Deps.UIConfig

local okConfig, DailyRewardConfig = pcall(require, Shared:WaitForChild("DailyRewardConfig", 10))
if not okConfig or not DailyRewardConfig then
	warn("[DailyRewardsPanel] DailyRewardConfig not found")
	return { Init = function() end, Show = function() end, Hide = function() end,
		IsVisible = function() return false end, Toggle = function() end, TryAutoShow = function() end }
end

local Client = script.Parent
local AnimUtil = require(Client:WaitForChild("AnimUtil"))
local SoundUtil = require(Client:WaitForChild("SoundUtil"))
local Components = require(Client:WaitForChild("Components"))

local C = UIConfig.Colors
local S = UIConfig.Sizes

local DailyRewardsPanel = {}

-- STATE
local canvas = nil
local uiScale = nil
local overlay = nil
local visible = false
local closeCallback = nil
local _hasAutoShown = false

-- UI refs
local _claimButton = nil
local _timerLabel = nil
local _dayCards = {}
local _streakLabel = nil
local _progressFill = nil
local _bgImage = nil
local _bgAnimToken = 0

-- State
local _status = nil
local _timerConn = nil

-- Remotes
local _getStatusFunc = nil
local _claimFunc = nil

-- Lazy RewardPopup
local _RewardPopup = nil
local function getRewardPopup()
	if _RewardPopup then return _RewardPopup end
	pcall(function()
		local ps = game:GetService("Players").LocalPlayer:FindFirstChild("PlayerScripts")
		local client = ps and ps:FindFirstChild("Client")
		local ui = client and client:FindFirstChild("UI")
		local rp = ui and ui:FindFirstChild("RewardPopup")
		if rp then _RewardPopup = require(rp) end
	end)
	return _RewardPopup
end

local function log(...) print("[DailyRewardsPanel]", ...) end

-- ═══════════════════════════════════════════════════════════════════
-- THEME — orange + dark/blackish palette
-- ═══════════════════════════════════════════════════════════════════

local HEADER_COLOR      = Color3.fromRGB(255, 122, 22)       -- panel header bar
local INNER_BG_COLOR    = Color3.fromRGB(14, 10, 8)          -- inner content base
local INNER_TINT_COLOR  = Color3.fromRGB(28, 18, 12)         -- subtle warm tint behind cards
local CARD_BG           = Color3.fromRGB(20, 14, 10)         -- card background (dark brown-black)
local CARD_BORDER       = Color3.fromRGB(145, 88, 22)        -- default card border
local PROGRESS_BG       = Color3.fromRGB(30, 20, 14)         -- progress bar bg
local PROGRESS_FILL     = Color3.fromRGB(255, 178, 38)       -- progress bar fill
local STREAK_TEXT       = Color3.fromRGB(255, 205, 92)       -- streak label
local TIMER_READY       = Color3.fromRGB(255, 188, 70)       -- "available now"
local TIMER_WAIT        = Color3.fromRGB(214, 188, 156)      -- countdown text
local CLAIM_GREEN       = Color3.fromRGB(255, 145, 30)       -- claim button (kept var name for compatibility)
local CLAIM_DISABLED    = Color3.fromRGB(44, 32, 24)         -- disabled button
local CLAIM_DISABLED_TEXT = Color3.fromRGB(145, 125, 102)
local LOCKED_TAG_BG     = Color3.fromRGB(88, 38, 24)
local REWARD_LABEL_TEXT = Color3.fromRGB(238, 218, 190)
local FALLBACK_ICON_TEXT = Color3.fromRGB(255, 195, 95)
local CLAIM_CHECK_COLOR = Color3.fromRGB(98, 255, 165)
local FATE_COIN_IMAGE   = "rbxassetid://81959864063463"

-- Per-day accent colours (orange/gold spectrum)
local DAY_COLORS = {
	[1] = Color3.fromRGB(255, 186, 70),
	[2] = Color3.fromRGB(255, 168, 58),
	[3] = Color3.fromRGB(255, 152, 48),
	[4] = Color3.fromRGB(255, 136, 38),
	[5] = Color3.fromRGB(255, 122, 30),
	[6] = Color3.fromRGB(242, 182, 86),
	[7] = Color3.fromRGB(255, 208, 92),
}

-- ═══════════════════════════════════════════════════════════════════
-- HELPERS
-- ═══════════════════════════════════════════════════════════════════

local function formatTimer(seconds)
	local h = math.floor(seconds / 3600)
	local m = math.floor((seconds % 3600) / 60)
	local s = math.floor(seconds % 60)
	return string.format("%02d:%02d:%02d", h, m, s)
end

local function fetchStatus()
	if not _getStatusFunc then
		pcall(function()
			local remotes = ReplicatedStorage:WaitForChild("Remotes", 5)
			if remotes then
				_getStatusFunc = remotes:WaitForChild("DailyReward_GetStatus", 5)
				_claimFunc = remotes:WaitForChild("DailyReward_Claim", 5)
			end
		end)
	end
	if _getStatusFunc then
		local statusOk, status = pcall(_getStatusFunc.InvokeServer, _getStatusFunc)
		if statusOk and status then return status end
	end
	return nil
end

-- ═══════════════════════════════════════════════════════════════════
-- UI UPDATES
-- ═══════════════════════════════════════════════════════════════════

local function updateDayCards(status)
	if not status then return end
	local streak = status.streak or 0
	local canClaim = status.canClaim

	for i, card in ipairs(_dayCards) do
		local check = card:FindFirstChild("Check")
		local glow = card:FindFirstChild("GlowStroke")
		local dimOverlay = card:FindFirstChild("DimOverlay")
		local claimTag = card:FindFirstChild("ClaimTag")
		local lockedTag = card:FindFirstChild("LockedTag")

		if i <= streak then
			if check then check.Visible = true end
			if glow then glow.Enabled = false end
			if dimOverlay then dimOverlay.Visible = false end
			if claimTag then claimTag.Visible = false end
			if lockedTag then lockedTag.Visible = false end
		elseif i == streak + 1 and canClaim then
			if check then check.Visible = false end
			if glow then glow.Enabled = true end
			if dimOverlay then dimOverlay.Visible = false end
			if claimTag then claimTag.Visible = true end
			if lockedTag then lockedTag.Visible = false end
		else
			if check then check.Visible = false end
			if glow then glow.Enabled = false end
			if dimOverlay then dimOverlay.Visible = true end
			if claimTag then claimTag.Visible = false end
			if lockedTag then lockedTag.Visible = true end
		end
	end

	if _streakLabel then
		_streakLabel.Text = string.format("Day %d / %d", streak, DailyRewardConfig.MaxStreak)
	end

	if _progressFill then
		local frac = math.clamp(streak / DailyRewardConfig.MaxStreak, 0, 1)
		TweenService:Create(_progressFill, TweenInfo.new(0.4, Enum.EasingStyle.Quad), {
			Size = UDim2.new(frac, 0, 1, 0)
		}):Play()
	end

	if _claimButton then
		if canClaim then
			_claimButton.Text = "CLAIM REWARD"
			_claimButton.BackgroundColor3 = CLAIM_GREEN
			_claimButton.TextColor3 = Color3.fromRGB(255, 255, 255)
			_claimButton.Active = true
			_claimButton.AutoButtonColor = true
		else
			_claimButton.Text = "COME BACK LATER"
			_claimButton.BackgroundColor3 = CLAIM_DISABLED
			_claimButton.TextColor3 = CLAIM_DISABLED_TEXT
			_claimButton.Active = false
			_claimButton.AutoButtonColor = false
		end
	end

	if _timerLabel then
		if canClaim then
			_timerLabel.Text = "Reward available now!"
			_timerLabel.TextColor3 = TIMER_READY
		else
			local secs = status.secondsUntilNext or 0
			_timerLabel.Text = "Next reward in: " .. formatTimer(secs)
			_timerLabel.TextColor3 = TIMER_WAIT
		end
	end
end

local function startTimerLoop()
	if _timerConn then _timerConn:Disconnect() end
	local lastFetch = os.time()
	local serverSecs = _status and _status.secondsUntilNext or 0
	_timerConn = RunService.Heartbeat:Connect(function()
		if not visible or not _status then return end
		if _status.canClaim then return end
		local elapsed = os.time() - lastFetch
		local remaining = math.max(0, serverSecs - elapsed)
		if _timerLabel then
			if remaining <= 0 then
				_timerLabel.Text = "Reward available now!"
				_timerLabel.TextColor3 = TIMER_READY
				_status = fetchStatus()
				if _status then
					updateDayCards(_status)
					serverSecs = _status.secondsUntilNext or 0
					lastFetch = os.time()
				end
			else
				_timerLabel.Text = "Next reward in: " .. formatTimer(remaining)
			end
		end
	end)
end

local function stopTimerLoop()
	if _timerConn then _timerConn:Disconnect(); _timerConn = nil end
end

local function stopBgFadeLoop()
	_bgAnimToken += 1
	if _bgImage then
		_bgImage.ImageTransparency = 0.82
	end
end

local function startBgFadeLoop()
	if not _bgImage then return end
	_bgAnimToken += 1
	local token = _bgAnimToken
	task.spawn(function()
		while visible and _bgImage and _bgImage.Parent and token == _bgAnimToken do
			local fadeOut = TweenService:Create(_bgImage, TweenInfo.new(1.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
				ImageTransparency = 0.9,
			})
			fadeOut:Play()
			fadeOut.Completed:Wait()
			if not visible or token ~= _bgAnimToken then break end

			local fadeIn = TweenService:Create(_bgImage, TweenInfo.new(1.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
				ImageTransparency = 0.82,
			})
			fadeIn:Play()
			fadeIn.Completed:Wait()
		end
	end)
end

-- ═══════════════════════════════════════════════════════════════════
-- CLAIM
-- ═══════════════════════════════════════════════════════════════════

local _claiming = false
local function onClaim()
	if _claiming then return end
	if not _status or not _status.canClaim then return end
	_claiming = true
	if _claimButton then _claimButton.Text = "..."; _claimButton.Active = false end

	local result = nil
	if _claimFunc then
		local claimOk, claimResult = pcall(_claimFunc.InvokeServer, _claimFunc)
		if claimOk then result = claimResult end
	end

	if result and result.success then
		log("Claimed:", result.newStreak, result.reward and result.reward.label or "?")
		local popup = getRewardPopup()
		local reward = result.reward or {}

		-- Check if this was a crate reward with roll results
		if reward.crateResults and #reward.crateResults > 0 and popup and popup.ShowBatch then
			log(string.format("Day%d claimed -> resultsCount=%d crate rolls", result.newStreak, #reward.crateResults))
			local batchItems = {}
			for i, roll in ipairs(reward.crateResults) do
				log(string.format("  roll#%d: %s %s (dup=%s, coins=%s)",
					i, roll.category or "?", roll.itemId or "?",
					tostring(roll.isDuplicate), tostring(roll.coinsInstead)))
				table.insert(batchItems, {
					title = "DAILY REWARD!",
					name = roll.displayName or roll.itemId or "MISSING ITEM",
					itemId = roll.itemId or "",
					itemType = roll.category == "Crowns" and "Crown" or (roll.category == "Pets" and "Pet" or ""),
					category = roll.category or "",
					rarityText = roll.rarity or "Common",
					icon = "",  -- let RewardPopup resolve from catalog
					isDuplicate = roll.isDuplicate,
				})
			end
			popup.ShowBatch(batchItems)
		elseif popup and popup.Show then
			local iconColor = nil
			if reward.iconColor and type(reward.iconColor) == "table" then
				iconColor = Color3.fromRGB(reward.iconColor[1] or 200, reward.iconColor[2] or 200, reward.iconColor[3] or 200)
			end
			popup.Show({
				title = "DAILY REWARD!",
				name = reward.label or "Reward",
				icon = reward.icon or "",
				iconText = reward.iconText or "",
				iconColor = iconColor,
				rarityText = "Day " .. tostring(result.newStreak),
				itemId = reward.crownId or reward.crateId or "",
				itemType = reward.type or "",
			})
		end
		_status = fetchStatus()
		if _status then
			updateDayCards(_status)
			startTimerLoop()
		end
	else
		local reason = result and result.reason or "unknown"
		warn("[DailyRewardsPanel] Claim rejected:", reason)
		if _claimButton then
			if reason == "AlreadyClaimed" or reason == "On cooldown" then
				_claimButton.Text = "ALREADY CLAIMED"
				_claimButton.BackgroundColor3 = CLAIM_DISABLED
				_claimButton.TextColor3 = CLAIM_DISABLED_TEXT
				_claimButton.Active = false
				_claimButton.AutoButtonColor = false
			end
		end
		_status = fetchStatus()
		if _status then updateDayCards(_status) end
	end
	_claiming = false
end

-- ═══════════════════════════════════════════════════════════════════
-- BUILD DAY CARD  (scale-based, no fixed pixel sizes)
-- ═══════════════════════════════════════════════════════════════════

local function buildDayCard(parent, dayNum)
	local reward = DailyRewardConfig.Rewards[dayNum]
	local dayColor = DAY_COLORS[dayNum] or Color3.fromRGB(255, 158, 52)

	local card = Instance.new("Frame")
	card.Name = "Day" .. dayNum
	card.BackgroundColor3 = CARD_BG
	card.BorderSizePixel = 0
	card.ZIndex = 6
	card.Parent = parent
	Instance.new("UICorner", card).CornerRadius = UDim.new(0, 10)

	-- Border
	local stroke = Instance.new("UIStroke")
	stroke.Color = CARD_BORDER
	stroke.Thickness = 1.5
	stroke.Transparency = 0.3
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent = card

	-- Glow stroke (claimable)
	local glowStroke = Instance.new("UIStroke")
	glowStroke.Name = "GlowStroke"
	glowStroke.Color = dayColor
	glowStroke.Thickness = 2.5
	glowStroke.Enabled = false
	glowStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	glowStroke.Parent = card

	-- Day header
	local dayLbl = Instance.new("TextLabel")
	dayLbl.AnchorPoint = Vector2.new(0.5, 0)
	dayLbl.Position = UDim2.new(0.5, 0, 0, 4)
	dayLbl.Size = UDim2.new(1, 0, 0, 16)
	dayLbl.BackgroundTransparency = 1
	dayLbl.Font = Enum.Font.GothamBold
	dayLbl.TextColor3 = dayColor
	dayLbl.TextSize = 12
	dayLbl.Text = "DAY " .. dayNum
	dayLbl.ZIndex = 7
	dayLbl.Parent = card

	-- Icon
	if reward then
		local rewardType = string.upper(tostring(reward.type or ""))
		local isFateCoinReward = (rewardType == "COINS" or rewardType == "FATECOINS" or rewardType == "FATE_COINS")
			and tostring(reward.icon or "") == FATE_COIN_IMAGE
		local iconLbl
		if reward.icon and reward.icon ~= "" then
			iconLbl = Instance.new("ImageLabel")
			iconLbl.Image = reward.icon
			iconLbl.ScaleType = Enum.ScaleType.Fit
			iconLbl.BackgroundTransparency = 1
		else
			iconLbl = Instance.new("TextLabel")
			iconLbl.BackgroundTransparency = 1
			iconLbl.Font = Enum.Font.GothamBold
			iconLbl.TextScaled = true
			iconLbl.Text = reward.iconText or "?"
			local ic = reward.iconColor
			if ic and type(ic) == "table" then
				iconLbl.TextColor3 = Color3.fromRGB(ic[1] or 200, ic[2] or 200, ic[3] or 200)
			else
				iconLbl.TextColor3 = FALLBACK_ICON_TEXT
			end
		end
		iconLbl.Name = "RewardIcon"
		iconLbl.AnchorPoint = Vector2.new(0.5, 0.5)
		iconLbl.Position = UDim2.new(0.5, 0, 0.48, 0)
		iconLbl.Size = UDim2.new(0.6, 0, 0.45, 0)
		if reward.type == "Spins" then
			-- Slightly larger icon box keeps spins artwork legible without changing card layout.
			iconLbl.Position = UDim2.new(0.5, 0, 0.47, 0)
			iconLbl.Size = UDim2.new(0.72, 0, 0.52, 0)
		elseif isFateCoinReward then
			-- Fate Coin art has heavy transparent padding, so intentionally overscale it.
			iconLbl.Position = UDim2.new(0.5, 0, 0.47, 0)
			iconLbl.Size = UDim2.new(1.35, 0, 0.98, 0)
		end
		iconLbl.ZIndex = 7
		iconLbl.Parent = card

		-- Label
		local rewLbl = Instance.new("TextLabel")
		rewLbl.AnchorPoint = Vector2.new(0.5, 1)
		rewLbl.Position = UDim2.new(0.5, 0, 1, -4)
		rewLbl.Size = UDim2.new(1, -8, 0, 14)
		rewLbl.BackgroundTransparency = 1
		rewLbl.Font = Enum.Font.GothamSemibold
		rewLbl.TextColor3 = REWARD_LABEL_TEXT
		rewLbl.TextSize = 10
		rewLbl.TextTruncate = Enum.TextTruncate.AtEnd
		rewLbl.Text = reward.label or ""
		rewLbl.ZIndex = 7
		rewLbl.Parent = card
	end

	-- Claim tag
	local claimTag = Instance.new("TextLabel")
	claimTag.Name = "ClaimTag"
	claimTag.AnchorPoint = Vector2.new(0.5, 0)
	claimTag.Position = UDim2.new(0.5, 0, 0, 20)
	claimTag.Size = UDim2.new(0.85, 0, 0, 16)
	claimTag.BackgroundColor3 = CLAIM_GREEN
	claimTag.Font = Enum.Font.GothamBold
	claimTag.TextColor3 = Color3.fromRGB(255, 255, 255)
	claimTag.TextSize = 9
	claimTag.Text = "CLAIM"
	claimTag.BorderSizePixel = 0
	claimTag.ZIndex = 8
	claimTag.Visible = false
	claimTag.Parent = card
	Instance.new("UICorner", claimTag).CornerRadius = UDim.new(0, 5)

	-- Locked tag
	local lockedTag = Instance.new("TextLabel")
	lockedTag.Name = "LockedTag"
	lockedTag.AnchorPoint = Vector2.new(0.5, 0)
	lockedTag.Position = UDim2.new(0.5, 0, 0, 20)
	lockedTag.Size = UDim2.new(0.85, 0, 0, 16)
	lockedTag.BackgroundColor3 = LOCKED_TAG_BG
	lockedTag.Font = Enum.Font.GothamBold
	lockedTag.TextColor3 = Color3.fromRGB(255, 255, 255)
	lockedTag.TextSize = 9
	lockedTag.Text = "LOCKED"
	lockedTag.BorderSizePixel = 0
	lockedTag.ZIndex = 8
	lockedTag.Visible = false
	lockedTag.Parent = card
	Instance.new("UICorner", lockedTag).CornerRadius = UDim.new(0, 5)

	-- Checkmark
	local check = Instance.new("TextLabel")
	check.Name = "Check"
	check.AnchorPoint = Vector2.new(0.5, 0.5)
	check.Position = UDim2.fromScale(0.5, 0.45)
	check.Size = UDim2.fromOffset(30, 30)
	check.BackgroundTransparency = 1
	check.Font = Enum.Font.GothamBold
	check.TextColor3 = CLAIM_CHECK_COLOR
	check.TextSize = 24
	check.Text = "\xE2\x9C\x93"
	check.ZIndex = 9
	check.Visible = false
	check.Parent = card

	-- Dim overlay (locked)
	local dimOv = Instance.new("Frame")
	dimOv.Name = "DimOverlay"
	dimOv.Size = UDim2.fromScale(1, 1)
	dimOv.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
	dimOv.BackgroundTransparency = 0.55
	dimOv.BorderSizePixel = 0
	dimOv.ZIndex = 8
	dimOv.Visible = false
	dimOv.Parent = card
	Instance.new("UICorner", dimOv).CornerRadius = UDim.new(0, 10)

	table.insert(_dayCards, card)
	return card
end

-- ═══════════════════════════════════════════════════════════════════
-- PANEL LIFECYCLE
-- ═══════════════════════════════════════════════════════════════════

function DailyRewardsPanel.Init(screenGui, onClose)
	closeCallback = onClose

	overlay = Components.CreateDimOverlay(screenGui, function()
		DailyRewardsPanel.Hide()
	end)

	local content, closeBtn
	canvas, uiScale, content, closeBtn = Components.CreatePanel(screenGui, "DAILY REWARDS", HEADER_COLOR, "Daily")

	-- Daily-only header divider tint (darker orange theme match).
	do
		local header = canvas and canvas:FindFirstChild("Header")
		local divider = header and header:FindFirstChild("HighlightLine")
		if divider and divider:IsA("Frame") then
			divider.BackgroundColor3 = Color3.fromRGB(170, 70, 0)
		end
	end

	closeBtn.MouseButton1Click:Connect(function()
		SoundUtil.Close()
		DailyRewardsPanel.Hide()
	end)

	-- Override stud texture to Fate Beams asset (only this panel)
	do
		local stud = canvas:FindFirstChild("StudTexture")
		if stud then
			stud.Image = "rbxassetid://84772207963553"
			stud.TileSize = UDim2.fromOffset(96, 96)
			stud.ImageTransparency = 0.88
			stud.ImageColor3 = Color3.fromRGB(255, 255, 255)
		end
	end

	-- Disable the scroll from CreatePanel — we do our own layout
	if content then
		content.ScrollingEnabled = false
		content.AutomaticCanvasSize = Enum.AutomaticSize.None
		content.CanvasSize = UDim2.fromScale(0, 0)
		content.ScrollBarThickness = 0
	end

	-- Decorative panel background (daily-only), kept subtle and behind content.
	local bgImage = Instance.new("ImageLabel")
	bgImage.Name = "DailyBgImage"
	bgImage.Size = UDim2.fromScale(1, 1)
	bgImage.Position = UDim2.fromScale(0, 0)
	bgImage.BackgroundTransparency = 1
	bgImage.Image = "rbxassetid://90452980108887"
	bgImage.ImageTransparency = 0.82
	bgImage.ScaleType = Enum.ScaleType.Crop
	bgImage.ZIndex = 4
	bgImage.Parent = content
	_bgImage = bgImage

	-- ── LIGHT BLUE INNER BACKGROUND ──────────────────────────────
	local innerBg = Instance.new("Frame")
	innerBg.Name = "InnerBg"
	innerBg.Size = UDim2.fromScale(1, 1)
	innerBg.BackgroundColor3 = INNER_TINT_COLOR
	innerBg.BackgroundTransparency = 0.72
	innerBg.BorderSizePixel = 0
	innerBg.ZIndex = 5
	innerBg.Parent = content
	Instance.new("UICorner", innerBg).CornerRadius = UDim.new(0, 8)
	local innerStroke = Instance.new("UIStroke")
	innerStroke.Color = CARD_BORDER
	innerStroke.Thickness = 1.2
	innerStroke.Transparency = 0.55
	innerStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	innerStroke.Parent = innerBg

	-- ── TOP: STREAK + PROGRESS BAR (fixed 40px strip) ───────────
	_streakLabel = Instance.new("TextLabel")
	_streakLabel.AnchorPoint = Vector2.new(0.5, 0)
	_streakLabel.Position = UDim2.new(0.5, 0, 0, 4)
	_streakLabel.Size = UDim2.new(1, -20, 0, 18)
	_streakLabel.BackgroundTransparency = 1
	_streakLabel.Font = Enum.Font.GothamBold
	_streakLabel.TextColor3 = STREAK_TEXT
	_streakLabel.TextSize = 14
	_streakLabel.Text = "Day 0 / 7"
	_streakLabel.ZIndex = 7
	_streakLabel.Parent = content

	local barBg = Instance.new("Frame")
	barBg.AnchorPoint = Vector2.new(0.5, 0)
	barBg.Position = UDim2.new(0.5, 0, 0, 26)
	barBg.Size = UDim2.new(0.7, 0, 0, 8)
	barBg.BackgroundColor3 = PROGRESS_BG
	barBg.BorderSizePixel = 0
	barBg.ZIndex = 7
	barBg.Parent = content
	Instance.new("UICorner", barBg).CornerRadius = UDim.new(1, 0)

	_progressFill = Instance.new("Frame")
	_progressFill.Size = UDim2.new(0, 0, 1, 0)
	_progressFill.BackgroundColor3 = PROGRESS_FILL
	_progressFill.BorderSizePixel = 0
	_progressFill.ZIndex = 8
	_progressFill.Parent = barBg
	Instance.new("UICorner", _progressFill).CornerRadius = UDim.new(1, 0)

	-- ── MIDDLE: CARDS AREA (fills available space) ──────────────
	-- Layout: 3-col × 2-row grid (days 1-6) on the left (~72%)
	--         tall Day 7 card on the right (~26%), 2% gap

	local TOP_OFFSET = 40     -- space for streak + progress bar
	local BOTTOM_OFFSET = 66  -- space for timer + claim button

	local cardsFrame = Instance.new("Frame")
	cardsFrame.Name = "CardsArea"
	cardsFrame.AnchorPoint = Vector2.new(0.5, 0)
	cardsFrame.Position = UDim2.new(0.5, 0, 0, TOP_OFFSET)
	cardsFrame.Size = UDim2.new(1, -16, 1, -(TOP_OFFSET + BOTTOM_OFFSET))
	cardsFrame.BackgroundTransparency = 1
	cardsFrame.ClipsDescendants = false
	cardsFrame.ZIndex = 6
	cardsFrame.Parent = content

	_dayCards = {}

	-- ── LEFT: 3×2 Grid container ────────────────────────────────
	local GRID_W_SCALE = 0.72
	local GAP_SCALE    = 0.02
	local DAY7_W_SCALE = 1 - GRID_W_SCALE - GAP_SCALE

	local gridFrame = Instance.new("Frame")
	gridFrame.Name = "GridDays"
	gridFrame.Size = UDim2.new(GRID_W_SCALE, 0, 1, 0)
	gridFrame.Position = UDim2.fromScale(0, 0)
	gridFrame.BackgroundTransparency = 1
	gridFrame.ZIndex = 6
	gridFrame.Parent = cardsFrame

	-- UIGridLayout for days 1-6
	local COLS, ROWS = 3, 2
	local CELL_PAD = 6
	local grid = Instance.new("UIGridLayout")
	grid.CellSize = UDim2.new(1 / COLS, -CELL_PAD, 1 / ROWS, -CELL_PAD)
	grid.CellPadding = UDim2.fromOffset(CELL_PAD, CELL_PAD)
	grid.FillDirection = Enum.FillDirection.Horizontal
	grid.SortOrder = Enum.SortOrder.LayoutOrder
	grid.HorizontalAlignment = Enum.HorizontalAlignment.Center
	grid.VerticalAlignment = Enum.VerticalAlignment.Center
	grid.Parent = gridFrame

	for i = 1, 6 do
		local c = buildDayCard(gridFrame, i)
		c.LayoutOrder = i
	end

	-- ── RIGHT: Day 7 featured card ──────────────────────────────
	local day7Frame = Instance.new("Frame")
	day7Frame.Name = "Day7Frame"
	day7Frame.AnchorPoint = Vector2.new(1, 0)
	day7Frame.Size = UDim2.new(DAY7_W_SCALE, 0, 1, 0)
	day7Frame.Position = UDim2.fromScale(1, 0)
	day7Frame.BackgroundTransparency = 1
	day7Frame.ZIndex = 6
	day7Frame.Parent = cardsFrame

	local c7 = buildDayCard(day7Frame, 7)
	c7.Size = UDim2.fromScale(1, 1)

	-- ── BOTTOM: Timer + Claim ───────────────────────────────────
	_timerLabel = Instance.new("TextLabel")
	_timerLabel.AnchorPoint = Vector2.new(0.5, 1)
	_timerLabel.Position = UDim2.new(0.5, 0, 1, -48)
	_timerLabel.Size = UDim2.new(1, -20, 0, 18)
	_timerLabel.BackgroundTransparency = 1
	_timerLabel.Font = Enum.Font.GothamSemibold
	_timerLabel.TextColor3 = TIMER_WAIT
	_timerLabel.TextSize = 13
	_timerLabel.Text = "Loading..."
	_timerLabel.ZIndex = 7
	_timerLabel.Parent = content

	_claimButton = Instance.new("TextButton")
	_claimButton.Name = "ClaimButton"
	_claimButton.AnchorPoint = Vector2.new(0.5, 1)
	_claimButton.Position = UDim2.new(0.5, 0, 1, -8)
	_claimButton.Size = UDim2.new(0.45, 0, 0, 36)
	_claimButton.BackgroundColor3 = CLAIM_GREEN
	_claimButton.BorderSizePixel = 0
	_claimButton.Font = Enum.Font.GothamBold
	_claimButton.TextColor3 = Color3.fromRGB(255, 255, 255)
	_claimButton.TextSize = 16
	_claimButton.Text = "CLAIM REWARD"
	_claimButton.AutoButtonColor = true
	_claimButton.ZIndex = 7
	_claimButton.Parent = content
	Instance.new("UICorner", _claimButton).CornerRadius = UDim.new(0, 10)
	local btnStroke = Instance.new("UIStroke")
	btnStroke.Color = Color3.fromRGB(255, 206, 120)
	btnStroke.Thickness = 1.5
	btnStroke.Transparency = 0.5
	btnStroke.Parent = _claimButton

	_claimButton.MouseButton1Click:Connect(onClaim)

	log("Initialized")
end

-- ═══════════════════════════════════════════════════════════════════
-- SHOW / HIDE / TOGGLE
-- ═══════════════════════════════════════════════════════════════════

function DailyRewardsPanel.Show()
	if visible then return end
	visible = true
	overlay.Visible = true
	SoundUtil.Open()
	AnimUtil.OpenPanel(canvas, uiScale)
	startBgFadeLoop()

	task.spawn(function()
		_status = fetchStatus()
		if _status then
			updateDayCards(_status)
			startTimerLoop()
		end
	end)
end

function DailyRewardsPanel.Hide()
	if not visible then return end
	visible = false
	stopBgFadeLoop()
	stopTimerLoop()
	overlay.Visible = false
	local t = AnimUtil.ClosePanel(canvas, uiScale)
	task.spawn(function()
		t.Completed:Wait()
		canvas.Visible = false
	end)
	if closeCallback then closeCallback() end
end

function DailyRewardsPanel.IsVisible()
	return visible
end

function DailyRewardsPanel.Toggle()
	if visible then DailyRewardsPanel.Hide() else DailyRewardsPanel.Show() end
end

function DailyRewardsPanel.TryAutoShow(openerFn)
	if _hasAutoShown then return end
	_hasAutoShown = true
	local doOpen = openerFn or function() DailyRewardsPanel.Show() end
	task.spawn(function()
		task.wait(2)
		if FORCE_OPEN_DAILY_ON_JOIN then
			log("FORCE_OPEN: auto-opening Daily Rewards")
			doOpen()
			return
		end
		-- Retry until PlayerData is loaded on the server (up to ~18 s total)
		local MAX_ATTEMPTS = 6
		local RETRY_WAIT  = 3
		for attempt = 1, MAX_ATTEMPTS do
			local status = fetchStatus()
			if status then
				if status.canClaim then
					log(string.format("Auto-opening: reward available (attempt %d)", attempt))
					doOpen()
					return
				elseif status.dataLoaded ~= false then
					-- Data is fully loaded but no reward is available yet
					log("Auto-show: data loaded, no reward available")
					return
				end
				log(string.format("Auto-show: data not loaded yet (attempt %d/%d), retrying in %ds", attempt, MAX_ATTEMPTS, RETRY_WAIT))
			end
			if attempt < MAX_ATTEMPTS then
				task.wait(RETRY_WAIT)
			end
		end
		log("Auto-show: gave up waiting for data after " .. MAX_ATTEMPTS .. " attempts")
	end)
end

return DailyRewardsPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="150">
            <Properties>
              <string name="Name">EmoteShopPanel</string>
              <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local MarketplaceService = game:GetService("MarketplaceService")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared", 60)
if not Shared then
	warn("[EmoteShopPanel] Shared not found")
	return {
		Init = function() end,
		Show = function() end,
		Hide = function() end,
		IsVisible = function() return false end,
		Toggle = function() end,
	}
end

local UIConfig = require(Shared:WaitForChild("UIConfig"))

local Client = script.Parent
local AnimUtil = require(Client:WaitForChild("AnimUtil"))
local SoundUtil = require(Client:WaitForChild("SoundUtil"))
local Components = require(Client:WaitForChild("Components"))

local C = UIConfig.Colors
local LocalPlayer = Players.LocalPlayer

local EmoteShopPanel = {}

local HEADER_COLOR = Color3.fromRGB(58, 58, 58)
local PANEL_BG = Color3.fromRGB(28, 28, 28)
local PANEL_HEADER_BG = Color3.fromRGB(36, 36, 36)
local PANEL_STROKE = Color3.fromRGB(55, 55, 55)
local PANEL_STUD = Color3.fromRGB(112, 112, 112)
local CARD_BG = Color3.fromRGB(32, 32, 32)
local CARD_BG_ALT = Color3.fromRGB(45, 45, 45)
local CARD_STROKE = Color3.fromRGB(68, 68, 68)
local MESSAGE_TEXT = Color3.fromRGB(244, 244, 244)
local MUTED_TEXT = Color3.fromRGB(182, 182, 182)
local BADGE_BG = Color3.fromRGB(52, 52, 52)

local canvas: CanvasGroup? = nil
local uiScale: UIScale? = nil
local overlay: TextButton? = nil
local visible = false
local closeCallback: (() -> ())? = nil
local activeEmoteTrack: AnimationTrack? = nil
local activeEmoteAnimationId: string? = nil
local emoteButtons: { [string]: TextButton } = {}
local emoteOwnedLocal: { [string]: boolean } = {}
local emoteDataById: { [string]: { [string]: any } } = {}
local emoteIdByAssetId: { [number]: string } = {}
local ownershipCheckInFlight: { [string]: boolean } = {}
local pendingPurchaseByAssetId: { [number]: { emoteId: string, emoteName: string, startedAt: number } } = {}

local function showEmoteShopToast(message: string)
	if not canvas or not canvas.Parent then
		return
	end

	local old = canvas:FindFirstChild("EmoteShopToast")
	if old then
		old:Destroy()
	end

	local toast = Instance.new("TextLabel")
	toast.Name = "EmoteShopToast"
	toast.AnchorPoint = Vector2.new(0.5, 1)
	toast.Position = UDim2.new(0.5, 0, 1, -14)
	toast.Size = UDim2.new(0, 360, 0, 38)
	toast.BackgroundColor3 = Color3.fromRGB(20, 24, 42)
	toast.BackgroundTransparency = 0.08
	toast.TextColor3 = Color3.fromRGB(255, 255, 255)
	toast.Font = Enum.Font.LuckiestGuy
	toast.TextSize = 15
	toast.Text = tostring(message or "")
	toast.BorderSizePixel = 0
	toast.ZIndex = 120
	toast.Parent = canvas
	Instance.new("UICorner", toast).CornerRadius = UDim.new(0, 10)

	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(0, 0, 0)
	stroke.Thickness = 1.2
	stroke.Transparency = 0.25
	stroke.Parent = toast

	task.delay(2.2, function()
		if toast and toast.Parent then
			toast:Destroy()
		end
	end)
end

type EmotePurchaseInfo = {
	promptType: "asset" | "none",
	id: number,
}

local function getEmotePurchaseInfo(emoteData): EmotePurchaseInfo
	if type(emoteData) ~= "table" then
		return { promptType = "none", id = 0 }
	end

	local explicitType = string.lower(tostring(emoteData.purchaseType or emoteData.productType or ""))
	local assetId = tonumber(emoteData.assetId or emoteData.emoteAssetId) or 0

	if explicitType == "asset" and assetId > 0 then
		return { promptType = "asset", id = assetId }
	end

	-- Emote shop uses third-party asset purchase prompts.
	if assetId > 0 then
		return { promptType = "asset", id = assetId }
	end

	return { promptType = "none", id = 0 }
end

local function isEmoteOwned(emoteId: string): boolean
	return emoteOwnedLocal[emoteId] == true
end

local function applyActionButtonColor(button: TextButton, color: Color3)
	button.BackgroundColor3 = color

	local gradient = button:FindFirstChildWhichIsA("UIGradient")
	if gradient then
		local abr, abg, abb = color.R, color.G, color.B
		local lighter = Color3.new(
			math.min(abr + 0.20, 1),
			math.min(abg + 0.20, 1),
			math.min(abb + 0.20, 1)
		)
		local darker = Color3.new(
			math.max(abr - 0.10, 0),
			math.max(abg - 0.10, 0),
			math.max(abb - 0.10, 0)
		)
		gradient.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, lighter),
			ColorSequenceKeypoint.new(0.5, color),
			ColorSequenceKeypoint.new(1, darker),
		})
	end
end

local function refreshEmoteCard(emoteId: string)
	local button = emoteButtons[emoteId]
	local emoteData = emoteDataById[emoteId]
	if not button or not emoteData then
		return
	end

	if isEmoteOwned(emoteId) then
		local buyGroup = button:FindFirstChild("RobuxBuyGroup")
		if buyGroup then
			buyGroup:Destroy()
		end
		button.Text = "Use"
		applyActionButtonColor(button, C.EquipButton)
	else
		local robuxAmount = tostring(tonumber(emoteData.robux) or 99)
		button.Text = string.format("%s ROBUX", robuxAmount)
		applyActionButtonColor(button, C.RobuxButton)
		Components.ApplyRobuxBuyStyle(button, robuxAmount)
	end
end

local function refreshEmoteOwnership(emoteId: string, optimisticOwned: boolean?): boolean
	local emoteData = emoteDataById[emoteId]
	if not emoteData then
		return false
	end

	local owned = optimisticOwned == true
	local purchase = getEmotePurchaseInfo(emoteData)
	if not owned and not ownershipCheckInFlight[emoteId] then
		ownershipCheckInFlight[emoteId] = true
		if purchase.promptType == "asset" and purchase.id > 0 then
			local ok, owns = pcall(function()
				return MarketplaceService:PlayerOwnsAsset(LocalPlayer, purchase.id)
			end)
			if ok then
				owned = owns == true
			else
				warn(string.format("[EmoteShopPanel] Asset ownership check failed for %s (%d): %s",
					tostring(emoteData.name), purchase.id, tostring(owns)))
			end
		end
		ownershipCheckInFlight[emoteId] = nil
	end

	emoteOwnedLocal[emoteId] = owned
	refreshEmoteCard(emoteId)
	return owned
end

local function refreshAllEmoteOwnership()
	for emoteId in pairs(emoteDataById) do
		refreshEmoteOwnership(emoteId)
	end
end

local function stopActiveEmote(fadeTime: number?)
	if activeEmoteTrack then
		pcall(function()
			activeEmoteTrack:Stop(fadeTime or 0.15)
		end)
		activeEmoteTrack = nil
		activeEmoteAnimationId = nil
	end
end

local function getLocalAnimator(): Animator?
	local player = Players.LocalPlayer
	local character = player and player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return nil
	end

	local animator = humanoid:FindFirstChildOfClass("Animator")
	if animator then
		return animator
	end

	animator = Instance.new("Animator")
	animator.Parent = humanoid
	return animator
end

local function playLocalEmote(emoteData)
	if type(emoteData) ~= "table" or type(emoteData.animationId) ~= "string" or emoteData.animationId == "" then
		return
	end

	if activeEmoteTrack and activeEmoteTrack.IsPlaying and activeEmoteAnimationId == emoteData.animationId then
		stopActiveEmote(0.12)
		return
	end

	local animator = getLocalAnimator()
	if not animator then
		warn(string.format("[EmoteShopPanel] Could not play emote '%s' - animator unavailable", tostring(emoteData.name)))
		return
	end

	stopActiveEmote(0.08)

	local animation = Instance.new("Animation")
	animation.AnimationId = emoteData.animationId

	local ok, track = pcall(function()
		return animator:LoadAnimation(animation)
	end)
	animation:Destroy()

	if not ok or not track then
		warn(string.format("[EmoteShopPanel] Failed to load emote '%s': %s", tostring(emoteData.name), tostring(track)))
		return
	end

	track.Priority = Enum.AnimationPriority.Action4
	track.Looped = true

	local playOk, playErr = pcall(function()
		track:Play(0.15, 1, 1)
	end)
	if not playOk then
		warn(string.format("[EmoteShopPanel] Failed to play emote '%s': %s", tostring(emoteData.name), tostring(playErr)))
		return
	end

	activeEmoteTrack = track
	activeEmoteAnimationId = emoteData.animationId

	track.Stopped:Connect(function()
		if activeEmoteTrack == track then
			activeEmoteTrack = nil
			activeEmoteAnimationId = nil
		end
	end)
end

local function handleEmoteAction(emoteData)
	if type(emoteData) ~= "table" or type(emoteData.id) ~= "string" then
		return
	end

	if isEmoteOwned(emoteData.id) then
		playLocalEmote(emoteData)
		return
	end

	local purchase = getEmotePurchaseInfo(emoteData)
	print(string.format(
		"[EmoteShopPanel] Buy clicked emote=%s id=%s promptType=%s assetId=%d",
		tostring(emoteData.name),
		tostring(emoteData.id),
		purchase.promptType,
		purchase.id
	))

	if purchase.promptType == "none" or purchase.id <= 0 then
		warn(string.format("[EmoteShopPanel] Purchase blocked emote=%s id=%s reason=missing_product_config",
			tostring(emoteData.name), tostring(emoteData.id)))
		return
	end

	if purchase.promptType == "asset" then
		pendingPurchaseByAssetId[purchase.id] = {
			emoteId = emoteData.id,
			emoteName = tostring(emoteData.name or emoteData.id),
			startedAt = os.clock(),
		}
		print(string.format(
			"[EmoteShopPanel] PromptPurchase request emote=%s id=%s assetId=%d studio=%s",
			tostring(emoteData.name),
			tostring(emoteData.id),
			purchase.id,
			tostring(RunService:IsStudio())
		))
		local okPrompt, promptErr = pcall(function()
			MarketplaceService:PromptPurchase(LocalPlayer, purchase.id)
		end)
		if not okPrompt then
			pendingPurchaseByAssetId[purchase.id] = nil
			warn(string.format(
				"[EmoteShopPanel] PromptPurchase failed emote=%s id=%s assetId=%d error=%s studio=%s",
				tostring(emoteData.name),
				tostring(emoteData.id),
				purchase.id,
				tostring(promptErr),
				tostring(RunService:IsStudio())
			))
			if RunService:IsStudio() then
				showEmoteShopToast("Purchase prompt unavailable in this Studio test mode.")
			else
				showEmoteShopToast("Couldn't open purchase prompt. Please try again.")
			end
		end
	end
end

function EmoteShopPanel.Init(screenGui: ScreenGui, onClose: () -> ())
	closeCallback = onClose
	print("[EmoteShopPanel] Init complete (client asset purchase flow)")

	overlay = Components.CreateDimOverlay(screenGui, function()
		EmoteShopPanel.Hide()
	end)

	local content: ScrollingFrame
	local closeBtn: TextButton
	canvas, uiScale, content, closeBtn = Components.CreatePanel(screenGui, "EMOTE SHOP", HEADER_COLOR, "Icons")
	canvas.Size = UDim2.fromScale(0.52, 0.46)
	canvas.BackgroundColor3 = PANEL_BG
	content.AutomaticCanvasSize = Enum.AutomaticSize.Y
	content.ScrollingEnabled = true
	content.CanvasSize = UDim2.fromScale(0, 1)
	content.ScrollBarThickness = 0
	content.ScrollBarImageColor3 = PANEL_STROKE

	local panelStroke = canvas:FindFirstChildWhichIsA("UIStroke")
	if panelStroke then
		panelStroke.Color = PANEL_STROKE
		panelStroke.Transparency = 0.08
	end

	local centerGlow = canvas:FindFirstChild("CenterGlow")
	if centerGlow then
		centerGlow:Destroy()
	end

	local sunburst = canvas:FindFirstChild("Sunburst")
	if sunburst then
		sunburst:Destroy()
	end

	for _, child in ipairs(canvas:GetChildren()) do
		if string.match(child.Name, "^Sparkle") then
			child:Destroy()
		end
	end

	local studTexture = canvas:FindFirstChild("StudTexture")
	if studTexture and studTexture:IsA("ImageLabel") then
		studTexture.ImageColor3 = PANEL_STUD
		studTexture.ImageTransparency = 0.9
		studTexture.TileSize = UDim2.fromOffset(72, 72)
	end

	local header = canvas:FindFirstChild("Header")
	if header and header:IsA("Frame") then
		header.BackgroundColor3 = PANEL_HEADER_BG

		local bottomMask = header:FindFirstChild("BottomMask")
		if bottomMask and bottomMask:IsA("Frame") then
			bottomMask.BackgroundColor3 = PANEL_HEADER_BG
		end

		local highlightLine = header:FindFirstChild("HighlightLine")
		if highlightLine and highlightLine:IsA("Frame") then
			highlightLine.BackgroundColor3 = Color3.fromRGB(148, 148, 148)
			highlightLine.BackgroundTransparency = 0.82
		end

		local titleLabel = header:FindFirstChild("Title")
		if titleLabel and titleLabel:IsA("TextLabel") then
			titleLabel.TextColor3 = MESSAGE_TEXT
		end
	end

	closeBtn.BackgroundColor3 = C.CloseBtn
	closeBtn.TextColor3 = C.TextWhite
	local closeStroke = closeBtn:FindFirstChildWhichIsA("UIStroke")
	if closeStroke then
		closeStroke.Color = Color3.fromRGB(255, 255, 255)
		closeStroke.Transparency = 0.35
	end

	AnimUtil.WireButton(closeBtn, function()
		EmoteShopPanel.Hide()
	end)

	local wrapper = Instance.new("Frame")
	wrapper.Name = "Wrapper"
	wrapper.AnchorPoint = Vector2.new(0.5, 0)
	wrapper.Position = UDim2.new(0.5, 0, 0, 12)
	wrapper.Size = UDim2.new(1, -12, 0, 0)
	wrapper.AutomaticSize = Enum.AutomaticSize.Y
	wrapper.BackgroundTransparency = 1
	wrapper.BorderSizePixel = 0
	wrapper.Parent = content

	local bodyLayout = Instance.new("UIListLayout")
	bodyLayout.FillDirection = Enum.FillDirection.Vertical
	bodyLayout.Padding = UDim.new(0, 14)
	bodyLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	bodyLayout.VerticalAlignment = Enum.VerticalAlignment.Top
	bodyLayout.Parent = wrapper

	local gridHolder = Instance.new("Frame")
	gridHolder.Name = "EmoteGrid"
	gridHolder.Size = UDim2.new(1, -8, 0, 0)
	gridHolder.AutomaticSize = Enum.AutomaticSize.Y
	gridHolder.BackgroundTransparency = 1
	gridHolder.BorderSizePixel = 0
	gridHolder.LayoutOrder = 1
	gridHolder.Parent = wrapper

	local grid = Components.AddGridLayout(gridHolder)
	grid:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
		gridHolder.Size = UDim2.new(1, -8, 0, grid.AbsoluteContentSize.Y + 16)
	end)

	for _, emoteData in ipairs(UIConfig.MockEmotes or {}) do
		emoteDataById[emoteData.id] = emoteData
		local purchase = getEmotePurchaseInfo(emoteData)
		if purchase.promptType == "asset" and purchase.id > 0 then
			emoteIdByAssetId[purchase.id] = emoteData.id
		else
			warn(string.format("[EmoteShopPanel] Missing purchase config emote=%s id=%s",
				tostring(emoteData.name), tostring(emoteData.id)))
		end

		local card = Components.CreateItemCard(gridHolder, {
			name = tostring(emoteData.name or "Emote"),
			rarity = "Common",
			iconColor = Color3.fromRGB(72, 72, 72),
			iconText = string.sub(tostring(emoteData.name or "E"), 1, 1),
			image = tostring(emoteData.icon or ""),
			actionText = string.format("%d ROBUX", tonumber(emoteData.robux) or 99),
			actionColor = C.RobuxButton,
			tag = tostring(emoteData.tag or ""),
			subLabel = "Emote",
			onAction = function()
				handleEmoteAction(emoteData)
			end,
		})

		local rarityLabel = card:FindFirstChild("Rarity")
		if rarityLabel and rarityLabel:IsA("TextLabel") then
			rarityLabel:Destroy()
		end

		local subLabel = card:FindFirstChild("SubLabel")
		if subLabel and subLabel:IsA("TextLabel") then
			subLabel.Position = UDim2.new(0, 5, 0, 121)
		end

		local actionBtn = card:FindFirstChild("ActionBtn")
		if actionBtn and actionBtn:IsA("TextButton") then
			emoteButtons[emoteData.id] = actionBtn
		end

		refreshEmoteCard(emoteData.id)
	end

	refreshAllEmoteOwnership()

	Players.LocalPlayer.CharacterAdded:Connect(function()
		stopActiveEmote(0.08)
	end)

	MarketplaceService.PromptPurchaseFinished:Connect(function(player, assetId, wasPurchased)
		if player ~= LocalPlayer then
			return
		end
		local resolvedAssetId = tonumber(assetId)
		if not resolvedAssetId or resolvedAssetId <= 0 then
			return
		end
		local pending = pendingPurchaseByAssetId[resolvedAssetId]
		local elapsedMs = 0
		if pending and type(pending.startedAt) == "number" then
			elapsedMs = math.floor((os.clock() - pending.startedAt) * 1000)
		end
		print(string.format(
			"[EmoteShopPanel] PromptPurchaseFinished assetId=%d purchased=%s emote=%s emoteId=%s elapsedMs=%d studio=%s",
			resolvedAssetId,
			tostring(wasPurchased == true),
			tostring(pending and pending.emoteName or "unknown"),
			tostring(pending and pending.emoteId or "unknown"),
			elapsedMs,
			tostring(RunService:IsStudio())
		))
		pendingPurchaseByAssetId[resolvedAssetId] = nil

		if wasPurchased ~= true then
			if RunService:IsStudio() then
				showEmoteShopToast("Purchase not completed. Studio Start Server/Player may block third-party prompts.")
			end
			return
		end
		local emoteId = emoteIdByAssetId[resolvedAssetId]
		if not emoteId then
			return
		end
		emoteOwnedLocal[emoteId] = true
		refreshEmoteCard(emoteId)
		task.delay(0.5, function()
			refreshEmoteOwnership(emoteId, true)
		end)
	end)
end

function EmoteShopPanel.Show()
	if not canvas or not uiScale or not overlay or visible then
		return
	end

	visible = true
	overlay.Visible = true
	print("[EmoteShopPanel] Opened")
	refreshAllEmoteOwnership()
	SoundUtil.Open()
	AnimUtil.OpenPanel(canvas, uiScale)
end

function EmoteShopPanel.Hide()
	if not canvas or not uiScale or not overlay or not visible then
		return
	end

	visible = false
	overlay.Visible = false
	stopActiveEmote(0.12)
	local tween = AnimUtil.ClosePanel(canvas, uiScale)
	task.spawn(function()
		tween.Completed:Wait()
		if canvas then
			canvas.Visible = false
		end
	end)

	if closeCallback then
		closeCallback()
	end
end

function EmoteShopPanel.IsVisible(): boolean
	return visible
end

function EmoteShopPanel.Toggle()
	if visible then
		EmoteShopPanel.Hide()
	else
		EmoteShopPanel.Show()
	end
end

return EmoteShopPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="151">
            <Properties>
              <string name="Name">FateCrownsPanel</string>
              <string name="Source"><![CDATA[--[[
	FateCrownsPanel
	Crown collection / equip grid — shows ALL 17 crowns organized by source.

	Display order:
	  • Level Crowns   (earned by wins milestones)
	  • Findable Crowns (from Crown Crate / Spin Wheel)
	  • Exclusive Crowns (Shop-only, Robux)

	Each card:
	  • ViewportFrame showing the 3D crown model
	  • Owned = full color + Equip button (server-wired)
	  • Unowned = greyed/locked + source label:
	      Level → "X Wins"
	      Findable → "Crown Crate"
	      Exclusive → "Shop Only"

	Data source: ItemCatalog.GetAllCrownsSorted()
	Ownership:   Player "OwnedCrowns" attribute (JSON array of catalog IDs)

	Used by: UIController (sidebar "Crowns" button)
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")
local MarketplaceService = game:GetService("MarketplaceService")

local Shared = ReplicatedStorage:WaitForChild("Shared", 60)
if not Shared then
	warn("[FateCrownsPanel] Shared not found after 60s -- disabled")
	return { Init = function() end, Show = function() end, Hide = function() end,
		IsVisible = function() return false end, Toggle = function() end }
end

local CDPModule = Shared:WaitForChild("ClientDepsProvider", 60)
if not CDPModule then
	warn("[FateCrownsPanel] ClientDepsProvider MISSING")
	return { Init = function() end, Show = function() end, Hide = function() end,
		IsVisible = function() return false end, Toggle = function() end }
end

local ok, Deps = pcall(require, CDPModule)
if not ok or not Deps then
	warn("[FateCrownsPanel] require(ClientDepsProvider) FAILED:", Deps)
	return { Init = function() end, Show = function() end, Hide = function() end,
		IsVisible = function() return false end, Toggle = function() end }
end
local UIConfig = Deps.UIConfig
local ItemCatalog = Deps.ItemCatalog

-- Build a crownId → gamepassId map from MockPremiumItems so the inventory
-- can fall back to gamepass ownership for exclusive crowns (same source as Shop).
local _crownGamepassMap: {[string]: number} = {}
for _, item in ipairs(UIConfig.MockPremiumItems) do
	if item.type == "ExclusiveCrown" and item.gamepassId and item.id then
		_crownGamepassMap[item.id] = item.gamepassId
	end
end

local Client = script.Parent
local AnimUtil   = require(Client:WaitForChild("AnimUtil"))
local SoundUtil  = require(Client:WaitForChild("SoundUtil"))
local Components = require(Client:WaitForChild("Components"))

local C = UIConfig.Colors

local player = Players.LocalPlayer

local canvas: CanvasGroup = nil
local uiScale: UIScale = nil
local overlay: Frame = nil
local contentFrame: ScrollingFrame = nil
local visible = false
local closeCallback: (() -> ())? = nil

local equippedId: string? = nil

local FateCrownsPanel = {}

local function getOwnedCrownSet(): { [string]: boolean }
	local json = player:GetAttribute("OwnedCrowns") or "[]"
	local okDec, list = pcall(HttpService.JSONDecode, HttpService, json)
	if not okDec or type(list) ~= "table" then list = {} end
	local set = {}
	for _, id in ipairs(list) do
		set[id] = true
	end
	-- Ownership is inventory-driven only; server grant confirmation updates attributes.
	return set
end

local function getEquipRemote(): RemoteEvent?
	local remotes = ReplicatedStorage:FindFirstChild("Remotes")
	if not remotes then return nil end
	return remotes:FindFirstChild("EquipItem")
end

local function getUnequipRemote(): RemoteEvent?
	local remotes = ReplicatedStorage:FindFirstChild("Remotes")
	if not remotes then return nil end
	return remotes:FindFirstChild("UnequipItem")
end

local function clearContent()
	for _, child in ipairs(contentFrame:GetChildren()) do
		if child:IsA("Frame") then child:Destroy() end
	end
end

--- Build a sub-label for unowned crowns based on source (delegates to ItemCatalog)
local function getSubLabel(crown): string?
	return ItemCatalog.GetCrownAcquisitionLabel(crown.id)
end

local function refresh()
	clearContent()

	local ownedSet = getOwnedCrownSet()
	equippedId = player:GetAttribute("EquippedCrown") or nil
	local allCrowns = ItemCatalog.GetAllCrownsSorted()
	for _, crown in ipairs(allCrowns) do
		if crown.name == "Aura Crown" then
			print(string.format("[CrownCatalog] AuraCrown id=%s", tostring(crown.id)))
			break
		end
	end

	for i, crown in ipairs(allCrowns) do
		local isOwned = ownedSet[crown.id] == true
		local isEquipped = isOwned and (crown.id == equippedId)
		local actionText = nil
		local actionColor = nil
		local subLabel = nil

		if isOwned then
			actionText = isEquipped and "Equipped" or "Equip"
			actionColor = isEquipped and C.Green or C.EquipButton
		else
			subLabel = getSubLabel(crown)
		end

		Components.CreateViewportItemCard(contentFrame, {
			name = crown.name,
			rarity = crown.rarity,
			iconColor = crown.iconColor,
			thumbnailBgColor = crown.thumbnailBgColor,
			iconText = crown.iconText or "",
			image = ItemCatalog.GetImage(crown),
			modelPath = crown.modelPath,
			locked = not isOwned,
			equipped = isEquipped,
			owned = isOwned,
			subLabel = subLabel,
			actionText = actionText,
			actionColor = actionColor,
			onAction = function()
				if isOwned then
					if isEquipped then
						-- Unequip
						local unequipRemote = getUnequipRemote()
						if unequipRemote then
							unequipRemote:FireServer("Crowns")
						end
						equippedId = nil
					else
						-- Equip via server
						local equipRemote = getEquipRemote()
						if equipRemote then
							equipRemote:FireServer("Crowns", crown.id)
						end
						equippedId = crown.id
					end
					SoundUtil.Equip()
					refresh()
				end
			end,
		}).LayoutOrder = i
	end
end

function FateCrownsPanel.Init(screenGui: ScreenGui, onClose: () -> ())
	closeCallback = onClose

	overlay = Components.CreateDimOverlay(screenGui, function()
		FateCrownsPanel.Hide()
	end)

	local content, closeBtn
	canvas, uiScale, content, closeBtn = Components.CreatePanel(screenGui, "FATE CROWNS", C.HeaderCrowns, "Crowns")
	contentFrame = content

	Components.AddGridLayout(content)

	closeBtn.MouseButton1Click:Connect(function()
		SoundUtil.Close()
		FateCrownsPanel.Hide()
	end)

	-- Override stud texture to Fate Beams asset (only this panel)
	do
		local stud = canvas:FindFirstChild("StudTexture")
		if stud then
			stud.Image = "rbxassetid://84772207963553"
			stud.TileSize = UDim2.fromOffset(96, 96)
			stud.ImageTransparency = 0.88
			stud.ImageColor3 = Color3.fromRGB(255, 255, 255)
		end
	end

	-- Refresh when ownership/equip changes
	player:GetAttributeChangedSignal("OwnedCrowns"):Connect(function()
		if visible then refresh() end
	end)
	player:GetAttributeChangedSignal("EquippedCrown"):Connect(function()
		if visible then refresh() end
	end)

	-- Also listen for InventoryUpdated remote
	task.spawn(function()
		local remotes = ReplicatedStorage:WaitForChild("Remotes", 10)
		if remotes then
			local invUpdate = remotes:FindFirstChild("InventoryUpdated")
			if invUpdate and invUpdate:IsA("RemoteEvent") then
				invUpdate.OnClientEvent:Connect(function()
					if visible then refresh() end
				end)
			end
		end
	end)

	refresh()
end

function FateCrownsPanel.Show()
	if visible then return end
	visible = true
	overlay.Visible = true
	refresh()
	SoundUtil.Open()
	AnimUtil.OpenPanel(canvas, uiScale)
end

function FateCrownsPanel.Hide()
	if not visible then return end
	visible = false
	overlay.Visible = false
	local t = AnimUtil.ClosePanel(canvas, uiScale)
	task.spawn(function()
		t.Completed:Wait()
		canvas.Visible = false
	end)
	if closeCallback then closeCallback() end
end

function FateCrownsPanel.IsVisible(): boolean
	return visible
end

function FateCrownsPanel.Toggle()
	if visible then FateCrownsPanel.Hide() else FateCrownsPanel.Show() end
end

return FateCrownsPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="152">
            <Properties>
              <string name="Name">ForceNextModePanel</string>
              <string name="Source"><![CDATA[--[[
	ForceNextModePanel
	Separate client-side purchase UI for the FORCE NEXT MODE! developer product.

	Uses the same mode choices as the real vote panel, but never casts votes.
	Selecting a mode only requests the server-authoritative purchase prompt.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local UIConfig = require(Shared:WaitForChild("UIConfig"))
local AnimUtil = require(script.Parent:WaitForChild("AnimUtil"))

local ForceNextModePanel = {}

local player = Players.LocalPlayer
local initialized = false
local visible = false
local closeCallback = nil

local gui: ScreenGui? = nil
local backdropFrame: Frame? = nil
local panelFrame: Frame? = nil
local titleLabel: TextLabel? = nil
local subtitleLabel: TextLabel? = nil
local promptRemote: RemoteEvent? = nil
local stateValue: StringValue? = nil
local voteActiveValue: BoolValue? = nil
local panelScaleTween: Tween? = nil
local panelBackgroundTween: Tween? = nil
local lifecycleVersion = 0

local VOTE_DISPLAY_ORDER = 151
local MODAL_DISPLAY_ORDER = VOTE_DISPLAY_ORDER + 1
local BACKDROP_ZINDEX = 20
local PANEL_ZINDEX = 30
local ANIM = UIConfig.Anim

local PANEL_BG = Color3.fromRGB(30, 30, 30)
local HEADER_COLOR = Color3.fromRGB(255, 215, 48)
local BTN_NORMAL_COLOR = Color3.fromRGB(50, 160, 80)
local BTN_BRAINROT_COLOR = Color3.fromRGB(178, 48, 255)
local TEXT_COLOR = Color3.fromRGB(255, 255, 255)
local BACKDROP_BG = Color3.fromRGB(0, 0, 0)
local BACKDROP_TRANSPARENCY = 0.45
local PANEL_BG_TRANSPARENCY = 0
local PANEL_STROKE_COLOR = Color3.fromRGB(255, 255, 255)
local PANEL_STROKE_TRANSPARENCY = 0.3
local STUD_TEXTURE_TRANSPARENCY = 0.88
local BUTTON_BG_TRANSPARENCY = 0.08
local BUTTON_OVERLAY_TRANSPARENCY = 0.5
local CLOSE_BTN_TRANSPARENCY = 0.1
local ROBUX_ICON_IMAGE = "rbxassetid://138917867019056"
local ROBUX_ICON_SIZE = 28

local NORMAL_MODE_IMAGE = "rbxassetid://90452980108887"
local BRAINROT_MODE_IMAGE = "rbxassetid://134040200136136"

local function log(...)
	print("[ForceNextModeUI]", ...)
end

local function setGuiPreferredEnabled(enabled: boolean)
	if gui then
		gui:SetAttribute("PreferredEnabled", enabled)
	end
end

local function isPlayingState(): boolean
	return stateValue ~= nil and stateValue.Value == "Playing"
end

local function getTimingSubtitle(): string
	local forFollowingMatch = voteActiveValue ~= nil and voteActiveValue.Value == true
	if forFollowingMatch then
		return "Choose a mode to buy a 5 Robux force for the following match."
	end
	return "Choose a mode to buy a 5 Robux force for the next match."
end

local function refreshSubtitle()
	if subtitleLabel then
		subtitleLabel.Text = getTimingSubtitle()
	end
end

local function cancelTween(tween: Tween?): Tween?
	if tween then
		pcall(function()
			tween:Cancel()
		end)
	end
	return nil
end

local function getPanelScale(): UIScale?
	if not panelFrame then
		return nil
	end

	local uiScale = panelFrame:FindFirstChildOfClass("UIScale")
	if uiScale and uiScale:IsA("UIScale") then
		return uiScale
	end

	uiScale = Instance.new("UIScale")
	uiScale.Parent = panelFrame
	return uiScale
end

local function logVisualState(stage: string)
	local uiScale = panelFrame and panelFrame:FindFirstChildOfClass("UIScale")
	log(string.format(
		"%s guiEnabled=%s panelVisible=%s panelBg=%.2f backdropVisible=%s backdropBg=%.2f scale=%.2f",
		stage,
		tostring(gui and gui.Enabled or false),
		tostring(panelFrame and panelFrame.Visible or false),
		panelFrame and panelFrame.BackgroundTransparency or -1,
		tostring(backdropFrame and backdropFrame.Visible or false),
		backdropFrame and backdropFrame.BackgroundTransparency or -1,
		uiScale and uiScale.Scale or -1
	))
end

local function ResetForceNextModeVisualState()
	panelScaleTween = cancelTween(panelScaleTween)
	panelBackgroundTween = cancelTween(panelBackgroundTween)

	if backdropFrame then
		backdropFrame.BackgroundColor3 = BACKDROP_BG
		backdropFrame.BackgroundTransparency = BACKDROP_TRANSPARENCY
		backdropFrame.Visible = true
		backdropFrame.Active = true
		backdropFrame.ZIndex = BACKDROP_ZINDEX
	end

	if not panelFrame then
		return
	end

	local uiScale = getPanelScale()
	if uiScale then
		uiScale.Scale = 1
	end

	panelFrame.BackgroundColor3 = PANEL_BG
	panelFrame.BackgroundTransparency = PANEL_BG_TRANSPARENCY
	panelFrame.Visible = true
	panelFrame.Active = true
	panelFrame.ZIndex = PANEL_ZINDEX

	local panelStroke = panelFrame:FindFirstChildWhichIsA("UIStroke")
	if panelStroke then
		panelStroke.Color = PANEL_STROKE_COLOR
		panelStroke.Thickness = 2
		panelStroke.Transparency = PANEL_STROKE_TRANSPARENCY
	end

	local studTex = panelFrame:FindFirstChild("StudTexture")
	if studTex and studTex:IsA("ImageLabel") then
		studTex.Visible = true
		studTex.ImageTransparency = STUD_TEXTURE_TRANSPARENCY
		studTex.ImageColor3 = Color3.fromRGB(255, 255, 255)
	end

	local closeBtn = panelFrame:FindFirstChild("CloseBtn")
	if closeBtn and closeBtn:IsA("TextButton") then
		closeBtn.Visible = true
		closeBtn.Active = true
		closeBtn.AutoButtonColor = true
		closeBtn.BackgroundTransparency = CLOSE_BTN_TRANSPARENCY
	end

	for _, buttonName in ipairs({ "BrainrotBtn", "NormalBtn" }) do
		local button = panelFrame:FindFirstChild(buttonName, true)
		if button and button:IsA("TextButton") then
			button.Visible = true
			button.Active = true
			button.AutoButtonColor = true
			button.BackgroundTransparency = BUTTON_BG_TRANSPARENCY

			local darkOverlay = button:FindFirstChild("DarkOverlay")
			if darkOverlay and darkOverlay:IsA("Frame") then
				darkOverlay.Visible = true
				darkOverlay.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
				darkOverlay.BackgroundTransparency = BUTTON_OVERLAY_TRANSPARENCY
			end
		end
	end

	logVisualState("ResetVisualState")
end

local function playOpenAnimation()
	local uiScale = getPanelScale()
	if not uiScale then
		return
	end

	panelScaleTween = cancelTween(panelScaleTween)
	panelBackgroundTween = cancelTween(panelBackgroundTween)

	uiScale.Scale = ANIM.PopupOpenStartScale
	panelScaleTween = AnimUtil.Tween(
		uiScale,
		{ Scale = 1 },
		ANIM.PopupOpenDuration,
		ANIM.PopupOpenEase,
		Enum.EasingDirection.Out
	)
end

local function playCloseAnimation(closeVersion: number)
	if not panelFrame then
		return
	end

	local uiScale = getPanelScale()
	panelScaleTween = cancelTween(panelScaleTween)
	panelBackgroundTween = cancelTween(panelBackgroundTween)

	if uiScale then
		panelScaleTween = AnimUtil.Tween(
			uiScale,
			{ Scale = ANIM.PopupCloseTargetScale },
			ANIM.PopupCloseDuration,
			ANIM.PopupCloseEase,
			Enum.EasingDirection.In
		)
	end

	panelBackgroundTween = AnimUtil.Tween(
		panelFrame,
		{ BackgroundTransparency = 1 },
		ANIM.PopupCloseDuration,
		Enum.EasingStyle.Quad,
		Enum.EasingDirection.In
	)

	logVisualState("HideStart")

	task.delay(ANIM.PopupCloseDuration, function()
		if lifecycleVersion ~= closeVersion or visible then
			log("Hide completion skipped due to newer lifecycle state")
			return
		end

		if gui then
			gui.Enabled = false
		end
		if backdropFrame then
			backdropFrame.Visible = false
		end
		if panelFrame then
			panelFrame.Visible = false
		end

		logVisualState("HideComplete")
	end)
end

local function hidePanel()
	if not visible then
		log("Hide skipped: panel already closed")
		return
	end

	visible = false
	setGuiPreferredEnabled(false)
	lifecycleVersion += 1
	playCloseAnimation(lifecycleVersion)

	log("Hidden")
	if closeCallback then
		closeCallback()
	end
end

local function requestForceMode(requestedMode: string)
	if promptRemote then
		promptRemote:FireServer(requestedMode)
	end
	log("Prompt requested for mode:", requestedMode)
	hidePanel()
end

local function createChoiceButton(
	parent: Instance,
	name: string,
	label: string,
	imageId: string,
	bgColor: Color3,
	layoutOrder: number,
	onClick: () -> ()
): TextButton
	local btn = Instance.new("TextButton")
	btn.Name = name
	btn.Size = UDim2.fromOffset(190, 124)
	btn.BackgroundColor3 = bgColor
	btn.BackgroundTransparency = 0.08
	btn.BorderSizePixel = 0
	btn.Text = ""
	btn.AutoButtonColor = true
	btn.LayoutOrder = layoutOrder
	btn.ClipsDescendants = true
	btn.ZIndex = PANEL_ZINDEX + 4
	btn.Parent = parent

	Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 12)

	local btnStroke = Instance.new("UIStroke")
	btnStroke.Color = Color3.fromRGB(60, 65, 85)
	btnStroke.Thickness = 2.5
	btnStroke.Transparency = 0.3
	btnStroke.Parent = btn

	local bgImage = Instance.new("ImageLabel")
	bgImage.Name = "BackgroundImage"
	bgImage.Position = UDim2.fromScale(0, 0)
	bgImage.Size = UDim2.fromScale(1, 1)
	bgImage.BackgroundTransparency = 1
	bgImage.Image = imageId
	bgImage.ScaleType = Enum.ScaleType.Crop
	bgImage.ZIndex = PANEL_ZINDEX + 5
	bgImage.Parent = btn

	local darkOverlay = Instance.new("Frame")
	darkOverlay.Name = "DarkOverlay"
	darkOverlay.Position = UDim2.fromScale(0, 0)
	darkOverlay.Size = UDim2.fromScale(1, 1)
	darkOverlay.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
	darkOverlay.BackgroundTransparency = 0.5
	darkOverlay.BorderSizePixel = 0
	darkOverlay.ZIndex = PANEL_ZINDEX + 6
	darkOverlay.Parent = btn

	local lblText = Instance.new("TextLabel")
	lblText.Name = "Label"
	lblText.AnchorPoint = Vector2.new(0.5, 0.5)
	lblText.Position = UDim2.fromScale(0.5, 0.42)
	lblText.Size = UDim2.new(1, -16, 0, 28)
	lblText.BackgroundTransparency = 1
	lblText.Font = Enum.Font.GothamBold
	lblText.TextColor3 = TEXT_COLOR
	lblText.TextSize = 15
	lblText.Text = label
	lblText.TextWrapped = true
	lblText.ZIndex = PANEL_ZINDEX + 7
	lblText.Parent = btn

	local lblStroke = Instance.new("UIStroke")
	lblStroke.Color = Color3.fromRGB(0, 0, 0)
	lblStroke.Thickness = 2
	lblStroke.Parent = lblText

	local buyRow = Instance.new("Frame")
	buyRow.Name = "BuyRow"
	buyRow.AnchorPoint = Vector2.new(0.5, 1)
	buyRow.Position = UDim2.new(0.5, 0, 1, -12)
	buyRow.Size = UDim2.new(1, -12, 0, 22)
	buyRow.BackgroundTransparency = 1
	buyRow.ZIndex = PANEL_ZINDEX + 7
	buyRow.Parent = btn

	local buyLayout = Instance.new("UIListLayout")
	buyLayout.FillDirection = Enum.FillDirection.Horizontal
	buyLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	buyLayout.VerticalAlignment = Enum.VerticalAlignment.Center
	buyLayout.Padding = UDim.new(0, 5)
	buyLayout.Parent = buyRow

	local buyIcon = Instance.new("ImageLabel")
	buyIcon.Name = "RobuxIcon"
	buyIcon.Size = UDim2.fromOffset(ROBUX_ICON_SIZE, ROBUX_ICON_SIZE)
	buyIcon.BackgroundTransparency = 1
	buyIcon.Image = ROBUX_ICON_IMAGE
	buyIcon.ImageColor3 = Color3.fromRGB(255, 255, 255)
	buyIcon.ScaleType = Enum.ScaleType.Fit
	buyIcon.ZIndex = PANEL_ZINDEX + 7
	buyIcon.Parent = buyRow

	local iconSizeConstraint = Instance.new("UISizeConstraint")
	iconSizeConstraint.MinSize = Vector2.new(ROBUX_ICON_SIZE, ROBUX_ICON_SIZE)
	iconSizeConstraint.MaxSize = Vector2.new(ROBUX_ICON_SIZE, ROBUX_ICON_SIZE)
	iconSizeConstraint.Parent = buyIcon

	local iconAspect = Instance.new("UIAspectRatioConstraint")
	iconAspect.AspectRatio = 1
	iconAspect.AspectType = Enum.AspectType.FitWithinMaxSize
	iconAspect.DominantAxis = Enum.DominantAxis.Width
	iconAspect.Parent = buyIcon

	local buyLbl = Instance.new("TextLabel")
	buyLbl.Name = "PriceLabel"
	buyLbl.AutomaticSize = Enum.AutomaticSize.X
	buyLbl.Size = UDim2.fromOffset(0, 22)
	buyLbl.BackgroundTransparency = 1
	buyLbl.Font = Enum.Font.LuckiestGuy
	buyLbl.TextColor3 = Color3.fromRGB(255, 240, 185)
	buyLbl.TextSize = 18
	buyLbl.Text = "5"
	buyLbl.ZIndex = PANEL_ZINDEX + 7
	buyLbl.Parent = buyRow

	local priceStroke = Instance.new("UIStroke")
	priceStroke.Color = Color3.fromRGB(0, 0, 0)
	priceStroke.Thickness = 1.5
	priceStroke.Parent = buyLbl

	btn.MouseEnter:Connect(function()
		TweenService:Create(darkOverlay, TweenInfo.new(0.15), { BackgroundTransparency = 0.64 }):Play()
	end)

	btn.MouseLeave:Connect(function()
		TweenService:Create(darkOverlay, TweenInfo.new(0.15), { BackgroundTransparency = 0.5 }):Play()
	end)

	btn.MouseButton1Click:Connect(onClick)

	return btn
end

local function createGui()
	if gui and gui.Parent then
		return
	end

	local playerGui = player:FindFirstChild("PlayerGui")
	if not playerGui then
		return
	end

	gui = Instance.new("ScreenGui")
	gui.Name = "ForceNextModeGui"
	gui.DisplayOrder = MODAL_DISPLAY_ORDER
	gui.IgnoreGuiInset = true
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Global
