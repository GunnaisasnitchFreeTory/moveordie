-- 15b. AbilitySellerLabelController (rainbow billboard text)
local abilityLabelOk, abilityLabelErr = pcall(function()
	local AbilitySellerLabelController = require(Client:WaitForChild("AbilitySellerLabelController"))
	AbilitySellerLabelController.Init()
end)
if abilityLabelOk then
	print("[Client] AbilitySellerLabelController loaded OK")
else
	warn("[Client] AbilitySellerLabelController FAILED:", abilityLabelErr)
end

-- BUILD_ID label (bottom-left corner, subtle version stamp)
pcall(function()
	local buildVal = ReplicatedStorage:WaitForChild("BUILD_ID", 10)
	if not buildVal then return end

	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")

	local screenGui = Instance.new("ScreenGui")
	screenGui.Name = "BuildLabel"
	screenGui.ResetOnSpawn = false
	screenGui.DisplayOrder = 999
	screenGui.IgnoreGuiInset = true
	screenGui.Parent = playerGui

	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(0, 300, 0, 20)
	label.Position = UDim2.new(0, 6, 1, -22)
	label.AnchorPoint = Vector2.new(0, 1)
	label.BackgroundTransparency = 1
	label.Text = buildVal.Value
	label.TextColor3 = Color3.fromRGB(180, 180, 180)
	label.TextTransparency = 0.5
	label.TextSize = 11
	label.Font = Enum.Font.RobotoMono
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Parent = screenGui

	buildVal.Changed:Connect(function(newVal)
		label.Text = newVal
	end)
end)

print(string.format("[Client] Init complete (t=%s)", ts()))
task.delay(2, logFinalRemoteContents)
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="112">
          <Properties>
            <string name="Name">AbilityActivationWarningController</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local AbilityActivationWarningController = {}

local LocalPlayer = Players.LocalPlayer
local warningGui: ScreenGui? = nil
local warningLabel: TextLabel? = nil
local hideToken = 0
local shownPosition = UDim2.new(0.5, 0, 0.6, 0)
local hiddenPosition = UDim2.new(0.5, 0, 0.625, 0)

local function ensureGui()
	if warningGui and warningLabel and warningGui.Parent then
		return
	end

	local playerGui = LocalPlayer:WaitForChild("PlayerGui")

	warningGui = Instance.new("ScreenGui")
	warningGui.Name = "AbilityActivationWarningGui"
	warningGui.ResetOnSpawn = false
	warningGui.IgnoreGuiInset = true
	warningGui.DisplayOrder = 160
	warningGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	warningGui.Parent = playerGui

	warningLabel = Instance.new("TextLabel")
	warningLabel.Name = "WarningLabel"
	warningLabel.AnchorPoint = Vector2.new(0.5, 0.5)
	warningLabel.Position = hiddenPosition
	warningLabel.Size = UDim2.new(0, 460, 0, 52)
	warningLabel.BackgroundTransparency = 1
	warningLabel.BorderSizePixel = 0
	warningLabel.Font = Enum.Font.GothamBlack
	warningLabel.TextColor3 = Color3.fromRGB(112, 255, 149)
	warningLabel.TextSize = 28
	warningLabel.TextStrokeColor3 = Color3.fromRGB(6, 24, 11)
	warningLabel.TextStrokeTransparency = 0.35
	warningLabel.TextWrapped = true
	warningLabel.TextTransparency = 1
	warningLabel.Visible = false
	warningLabel.ZIndex = 5
	warningLabel.Parent = warningGui
end

local function showWarning(message: string)
	ensureGui()
	if not warningLabel then
		return
	end

	hideToken += 1
	local token = hideToken

	warningLabel.Text = tostring(message or "")
	warningLabel.Position = hiddenPosition
	warningLabel.TextTransparency = 1
	warningLabel.Visible = true
	TweenService:Create(warningLabel, TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		TextTransparency = 0,
		Position = shownPosition,
	}):Play()

	task.delay(2.6, function()
		if token ~= hideToken or not warningLabel then
			return
		end
		local fade = TweenService:Create(warningLabel, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
			TextTransparency = 1,
			Position = hiddenPosition,
		})
		fade:Play()
		fade.Completed:Connect(function()
			if warningLabel and token == hideToken then
				warningLabel.Visible = false
			end
		end)
	end)
end

function AbilityActivationWarningController.Init()
	local remotes = ReplicatedStorage:WaitForChild("Remotes", 15)
	if not remotes then
		warn("[AbilityActivationWarningController] Remotes folder not found")
		return
	end

	local warningRemote = remotes:WaitForChild("AbilityActivationWarning", 15)
	if not warningRemote or not warningRemote:IsA("RemoteEvent") then
		warn("[AbilityActivationWarningController] AbilityActivationWarning remote missing")
		return
	end

	ensureGui()
	warningRemote.OnClientEvent:Connect(function(message: string)
		showWarning(message)
	end)
end

return AbilityActivationWarningController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="113">
          <Properties>
            <string name="Name">AbilitySellerLabelController</string>
            <string name="Source"><![CDATA[local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local AbilitySellerLabelController = {}

local trackedBillboards: { [BillboardGui]: boolean } = {}
local hue = 0
local started = false

local function trackBillboard(billboard: BillboardGui)
	if billboard.Name ~= "AbilityLabel" then
		return
	end
	trackedBillboards[billboard] = true
end

local function scanWorkspace()
	for _, desc in ipairs(Workspace:GetDescendants()) do
		if desc:IsA("BillboardGui") then
			trackBillboard(desc)
		end
	end
end

function AbilitySellerLabelController.Init()
	if started then
		return
	end
	started = true

	scanWorkspace()

	Workspace.DescendantAdded:Connect(function(desc)
		if desc:IsA("BillboardGui") then
			trackBillboard(desc)
		end
	end)

	RunService.RenderStepped:Connect(function(dt)
		hue = (hue + (dt * 1.0)) % 1
		local rainbow = Color3.fromHSV(hue, 1, 1)
		for billboard in pairs(trackedBillboards) do
			if billboard and billboard.Parent then
				local textLabel = billboard:FindFirstChild("TextLabel")
				if textLabel and textLabel:IsA("TextLabel") then
					textLabel.Font = Enum.Font.LuckiestGuy
					textLabel.Text = "Abilities"
					textLabel.TextScaled = false
					textLabel.TextSize = 28
					textLabel.TextStrokeTransparency = 0.5
					textLabel.TextColor3 = rainbow
				end
			else
				trackedBillboards[billboard] = nil
			end
		end
	end)
end

return AbilitySellerLabelController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="114">
          <Properties>
            <string name="Name">AnnouncementController</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local LocalPlayer = Players.LocalPlayer
local Shared = ReplicatedStorage:WaitForChild("Shared", 10)
local FeedbackConfig = require(Shared:WaitForChild("FeedbackConfig", 10))
local PlayerState = require(Shared:WaitForChild("PlayerState", 10))

local AnnouncementController = {}

type AnnouncementPayload = {
	text: string,
	style: string?,
	priority: number?,
	durationSeconds: number?,
	dedupeKey: string?,
	cooldownSeconds: number?,
	requiresInMatch: boolean?,
	soundId: string?,
}

type QueuedAnnouncement = AnnouncementPayload & {
	source: string,
	sequence: number,
}

local initialized = false
local announcementRemote: RemoteEvent? = nil
local playerGui: PlayerGui? = nil
local screenGui: ScreenGui? = nil
local announcementLabel: TextLabel? = nil
local announcementStroke: UIStroke? = nil
local queue: { QueuedAnnouncement } = {}
local activeAnnouncement: QueuedAnnouncement? = nil
local recentCooldownsByKey: { [string]: number } = {}
local sequenceCounter = 0
local activeToken = 0

local GUI_NAME = "SwordAnnouncement"
local LABEL_NAME = "AnnouncementLabel"

local function log(message: string)
	print("[AnnouncementController] " .. message)
end

local function isLocalPlayerInMatch(): boolean
	return LocalPlayer:GetAttribute("PlayerState") == PlayerState.States.InMatch
end

local function ensureGui()
	if screenGui and screenGui.Parent and announcementLabel and announcementStroke then
		return
	end

	playerGui = LocalPlayer:FindFirstChildOfClass("PlayerGui") or LocalPlayer:WaitForChild("PlayerGui", 10)
	if not playerGui then
		return
	end

	local existingGui = playerGui:FindFirstChild(GUI_NAME)
	if existingGui and existingGui:IsA("ScreenGui") then
		screenGui = existingGui
	else
		screenGui = Instance.new("ScreenGui")
		screenGui.Name = GUI_NAME
		screenGui.ResetOnSpawn = false
		screenGui.IgnoreGuiInset = true
		screenGui.DisplayOrder = FeedbackConfig.Announcements.DisplayOrder
		screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
		screenGui.Parent = playerGui
	end

	local existingLabel = screenGui:FindFirstChild(LABEL_NAME)
	if existingLabel and existingLabel:IsA("TextLabel") then
		announcementLabel = existingLabel
	else
		announcementLabel = Instance.new("TextLabel")
		announcementLabel.Name = LABEL_NAME
		announcementLabel.AnchorPoint = Vector2.new(0.5, 0)
		announcementLabel.Position = UDim2.new(0.5, 0, 0, FeedbackConfig.Announcements.YPosition)
		announcementLabel.Size = UDim2.new(1, -40, 0, FeedbackConfig.Announcements.LineHeight)
		announcementLabel.BackgroundTransparency = 1
		announcementLabel.Font = Enum.Font.GothamBold
		announcementLabel.TextSize = FeedbackConfig.Announcements.TextSize
		announcementLabel.TextWrapped = true
		announcementLabel.TextXAlignment = Enum.TextXAlignment.Center
		announcementLabel.TextYAlignment = Enum.TextYAlignment.Center
		announcementLabel.TextTransparency = 1
		announcementLabel.Visible = false
		announcementLabel.Parent = screenGui
	end

	local existingStroke = announcementLabel:FindFirstChildOfClass("UIStroke")
	if existingStroke then
		announcementStroke = existingStroke
	else
		announcementStroke = Instance.new("UIStroke")
		announcementStroke.Thickness = 2
		announcementStroke.Transparency = 1
		announcementStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
		announcementStroke.Parent = announcementLabel
	end
end

local function playSound(soundId: string?)
	if type(soundId) ~= "string" or soundId == "" then
		return
	end
	if not playerGui then
		return
	end

	local sound = Instance.new("Sound")
	sound.SoundId = soundId
	sound.Volume = 0.4
	sound.PlayOnRemove = false
	sound.Parent = playerGui
	sound:Play()
	task.delay(5, function()
		if sound and sound.Parent then
			sound:Destroy()
		end
	end)
end

local function getStyle(styleName: string?): { TextColor: Color3, StrokeColor: Color3 }
	local styles = FeedbackConfig.Announcements.Styles
	local key = if type(styleName) == "string" and styles[styleName] then styleName else "Default"
	return styles[key]
end

local function isDuplicate(entry: QueuedAnnouncement): boolean
	local dedupeKey = type(entry.dedupeKey) == "string" and entry.dedupeKey or ""
	if dedupeKey == "" then
		return false
	end

	local now = os.clock()
	local cooldownExpiry = recentCooldownsByKey[dedupeKey]
	if cooldownExpiry and cooldownExpiry > now then
		log(string.format("announcement_skipped reason=cooldown dedupeKey=%s source=%s", dedupeKey, entry.source))
		return true
	end

	if activeAnnouncement and activeAnnouncement.dedupeKey == dedupeKey then
		log(string.format("announcement_skipped reason=active_duplicate dedupeKey=%s source=%s", dedupeKey, entry.source))
		return true
	end

	for _, queued in ipairs(queue) do
		if queued.dedupeKey == dedupeKey then
			log(string.format("announcement_skipped reason=queued_duplicate dedupeKey=%s source=%s", dedupeKey, entry.source))
			return true
		end
	end

	return false
end

local function sortQueue()
	table.sort(queue, function(a, b)
		local aPriority = tonumber(a.priority) or 0
		local bPriority = tonumber(b.priority) or 0
		if aPriority == bPriority then
			return a.sequence < b.sequence
		end
		return aPriority > bPriority
	end)
end

local function hideActiveAnnouncement(reason: string)
	activeToken += 1
	activeAnnouncement = nil
	if announcementLabel then
		announcementLabel.Visible = false
		announcementLabel.TextTransparency = 1
	end
	if announcementStroke then
		announcementStroke.Transparency = 1
	end
	if reason ~= "" then
		log("announcement_cleared reason=" .. reason)
	end
end

local pumpQueue

local function finishAnnouncement(entry: QueuedAnnouncement, reason: string)
	local dedupeKey = type(entry.dedupeKey) == "string" and entry.dedupeKey or ""
	if dedupeKey ~= "" then
		recentCooldownsByKey[dedupeKey] = os.clock() + math.max(0, tonumber(entry.cooldownSeconds) or FeedbackConfig.Announcements.DefaultCooldownSeconds)
	end
	hideActiveAnnouncement(reason)
	task.delay(FeedbackConfig.Announcements.QueueGapSeconds, function()
		pumpQueue()
	end)
end

local function playAnnouncement(entry: QueuedAnnouncement)
	ensureGui()
	if not announcementLabel or not announcementStroke then
		return
	end

	local style = getStyle(entry.style)
	local displayDuration = math.max(0.5, tonumber(entry.durationSeconds) or FeedbackConfig.Announcements.DisplayDurationSeconds)
	local token = activeToken + 1
	activeToken = token
	activeAnnouncement = entry

	announcementLabel.Text = entry.text
	announcementLabel.TextColor3 = style.TextColor
	announcementStroke.Color = style.StrokeColor
	announcementLabel.TextTransparency = 1
	announcementStroke.Transparency = 1
	announcementLabel.Visible = true

	playSound(entry.soundId)

	TweenService:Create(
		announcementLabel,
		TweenInfo.new(FeedbackConfig.Announcements.FadeInSeconds, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ TextTransparency = 0 }
	):Play()
	TweenService:Create(
		announcementStroke,
		TweenInfo.new(FeedbackConfig.Announcements.FadeInSeconds, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ Transparency = 0.3 }
	):Play()

	log(string.format("announcement_shown source=%s style=%s text=%s", entry.source, tostring(entry.style or "Default"), entry.text))

	task.delay(displayDuration, function()
		if activeToken ~= token or activeAnnouncement ~= entry or not announcementLabel or not announcementStroke then
			return
		end

		local fadeOut = TweenService:Create(
			announcementLabel,
			TweenInfo.new(FeedbackConfig.Announcements.FadeOutSeconds, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
			{ TextTransparency = 1 }
		)
		local strokeFade = TweenService:Create(
			announcementStroke,
			TweenInfo.new(FeedbackConfig.Announcements.FadeOutSeconds, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
			{ Transparency = 1 }
		)
		fadeOut:Play()
		strokeFade:Play()
		fadeOut.Completed:Connect(function()
			if activeToken ~= token or activeAnnouncement ~= entry then
				return
			end
			finishAnnouncement(entry, "completed")
		end)
	end)
end

function pumpQueue()
	if activeAnnouncement then
		return
	end

	while #queue > 0 do
		local nextEntry = table.remove(queue, 1)
		if nextEntry.requiresInMatch == true and not isLocalPlayerInMatch() then
			log(string.format("announcement_skipped reason=requires_in_match source=%s text=%s", nextEntry.source, nextEntry.text))
		else
			playAnnouncement(nextEntry)
			return
		end
	end
end

local function purgeMatchOnlyAnnouncements(reason: string)
	local filtered = {}
	for _, entry in ipairs(queue) do
		if entry.requiresInMatch == true then
			log(string.format("announcement_removed_from_queue reason=%s source=%s text=%s", reason, entry.source, entry.text))
		else
			table.insert(filtered, entry)
		end
	end
	queue = filtered
	if activeAnnouncement and activeAnnouncement.requiresInMatch == true then
		hideActiveAnnouncement(reason)
		task.delay(FeedbackConfig.Announcements.QueueGapSeconds, function()
			pumpQueue()
		end)
	end
end

local function normalizePayload(payload: AnnouncementPayload, source: string): QueuedAnnouncement?
	local text = tostring(payload.text or ""):gsub("^%s+", ""):gsub("%s+$", "")
	if text == "" then
		return nil
	end

	sequenceCounter += 1

	return {
		text = text,
		style = payload.style,
		priority = tonumber(payload.priority) or FeedbackConfig.Announcements.Priorities.Quest,
		durationSeconds = tonumber(payload.durationSeconds) or FeedbackConfig.Announcements.DisplayDurationSeconds,
		dedupeKey = payload.dedupeKey,
		cooldownSeconds = tonumber(payload.cooldownSeconds) or FeedbackConfig.Announcements.DefaultCooldownSeconds,
		requiresInMatch = payload.requiresInMatch == true,
		soundId = payload.soundId,
		source = source,
		sequence = sequenceCounter,
	}
end

local function enqueueAnnouncement(payload: AnnouncementPayload, source: string)
	local entry = normalizePayload(payload, source)
	if not entry then
		return
	end

	if isDuplicate(entry) then
		return
	end

	if #queue >= FeedbackConfig.Announcements.MaxQueued then
		log(string.format("announcement_skipped reason=queue_full source=%s text=%s", source, entry.text))
		return
	end

	table.insert(queue, entry)
	sortQueue()
	log(string.format("announcement_queued source=%s priority=%d text=%s", source, tonumber(entry.priority) or 0, entry.text))
	pumpQueue()
end

function AnnouncementController.QueueLocal(payload: AnnouncementPayload)
	enqueueAnnouncement(payload, "local")
end

function AnnouncementController.Init()
	if initialized then
		return
	end
	initialized = true

	ensureGui()

	task.spawn(function()
		local remotes = ReplicatedStorage:WaitForChild("Remotes", 15)
		if not remotes then
			warn("[AnnouncementController] Remotes folder not found")
			return
		end

		local remote = remotes:WaitForChild("PlayerAnnouncement", 15)
		if remote and remote:IsA("RemoteEvent") then
			announcementRemote = remote
			announcementRemote.OnClientEvent:Connect(function(payload)
				if type(payload) == "table" then
					enqueueAnnouncement(payload, "server")
				end
			end)
		else
			warn("[AnnouncementController] PlayerAnnouncement remote missing")
		end
	end)

	LocalPlayer:GetAttributeChangedSignal("PlayerState"):Connect(function()
		if not isLocalPlayerInMatch() then
			purgeMatchOnlyAnnouncements("left_match")
		end
	end)

	log("initialized")
end

return AnnouncementController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="115">
          <Properties>
            <string name="Name">BrainrotPickupController</string>
            <string name="Source"><![CDATA[--[[
	BrainrotPickupController
	Client-side controller for brainrot mode pickups.

	Handles:
	  * Watching BrainrotPickups folder for spawned models
	  * Floating idle animation (sine wave bob + slow Y rotation)
	  * Dedicated brainrot pickup popup (static images preferred, ThumbnailRenderer fallback)
	  * Cleanup on despawn (no memory leaks)

	Popup is self-contained and renders above ALL other UI (DisplayOrder 135).
	Image priority: static imageAssetId -> ThumbnailRenderer (ViewportFrame) -> placeholder.

	API:
		Init()
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local AnimUtil = require(script.Parent:WaitForChild("UI"):WaitForChild("AnimUtil"))

local BrainrotPickupController = {}

local player = Players.LocalPlayer
local initialized = false

local _ThumbnailRenderer = nil
local function getThumbnailRenderer()
	if _ThumbnailRenderer then return _ThumbnailRenderer end
	pcall(function()
		local playerScripts = player:FindFirstChild("PlayerScripts")
		local clientUI = playerScripts and playerScripts:FindFirstChild("Client")
		clientUI = clientUI and clientUI:FindFirstChild("UI")
		local mod = clientUI and clientUI:FindFirstChild("ThumbnailRenderer")
		if mod then _ThumbnailRenderer = require(mod) end
	end)
	return _ThumbnailRenderer
end

local FOLDER_NAME    = "BrainrotPickups"
local BOB_AMPLITUDE  = 0.4    -- ±0.4 studs max, well within ±0.35-0.6 spec
local BOB_SPEED      = 2.5
local ROTATION_SPEED = 25
local HOVER_ABOVE_GROUND = 3.0  -- studs above floor to lock baseY

local POPUP_DISPLAY_ORDER = 135
local POPUP_DURATION = 3.0
local BRAINROT_FALLBACK_IMAGE = "rbxassetid://99759801373492"

-- Image holder styling (deep purple, no placeholder vibe)
local ICON_BG_COLOR = Color3.fromRGB(48, 16, 70)
local ICON_STROKE_COLOR = Color3.fromRGB(90, 45, 130)
local ICON_STROKE_THICKNESS = 2
local ICON_STROKE_TRANSPARENCY = 0.15

local activeAnimations = {}
local _popupGui = nil
local _activePopup = nil

-- Raycast params: ignore the model itself + its descendants
local function makeRaycastParams(model): RaycastParams
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local exclude = {}
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then table.insert(exclude, d) end
	end
	if model:IsA("BasePart") then table.insert(exclude, model) end
	params.FilterDescendantsInstances = exclude
	return params
end

-- Find ground Y below a given world position; returns nil if no ground found.
local function findGroundY(worldPos: Vector3, model): number?
	local params = makeRaycastParams(model)
	local result = Workspace:Raycast(worldPos, Vector3.new(0, -300, 0), params)
	if result then
		return result.Position.Y
	end
	return nil
end

local function startAnimation(model)
	if activeAnimations[model] then return end

	-- Ensure PrimaryPart is set so PivotTo works correctly for the whole model
	local primaryPart
	if model:IsA("Model") then
		primaryPart = model.PrimaryPart
		if not primaryPart then
			primaryPart = model:FindFirstChildWhichIsA("BasePart", true)
			if primaryPart then
				model.PrimaryPart = primaryPart
			end
		end
	elseif model:IsA("BasePart") then
		primaryPart = model
	end

	if not primaryPart then
		warn("[Brainrot] No BasePart found — cannot animate:", model.Name)
		return
	end

	local baseCFrame = primaryPart.CFrame
	local spawnPos   = baseCFrame.Position

	-- Find ground to determine correct hover baseY
	local groundY = findGroundY(spawnPos, model)
	local baseY: number
	if groundY then
		baseY = groundY + HOVER_ABOVE_GROUND
		print(string.format("[BrainrotHover] BaseY=%.3f (ground=%.3f + %.1f offset)", baseY, groundY, HOVER_ABOVE_GROUND))
	else
		-- Fallback: use spawn position as-is
		baseY = spawnPos.Y
		print(string.format("[BrainrotHover] BaseY=%.3f (no ground found, using spawn Y)", baseY))
	end

	-- Snap model to correct hover height immediately
	local correctedCF = CFrame.new(spawnPos.X, baseY, spawnPos.Z) * (baseCFrame - baseCFrame.Position)
	if model:IsA("Model") then
		model:PivotTo(correctedCF)
	else
		model.CFrame = correctedCF
	end
	baseCFrame = correctedCF  -- update reference

	local startTime = tick()

	local conn = RunService.Heartbeat:Connect(function()
		if not model or not model.Parent then return end

		local elapsed = tick() - startTime
		-- Pure sine — oscillates between -BOB_AMPLITUDE and +BOB_AMPLITUDE, NEVER accumulates
		local bobOffset = math.sin(elapsed * BOB_SPEED) * BOB_AMPLITUDE
		-- Hard clamp so drift from any source cannot push Y outside ±amplitude
		local clampedY = math.clamp(baseY + bobOffset, baseY - BOB_AMPLITUDE, baseY + BOB_AMPLITUDE)
		local rotationAngle = math.rad(elapsed * ROTATION_SPEED)

		local animCFrame = CFrame.new(baseCFrame.Position.X, clampedY, baseCFrame.Position.Z)
			* CFrame.Angles(0, rotationAngle, 0)

		if model:IsA("Model") then
			model:PivotTo(animCFrame)
		else
			model.CFrame = animCFrame
		end
	end)

	activeAnimations[model] = {
		connection = conn,
		baseCFrame = baseCFrame,
		startTime = startTime,
	}
end

local function stopAnimation(model)
	local anim = activeAnimations[model]
	if anim then
		if anim.connection and anim.connection.Connected then
			anim.connection:Disconnect()
		end
		activeAnimations[model] = nil
	end
end

local function onModelAdded(model)
	if not model:GetAttribute("BrainrotPetId") then return end
	task.defer(function()
		if model and model.Parent then
			startAnimation(model)
		end
	end)
end

local function onModelRemoved(model)
	stopAnimation(model)
end

local function watchFolder(folder)
	for _, child in ipairs(folder:GetChildren()) do
		onModelAdded(child)
	end
	folder.ChildAdded:Connect(onModelAdded)
	folder.ChildRemoved:Connect(onModelRemoved)
end

local function getPopupGui()
	if _popupGui and _popupGui.Parent then return _popupGui end
	local pg = player:FindFirstChild("PlayerGui")
	if not pg then return nil end
	local existing = pg:FindFirstChild("BrainrotPickupGui")
	if existing then _popupGui = existing; return existing end
	local sg = Instance.new("ScreenGui")
	sg.Name = "BrainrotPickupGui"
	sg.DisplayOrder = POPUP_DISPLAY_ORDER
	sg.IgnoreGuiInset = true
	sg.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	sg.Parent = pg
	_popupGui = sg
	return sg
end

local function dismissPopup()
	if not _activePopup or not _activePopup.Parent then return end
	local popup = _activePopup
	_activePopup = nil

	AnimUtil.PopupClose(popup, popup)
end

local function showPickupPopup(data)
	if not data then return end

	local gui = getPopupGui()
	if not gui then
		warn("[BrainrotPickup] Could not get popup ScreenGui")
		return
	end

	if _activePopup and _activePopup.Parent then
		_activePopup:Destroy()
		_activePopup = nil
	end

	local imageId = data.imageAssetId or ""
	local displayName = data.petName or "MISSING ITEM"
	local coinsAwarded = data.coins or 0
	local alreadyOwned = data.alreadyOwned or false
	local isNew = data.isNew

	local ownerText
	if isNew == true or alreadyOwned == false then
		ownerText = "NEW PET UNLOCKED!"
	else
		ownerText = "ALREADY OWNED (DUPLICATE)!"
	end

	print(string.format("[BrainrotPickup] Popup: %s | image=%s | coins=%d | owned=%s",
		displayName, imageId, coinsAwarded, tostring(alreadyOwned)))

	local card = Instance.new("Frame")
	card.Name = "BrainrotPopup"
	card.AnchorPoint = Vector2.new(0.5, 0.5)
	card.Position = UDim2.fromScale(0.5, 0.45)
	card.Size = UDim2.fromOffset(280, 340)
	card.BackgroundColor3 = Color3.fromRGB(22, 18, 38)
	card.BackgroundTransparency = 0.02
	card.BorderSizePixel = 0
	card.ZIndex = 51
	card.Parent = gui
	_activePopup = card

	Instance.new("UICorner", card).CornerRadius = UDim.new(0, 18)

	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(178, 48, 255)
	stroke.Thickness = 2.5
	stroke.Transparency = 0.2
	stroke.Parent = card

	AnimUtil.PopupOpen(card)

	local title = Instance.new("TextLabel")
	title.Name = "Title"
	title.AnchorPoint = Vector2.new(0.5, 0)
	title.Position = UDim2.new(0.5, 0, 0, 14)
	title.Size = UDim2.new(1, -20, 0, 28)
	title.BackgroundTransparency = 1
	title.Font = Enum.Font.GothamBold
	title.TextColor3 = Color3.fromRGB(255, 215, 48)
	title.TextSize = 20
	title.Text = "BRAINROT COLLECTED!"
	title.ZIndex = 52
	title.Parent = card

	local titleStroke = Instance.new("UIStroke")
	titleStroke.Color = Color3.fromRGB(0, 0, 0)
	titleStroke.Thickness = 2
	titleStroke.Parent = title

	local hasStaticImage = imageId ~= "" and imageId ~= BRAINROT_FALLBACK_IMAGE
	local usedRenderer = false
	local modelPath = data.modelPath or ""

	if not hasStaticImage and modelPath ~= "" then
		local TR = getThumbnailRenderer()
		if TR then
			local vpFrame = Instance.new("ViewportFrame")
			vpFrame.Name = "BrainrotIcon"
			vpFrame.AnchorPoint = Vector2.new(0.5, 0)
			vpFrame.Position = UDim2.new(0.5, 0, 0, 50)
			vpFrame.Size = UDim2.fromOffset(110, 110)
			vpFrame.BackgroundColor3 = ICON_BG_COLOR
			vpFrame.BackgroundTransparency = 0
			vpFrame.ZIndex = 52
			vpFrame.Parent = card

			Instance.new("UICorner", vpFrame).CornerRadius = UDim.new(0, 14)
			local vpStroke = Instance.new("UIStroke")
			vpStroke.Color = ICON_STROKE_COLOR
			vpStroke.Thickness = ICON_STROKE_THICKNESS
			vpStroke.Transparency = ICON_STROKE_TRANSPARENCY
			vpStroke.Parent = vpFrame
			Instance.new("UIAspectRatioConstraint", vpFrame).AspectRatio = 1

			local renderOk = TR.RenderItemToViewport(vpFrame, {
				modelPath = modelPath,
				id = data.petId,
				name = displayName,
				type = "Pet",
				rarity = data.rarity or "Legendary",
			})
			if renderOk then
				usedRenderer = true
				print(string.format("[BrainrotPickup] ThumbnailRenderer used for: %s", modelPath))
			else
				warn(string.format("[BrainrotPickup] ThumbnailRenderer failed for: %s", modelPath))
				vpFrame:Destroy()
			end
		end
	end

	if not usedRenderer then
		if imageId == "" then imageId = BRAINROT_FALLBACK_IMAGE end
		local icon = Instance.new("ImageLabel")
		icon.Name = "BrainrotIcon"
		icon.AnchorPoint = Vector2.new(0.5, 0)
		icon.Position = UDim2.new(0.5, 0, 0, 50)
		icon.Size = UDim2.fromOffset(110, 110)
		icon.BackgroundColor3 = ICON_BG_COLOR
		icon.BackgroundTransparency = 0
		icon.Image = imageId
		icon.ImageTransparency = 0
		icon.ScaleType = Enum.ScaleType.Fit
		icon.ZIndex = 52
		icon.Parent = card

		Instance.new("UICorner", icon).CornerRadius = UDim.new(0, 14)
		local iconStroke = Instance.new("UIStroke")
		iconStroke.Color = ICON_STROKE_COLOR
		iconStroke.Thickness = ICON_STROKE_THICKNESS
		iconStroke.Transparency = ICON_STROKE_TRANSPARENCY
		iconStroke.Parent = icon
		Instance.new("UIAspectRatioConstraint", icon).AspectRatio = 1
	end

	local nameLbl = Instance.new("TextLabel")
	nameLbl.Name = "PetName"
	nameLbl.AnchorPoint = Vector2.new(0.5, 0)
	nameLbl.Position = UDim2.new(0.5, 0, 0, 170)
	nameLbl.Size = UDim2.new(1, -24, 0, 28)
	nameLbl.BackgroundTransparency = 1
	nameLbl.Font = Enum.Font.GothamBold
	nameLbl.TextColor3 = Color3.fromRGB(255, 255, 255)
	nameLbl.TextSize = 18
	nameLbl.Text = displayName
	nameLbl.TextWrapped = true
	nameLbl.ZIndex = 52
	nameLbl.Parent = card

	local nameStroke = Instance.new("UIStroke")
	nameStroke.Color = Color3.fromRGB(0, 0, 0)
	nameStroke.Thickness = 1.5
	nameStroke.Parent = nameLbl

	local coinsLbl = Instance.new("TextLabel")
	coinsLbl.Name = "CoinsLine"
	coinsLbl.AnchorPoint = Vector2.new(0.5, 0)
	coinsLbl.Position = UDim2.new(0.5, 0, 0, 202)
	coinsLbl.Size = UDim2.new(1, -24, 0, 24)
	coinsLbl.BackgroundTransparency = 1
	coinsLbl.Font = Enum.Font.GothamBold
	coinsLbl.TextColor3 = Color3.fromRGB(255, 215, 48)
	coinsLbl.TextSize = 18
	coinsLbl.Text = "+" .. tostring(coinsAwarded) .. " coins"
	coinsLbl.ZIndex = 52
	coinsLbl.Parent = card

	local coinsStroke = Instance.new("UIStroke")
	coinsStroke.Color = Color3.fromRGB(0, 0, 0)
	coinsStroke.Thickness = 1.5
	coinsStroke.Parent = coinsLbl

	local ownerLbl = Instance.new("TextLabel")
	ownerLbl.Name = "OwnerLine"
	ownerLbl.AnchorPoint = Vector2.new(0.5, 0)
	ownerLbl.Position = UDim2.new(0.5, 0, 0, 230)
	ownerLbl.Size = UDim2.new(1, -24, 0, 22)
	ownerLbl.BackgroundTransparency = 1
	ownerLbl.Font = Enum.Font.GothamSemibold
	ownerLbl.TextSize = 14
	ownerLbl.TextWrapped = true
	ownerLbl.ZIndex = 52
	ownerLbl.Parent = card

	if alreadyOwned then
		ownerLbl.TextColor3 = Color3.fromRGB(255, 180, 40)
		ownerLbl.Text = ownerText
	else
		ownerLbl.TextColor3 = Color3.fromRGB(80, 255, 120)
		ownerLbl.Text = ownerText
	end

	local ownerStroke = Instance.new("UIStroke")
	ownerStroke.Color = Color3.fromRGB(0, 0, 0)
	ownerStroke.Thickness = 1
	ownerStroke.Parent = ownerLbl

	local rarLbl = Instance.new("TextLabel")
	rarLbl.Name = "Rarity"
	rarLbl.AnchorPoint = Vector2.new(0.5, 0)
	rarLbl.Position = UDim2.new(0.5, 0, 0, 256)
	rarLbl.Size = UDim2.new(1, -24, 0, 18)
	rarLbl.BackgroundTransparency = 1
	rarLbl.Font = Enum.Font.GothamSemibold
	rarLbl.TextColor3 = Color3.fromRGB(255, 198, 18)
	rarLbl.TextSize = 13
	rarLbl.Text = data.rarity or "Legendary"
	rarLbl.ZIndex = 52
	rarLbl.Parent = card

	local okBtn = Instance.new("TextButton")
	okBtn.Name = "OkBtn"
	okBtn.AnchorPoint = Vector2.new(0.5, 1)
	okBtn.Position = UDim2.new(0.5, 0, 1, -14)
	okBtn.Size = UDim2.new(1, -50, 0, 38)
	okBtn.BackgroundColor3 = Color3.fromRGB(178, 48, 255)
	okBtn.Font = Enum.Font.GothamBold
	okBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
	okBtn.TextSize = 16
	okBtn.Text = "NICE!"
	okBtn.BorderSizePixel = 0
	okBtn.AutoButtonColor = true
	okBtn.ZIndex = 52
	okBtn.Parent = card

	Instance.new("UICorner", okBtn).CornerRadius = UDim.new(0, 10)
	okBtn.MouseButton1Click:Connect(dismissPopup)

	local thisPopup = card
	task.delay(POPUP_DURATION, function()
		if _activePopup == thisPopup then
			dismissPopup()
		end
	end)
end

function BrainrotPickupController.Init()
	if initialized then return end
	initialized = true

	task.spawn(function()
		local folder = Workspace:WaitForChild(FOLDER_NAME, 60)
		if folder then
			watchFolder(folder)
			print("[BrainrotPickup] Watching folder")
		else
			local conn
			conn = Workspace.ChildAdded:Connect(function(child)
				if child.Name == FOLDER_NAME and child:IsA("Folder") then
					watchFolder(child)
					print("[BrainrotPickup] Folder appeared -- watching")
					if conn then conn:Disconnect() end
				end
			end)
		end
	end)

	task.spawn(function()
		local remotes = ReplicatedStorage:WaitForChild("Remotes", 15)
		if not remotes then return end

		local collectRemote = remotes:WaitForChild("BrainrotCollected", 15)
		if not collectRemote then return end

		collectRemote.OnClientEvent:Connect(function(data)
			if data then
				showPickupPopup(data)
			end
		end)

		print("[BrainrotPickup] Connected to BrainrotCollected remote")
	end)

	task.spawn(function()
		local Shared = ReplicatedStorage:FindFirstChild("Shared")
		if not Shared then return end
		local IC = nil
		pcall(function() IC = require(Shared:WaitForChild("ItemCatalog", 5)) end)
		if not IC or not IC.Pets then return end

		for id, pet in pairs(IC.Pets) do
			if pet.source == "brainrot_mode" then
				if pet.image and pet.image ~= "" then
					print(string.format("[ImageRules] STATIC: %s -> %s", id, pet.image))
				elseif pet.modelPath and pet.modelPath ~= "" then
					print(string.format("[ImageRules] RENDERER: %s -> %s", id, pet.modelPath))
				else
					print(string.format("[ImageRules] PLACEHOLDER: %s -> %s", id, BRAINROT_FALLBACK_IMAGE))
				end
			end
		end
	end)

	print("[BrainrotPickupController] Initialized")
end

return BrainrotPickupController
]]></string>
