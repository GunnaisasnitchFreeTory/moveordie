-- SHOW / HIDE

function QuestsPanel.Show()
	if not canvas then return end
	visible = true
	local screenGui = getQuestScreenGui()
	if screenGui then
		screenGui.Enabled = true
	end
	canvas.Visible = true
	canvas.GroupTransparency = 0.12
	if scrollFrame then
		scrollFrame.Visible = true
	end
	log(string.format(
		"show_called target=%s canvasVisible=%s overlayTarget=%s",
		canvas:GetFullName(),
		tostring(canvas.Visible),
		overlay and overlay:GetFullName() or "nil"
	))
	logVisibilityDiagnostics("show_start")

	if overlay then
		overlay.Visible = true
		TweenService:Create(overlay, TweenInfo.new(0.18), { BackgroundTransparency = 0.55 }):Play()
	end

	uiScale.Scale = 0.96
	TweenService:Create(canvas,  TweenInfo.new(0.18), { GroupTransparency = 0 }):Play()
	TweenService:Create(uiScale, TweenInfo.new(0.28, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()

	SoundUtil.Open()

	task.spawn(function()
		refreshUI()
		if scrollFrame then
			local lbl = scrollFrame:FindFirstChild("LoadingLabel")
			if lbl and next(_questRows) ~= nil then lbl.Visible = false end
		end
	end)
	task.delay(0.05, function()
		if visible and canvas then
			logVisibilityDiagnostics("show_post_open")
		end
	end)
	log(string.format("show_completed target=%s finalVisible=%s", canvas:GetFullName(), tostring(QuestsPanel.IsVisible())))
end

function QuestsPanel.Hide()
	if not canvas then return end
	visible = false
	log(string.format("hide_called target=%s", canvas:GetFullName()))

	TweenService:Create(canvas,  TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { GroupTransparency = 1 }):Play()
	TweenService:Create(uiScale, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Scale = 0.92 }):Play()

	if overlay then
		TweenService:Create(overlay, TweenInfo.new(0.18), { BackgroundTransparency = 1 }):Play()
	end

	task.delay(0.2, function()
		if not visible and canvas then
			canvas.Visible = false
			if overlay then overlay.Visible = false end
			log(string.format("hide_completed target=%s finalVisible=%s", canvas:GetFullName(), tostring(visible)))
		end
	end)

	SoundUtil.Close()
end

function QuestsPanel.IsVisible()
	if not visible or not canvas or not canvas.Visible then
		return false
	end

	local screenGui = getQuestScreenGui()
	if screenGui and screenGui.Enabled == false then
		return false
	end

	local absoluteSize = canvas.AbsoluteSize
	if absoluteSize.X <= 0 or absoluteSize.Y <= 0 then
		return false
	end

	return true
end

function QuestsPanel.GetVisibilityDiagnostics()
	return getVisibilityDiagnostics()
end

function QuestsPanel.Toggle()
	if visible then QuestsPanel.Hide() else QuestsPanel.Show() end
end

-- INIT

function QuestsPanel.Init(screenGui, onClose)
	closeCallback = onClose

	buildPanel(screenGui)
	connectVisibilityWatchers()

	task.spawn(function()
		ensureRemotes()
		if not _updateRemote then
			pcall(function()
				local remotes = ReplicatedStorage:WaitForChild("Remotes", 10)
				if remotes then
					_updateRemote = remotes:WaitForChild("DailyQuest_Update", 10)
				end
			end)
		end
		if _updateRemote then
			_updateRemote.OnClientEvent:Connect(function(status)
				_status = status
				if not status or not status.quests then return end
				logStatusPayload(status, "remote_update")
				if shouldRebuildRows(status) then
					clearQuestRows()
					buildQuestRows(status.quests, status.day)
					syncEmptyStateLabel()
				elseif visible then
					for _, quest in ipairs(status.quests) do
						local rowData = _questRows[quest.id]
						if rowData then updateRow(rowData, quest) end
					end
				end
			end)
		end
	end)
end

return QuestsPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="163">
            <Properties>
              <string name="Name">RewardPopup</string>
              <string name="Source"><![CDATA[--[[
	RewardPopup
	Shared reward popup used by both Spin Wheel and Crate Shop.
	Lives in StarterPlayerScripts (safe from SharedSanity cleanup).

	Style: Dark rounded card, "YOU WON!" header, medium icon,
	       reward name, rarity line, green OK button.
	       Confetti burst + win sound on reveal.

	API:
	  RewardPopup.Show({...})       -- single reward
	  RewardPopup.ShowBatch({...})  -- multiple rewards (grid layout)
	  RewardPopup.IsActive() → boolean
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local WIN_SFX_ID = "rbxassetid://111217342629113"
local WIN_SFX_VOLUME = 0.5

local AnimUtil = require(script.Parent:WaitForChild("AnimUtil"))

local RewardPopup = {}

local player = Players.LocalPlayer
local _active = false
local _overlay: Frame? = nil
local _onDismissCallback: (() -> ())? = nil
local _ignoreBackdropUntil = 0

local function isMobileTouchDevice(): boolean
	return UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
end

-- ═══════════════════════════════════════════
-- LAZY-LOAD ITEMCATALOG + THUMBNAILRENDERER
-- ═══════════════════════════════════════════
local _ItemCatalog = nil
local function getItemCatalog()
	if _ItemCatalog then return _ItemCatalog end
	pcall(function()
		local Shared = ReplicatedStorage:FindFirstChild("Shared")
		if Shared then
			local cdp = Shared:FindFirstChild("ClientDepsProvider")
			if cdp then
				local Deps = require(cdp)
				_ItemCatalog = Deps and Deps.ItemCatalog
			end
		end
	end)
	return _ItemCatalog
end

local _ThumbnailRenderer = nil
local function getThumbnailRenderer()
	if _ThumbnailRenderer then return _ThumbnailRenderer end
	pcall(function()
		local playerScripts = player:FindFirstChild("PlayerScripts")
		local clientUI = playerScripts and playerScripts:FindFirstChild("Client")
		clientUI = clientUI and clientUI:FindFirstChild("UI")
		local mod = clientUI and clientUI:FindFirstChild("ThumbnailRenderer")
		if mod then _ThumbnailRenderer = require(mod) end
	end)
	return _ThumbnailRenderer
end

local _QuestRewardIconResolver = nil
local function getQuestRewardIconResolver()
	if _QuestRewardIconResolver then return _QuestRewardIconResolver end
	pcall(function()
		local Shared = ReplicatedStorage:FindFirstChild("Shared")
		if Shared then
			local mod = Shared:FindFirstChild("QuestRewardIconResolver")
			if mod then _QuestRewardIconResolver = require(mod) end
		end
	end)
	return _QuestRewardIconResolver
end

-- ═══════════════════════════════════════════
-- LOOKUP CATALOG ENTRY (shared helper)
-- ═══════════════════════════════════════════
local function lookupCatalogEntry(data)
	local IC = getItemCatalog()
	if not IC then return nil end
	if not data.itemId or data.itemId == "" then return nil end
	local t = string.lower(data.itemType or "")

	local entry = nil
	if data.category and data.category ~= "" then
		if IC.Get then entry = IC.Get(data.category, data.itemId) end
	end
	if not entry then
		if t == "pet" and IC.Pets then
			entry = IC.Pets[data.itemId]
		elseif t == "crown" and IC.Crowns then
			entry = IC.Crowns[data.itemId]
		elseif (t == "iconimage" or t == "icon_image") and IC.IconImages then
			entry = IC.IconImages[data.itemId]
		elseif (t == "bundlereward" or t == "bundle_reward") and IC.BundleRewards then
			entry = IC.BundleRewards[data.itemId]
		elseif (t == "crate" or t == "crates") and IC.Crates then
			entry = IC.Crates[data.itemId]
		end
	end
	if not entry then
		if IC.Pets and IC.Pets[data.itemId] then entry = IC.Pets[data.itemId]
		elseif IC.Crowns and IC.Crowns[data.itemId] then entry = IC.Crowns[data.itemId]
		elseif IC.IconImages and IC.IconImages[data.itemId] then entry = IC.IconImages[data.itemId]
		elseif IC.BundleRewards and IC.BundleRewards[data.itemId] then entry = IC.BundleRewards[data.itemId]
		elseif IC.Crates and IC.Crates[data.itemId] then entry = IC.Crates[data.itemId] end
	end
	return entry
end

-- ═══════════════════════════════════════════
-- RESOLVE RARITY (authoritative from ItemCatalog)
-- For Pets/Crowns: ALWAYS use catalog rarity, never trust caller.
-- For Coins: use fixed rule based on amount, or caller's value.
-- ═══════════════════════════════════════════
local function resolveRarity(data)
	local callerRarity = data.rarityText or "Common"
	local itemType = data.itemType or ""

	-- Coins: no catalog rarity, use caller's value (which should be set intentionally)
	if itemType == "Coins" or itemType == "FateCoins" or itemType == "Spin" or itemType == "Spins" then
		print(string.format("[RewardPopup] type=Coins rarity=%s (coins use caller value)", callerRarity))
		return callerRarity
	end

	-- For Pets and Crowns: look up canonical rarity from ItemCatalog
	local entry = lookupCatalogEntry(data)
	if entry and entry.rarity then
		local catalogRarity = entry.rarity
		if catalogRarity ~= callerRarity then
			warn(string.format("[RewardPopup] RARITY MISMATCH! type=%s id=%s catalogRarity=%s callerRarity=%s → using catalog",
				itemType, data.itemId or "?", catalogRarity, callerRarity))
		else
			print(string.format("[RewardPopup] type=%s id=%s catalogRarity=%s popupRarity=%s",
				itemType, data.itemId or "?", catalogRarity, catalogRarity))
		end
		return catalogRarity
	end

	-- Catalog entry not found — use caller's value but warn
	if data.itemId and data.itemId ~= "" then
		warn(string.format("[RewardPopup] No catalog entry for type=%s id=%s — using caller rarity: %s",
			itemType, data.itemId or "?", callerRarity))
	end
	return callerRarity
end

-- ═══════════════════════════════════════════
-- BRAINROT PLACEHOLDER (used when no image asset set for brainrot items)
-- ═══════════════════════════════════════════
local BRAINROT_PLACEHOLDER_IMAGE = "rbxassetid://99759801373492"
local CRATE_FALLBACK_IMAGE = "rbxassetid://102125624504903"
local GENERIC_SPIN_REWARD_IMAGE = "rbxassetid://134540256061817"

-- ═══════════════════════════════════════════
-- RESOLVE ICON (multi-level fallback + ThumbnailRenderer)
-- Rule: If catalog has a non-empty image → use it (static).
--       No static image but has modelPath → return entry for ThumbnailRenderer.
--       Else → emoji fallback / placeholder.
-- Returns: resolvedImage, fallbackEmoji, fallbackColor, catalogEntry (for ThumbnailRenderer)
-- ═══════════════════════════════════════════
local function resolveIcon(data)
	-- Quest-specific mapping takes precedence when a quest reward descriptor exists.
	local questIconResolver = getQuestRewardIconResolver()
	if questIconResolver and questIconResolver.GetQuestRewardIcon then
		local questIcon = questIconResolver.GetQuestRewardIcon(data.questReward)
		if questIcon and questIcon ~= "" then
			return questIcon, nil, nil, nil
		end
	end

	local t = string.lower(data.itemType or "")
	local entry = lookupCatalogEntry(data)

	if t == "spin" or t == "spins" then
		return GENERIC_SPIN_REWARD_IMAGE, nil, nil, nil
	end

	-- For crown rewards, always resolve from the won crown id first.
	-- This prevents stale/default wheel icon overrides from showing the wrong crown art.
	if t == "crown" and entry then
		if entry.image and entry.image ~= "" then
			return entry.image, nil, nil, entry
		end
		if entry.modelPath and entry.modelPath ~= "" then
			return nil, entry.iconText or data.iconText, entry.iconColor or data.iconColor, entry
		end
	end

	-- Explicit icon from caller (e.g. wheel-specific asset IDs) is a fallback,
	-- except when crown catalog data above was available.
	if data.icon and data.icon ~= "" then
		return data.icon, nil, nil, nil
	end

	if entry then
		-- If catalog has a non-empty static image, use it
		if entry.image and entry.image ~= "" then
			return entry.image, nil, nil, entry
		end
		-- Crates should never render blank icon in popup.
		if t == "crate" or t == "crates" then
			return CRATE_FALLBACK_IMAGE, nil, nil, entry
		end
		-- No static image but has modelPath → allow ThumbnailRenderer (works for all items)
		if entry.modelPath and entry.modelPath ~= "" then
			return nil, entry.iconText or data.iconText, entry.iconColor or data.iconColor, entry
		end
		-- No image and no modelPath: use placeholder for brainrots, emoji for others
		if entry.source == "brainrot_mode" then
			print("[RewardPopup] Brainrot item with no image or modelPath — using placeholder for:", entry.name or "?")
			return BRAINROT_PLACEHOLDER_IMAGE, nil, nil, entry
		end
		return nil, entry.iconText or data.iconText, entry.iconColor or data.iconColor, entry
	end

	if data.iconText and data.iconText ~= "" then
		return nil, data.iconText, data.iconColor, nil
	end
	warn("[RewardPopup] Missing icon for", data.itemType or "?", data.itemId or "?", data.name or "?")
	return CRATE_FALLBACK_IMAGE, nil, nil, nil
end

-- ═══════════════════════════════════════════
-- RARITY COLORS
-- ═══════════════════════════════════════════
local RARITY_COLORS = {
	Common    = Color3.fromRGB(180, 200, 180),
	Uncommon  = Color3.fromRGB(80, 200, 80),
	Rare      = Color3.fromRGB(60, 140, 255),
	Epic      = Color3.fromRGB(178, 60, 255),
	Legendary = Color3.fromRGB(255, 180, 40),
	Exclusive = Color3.fromRGB(255, 58, 58),
	Impossible = Color3.fromRGB(255, 32, 32),
}

-- ═══════════════════════════════════════════
-- WIN SOUND
-- ═══════════════════════════════════════════
local _winSound: Sound? = nil

local function playWinSound()
	if _winSound and _winSound.IsPlaying then
		_winSound:Stop()
	end
	if not _winSound or not _winSound.Parent then
		_winSound = Instance.new("Sound")
		_winSound.Name = "CrateWinSFX"
		_winSound.SoundId = WIN_SFX_ID
		_winSound.Looped = false
		_winSound.Volume = WIN_SFX_VOLUME
		_winSound.Parent = SoundService
	end
	_winSound:Play()
end

-- ═══════════════════════════════════════════
-- CONFETTI BURST (self-contained, same style as Spin Wheel)
-- ═══════════════════════════════════════════
local CONFETTI_COLORS = {
	Color3.fromRGB(255, 0, 0),
	Color3.fromRGB(0, 255, 0),
	Color3.fromRGB(0, 0, 255),
	Color3.fromRGB(255, 255, 0),
	Color3.fromRGB(255, 0, 255),
	Color3.fromRGB(0, 255, 255),
	Color3.fromRGB(255, 128, 0),
	Color3.fromRGB(255, 255, 255),
}

local function spawnConfettiBurst(parent: GuiObject)
	local screenW = parent.AbsoluteSize.X
	local screenH = parent.AbsoluteSize.Y
	if screenW < 10 or screenH < 10 then return end

	local centerX = screenW * 0.5
	local centerY = screenH * 0.5
	local velScale = math.min(screenW, screenH) / 1000

	for _ = 1, 60 do
		local piece = Instance.new("Frame")
		piece.AnchorPoint = Vector2.new(0.5, 0.5)
		piece.BorderSizePixel = 0
		local s = math.random(4, 10)
		piece.Size = UDim2.fromOffset(s, s * math.random(10, 30) / 10)
		piece.Position = UDim2.fromOffset(centerX, centerY)
		piece.BackgroundColor3 = CONFETTI_COLORS[math.random(1, #CONFETTI_COLORS)]
		piece.Rotation = math.random(0, 360)
		piece.ZIndex = 200
		piece.Parent = parent

		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 2)
		corner.Parent = piece

		local angle = math.random() * math.pi * 2
		local speed = math.random(800, 1600) * velScale
		local vx = math.cos(angle) * speed
		local vy = math.sin(angle) * speed - math.random(600, 1000) * velScale
		local gravity = 1800 * velScale
		local drag = 0.98
		local rotSpeed = math.random(200, 600) * (math.random(0, 1) == 0 and 1 or -1)
		local t0 = tick()
		local px, py = 0, 0

		local conn
		conn = RunService.Heartbeat:Connect(function(dt)
			if not piece.Parent then
				conn:Disconnect()
				return
			end
			local elapsed = tick() - t0
			if elapsed > 3.5 or py > screenH + 80 then
				piece:Destroy()
				conn:Disconnect()
				return
			end
			vy = vy + gravity * dt
			vx = vx * drag
			px = px + vx * dt
			py = py + vy * dt
			piece.Position = UDim2.fromOffset(centerX + px, centerY + py)
			piece.Rotation = piece.Rotation + rotSpeed * dt
			if elapsed > 2.5 then
				piece.BackgroundTransparency = (elapsed - 2.5) / 1.0
			end
		end)
	end
end

-- ═══════════════════════════════════════════
-- SCREEN GUI
-- ═══════════════════════════════════════════
local _gui: ScreenGui? = nil

local function getGui(): ScreenGui?
	if _gui and _gui.Parent then return _gui end
	local pg = player:FindFirstChild("PlayerGui")
	if not pg then return nil end
	local existing = pg:FindFirstChild("RewardPopupGui")
	if existing and existing:IsA("ScreenGui") then
		existing.ResetOnSpawn = false
		existing.IgnoreGuiInset = true
		existing.DisplayOrder = math.max(existing.DisplayOrder, 500)
		existing.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
		existing.Enabled = true
		_gui = existing
		return existing
	end
	local sg = Instance.new("ScreenGui")
	sg.Name = "RewardPopupGui"
	sg.DisplayOrder = 500
	sg.IgnoreGuiInset = true
	sg.ResetOnSpawn = false
	sg.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	sg.Enabled = true
	sg.Parent = pg
	print("[Modal] RewardPopupGui ready (DisplayOrder=500)")
	_gui = sg
	return sg
end

-- ═══════════════════════════════════════════
-- DISMISS
-- ═══════════════════════════════════════════
local function dismiss()
	if not _active then return end
	_active = false
	local ov = _overlay
	if ov and ov.Parent then
		local panel = ov:FindFirstChild("Card") or ov:FindFirstChild("BatchPanel")
		local modalName = panel and panel.Name or "RewardPopup"
		print(string.format("[Modal] Hide %s -> tween out -> hidden", modalName))
		if panel then
			AnimUtil.PopupClose(panel, ov)
		else
			task.delay(0.25, function()
				if ov and ov.Parent then ov:Destroy() end
			end)
		end
	end
	_overlay = nil
	if _onDismissCallback then
		task.spawn(_onDismissCallback)
		_onDismissCallback = nil
	end
end

-- ═══════════════════════════════════════════
-- HELPER: build icon inside a parent frame
-- Supports: static image, ThumbnailRenderer (ViewportFrame for pets), emoji fallback
-- ═══════════════════════════════════════════
local function buildIcon(parent, resolvedImage, fallbackEmoji, fallbackColor, posY, iconSize, zIdx, catalogEntry, imageScaleType)
	for _, child in ipairs(parent:GetChildren()) do
		if child.Name == "RewardIcon" then
			child:Destroy()
		end
	end

	if resolvedImage and resolvedImage ~= "" then
		local icon = Instance.new("ImageLabel")
		icon.Name = "RewardIcon"
		icon.AnchorPoint = Vector2.new(0.5, 0)
		icon.Position = UDim2.new(0.5, 0, 0, posY)
		icon.Size = UDim2.fromOffset(iconSize, iconSize)
		icon.BackgroundTransparency = 1
		icon.Image = resolvedImage
		icon.ImageTransparency = 0
		icon.ScaleType = imageScaleType or Enum.ScaleType.Fit
		icon.Visible = true
		icon.ZIndex = zIdx
		icon.Parent = parent
		local asp = Instance.new("UIAspectRatioConstraint")
		asp.AspectRatio = 1
		asp.Parent = icon
		return
	end

	-- ThumbnailRenderer fallback: for pets/crowns with a modelPath but no static image
	if catalogEntry and catalogEntry.modelPath and catalogEntry.modelPath ~= "" then
		local TR = getThumbnailRenderer()
		if TR then
			local vpFrame = Instance.new("ViewportFrame")
			vpFrame.Name = "RewardIcon"
			vpFrame.AnchorPoint = Vector2.new(0.5, 0)
			vpFrame.Position = UDim2.new(0.5, 0, 0, posY)
			vpFrame.Size = UDim2.fromOffset(iconSize, iconSize)
			vpFrame.BackgroundTransparency = 1
			vpFrame.BorderSizePixel = 0
			vpFrame.Visible = true
			vpFrame.ZIndex = zIdx
			vpFrame.Parent = parent
			Instance.new("UIAspectRatioConstraint", vpFrame).AspectRatio = 1

			local renderOk = TR.RenderItemToViewport(vpFrame, {
				modelPath = catalogEntry.modelPath,
				id = catalogEntry.id or catalogEntry.name,
				name = catalogEntry.name or catalogEntry.modelName,
				type = catalogEntry.type,
				rarity = catalogEntry.rarity,
			})
			if renderOk then
				print("[RewardPopup] ThumbnailRenderer used for:", catalogEntry.modelPath)
				return
			else
				warn("[RewardPopup] ThumbnailRenderer failed for:", catalogEntry.modelPath, "— falling back to emoji")
				vpFrame:Destroy()
			end
		end
	end

	-- Emoji fallback
	if fallbackEmoji and fallbackEmoji ~= "" then
		local emojiHolder = Instance.new("Frame")
		emojiHolder.Name = "RewardIcon"
		emojiHolder.AnchorPoint = Vector2.new(0.5, 0)
		emojiHolder.Position = UDim2.new(0.5, 0, 0, posY)
		emojiHolder.Size = UDim2.fromOffset(iconSize, iconSize)
		emojiHolder.BackgroundColor3 = fallbackColor or Color3.fromRGB(60, 65, 85)
		emojiHolder.BackgroundTransparency = 0.15
		emojiHolder.BorderSizePixel = 0
		emojiHolder.Visible = true
		emojiHolder.ZIndex = zIdx
		emojiHolder.Parent = parent
		Instance.new("UICorner", emojiHolder).CornerRadius = UDim.new(0.5, 0)
		Instance.new("UIAspectRatioConstraint", emojiHolder).AspectRatio = 1
		local ehs = Instance.new("UIStroke")
		ehs.Color = Color3.fromRGB(255, 255, 255)
		ehs.Thickness = 2
		ehs.Transparency = 0.5
		ehs.Parent = emojiHolder
		local emojiLbl = Instance.new("TextLabel")
		emojiLbl.Size = UDim2.fromScale(1, 1)
		emojiLbl.BackgroundTransparency = 1
		emojiLbl.Font = Enum.Font.GothamBold
		emojiLbl.Text = fallbackEmoji
		emojiLbl.TextScaled = true
		emojiLbl.TextColor3 = Color3.fromRGB(255, 255, 255)
		emojiLbl.ZIndex = zIdx + 1
		emojiLbl.Parent = emojiHolder
	end
end

-- ═══════════════════════════════════════════
-- SHOW (single reward)
-- ═══════════════════════════════════════════
function RewardPopup.Show(data)
	if not data then return end

	if _active and _overlay and _overlay.Parent then
		_overlay:Destroy()
		_overlay = nil
		_active = false
	end
	local gui = getGui()
	if not gui then return end
	gui.Enabled = true

	_active = true
	_onDismissCallback = data.onDismiss
	_ignoreBackdropUntil = os.clock() + 0.2

	local titleText = data.title or "YOU WON!"
	local nameText = data.name or "MISSING ITEM"
	local rarityStr = resolveRarity(data)
	local okText = data.okText or "OK"
	local rarityColor = RARITY_COLORS[rarityStr] or RARITY_COLORS.Common
	local resolvedImage, fallbackEmoji, fallbackColor, catalogEntry = resolveIcon(data)

	local wrapper = Instance.new("Frame")
	wrapper.Name = "ModalWrapper"
	wrapper.Size = UDim2.fromScale(1, 1)
	wrapper.BackgroundTransparency = 1
	wrapper.BorderSizePixel = 0
	wrapper.ZIndex = 50
	wrapper.Parent = gui
	_overlay = wrapper

	local clickCatcher = Instance.new("TextButton")
	clickCatcher.Name = "ClickCatcher"
	clickCatcher.Size = UDim2.fromScale(1, 1)
	clickCatcher.BackgroundTransparency = 1
	clickCatcher.BorderSizePixel = 0
	clickCatcher.Text = ""
	clickCatcher.AutoButtonColor = false
	clickCatcher.Active = true
	clickCatcher.ZIndex = 50
	clickCatcher.Parent = wrapper
	clickCatcher.MouseButton1Click:Connect(function()
		if os.clock() < _ignoreBackdropUntil then
			return
		end
		dismiss()
	end)

	local card = Instance.new("Frame")
	card.Name = "Card"
	card.AnchorPoint = Vector2.new(0.5, 0.5)
	card.Position = UDim2.fromScale(0.5, 0.5)
	card.Size = UDim2.fromOffset(260, 310)
	card.BackgroundColor3 = Color3.fromRGB(25, 28, 42)
	card.BackgroundTransparency = 0.02
	card.BorderSizePixel = 0
	card.ZIndex = 51
	card.Parent = wrapper

	Instance.new("UICorner", card).CornerRadius = UDim.new(0, 16)
	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(60, 65, 85)
	stroke.Thickness = 2
	stroke.Transparency = 0.3
	stroke.Parent = card

	AnimUtil.PopupOpen(card)
	-- Shop purchase popups can render immediately on mobile before the tween is perceptible.
	-- Re-trigger an explicit open tween for mobile shop/gamepass sources only.
	do
		local source = tostring(data.popupSource or "")
		local isShopSource = source == "Shop" or source == "GamePass" or source == "DevProduct"
		if isShopSource and isMobileTouchDevice() then
			task.defer(function()
				if not card or not card.Parent then return end
				local sc = card:FindFirstChildOfClass("UIScale")
				if sc then
					sc.Scale = math.min(sc.Scale, 0.84)
				end
				AnimUtil.PopupOpen(card)
				print("[ShopPopup] platform=Mobile animationPlayed=true")
			end)
		end
	end

	task.defer(function()
		if card and card.Parent then
			print(string.format("[Modal] Show %s parent=%s anchor=(%.1f,%.1f) pos=(%.2f,%.2f) absPos=(%.0f,%.0f) absSize=(%.0f,%.0f)",
				titleText, gui.Name,
				card.AnchorPoint.X, card.AnchorPoint.Y,
				card.Position.X.Scale, card.Position.Y.Scale,
				card.AbsolutePosition.X, card.AbsolutePosition.Y,
				card.AbsoluteSize.X, card.AbsoluteSize.Y))
			print(string.format("[CrateModalDebug] parent=%s visible=%s size=%s pos=%s screenEnabled=%s displayOrder=%d zindex=%d",
				card.Parent and card.Parent:GetFullName() or "nil",
				tostring(card.Visible),
				tostring(card.Size),
				tostring(card.Position),
				tostring(gui.Enabled),
				gui.DisplayOrder,
				card.ZIndex))
		end
	end)

	playWinSound()
	task.delay(0.15, function()
		if overlay and overlay.Parent then
			spawnConfettiBurst(overlay)
		end
	end)

	local header = Instance.new("TextLabel")
	header.Name = "Header"
	header.AnchorPoint = Vector2.new(0.5, 0)
	header.Position = UDim2.new(0.5, 0, 0, 14)
	header.Size = UDim2.new(1, -20, 0, 30)
	header.BackgroundTransparency = 1
	header.Font = Enum.Font.GothamBold
	header.TextColor3 = Color3.fromRGB(255, 215, 0)
	header.TextSize = 22
	header.Text = titleText
	header.ZIndex = 52
	header.Parent = card
	local hs = Instance.new("UIStroke")
	hs.Color = Color3.fromRGB(0, 0, 0)
	hs.Thickness = 2
	hs.Parent = header

	local isCoinReward = (data.itemType == "Coins" or data.itemType == "FateCoins")
	local iconY = isCoinReward and 34 or 55
	local iconSize = isCoinReward and 140 or 90
	local imageScaleType = isCoinReward and Enum.ScaleType.Crop or Enum.ScaleType.Fit
	buildIcon(card, resolvedImage, fallbackEmoji, fallbackColor, iconY, iconSize, 52, catalogEntry, imageScaleType)

	local nameLbl = Instance.new("TextLabel")
	nameLbl.Name = "Name"
	nameLbl.AnchorPoint = Vector2.new(0.5, 0)
	nameLbl.Position = UDim2.new(0.5, 0, 0, 190)
	nameLbl.Size = UDim2.new(1, -24, 0, 28)
	nameLbl.BackgroundTransparency = 1
	nameLbl.Font = Enum.Font.GothamBold
	nameLbl.TextColor3 = Color3.fromRGB(255, 255, 255)
	nameLbl.TextSize = 20
	nameLbl.Text = nameText
	nameLbl.ZIndex = 52
	nameLbl.Parent = card
	local ns = Instance.new("UIStroke")
	ns.Color = Color3.fromRGB(0, 0, 0)
	ns.Thickness = 1.5
	ns.Parent = nameLbl

	local rarLbl = Instance.new("TextLabel")
	rarLbl.Name = "Rarity"
	rarLbl.AnchorPoint = Vector2.new(0.5, 0)
	rarLbl.Position = UDim2.new(0.5, 0, 0, 220)
	rarLbl.Size = UDim2.new(1, -24, 0, 20)
	rarLbl.BackgroundTransparency = 1
	rarLbl.Font = Enum.Font.GothamSemibold
	rarLbl.TextColor3 = rarityColor
	rarLbl.TextSize = 14
	rarLbl.Text = rarityStr
	rarLbl.ZIndex = 52
	rarLbl.Parent = card

	local okBtn = Instance.new("TextButton")
	okBtn.Name = "OkBtn"
	okBtn.AnchorPoint = Vector2.new(0.5, 1)
	okBtn.Position = UDim2.new(0.5, 0, 1, -18)
	okBtn.Size = UDim2.new(1, -50, 0, 40)
	okBtn.BackgroundColor3 = Color3.fromRGB(50, 180, 80)
	okBtn.Font = Enum.Font.GothamBold
	okBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
	okBtn.TextSize = 18
	okBtn.Text = okText
	okBtn.BorderSizePixel = 0
	okBtn.AutoButtonColor = true
	okBtn.ZIndex = 52
	okBtn.Parent = card
	Instance.new("UICorner", okBtn).CornerRadius = UDim.new(0, 10)

	okBtn.MouseButton1Click:Connect(dismiss)

	local thisOverlay = overlay
	task.delay(8, function()
		if _overlay == thisOverlay and _active then dismiss() end
	end)
end

-- ═══════════════════════════════════════════
-- SHOWBATCH (multiple rewards — grid layout)
-- Used by crate opening (3 or 6 crates)
-- ═══════════════════════════════════════════
function RewardPopup.ShowBatch(items)
	if not items or #items == 0 then return end
	if #items == 1 then
		RewardPopup.Show(items[1])
		return
	end

	if _active and _overlay and _overlay.Parent then
		_overlay:Destroy()
		_overlay = nil
		_active = false
	end

	local gui = getGui()
	if not gui then return end
	gui.Enabled = true

	_active = true
	_onDismissCallback = nil
	_ignoreBackdropUntil = os.clock() + 0.2

	local count = #items
	local CARD_W, CARD_H = 150, 200
	local COLS = math.min(count, 3)
	local ROWS = math.ceil(count / COLS)
	local GAP = 14
	local containerW = COLS * CARD_W + (COLS - 1) * GAP
	local containerH = ROWS * CARD_H + (ROWS - 1) * GAP

	local wrapper = Instance.new("Frame")
	wrapper.Name = "ModalWrapper"
	wrapper.Size = UDim2.fromScale(1, 1)
	wrapper.BackgroundTransparency = 1
	wrapper.BorderSizePixel = 0
	wrapper.ZIndex = 50
	wrapper.Parent = gui
	_overlay = wrapper

	local clickCatcher = Instance.new("TextButton")
	clickCatcher.Name = "ClickCatcher"
	clickCatcher.Size = UDim2.fromScale(1, 1)
	clickCatcher.BackgroundTransparency = 1
	clickCatcher.BorderSizePixel = 0
	clickCatcher.Text = ""
	clickCatcher.AutoButtonColor = false
	clickCatcher.Active = true
	clickCatcher.ZIndex = 50
	clickCatcher.Parent = wrapper
	clickCatcher.MouseButton1Click:Connect(function()
		if os.clock() < _ignoreBackdropUntil then
			return
		end
		dismiss()
	end)

	-- Main panel
	local panelW = containerW + 40
	local panelH = containerH + 100
	local panel = Instance.new("Frame")
	panel.Name = "BatchPanel"
	panel.AnchorPoint = Vector2.new(0.5, 0.5)
	panel.Position = UDim2.fromScale(0.5, 0.5)
	panel.Size = UDim2.fromOffset(panelW, panelH)
	panel.BackgroundColor3 = Color3.fromRGB(20, 22, 35)
	panel.BackgroundTransparency = 0.05
	panel.BorderSizePixel = 0
	panel.ZIndex = 51
	panel.Parent = wrapper

	Instance.new("UICorner", panel).CornerRadius = UDim.new(0, 16)
	local panelStroke = Instance.new("UIStroke")
	panelStroke.Color = Color3.fromRGB(60, 65, 85)
	panelStroke.Thickness = 2
	panelStroke.Transparency = 0.3
	panelStroke.Parent = panel

	AnimUtil.PopupOpen(panel)

	task.defer(function()
		if panel and panel.Parent then
			print(string.format("[Modal] ShowBatch parent=%s anchor=(%.1f,%.1f) pos=(%.2f,%.2f) absPos=(%.0f,%.0f) absSize=(%.0f,%.0f)",
				gui.Name,
				panel.AnchorPoint.X, panel.AnchorPoint.Y,
				panel.Position.X.Scale, panel.Position.Y.Scale,
				panel.AbsolutePosition.X, panel.AbsolutePosition.Y,
				panel.AbsoluteSize.X, panel.AbsoluteSize.Y))
			print(string.format("[CrateModalDebug] parent=%s visible=%s size=%s pos=%s screenEnabled=%s displayOrder=%d zindex=%d",
				panel.Parent and panel.Parent:GetFullName() or "nil",
				tostring(panel.Visible),
				tostring(panel.Size),
				tostring(panel.Position),
				tostring(gui.Enabled),
				gui.DisplayOrder,
				panel.ZIndex))
		end
	end)

	playWinSound()
	task.delay(0.15, function()
		if overlay and overlay.Parent then
			spawnConfettiBurst(overlay)
		end
	end)

	-- Header
	local header = Instance.new("TextLabel")
	header.AnchorPoint = Vector2.new(0.5, 0)
	header.Position = UDim2.new(0.5, 0, 0, 10)
	header.Size = UDim2.new(1, 0, 0, 28)
	header.BackgroundTransparency = 1
	header.Font = Enum.Font.GothamBold
	header.TextColor3 = Color3.fromRGB(255, 215, 0)
	header.TextSize = 20
	header.Text = "YOU WON!"
	header.ZIndex = 52
	header.Parent = panel
	local hs = Instance.new("UIStroke")
	hs.Color = Color3.fromRGB(0, 0, 0)
	hs.Thickness = 2
	hs.Parent = header

	-- Card grid container
	local grid = Instance.new("Frame")
	grid.Name = "CardGrid"
	grid.AnchorPoint = Vector2.new(0.5, 0)
	grid.Position = UDim2.new(0.5, 0, 0, 44)
	grid.Size = UDim2.fromOffset(containerW, containerH)
	grid.BackgroundTransparency = 1
	grid.ZIndex = 52
	grid.Parent = panel

	local gridLayout = Instance.new("UIGridLayout")
	gridLayout.CellSize = UDim2.fromOffset(CARD_W, CARD_H)
	gridLayout.CellPadding = UDim2.fromOffset(GAP, GAP)
	gridLayout.FillDirection = Enum.FillDirection.Horizontal
	gridLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	gridLayout.SortOrder = Enum.SortOrder.LayoutOrder
	gridLayout.Parent = grid

	-- Build mini-cards
	for idx, item in ipairs(items) do
		local resolvedImage, fallbackEmoji, fallbackColor, catalogEntry = resolveIcon(item)
		local rarityStr = resolveRarity(item)
		local rarityColor = RARITY_COLORS[rarityStr] or RARITY_COLORS.Common

		local card = Instance.new("Frame")
		card.Name = "Card" .. idx
		card.BackgroundColor3 = Color3.fromRGB(30, 33, 50)
		card.BorderSizePixel = 0
		card.LayoutOrder = idx
		card.ZIndex = 53
		card.Parent = grid

		Instance.new("UICorner", card).CornerRadius = UDim.new(0, 12)
		local cardStroke = Instance.new("UIStroke")
		cardStroke.Color = rarityColor
		cardStroke.Thickness = 1.5
		cardStroke.Transparency = 0.4
		cardStroke.Parent = card

		-- Icon
		local isCoinReward = (item.itemType == "Coins" or item.itemType == "FateCoins")
		local iconSize = isCoinReward and 78 or 60
		local imageScaleType = isCoinReward and Enum.ScaleType.Crop or Enum.ScaleType.Fit
		buildIcon(card, resolvedImage, fallbackEmoji, fallbackColor, 12, iconSize, 54, catalogEntry, imageScaleType)

		-- Name
		local nameLbl = Instance.new("TextLabel")
		nameLbl.AnchorPoint = Vector2.new(0.5, 0)
		nameLbl.Position = UDim2.new(0.5, 0, 0, 78)
		nameLbl.Size = UDim2.new(1, -12, 0, 36)
		nameLbl.BackgroundTransparency = 1
		nameLbl.Font = Enum.Font.GothamBold
		nameLbl.TextColor3 = Color3.fromRGB(255, 255, 255)
		nameLbl.TextSize = 13
		nameLbl.Text = item.name or "MISSING ITEM"
		nameLbl.TextWrapped = true
		nameLbl.ZIndex = 54
		nameLbl.Parent = card

		-- Rarity
		local rarLbl = Instance.new("TextLabel")
		rarLbl.AnchorPoint = Vector2.new(0.5, 0)
		rarLbl.Position = UDim2.new(0.5, 0, 0, 116)
		rarLbl.Size = UDim2.new(1, -12, 0, 16)
		rarLbl.BackgroundTransparency = 1
		rarLbl.Font = Enum.Font.GothamSemibold
		rarLbl.TextColor3 = rarityColor
		rarLbl.TextSize = 11
		rarLbl.Text = rarityStr
		rarLbl.ZIndex = 54
		rarLbl.Parent = card

		-- Duplicate tag
		if item.isDuplicate then
			local dupLbl = Instance.new("TextLabel")
			dupLbl.AnchorPoint = Vector2.new(0.5, 1)
			dupLbl.Position = UDim2.new(0.5, 0, 1, -8)
			dupLbl.Size = UDim2.new(1, -12, 0, 16)
			dupLbl.BackgroundTransparency = 1
			dupLbl.Font = Enum.Font.GothamBold
			dupLbl.TextColor3 = Color3.fromRGB(255, 180, 40)
			dupLbl.TextSize = 10
			dupLbl.Text = "ALREADY OWNED"
			dupLbl.ZIndex = 54
			dupLbl.Parent = card
		end
	end

	-- CLAIM ALL button
	local claimBtn = Instance.new("TextButton")
	claimBtn.AnchorPoint = Vector2.new(0.5, 1)
	claimBtn.Position = UDim2.new(0.5, 0, 1, -12)
	claimBtn.Size = UDim2.new(0, math.min(containerW, 200), 0, 38)
	claimBtn.BackgroundColor3 = Color3.fromRGB(50, 180, 80)
	claimBtn.Font = Enum.Font.GothamBold
	claimBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
	claimBtn.TextSize = 16
	claimBtn.Text = "CLAIM ALL"
	claimBtn.BorderSizePixel = 0
	claimBtn.AutoButtonColor = true
	claimBtn.ZIndex = 52
	claimBtn.Parent = panel
	Instance.new("UICorner", claimBtn).CornerRadius = UDim.new(0, 10)
	claimBtn.MouseButton1Click:Connect(dismiss)

	local thisWrapper = wrapper
	task.delay(12, function()
		if _overlay == thisWrapper and _active then dismiss() end
	end)
end

function RewardPopup.IsActive(): boolean
	return _active
end

function RewardPopup.Dismiss()
	dismiss()
end

return RewardPopup
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="164">
            <Properties>
              <string name="Name">SettingsPanel</string>
              <string name="Source"><![CDATA[--[[
	SettingsPanel
	Player settings — music toggle + volume slider.

	• Background Music ON/OFF toggle
	• Music volume slider (0–100)
	• Instantly affects currently playing background music
	• Same glossy/vibrant style as other panels

	Used by: UIController (sidebar "Settings" button)
]]

local SoundService = game:GetService("SoundService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local UIConfig = require(Shared:WaitForChild("UIConfig"))

local Client = script.Parent
local AnimUtil   = require(Client:WaitForChild("AnimUtil"))
local SoundUtil  = require(Client:WaitForChild("SoundUtil"))
local Components = require(Client:WaitForChild("Components"))

local C = UIConfig.Colors
local S = UIConfig.Sizes

local canvas: CanvasGroup = nil
local uiScale: UIScale = nil
local overlay: Frame = nil
local visible = false
local closeCallback: (() -> ())? = nil

-- Settings state
local musicEnabled = true
local musicVolume = 50 -- 0–100

local SettingsPanel = {}

-- ─── FIND BACKGROUND MUSIC ───

local function findBGMusic(): { Sound }
	local sounds = {}
	-- Check SoundService
	for _, child in ipairs(SoundService:GetChildren()) do
		if child:IsA("Sound") then
			table.insert(sounds, child)
		end
	end
	-- Check Workspace
	for _, child in ipairs(workspace:GetChildren()) do
		if child:IsA("Sound") then
			table.insert(sounds, child)
		end
	end
	-- Check SoundGroup named "Music" or "BGM"
	local sg = SoundService:FindFirstChild("Music") or SoundService:FindFirstChild("BGM")
	if sg then
		for _, child in ipairs(sg:GetChildren()) do
			if child:IsA("Sound") then
				table.insert(sounds, child)
			end
		end
	end
	return sounds
end

local function applyMusicSettings()
	local vol = musicEnabled and (musicVolume / 100) or 0

	-- Prefer setting SoundGroup volume (lets MusicController manage per-sound fades)
	local bgmGroup = SoundService:FindFirstChild("BGM") or SoundService:FindFirstChild("Music")
	if bgmGroup and bgmGroup:IsA("SoundGroup") then
		bgmGroup.Volume = vol
	end

	-- Also apply to any orphan sounds not managed by a group
	local sounds = findBGMusic()
	for _, sound in ipairs(sounds) do
		if not sound.SoundGroup or sound.SoundGroup == SoundService then
			sound.Volume = vol
		end
	end
end

-- ─── BUILD ───

local toggleBtn: TextButton = nil
local toggleLabel: TextLabel = nil
local volumeLabel: TextLabel = nil
local sliderFill: Frame = nil

local function updateToggleVisual()
	if not toggleBtn then return end
	if musicEnabled then
		toggleBtn.BackgroundColor3 = C.Green
		toggleLabel.Text = "ON"
	else
		toggleBtn.BackgroundColor3 = C.Red
		toggleLabel.Text = "OFF"
	end
end

local function updateVolumeVisual()
	if not volumeLabel then return end
	volumeLabel.Text = tostring(musicVolume) .. "%"
	if sliderFill then
		sliderFill.Size = UDim2.new(musicVolume / 100, 0, 1, 0)
	end
end

function SettingsPanel.Init(screenGui: ScreenGui, onClose: () -> ())
	closeCallback = onClose

	overlay = Components.CreateDimOverlay(screenGui, function()
		SettingsPanel.Hide()
	end)

	local content, closeBtn
	canvas, uiScale, content, closeBtn = Components.CreatePanel(screenGui, "SETTINGS", C.HeaderSettings, "Settings")
	local studTexture = canvas:FindFirstChild("StudTexture")
	if studTexture then
		studTexture:Destroy()
	end

	-- Hide scrolling, use fixed layout
	content.ScrollBarThickness = 0
	content.ScrollingEnabled = false

	-- ─── MUSIC TOGGLE ROW ───
	local row1 = Instance.new("Frame")
	row1.Name = "MusicRow"
	row1.Size = UDim2.new(1, -40, 0, 56)
	row1.Position = UDim2.new(0, 20, 0, S.PanelHeaderHeight + 24)
	row1.BackgroundColor3 = C.CardBg
	row1.BorderSizePixel = 0
	row1.Parent = canvas

	local r1c = Instance.new("UICorner")
	r1c.CornerRadius = UDim.new(0, S.BtnCorner)
	r1c.Parent = row1

	local r1s = Instance.new("UIStroke")
	r1s.Color = C.CardStroke
	r1s.Thickness = S.PanelStroke
	r1s.Transparency = 0.35
	r1s.Parent = row1

	local r1pad = Instance.new("UIPadding")
	r1pad.PaddingLeft = UDim.new(0, 16)
	r1pad.PaddingRight = UDim.new(0, 14)
	r1pad.Parent = row1

	local musicText = Instance.new("TextLabel")
	musicText.Size = UDim2.new(0.6, 0, 1, 0)
	musicText.Position = UDim2.fromOffset(0, 0)
	musicText.BackgroundTransparency = 1
	musicText.Font = Enum.Font.GothamBold
	musicText.TextColor3 = C.TextWhite
	musicText.TextSize = 20
	musicText.Text = "Background Music"
	musicText.TextXAlignment = Enum.TextXAlignment.Left
	musicText.Parent = row1

	local mts = Instance.new("UIStroke")
	mts.Color = Color3.fromRGB(0, 0, 0)
	mts.Thickness = 1.5
	mts.Transparency = 0.22
	mts.Parent = musicText

	toggleBtn = Instance.new("TextButton")
	toggleBtn.Name = "ToggleBtn"
	toggleBtn.Size = UDim2.fromOffset(80, 36)
	toggleBtn.AnchorPoint = Vector2.new(1, 0.5)
	toggleBtn.Position = UDim2.new(1, 0, 0.5, 0)
	toggleBtn.BackgroundColor3 = C.Green
	toggleBtn.BorderSizePixel = 0
	toggleBtn.AutoButtonColor = false
	toggleBtn.Text = ""
	toggleBtn.Parent = row1

	local tbc = Instance.new("UICorner")
	tbc.CornerRadius = UDim.new(0, S.BtnCorner)
	tbc.Parent = toggleBtn

	local tbs = Instance.new("UIStroke")
	tbs.Color = Color3.fromRGB(255, 255, 255)
	tbs.Thickness = S.PanelStroke
	tbs.Transparency = 0.4
	tbs.Parent = toggleBtn

	toggleLabel = Instance.new("TextLabel")
	toggleLabel.Size = UDim2.fromScale(1, 1)
	toggleLabel.BackgroundTransparency = 1
	toggleLabel.Font = Enum.Font.GothamBold
	toggleLabel.TextColor3 = C.TextWhite
	toggleLabel.TextSize = 18
	toggleLabel.Text = "ON"
	toggleLabel.Parent = toggleBtn

	local tls = Instance.new("UIStroke")
	tls.Color = Color3.fromRGB(0, 0, 0)
	tls.Thickness = 1.5
	tls.Transparency = 0.2
	tls.Parent = toggleLabel

	AnimUtil.WireButton(toggleBtn, function()
		SoundUtil.Click()
		musicEnabled = not musicEnabled
		updateToggleVisual()
		applyMusicSettings()
	end)

	-- ─── VOLUME SLIDER ROW ───
	local row2 = Instance.new("Frame")
	row2.Name = "VolumeRow"
	row2.Size = UDim2.new(1, -40, 0, 56)
	row2.Position = UDim2.new(0, 20, 0, S.PanelHeaderHeight + 92)
	row2.BackgroundColor3 = C.CardBg
	row2.BorderSizePixel = 0
	row2.Parent = canvas

	local r2c = Instance.new("UICorner")
	r2c.CornerRadius = UDim.new(0, S.BtnCorner)
	r2c.Parent = row2

	local r2s = Instance.new("UIStroke")
	r2s.Color = C.CardStroke
	r2s.Thickness = S.PanelStroke
	r2s.Transparency = 0.35
	r2s.Parent = row2

	local r2pad = Instance.new("UIPadding")
	r2pad.PaddingLeft = UDim.new(0, 16)
	r2pad.PaddingRight = UDim.new(0, 14)
	r2pad.Parent = row2

	local volText = Instance.new("TextLabel")
	volText.Size = UDim2.new(0, 120, 1, 0)
	volText.Position = UDim2.fromOffset(0, 0)
	volText.BackgroundTransparency = 1
	volText.Font = Enum.Font.GothamBold
	volText.TextColor3 = C.TextWhite
	volText.TextSize = 20
	volText.Text = "Volume"
	volText.TextXAlignment = Enum.TextXAlignment.Left
	volText.Parent = row2

	local vts = Instance.new("UIStroke")
	vts.Color = Color3.fromRGB(0, 0, 0)
	vts.Thickness = 1.5
	vts.Transparency = 0.22
	vts.Parent = volText

	-- Volume percentage label
	volumeLabel = Instance.new("TextLabel")
	volumeLabel.Size = UDim2.fromOffset(50, 30)
	volumeLabel.AnchorPoint = Vector2.new(1, 0.5)
	volumeLabel.Position = UDim2.new(1, 0, 0.5, 0)
	volumeLabel.BackgroundTransparency = 1
	volumeLabel.Font = Enum.Font.GothamBold
	volumeLabel.TextColor3 = C.Gold
	volumeLabel.TextSize = 18
	volumeLabel.Text = "50%"
	volumeLabel.ZIndex = 4
	volumeLabel.Parent = row2

	local vls = Instance.new("UIStroke")
	vls.Color = Color3.fromRGB(0, 0, 0)
	vls.Thickness = 1.5
	vls.Transparency = 0.22
	vls.Parent = volumeLabel

	-- Slider track
	-- Keep the visible bar as a Frame so hover/click feedback never moves the bar itself.
	-- A transparent hitbox handles interaction on top of it.
	local sliderTrack = Instance.new("Frame")
	sliderTrack.Name = "SliderTrack"
	sliderTrack.Size = UDim2.new(1, -220, 0, 16)
	sliderTrack.AnchorPoint = Vector2.new(0, 0.5)
	sliderTrack.Position = UDim2.new(0, 134, 0.5, 0)
	sliderTrack.BackgroundColor3 = C.CardBgDark
	sliderTrack.BorderSizePixel = 0
	sliderTrack.ClipsDescendants = true
	sliderTrack.ZIndex = 1
	sliderTrack.Parent = row2

	local stc = Instance.new("UICorner")
	stc.CornerRadius = UDim.new(0, 8)
	stc.Parent = sliderTrack

	local trackStroke = Instance.new("UIStroke")
	trackStroke.Color = Color3.fromRGB(255, 255, 255)
	trackStroke.Thickness = 1.25
	trackStroke.Transparency = 0.72
	trackStroke.Parent = sliderTrack

	-- Slider fill
	sliderFill = Instance.new("Frame")
	sliderFill.Name = "Fill"
	sliderFill.Size = UDim2.new(0.5, 0, 1, 0)
	sliderFill.BackgroundColor3 = C.Blue
	sliderFill.BorderSizePixel = 0
	sliderFill.ZIndex = 2
	sliderFill.Parent = sliderTrack

	local sfc = Instance.new("UICorner")
	sfc.CornerRadius = UDim.new(0, 8)
	sfc.Parent = sliderFill

	local sliderHitbox = Instance.new("TextButton")
	sliderHitbox.Name = "SliderHitbox"
	sliderHitbox.Size = UDim2.fromScale(1, 1)
	sliderHitbox.BackgroundTransparency = 1
	sliderHitbox.BorderSizePixel = 0
	sliderHitbox.AutoButtonColor = false
	sliderHitbox.Text = ""
	sliderHitbox.ZIndex = 3
	sliderHitbox.Parent = sliderTrack

	-- Slider interaction
	local dragging = false
	local trackBaseColor = C.CardBgDark
	local trackHoverColor = trackBaseColor:Lerp(Color3.new(1, 1, 1), 0.08)
	local fillBaseColor = C.Blue
	local fillHoverColor = fillBaseColor:Lerp(Color3.new(1, 1, 1), 0.06)

	local function setSliderHoverState(isHovering: boolean)
		AnimUtil.Tween(sliderTrack, {
			BackgroundColor3 = isHovering and trackHoverColor or trackBaseColor,
		}, 0.10, Enum.EasingStyle.Quad)
		AnimUtil.Tween(sliderFill, {
			BackgroundColor3 = isHovering and fillHoverColor or fillBaseColor,
		}, 0.10, Enum.EasingStyle.Quad)
		AnimUtil.Tween(trackStroke, {
			Transparency = isHovering and 0.56 or 0.72,
		}, 0.10, Enum.EasingStyle.Quad)
	end

	local function updateSliderFromInput(input)
		local trackAbsPos = sliderTrack.AbsolutePosition.X
		local trackAbsSize = sliderTrack.AbsoluteSize.X
		local relX = math.clamp((input.Position.X - trackAbsPos) / trackAbsSize, 0, 1)
		musicVolume = math.floor(relX * 100 + 0.5)
		updateVolumeVisual()
		applyMusicSettings()
	end

	sliderHitbox.MouseEnter:Connect(function()
		setSliderHoverState(true)
	end)

	sliderHitbox.MouseLeave:Connect(function()
		if not dragging then
			setSliderHoverState(false)
		end
	end)

	sliderHitbox.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			setSliderHoverState(true)
			updateSliderFromInput(input)
		end
	end)

	sliderHitbox.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
			local mouse = game:GetService("UserInputService"):GetMouseLocation()
			local pos = sliderTrack.AbsolutePosition
			local size = sliderTrack.AbsoluteSize
			local inside = mouse.X >= pos.X and mouse.X <= pos.X + size.X and mouse.Y >= pos.Y and mouse.Y <= pos.Y + size.Y
			setSliderHoverState(inside)
		end
	end)

	game:GetService("UserInputService").InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			updateSliderFromInput(input)
		end
	end)

	-- ─── CLOSE ───
	AnimUtil.WireButton(closeBtn, function()
		SoundUtil.Close()
		SettingsPanel.Hide()
	end)

	updateToggleVisual()
	updateVolumeVisual()
end

function SettingsPanel.Show()
	if visible then return end
	visible = true
	overlay.Visible = true
	SoundUtil.Open()
	AnimUtil.OpenPanel(canvas, uiScale)
end

function SettingsPanel.Hide()
	if not visible then return end
	visible = false
	overlay.Visible = false
	local t = AnimUtil.ClosePanel(canvas, uiScale)
	task.spawn(function()
		t.Completed:Wait()
		canvas.Visible = false
	end)
	if closeCallback then closeCallback() end
end

function SettingsPanel.IsVisible(): boolean
	return visible
end

function SettingsPanel.Toggle()
	if visible then SettingsPanel.Hide() else SettingsPanel.Show() end
end

return SettingsPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="165">
            <Properties>
              <string name="Name">ShopPanel</string>
              <string name="Source"><![CDATA[--[[
	ShopPanel  (Premium / Robux Shop)
	Sells Fate Coins, exclusive Crowns, exclusive Pets, VIP bundles.
	All prices are in Robux.

	Features:
	  * Category tabs (Coins, Crowns, Pets, Bundles)
	  * Dark vibrant card grid with rarity borders
	  * Stud texture + sunburst background (via Components.CreatePanel)
	  * Item images from ItemCatalog (single source of truth)

	Used by: UIController (sidebar "Shop" button)
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local MarketplaceService = game:GetService("MarketplaceService")
local TweenService       = game:GetService("TweenService")
local Players            = game:GetService("Players")
local HttpService        = game:GetService("HttpService")
local RunService         = game:GetService("RunService")
local ContentProvider    = game:GetService("ContentProvider")
local UserInputService   = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer

local Shared = ReplicatedStorage:WaitForChild("Shared", 60)
if not Shared then
	warn("[ShopPanel] Shared not found after 60s -- disabled")
	return { Init = function() end, Show = function() end, Hide = function() end,
		IsVisible = function() return false end, Toggle = function() end }
end

local CDPModule = Shared:WaitForChild("ClientDepsProvider", 60)
if not CDPModule then
	local _children = {}
	for _, c in ipairs(Shared:GetChildren()) do table.insert(_children, c.Name.."("..c.ClassName..")") end
	warn("[ShopPanel] ClientDepsProvider MISSING. Shared path:", Shared:GetFullName(), "| Shared children:", table.concat(_children, ", "))
	return { Init = function() end, Show = function() end, Hide = function() end,
		IsVisible = function() return false end, Toggle = function() end }
end

local ok, Deps = pcall(require, CDPModule)
if not ok or not Deps then
	warn("[ShopPanel] require(ClientDepsProvider) FAILED:", Deps)
	return { Init = function() end, Show = function() end, Hide = function() end,
		IsVisible = function() return false end, Toggle = function() end }
end
local UIConfig = Deps.UIConfig
local ItemCatalog = Deps.ItemCatalog
local MonetizationConfig = Deps.MonetizationConfig or require(Shared:WaitForChild("MonetizationConfig"))

local Client = script.Parent
local AnimUtil          = require(Client:WaitForChild("AnimUtil"))
local SoundUtil         = require(Client:WaitForChild("SoundUtil"))
local Components        = require(Client:WaitForChild("Components"))
local ThumbnailRenderer = require(Client:WaitForChild("ThumbnailRenderer"))
local RewardPopup       = require(Client:WaitForChild("RewardPopup"))

local C = UIConfig.Colors
local S = UIConfig.Sizes
local ROBUX_ICON_IMAGE = "rbxassetid://138917867019056"
local VIP_GAMEPASS_ID = MonetizationConfig.GetGamePassId("bundle_vip") or 0

local canvas: CanvasGroup = nil
local uiScale: UIScale = nil
local overlay: Frame = nil
local contentFrame: ScrollingFrame = nil
local coinsBgArt: ImageLabel? = nil
-- FadeOverlays: a Frame child of coinsBgArt used as container + duplicate guard.
-- Overlays are ImageLabels inside it, created once and reused across open/close cycles.
local _fadeContainer: Frame? = nil           -- "FadeOverlays" frame inside coinsBgArt
local _fadeOverlays: {ImageLabel} = {}       -- the 6 overlay ImageLabels
local _fadeThreads: {thread} = {}            -- per-overlay animation threads
local visible = false
local closeCallback: (() -> ())? = nil
local activeTab = 1
local _setActiveTab: ((number) -> ())? = nil

local CATEGORIES = {
	{ label = "Coins",   filter = "Currency" },
	{ label = "Crowns",  filter = "ExclusiveCrown" },
	{ label = "Pets",    filter = "ExclusivePet" },
	{ label = "Bundles", filter = "Bundle" },
}

local ShopPanel = {}

local function isMobileTouchDevice(): boolean
	return UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
end

local _bundlePanelOk, _BundlePanel = false, nil
do
	local bpModule = Client:WaitForChild("BundlePanel", 10)
	if bpModule then
		_bundlePanelOk, _BundlePanel = pcall(require, bpModule)
		if not _bundlePanelOk then
			warn("[ShopPanel] BundlePanel failed to load:", _BundlePanel)
			_BundlePanel = nil
		end
	else
		warn("[ShopPanel] BundlePanel module not found -- bundle tab will be empty")
	end
end

local _warnedMissing = {}
-- Items purchased this session: avoids waiting for OwnedCrowns attribute to propagate
local _locallyOwned: {[string]: true} = {}
