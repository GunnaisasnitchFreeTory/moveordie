		function()
			requestForceMode("Brainrot")
		end
	)

	createChoiceButton(
		btnContainer,
		"NormalBtn",
		"Normal Mode",
		NORMAL_MODE_IMAGE,
		BTN_NORMAL_COLOR,
		2,
		function()
			requestForceMode("Normal")
		end
	)

