      <Item class="Script" referent="51">
        <Properties>
          <string name="Name">00_SecuritySanitizer</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--[[
	00_SecuritySanitizer
	Startup/runtime malware guard for known "Error 501" style infections.
]]

local ServerScriptService = game:GetService("ServerScriptService")
local ReplicatedFirst = game:GetService("ReplicatedFirst")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterGui = game:GetService("StarterGui")
local StarterPlayer = game:GetService("StarterPlayer")
local Workspace = game:GetService("Workspace")

local TAG = "[SecuritySanitizer]"

local WATCH_ROOTS: {Instance} = {
	Workspace,
	ServerScriptService,
	ReplicatedStorage,
	StarterGui,
	StarterPlayer,
	StarterPlayer:WaitForChild("StarterPlayerScripts"),
	StarterPlayer:WaitForChild("StarterCharacterScripts"),
	ReplicatedFirst,
}

local SUSPICIOUS_CONTAINER_NAMES: {[string]: boolean} = {
	["do not delete(main core)"] = true,
	["main core"] = true,
	["coreviewsystem"] = true,
	["update"] = true,
	["important"] = true,
}

local SUSPICIOUS_TEXT_PATTERNS: {string} = {
	"coreviewsystem",
	"error 501",
	"version:1.01",
	"do not delete",
	"main core",
	"114706280708394",
	"138561891349979",
	"rbxassetid://114706280708394",
	"rbxassetid://138561891349979",
	"getobjects(",
	"loadasset(",
	"inser tservice", -- obfuscated safety; won't match normal text
	"insertservice",
	"httpservice.httpenabled",
}

local removedCount = 0

local function lower(s: string): string
	return string.lower(s)
end

local function textHasSuspiciousPattern(text: string): boolean
	local t = lower(text)
	for _, pat in ipairs(SUSPICIOUS_TEXT_PATTERNS) do
		if string.find(t, pat, 1, true) ~= nil then
			return true
		end
	end
	-- Detect dynamic long numeric IDs when paired with object-loading APIs.
	local hasLoader = (string.find(t, "getobjects(", 1, true) ~= nil)
		or (string.find(t, "loadasset(", 1, true) ~= nil)
		or (string.find(t, "insertservice", 1, true) ~= nil)
	local hasDynamicRequire = string.find(t, "require(", 1, true) ~= nil
	if (hasLoader or hasDynamicRequire) and string.find(t, "%d%d%d%d%d%d%d%d%d") ~= nil then
		return true
	end
	return false
end

local function scriptSourceLooksSuspicious(inst: Instance): boolean
	if not inst:IsA("LuaSourceContainer") then
		return false
	end
	local ok, source = pcall(function()
		return (inst :: any).Source
	end)
	if ok and type(source) == "string" and source ~= "" then
		return textHasSuspiciousPattern(source)
	end
	return false
end

local function findSuspiciousContainer(inst: Instance): Instance?
	local cur: Instance? = inst
	while cur do
		local n = lower(cur.Name)
		if SUSPICIOUS_CONTAINER_NAMES[n] then
			return cur
		end
		local ok, full = pcall(function()
			return lower(cur:GetFullName())
		end)
		if ok and textHasSuspiciousPattern(full) then
			return cur
		end
		cur = cur.Parent
	end
	return nil
end

local function stringValueLooksSuspicious(inst: Instance): boolean
	if not inst:IsA("StringValue") then
		return false
	end
	return textHasSuspiciousPattern(inst.Name) or textHasSuspiciousPattern(inst.Value)
end

local function isSuspicious(inst: Instance): boolean
	if stringValueLooksSuspicious(inst) then
		return true
	end
	local name = lower(inst.Name)
	if SUSPICIOUS_CONTAINER_NAMES[name] then
		return true
	end
	local ok, fullName = pcall(function()
		return lower(inst:GetFullName())
	end)
	if ok and textHasSuspiciousPattern(fullName) then
		return true
	end
	if scriptSourceLooksSuspicious(inst) then
		return true
	end
	return false
end

local function purge(inst: Instance, reason: string)
	local container = findSuspiciousContainer(inst)
	if container and container.Parent then
		removedCount += 1
		warn(TAG, "Removing suspicious container:", container:GetFullName(), "reason=", reason)
		container:Destroy()
		return
	end
	if inst.Parent then
		removedCount += 1
		warn(TAG, "Removing suspicious instance:", inst:GetFullName(), "reason=", reason)
		inst:Destroy()
	end
end

for _, root in ipairs(WATCH_ROOTS) do
	for _, d in ipairs(root:GetDescendants()) do
		if isSuspicious(d) then
			purge(d, "startup_scan")
		end
	end
	root.DescendantAdded:Connect(function(d)
		if isSuspicious(d) then
			purge(d, "descendant_added")
		end
	end)
end

warn(TAG, "active", "removed_on_startup=", removedCount)
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="52">
        <Properties>
          <string name="Name">01_BackdoorScanner</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--[[
	01_BackdoorScanner
	Studio-only forensic scanner for backdoor signatures.
	Default mode is scan-only. Set CLEANUP_MODE=true to quarantine/destroy hits.
]]

local RunService = game:GetService("RunService")
if not RunService:IsStudio() then
	return
end

local ServerStorage = game:GetService("ServerStorage")

local TAG = "[BackdoorScanner]"
local CLEANUP_MODE = false
local CLEANUP_ACTION: "quarantine" | "destroy" = "quarantine"

local PATTERNS: {string} = {
	"138561891349979",
	"114706280708394",
	"coreviewsystem",
	"do not delete(main core)",
	"do not delete",
	"main core",
	"error 501",
	"getobjects(",
	"rbxassetid://",
	"httpservice.httpenabled",
}

local CONTAINER_NAMES: {[string]: boolean} = {
	["do not delete(main core)"] = true,
	["main core"] = true,
	["coreviewsystem"] = true,
	["update"] = true,
	["important"] = true,
}

local function lower(s: string): string
	return string.lower(s)
end

local function hasPattern(text: string): boolean
	local t = lower(text)
	for _, p in ipairs(PATTERNS) do
		if string.find(t, p, 1, true) ~= nil then
			return true
		end
	end
	return false
end

local function findMatchedLines(source: string, maxLines: number): {string}
	local out = {}
	local lineNo = 0
	for line in string.gmatch(source, "([^\n\r]*)[\n\r]?") do
		lineNo += 1
		local l = lower(line)
		for _, p in ipairs(PATTERNS) do
			if string.find(l, p, 1, true) ~= nil then
				table.insert(out, string.format("L%d: %s", lineNo, line))
				break
			end
		end
		if #out >= maxLines then
			break
		end
	end
	return out
end

local function getSuspiciousContainer(inst: Instance): Instance
	local cur: Instance? = inst
	while cur do
		if CONTAINER_NAMES[lower(cur.Name)] then
			return cur
		end
		cur = cur.Parent
	end
	return inst
end

local seenByPath: {[string]: boolean} = {}
local hits: {Instance} = {}

local function reportHit(inst: Instance, reason: string, sourceLines: {string}?)
	local full = inst:GetFullName()
	local key = full .. "::" .. reason
	if seenByPath[key] then
		return
	end
	seenByPath[key] = true
	table.insert(hits, inst)
	print(string.format("%s HIT reason=%s path=%s class=%s", TAG, reason, full, inst.ClassName))
	if sourceLines and #sourceLines > 0 then
		for _, line in ipairs(sourceLines) do
			print(string.format("%s   %s", TAG, line))
		end
	end
end

local function scanValueChains(inst: Instance)
	local full = lower(inst:GetFullName())
	if string.find(full, ".script.value.script.value", 1, true)
		or string.find(full, ".value.script.value", 1, true)
		or string.find(full, "coreviewsystem", 1, true)
	then
		reportHit(inst, "value_chain_path", nil)
	end

	if inst:IsA("ObjectValue") then
		local target = inst.Value
		if target and target:IsA("LuaSourceContainer") then
			local chainDesc = string.format("%s -> %s", inst:GetFullName(), target:GetFullName())
			if hasPattern(chainDesc) then
				reportHit(inst, "objectvalue_chain", nil)
			end
		end
	end
end

local function scanSources(inst: Instance)
	if not inst:IsA("LuaSourceContainer") then
		return
	end
	local ok, source = pcall(function()
		return (inst :: any).Source
	end)
	if not ok then
		-- Source unreadable; still log suspicious path patterns if present.
		local full = inst:GetFullName()
		if hasPattern(full) then
			reportHit(inst, "source_unreadable_path_match", nil)
		end
		return
	end
	if type(source) ~= "string" or source == "" then
		return
	end
	if hasPattern(source) then
		reportHit(inst, "source_pattern", findMatchedLines(source, 2))
	end
end

local function getQuarantineFolder(): Folder
	local f = ServerStorage:FindFirstChild("Quarantine")
	if f and f:IsA("Folder") then
		return f
	end
	f = Instance.new("Folder")
	f.Name = "Quarantine"
	f.Parent = ServerStorage
	return f
end

print("=== SERVER SCAN START ===")
print(string.format("%s cleanup_mode=%s action=%s", TAG, tostring(CLEANUP_MODE), CLEANUP_ACTION))

for _, d in ipairs(game:GetDescendants()) do
	if CONTAINER_NAMES[lower(d.Name)] then
		reportHit(d, "container_name", nil)
	end
	if hasPattern(d:GetFullName()) then
		reportHit(d, "fullname_pattern", nil)
	end
	scanValueChains(d)
	scanSources(d)
end

local uniqueTargets: {[Instance]: boolean} = {}
for _, inst in ipairs(hits) do
	local target = getSuspiciousContainer(inst)
	uniqueTargets[target] = true
end

local totalTargets = 0
for _ in pairs(uniqueTargets) do
	totalTargets += 1
end

print(string.format("%s total_hits=%d unique_targets=%d", TAG, #hits, totalTargets))

_G.SUSPECTS = {}
for target in pairs(uniqueTargets) do
	table.insert(_G.SUSPECTS, target)
end

if CLEANUP_MODE then
	local quarantine = nil :: Folder?
	if CLEANUP_ACTION == "quarantine" then
		quarantine = getQuarantineFolder()
	end
	for target in pairs(uniqueTargets) do
		if target.Parent then
			if CLEANUP_ACTION == "destroy" then
				warn(string.format("%s DESTROY %s (%s)", TAG, target:GetFullName(), target.ClassName))
				target:Destroy()
			else
				warn(string.format("%s QUARANTINE %s (%s)", TAG, target:GetFullName(), target.ClassName))
				target.Parent = quarantine
			end
		end
	end
end

print("=== SERVER SCAN END ===")
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="53">
        <Properties>
          <string name="Name">BrainrotModeService</string>
          <string name="Source"><![CDATA[--[[
	BrainrotModeService
	Server-side manager for "Save the Brainrot" match mode.

	Handles:
	  * Building a unique-per-match brainrot pool
	  * Spawning 2 brainrots per round inside the arena
	  * ProximityPrompt-based pickup (server-authoritative)
	  * Reward granting (new pet + 100 coins, duplicate → 200 coins)
	  * Per-round and per-match cleanup

	API:
		Init()
		OnMatchStart()          → called when Brainrot mode match begins
		OnRoundStart(round)     → spawn 2 brainrots for this round
		OnRoundEnd()            → despawn remaining pickups
		OnMatchEnd()            → full cleanup + pool reset
		IsActive()              → boolean
]]

local ReplicatedStorage  = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")
local Workspace          = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Server = ServerScriptService:WaitForChild("Server")

local ItemCatalog       = require(Shared:WaitForChild("ItemCatalog"))
local EconomyService    = require(Server:WaitForChild("EconomyService"))
local InventoryService  = require(Server:WaitForChild("InventoryService"))
local MapManager        = require(Server:WaitForChild("MapManager"))

local BRAINROT_FOLDER_NAME = "BrainrotPickups"
local PICKUP_PROMPT_DISTANCE = 8
local EDGE_MARGIN = 8
local RAYCAST_HEIGHT = 80
local SPAWN_BOTTOM_BUFFER = 0.5

local COINS_NEW_PET = 50
local COINS_DUPLICATE = 90

local BrainrotModeService = {}

local initialized = false
local active = false
local availablePool: { string } = {}
local spawnedThisMatch: { string } = {}
local pickupsFolder: Folder? = nil
local collectRemote: RemoteEvent? = nil
local promptConnections: { RBXScriptConnection } = {}
local _DailyQuestService = nil

local function log(...)
	print("[BrainrotMode]", ...)
end

local function getDailyQuestService()
	if _DailyQuestService then return _DailyQuestService end
	local ok, mod = pcall(require, Server:FindFirstChild("DailyQuestService"))
	if ok and mod then
		_DailyQuestService = mod
	end
	return _DailyQuestService
end

local function getBrainrotPetIds(): { string }
	local ids = {}
	for id, pet in pairs(ItemCatalog.Pets) do
		if pet.source == "brainrot_mode" then
			table.insert(ids, id)
		end
	end
	return ids
end

local function shuffleArray(arr: { any })
	for i = #arr, 2, -1 do
		local j = math.random(1, i)
		arr[i], arr[j] = arr[j], arr[i]
	end
end

local function getPickupsFolder(): Folder
	if pickupsFolder and pickupsFolder.Parent then
		return pickupsFolder
	end
	local existing = Workspace:FindFirstChild(BRAINROT_FOLDER_NAME)
	if existing then
		pickupsFolder = existing
		return existing
	end
	local folder = Instance.new("Folder")
	folder.Name = BRAINROT_FOLDER_NAME
	folder.Parent = Workspace
	pickupsFolder = folder
	return folder
end

local function clearPickupsFolder()
	local folder = Workspace:FindFirstChild(BRAINROT_FOLDER_NAME)
	if folder then
		for _, child in ipairs(folder:GetChildren()) do
			child:Destroy()
		end
	end
end

local function disconnectPrompts()
	for _, conn in ipairs(promptConnections) do
		if conn.Connected then
			conn:Disconnect()
		end
	end
	promptConnections = {}
end

local function getRandomArenaPosition(): Vector3?
	local bounds = MapManager.GetActiveBounds()
	if not bounds then
		warn("[BrainrotMode] No active bounds available")
		return nil
	end

	local centerX = bounds.cframe.Position.X
	local centerZ = bounds.cframe.Position.Z
	local topY = bounds.topY

	local halfX = (bounds.sizeX / 2) - EDGE_MARGIN
	local halfZ = (bounds.sizeZ / 2) - EDGE_MARGIN

	if halfX <= 0 or halfZ <= 0 then
		halfX = math.max(halfX, 2)
		halfZ = math.max(halfZ, 2)
	end

	local x = centerX + (math.random() * 2 - 1) * halfX
	local z = centerZ + (math.random() * 2 - 1) * halfZ

	-- Raycast down from well above the arena to find the floor
	local rayOrigin = Vector3.new(x, topY + RAYCAST_HEIGHT, z)
	local rayDir = Vector3.new(0, -(RAYCAST_HEIGHT * 2), 0)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local pickupsFolder_ = Workspace:FindFirstChild(BRAINROT_FOLDER_NAME)
	if pickupsFolder_ then
		params.FilterDescendantsInstances = { pickupsFolder_ }
	end

	local result = Workspace:Raycast(rayOrigin, rayDir, params)
	local y
	if result then
		y = result.Position.Y
	else
		y = topY
	end

	return Vector3.new(x, y, z)
end

local function alignSpawnedBrainrotToGround(inst: Instance, groundPos: Vector3, contextName: string)
	local desiredBottomY = groundPos.Y + SPAWN_BOTTOM_BUFFER

	if inst:IsA("Model") then
		local bboxCF, bboxSize = inst:GetBoundingBox()
		local currentBottomY = bboxCF.Position.Y - (bboxSize.Y / 2)
		local deltaY = desiredBottomY - currentBottomY
		if math.abs(deltaY) > 0.001 then
			inst:PivotTo(inst:GetPivot() + Vector3.new(0, deltaY, 0))
		end
		log(string.format(
			"[SpawnAlign] type=Model context=%s groundY=%.2f desiredBottomY=%.2f currentBottomY=%.2f deltaY=%.2f bboxY=%.2f",
			contextName,
			groundPos.Y,
			desiredBottomY,
			currentBottomY,
			deltaY,
			bboxSize.Y
		))
		return
	end

	if inst:IsA("BasePart") then
		local currentBottomY = inst.Position.Y - (inst.Size.Y / 2)
		local deltaY = desiredBottomY - currentBottomY
		if math.abs(deltaY) > 0.001 then
			inst.Position = inst.Position + Vector3.new(0, deltaY, 0)
		end
		log(string.format(
			"[SpawnAlign] type=BasePart context=%s groundY=%.2f desiredBottomY=%.2f currentBottomY=%.2f deltaY=%.2f partY=%.2f",
			contextName,
			groundPos.Y,
			desiredBottomY,
			currentBottomY,
			deltaY,
			inst.Size.Y
		))
	end
end

local function spawnBrainrot(petId: string)
	local petDef = ItemCatalog.Pets[petId]
	if not petDef then
		warn("[BrainrotMode] Pet not in catalog:", petId)
		return nil
	end

	local modelPath = petDef.modelPath
	if not modelPath then
		warn("[BrainrotMode] No modelPath for:", petId)
		return nil
	end

	local modelTemplate = nil
	local parts = string.split(modelPath, ".")
	local current: Instance = ReplicatedStorage
	for _, part in ipairs(parts) do
		current = current:FindFirstChild(part)
		if not current then
			warn("[BrainrotMode] Model not found at path:", modelPath)
			return nil
		end
	end
	modelTemplate = current

	local spawnPos = getRandomArenaPosition()
	if not spawnPos then return nil end

	local clone = modelTemplate:Clone()
	clone.Name = "Brainrot_" .. petId
	clone:SetAttribute("BrainrotPetId", petId)
	clone:SetAttribute("BrainrotPetName", petDef.name)

	if clone:IsA("Model") then
		if clone.PrimaryPart then
			local yRot = math.random() * math.pi * 2
			clone:PivotTo(CFrame.new(spawnPos) * CFrame.fromAxisAngle(Vector3.new(0, 1, 0), yRot))
		else
			local firstPart = clone:FindFirstChildWhichIsA("BasePart", true)
			if firstPart then
				local offset = spawnPos - firstPart.Position
				for _, desc in ipairs(clone:GetDescendants()) do
					if desc:IsA("BasePart") then
						desc.Position = desc.Position + offset
						desc.Anchored = true
						desc.CanCollide = false
					end
				end
			end
		end
	elseif clone:IsA("BasePart") then
		clone.Position = spawnPos
		clone.Anchored = true
		clone.CanCollide = false
	end

	for _, desc in ipairs(clone:GetDescendants()) do
		if desc:IsA("BasePart") then
			desc.Anchored = true
			desc.CanCollide = false
		end
	end

	-- Parent first so bounding box is valid, then align bottom to ground safely.
	clone.Parent = getPickupsFolder()
	alignSpawnedBrainrotToGround(clone, spawnPos, petId)

	local promptPart = nil
	if clone:IsA("Model") then
		promptPart = clone.PrimaryPart or clone:FindFirstChildWhichIsA("BasePart", true)
	elseif clone:IsA("BasePart") then
		promptPart = clone
	end

	if promptPart then
		local prompt = Instance.new("ProximityPrompt")
		prompt.Name = "BrainrotPickupPrompt"
		prompt.ActionText = "Collect"
		prompt.ObjectText = petDef.name
		prompt.KeyboardKeyCode = Enum.KeyCode.E
		prompt.HoldDuration = 0
		prompt.MaxActivationDistance = PICKUP_PROMPT_DISTANCE
		prompt.RequiresLineOfSight = false
		prompt.Parent = promptPart

		local conn = prompt.Triggered:Connect(function(player)
			if not active then return end
			if not clone or not clone.Parent then return end

			local matchStatus = ReplicatedStorage:FindFirstChild("MatchStatus")
			local modeVal = matchStatus and matchStatus:FindFirstChild("Mode")
			if not modeVal or modeVal.Value ~= "Brainrot" then return end

			clone:Destroy()

			local alreadyOwned = InventoryService.OwnsItem(player, "Pets", petId)
			local coinsAwarded = 0

			if alreadyOwned then
				local _, finalAmount = EconomyService.AwardCoins(player, COINS_DUPLICATE, "BrainrotDuplicate:" .. petId)
				coinsAwarded = finalAmount or COINS_DUPLICATE
				log(string.format("%s collected DUPLICATE %s → +%d coins", player.Name, petDef.name, COINS_DUPLICATE))
			else
				InventoryService.GrantItem(player, "Pets", petId)
				local _, finalAmount = EconomyService.AwardCoins(player, COINS_NEW_PET, "BrainrotNew:" .. petId)
				coinsAwarded = finalAmount or COINS_NEW_PET
				log(string.format("%s collected NEW %s → pet + %d coins", player.Name, petDef.name, COINS_NEW_PET))
			end

			local dqs = getDailyQuestService()
			if dqs and dqs.OnBrainrotPetPickup then
				log(string.format("[QuestBridge] firing Brainrot pickup quest hook player=%s petId=%s mode=Brainrot",
					player.Name, petId))
				pcall(dqs.OnBrainrotPetPickup, player, petId, "Brainrot")
			end

			if collectRemote then
				local imageAssetId = petDef.image
				if not imageAssetId or imageAssetId == "" then
					imageAssetId = ""
				end
				collectRemote:FireClient(player, {
					petId = petId,
					petName = petDef.name,
					isNew = not alreadyOwned,
					alreadyOwned = alreadyOwned,
					coins = coinsAwarded,
					rarity = petDef.rarity,
					imageAssetId = imageAssetId,
					modelPath = petDef.modelPath or "",
				})
			end
		end)
		table.insert(promptConnections, conn)
	end

	-- Add subtle glow Highlight for visibility
	local highlight = Instance.new("Highlight")
	highlight.Name = "BrainrotGlow"
	highlight.Adornee = clone
	highlight.FillColor = Color3.fromRGB(178, 48, 255)
	highlight.FillTransparency = 0.75
	highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
	highlight.OutlineTransparency = 0.3
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.Parent = clone

	log(string.format("Spawned %s at ground=(%.0f, %.0f, %.0f)", petDef.name, spawnPos.X, spawnPos.Y, spawnPos.Z))
	return clone
end

function BrainrotModeService.Init()
	if initialized then return end
	initialized = true

	local remotesFolder = ReplicatedStorage:FindFirstChild("Remotes")
	if not remotesFolder then
		remotesFolder = Instance.new("Folder")
		remotesFolder.Name = "Remotes"
		remotesFolder.Parent = ReplicatedStorage
	end

	local existing = remotesFolder:FindFirstChild("BrainrotCollected")
	if not existing then
		collectRemote = Instance.new("RemoteEvent")
		collectRemote.Name = "BrainrotCollected"
		collectRemote.Parent = remotesFolder
	else
		collectRemote = existing
	end

	log("Initialized")
end

function BrainrotModeService.OnMatchStart()
	active = true
	spawnedThisMatch = {}

	local allIds = getBrainrotPetIds()
	shuffleArray(allIds)
	availablePool = allIds

	log(string.format("Brainrot match started — pool has %d unique pets", #availablePool))
end

function BrainrotModeService.OnRoundStart(roundNumber: number)
	if not active then return end

	clearPickupsFolder()
	disconnectPrompts()

	if #availablePool < 2 then
		if #availablePool == 1 then
			local id = table.remove(availablePool)
			table.insert(spawnedThisMatch, id)
			spawnBrainrot(id)
			log(string.format("Round %d: Only 1 brainrot left in pool — spawned 1", roundNumber))
		else
			log(string.format("Round %d: Pool exhausted — no brainrots to spawn", roundNumber))
		end
		return
	end

	for _ = 1, 2 do
		local id = table.remove(availablePool)
		if id then
			table.insert(spawnedThisMatch, id)
			spawnBrainrot(id)
		end
	end

	log(string.format("Round %d: Spawned 2 brainrots (%d remaining in pool)", roundNumber, #availablePool))
end

function BrainrotModeService.OnRoundEnd()
	if not active then return end
	clearPickupsFolder()
	disconnectPrompts()
	log("Round cleanup complete")
end

function BrainrotModeService.OnMatchEnd()
	active = false
	clearPickupsFolder()
	disconnectPrompts()
	availablePool = {}
	spawnedThisMatch = {}
	log("Match cleanup complete — pool reset")
end

function BrainrotModeService.IsActive(): boolean
	return active
end

return BrainrotModeService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="54">
        <Properties>
          <string name="Name">CrateService</string>
          <string name="Source"><![CDATA[--[[
	CrateService
	Server-authoritative crate opening logic.

	Handles:
	  * Coin deduction for crate purchases
	  * Weighted random rolling from explicit per-item reward tables
	  * Duplicate detection (crowns: reroll up to 5 attempts; pets: single roll)
	  * Duplicates receive NO refund — client shows "Already Owned"
	  * Item granting via InventoryService
	  * Returns result array to caller (for RemoteFunction response)

	Reward tables use explicit per-item weights for easy tuning.
	To adjust drop rates, edit REWARD_TABLES below.

	API:
		Init()
		OpenCrate(player, crateId, quantity) → { results: {}, success: boolean, error: string? }
		RollCrateFree(player, crateId, quantity) → { results: {}, success: boolean, error: string? }
		DebugSimulate(crateId, rolls)  — Studio-only: simulate N rolls, print distribution
]]

local RunService           = game:GetService("RunService")
local ReplicatedStorage    = game:GetService("ReplicatedStorage")
local ServerScriptService  = game:GetService("ServerScriptService")
local HttpService          = game:GetService("HttpService")

local Shared      = ReplicatedStorage:WaitForChild("Shared")
local Server      = ServerScriptService:WaitForChild("Server")
local ItemCatalog = require(Shared:WaitForChild("ItemCatalog"))

local CrateService = {}
local initialized = false

local MAX_REROLL   = 5
local MAX_QUANTITY = 10

-- ── Lazy loaders ──
local _EconomyService = nil
local _InventoryService = nil
local _GrantService = nil
local _PlayerDataService = nil

local function getEconomy()
	if _EconomyService then return _EconomyService end
	local ok, mod = pcall(require, Server:WaitForChild("EconomyService", 10))
	if ok and mod then _EconomyService = mod end
	return _EconomyService
end

local function getInventory()
	if _InventoryService then return _InventoryService end
	local ok, mod = pcall(require, Server:WaitForChild("InventoryService", 10))
	if ok and mod then _InventoryService = mod end
	return _InventoryService
end

local function getGrantService()
	if _GrantService then return _GrantService end
	local ok, mod = pcall(require, Server:WaitForChild("GrantService", 10))
	if ok and mod then _GrantService = mod end
	return _GrantService
end

local function getPlayerData()
	if _PlayerDataService then return _PlayerDataService end
	local ok, mod = pcall(require, Server:WaitForChild("PlayerDataService", 10))
	if ok and mod then _PlayerDataService = mod end
	return _PlayerDataService
end

local function log(...)
	print("[CrateService]", ...)
end

-- ═══════════════════════════════════════════════════════════════════
-- REWARD TABLES  (explicit per-item weights — easy to tune)
-- ═══════════════════════════════════════════════════════════════════

local REWARD_TABLES = {
	-- Weights tuned for heavy grind: Rare ~0.3%, Epic ~0.15%, Aura ~0.07%
	crate_crown = {
		{ itemId = "crown_red",            category = "Crowns", weight = 50 },
		{ itemId = "crown_blue",           category = "Crowns", weight = 50 },
		{ itemId = "crown_green",          category = "Crowns", weight = 50 },
		{ itemId = "crown_purple",         category = "Crowns", weight = 50 },
		{ itemId = "crown_pink",           category = "Crowns", weight = 50 },
		{ itemId = "crown_white",          category = "Crowns", weight = 50 },
		{ itemId = "crown_orange",         category = "Crowns", weight = 50 },
		{ itemId = "crown_sparkle",        category = "Crowns", weight = 3 },
		{ itemId = "crown_anime_lines",    category = "Crowns", weight = 1 },
		{ itemId = "crown_darkness",       category = "Crowns", weight = 1 },
		{ itemId = "crown_love",           category = "Crowns", weight = 1 },
		{ itemId = "crown_mystic_art",     category = "Crowns", weight = 1 },
		{ itemId = "crown_orb",            category = "Crowns", weight = 1 },
		{ itemId = "crown_pop",            category = "Crowns", weight = 1 },
		{ itemId = "crown_cartoon_smoke",  category = "Crowns", weight = 1 },
		{ itemId = "crown_glitch",         category = "Crowns", weight = 1 },
		{ itemId = "crown_mystical",       category = "Crowns", weight = 1 },
		{ itemId = "crown_aura",           category = "Crowns", weight = 1 },
	},
	crate_pet_common = {
		{ itemId = "pet_bald_guest", category = "Pets", weight = 15 },
		{ itemId = "pet_dog",        category = "Pets", weight = 15 },
		{ itemId = "pet_noob",       category = "Pets", weight = 14 },
		{ itemId = "pet_duck",       category = "Pets", weight = 14 },
		{ itemId = "pet_rabbit",     category = "Pets", weight = 14 },
		{ itemId = "pet_crocodile",  category = "Pets", weight = 14 },
		{ itemId = "pet_parrot",     category = "Pets", weight = 14 },
	},
	crate_pet_rare = {
		{ itemId = "pet_scorpion",  category = "Pets", weight = 20 },
		{ itemId = "pet_ray_fish",  category = "Pets", weight = 20 },
		{ itemId = "pet_shark",     category = "Pets", weight = 20 },
		{ itemId = "pet_spider",    category = "Pets", weight = 20 },
		{ itemId = "pet_eagle",     category = "Pets", weight = 20 },
	},
	crate_pet_epic = {
		{ itemId = "pet_axolotl",       category = "Pets", weight = 10 },
		{ itemId = "pet_bat",           category = "Pets", weight = 10 },
		{ itemId = "pet_dolphin",       category = "Pets", weight = 10 },
		{ itemId = "pet_unicorn",       category = "Pets", weight = 10 },
		{ itemId = "pet_steve",         category = "Pets", weight = 10 },
		{ itemId = "pet_zombie",        category = "Pets", weight = 10 },
		{ itemId = "pet_foxy_plush",    category = "Pets", weight = 10 },
		{ itemId = "pet_chica_plush",   category = "Pets", weight = 10 },
		{ itemId = "pet_freddy_plush",  category = "Pets", weight = 7 },
		{ itemId = "pet_bonnie_plush",  category = "Pets", weight = 7 },
		{ itemId = "pet_fredbear_plush", category = "Pets", weight = 3 },
		{ itemId = "pet_huggy_wuggy",   category = "Pets", weight = 3 },
	},
}

-- ═══════════════════════════════════════════════════════════════════
-- WEIGHTED ROLL HELPERS
-- ═══════════════════════════════════════════════════════════════════

local function totalWeight(entries): number
	local t = 0
	for _, e in ipairs(entries) do t += e.weight end
	return t
end

local function normalizeWeights(entries)
	local tw = totalWeight(entries)
	local result = {}
	for _, e in ipairs(entries) do
		table.insert(result, {
			itemId = e.itemId,
			weight = e.weight,
			pct = if tw > 0 then (e.weight / tw) * 100 else 0,
		})
	end
	return result
end

local function weightedRoll(entries)
	local tw = totalWeight(entries)
	if tw <= 0 then return entries[1] end
	local roll = math.random() * tw
	local cumulative = 0
	for _, e in ipairs(entries) do
		cumulative += e.weight
		if roll <= cumulative then return e end
	end
	return entries[#entries]
end

-- ═══════════════════════════════════════════════════════════════════
-- ROLLING LOGIC
-- ═══════════════════════════════════════════════════════════════════

local function rollItem(player: Player, crateId: string): (string, string, boolean)
	local entries = REWARD_TABLES[crateId]
	if not entries or #entries == 0 then
		warn("[CrateService] No reward table for crate:", crateId)
		return "", "Pets", true
	end

	local inv = getInventory()
	local isCrown = (crateId == "crate_crown")

	if isCrown and inv then
		for _ = 1, MAX_REROLL do
			local entry = weightedRoll(entries)
			if not inv.OwnsItem(player, entry.category, entry.itemId) then
				return entry.itemId, entry.category, false
			end
		end
		local entry = weightedRoll(entries)
		return entry.itemId, entry.category, true
	else
		local entry = weightedRoll(entries)
		local isDup = false
		if inv and inv.OwnsItem(player, entry.category, entry.itemId) then
			isDup = true
		end
		return entry.itemId, entry.category, isDup
	end
end

-- ═══════════════════════════════════════════════════════════════════
-- PRICE LOOKUP
-- ═══════════════════════════════════════════════════════════════════

local UNIFIED_PRICES = {
	{ quantity = 1, cost = 500, currency = "Coins" },
	{ quantity = 3, cost = 800, currency = "Coins" },
	{ quantity = 6, cost = 400, currency = "Robux" },
}

local RARE_PET_PRICES = {
	{ quantity = 1, cost = 800, currency = "Coins" },
	{ quantity = 3, cost = 1400, currency = "Coins" },
	{ quantity = 6, cost = 400, currency = "Robux" },
}

local EPIC_PET_PRICES = {
	{ quantity = 1, cost = 1400, currency = "Coins" },
	{ quantity = 3, cost = 1950, currency = "Coins" },
	{ quantity = 6, cost = 400, currency = "Robux" },
}

local CRATE_PRICES = {
	crate_crown      = UNIFIED_PRICES,
	crate_pet_common = UNIFIED_PRICES,
	crate_pet_rare   = RARE_PET_PRICES,
	crate_pet_epic   = EPIC_PET_PRICES,
}

local function findPrice(crateId: string, quantity: number): { cost: number, currency: string }?
	local prices = CRATE_PRICES[crateId]
	if not prices then return nil end
	for _, p in ipairs(prices) do
		if p.quantity == quantity then
			return p
		end
	end
	return nil
end

-- ═══════════════════════════════════════════════════════════════════
-- PUBLIC API
-- ═══════════════════════════════════════════════════════════════════

function CrateService.Init()
	if initialized then return end
	initialized = true

	local priceIds, rewardIds, catalogIds = {}, {}, {}
	for id in pairs(CRATE_PRICES) do table.insert(priceIds, id) end
	for id in pairs(REWARD_TABLES) do table.insert(rewardIds, id) end
	for id in pairs(ItemCatalog.Crates) do table.insert(catalogIds, id) end
	table.sort(priceIds); table.sort(rewardIds); table.sort(catalogIds)

	log("=== Crate ID sanity check ===")
	log("  CRATE_PRICES:       ", table.concat(priceIds, ", "))
	log("  REWARD_TABLES:      ", table.concat(rewardIds, ", "))
	log("  ItemCatalog.Crates: ", table.concat(catalogIds, ", "))

	local priceSet, rewardSet, catalogSet = {}, {}, {}
	for _, id in ipairs(priceIds) do priceSet[id] = true end
	for _, id in ipairs(rewardIds) do rewardSet[id] = true end
	for _, id in ipairs(catalogIds) do catalogSet[id] = true end

	for id in pairs(priceSet) do
		if not catalogSet[id] then warn("[CrateService] MISMATCH:", id, "in CRATE_PRICES but NOT in ItemCatalog.Crates") end
		if not rewardSet[id] then warn("[CrateService] MISMATCH:", id, "in CRATE_PRICES but NOT in REWARD_TABLES") end
	end
	for id in pairs(rewardSet) do
		if not priceSet[id] then warn("[CrateService] MISMATCH:", id, "in REWARD_TABLES but NOT in CRATE_PRICES") end
	end

	for _, crateId in ipairs(rewardIds) do
		local nw = normalizeWeights(REWARD_TABLES[crateId])
		local parts = {}
		for _, e in ipairs(nw) do
			table.insert(parts, string.format("%s=%.1f%%", e.itemId, e.pct))
		end
		log("  Weights [" .. crateId .. "]: " .. table.concat(parts, ", "))
	end

	log("Initialized —", #priceIds, "crate types")
end

function CrateService.GetCrateCounts(player: Player): { [string]: number }
	local pds = getPlayerData()
	if not pds then return {} end
	local data = pds.GetData(player)
	if not data then return {} end
	local owned = data.OwnedCrates
	if type(owned) ~= "table" then
		owned = {}
		pds.SetField(player, "OwnedCrates", owned)
	end
	return owned
end

function CrateService.GetCrateCount(player: Player, crateId: string): number
	local counts = CrateService.GetCrateCounts(player)
	local n = tonumber(counts[crateId]) or 0
	return math.max(0, math.floor(n))
end

function CrateService.AddCrates(player: Player, crateId: string, quantity: number, source: string?): { success: boolean, reason: string?, newCount: number? }
	quantity = math.max(1, math.floor(quantity or 0))
	if not ItemCatalog.Crates[crateId] then
		return { success = false, reason = "Unknown crate type" }
	end
	local pds = getPlayerData()
	if not pds or not pds.IsLoaded(player) then
		return { success = false, reason = "Data not loaded" }
	end

	local data = pds.GetData(player)
	if not data then
		return { success = false, reason = "Data not loaded" }
	end
	local counts = data.OwnedCrates
	if type(counts) ~= "table" then
		counts = {}
	end
	local current = tonumber(counts[crateId]) or 0
	local newCount = current + quantity
	counts[crateId] = newCount
	pds.SetField(player, "OwnedCrates", counts)

	print(string.format("[CrateBuy] SUCCESS player=%s crateType=%s qty=%d newCount=%d source=%s",
		player.Name, crateId, quantity, newCount, tostring(source or "Unknown")))
	return { success = true, newCount = newCount }
end

function CrateService.OpenOwnedCrates(player: Player, crateId: string, quantity: number): { results: { any }, success: boolean, error: string?, newCount: number? }
	if type(crateId) ~= "string" or type(quantity) ~= "number" then
		return { results = {}, success = false, error = "Invalid arguments" }
	end
	quantity = math.clamp(math.floor(quantity), 1, MAX_QUANTITY)
	if not ItemCatalog.Crates[crateId] then
		return { results = {}, success = false, error = "Unknown crate: " .. tostring(crateId) }
	end

	local pds = getPlayerData()
	if not pds or not pds.IsLoaded(player) then
		return { results = {}, success = false, error = "Data not loaded" }
	end
	local data = pds.GetData(player)
	if not data then
		return { results = {}, success = false, error = "Data not loaded" }
	end

	local counts = data.OwnedCrates
	if type(counts) ~= "table" then
		counts = {}
	end
	local current = math.max(0, math.floor(tonumber(counts[crateId]) or 0))
	if current < quantity then
		return { results = {}, success = false, error = "Not enough owned crates" }
	end

	local newCount = current - quantity
	counts[crateId] = newCount
	pds.SetField(player, "OwnedCrates", counts)

	local rolled = CrateService.RollCrateFree(player, crateId, quantity)
	if not rolled.success then
		-- Roll failed after consume: restore crate balance.
		counts[crateId] = current
		pds.SetField(player, "OwnedCrates", counts)
		return { results = {}, success = false, error = rolled.error or "Open failed" }
	end

	return {
		results = rolled.results or {},
		success = true,
		newCount = newCount,
	}
end

function CrateService.BuyCrateWithCoins(player: Player, crateId: string, quantity: number): { success: boolean, reason: string?, newCount: number?, cost: number? }
	if type(crateId) ~= "string" or type(quantity) ~= "number" then
		print(string.format("[CrateBuy] FAIL reason=%s", "Invalid arguments"))
		return { success = false, reason = "Invalid arguments" }
	end
	quantity = math.clamp(math.floor(quantity), 1, MAX_QUANTITY)
	local price = findPrice(crateId, quantity)
	if not price then
		print(string.format("[CrateBuy] FAIL reason=%s", "No price for quantity"))
		return { success = false, reason = "No price for quantity" }
	end
	if price.currency ~= "Coins" then
		print(string.format("[CrateBuy] FAIL reason=%s", "Robux purchase required"))
		return { success = false, reason = "Robux purchase required" }
	end
	local economy = getEconomy()
	if not economy then
		print(string.format("[CrateBuy] FAIL reason=%s", "Economy service unavailable"))
		return { success = false, reason = "Economy service unavailable" }
	end
	if not economy.DeductCoins(player, price.cost, "CrateBuy:" .. crateId .. "x" .. quantity) then
		print(string.format("[CrateBuy] FAIL reason=%s", "INSUFFICIENT_FUNDS"))
		return { success = false, reason = "INSUFFICIENT_FUNDS" }
	end
	local add = CrateService.AddCrates(player, crateId, quantity, "Coins")
	if not add.success then
		economy.AwardCoins(player, price.cost, "CrateBuyRefund:" .. crateId, true)
		print(string.format("[CrateBuy] FAIL reason=%s", tostring(add.reason or "AddCrates failed")))
		return { success = false, reason = add.reason or "AddCrates failed" }
	end
	return { success = true, newCount = add.newCount, cost = price.cost }
end

function CrateService.OpenCrate(player: Player, crateId: string, quantity: number): { results: { any }, success: boolean, error: string? }
	if type(crateId) ~= "string" or type(quantity) ~= "number" then
		return { results = {}, success = false, error = "Invalid arguments" }
	end

	quantity = math.clamp(math.floor(quantity), 1, MAX_QUANTITY)

	if not ItemCatalog.Crates[crateId] then
		return { results = {}, success = false, error = "Unknown crate: " .. tostring(crateId) }
	end

	local price = findPrice(crateId, quantity)
	if not price then
		return { results = {}, success = false, error = "No price for quantity " .. tostring(quantity) }
	end

	if price.currency == "Robux" then
		return { results = {}, success = false, error = "Robux crates must be purchased through the shop" }
	end

	local economy = getEconomy()
	if not economy then
		return { results = {}, success = false, error = "Economy service unavailable" }
	end

	if not economy.DeductCoins(player, price.cost, "Crate:" .. crateId .. "x" .. quantity) then
		return { results = {}, success = false, error = "Not enough coins" }
	end

	local grant = getGrantService()
	if not grant then
		return { results = {}, success = false, error = "Grant service unavailable" }
	end

	local crateTxnId = HttpService:GenerateGUID(false)
	local results = {}
	local grantedPopupItems = {}
	local grantSuccessCount = 0
	local duplicateCount = 0
	local grantFailureCount = 0

	for rollIndex = 1, quantity do
		local itemId, category, isDuplicate = rollItem(player, crateId)

		local catalogEntry = ItemCatalog.Get(category, itemId)
		local result = {
			itemId = itemId,
			category = category,
			isDuplicate = isDuplicate,
			coinsAwarded = 0,
			displayName = catalogEntry and catalogEntry.name or itemId,
			rarity = catalogEntry and catalogEntry.rarity or "Common",
		}

		if isDuplicate or itemId == "" then
			if isDuplicate then
				duplicateCount += 1
			end
			log(string.format("%s opened %s — already owned: %s (%s)",
				player.Name, crateId, itemId, category))
		else
			if category == "Crowns" then
				print(string.format("[CrateOpen] reward type=Crown id=%s", tostring(itemId)))
				print(string.format("[GrantCrown] START id=%s", tostring(itemId)))
			end
			local grantType = (category == "Crowns") and "Crown" or "Pet"
			local grantRes = grant.GrantItem(player, grantType, itemId, "Crate", {
				fireReward = false,
				idempotencyKey = string.format("crate:%s:%s:%d:%s", player.UserId, crateTxnId, rollIndex, itemId),
				payload = {
					type = grantType,
					id = itemId,
					category = category,
					source = "Crate",
					rarity = result.rarity,
					name = result.displayName,
				},
			})
			local ownsAfterGrant = false
			local inv = getInventory()
			if inv then
				ownsAfterGrant = inv.OwnsItem(player, category, itemId) == true
			end
			if grantRes.success then
				result.grantSuccess = true
				grantSuccessCount += 1
				table.insert(grantedPopupItems, {
					type = grantType,
					id = itemId,
					category = category,
					source = "Crate",
					rarity = result.rarity,
					name = result.displayName,
				})
				if category == "Crowns" then
					print(string.format("[GrantCrown] SUCCESS id=%s (owned=%s)", tostring(itemId), tostring(ownsAfterGrant)))
				end
			else
				result.grantSuccess = false
				grantFailureCount += 1
				result.grantFailReason = grantRes.reason or (category == "Crowns" and "OWNERSHIP_NOT_PERSISTED") or "UNKNOWN"
				warn(string.format("[CrateService] Grant failed player=%s crate=%s roll=%d item=%s reason=%s",
					player.Name, crateId, rollIndex, itemId, tostring(grantRes.reason)))
				if category == "Crowns" then
					print(string.format("[GrantCrown] FAIL id=%s reason=%s",
						tostring(itemId),
						tostring(result.grantFailReason)))
				end
			end
			local entry = ItemCatalog.Get(category, itemId)
			log(string.format("%s opened %s — got %s (%s)",
				player.Name, crateId, entry and entry.name or itemId, category))
		end

		table.insert(results, result)
	end

	if #grantedPopupItems > 0 then
		grant.EmitRewardGranted(player, {
			type = "Crate",
			id = crateId,
			source = "Crate",
			batchItems = grantedPopupItems,
		})
	end

	print(string.format(
		"[CrateOpenAudit] player=%s crate=%s requestedQty=%d rewardsGenerated=%d inventoryGranted=%d duplicates=%d grantFailures=%d",
		player.Name,
		crateId,
		quantity,
		#results,
		grantSuccessCount,
		duplicateCount,
		grantFailureCount
	))

	return { results = results, success = true }
end

--[[
	RollCrateFree — rolls crates WITHOUT charging coins.
	Used by DailyRewardService for reward crates.
	Same rolling + granting logic as OpenCrate, but no price lookup / coin deduction.
]]
function CrateService.RollCrateFree(player: Player, crateId: string, quantity: number): { results: { any }, success: boolean, error: string? }
	if type(crateId) ~= "string" or type(quantity) ~= "number" then
		return { results = {}, success = false, error = "Invalid arguments" }
	end

	quantity = math.clamp(math.floor(quantity), 1, MAX_QUANTITY)

	if not REWARD_TABLES[crateId] then
		return { results = {}, success = false, error = "Unknown crate: " .. tostring(crateId) }
	end

	local grant = getGrantService()
	if not grant then
		return { results = {}, success = false, error = "Grant service unavailable" }
	end

	local crateTxnId = HttpService:GenerateGUID(false)
	local results = {}
	local grantedPopupItems = {}
	local grantSuccessCount = 0
	local duplicateCount = 0
	local grantFailureCount = 0

	for i = 1, quantity do
		local itemId, category, isDuplicate = rollItem(player, crateId)

		local catalogEntry = ItemCatalog.Get(category, itemId)
		local result = {
			itemId = itemId,
			category = category,
			isDuplicate = isDuplicate,
			coinsAwarded = 0,
			displayName = catalogEntry and catalogEntry.name or itemId,
			rarity = catalogEntry and catalogEntry.rarity or "Common",
		}

		if isDuplicate or itemId == "" then
			if isDuplicate then
				duplicateCount += 1
			end
			log(string.format("%s FREE roll #%d %s — already owned: %s (%s)",
				player.Name, i, crateId, itemId, category))
		else
			if category == "Crowns" then
				print(string.format("[CrateOpen] reward type=Crown id=%s", tostring(itemId)))
				print(string.format("[GrantCrown] START id=%s", tostring(itemId)))
			end
			local grantType = (category == "Crowns") and "Crown" or "Pet"
			local grantRes = grant.GrantItem(player, grantType, itemId, "Crate", {
				fireReward = false,
				idempotencyKey = string.format("cratefree:%s:%s:%d:%s", player.UserId, crateTxnId, i, itemId),
				payload = {
					type = grantType,
					id = itemId,
					category = category,
					source = "Crate",
					rarity = result.rarity,
					name = result.displayName,
				},
			})
			local ownsAfterGrant = false
			local inv = getInventory()
			if inv then
				ownsAfterGrant = inv.OwnsItem(player, category, itemId) == true
			end
			if grantRes.success then
				result.grantSuccess = true
				grantSuccessCount += 1
				table.insert(grantedPopupItems, {
					type = grantType,
					id = itemId,
					category = category,
					source = "Crate",
					rarity = result.rarity,
					name = result.displayName,
				})
				if category == "Crowns" then
					print(string.format("[GrantCrown] SUCCESS id=%s (owned=%s)", tostring(itemId), tostring(ownsAfterGrant)))
				end
			else
				result.grantSuccess = false
				grantFailureCount += 1
				result.grantFailReason = grantRes.reason or (category == "Crowns" and "OWNERSHIP_NOT_PERSISTED") or "UNKNOWN"
				warn(string.format("[CrateService] Free grant failed player=%s crate=%s roll=%d item=%s reason=%s",
					player.Name, crateId, i, itemId, tostring(grantRes.reason)))
				if category == "Crowns" then
					print(string.format("[GrantCrown] FAIL id=%s reason=%s",
						tostring(itemId),
						tostring(result.grantFailReason)))
				end
			end
			log(string.format("%s FREE roll #%d %s — got %s (%s)",
				player.Name, i, crateId, catalogEntry and catalogEntry.name or itemId, category))
		end

		table.insert(results, result)
	end

	if #grantedPopupItems > 0 then
		grant.EmitRewardGranted(player, {
			type = "Crate",
			id = crateId,
			source = "Crate",
			batchItems = grantedPopupItems,
		})
	end

	print(string.format(
		"[CrateOpenAudit] player=%s crate=%s requestedQty=%d rewardsGenerated=%d inventoryGranted=%d duplicates=%d grantFailures=%d source=Free",
		player.Name,
		crateId,
		quantity,
		#results,
		grantSuccessCount,
		duplicateCount,
		grantFailureCount
	))

	return { results = results, success = true }
end

-- ═══════════════════════════════════════════════════════════════════
-- DEBUG: Simulate rolls (Studio only)
-- ═══════════════════════════════════════════════════════════════════

function CrateService.DebugSimulate(crateId: string, rolls: number?)
	if not RunService:IsStudio() then
		warn("[CrateService] DebugSimulate is Studio-only")
		return
	end

	rolls = rolls or 10000

	local entries = REWARD_TABLES[crateId]
	if not entries then
		warn("[CrateService] No reward table for:", crateId)
		return
	end

	local counts: { [string]: number } = {}
	for _ = 1, rolls do
		local entry = weightedRoll(entries)
		counts[entry.itemId] = (counts[entry.itemId] or 0) + 1
	end

	local tw = totalWeight(entries)
	log(string.format("=== Simulated %d rolls for %s ===", rolls, crateId))
	for _, e in ipairs(entries) do
		local actual = counts[e.itemId] or 0
		local actualPct = (actual / rolls) * 100
		local expectedPct = if tw > 0 then (e.weight / tw) * 100 else 0
		log(string.format("  %-25s w=%3d  expected=%.1f%%  actual=%.1f%% (%d)",
			e.itemId, e.weight, expectedPct, actualPct, actual))
	end
	log("=== End simulation ===")
end

return CrateService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="55">
        <Properties>
          <string name="Name">CrownAttachService</string>
          <string name="Source"><![CDATA[--[[
	CrownAttachService
	Server-side crown visual attachment.

	Listens for EquippedCrown player attribute changes and attaches
	the corresponding crown model to the character's Head as an Accessory.

	Crown models are Parts with SpecialMesh + HatAttachment. This service:
	  1. Clones the source model from ItemModelRegistry
	  2. Wraps it in an Accessory (Handle pattern)
	  3. Parents to character — Roblox auto-welds via HatAttachment

	Handles:
	  - Equip / unequip / swap (only one crown at a time)
	  - Respawn (re-attaches on CharacterAdded)
	  - Cleanup on player leave

	API:
	  CrownAttachService.Init()
]]

local Players            = game:GetService("Players")
local ReplicatedStorage  = game:GetService("ReplicatedStorage")
local RunService         = game:GetService("RunService")

local Shared             = ReplicatedStorage:WaitForChild("Shared")
local ItemCatalog        = require(Shared:WaitForChild("ItemCatalog"))
local ItemModelRegistry  = require(Shared:WaitForChild("ItemModelRegistry"))

local TAG = "[CrownAttachService]"
local CROWN_TAG = "_EquippedCrown"   -- Accessory.Name so we can find/remove it
local CROWN_VISUAL_OFFSETS: { [string]: CFrame } = {
	crown_freddy_mask = CFrame.Angles(0, math.rad(180), 0),
	crown_6am = CFrame.Angles(0, math.rad(180), 0),
}

local CrownAttachService = {}
local _connections: { [Player]: { RBXScriptConnection } } = {}

local function log(...)
	print(TAG, ...)
end

local function ensureValidBeam(beam: Beam): boolean
	local function invalidate()
		if beam.Parent then
			beam:Destroy()
		end
	end
	local function isAttachmentValid(att: Attachment?): boolean
		return att ~= nil and att.Parent ~= nil and att:IsDescendantOf(game)
	end
	local function validateNow()
		if not beam.Parent then
			return false
		end
		local a0 = beam.Attachment0
		local a1 = beam.Attachment1
		if not isAttachmentValid(a0) or not isAttachmentValid(a1) then
			invalidate()
			return false
		end
		return true
	end

	if not validateNow() then
		return false
	end

	beam:GetPropertyChangedSignal("Attachment0"):Connect(validateNow)
	beam:GetPropertyChangedSignal("Attachment1"):Connect(validateNow)
	local a0 = beam.Attachment0
	local a1 = beam.Attachment1
	if a0 then
		a0.AncestryChanged:Connect(validateNow)
	end
	if a1 then
		a1.AncestryChanged:Connect(validateNow)
	end
	beam.AncestryChanged:Connect(function()
		if beam.Parent then
			validateNow()
		end
	end)

	return true
end

-- =====================================================================
-- HELPERS
-- =====================================================================

local function getCrownDef(crownId: string)
	if not crownId or crownId == "" then return nil end
	return ItemCatalog.Crowns and ItemCatalog.Crowns[crownId]
end

--- Remove any existing equipped crown Accessory from a character.
local function removeCrown(character: Model)
	for _, child in ipairs(character:GetChildren()) do
		if child.Name == CROWN_TAG and child:IsA("Accessory") then
			child:Destroy()
		end
	end
end

--- Clone a crown model, wrap in Accessory, parent to character.
local function attachCrown(character: Model, crownId: string)
	local head = character:FindFirstChild("Head")
	if not head then
		warn(TAG, "No Head on character — cannot attach crown")
		return
	end

	local crownDef = getCrownDef(crownId)
	if not crownDef then
		warn(TAG, "Crown not in catalog:", crownId)
		return
	end

	local modelPath = crownDef.modelPath
	local sourceModel = nil
	if modelPath and modelPath ~= "" then
		sourceModel = ItemModelRegistry.Get(modelPath)
	end
	if not sourceModel and crownDef.modelName and crownDef.modelName ~= "" then
		sourceModel = ItemModelRegistry.GetByExactName(crownDef.modelName)
		if sourceModel then
			log(string.format("Fallback model resolve by exact name: crownId=%s modelName=%s", crownId, crownDef.modelName))
		end
	end
	if not sourceModel and crownId == "crown_thestrongest" then
		sourceModel = ItemModelRegistry.Get("ItemModels.Crowns.Findable.THESTRONGEST Crown")
		if sourceModel then
			log("Fallback model resolve by fixed path for crown_thestrongest")
		end
	end
	if not sourceModel then
		warn(TAG, "Unable to resolve crown model:",
			"| crownId:", crownId,
			"| modelPath:", tostring(modelPath),
			"| modelName:", tostring(crownDef.modelName))
		return
	end

	log("Attaching crown:", crownId, "path:", modelPath)

	local clone = sourceModel:Clone()

	-- Build the Accessory wrapper
	local accessory = Instance.new("Accessory")
	accessory.Name = CROWN_TAG

	if clone:IsA("BasePart") then
		-- Most crowns are a single Part (SpecialMesh + HatAttachment inside)
		clone.Name = "Handle"
		clone.Anchored = false
		clone.CanCollide = false

		-- Weld any child BaseParts to Handle (e.g. VFX carrier parts)
		for _, desc in ipairs(clone:GetDescendants()) do
			if desc:IsA("BasePart") and desc ~= clone then
				desc.Anchored = false
				desc.CanCollide = false
				local weld = Instance.new("WeldConstraint")
				weld.Part0 = clone
				weld.Part1 = desc
				weld.Parent = desc
			end
		end

		clone.Parent = accessory

	elseif clone:IsA("Model") then
		-- Crown is a Model — pick the main part as Handle
		local handle = clone.PrimaryPart or clone:FindFirstChildWhichIsA("BasePart", true)
		if not handle then
			warn(TAG, "Crown model has no BasePart:", crownId)
			clone:Destroy()
			accessory:Destroy()
			return
		end

		handle.Name = "Handle"
		handle.Anchored = false
		handle.CanCollide = false

		-- Weld any sibling parts to Handle so they move together
		for _, part in ipairs(clone:GetDescendants()) do
			if part:IsA("BasePart") and part ~= handle then
				part.Anchored = false
				part.CanCollide = false
				local weld = Instance.new("WeldConstraint")
				weld.Part0 = handle
				weld.Part1 = part
				weld.Parent = part
			end
		end

		-- Move all children from the model into the Accessory
		for _, child in ipairs(clone:GetChildren()) do
			child.Parent = accessory
		end
		clone:Destroy()
	else
		warn(TAG, "Crown is neither BasePart nor Model:", clone.ClassName)
		clone:Destroy()
		accessory:Destroy()
		return
	end

	-- Ensure HatAttachment exists on Handle for auto-weld
	local handle = accessory:FindFirstChild("Handle")
	if handle then
		local att = handle:FindFirstChild("HatAttachment")
		if not att then
			att = Instance.new("Attachment")
			att.Name = "HatAttachment"
			att.Parent = handle
		end
		local offset = CROWN_VISUAL_OFFSETS[crownId]
		if offset then
			att.CFrame = att.CFrame * offset
			if RunService:IsStudio() then
				print(string.format("[CrownOffset] Applied offset for %s", crownId))
			end
		end
	end

	-- Parent to character — Roblox Accessory system auto-welds via matching Attachment
	accessory.Parent = character

	-- Enable all VFX (ParticleEmitters, Beams, Trails, PointLights, etc.)
	-- These may be disabled in ReplicatedStorage; force-enable after attaching.
	local vfxCount = 0
	for _, desc in ipairs(accessory:GetDescendants()) do
		if desc:IsA("ParticleEmitter") or desc:IsA("Trail") then
			desc.Enabled = true
			vfxCount += 1
		elseif desc:IsA("Beam") then
			if ensureValidBeam(desc) then
				desc.Enabled = true
				vfxCount += 1
			end
		elseif desc:IsA("Fire") or desc:IsA("Sparkles") or desc:IsA("Smoke") then
			desc.Enabled = true
			vfxCount += 1
		elseif desc:IsA("PointLight") or desc:IsA("SpotLight") or desc:IsA("SurfaceLight") then
			desc.Enabled = true
			vfxCount += 1
		end
	end

	log("Crown attached:", crownId, vfxCount > 0 and string.format("(%d VFX enabled)", vfxCount) or "(no VFX)")
end

-- =====================================================================
-- EQUIP STATE
-- =====================================================================

--- Read the player's EquippedCrown attribute and update the visual.
local function updateCrownVisual(player: Player)
	local character = player.Character
	if not character then return end

	-- Remove any existing crown first (prevents duplicates)
	removeCrown(character)

	local crownId = player:GetAttribute("EquippedCrown")
	if crownId and crownId ~= "" then
		attachCrown(character, crownId)
	end
end

-- =====================================================================
-- PLAYER LIFECYCLE
-- =====================================================================

local function setupPlayer(player: Player)
	local conns: { RBXScriptConnection } = {}

	-- Re-attach on equip/unequip/swap
	table.insert(conns, player:GetAttributeChangedSignal("EquippedCrown"):Connect(function()
		updateCrownVisual(player)
	end))

	-- Re-attach on respawn
	table.insert(conns, player.CharacterAdded:Connect(function(character)
		character:WaitForChild("Head", 10)
		task.wait(0.2) -- brief delay for character to fully load
		updateCrownVisual(player)
	end))

	_connections[player] = conns

	-- If player already has a character + equipped crown, attach now
	if player.Character then
		task.spawn(function()
			local head = player.Character:FindFirstChild("Head")
			if not head then player.Character:WaitForChild("Head", 10) end
			task.wait(0.3)
			updateCrownVisual(player)
		end)
	end
end

local function cleanupPlayer(player: Player)
	if _connections[player] then
		for _, conn in ipairs(_connections[player]) do
			conn:Disconnect()
		end
		_connections[player] = nil
	end
end

-- =====================================================================
-- PUBLIC API
-- =====================================================================

function CrownAttachService.Init()
	log("Initializing...")

	Players.PlayerAdded:Connect(setupPlayer)
	Players.PlayerRemoving:Connect(cleanupPlayer)

	-- Handle players already in game (late init / Studio)
	for _, player in ipairs(Players:GetPlayers()) do
		task.spawn(setupPlayer, player)
	end

	log("Ready")
end

return CrownAttachService
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="56">
        <Properties>
          <string name="Name">CrownPetShopServer</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--[[
	CrownPetShopServer
	Server-side script for the walk-up Crate Shop + shared RemoteEvents.

	Responsibilities:
	  1. Ensures Remotes folder exists with all needed events:
	     • OpenCrateShop — walk-up shop fallback
	     • ToggleAFK — client requests AFK toggle
	     • KillFeedEvent — server broadcasts eliminations to clients
	     • SpectateTarget — spectate camera commands
	  2. Finds the CrownPetShop model in Workspace
	  3. REMOVES any ProximityPrompt (walk-up is now client-side proximity)
	  4. Handles ToggleAFK requests from clients

	The actual "walk near and open" detection is handled CLIENT-SIDE
	in UIController.luau via RunService.Heartbeat distance checks.
	This avoids the need for holding E or any interaction prompt.
]]

local ServerScriptService = game:GetService("ServerScriptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- ─── Ensure Remotes folder + all events exist ───
local remotesFolder = ReplicatedStorage:FindFirstChild("Remotes")
if not remotesFolder then
	remotesFolder = Instance.new("Folder")
	remotesFolder.Name = "Remotes"
	remotesFolder.Parent = ReplicatedStorage
end

local function ensureRemote(name: string): RemoteEvent
	local event = remotesFolder:FindFirstChild(name)
	if not event then
		event = Instance.new("RemoteEvent")
		event.Name = name
		event.Parent = remotesFolder
	end
	return event
end

local openCrateShopEvent = ensureRemote("OpenCrateShop")
local toggleAFKEvent     = ensureRemote("ToggleAFK")
local killFeedEvent      = ensureRemote("KillFeedEvent")
local spectateTarget     = ensureRemote("SpectateTarget")

-- ─── ToggleAFK handler ───
local function getPlayerStateService()
	local ok, service = pcall(function()
		local Server = ServerScriptService:WaitForChild("Server", 5)
		if Server then
			return require(Server:WaitForChild("PlayerStateService", 5))
		end
		return nil
	end)
	return ok and service or nil
end

-- ─── AFK Billboard helpers ───
local Players = game:GetService("Players")

local AFK_BILLBOARD_NAME = "AFKBillboard"
local PLAYER_NAME_BILLBOARD_NAME = "PlayerNameBillboard"

local function createAFKBillboard(character: Model)
	if not character then return end
	-- Remove existing if any
	local existing = character:FindFirstChild(AFK_BILLBOARD_NAME)
	if existing then return end

	local head = character:FindFirstChild("Head")
	if not head then return end

	local billboard = Instance.new("BillboardGui")
	billboard.Name = AFK_BILLBOARD_NAME
	billboard.Adornee = head
	billboard.Size = UDim2.fromOffset(100, 40)
	billboard.StudsOffset = Vector3.new(0, 4, 0)
	billboard.AlwaysOnTop = true
	billboard.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	billboard.MaxDistance = 80
	billboard.Parent = character

	local label = Instance.new("TextLabel")
	label.Name = "AFKLabel"
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBold
	label.TextColor3 = Color3.fromRGB(255, 200, 50)
	label.TextSize = 24
	label.Text = "AFK"
	label.TextScaled = false
	label.Parent = billboard

	local textStroke = Instance.new("UIStroke")
	textStroke.Color = Color3.fromRGB(0, 0, 0)
	textStroke.Thickness = 2.5
	textStroke.Parent = label
end

local function removeAFKBillboard(character: Model)
	if not character then return end
	local existing = character:FindFirstChild(AFK_BILLBOARD_NAME)
	if existing then
		existing:Destroy()
	end
end

local function applyStyledPlayerNameplate(player: Player, character: Model)
	if not player or not character then return end

	local head = character:FindFirstChild("Head")
	if not head then return end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		-- Hide Roblox default overhead name so only the styled tag is visible.
		humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	end

	local existing = character:FindFirstChild(PLAYER_NAME_BILLBOARD_NAME)
	if existing then
		existing:Destroy()
	end

	local billboard = Instance.new("BillboardGui")
	billboard.Name = PLAYER_NAME_BILLBOARD_NAME
	billboard.Adornee = head
	billboard.Size = UDim2.fromOffset(170, 28)
	billboard.StudsOffset = Vector3.new(0, 2.25, 0)
	billboard.AlwaysOnTop = true
	billboard.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	billboard.MaxDistance = 120
	billboard.Parent = character

	local label = Instance.new("TextLabel")
	label.Name = "NameLabel"
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBold
	label.Text = player.Name
	label.TextColor3 = Color3.fromRGB(255, 165, 45)
	label.TextSize = 15
	label.TextScaled = false
	label.TextXAlignment = Enum.TextXAlignment.Center
	label.TextYAlignment = Enum.TextYAlignment.Center
	label.TextTruncate = Enum.TextTruncate.AtEnd
	label.Parent = billboard

	local textStroke = Instance.new("UIStroke")
	textStroke.Color = Color3.fromRGB(0, 0, 0)
	textStroke.Thickness = 1.8
	textStroke.Transparency = 0.1
	textStroke.Parent = label
end

Players.PlayerAdded:Connect(function(player)
	player.CharacterAdded:Connect(function(character)
		task.defer(function()
			applyStyledPlayerNameplate(player, character)
		end)
	end)
end)

for _, player in ipairs(Players:GetPlayers()) do
	if player.Character then
		task.defer(function()
			applyStyledPlayerNameplate(player, player.Character)
		end)
	end
end

task.spawn(function()
	local PSS = getPlayerStateService()
	if not PSS then
		warn("[CrownPetShopServer] PlayerStateService not found — AFK toggle disabled")
		return
	end

	toggleAFKEvent.OnServerEvent:Connect(function(player)
		local currentState = player:GetAttribute("PlayerState")
		local isAFK = (currentState == "AFK")
		local success = PSS.SetAFK(player, not isAFK)
		if success then
			print(string.format("[Server] %s toggled AFK: %s", player.Name, isAFK and "OFF" or "ON"))
			-- Manage AFK billboard
			local character = player.Character
			if not isAFK then
				-- Was NOT AFK → now IS AFK → show billboard
				createAFKBillboard(character)
			else
				-- Was AFK → now NOT AFK → remove billboard
				removeAFKBillboard(character)
			end
		end
	end)

	-- Clean up billboard when character respawns (handle edge case)
	Players.PlayerAdded:Connect(function(plr)
		plr.CharacterAdded:Connect(function(character)
			task.defer(function()
				if plr:GetAttribute("PlayerState") == "AFK" then
					createAFKBillboard(character)
				end
			end)
		end)
	end)

	-- Handle players already in game
	for _, plr in ipairs(Players:GetPlayers()) do
		plr.CharacterAdded:Connect(function(character)
			task.defer(function()
				if plr:GetAttribute("PlayerState") == "AFK" then
					createAFKBillboard(character)
				end
			end)
		end)
		-- If already AFK with existing character
		if plr:GetAttribute("PlayerState") == "AFK" and plr.Character then
			createAFKBillboard(plr.Character)
		end
	end

	print("[CrownPetShopServer] ToggleAFK handler ready")
end)

-- ─── Cleanup: remove any ProximityPrompts from CrownPetShop ───
local function cleanupShop()
	local shop = workspace:FindFirstChild("CrownPetShop", true)
	if not shop then
		warn("[CrownPetShopServer] CrownPetShop model not found in Workspace")
		return
	end

	-- Remove any ProximityPrompts (no longer needed — detection is client-side)
	for _, descendant in ipairs(shop:GetDescendants()) do
		if descendant:IsA("ProximityPrompt") then
			print("[CrownPetShopServer] Removing old ProximityPrompt from", descendant.Parent:GetFullName())
			descendant:Destroy()
		end
	end

	print(string.format("[CrownPetShopServer] CrownPetShop found at: %s — walk-up detection is client-side", shop:GetFullName()))
end

-- Run cleanup after workspace loads
task.defer(cleanupShop)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="57">
        <Properties>
          <string name="Name">DailyQuestService</string>
          <string name="Source"><![CDATA[--[[
	DailyQuestService
	Server-authoritative daily quest tracking and reward granting.

	Quests reset at UTC midnight. The active set is generated once per day from
	DailyQuestConfig.GenerateDailyQuests(day), seeded by the date -- identical
	for all players on the same day, automatically different every day.

	Player progress is stored in PlayerData.DailyQuestData as a JSON string:
	  {
	    day="YYYY_MM_DD",
	    progress={[questId]={progress=N, claimed=bool}},
	    oneTimeClaimed={[questId]=true}
	  }

	API:
	  Init()
	  GetStatus(player)              -- quest list with live progress
	  TryClaim(player, questId)      -- grant reward, return result
	  OnMatchStart(players)          -- resets single-match survival run trackers
	  OnMatchEnd()                   -- clears single-match survival run trackers
	  OnPlayerWon(player)            -- hook from MatchManager
	  OnSwordKill(player)            -- hook from SwordSpawnService
	  OnTTSSurvive(player)           -- hook from TungTungSahurService
	  OnElimination(player)          -- general kill hook
	  OnRoundSurvived(player)        -- hook from RoundManager
	OnBrainrotPetPickup(player, petId, modeName) -- hook from BrainrotModeService
	  DebugForceNewDay()             -- [Studio] reset cached day
	  DebugResetProgress(player)     -- [Studio] wipe today's progress
	  DebugCompleteQuest(p, questId) -- [Studio] max-out a quest
]]

local HttpService         = game:GetService("HttpService")
local ReplicatedStorage   = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")
local RunService          = game:GetService("RunService")
local Players             = game:GetService("Players")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Server = ServerScriptService:WaitForChild("Server")

local DailyQuestConfig = require(Shared:WaitForChild("DailyQuestConfig"))
local ItemCatalog = require(Shared:WaitForChild("ItemCatalog"))

-- Lazy service loaders
local _PDS, _Economy, _Inventory, _Crate, _Spin, _Feedback = nil, nil, nil, nil, nil, nil

local function getPDS()
	if _PDS then return _PDS end
	local ok, m = pcall(require, Server:WaitForChild("PlayerDataService", 5))
	if ok and m then _PDS = m end; return _PDS
end
local function getEconomy()
	if _Economy then return _Economy end
	local ok, m = pcall(require, Server:WaitForChild("EconomyService", 5))
	if ok and m then _Economy = m end; return _Economy
end
local function getInventory()
	if _Inventory then return _Inventory end
	local ok, m = pcall(require, Server:WaitForChild("InventoryService", 5))
	if ok and m then _Inventory = m end; return _Inventory
end
local function getCrate()
	if _Crate then return _Crate end
	local ok, m = pcall(require, Server:WaitForChild("CrateService", 5))
	if ok and m then _Crate = m end; return _Crate
end
local function getSpin()
	if _Spin then return _Spin end
	local ok, m = pcall(require, Server:WaitForChild("SpinWheelService", 5))
	if ok and m then _Spin = m end; return _Spin
end
local function getFeedback()
	if _Feedback ~= nil then return _Feedback end
	local ok, m = pcall(require, Server:FindFirstChild("MatchFeedbackService"))
	if ok and m then _Feedback = m else _Feedback = false end
	return _Feedback
end

local DailyQuestService = {}
local initialized  = false

local updateRemote:    RemoteEvent?    = nil
local getStatusFunc:   RemoteFunction? = nil
local claimFunc:       RemoteFunction? = nil
local debugRemote:     RemoteFunction? = nil

local function log(...) print("[DailyQuestService]", ...) end
local STARTER_QUEST = DailyQuestConfig.StarterQuest
local STARTER_QUEST_ID = tostring(STARTER_QUEST and STARTER_QUEST.id or "starter_survive_1_round")
local STARTER_QUEST_STATE_UNCLASSIFIED = "Unclassified"
local STARTER_QUEST_STATE_ELIGIBLE = "Eligible"
local STARTER_QUEST_STATE_INELIGIBLE = "Ineligible"
local STARTER_QUEST_STATE_COMPLETED = "Completed"
local STARTER_QUEST_REWARD_REASON = "StarterQuest_Survive1Round_700Coins"

local CRATE_ID_ALIASES: { [string]: string } = {
	crate_pet = "crate_pet_common",
}

local function resolveQuestCrateId(rawId: any): string
	local crateId = if type(rawId) == "string" and rawId ~= "" then rawId else "crate_pet_common"
	return CRATE_ID_ALIASES[crateId] or crateId
end

-- Today's quest cache -- regenerated when the UTC day rolls over
local _cachedDay:    string = ""
local _cachedQuests: { { [string]: any } } = {}
local _cachedById:   { [string]: { [string]: any } } = {}
local _sessionJoinTimeByUserId: { [number]: number } = {}
local _studioDayOffsetDays: number = 0
local _singleMatchSurvivalRoundsByUserId: { [number]: number } = {}
local _singleMatchParticipantByUserId: { [number]: boolean } = {}
local _lastSingleMatchSweepRound: number = -1
local _starterQuestAssignedLoggedByUserId: { [number]: boolean } = {}
local _lastQuestPayloadSignatureByUserId: { [number]: string } = {}

local MATCH_SCOPED_SURVIVAL_TYPES: { [string]: boolean } = {
	SurviveRoundsSingleMatch12 = true,
	SurviveRoundsSingleMatch15 = true,
}

local function getCurrentDay(): string
	if RunService:IsStudio() and _studioDayOffsetDays ~= 0 then
		local nowUtc = DateTime.now().UnixTimestamp
		return os.date("!%Y_%m_%d", nowUtc + (_studioDayOffsetDays * 86400))
	end
	return os.date("!%Y_%m_%d")
end

local function getTodayQuests(): { { [string]: any } }
	local today = getCurrentDay()
	if today ~= _cachedDay then
		_cachedDay    = today
		_cachedQuests = DailyQuestConfig.GenerateDailyQuests(today)
		_cachedById   = {}
		for _, q in ipairs(_cachedQuests) do
			_cachedById[q.id] = q
		end
		log(string.format("Generated quests for %s (%d quests)", today, #_cachedQuests))
		for _, q in ipairs(_cachedQuests) do
			log(string.format("  [%s] %s (%s x%d) -> %s",
				q.id, q.label, q.type, q.target,
				DailyQuestConfig.GetRewardLabel(q.reward)))
		end
	end
	return _cachedQuests
end

local function getTodayQuestById(id: string): { [string]: any }?
	getTodayQuests()
	return _cachedById[id]
end

local function getSessionPlayedSeconds(player: Player): number
	local joinTime = _sessionJoinTimeByUserId[player.UserId]
	if not joinTime then
		joinTime = os.time()
		_sessionJoinTimeByUserId[player.UserId] = joinTime
	end
	return math.max(0, os.time() - joinTime)
end

local function isMatchScopedSurvivalQuestType(questType: string): boolean
	return MATCH_SCOPED_SURVIVAL_TYPES[questType] == true
end

local function isPlayerInActiveSingleMatchRun(player: Player): boolean
	if _singleMatchParticipantByUserId[player.UserId] ~= true then
		return false
	end
	return player:GetAttribute("PlayerState") == "InMatch"
end

local function getSingleMatchSurvivalRounds(player: Player): number
	if not isPlayerInActiveSingleMatchRun(player) then
		return 0
	end
	return _singleMatchSurvivalRoundsByUserId[player.UserId] or 0
end

local function isOneTimeQuestRewardOwned(player: Player, questDef: { [string]: any }): boolean
	if type(questDef) ~= "table" or questDef.oneTime ~= true then
		return false
	end
	local reward = questDef.reward
	if type(reward) ~= "table" then
		return false
	end
	local inv = getInventory()
	if not inv or type(inv.OwnsItem) ~= "function" then
		return false
	end
	if reward.type == "Crown" and type(reward.itemId) == "string" and reward.itemId ~= "" then
		return inv.OwnsItem(player, "Crowns", reward.itemId) == true
	end
	if reward.type == "Pet" and type(reward.itemId) == "string" and reward.itemId ~= "" then
		return inv.OwnsItem(player, "Pets", reward.itemId) == true
	end
	if reward.type == "IconImage" and type(reward.itemId) == "string" and reward.itemId ~= "" then
		return inv.OwnsItem(player, "IconImages", reward.itemId) == true
	end
	return false
end

local function countListEntries(value: any): number
	if type(value) ~= "table" then
		return 0
	end
	return #value
end

local function getStarterQuestState(player: Player): string
	local PDS = getPDS()
	local rawState = PDS and PDS.GetField(player, "StarterQuestState") or STARTER_QUEST_STATE_UNCLASSIFIED
	local starterQuestState = tostring(rawState or STARTER_QUEST_STATE_UNCLASSIFIED)
	if starterQuestState ~= STARTER_QUEST_STATE_UNCLASSIFIED
		and starterQuestState ~= STARTER_QUEST_STATE_ELIGIBLE
		and starterQuestState ~= STARTER_QUEST_STATE_INELIGIBLE
		and starterQuestState ~= STARTER_QUEST_STATE_COMPLETED
	then
		starterQuestState = STARTER_QUEST_STATE_UNCLASSIFIED
	end
	return starterQuestState
end

local function setStarterQuestState(player: Player, starterQuestState: string): boolean
	local PDS = getPDS()
	if not PDS then
		return false
	end
	return PDS.SetField(player, "StarterQuestState", starterQuestState) == true
end

local function getStarterQuestEligibilitySnapshot(data: { [string]: any }): (boolean, number, number, number, boolean)
	local lifetimeMatches = tonumber(data.LifetimeMatchesCompleted) or 0
	local lifetimeWins = tonumber(data.LifetimeWins) or 0
	local timePlayedSeconds = tonumber(data.TimePlayedSeconds) or 0
	local tutorialCompleted = data.TutorialCompleted == true
	local eligible = lifetimeMatches == 0 and lifetimeWins == 0
	return eligible, lifetimeMatches, lifetimeWins, timePlayedSeconds, tutorialCompleted
end

local function resolveStarterQuestState(player: Player): string
	local PDS = getPDS()
	if not PDS or not PDS.IsLoaded(player) then
		return STARTER_QUEST_STATE_UNCLASSIFIED
	end

	local currentState = getStarterQuestState(player)
	if currentState == STARTER_QUEST_STATE_COMPLETED or currentState == STARTER_QUEST_STATE_ELIGIBLE then
		return currentState
	end

	local data = PDS.GetData(player) or {}
	local eligible, lifetimeMatches, lifetimeWins, timePlayedSeconds, tutorialCompleted = getStarterQuestEligibilitySnapshot(data)

	if currentState == STARTER_QUEST_STATE_INELIGIBLE then
		if eligible and setStarterQuestState(player, STARTER_QUEST_STATE_ELIGIBLE) then
			log(string.format(
				"[StarterQuest] player=%s reclassified=true oldState=%s newState=%s lifetimeMatches=%d lifetimeWins=%d timePlayed=%d tutorialCompleted=%s",
				player.Name,
				STARTER_QUEST_STATE_INELIGIBLE,
				STARTER_QUEST_STATE_ELIGIBLE,
				lifetimeMatches,
				lifetimeWins,
				timePlayedSeconds,
				tostring(tutorialCompleted)
			))
			return STARTER_QUEST_STATE_ELIGIBLE
		end
		return STARTER_QUEST_STATE_INELIGIBLE
	end

	local nextState = if eligible then STARTER_QUEST_STATE_ELIGIBLE else STARTER_QUEST_STATE_INELIGIBLE
	setStarterQuestState(player, nextState)

	log(string.format(
		"[StarterQuest] player=%s eligible=%s assignedState=%s lifetimeMatches=%d lifetimeWins=%d timePlayed=%d tutorialCompleted=%s",
		player.Name,
		tostring(eligible),
		nextState,
		lifetimeMatches,
		lifetimeWins,
		timePlayedSeconds,
		tostring(tutorialCompleted)
	))

	return nextState
end

local function syncStarterQuestProgressEntry(data: { [string]: any }, starterQuestState: string): boolean
	if not STARTER_QUEST then
		return false
	end
	if type(data.progress) ~= "table" then
		data.progress = {}
	end
	if type(data.oneTimeClaimed) ~= "table" then
		data.oneTimeClaimed = {}
	end

	local progressState = data.progress[STARTER_QUEST_ID]
	local mutated = false
	if type(progressState) ~= "table" then
		progressState = { progress = 0, claimed = false }
		data.progress[STARTER_QUEST_ID] = progressState
		mutated = true
	end

	if data.oneTimeClaimed[STARTER_QUEST_ID] == true or starterQuestState == STARTER_QUEST_STATE_COMPLETED then
		if (tonumber(progressState.progress) or 0) < STARTER_QUEST.target then
			progressState.progress = STARTER_QUEST.target
			mutated = true
		end
		if progressState.claimed ~= true then
			progressState.claimed = true
			mutated = true
		end
		if data.oneTimeClaimed[STARTER_QUEST_ID] ~= true then
			data.oneTimeClaimed[STARTER_QUEST_ID] = true
			mutated = true
		end
	end

	return mutated
end

local function shouldIncludeStarterQuestInStatus(data: { [string]: any }, starterQuestState: string): boolean
	if not STARTER_QUEST or type(data.progress) ~= "table" then
		return false
	end
	if starterQuestState == STARTER_QUEST_STATE_ELIGIBLE then
		return true
	end
	local progressState = data.progress[STARTER_QUEST_ID]
	return type(progressState) == "table"
		and progressState.claimed ~= true
		and (tonumber(progressState.progress) or 0) > 0
end

local function buildStarterQuestStatus(progressState: { [string]: any }): { [string]: any }
	local progress = math.max(0, math.floor(tonumber(progressState and progressState.progress) or 0))
	local claimed = progressState and progressState.claimed == true or false
	return {
		id = STARTER_QUEST.id,
		label = STARTER_QUEST.label,
		description = STARTER_QUEST.description,
		type = STARTER_QUEST.type,
		progress = progress,
		target = STARTER_QUEST.target,
		claimed = claimed,
		completed = progress >= STARTER_QUEST.target,
		reward = STARTER_QUEST.reward,
		icon = STARTER_QUEST.icon,
		iconColor = STARTER_QUEST.iconColor,
		order = STARTER_QUEST.order,
	}
end

-- Player data helpers

local function getQuestData(player: Player): { [string]: any }
	local PDS = getPDS()
	local raw = PDS and PDS.GetField(player, "DailyQuestData") or ""
	if raw and raw ~= "" then
		local ok, decoded = pcall(function() return HttpService:JSONDecode(raw) end)
		if ok and type(decoded) == "table" then return decoded end
	end
	return { day = "", progress = {}, oneTimeClaimed = {} }
end

local function saveQuestData(player: Player, data: { [string]: any })
	local PDS = getPDS()
	if not PDS then return end
	local ok, encoded = pcall(function() return HttpService:JSONEncode(data) end)
	if ok then PDS.SetField(player, "DailyQuestData", encoded) end
end

-- Returns the player's quest data, resetting if the UTC day has changed.
local function ensureQuestData(player: Player, starterQuestStateOverride: string?): { [string]: any }
	local data   = getQuestData(player)
	local today  = getCurrentDay()
	local quests = getTodayQuests()
	local starterQuestState = if type(starterQuestStateOverride) == "string" and starterQuestStateOverride ~= ""
		then starterQuestStateOverride
		else getStarterQuestState(player)
	local mutated = false
	if type(data.oneTimeClaimed) ~= "table" then
		data.oneTimeClaimed = {}
		mutated = true
	end

	if data.day ~= today then
		data.day      = today
		data.progress = {}
		for _, q in ipairs(quests) do
			data.progress[q.id] = { progress = 0, claimed = false }
		end
		mutated = true
	end

	if type(data.progress) ~= "table" then
		data.progress = {}
		mutated = true
	end
	for _, q in ipairs(quests) do
		if not data.progress[q.id] then
			data.progress[q.id] = { progress = 0, claimed = false }
			mutated = true
		end
		if q.oneTime == true and data.oneTimeClaimed[q.id] == true then
			local p = data.progress[q.id]
			p.progress = math.max(tonumber(p.progress) or 0, q.target)
			p.claimed = true
		end
		if isMatchScopedSurvivalQuestType(q.type) then
			local p = data.progress[q.id]
			if p and not p.claimed and (tonumber(p.progress) or 0) ~= 0 then
				p.progress = 0
			end
		end
	end
	if syncStarterQuestProgressEntry(data, starterQuestState) then
		mutated = true
	end
	if mutated then
		saveQuestData(player, data)
	end
	return data
end

local function resolveQuestProgress(player: Player, questDef: { [string]: any }, progressState: { [string]: any }): number
	-- Claimed quests are inactive immediately and must never continue progressing.
	if progressState.claimed then
		return questDef.target
	end
	if questDef.type == "TimePlayed" then
		return math.min(getSessionPlayedSeconds(player), questDef.target)
	end
	if isMatchScopedSurvivalQuestType(questDef.type) then
		local persisted = tonumber(progressState.progress) or 0
		if persisted >= questDef.target then
			return questDef.target
		end
		return math.min(getSingleMatchSurvivalRounds(player), questDef.target)
	end
	return progressState.progress or 0
end

local function buildQuestPayloadSummary(questList: { { [string]: any } }): (string, boolean, string)
	local entries = table.create(#questList)
	local starterPresent = false
	for _, quest in ipairs(questList) do
		local questId = tostring(quest.id or "")
		local questLabel = tostring(quest.label or questId)
		if questId == STARTER_QUEST_ID then
			starterPresent = true
		end
		table.insert(entries, questId .. ":" .. questLabel)
	end
	local payloadSummary = table.concat(entries, " | ")
	local payloadSignature = tostring(#questList) .. "::" .. payloadSummary
	return payloadSignature, starterPresent, payloadSummary
end

-- Status builder

function DailyQuestService.GetStatus(player: Player)
	local PDS = getPDS()
	if not PDS or not PDS.IsLoaded(player) then
		return { dataLoaded = false, quests = {} }
	end

	local starterQuestState = resolveStarterQuestState(player)
	local data       = ensureQuestData(player, starterQuestState)
	local quests     = getTodayQuests()
	local mutated    = false

	local questList = {}
	if shouldIncludeStarterQuestInStatus(data, starterQuestState) and STARTER_QUEST then
		local starterProgressState = data.progress[STARTER_QUEST_ID] or { progress = 0, claimed = false }
		if _starterQuestAssignedLoggedByUserId[player.UserId] ~= true then
			_starterQuestAssignedLoggedByUserId[player.UserId] = true
			log(string.format("[StarterQuest] player=%s assigned=true insertedIntoActiveList=true quest=%s", player.Name, STARTER_QUEST_ID))
		end
		table.insert(questList, buildStarterQuestStatus(starterProgressState))
	end

	for _, questDef in ipairs(quests) do
		local p = data.progress[questDef.id] or { progress = 0, claimed = false }
		local oneTimeClaimed = (questDef.oneTime == true) and (data.oneTimeClaimed[questDef.id] == true)
		local rewardOwned = isOneTimeQuestRewardOwned(player, questDef)

		-- One-time quest migration safety:
		-- If reward is already owned or this quest was previously completed,
		-- mark this daily entry as claimed so it never appears again.
		if questDef.oneTime == true and (oneTimeClaimed or rewardOwned) and not p.claimed then
			p.progress = questDef.target
			p.claimed = true
			data.oneTimeClaimed[questDef.id] = true
			mutated = true
			log(string.format(
				"[DailyQuestOneTime] autoMarkClaimed player=%s quest=%s rewardOwned=%s priorOneTimeClaimed=%s",
				player.Name,
				questDef.id,
				tostring(rewardOwned),
				tostring(oneTimeClaimed)
			))
		end
		if isMatchScopedSurvivalQuestType(questDef.type) and not p.claimed and (tonumber(p.progress) or 0) ~= 0 then
			p.progress = 0
			mutated = true
			log(string.format(
				"[SingleMatchQuest] resetStoredPartial player=%s quest=%s",
				player.Name,
				questDef.id
			))
		end

		local progress = resolveQuestProgress(player, questDef, p)
		-- Claimed quests are hidden from the active quest feed.
		if p.claimed then
			continue
		end

		table.insert(questList, {
			id          = questDef.id,
			label       = questDef.label,
			description = questDef.description,
			type        = questDef.type,
			progress    = progress,
			target      = questDef.target,
			claimed     = p.claimed,
			completed   = progress >= questDef.target,
			reward      = questDef.reward,
			icon        = questDef.icon,
			iconColor   = questDef.iconColor,
			order       = questDef.order,
		})
	end

	table.sort(questList, function(a, b) return (a.order or 99) < (b.order or 99) end)
	if mutated then
		saveQuestData(player, data)
	end

	local payloadSignature, starterPresent, payloadSummary = buildQuestPayloadSummary(questList)
	if _lastQuestPayloadSignatureByUserId[player.UserId] ~= payloadSignature then
		_lastQuestPayloadSignatureByUserId[player.UserId] = payloadSignature
		log(string.format(
			"[QuestPayload] player=%s source=GetStatus starterState=%s starterPresent=%s activeQuestCount=%d quests=%s",
			player.Name,
			starterQuestState,
			tostring(starterPresent),
			#questList,
			payloadSummary
		))
	end

	return {
		dataLoaded = true,
		day        = data.day,
		quests     = questList,
	}
end

-- Progress incrementor

local function incrementProgress(player: Player, questType: string, amount: number?)
	local PDS = getPDS()
	if not PDS or not PDS.IsLoaded(player) then return end

	local starterQuestState = resolveStarterQuestState(player)
	local data    = ensureQuestData(player, starterQuestState)
	local quests  = getTodayQuests()
	local changed = false
	local incrementAmount = amount or 1

	if STARTER_QUEST
		and STARTER_QUEST.type == questType
		and starterQuestState == STARTER_QUEST_STATE_ELIGIBLE
	then
		local starterProgress = data.progress[STARTER_QUEST_ID]
		if starterProgress and starterProgress.claimed ~= true and (tonumber(starterProgress.progress) or 0) < STARTER_QUEST.target then
			local previousProgress = tonumber(starterProgress.progress) or 0
			starterProgress.progress = math.min(previousProgress + incrementAmount, STARTER_QUEST.target)
			log(string.format("Progress: %s %s %d/%d",
				player.Name, STARTER_QUEST_ID, starterProgress.progress, STARTER_QUEST.target))
			if previousProgress < STARTER_QUEST.target and starterProgress.progress >= STARTER_QUEST.target then
				log(string.format("[StarterQuest] player=%s completed=true quest=%s", player.Name, STARTER_QUEST_ID))
				local feedback = getFeedback()
				if feedback and feedback.OnQuestCompleted then
					pcall(feedback.OnQuestCompleted, player, STARTER_QUEST)
				end
			end
			changed = true
		end
	end

	for _, questDef in ipairs(quests) do
		if questDef.type == questType then
			if isMatchScopedSurvivalQuestType(questDef.type) then
				continue
			end
			local p = data.progress[questDef.id]
			if p and questDef.oneTime == true and (data.oneTimeClaimed[questDef.id] == true or isOneTimeQuestRewardOwned(player, questDef)) then
				if not p.claimed then
					p.progress = questDef.target
					p.claimed = true
					data.oneTimeClaimed[questDef.id] = true
					changed = true
				end
				continue
			end
			if p and not p.claimed and p.progress < questDef.target then
				local prevProgress = p.progress
				p.progress = math.min(prevProgress + incrementAmount, questDef.target)
				log(string.format("Progress: %s %s %d/%d",
					player.Name, questDef.id, p.progress, questDef.target))
				if prevProgress < questDef.target and p.progress >= questDef.target then
					log(string.format("Quest completed: %s %s", player.Name, questDef.id))
					local feedback = getFeedback()
					if feedback and feedback.OnQuestCompleted then
						pcall(feedback.OnQuestCompleted, player, questDef)
					end
				end
				changed = true
			end
		end
	end

	if changed then
		saveQuestData(player, data)
		if updateRemote then
			updateRemote:FireClient(player, DailyQuestService.GetStatus(player))
		end
	end
end

-- Public event hooks (called by other services)

local function applySingleMatchSurvivalProgress(player: Player, roundsSurvived: number)
	local PDS = getPDS()
	if not PDS or not PDS.IsLoaded(player) then
		return
	end
	local data = ensureQuestData(player)
	local quests = getTodayQuests()
	local changed = false

	for _, questDef in ipairs(quests) do
		if isMatchScopedSurvivalQuestType(questDef.type) then
			local p = data.progress[questDef.id]
			if p and not p.claimed and roundsSurvived >= (questDef.target or 0) then
				p.progress = questDef.target
				changed = true
				log(string.format(
					"[SingleMatchQuest] player=%s quest=%s completed=true roundsSurvived=%d target=%d",
					player.Name,
					questDef.id,
					roundsSurvived,
					questDef.target or 0
				))
				local feedback = getFeedback()
				if feedback and feedback.OnQuestCompleted then
					pcall(feedback.OnQuestCompleted, player, questDef)
				end
			end
		end
	end

	if changed then
		saveQuestData(player, data)
		if updateRemote then
			updateRemote:FireClient(player, DailyQuestService.GetStatus(player))
		end
	end
end

local function sweepSingleMatchRunFailures(roundNumber: number?)
	local sweepRound = tonumber(roundNumber) or -1
	if sweepRound >= 0 and _lastSingleMatchSweepRound == sweepRound then
		return
	end
	_lastSingleMatchSweepRound = sweepRound
	for userId, active in pairs(_singleMatchParticipantByUserId) do
		if active then
			local trackedPlayer = Players:GetPlayerByUserId(userId)
			local stillInMatch = trackedPlayer and trackedPlayer:GetAttribute("PlayerState") == "InMatch"
			if not stillInMatch then
				_singleMatchParticipantByUserId[userId] = nil
				_singleMatchSurvivalRoundsByUserId[userId] = nil
				if trackedPlayer then
					log(string.format(
						"[SingleMatchQuest] player=%s runReset=true reason=left_inmatch_state round=%s",
						trackedPlayer.Name,
						tostring(roundNumber or "?")
					))
				end
			end
		end
	end
end

function DailyQuestService.OnMatchStart(players: { Player }?)
	_singleMatchSurvivalRoundsByUserId = {}
	_singleMatchParticipantByUserId = {}
	_lastSingleMatchSweepRound = -1
	if type(players) == "table" then
		for _, player in ipairs(players) do
			if player and player.Parent then
				_singleMatchParticipantByUserId[player.UserId] = true
				_singleMatchSurvivalRoundsByUserId[player.UserId] = 0
				log(string.format("[SingleMatchQuest] player=%s matchStart=true roundsSurvived=0", player.Name))
			end
		end
	end
end

function DailyQuestService.OnMatchEnd()
	if next(_singleMatchParticipantByUserId) ~= nil then
		for _, player in ipairs(Players:GetPlayers()) do
			if _singleMatchParticipantByUserId[player.UserId] == true then
				log(string.format(
					"[SingleMatchQuest] player=%s matchEnd=true roundsSurvived=%d",
					player.Name,
					_singleMatchSurvivalRoundsByUserId[player.UserId] or 0
				))
			end
		end
	end
	_singleMatchParticipantByUserId = {}
	_singleMatchSurvivalRoundsByUserId = {}
	_lastSingleMatchSweepRound = -1
end

function DailyQuestService.OnPlayerWon(player: Player)
	incrementProgress(player, "WinsToday")
end

function DailyQuestService.OnSwordKill(player: Player)
	incrementProgress(player, "SwordKillsToday")
	incrementProgress(player, "EliminationsToday")
end

function DailyQuestService.OnTTSSurvive(player: Player)
	incrementProgress(player, "TTSSurvivalsToday")
end

function DailyQuestService.OnElimination(player: Player)
	incrementProgress(player, "EliminationsToday")
end

function DailyQuestService.OnRoundSurvived(player: Player, roundNumber: number?)
	incrementProgress(player, "SurviveRoundsToday")
	incrementProgress(player, "StarterSurviveRound")
	sweepSingleMatchRunFailures(roundNumber)
	if not isPlayerInActiveSingleMatchRun(player) then
		return
	end
	local roundsSurvived = (_singleMatchSurvivalRoundsByUserId[player.UserId] or 0) + 1
	_singleMatchSurvivalRoundsByUserId[player.UserId] = roundsSurvived
	log(string.format(
		"[SingleMatchQuest] player=%s roundSurvived=true roundsSurvived=%d",
		player.Name,
		roundsSurvived
	))
	applySingleMatchSurvivalProgress(player, roundsSurvived)
end

function DailyQuestService.OnBrainrotPetPickup(player: Player, petId: string, modeName: string?)
	if type(petId) ~= "string" then return end
	if modeName and modeName ~= "Brainrot" then
		return
	end
	if petId ~= "pet_brainrot_ishowspeed" then
		return
	end
	log(string.format("[QuestHook] Brainrot pickup accepted player=%s petId=%s mode=%s",
		player.Name,
		petId,
		tostring(modeName or "Brainrot")))
	incrementProgress(player, "BrainrotIShowSpeedPickupsToday", 1)
end

-- Claim

function DailyQuestService.TryClaim(player: Player, questId: string)
	local PDS = getPDS()
	if not PDS or not PDS.IsLoaded(player) then
		return { success = false, reason = "Data not loaded" }
	end

	if type(questId) ~= "string" then
		return { success = false, reason = "Invalid questId" }
	end

	local starterQuestState = resolveStarterQuestState(player)
	local data = ensureQuestData(player, starterQuestState)
	local questDef = nil
	if questId == STARTER_QUEST_ID and STARTER_QUEST and shouldIncludeStarterQuestInStatus(data, starterQuestState) then
		questDef = STARTER_QUEST
	else
		questDef = getTodayQuestById(questId)
	end
	if not questDef then
		return { success = false, reason = "Unknown quest: " .. questId }
	end

	local p    = data.progress[questId]
	if not p then return { success = false, reason = "Quest state missing" } end

	if p.claimed then
		return { success = false, reason = "Already claimed" }
	end

	local progress = p.progress
	progress = resolveQuestProgress(player, questDef, p)

	if progress < questDef.target then
		return { success = false, reason = "Quest not completed yet" }
	end

	-- Grant reward
	local reward  = questDef.reward
	local granted = false
	local extra   = {}
	local failReason = "Reward grant failed"
	local rewardType = tostring(reward and reward.type or "")
	local rewardId = ""
	local rewardAmount = 1
	if rewardType == "Coins" then
		rewardAmount = tonumber(reward.amount) or 0
		rewardId = "fate_coins"
	elseif rewardType == "Spin" then
		rewardAmount = tonumber(reward.count) or 0
		rewardId = "spin_purchased"
	elseif rewardType == "Crate" then
		rewardAmount = tonumber(reward.count) or 1
		rewardId = tostring(reward.crateId or reward.itemId or "")
	else
		rewardAmount = 1
		rewardId = tostring(reward and reward.itemId or "")
	end
	log(string.format("[DailyQuestGrant] quest=%s rewardType=%s rewardId=%s amount=%s",
		tostring(questId), rewardType, rewardId, tostring(rewardAmount)))

	if reward.type == "Coins" then
		local eco = getEconomy()
		if eco then
			local source = "DailyQuest_" .. questId
			local baseAmount = tonumber(reward.amount) or 0
			local useExactPolicy = reward.exact == true
			local ok, actualAmount
			if useExactPolicy then
				ok, actualAmount = eco.AwardCoins(player, baseAmount, source, true)
			else
				ok, actualAmount = eco.AwardVipOnlyCoins(player, baseAmount, source)
			end
			granted = ok == true
			if granted then
				extra.actualAmount = actualAmount or baseAmount
				log(string.format(
					"[DailyQuestGrantAudit] player=%s quest=%s base=%d policy=%s final=%d source=%s",
					player.Name,
					questId,
					baseAmount,
					if useExactPolicy then "exact" else "vip_only",
					tonumber(extra.actualAmount) or 0,
					source
				))
			end
			if not granted then
				failReason = "COIN_GRANT_FAILED"
			end
		else
			failReason = "ECONOMY_UNAVAILABLE"
		end

	elseif reward.type == "Pet" then
		local inv = getInventory()
		if inv then
			granted = inv.GrantItem(player, "Pets", reward.itemId) == true
			if not granted then
				failReason = "PET_GRANT_FAILED"
			end
		else
			failReason = "INVENTORY_UNAVAILABLE"
		end

	elseif reward.type == "IconImage" then
		local inv = getInventory()
		if inv then
			granted = inv.GrantItem(player, "IconImages", reward.itemId) == true
			if granted then
				local iconDef = ItemCatalog.IconImages and ItemCatalog.IconImages[reward.itemId]
				log(string.format("[DailyQuestGrant] iconImageUnlocked player=%s itemId=%s image=%s",
					player.Name,
					tostring(reward.itemId),
					tostring(iconDef and iconDef.image or "")))
			else
				failReason = "ICONIMAGE_GRANT_FAILED"
			end
		else
			failReason = "INVENTORY_UNAVAILABLE"
		end

	elseif reward.type == "Crown" then
		local inv = getInventory()
		if inv then
			granted = inv.GrantItem(player, "Crowns", reward.itemId) == true
			if not granted then
				failReason = "CROWN_GRANT_FAILED"
			end
		else
			failReason = "INVENTORY_UNAVAILABLE"
		end

	elseif reward.type == "Crate" then
		local crate = getCrate()
		if crate then
			local crateId = resolveQuestCrateId(reward.crateId or reward.itemId)
			local qty     = reward.count or 1
			local crateDefFound = ItemCatalog.Crates and ItemCatalog.Crates[crateId] ~= nil
			local result  = crate.RollCrateFree(player, crateId, qty)
			local outcomes = if result and type(result.results) == "table" then result.results else {}
			local chosenOutcome = outcomes[1]
			if chosenOutcome then
				for _, r in ipairs(outcomes) do
					if r and r.grantSuccess == true then
						chosenOutcome = r
						break
					end
				end
			end

			if result and result.success and chosenOutcome and type(chosenOutcome.itemId) == "string" and chosenOutcome.itemId ~= "" then
				local grantSuccess = chosenOutcome.grantSuccess == true
				local isDuplicate = chosenOutcome.isDuplicate == true
				-- Existing crate duplicate behavior is preserved: duplicate is a valid resolved outcome.
				granted = grantSuccess or isDuplicate
				extra.crateGrant = {
					itemId      = chosenOutcome.itemId,
					displayName = chosenOutcome.displayName,
					rarity      = chosenOutcome.rarity,
					category    = chosenOutcome.category,
					isDuplicate = isDuplicate,
					grantSuccess = grantSuccess,
				}
				extra.crateResults = outcomes
				extra.crateResolved = {
					crateId = crateId,
					crateDefinitionFound = crateDefFound,
					quantity = qty,
					rollSuccess = result.success == true,
				}
			end
			if not granted then
				failReason = tostring(result and result.error or "CRATE_GRANT_FAILED")
			end

			log(string.format(
				"[QuestCrate] quest=%s rewardType=Crate rewardId=%s resolvedCrateId=%s crateDefFound=%s granted=%s outcome=%s duplicate=%s",
				tostring(questId),
				tostring(reward.crateId or reward.itemId or "nil"),
				tostring(crateId),
				tostring(crateDefFound),
				tostring(granted),
				tostring(extra.crateGrant and extra.crateGrant.itemId or "nil"),
				tostring(extra.crateGrant and extra.crateGrant.isDuplicate or false)
			))
		else
			failReason = "CRATE_SERVICE_UNAVAILABLE"
		end

	elseif reward.type == "Spin" then
		local sws = getSpin()
		if sws then
			if type(sws.GetPlayerData) == "function" then
				pcall(function()
					sws.GetPlayerData(player)
				end)
			end
			granted = sws.GrantRobuxSpins(player, reward.count or 1) == true
			if not granted then
				failReason = "SPIN_GRANT_FAILED"
			end
		else
			failReason = "SPIN_SERVICE_UNAVAILABLE"
		end
	else
		failReason = "UNSUPPORTED_REWARD_TYPE"
	end

	if not granted then
		log(string.format("[DailyQuestGrant] player=%s result=FAIL reason=%s",
			player.Name, tostring(failReason)))
		return { success = false, reason = tostring(failReason) }
	end

	-- Deactivate immediately at lifecycle level.
	p.progress = questDef.target
	p.claimed = true
	if questDef.oneTime == true then
		if type(data.oneTimeClaimed) ~= "table" then
			data.oneTimeClaimed = {}
		end
		data.oneTimeClaimed[questId] = true
		if questId == STARTER_QUEST_ID then
			setStarterQuestState(player, STARTER_QUEST_STATE_COMPLETED)
		end
	end
	saveQuestData(player, data)
	log(string.format("[DailyQuest] quest=%s claimed=true deactivated=true", tostring(questId)))
	log(string.format("[DailyQuest] quest=%s trackerStopped=true", tostring(questId)))
	if questId == STARTER_QUEST_ID then
		log(string.format(
			"[StarterQuest] player=%s rewardGranted=%d reason=%s",
			player.Name,
			tonumber(extra.actualAmount) or (tonumber(reward.amount) or 0),
			STARTER_QUEST_REWARD_REASON
		))
	end

	if updateRemote then
		updateRemote:FireClient(player, DailyQuestService.GetStatus(player))
	end

	log(string.format("%s claimed %s (reward: %s)",
		player.Name, questId, DailyQuestConfig.GetRewardLabel(reward)))
	log(string.format("[DailyQuestGrant] player=%s result=SUCCESS", player.Name))

	if reward.type == "Coins" and type(extra.actualAmount) == "number" then
		local rewardPayload = table.clone(reward)
		rewardPayload.amount = extra.actualAmount
		reward = rewardPayload
	end

	return { success = true, reward = reward, extra = extra }
end

-- Debug commands (Studio-only)

function DailyQuestService.DebugForceNewDay()
	_cachedDay    = ""
	_cachedQuests = {}
	_cachedById   = {}
	log(string.format("[DEBUG] Forced new-day cache clear (offset=%d)", _studioDayOffsetDays))
	for _, player in ipairs(Players:GetPlayers()) do
		local PDS = getPDS()
		if PDS and PDS.IsLoaded(player) then
			PDS.SetField(player, "DailyQuestData", "")
		end
	end
end

function DailyQuestService.DebugForceNextDay()
	if not RunService:IsStudio() then return end
	_studioDayOffsetDays += 1
	DailyQuestService.DebugForceNewDay()
	log(string.format("[DEBUG] Forced next day (offset now %d)", _studioDayOffsetDays))
end

function DailyQuestService.DebugForceRandomQuests()
	if not RunService:IsStudio() then return end
	local rng = Random.new()
	_studioDayOffsetDays = rng:NextInteger(1, 3650)
	DailyQuestService.DebugForceNewDay()
	log(string.format("[DEBUG] Forced random quest day (offset now %d)", _studioDayOffsetDays))
end

function DailyQuestService.DebugResetProgress(player: Player)
	local PDS = getPDS()
	if PDS then
		PDS.SetField(player, "DailyQuestData", "")
		PDS.SetField(player, "StarterQuestState", STARTER_QUEST_STATE_UNCLASSIFIED)
		_starterQuestAssignedLoggedByUserId[player.UserId] = nil
		_lastQuestPayloadSignatureByUserId[player.UserId] = nil
		log("[DEBUG] Reset quest progress for " .. player.Name)
		if updateRemote then
			updateRemote:FireClient(player, DailyQuestService.GetStatus(player))
		end
	end
end

function DailyQuestService.DebugCompleteQuest(player: Player, questId: string)
	local PDS = getPDS()
	if not PDS or not PDS.IsLoaded(player) then return end
	local starterQuestState = resolveStarterQuestState(player)
	local data = ensureQuestData(player, starterQuestState)
	local qdef = if questId == STARTER_QUEST_ID and STARTER_QUEST then STARTER_QUEST else getTodayQuestById(questId)
	if not qdef then
		log("[DEBUG] Unknown questId: " .. tostring(questId))
		return
	end
	local p = data.progress[questId]
	if p then
		p.progress = qdef.target
		saveQuestData(player, data)
		log("[DEBUG] Completed quest " .. questId .. " for " .. player.Name)
		if updateRemote then
			updateRemote:FireClient(player, DailyQuestService.GetStatus(player))
		end
	end
end

-- Init

function DailyQuestService.Init()
	if initialized then return end
	initialized = true

	getTodayQuests()

	local remotes = ReplicatedStorage:WaitForChild("Remotes", 10)
	if not remotes then
		warn("[DailyQuestService] Remotes folder not found")
		return
	end

	if not remotes:FindFirstChild("DailyQuest_Update") then
		updateRemote = Instance.new("RemoteEvent")
		updateRemote.Name   = "DailyQuest_Update"
		updateRemote.Parent = remotes
	else
		updateRemote = remotes:FindFirstChild("DailyQuest_Update")
	end

	if not remotes:FindFirstChild("DailyQuest_GetStatus") then
		getStatusFunc = Instance.new("RemoteFunction")
		getStatusFunc.Name   = "DailyQuest_GetStatus"
		getStatusFunc.Parent = remotes
	else
		getStatusFunc = remotes:FindFirstChild("DailyQuest_GetStatus")
	end
	getStatusFunc.OnServerInvoke = function(player)
		return DailyQuestService.GetStatus(player)
	end

	if not remotes:FindFirstChild("DailyQuest_Claim") then
		claimFunc = Instance.new("RemoteFunction")
		claimFunc.Name   = "DailyQuest_Claim"
		claimFunc.Parent = remotes
	else
		claimFunc = remotes:FindFirstChild("DailyQuest_Claim")
	end
	claimFunc.OnServerInvoke = function(player, questId)
		if type(questId) ~= "string" then
			return { success = false, reason = "Invalid questId" }
		end
		return DailyQuestService.TryClaim(player, questId)
	end

	if RunService:IsStudio() then
		if not remotes:FindFirstChild("DailyQuest_Debug") then
			debugRemote = Instance.new("RemoteFunction")
			debugRemote.Name   = "DailyQuest_Debug"
			debugRemote.Parent = remotes
		else
			debugRemote = remotes:FindFirstChild("DailyQuest_Debug")
		end
		debugRemote.OnServerInvoke = function(player, cmd, arg)
			if cmd == "ForceNewDay" then
				DailyQuestService.DebugForceNewDay()
				return { ok = true, msg = "New day forced" }
			elseif cmd == "ForceNextDay" then
				DailyQuestService.DebugForceNextDay()
				return { ok = true, msg = "Next day forced (new quest set)" }
			elseif cmd == "ForceRandomQuests" then
				DailyQuestService.DebugForceRandomQuests()
				return { ok = true, msg = "Random quest day forced (new quest set)" }
			elseif cmd == "ResetProgress" then
				DailyQuestService.DebugResetProgress(player)
				return { ok = true, msg = "Progress reset" }
			elseif cmd == "CompleteQuest" then
				if type(arg) == "string" then
					DailyQuestService.DebugCompleteQuest(player, arg)
					return { ok = true, msg = "Quest completed: " .. arg }
				end
			end
			return { ok = false, msg = "Unknown command" }
		end
	end

	Players.PlayerAdded:Connect(function(player)
		_sessionJoinTimeByUserId[player.UserId] = os.time()
		_starterQuestAssignedLoggedByUserId[player.UserId] = nil
		_lastQuestPayloadSignatureByUserId[player.UserId] = nil
		task.spawn(function()
			while player.Parent do
				local PDS = getPDS()
				if PDS and PDS.IsLoaded(player) then
					task.wait(1)
					if player.Parent and updateRemote then
						updateRemote:FireClient(player, DailyQuestService.GetStatus(player))
					end
					return
				end
				task.wait(0.5)
			end
		end)
	end)

	Players.PlayerRemoving:Connect(function(player)
		_singleMatchParticipantByUserId[player.UserId] = nil
		_singleMatchSurvivalRoundsByUserId[player.UserId] = nil
		_lastQuestPayloadSignatureByUserId[player.UserId] = nil
		local PDS = getPDS()
		if PDS and PDS.IsLoaded(player) then
			local data = ensureQuestData(player)
			local quests = getTodayQuests()
			local sessionPlayed = getSessionPlayedSeconds(player)
			local changed = false

			for _, questDef in ipairs(quests) do
				if questDef.type == "TimePlayed" then
					local p = data.progress[questDef.id]
					if p and not p.claimed and sessionPlayed < questDef.target and p.progress ~= 0 then
						p.progress = 0
						changed = true
					end
				end
			end

			if changed then
				saveQuestData(player, data)
			end
		end
		_sessionJoinTimeByUserId[player.UserId] = nil
	end)

	for _, player in ipairs(Players:GetPlayers()) do
		_sessionJoinTimeByUserId[player.UserId] = os.time()
	end

	log("Initialized -- " .. #getTodayQuests() .. " quests active today")
end

return DailyQuestService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="58">
        <Properties>
          <string name="Name">DailyRewardService</string>
          <string name="Source"><![CDATA[--[[
	DailyRewardService
	Server-side daily reward claim logic.

	API:
	  Init()             — creates remotes, wires handlers
	  GetStatus(player)  — returns current streak state
	  Claim(player)      — attempts to claim today's reward

	Uses PlayerDataService for persistence, EconomyService for coins,
	InventoryService for crown grants, CrateService for crate openings.

	Coin rewards are granted through EconomyService so VIP-only
	server-authoritative Fate Coin modifiers apply consistently.
]]

local ServerScriptService = game:GetService("ServerScriptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Server = ServerScriptService:WaitForChild("Server")
local Shared = ReplicatedStorage:WaitForChild("Shared")

local DailyRewardConfig = require(Shared:WaitForChild("DailyRewardConfig"))

local _PDS, _Economy, _Inventory, _Crate, _SpinWheel, _Stat = nil, nil, nil, nil, nil, nil

local function getPDS()
	if _PDS then return _PDS end
	local ok, mod = pcall(require, Server:WaitForChild("PlayerDataService", 5))
	if ok and mod then _PDS = mod end
	return _PDS
end

local function getEconomy()
	if _Economy then return _Economy end
	local ok, mod = pcall(require, Server:WaitForChild("EconomyService", 5))
	if ok and mod then _Economy = mod end
	return _Economy
end

local function getInventory()
	if _Inventory then return _Inventory end
	local ok, mod = pcall(require, Server:WaitForChild("InventoryService", 5))
	if ok and mod then _Inventory = mod end
	return _Inventory
end

local function getCrate()
	if _Crate then return _Crate end
	local ok, mod = pcall(require, Server:WaitForChild("CrateService", 5))
	if ok and mod then _Crate = mod end
	return _Crate
end

local function getSpinWheel()
	if _SpinWheel then return _SpinWheel end
	local ok, mod = pcall(require, Server:WaitForChild("SpinWheelService", 5))
	if ok and mod then _SpinWheel = mod end
	return _SpinWheel
end

local function getStat()
	if _Stat then return _Stat end
	local ok, mod = pcall(require, Server:WaitForChild("StatService", 5))
	if ok and mod then _Stat = mod end
	return _Stat
end

local DailyRewardService = {}
local initialized = false
local _claimLock: { [number]: boolean } = {}

local function log(...)
	print("[DailyRewardService]", ...)
end

function DailyRewardService.GetStatus(player)
	local PDS = getPDS()
	if not PDS or not PDS.IsLoaded(player) then
		return { dataLoaded = false, streak = 0, canClaim = false, secondsUntilNext = 0, rewards = DailyRewardConfig.Rewards }
	end

	local lastClaim = PDS.GetField(player, "LastDailyRewardTime") or 0
	local streak = PDS.GetField(player, "DailyStreak") or 0
	local now = os.time()
	local elapsed = now - lastClaim

	local canClaim = elapsed >= DailyRewardConfig.CooldownSeconds
	local secondsUntilNext = 0
	if not canClaim then
		secondsUntilNext = math.max(0, DailyRewardConfig.CooldownSeconds - elapsed)
	end

	local effectiveStreak = streak
	if elapsed >= DailyRewardConfig.StreakResetSeconds and lastClaim > 0 then
		effectiveStreak = 0
	end

	return {
		dataLoaded = true,
		streak = effectiveStreak,
		lastClaimTime = lastClaim,
		canClaim = canClaim,
		secondsUntilNext = secondsUntilNext,
		rewards = DailyRewardConfig.Rewards,
	}
end

function DailyRewardService.Claim(player)
	local userId = player.UserId
	if _claimLock[userId] then
		return { success = false, reason = "AlreadyClaiming" }
	end
	_claimLock[userId] = true

	local PDS = getPDS()
	if not PDS or not PDS.IsLoaded(player) then
		_claimLock[userId] = nil
		return { success = false, reason = "Data not loaded" }
	end

	local lastClaim = PDS.GetField(player, "LastDailyRewardTime") or 0
	local streak = PDS.GetField(player, "DailyStreak") or 0
	local now = os.time()
	local elapsed = now - lastClaim

	if elapsed < DailyRewardConfig.CooldownSeconds then
		_claimLock[userId] = nil
		local remaining = DailyRewardConfig.CooldownSeconds - elapsed
		return { success = false, reason = "AlreadyClaimed", secondsUntilNext = remaining }
	end

	if elapsed >= DailyRewardConfig.StreakResetSeconds and lastClaim > 0 then
		streak = 0
		log(string.format("%s streak reset (%.0f hours since last claim)", player.Name, elapsed / 3600))
	end

	streak = streak + 1
	if streak > DailyRewardConfig.MaxStreak then
		streak = 1
	end

	local rewardDef = DailyRewardConfig.Rewards[streak]
	if not rewardDef then
		_claimLock[userId] = nil
		warn("[DailyRewardService] No reward defined for day", streak)
		return { success = false, reason = "No reward for day " .. tostring(streak) }
	end

	local grantResult = {
		type = rewardDef.type,
		label = rewardDef.label,
		icon = rewardDef.icon or "",
		iconText = rewardDef.iconText or "",
		iconColor = rewardDef.iconColor,
		crownId = rewardDef.crownId,
		crateId = rewardDef.crateId,
	}

	if rewardDef.type == "Coins" then
		local eco = getEconomy()
		if eco then
			local source = "DailyReward_Day" .. streak
			local baseAmount = tonumber(rewardDef.amount) or 0
			local stat = getStat()
			local vipOwned = false
			if stat and type(stat.HasVipEntitlement) == "function" then
				vipOwned = stat.HasVipEntitlement(player) == true
			else
				vipOwned = player:GetAttribute("OwnsVIP") == true or player:GetAttribute("VIPBundleOwned") == true
			end
			local ok, actualAmount = eco.AwardDailyRewardCoins(player, baseAmount, source)
			if not ok then
				_claimLock[userId] = nil
				return { success = false, reason = "Coin grant failed" }
			end
			grantResult.amount = actualAmount or rewardDef.amount
			grantResult.label = string.format("%d Coins", grantResult.amount)
			warn(string.format(
				"[DailyRewardGrantAudit] player=%s userId=%d day=%d base=%d policy=vip_only vipOwned=%s final=%d source=%s",
				player.Name,
				userId,
				streak,
				baseAmount,
				tostring(vipOwned),
				tonumber(grantResult.amount) or 0,
				source
			))
		else
			_claimLock[userId] = nil
			return { success = false, reason = "Economy unavailable" }
		end

	elseif rewardDef.type == "Crown" then
		local inv = getInventory()
		if inv then
			local alreadyOwned = inv.OwnsItem(player, "Crowns", rewardDef.crownId)
			if alreadyOwned then
				grantResult.duplicate = true
				grantResult.coinsInstead = 0
			else
				inv.GrantItem(player, "Crowns", rewardDef.crownId)
				grantResult.crownId = rewardDef.crownId
			end
		else
			_claimLock[userId] = nil
			return { success = false, reason = "Inventory unavailable" }
		end

	elseif rewardDef.type == "Crate" then
		local crateService = getCrate()
		if crateService and crateService.RollCrateFree then
			local rollCount = rewardDef.amount or 1
			local rollResult = crateService.RollCrateFree(player, rewardDef.crateId, rollCount)
			local crateResults = rollResult and rollResult.results or {}
			grantResult.crateResults = crateResults
		else
			_claimLock[userId] = nil
			return { success = false, reason = "Crate service unavailable" }
		end

	elseif rewardDef.type == "Spins" then
		local spinsToGrant = rewardDef.amount or 1
		local spinService = getSpinWheel()
		if not spinService or type(spinService.GrantRobuxSpins) ~= "function" then
			_claimLock[userId] = nil
			return { success = false, reason = "SpinWheelService unavailable" }
		end
		local granted = spinService.GrantRobuxSpins(player, spinsToGrant)
		if not granted then
			_claimLock[userId] = nil
			return { success = false, reason = "Spins grant failed" }
		end
		grantResult.amount = spinsToGrant
		log(string.format("%s claimed Day %d: %d free spins", player.Name, streak, spinsToGrant))
	end

	PDS.SetField(player, "LastDailyRewardTime", now)
	PDS.SetField(player, "DailyStreak", streak)

	warn(string.format("[DAILY_AUDIT] player=%s userId=%d day=%d type=%s label=%s | t=%d",
		player.Name, userId, streak, rewardDef.type, grantResult.label, os.time()))

	_claimLock[userId] = nil
	return {
		success = true,
		reward = grantResult,
		newStreak = streak,
	}
end

function DailyRewardService.Init()
	if initialized then return end
	initialized = true

	local remotesFolder = ReplicatedStorage:FindFirstChild("Remotes")
	if not remotesFolder then
		remotesFolder = Instance.new("Folder")
		remotesFolder.Name = "Remotes"
		remotesFolder.Parent = ReplicatedStorage
	end

	local getStatusFunc = remotesFolder:FindFirstChild("DailyReward_GetStatus")
	if not getStatusFunc then
		getStatusFunc = Instance.new("RemoteFunction")
		getStatusFunc.Name = "DailyReward_GetStatus"
		getStatusFunc.Parent = remotesFolder
	end
	getStatusFunc.OnServerInvoke = function(player)
		return DailyRewardService.GetStatus(player)
	end

	local claimFunc = remotesFolder:FindFirstChild("DailyReward_Claim")
	if not claimFunc then
		claimFunc = Instance.new("RemoteFunction")
		claimFunc.Name = "DailyReward_Claim"
		claimFunc.Parent = remotesFolder
	end
	claimFunc.OnServerInvoke = function(player)
		return DailyRewardService.Claim(player)
	end

	game:GetService("Players").PlayerRemoving:Connect(function(player)
		_claimLock[player.UserId] = nil
	end)

	log(string.format("Initialized — cooldown=%ds, streakReset=%ds, maxStreak=%d",
		DailyRewardConfig.CooldownSeconds, DailyRewardConfig.StreakResetSeconds, DailyRewardConfig.MaxStreak))
end

return DailyRewardService
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="59">
        <Properties>
          <string name="Name">DayNightCycle</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--[[
	DayNightCycle
	Smoothly cycles Lighting.ClockTime through a full day in CYCLE_SECONDS.
	Also adjusts Ambient / OutdoorAmbient / Brightness so nighttime
	actually looks dark and sunrise/sunset feel warm.

	Runs on server — ClockTime replicates to all clients automatically.
]]

local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")

-- ═══════════════════════════════════════════════════════════════════
-- CONFIG
-- ═══════════════════════════════════════════════════════════════════

local CYCLE_SECONDS = 180         -- one full day/night rotation (3 minutes)
local START_HOUR    = 9           -- start at mid-morning
local SPEED         = 24 / CYCLE_SECONDS  -- ClockTime hours per real second

-- Day (noon) lighting values — very bright and vibrant
local DAY_AMBIENT         = Color3.fromRGB(212, 194, 172)   -- slightly warmer / richer daylight
local DAY_OUTDOOR_AMBIENT = Color3.fromRGB(242, 220, 194)   -- stronger outdoor color lift
local DAY_BRIGHTNESS      = 4.3

-- Night (midnight) lighting values — bright and colorful, never gloomy
local NIGHT_AMBIENT         = Color3.fromRGB(162, 168, 222) -- richer night tint
local NIGHT_OUTDOOR_AMBIENT = Color3.fromRGB(178, 184, 230)
local NIGHT_BRIGHTNESS      = 3.4

-- Sunrise/sunset accent colors (blended in at golden hours)
local GOLDEN_AMBIENT         = Color3.fromRGB(232, 170, 96) -- slightly more vivid golden hour
local GOLDEN_OUTDOOR_AMBIENT = Color3.fromRGB(255, 198, 116)
local GOLDEN_BRIGHTNESS      = 3.7

-- Global post color pass (one notch stronger vibrance).
local GLOBAL_VIBRANCE_SATURATION = 0.14
local GLOBAL_VIBRANCE_CONTRAST   = 0.08
local GLOBAL_VIBRANCE_BRIGHTNESS = 0.02

-- ═══════════════════════════════════════════════════════════════════
-- HELPERS
-- ═══════════════════════════════════════════════════════════════════

--[[
	Returns 0–1 representing how "night" the given hour is.
	0 = noon, 1 = midnight.  Smooth cosine curve.
]]
local function getNightFactor(hour: number): number
	-- Cosine curve centered at noon (12) with period 24
	-- cos(0) = 1 at midnight (hour 0/24), cos(pi) = -1 at noon (hour 12)
	-- We remap: nightFactor = (cos + 1) / 2   → 1 at midnight, 0 at noon
	return (math.cos(math.rad((hour - 12) * (360 / 24))) + 1) / 2
end

--[[
	Returns 0–1 representing how "golden hour" the given hour is.
	Peaks at ~6:30 (sunrise) and ~17:30 (sunset), 0 elsewhere.
]]
local function getGoldenFactor(hour: number): number
	-- Two Gaussian bumps at 6.5 and 17.5
	local sunrise = math.exp(-((hour - 6.5) ^ 2) / 2)
	local sunset  = math.exp(-((hour - 17.5) ^ 2) / 2)
	return math.clamp(math.max(sunrise, sunset), 0, 1)
end

--[[
	Lerp two Color3 values.
]]
local function lerpColor(a: Color3, b: Color3, t: number): Color3
	return Color3.new(
		a.R + (b.R - a.R) * t,
		a.G + (b.G - a.G) * t,
		a.B + (b.B - a.B) * t
	)
end

-- ═══════════════════════════════════════════════════════════════════
-- MAIN LOOP
-- ═══════════════════════════════════════════════════════════════════

Lighting.ClockTime = START_HOUR
print(string.format("[DayNight] Cycle started — %ds per full day, starting at hour %d", CYCLE_SECONDS, START_HOUR))

-- Ensure a single persistent color correction profile for world vibrance.
do
	local cc = Lighting:FindFirstChild("GlobalVibranceCC")
	if not cc or not cc:IsA("ColorCorrectionEffect") then
		if cc then
			cc:Destroy()
		end
		cc = Instance.new("ColorCorrectionEffect")
		cc.Name = "GlobalVibranceCC"
		cc.Parent = Lighting
	end
	cc.Enabled = true
	cc.Saturation = GLOBAL_VIBRANCE_SATURATION
	cc.Contrast = GLOBAL_VIBRANCE_CONTRAST
	cc.Brightness = GLOBAL_VIBRANCE_BRIGHTNESS
end

RunService.Heartbeat:Connect(function(dt: number)
	-- While an exclusive mode preset is active (e.g. Save the Brainrot),
	-- do not mutate Lighting so the preset remains authoritative.
	if Lighting:GetAttribute("ModeLightingExclusive") == true then
		return
	end

	-- Advance clock
	local newTime = (Lighting.ClockTime + SPEED * dt) % 24
	Lighting.ClockTime = newTime

	-- Compute blending factors
	local night  = getNightFactor(newTime)
	local golden = getGoldenFactor(newTime)

	-- Base day→night lerp
	local ambient = lerpColor(DAY_AMBIENT, NIGHT_AMBIENT, night)
	local outdoor = lerpColor(DAY_OUTDOOR_AMBIENT, NIGHT_OUTDOOR_AMBIENT, night)
	local bright  = DAY_BRIGHTNESS + (NIGHT_BRIGHTNESS - DAY_BRIGHTNESS) * night

	-- Layer golden-hour tint on top (additive blend)
	if golden > 0.05 then
		ambient = lerpColor(ambient, GOLDEN_AMBIENT, golden * 0.6)
		outdoor = lerpColor(outdoor, GOLDEN_OUTDOOR_AMBIENT, golden * 0.5)
		bright  = bright + (GOLDEN_BRIGHTNESS - bright) * golden * 0.3
	end

	-- Apply
	Lighting.Ambient = ambient
	Lighting.OutdoorAmbient = outdoor
	Lighting.Brightness = bright
end)

]]></string>
        </Properties>
      </Item>
