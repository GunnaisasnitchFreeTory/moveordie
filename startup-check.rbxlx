-- ═══════════════════════════════════════════════════════════════════
-- GAMEPASS GRANT LOGIC
-- ═══════════════════════════════════════════════════════════════════

local function grantGamepassReward(player: Player, gamepassId: number, emitPurchaseGranted: boolean?): boolean
	local reward = GAMEPASS_REWARD_MAP[gamepassId]
	if not reward then return false end

	local grant = getGrantService()
	if not grant then
		warn("[PurchaseSystem] GrantService unavailable for gamepass grant")
		return false
	end

	if reward.type == "Bundle" then
		syncVipBundleEntitlement(player, reward, "GamePassGrant:" .. tostring(gamepassId))

		local grantedItems = {}
		for _, item in ipairs(reward.items) do
			local grantType = nil
			local grantValue = nil
			local grantKey = nil
			if item.type == "Currency" then
				grantType = "Currency"
				grantValue = tonumber(item.amount) or 0
				grantKey = string.format("coins:%d", grantValue)
			elseif item.category and item.itemId then
				grantType = toRewardTypeFromCategory(item.category)
				grantValue = item.itemId
				grantKey = tostring(item.itemId)
			end
			if not grantType or grantValue == nil or grantKey == nil or (grantType == "Currency" and grantValue <= 0) then
				warn(string.format("[PurchaseSystem] Gamepass bundle item invalid: pass=%d label=%s",
					gamepassId, tostring(item.label or item.itemId or item.type)))
				return false
			end
			local okGrant = grant.GrantItem(player, grantType, grantValue, "GamePass", {
				fireReward = false,
				idempotencyKey = string.format("gamepass:%d:%d:%s", player.UserId, gamepassId, grantKey),
			})
			if not okGrant.success then
				warn(string.format("[PurchaseSystem] Gamepass bundle grant failed: %s/%s for %s reason=%s",
					tostring(item.category or item.type), tostring(item.itemId or item.amount), player.Name, tostring(okGrant.reason)))
				return false
			end
			local grantedPayload = okGrant.payload or {
				type = grantType,
				id = item.itemId or "fate_coins",
				category = item.category,
				amount = grantType == "Currency" and tonumber(grantValue) or nil,
				source = "GamePass",
			}
			if item.popupImageOverride and item.popupImageOverride ~= "" then
				grantedPayload.popupImageOverride = item.popupImageOverride
			end
			if item.imageAssetId and item.imageAssetId ~= "" then
				grantedPayload.imageAssetId = item.imageAssetId
			end
			table.insert(grantedItems, grantedPayload)
		end
		if #grantedItems > 0 then
			grant.EmitRewardGranted(player, {
				type = "Bundle",
				id = reward.bundleId or tostring(gamepassId),
				source = "GamePass",
				batchItems = grantedItems,
			})
		end
	else
		local grantType = toRewardTypeFromCategory(reward.category)
		local okGrant = grant.GrantItem(player, grantType, reward.itemId, "GamePass", {
			fireReward = false,
			idempotencyKey = string.format("gamepass:%d:%d:%s", player.UserId, gamepassId, reward.itemId),
		})
		if not okGrant.success then
			warn(string.format("[PurchaseSystem] Gamepass grant failed: %s/%s for %s reason=%s",
				reward.category, reward.itemId, player.Name, tostring(okGrant.reason)))
			return false
		end
		if emitPurchaseGranted == true and not okGrant.alreadyOwned then
			emitShopPurchaseGranted(player, gamepassId, reward)
		end
	end

	notifyClient(player, "GamepassPurchase", { gamepassId = gamepassId })
	print(string.format("[PurchaseSystem] Gamepass %d (%s) granted to %s", gamepassId, reward.label, player.Name))
	return true
end

-- Check all gamepasses on player join and grant any owned items
local function checkGamepassOwnership(player: Player)
	for gamepassId, reward in pairs(GAMEPASS_REWARD_MAP) do
		local ok, owns = pcall(function()
			return MarketplaceService:UserOwnsGamePassAsync(player.UserId, gamepassId)
		end)
		if ok and owns then
			grantGamepassReward(player, gamepassId, false)
		elseif not ok then
			warn(string.format("[PurchaseSystem] UserOwnsGamePassAsync failed for %s gamepass %d: %s",
				player.Name, gamepassId, tostring(owns)))
		end
	end
end

MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player: Player, gamepassId: number, wasPurchased: boolean)
	print(string.format("[GamePass] FINISHED passId=%d player=%s purchased=%s",
		tonumber(gamepassId) or 0,
		player and player.Name or "unknown",
		tostring(wasPurchased)))
	if not wasPurchased then
		return
	end
	if not player or not player.Parent then
		return
	end
	if GAMEPASS_REWARD_MAP[gamepassId] then
		local granted = grantGamepassReward(player, gamepassId, true)
		if not granted then
			warn(string.format("[GamePass] Grant failed passId=%d player=%s", gamepassId, player.Name))
		end
	end
end)

-- Create remote for client to request gamepass verification after purchase
local gamepassVerifyRF = remotesFolder:FindFirstChild("VerifyGamepassPurchase")
if not gamepassVerifyRF then
	gamepassVerifyRF = Instance.new("RemoteFunction")
	gamepassVerifyRF.Name = "VerifyGamepassPurchase"
	gamepassVerifyRF.Parent = remotesFolder
end

canPurchaseGamepassRF.OnServerInvoke = function(player: Player, gamepassId: number)
	if type(gamepassId) ~= "number" then
		return { allowed = false, reason = "INVALID_GAMEPASS" }
	end

	return getGamepassPurchaseGate(player, gamepassId)
end

gamepassVerifyRF.OnServerInvoke = function(player: Player, gamepassId: number)
	if type(gamepassId) ~= "number" then return { success = false } end

	local reward = GAMEPASS_REWARD_MAP[gamepassId]
	if not reward then return { success = false, reason = "Unknown gamepass" } end

	local gate = getGamepassPurchaseGate(player, gamepassId)
	if isVipBundleReward(reward) and gate.vipOwned == true then
		warn(string.format(
			"[VIPPurchaseGate] player=%s gamepassId=%d vipOwned=%s purchaseBlocked=%s verifyShortCircuit=true",
			player.Name,
			gamepassId,
			tostring(gate.vipOwned),
			tostring(gate.alreadyOwned)
		))
		return { success = true, alreadyOwned = true, reason = "Already owned" }
	end

	local ok, owns = pcall(function()
		return MarketplaceService:UserOwnsGamePassAsync(player.UserId, gamepassId)
	end)

	if ok and owns then
		local granted = grantGamepassReward(player, gamepassId, true)
		if granted then
			return { success = true }
		end
		return { success = false, reason = "Grant failed" }
	end

	return { success = false, reason = "Not owned" }
end

-- Hook into PlayerAdded for gamepass ownership checks
Players.PlayerAdded:Connect(function(player)
	task.defer(function()
		checkGamepassOwnership(player)
	end)
end)

-- Check existing players (Studio)
for _, player in ipairs(Players:GetPlayers()) do
	task.spawn(function()
		checkGamepassOwnership(player)
	end)
end

-- ═══════════════════════════════════════════════════════════════════
-- DEVELOPER PRODUCT RECEIPT HANDLING (ProcessReceipt)
--
-- Idempotent: tracks PurchaseId in-memory to prevent double-granting.
-- Uses PRODUCT_REWARD_MAP for centralized reward lookup.
-- ═══════════════════════════════════════════════════════════════════

local processedReceipts: { [string]: boolean } = {}

MarketplaceService.ProcessReceipt = function(receiptInfo)
	local receiptKey = tostring(receiptInfo.PurchaseId)
	local productId = receiptInfo.ProductId
	print(string.format("[Receipt] START productId=%d playerId=%d purchaseId=%s", productId, receiptInfo.PlayerId, receiptKey))

	if processedReceipts[receiptKey] then
		print("[PurchaseSystem] Receipt already processed:", receiptKey)
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end

	local player = Players:GetPlayerByUserId(receiptInfo.PlayerId)
	if not player then
		print("[PurchaseSystem] Player not in game for receipt:", receiptKey, "userId:", receiptInfo.PlayerId)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	print(string.format("[Receipt] START productId=%d player=%s purchaseId=%s", productId, player.Name, receiptKey))

	local pds = getPlayerDataService()
	if pds then
		local pdata = pds.GetData(player)
		local processed = pdata and pdata.ProcessedReceipts
		if type(processed) == "table" and processed[receiptKey] then
			processedReceipts[receiptKey] = true
			print(string.format("[Receipt] player=%s productId=%d alreadyProcessed=true", player.Name, productId))
			return Enum.ProductPurchaseDecision.PurchaseGranted
		end
	end

	local reward = PRODUCT_REWARD_MAP[productId]

	if not reward then
		print(string.format("[Receipt] productId=%d result=FAIL reason=UNKNOWN_PRODUCT", productId))
		warn(string.format("[CoinsProduct] player=%s productId=%d grant=0 result=FAIL reason=UNKNOWN_PRODUCT",
			player.Name, productId))
		warn("[PurchaseSystem] Unknown productId:", productId, "receipt:", receiptKey)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	print(string.format("[Receipt] productId=%d resolvedGrant type=%s id=%s amount=%s",
		productId,
		tostring(reward.type),
		tostring(reward.itemId or reward.crateId or ""),
		tostring(reward.amount or reward.quantity or 0)
	))

	local granted = false
	local ok, err = pcall(function()
		local grant = getGrantService()
		if not grant then
			error("GrantService unavailable")
		end
		if reward.type == "Spins" then
			local g = grant.GrantItem(player, "Spin", reward.amount, "DevProduct", {
				idempotencyKey = "receipt:" .. receiptKey,
			})
			granted = g.success

		elseif reward.type == "Coins" then
			local g = grant.GrantItem(player, "Currency", reward.amount, "DevProduct", {
				idempotencyKey = "receipt:" .. receiptKey,
			})
			granted = g.success
			if granted then
				print(string.format("[CoinsProduct] player=%s productId=%d grant=%d result=SUCCESS",
					player.Name, productId, reward.amount))
			end

		elseif reward.type == "Crate" then
			local crate = getCrateService()
			if crate then
				local result = crate.AddCrates(player, reward.crateId, reward.quantity, "DevProduct")
				if result and result.success then
					local remotes = ReplicatedStorage:FindFirstChild("Remotes")
					local invUpdate = remotes and remotes:FindFirstChild("InventoryUpdated")
					if invUpdate and invUpdate:IsA("RemoteEvent") then
						invUpdate:FireClient(player, "CrateBalance", {
							crateId = reward.crateId,
							newCount = result.newCount,
							counts = crate.GetCrateCounts(player),
							qty = reward.quantity,
						})
					end
					granted = true
				else
					warn("[PurchaseSystem] AddCrates failed:", result and result.reason or "unknown")
				end
			end
		elseif reward.type == "FreezePlayer" then
			local consumeOk, consumeReason = FreezePlayerProductService.ConsumePendingReceipt(player, receiptKey)
			granted = consumeOk
			print(string.format(
				"[FreezeProductReceipt] purchaser=%s productId=%d result=%s reason=%s",
				player.Name,
				productId,
				tostring(granted),
				tostring(consumeReason)
			))

		elseif reward.type == "ForceNextMode" then
			local consumeOk, consumeReason = ForceNextModeProductService.ConsumePendingReceipt(player, receiptKey)
			granted = consumeOk
			print(string.format(
				"[ForceNextModeReceipt] purchaser=%s productId=%d result=%s reason=%s",
				player.Name,
				productId,
				tostring(granted),
				tostring(consumeReason)
			))
		elseif reward.type == "Ability" then
			local consumeOk, consumeReason = PerkProductService.ConsumePendingReceipt(
				player,
				receiptKey,
				tostring(reward.abilityId or "")
			)
			granted = consumeOk
			print(string.format(
				"[AbilityProductReceipt] purchaser=%s productId=%d ability=%s result=%s reason=%s",
				player.Name,
				productId,
				tostring(reward.abilityId),
				tostring(granted),
				tostring(consumeReason)
			))
		end
	end)

	if not ok then
		print(string.format("[Receipt] productId=%d result=FAIL reason=%s", productId, tostring(err)))
		warn("[PurchaseSystem] Error granting reward for productId", productId, ":", err)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	if granted then
		processedReceipts[receiptKey] = true
		if pds then
			local pdata = pds.GetData(player)
			if pdata then
				local processed = pdata.ProcessedReceipts
				if type(processed) ~= "table" then
					processed = {}
				end
				processed[receiptKey] = true
				pds.SetField(player, "ProcessedReceipts", processed)
			end
		end
		print(string.format("[Receipt] productId=%d result=SUCCESS", productId))
		print(string.format("[PurchaseSystem] Granted: %s (%s) to %s, receipt=%s",
			reward.label, reward.type, player.Name, receiptKey))
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end

	print(string.format("[Receipt] productId=%d result=FAIL reason=GRANT_RETURNED_FALSE", productId))
	warn("[PurchaseSystem] Failed to grant reward for productId:", productId, "receipt:", receiptKey)
	return Enum.ProductPurchaseDecision.NotProcessedYet
end

print("[PurchaseSystem] ProcessReceipt + Gamepass handlers installed")

-- ═══════════════════════════════════════════════════════════════════
-- SPIN THE WHEEL: CLEANUP + PROXIMITY PROMPT SETUP
-- ═══════════════════════════════════════════════════════════════════

task.defer(function()
	local spinModel = workspace:FindFirstChild("SpinTheWheel", true)
	if not spinModel then
		-- Retry a few times (streaming may delay)
		for i = 1, 5 do
			task.wait(2)
			spinModel = workspace:FindFirstChild("SpinTheWheel", true)
			if spinModel then break end
		end
	end

	if not spinModel then
		warn("[SpinWheelBootstrap] SpinTheWheel model NOT FOUND in Workspace — ProximityPrompt not created")
		return
	end

	print("[SpinWheelBootstrap] SpinTheWheel found:", spinModel:GetFullName())

	-- A) REMOVE all ClickDetectors (disable click-to-spin in the 3D world)
	local clickDetectorsRemoved = 0
	for _, desc in ipairs(spinModel:GetDescendants()) do
		if desc:IsA("ClickDetector") then
			print("[SpinWheelBootstrap] REMOVING ClickDetector:", desc:GetFullName())
			desc:Destroy()
			clickDetectorsRemoved += 1
		end
	end
	if clickDetectorsRemoved > 0 then
		print("[SpinWheelBootstrap] Removed", clickDetectorsRemoved, "ClickDetector(s)")
	end

	-- B) DISABLE/REMOVE embedded Scripts and LocalScripts
	--    These may contain old click-to-spin logic or unauthorized sound assets
	local scriptsRemoved = 0
	for _, desc in ipairs(spinModel:GetDescendants()) do
		if desc:IsA("Script") or desc:IsA("LocalScript") then
			print("[SpinWheelBootstrap] REMOVING embedded script:", desc:GetFullName(), "(" .. desc.ClassName .. ")")
			desc.Disabled = true
			desc:Destroy()
			scriptsRemoved += 1
		end
	end
	if scriptsRemoved > 0 then
		print("[SpinWheelBootstrap] Removed", scriptsRemoved, "embedded script(s)")
	end

	-- C) REMOVE any existing ProximityPrompts (we'll create a fresh one)
	for _, desc in ipairs(spinModel:GetDescendants()) do
		if desc:IsA("ProximityPrompt") then
			print("[SpinWheelBootstrap] Removing old ProximityPrompt:", desc:GetFullName())
			desc:Destroy()
		end
	end

	-- D) Find the GROUND-LEVEL center position of the spin wheel model
	--    The actual wheel is elevated (Y ~16.5 studs), which causes distance
	--    mismatch between the prompt and auto-close checks.
	--    We create an invisible anchor Part at GROUND LEVEL so:
	--    1) The "Press E" prompt renders at a visible height (not behind the wheel)
	--    2) Distance measurements are consistent (horizontal, not affected by elevation)
	local wheelCenter = nil

	-- Try to find the model center
	local anyPart = spinModel:FindFirstChildWhichIsA("BasePart", true)
	if anyPart then
		-- Use horizontal position of any part, but force Y to near-ground level
		wheelCenter = Vector3.new(anyPart.Position.X, 5, anyPart.Position.Z)
		print("[SpinWheelBootstrap] Reference part:", anyPart:GetFullName(), "at", anyPart.Position)
	end

	if not wheelCenter then
		warn("[SpinWheelBootstrap] No BasePart found in SpinTheWheel — cannot create ProximityPrompt")
		return
	end

	-- Create an invisible anchor Part at ground level
	local anchor = Instance.new("Part")
	anchor.Name = "SpinWheelPromptAnchor"
	anchor.Size = Vector3.new(2, 2, 2)
	anchor.Position = wheelCenter
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.CanTouch = false
	anchor.Transparency = 1 -- invisible
	anchor.Parent = spinModel

	print("[SpinWheelBootstrap] Created invisible anchor at:", wheelCenter)

	-- Create ProximityPrompt on the ground-level anchor
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "SpinWheelPrompt"
	prompt.ActionText = "Spin"
	prompt.ObjectText = "Spin The Wheel"
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 14
	prompt.RequiresLineOfSight = false
	prompt.Parent = anchor

	print("[SpinWheelBootstrap] ProximityPrompt created on:", anchor:GetFullName(), "at Y =", wheelCenter.Y)
	print("[SpinWheelBootstrap] Spin The Wheel system fully ready ✓")
end)

print("[SpinWheelBootstrap] Spin The Wheel remotes ready")
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="100">
        <Properties>
          <string name="Name">SpinWheelService</string>
          <string name="Source"><![CDATA[--[[
	SpinWheelService
	Server-authoritative spin wheel logic.

	Responsibilities:
	  * Track per-player spin data (free spin timer, purchased spins)
	  * Validate spin requests
	  * Weighted RNG for reward selection (uses segment.weight)
	  * Award rewards AFTER spin animation completes (pending spin system)
	    – Coins → EconomyService.AwardCoins (skipMultiplier=true)
	    – Pets  → InventoryService.GrantItem
	  * Persist spin data via DataStore (with pcall fallback)
	  * Grant spins purchased via Robux (called from ProcessReceipt)
	  * New players start with 1 purchased spin
	  * DATA_VERSION migration resets inflated spins for existing players

	API:
	  Init()
	  GetPlayerData(player) → { freeSpinAvailable, nextFreeSpinTime, purchasedSpins }
	  RequestSpin(player)   → { success, segmentIndex, rewardName, rewardType,
	                             coinsAwarded, catalogId, rarity, spinId }
	                           | { success=false, reason }
	  BuySpins(player, packageIndex) → { success, newSpinCount } | { success=false, reason }
	  GrantRobuxSpins(player, spinsToAdd) → boolean
	  SavePlayer(player)    → saves data to DataStore
]]

local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")
local ServerScriptService = game:GetService("ServerScriptService")

local Shared = ReplicatedStorage:WaitForChild("Shared", 10)
if not Shared then
	warn("[SpinWheelService] ReplicatedStorage.Shared not found after 10s — spin wheel disabled")
	return {
		Init = function() end, OnPlayerJoined = function() end, OnPlayerLeaving = function() end,
		GetPlayerData = function() return { freeSpinAvailable = false, nextFreeSpinTime = 0, purchasedSpins = 0 } end,
		RequestSpin = function() return { success = false, reason = "Service unavailable" } end,
		BuySpins = function() return { success = false, reason = "Service unavailable" } end,
		GrantRobuxSpins = function() return false end, SaveAll = function() end,
	}
end

local SpinWheelConfigModule = Shared:WaitForChild("SpinWheelConfig", 10)
local SpinWheelConfig
if SpinWheelConfigModule then
	local ok, mod = pcall(require, SpinWheelConfigModule)
	if ok then SpinWheelConfig = mod else warn("[SpinWheelService] SpinWheelConfig failed to load:", mod) end
end
if not SpinWheelConfig then
	warn("[SpinWheelService] SpinWheelConfig not found — spin wheel will not function")
	return {
		Init = function() end, OnPlayerJoined = function() end, OnPlayerLeaving = function() end,
		GetPlayerData = function() return { freeSpinAvailable = false, nextFreeSpinTime = 0, purchasedSpins = 0 } end,
		RequestSpin = function() return { success = false, reason = "Config missing" } end,
		BuySpins = function() return { success = false, reason = "Config missing" } end,
		GrantRobuxSpins = function() return false end, SaveAll = function() end,
	}
end

local ItemCatalogModule = Shared:WaitForChild("ItemCatalog", 10)
local ItemCatalog
if ItemCatalogModule then
	local ok, mod = pcall(require, ItemCatalogModule)
	if ok then ItemCatalog = mod else warn("[SpinWheelService] ItemCatalog failed to load:", mod) end
end
if not ItemCatalog then
	warn("[SpinWheelService] ItemCatalog not found — pet rewards will use raw catalog IDs")
	ItemCatalog = { GetPet = function() return nil end }
end

local IS_STUDIO = RunService:IsStudio()

local spinDataStore = nil
pcall(function()
	local storeName = IS_STUDIO and "SpinWheelData_v1_STUDIO" or "SpinWheelData_v1"
	spinDataStore = DataStoreService:GetDataStore(storeName)
end)

local _EconomyService = nil
local _InventoryService = nil
local _GrantService = nil

local function getEconomyService()
	if _EconomyService ~= nil then return _EconomyService end
	local ok, mod = pcall(function()
		local Server = ServerScriptService:WaitForChild("Server", 5)
		return require(Server:WaitForChild("EconomyService", 5))
	end)
	if ok and mod then _EconomyService = mod else _EconomyService = false end
	return _EconomyService
end

local function getInventoryService()
	if _InventoryService ~= nil then return _InventoryService end
	local ok, mod = pcall(function()
		local Server = ServerScriptService:WaitForChild("Server", 5)
		return require(Server:WaitForChild("InventoryService", 5))
	end)
	if ok and mod then _InventoryService = mod else _InventoryService = false end
	return _InventoryService
end

local function getGrantService()
	if _GrantService ~= nil then return _GrantService end
	local ok, mod = pcall(function()
		local Server = ServerScriptService:WaitForChild("Server", 5)
		return require(Server:WaitForChild("GrantService", 5))
	end)
	if ok and mod then _GrantService = mod else _GrantService = false end
	return _GrantService
end

local SPIN_DURATION_SECONDS = 11
local CROWN_DUPLICATE_COINS = 100
local CROWN_MAX_REROLL = 5
local NEW_PLAYER_STARTING_SPINS = 1
local DATA_VERSION = 2

local playerCache: { [number]: { lastFreeSpinTime: number, purchasedSpins: number, dataVersion: number } } = {}
local spinInProgress: { [number]: boolean } = {}

local function log(...)
	print("[SpinWheelService]", ...)
end

local _findableCrownPool: { { id: string, name: string, rarity: string, image: string? } }? = nil

local function getFindableCrownPool()
	if _findableCrownPool then return _findableCrownPool end
	_findableCrownPool = {}
	if ItemCatalog and ItemCatalog.Crowns then
		for id, entry in pairs(ItemCatalog.Crowns) do
			if entry.source == "Findable" and entry.modelPath and entry.modelPath ~= "" then
				table.insert(_findableCrownPool, {
					id    = id,
					name  = entry.name or id,
					rarity = entry.rarity or "Common",
					image = entry.image,
				})
			end
		end
	end
	log(string.format("Findable crown pool: %d crowns", #_findableCrownPool))
	return _findableCrownPool
end

-- Rarity weights for spin wheel crown selection (grind-heavy tuning)
local CROWN_RARITY_WEIGHT = {
	Common    = 50,
	Rare      = 2,
	Epic      = 1,
	Legendary = 0,
}

local function weightedPickCrown(pool: { { id: string, name: string, rarity: string, image: string? } })
	local total = 0
	for _, entry in ipairs(pool) do
		total += (CROWN_RARITY_WEIGHT[entry.rarity] or 1)
	end
	if total <= 0 then return pool[math.random(1, #pool)] end
	local roll = math.random() * total
	local cumulative = 0
	for _, entry in ipairs(pool) do
		cumulative += (CROWN_RARITY_WEIGHT[entry.rarity] or 1)
		if roll <= cumulative then return entry end
	end
	return pool[#pool]
end

local function pickRandomFindableCrown(player: Player): (string, string, string, boolean, string?)
	local pool = getFindableCrownPool()
	if #pool == 0 then
		warn("[SpinWheel] Crown pool empty — using fallback crown_sparkle")
		return "crown_sparkle", "Sparkle Crown", "Common", false, "rbxassetid://137567080814300"
	end

	local IS = getInventoryService()

	for _ = 1, CROWN_MAX_REROLL do
		local pick = weightedPickCrown(pool)
		local owns = false
		if IS and type(IS.OwnsItem) == "function" then
			local ok, result = pcall(IS.OwnsItem, IS, player, "Crowns", pick.id)
			owns = ok and result
		end
		if not owns then
			return pick.id, pick.name, pick.rarity, false, pick.image
		end
	end

	local pick = weightedPickCrown(pool)
	local isDuplicate = false
	if IS and type(IS.OwnsItem) == "function" then
		local ok, result = pcall(IS.OwnsItem, IS, player, "Crowns", pick.id)
		isDuplicate = ok and result or false
	end
	return pick.id, pick.name, pick.rarity, isDuplicate, pick.image
end
local pendingSpin: {
	[number]: {
		spinId: string,
		segmentIndex: number,
		rewardName: string,
		rewardType: string,
		coinsAwarded: number,
		catalogId: string?,
		createdAt: number,
		grantAtTime: number,
	}
} = {}

local SpinWheelService = {}

local function isUnlimitedSpinsEnabled(): boolean
	return SpinWheelConfig.DEBUG_UNLIMITED_SPINS == true
end

local function grantPet(player: Player, catalogId: string)
	local GS = getGrantService()
	if GS and GS ~= false and type(GS.GrantItem) == "function" then
		local res = GS.GrantItem(player, "Pet", catalogId, "SpinWheel")
		if not res.success then
			error("GrantService Pet grant failed: " .. tostring(res.reason))
		end
		log(string.format("PET GRANTED via GrantService: %s → %s", player.Name, catalogId))
		return
	end
	error("GrantService unavailable for pet grant")
end

local function loadData(userId: number): { lastFreeSpinTime: number, purchasedSpins: number, dataVersion: number }
	local data = { lastFreeSpinTime = 0, purchasedSpins = NEW_PLAYER_STARTING_SPINS, dataVersion = DATA_VERSION }

	if spinDataStore then
		local ok, saved = pcall(function()
			return spinDataStore:GetAsync("SpinWheel_" .. tostring(userId))
		end)
		if ok and saved and type(saved) == "table" then
			data.lastFreeSpinTime = saved.lastFreeSpinTime or 0
			data.purchasedSpins = saved.purchasedSpins or 0

			local savedVersion = saved.dataVersion or 0
			if savedVersion < DATA_VERSION then
				local oldSpins = data.purchasedSpins
				data.purchasedSpins = NEW_PLAYER_STARTING_SPINS
				data.dataVersion = DATA_VERSION
				warn(string.format(
					"[SPIN_AUDIT] userId=%d MIGRATION v%d->v%d | spins %d -> %d (reset) | t=%d",
					userId, savedVersion, DATA_VERSION, oldSpins, NEW_PLAYER_STARTING_SPINS, os.time()
				))
			else
				data.dataVersion = savedVersion
			end
		else
			warn(string.format("[SPIN_AUDIT] userId=%d NEW_PLAYER starting spins=%d | t=%d",
				userId, NEW_PLAYER_STARTING_SPINS, os.time()))
		end
	end

	return data
end

local function saveData(userId: number, data: { lastFreeSpinTime: number, purchasedSpins: number, dataVersion: number? })
	if not spinDataStore then return end
	pcall(function()
		spinDataStore:SetAsync("SpinWheel_" .. tostring(userId), {
			lastFreeSpinTime = data.lastFreeSpinTime,
			purchasedSpins = data.purchasedSpins,
			dataVersion = data.dataVersion or DATA_VERSION,
		})
	end)
end

local function getRandomSegment(): number?
	local segments = SpinWheelConfig.Segments
	if not segments or #segments == 0 then
		warn("[SpinWheelService] Segments table is nil or empty!")
		return nil
	end
	local totalWeight = 0
	for _, seg in ipairs(segments) do
		totalWeight = totalWeight + (seg.weight or seg.chance or 1)
	end
	if totalWeight <= 0 then return 1 end
	local roll = math.random() * totalWeight
	local cumulative = 0
	for i, seg in ipairs(segments) do
		cumulative = cumulative + (seg.weight or seg.chance or 1)
		if roll <= cumulative then
			return i
		end
	end
	return 1
end

local function clearPending(userId: number, reason: string?)
	local p = pendingSpin[userId]
	if p then
		pendingSpin[userId] = nil
		spinInProgress[userId] = nil
		if reason then
			log(string.format("PENDING CLEARED spinId=%s userId=%d reason=%s", p.spinId, userId, reason))
		end
	end
end

function SpinWheelService.Init()
	local pool = getFindableCrownPool()
	if #pool == 0 then
		warn("[SpinWheel] ERROR: Findable crown pool is EMPTY — check ReplicatedStorage.ItemModels.Crowns.Findable")
	else
		log(string.format("Findable crown pool ready (count=%d)", #pool))
		for _, entry in ipairs(pool) do
			log(string.format("  crown: %s (%s) image=%s", entry.name, entry.id, tostring(entry.image ~= "" and "yes" or "MISSING")))
		end
	end
	log("Initialized")
	if isUnlimitedSpinsEnabled() then
		log("DEBUG: Unlimited spins ENABLED")
	end
end

function SpinWheelService.OnPlayerJoined(player: Player)
	local data = loadData(player.UserId)
	playerCache[player.UserId] = data
	warn(string.format("[SPIN_AUDIT] player=%s userId=%d LOADED lastFreeSpin=%d purchasedSpins=%d ver=%d | t=%d",
		player.Name, player.UserId, data.lastFreeSpinTime, data.purchasedSpins, data.dataVersion, os.time()))
end

function SpinWheelService.OnPlayerLeaving(player: Player)
	local userId = player.UserId
	clearPending(userId, "PlayerLeaving")
	local data = playerCache[userId]
	if data then
		saveData(userId, data)
		playerCache[userId] = nil
		spinInProgress[userId] = nil
		log(player.Name .. " spin data saved")
	end
end

function SpinWheelService.GetPlayerData(player: Player): { freeSpinAvailable: boolean, nextFreeSpinTime: number, purchasedSpins: number }
	local data = playerCache[player.UserId]
	if not data then
		data = loadData(player.UserId)
		playerCache[player.UserId] = data
	end

	if isUnlimitedSpinsEnabled() then
		return {
			freeSpinAvailable = true,
			nextFreeSpinTime = 0,
			nextFreeSpinAt = 0,
			purchasedSpins = data.purchasedSpins,
		}
	end

	local now = os.time()
	local elapsed = now - data.lastFreeSpinTime
	local freeAvailable = elapsed >= SpinWheelConfig.FREE_SPIN_COOLDOWN
	local nextFreeTime = freeAvailable and 0 or (data.lastFreeSpinTime + SpinWheelConfig.FREE_SPIN_COOLDOWN - now)
	local absoluteNextFree = freeAvailable and 0 or (data.lastFreeSpinTime + SpinWheelConfig.FREE_SPIN_COOLDOWN)

	return {
		freeSpinAvailable = freeAvailable,
		nextFreeSpinTime = math.max(0, nextFreeTime),
		nextFreeSpinAt = absoluteNextFree,
		purchasedSpins = data.purchasedSpins,
	}
end

function SpinWheelService.RequestSpin(player: Player)
	log(string.format("RequestSpin from %s — validating...", player.Name))

	local userId = player.UserId

	if spinInProgress[userId] then
		return { success = false, reason = "Spin already in progress" }
	end
	if pendingSpin[userId] then
		return { success = false, reason = "Spin already in progress" }
	end

	local data = playerCache[userId]
	if not data then
		return { success = false, reason = "Data not loaded" }
	end

	local debugUnlimited = isUnlimitedSpinsEnabled()
	local now = os.time()
	local hasFree = (now - data.lastFreeSpinTime) >= SpinWheelConfig.FREE_SPIN_COOLDOWN
	local hasPurchased = data.purchasedSpins > 0

	if debugUnlimited then
		hasFree = true
		hasPurchased = true
	end

	if not hasFree and not hasPurchased then
		return { success = false, reason = "No spins available" }
	end

	spinInProgress[userId] = true

	local spinType = "free"
	if debugUnlimited then
		spinType = "debug"
	else
		if hasFree then
			data.lastFreeSpinTime = now
		else
			data.purchasedSpins = data.purchasedSpins - 1
			spinType = "purchased"
		end
	end

	warn(string.format("[SPIN_AUDIT] player=%s userId=%d SPIN_USED type=%s remainingPurchased=%d | t=%d",
		player.Name, userId, spinType, data.purchasedSpins, os.time()))

	local segIndex = getRandomSegment()
	local segment = segIndex and SpinWheelConfig.Segments[segIndex]

	if not segment then
		if spinType == "free" then
			data.lastFreeSpinTime = data.lastFreeSpinTime - SpinWheelConfig.FREE_SPIN_COOLDOWN
		elseif spinType == "purchased" then
			data.purchasedSpins = data.purchasedSpins + 1
		end
		spinInProgress[userId] = nil
		warn(string.format("[SpinWheelService] SPIN FAILED: segment %s is nil for %s — spin refunded",
			tostring(segIndex), player.Name))
		return { success = false, reason = "Spin failed — try again." }
	end

	local rewardType = segment.reward or "Coins"
	local rewardName = segment.name or "Unknown Reward"
	local coinsToAward = segment.amount or 0
	local catalogId = segment.catalogId
	local rarity = segment.rarity or "Common"
	local isDuplicate = false
	local resolvedWheelImage = nil

	local resolveOk, resolveErr = pcall(function()
		if rewardType == "Pet" and catalogId then
			local petInfo = ItemCatalog and ItemCatalog.GetPet and ItemCatalog.GetPet(catalogId)
			if petInfo then
				rewardName = petInfo.name .. " (" .. petInfo.rarity .. ")"
			end
		elseif rewardType == "Crown" then
			local crownId, crownName, crownRarity, crownIsDup, crownImage = pickRandomFindableCrown(player)
			if not crownId then
				error("pickRandomFindableCrown returned nil")
			end
			catalogId = crownId
			rewardName = crownName
			rarity = crownRarity
			isDuplicate = crownIsDup
			if crownImage and crownImage ~= "" then
				resolvedWheelImage = crownImage
			end
			if isDuplicate then
				coinsToAward = CROWN_DUPLICATE_COINS
			end
			log(string.format("[SpinWheel] Crown wedge -> selected=%s (%s) dup=%s image=%s",
				crownName, crownId, tostring(isDuplicate), tostring(resolvedWheelImage ~= nil)))
		end
	end)
	if not resolveOk then
		warn(string.format("[SpinWheelService] REWARD RESOLVE FAILED for %s: %s", player.Name, tostring(resolveErr)))
		if rewardType == "Crown" then
			if spinType == "free" then
				data.lastFreeSpinTime = data.lastFreeSpinTime - SpinWheelConfig.FREE_SPIN_COOLDOWN
			elseif spinType == "purchased" then
				data.purchasedSpins = data.purchasedSpins + 1
			end
			spinInProgress[userId] = nil
			warn(string.format("[SpinWheel] Crown wedge FAILED -> %s (spin NOT consumed)", tostring(resolveErr)))
			return { success = false, reason = "Reward failed to load \xe2\x80\x94 try again" }
		end
		rewardType = "Coins"
		rewardName = segment.name or "Coins"
		coinsToAward = math.max(segment.amount or 0, 100)
		catalogId = nil
	end

	local spinId = HttpService:GenerateGUID(false)
	local createdAt = os.time()
	local grantAtTime = createdAt + SPIN_DURATION_SECONDS

	pendingSpin[userId] = {
		spinId = spinId,
		segmentIndex = segIndex,
		rewardName = rewardName,
		rewardType = rewardType,
		coinsAwarded = coinsToAward,
		catalogId = catalogId,
		isDuplicate = isDuplicate,
		createdAt = createdAt,
		grantAtTime = grantAtTime,
	}

	if not debugUnlimited then
		task.spawn(function() saveData(userId, data) end)
	end

	task.delay(SPIN_DURATION_SECONDS, function()
		local pending = pendingSpin[userId]
		if not pending or pending.spinId ~= spinId then return end

		pendingSpin[userId] = nil

		local livePlayer = Players:GetPlayerByUserId(userId)
		if not livePlayer then
			spinInProgress[userId] = nil
			return
		end

		local rType = pending.rewardType or "Coins"
		local rCoins = pending.coinsAwarded or 0
		local rCatalog = pending.catalogId
		local rName = pending.rewardName or "Unknown"

		if type(rCoins) ~= "number" then rCoins = 0 end

		local grantOk, grantErr = pcall(function()
			if rType == "Pet" and rCatalog and rCatalog ~= "" then
				grantPet(livePlayer, rCatalog)
				log(string.format("GRANTED spinId=%s Pet %s to %s", spinId, rCatalog, livePlayer.Name))
			elseif rType == "Crown" and rCatalog and rCatalog ~= "" then
				if pending.isDuplicate then
					local GS = getGrantService()
					if GS and GS ~= false and type(GS.GrantItem) == "function" then
						local g = GS.GrantItem(livePlayer, "Currency", rCoins, "SpinWheel", {
							applyVipMultiplier = true,
							rewardSource = "SpinWheelDuplicateCrown:" .. tostring(rCatalog or "unknown"),
						})
						if not g.success then
							error("SpinWheel duplicate crown coin grant failed: " .. tostring(g.reason))
						end
					else
						error("GrantService unavailable for duplicate coin grant")
					end
					log(string.format("GRANTED spinId=%s Crown %s DUPLICATE to %s → +%d coins",
						spinId, rCatalog, livePlayer.Name, rCoins))
				else
					local GS = getGrantService()
					if GS and GS ~= false and type(GS.GrantItem) == "function" then
						local g = GS.GrantItem(livePlayer, "Crown", rCatalog, "SpinWheel")
						if not g.success then
							error("SpinWheel crown grant failed: " .. tostring(g.reason))
						end
					else
						error("GrantService unavailable for crown grant")
					end
					log(string.format("GRANTED spinId=%s Crown %s to %s", spinId, rCatalog, livePlayer.Name))
				end
			else
				local GS = getGrantService()
				if GS and GS ~= false and type(GS.GrantItem) == "function" then
					local g = GS.GrantItem(livePlayer, "Currency", rCoins, "SpinWheel", {
						applyVipMultiplier = true,
						rewardSource = "SpinWheel:" .. tostring(rName),
					})
					if not g.success then
						error("SpinWheel coin grant failed: " .. tostring(g.reason))
					end
				else
					error("GrantService unavailable for coin grant")
				end
				log(string.format("GRANTED spinId=%s %s to %s (+%d coins)",
					spinId, rName, livePlayer.Name, rCoins))
			end
		end)

		if not grantOk then
			warn(string.format("[SpinWheelService] GRANT FAILED spinId=%s player=%s err=%s",
				spinId, livePlayer.Name, tostring(grantErr)))
		end

		spinInProgress[userId] = nil
	end)

	return {
		success = true,
		segmentIndex = segIndex,
		rewardName = rewardName,
		rewardType = rewardType,
		coinsAwarded = coinsToAward,
		baseCoins = coinsToAward,
		catalogId = catalogId,
		rarity = rarity,
		isDuplicate = isDuplicate,
		wheelImage = resolvedWheelImage or (segment and segment.wheelImage) or "",
		spinId = spinId,
	}
end

function SpinWheelService.BuySpins(player: Player, packageIndex: number): { success: boolean, newSpinCount: number?, reason: string? }
	local data = playerCache[player.UserId]
	if not data then
		return { success = false, reason = "Data not loaded" }
	end

	local pkg = SpinWheelConfig.SpinPrices[packageIndex]
	if not pkg then
		return { success = false, reason = "Invalid package" }
	end

	local ES = getEconomyService()
	if ES and type(ES.DeductCoins) == "function" then
		local ok = ES.DeductCoins(player, pkg.coins, "BuySpins")
		if not ok then
			return { success = false, reason = "Not enough Fate Coins" }
		end
	else
		local currentCoins = player:GetAttribute("Coins") or 0
		if currentCoins < pkg.coins then
			return { success = false, reason = "Not enough Fate Coins" }
		end
		player:SetAttribute("Coins", currentCoins - pkg.coins)
	end

	local oldSpins = data.purchasedSpins
	data.purchasedSpins = data.purchasedSpins + pkg.spins

	task.spawn(function() saveData(player.UserId, data) end)

	warn(string.format("[SPIN_AUDIT] player=%s userId=%d BUY_SPINS pkg=%d cost=%d +%d spins | %d -> %d | t=%d",
		player.Name, player.UserId, packageIndex, pkg.coins, pkg.spins,
		oldSpins, data.purchasedSpins, os.time()))

	return {
		success = true,
		newSpinCount = data.purchasedSpins,
	}
end

function SpinWheelService.GrantRobuxSpins(player: Player, spinsToAdd: number): boolean
	local data = playerCache[player.UserId]
	if not data then
		warn("[SpinWheelService] GrantRobuxSpins failed — no cached data for", player.Name)
		return false
	end

	local oldSpins = data.purchasedSpins
	data.purchasedSpins = data.purchasedSpins + spinsToAdd

	task.spawn(function() saveData(player.UserId, data) end)

	warn(string.format("[SPIN_AUDIT] player=%s userId=%d GRANT_SPINS +%d | %d -> %d | t=%d",
		player.Name, player.UserId, spinsToAdd, oldSpins, data.purchasedSpins, os.time()))

	return true
end

function SpinWheelService.SaveAll()
	for userId, data in pairs(playerCache) do
		saveData(userId, data)
	end
	log("All spin data saved")
end

return SpinWheelService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="101">
        <Properties>
          <string name="Name">StatService</string>
          <string name="Source"><![CDATA[--[[
	StatService
	Server-authoritative stat calculation.

	Computes final player stats from:
	  • Base stats (Roblox defaults)
	  • Equipped pet modifiers  (additive speed/jump, multiplicative coins)
	  • Equipped crown modifiers (same)

	Stats are recalculated ONLY on equip / unequip — never per-frame.
	Server owns final stat values.

	API:
		Init()
		RecalculateStats(player)
		GetCoinMultiplier(player)  → number
		SetWalkSpeedOverride(player, key, value)
		ClearWalkSpeedOverride(player, key)
		SetTemporaryMovementBonus(player, key, bonus)
		ClearTemporaryMovementBonus(player, key)
		OnPlayerRemoving(player)
]]

local ReplicatedStorage   = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")
local MarketplaceService  = game:GetService("MarketplaceService")
local Players             = game:GetService("Players")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Server = ServerScriptService:WaitForChild("Server")

local PlayerDataService = require(Server:WaitForChild("PlayerDataService"))

local ItemCatalogModule = Shared:WaitForChild("ItemCatalog", 10)
local ItemCatalog
if ItemCatalogModule then
	local ok, mod = pcall(require, ItemCatalogModule)
	if ok then ItemCatalog = mod else warn("[StatService] ItemCatalog failed:", mod) end
end
if not ItemCatalog then
	warn("[StatService] ItemCatalog not found — stats will use base values only")
	ItemCatalog = { Get = function() return nil end }
end

local BundleCatalogModule = Shared:WaitForChild("BundleCatalog", 10)
local BundleCatalog
if BundleCatalogModule then
	local ok, mod = pcall(require, BundleCatalogModule)
	if ok then BundleCatalog = mod else warn("[StatService] BundleCatalog failed:", mod) end
end
if not BundleCatalog then
	warn("[StatService] BundleCatalog not found — VIP checks will fail")
end

local StatService = {}
local initialized = false

local DEBUG_LOG = true
local function log(...)
	if DEBUG_LOG then print("[StatService]", ...) end
end

local BASE_STATS = {
	WalkSpeed      = 18,
	JumpPower      = 50,
	CoinMultiplier = 1.0,
}
local VIP_COIN_MULTIPLIER = 1.5

local coinMultiplierCache: { [number]: number } = {}
local walkSpeedOverridesByUserId: { [number]: { [string]: number } } = {}
local temporaryMovementBonusesByUserId: { [number]: { [string]: { WalkSpeed: number?, JumpPower: number? } } } = {}
local vipOwnershipChecksInFlight: { [number]: boolean } = {}
local TUTORIAL_MOVEMENT_LOCK_ATTRIBUTE = "TutorialMovementLocked"

local function getItemStats(catalogCategory: string, itemId: string?): { [string]: number }?
	if not itemId or itemId == "" then return nil end
	local entry = ItemCatalog.Get(catalogCategory, itemId)
	if entry and type(entry.stats) == "table" then
		return entry.stats
	end
	return nil
end

local function getEffectiveWalkSpeed(baseWalkSpeed: number, userId: number): number
	local overrides = walkSpeedOverridesByUserId[userId]
	if not overrides then
		return baseWalkSpeed
	end
	local best = baseWalkSpeed
	local hasAny = false
	for _, value in pairs(overrides) do
		if type(value) == "number" then
			if not hasAny then
				best = value
				hasAny = true
			else
				best = math.min(best, value)
			end
		end
	end
	return hasAny and best or baseWalkSpeed
end

local function getTemporaryMovementBonusTotals(userId: number): (number, number)
	local bonuses = temporaryMovementBonusesByUserId[userId]
	if not bonuses then
		return 0, 0
	end

	local walkSpeedBonus = 0
	local jumpPowerBonus = 0
	for _, bonus in pairs(bonuses) do
		if type(bonus) == "table" then
			walkSpeedBonus += tonumber(bonus.WalkSpeed) or 0
			jumpPowerBonus += tonumber(bonus.JumpPower) or 0
		end
	end

	return walkSpeedBonus, jumpPowerBonus
end

local function isMovementTemporarilyLocked(player: Player, humanoid: Humanoid): boolean
	if player:GetAttribute(TUTORIAL_MOVEMENT_LOCK_ATTRIBUTE) == true then
		return true
	end
	local state = player:GetAttribute("PlayerState")
	if state ~= "InMatch" then
		return false
	end
	-- RoundManager freeze sets both to 0; avoid fighting that lock.
	return humanoid.WalkSpeed == 0 and humanoid.JumpPower == 0
end

local function getVipBundleGamepassId(): number?
	if not BundleCatalog then
		return nil
	end

	local vipBundle = nil
	if type(BundleCatalog.Get) == "function" then
		vipBundle = BundleCatalog.Get("bundle_vip")
	end
	if type(vipBundle) ~= "table" then
		vipBundle = BundleCatalog.bundle_vip
	end
	if type(vipBundle) ~= "table" then
		return nil
	end

	return tonumber(vipBundle.gamepassId)
end

local function checkVipOwnership(player: Player)
	StatService.RefreshVipOwnership(player, "PlayerAdded")
end

local function getPersistedVipBundleOwned(player: Player, data: { [string]: any }?): boolean
	if player:GetAttribute("VIPBundleOwned") == true then
		return true
	end

	local resolvedData = data or PlayerDataService.GetData(player)
	return resolvedData ~= nil and resolvedData.VIPBundleOwned == true
end

local function getEffectiveVipOwned(player: Player, data: { [string]: any }?): boolean
	return (player:GetAttribute("OwnsVIP") == true) or getPersistedVipBundleOwned(player, data)
end

function StatService.HasVipEntitlement(player: Player, data: { [string]: any }?): boolean
	if not player then
		return false
	end

	return getEffectiveVipOwned(player, data)
end

function StatService.SetVipOwnership(player: Player, ownsVip: boolean, source: string?)
	if not player or not player.Parent then
		return
	end

	local normalizedOwnsVip = ownsVip == true
	local data = PlayerDataService.GetData(player)
	local persistedBefore = getPersistedVipBundleOwned(player, data)

	if normalizedOwnsVip then
		player:SetAttribute("VIPBundleOwned", true)
		if PlayerDataService.IsLoaded(player) and data and data.VIPBundleOwned ~= true then
			PlayerDataService.SetField(player, "VIPBundleOwned", true)
		end
	end

	local effectiveVipOwned = normalizedOwnsVip or getPersistedVipBundleOwned(player, data)
	player:SetAttribute("OwnsVIP", effectiveVipOwned)
	log(string.format(
		"VIP entitlement sync player=%s source=%s marketVip=%s persistedBefore=%s persistedAfter=%s effectiveVip=%s dataLoaded=%s",
		player.Name,
		tostring(source or "unknown"),
		tostring(normalizedOwnsVip),
		tostring(persistedBefore),
		tostring(getPersistedVipBundleOwned(player, data)),
		tostring(effectiveVipOwned),
		tostring(PlayerDataService.IsLoaded(player))
	))

	if PlayerDataService.IsLoaded(player) then
		StatService.RecalculateStats(player)
	end
end

function StatService.RefreshVipOwnership(player: Player, source: string?): boolean
	local gamepassId = getVipBundleGamepassId()
	if not player or not player.Parent or not gamepassId or gamepassId <= 0 then
		return false
	end

	if vipOwnershipChecksInFlight[player.UserId] then
		return false
	end

	vipOwnershipChecksInFlight[player.UserId] = true
	task.spawn(function()
		local success, hasPass = pcall(function()
			return MarketplaceService:UserOwnsGamePassAsync(player.UserId, gamepassId)
		end)
		vipOwnershipChecksInFlight[player.UserId] = nil

		if not player or not player.Parent then
			return
		end

		if success then
			StatService.SetVipOwnership(player, hasPass == true, source or "RefreshVipOwnership")
			log(string.format("VIP verification player=%s source=%s vip=%s",
				player.Name, tostring(source or "RefreshVipOwnership"), tostring(hasPass == true)))
		else
			warn(string.format("[StatService] VIP check failed for %s: %s", player.Name, tostring(hasPass)))
		end
	end)

	return true
end

function StatService.Init()
	if initialized then return end
	initialized = true

	Players.PlayerAdded:Connect(function(player)
		checkVipOwnership(player)
	end)

	for _, player in ipairs(Players:GetPlayers()) do
		checkVipOwnership(player)
	end

	log("Initialized")
end

function StatService.RecalculateStats(player: Player)
	local data = PlayerDataService.GetData(player)
	if not data then return end

	local walkSpeed = BASE_STATS.WalkSpeed
	local jumpPower = BASE_STATS.JumpPower
	local coinMult  = BASE_STATS.CoinMultiplier

	local petStats = getItemStats("Pets", data.EquippedPet)
	if petStats then
		walkSpeed += (petStats.WalkSpeed or 0)
		jumpPower += (petStats.JumpPower or 0)
		coinMult  *= (petStats.CoinMultiplier or 1)
	end

	local crownStats = getItemStats("Crowns", data.EquippedCrown)
	if crownStats then
		walkSpeed += (crownStats.WalkSpeed or 0)
		jumpPower += (crownStats.JumpPower or 0)
		coinMult  *= (crownStats.CoinMultiplier or 1)
	end

	local vipPersisted = getPersistedVipBundleOwned(player, data)
	local vipOwned = getEffectiveVipOwned(player, data)
	if vipOwned and data.VIPBundleOwned ~= true then
		PlayerDataService.SetField(player, "VIPBundleOwned", true)
		vipPersisted = true
	end
	player:SetAttribute("VIPBundleOwned", vipPersisted)
	player:SetAttribute("OwnsVIP", vipOwned)
	if vipOwned then
		coinMult = coinMult * VIP_COIN_MULTIPLIER
	end

	walkSpeed = getEffectiveWalkSpeed(walkSpeed, player.UserId)
	local walkSpeedBonus, jumpPowerBonus = getTemporaryMovementBonusTotals(player.UserId)
	walkSpeed += walkSpeedBonus
	jumpPower += jumpPowerBonus

	coinMultiplierCache[player.UserId] = coinMult
	player:SetAttribute("CoinMultiplier", coinMult)

	local character = player.Character
	if character then
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			if isMovementTemporarilyLocked(player, humanoid) then
				log(string.format("%s stats deferred (movement lock active)", player.Name))
			else
				humanoid.UseJumpPower = true
				humanoid.WalkSpeed = walkSpeed
				humanoid.JumpPower = jumpPower
			end
		end
	end

	log(string.format("%s stats: WalkSpeed=%.1f JumpPower=%.1f CoinMult=%.2fx (VIP=%s persistedVIP=%s)",
		player.Name, walkSpeed, jumpPower, coinMult, tostring(vipOwned), tostring(vipPersisted)))
	if vipPersisted or vipOwned then
		warn(string.format("[VIPPersistence] player=%s vipBundleOwned=%s loaded=%s multiplier=%.2f",
			player.Name, tostring(vipPersisted), tostring(PlayerDataService.IsLoaded(player)), coinMult))
	end
end

function StatService.SetWalkSpeedOverride(player: Player, key: string, value: number)
	if type(key) ~= "string" or key == "" or type(value) ~= "number" then
		return
	end
	local userId = player.UserId
	local overrides = walkSpeedOverridesByUserId[userId]
	if not overrides then
		overrides = {}
		walkSpeedOverridesByUserId[userId] = overrides
	end
	overrides[key] = value
	log(string.format("%s WalkSpeed override set key=%s value=%.1f", player.Name, key, value))
	StatService.RecalculateStats(player)
end

function StatService.ClearWalkSpeedOverride(player: Player, key: string)
	if type(key) ~= "string" or key == "" then
		return
	end
	local userId = player.UserId
	local overrides = walkSpeedOverridesByUserId[userId]
	if not overrides then
		return
	end
	overrides[key] = nil
	if next(overrides) == nil then
		walkSpeedOverridesByUserId[userId] = nil
	end
	log(string.format("%s WalkSpeed override cleared key=%s", player.Name, key))
	StatService.RecalculateStats(player)
end

function StatService.SetTemporaryMovementBonus(player: Player, key: string, bonus: { WalkSpeed: number?, JumpPower: number? })
	if type(key) ~= "string" or key == "" or type(bonus) ~= "table" then
		return
	end

	local walkSpeed = tonumber(bonus.WalkSpeed)
	local jumpPower = tonumber(bonus.JumpPower)
	if walkSpeed == nil and jumpPower == nil then
		return
	end

	local userId = player.UserId
	local bonuses = temporaryMovementBonusesByUserId[userId]
	if not bonuses then
		bonuses = {}
		temporaryMovementBonusesByUserId[userId] = bonuses
	end

	bonuses[key] = {
		WalkSpeed = walkSpeed,
		JumpPower = jumpPower,
	}

	log(string.format(
		"%s temporary movement bonus set key=%s walk=%.1f jump=%.1f",
		player.Name,
		key,
		walkSpeed or 0,
		jumpPower or 0
	))
	StatService.RecalculateStats(player)
end

function StatService.ClearTemporaryMovementBonus(player: Player, key: string)
	if type(key) ~= "string" or key == "" then
		return
	end

	local userId = player.UserId
	local bonuses = temporaryMovementBonusesByUserId[userId]
	if not bonuses then
		return
	end

	bonuses[key] = nil
	if next(bonuses) == nil then
		temporaryMovementBonusesByUserId[userId] = nil
	end

	log(string.format("%s temporary movement bonus cleared key=%s", player.Name, key))
	StatService.RecalculateStats(player)
end

function StatService.GetCoinMultiplier(player: Player): number
	return coinMultiplierCache[player.UserId]
		or tonumber(player:GetAttribute("CoinMultiplier"))
		or BASE_STATS.CoinMultiplier
end

function StatService.GetVipRewardMultiplier(player: Player): number
	if not player then
		return 1
	end
	return getEffectiveVipOwned(player) and VIP_COIN_MULTIPLIER or 1
end

function StatService.OnPlayerRemoving(player: Player)
	coinMultiplierCache[player.UserId] = nil
	walkSpeedOverridesByUserId[player.UserId] = nil
	temporaryMovementBonusesByUserId[player.UserId] = nil
	vipOwnershipChecksInFlight[player.UserId] = nil
end

return StatService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="102">
        <Properties>
          <string name="Name">SwordSpawnService</string>
          <string name="Source"><![CDATA[--[[
	SwordSpawnService
	Server-side sword spawning during rounds 2-7.

	- Spawns immediately at round start (if below cap), then recurs every
	  SPAWN_INTERVAL_MIN–SPAWN_INTERVAL_MAX seconds while the round is active.
	- Hard cap: MAX_SWORDS_ALIVE uncollected pickups at once (no pileups).
	- Pickup is a hovering world model (client handles animation).
	- On collection: clone ClassicSword from ServerStorage into Backpack.
	- First kill with sword: +50 coins, sword removed immediately.
	- Swords auto-removed after 2 rounds or at round 8+.
	- All swords cleaned up on match end.

	Works in BOTH Normal and Brainrot modes.

	API:
		Init()
		OnRoundStart(roundNumber: number)
		OnRoundEnd()
		OnMatchEnd()
]]

local Players = game:GetService("Players")
local ServerStorage = game:GetService("ServerStorage")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local ServerScriptService = game:GetService("ServerScriptService")

local Server = ServerScriptService:WaitForChild("Server")
local MapManager = require(Server:WaitForChild("MapManager"))
local EconomyService = require(Server:WaitForChild("EconomyService"))
local StatService = require(Server:WaitForChild("StatService"))
local PlayerState = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("PlayerState"))
local PlayerStateService = require(Server:WaitForChild("PlayerStateService"))
local EliminationTracker = require(Server:WaitForChild("EliminationTracker"))

local MIN_SPAWN_ROUND = 2
local MAX_SPAWN_ROUND = 7
local SWORD_LIFESPAN_ROUNDS = 2
local KILL_BONUS = 50
local SOUND_ID = "rbxassetid://93965767748928"
local SWORD_WALKSPEED_OVERRIDE_KEY = "SwordHold"
local SWORD_WALKSPEED = 15

-- Spawn frequency: one attempt every SPAWN_INTERVAL_MIN–MAX seconds while a round is active
local SPAWN_INTERVAL_MIN = 16
local SPAWN_INTERVAL_MAX = 22
-- Hard cap: never have more than this many uncollected pickups in the world at once
local MAX_SWORDS_ALIVE = 1
-- Probability (0–1) that a sword spawns immediately when a round starts.
-- Combined with the per-round cap this keeps sword presence at ~40-60% of rounds.
local INITIAL_SPAWN_CHANCE = 0.50

local PICKUP_FOLDER_NAME = "SwordPickups"
local SPAWN_Y_OFFSET = 3.0
local EDGE_MARGIN = 6
local RAYCAST_HEIGHT = 80

local GLOW_FILL_COLOR = Color3.fromRGB(0, 200, 255)
local GLOW_FILL_TRANSPARENCY = 0.5
local GLOW_OUTLINE_COLOR = Color3.fromRGB(255, 255, 255)
local GLOW_OUTLINE_TRANSPARENCY = 0.1

local BEACON_HEIGHT = 50
local RING_DIAMETER = 8
local RING_COLOR = Color3.fromRGB(0, 200, 255)
local DENIED_COOLDOWN = 3

local _DQS = nil
local function getDQS()
	if _DQS ~= nil then return _DQS end
	local ok, mod = pcall(require, Server:FindFirstChild("DailyQuestService"))
	if ok and mod then _DQS = mod else _DQS = false end
	return _DQS
end

local _Feedback = nil
local function getFeedback()
	if _Feedback ~= nil then return _Feedback end
	local ok, mod = pcall(require, Server:FindFirstChild("MatchFeedbackService"))
	if ok and mod then _Feedback = mod else _Feedback = false end
	return _Feedback
end

local _PerkMatchEffectService = nil
local function getPerkMatchEffectService()
	if _PerkMatchEffectService ~= nil then
		return _PerkMatchEffectService
	end
	local ok, mod = pcall(require, Server:FindFirstChild("PerkMatchEffectService"))
	if ok and mod then
		_PerkMatchEffectService = mod
	else
		_PerkMatchEffectService = false
	end
	return _PerkMatchEffectService
end

local SwordSpawnService = {}

local initialized = false
local pickupsFolder: Folder? = nil
local touchConnections: { RBXScriptConnection } = {}

local activePickups: { { model: Model, spawnRound: number } } = {}
local swordHolders: { [Player]: { tool: Tool, spawnRound: number, deathConn: RBXScriptConnection?, unequippedConn: RBXScriptConnection? } } = {}

local swordSpawnedRemote: RemoteEvent? = nil
local swordDeniedCooldowns: { [number]: number } = {}
local fireSwordSpawnMatchAlert: (() -> ())? = nil

local _spawnLoopActive = false
local _currentRound = 0
-- Hard cap: at most one sword pickup spawns per round
local _swordsSpawnedThisRound = 0

local function log(...)
	print("[SwordSpawn]", ...)
end

local function isSpawnRoundAllowed(roundNumber: number): boolean
	return roundNumber >= MIN_SPAWN_ROUND and roundNumber <= MAX_SPAWN_ROUND
end

local function countActivePickups(): number
	local count = 0
	for _, entry in ipairs(activePickups) do
		if entry.model and entry.model.Parent then
			count += 1
		end
	end
	return count
end

local function getPickupsFolder(): Folder
	if pickupsFolder and pickupsFolder.Parent then return pickupsFolder end
	local existing = Workspace:FindFirstChild(PICKUP_FOLDER_NAME)
	if existing then
		pickupsFolder = existing
		return existing
	end
	local folder = Instance.new("Folder")
	folder.Name = PICKUP_FOLDER_NAME
	folder.Parent = Workspace
	pickupsFolder = folder
	return folder
end

local function clearPickupsFolder()
	local folder = Workspace:FindFirstChild(PICKUP_FOLDER_NAME)
	if folder then
		folder:Destroy()
		pickupsFolder = nil
	end
end

local function disconnectTouched()
	for _, conn in ipairs(touchConnections) do
		if conn.Connected then conn:Disconnect() end
	end
	touchConnections = {}
end

local function getRandomArenaPosition(): Vector3?
	local bounds = MapManager.GetActiveBounds()
	if not bounds then
		warn("[SwordSpawn] No active bounds available")
		return nil
	end

	local centerX = bounds.cframe.Position.X
	local centerZ = bounds.cframe.Position.Z
	local topY = bounds.topY

	local halfX = (bounds.sizeX / 2) - EDGE_MARGIN
	local halfZ = (bounds.sizeZ / 2) - EDGE_MARGIN
	halfX = math.max(halfX, 2)
	halfZ = math.max(halfZ, 2)

	local x = centerX + (math.random() * 2 - 1) * halfX
	local z = centerZ + (math.random() * 2 - 1) * halfZ

	local rayOrigin = Vector3.new(x, topY + RAYCAST_HEIGHT, z)
	local rayDir = Vector3.new(0, -(RAYCAST_HEIGHT * 2), 0)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local folder = Workspace:FindFirstChild(PICKUP_FOLDER_NAME)
	if folder then
		params.FilterDescendantsInstances = { folder }
	end

	local result = Workspace:Raycast(rayOrigin, rayDir, params)
	local y = result and (result.Position.Y + SPAWN_Y_OFFSET) or (topY + SPAWN_Y_OFFSET)
	return Vector3.new(x, y, z)
end

local function scheduleWalkSpeedRestore(player: Player, reason: string)
	local function stillHasSword(): boolean
		if swordHolders[player] then return true end
		local backpack = player:FindFirstChild("Backpack")
		if backpack then
			for _, item in ipairs(backpack:GetChildren()) do
				if item:IsA("Tool") and item.Name == "ClassicSword" then
					return true
				end
			end
		end
		local character = player.Character
		if character then
			for _, item in ipairs(character:GetChildren()) do
				if item:IsA("Tool") and item.Name == "ClassicSword" then
					return true
				end
			end
		end
		return false
	end

	task.spawn(function()
		for _ = 1, 32 do
			if not player.Parent then
				return
			end
			if stillHasSword() then
				return
			end
			local character = player.Character
			local humanoid = character and character:FindFirstChildOfClass("Humanoid")
			if humanoid and humanoid.Health > 0 then
				if humanoid.WalkSpeed == 0 and humanoid.JumpPower == 0 then
					task.wait(0.2)
					continue
				end
				StatService.RecalculateStats(player)
				log(string.format(
					"[SwordMoveGuard] player=%s swordRemoved=true walkSpeedRestored=true reason=%s",
					player.Name,
					reason
				))
				return
			end
			task.wait(0.2)
		end
	end)
end

local function removeSwordFromPlayer(player: Player)
	local data = swordHolders[player]
	if not data then return end

	if data.deathConn then
		data.deathConn:Disconnect()
	end
	if data.unequippedConn then
		data.unequippedConn:Disconnect()
	end

	if data.tool and data.tool.Parent then
		data.tool:Destroy()
	end

	if player.Parent then
		local backpack = player:FindFirstChild("Backpack")
		if backpack then
			for _, item in ipairs(backpack:GetChildren()) do
				if item:IsA("Tool") and item.Name == "ClassicSword" then
					item:Destroy()
				end
			end
		end
		local character = player.Character
		if character then
			for _, item in ipairs(character:GetChildren()) do
				if item:IsA("Tool") and item.Name == "ClassicSword" then
					item:Destroy()
				end
			end
		end
	end

	swordHolders[player] = nil
	StatService.ClearWalkSpeedOverride(player, SWORD_WALKSPEED_OVERRIDE_KEY)
	local perkService = getPerkMatchEffectService()
	if perkService and type(perkService.OnSwordStateChanged) == "function" then
		pcall(perkService.OnSwordStateChanged, player, false, "SwordRemoved")
	end
	scheduleWalkSpeedRestore(player, "SwordRemoved")
	log(string.format(
		"[SwordMoveGuard] player=%s swordRemoved=true walkSpeedOverrideCleared=true",
		player.Name
	))
	log(player.Name, "sword removed")
end

local function removeAllSwords()
	for player, _ in pairs(swordHolders) do
		removeSwordFromPlayer(player)
	end
	swordHolders = {}
end

local function playerHasSword(player: Player): boolean
	if swordHolders[player] then return true end
	local backpack = player:FindFirstChild("Backpack")
	if backpack then
		for _, item in ipairs(backpack:GetChildren()) do
			if item:IsA("Tool") and item.Name == "ClassicSword" then
				return true
			end
		end
	end
	local character = player.Character
	if character then
		for _, item in ipairs(character:GetChildren()) do
			if item:IsA("Tool") and item.Name == "ClassicSword" then
				return true
			end
		end
	end
	return false
end

local function onSwordKill(killer: Player, victim: Player)
	log(string.format("%s killed %s with sword! +%d coins", killer.Name, victim.Name, KILL_BONUS))
	local awardOk, awardedAmount = EconomyService.AwardRewardCoins(killer, KILL_BONUS, "SwordKill")
	if awardOk then
		EconomyService.TrackMatchCoins(killer, awardedAmount or 0)
	end
	removeSwordFromPlayer(killer)
	local dqs = getDQS()
	if dqs and dqs.OnSwordKill then pcall(dqs.OnSwordKill, killer) end
	local feedback = getFeedback()
	if feedback and feedback.OnSwordElimination then
		pcall(feedback.OnSwordElimination, killer, victim)
	end
end

local function giveSwordToPlayer(player: Player, spawnRound: number)
	local toolsFolder = ServerStorage:FindFirstChild("Tools")
	local template = toolsFolder and toolsFolder:FindFirstChild("ClassicSword")
	if not template then
		warn("[SwordSpawn] ClassicSword not found in ServerStorage.Tools")
		return
	end

	local clone = template:Clone()
	clone:SetAttribute("SwordSpawnRound", spawnRound)
	clone.CanBeDropped = false

	local backpack = player:FindFirstChild("Backpack")
	if backpack then
		clone.Parent = backpack
	end

	local deathConn: RBXScriptConnection? = nil
	local unequippedConn: RBXScriptConnection? = nil
	local character = player.Character
	if character then
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			-- Guard: sword must stay visibly equipped once picked up.
			humanoid:EquipTool(clone)

			unequippedConn = clone.Unequipped:Connect(function()
				local holder = swordHolders[player]
				if not holder or holder.tool ~= clone then return end
				if not player.Parent then return end
				local currentCharacter = player.Character
				if not currentCharacter then return end
				local currentHumanoid = currentCharacter:FindFirstChildOfClass("Humanoid")
				if not currentHumanoid or currentHumanoid.Health <= 0 then return end
				task.defer(function()
					local latest = swordHolders[player]
					if not latest or latest.tool ~= clone then return end
					if clone.Parent ~= currentCharacter then
						currentHumanoid:EquipTool(clone)
						log(string.format("%s sword re-equipped (hide guard)", player.Name))
					end
				end)
			end)

			deathConn = humanoid.Died:Connect(function()
				removeSwordFromPlayer(player)
			end)
		end
	end

	swordHolders[player] = {
		tool = clone,
		spawnRound = spawnRound,
		deathConn = deathConn,
		unequippedConn = unequippedConn,
	}
	StatService.SetWalkSpeedOverride(player, SWORD_WALKSPEED_OVERRIDE_KEY, SWORD_WALKSPEED)
	local perkService = getPerkMatchEffectService()
	if perkService and type(perkService.OnSwordStateChanged) == "function" then
		pcall(perkService.OnSwordStateChanged, player, true, "SwordAcquired")
	end
	log(string.format(
		"[SwordMoveGuard] player=%s swordAcquired=true walkSpeedOverride=%.1f",
		player.Name,
		SWORD_WALKSPEED
	))

	log(string.format("%s picked up sword (spawned round %d)", player.Name, spawnRound))
end

local function spawnSwordPickup(roundNumber: number)
	local spawnPos = getRandomArenaPosition()
	if not spawnPos then return end

	local toolsFolder = ServerStorage:FindFirstChild("Tools")
	local template = toolsFolder and toolsFolder:FindFirstChild("ClassicSword")
	if not template then
		warn("[SwordSpawn] ClassicSword not found in ServerStorage.Tools")
		return
	end

	local handleTemplate = template:FindFirstChild("Handle")
	if not handleTemplate then
		warn("[SwordSpawn] ClassicSword has no Handle")
		return
	end

	local pickupModel = Instance.new("Model")
	pickupModel.Name = "SwordPickup"

	local handleClone = handleTemplate:Clone()
	handleClone.Anchored = true
	handleClone.CanCollide = false
	handleClone.CFrame = CFrame.new(spawnPos) * CFrame.Angles(0, math.rad(math.random(0, 360)), 0)
	handleClone.Parent = pickupModel
	pickupModel.PrimaryPart = handleClone

	pickupModel:SetAttribute("SwordPickup", true)
	pickupModel:SetAttribute("SpawnRound", roundNumber)

	local highlight = Instance.new("Highlight")
	highlight.Name = "SwordGlow"
	highlight.Adornee = pickupModel
	highlight.FillColor = GLOW_FILL_COLOR
	highlight.FillTransparency = GLOW_FILL_TRANSPARENCY
	highlight.OutlineColor = GLOW_OUTLINE_COLOR
	highlight.OutlineTransparency = GLOW_OUTLINE_TRANSPARENCY
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.Parent = pickupModel

	local particles = Instance.new("ParticleEmitter")
	particles.Name = "SwordSparkle"
	particles.Color = ColorSequence.new(Color3.fromRGB(0, 200, 255), Color3.fromRGB(255, 255, 255))
	particles.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.3),
		NumberSequenceKeypoint.new(1, 0),
	})
	particles.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0),
		NumberSequenceKeypoint.new(1, 1),
	})
	particles.Lifetime = NumberRange.new(0.6, 1.2)
	particles.Rate = 8
	particles.Speed = NumberRange.new(1, 3)
	particles.SpreadAngle = Vector2.new(180, 180)
	particles.LightEmission = 0.8
	particles.LightInfluence = 0.3
	particles.Parent = handleClone

	local groundY = spawnPos.Y - SPAWN_Y_OFFSET

	local beaconAnchor = Instance.new("Part")
	beaconAnchor.Name = "BeaconAnchor"
	beaconAnchor.Anchored = true
	beaconAnchor.CanCollide = false
	beaconAnchor.Transparency = 1
	beaconAnchor.Size = Vector3.new(0.1, 0.1, 0.1)
	beaconAnchor.CFrame = CFrame.new(spawnPos.X, groundY + BEACON_HEIGHT, spawnPos.Z)
	beaconAnchor:SetAttribute("NoAnimate", true)
	beaconAnchor.Parent = pickupModel

	local attachBottom = Instance.new("Attachment")
	attachBottom.Name = "BeaconBottom"
	attachBottom.Parent = handleClone

	local attachTop = Instance.new("Attachment")
	attachTop.Name = "BeaconTop"
	attachTop.Parent = beaconAnchor

	local beam = Instance.new("Beam")
	beam.Name = "SwordBeacon"
	beam.Attachment0 = attachBottom
	beam.Attachment1 = attachTop
	beam.Color = ColorSequence.new(RING_COLOR, Color3.fromRGB(100, 240, 255))
	beam.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.3),
		NumberSequenceKeypoint.new(0.8, 0.6),
		NumberSequenceKeypoint.new(1, 1),
	})
	beam.LightEmission = 1
	beam.LightInfluence = 0
	beam.Width0 = 4
	beam.Width1 = 1
	beam.FaceCamera = true
	beam.Parent = pickupModel

	local ring = Instance.new("Part")
	ring.Name = "GroundRing"
	ring.Shape = Enum.PartType.Cylinder
	ring.Anchored = true
	ring.CanCollide = false
	ring.Size = Vector3.new(0.15, RING_DIAMETER, RING_DIAMETER)
	ring.CFrame = CFrame.new(spawnPos.X, groundY + 0.1, spawnPos.Z) * CFrame.Angles(0, 0, math.rad(90))
	ring.Material = Enum.Material.Neon
	ring.Color = RING_COLOR
	ring.Transparency = 0.3
	ring:SetAttribute("NoAnimate", true)
	ring.Parent = pickupModel

	local collected = false
	local conn = handleClone.Touched:Connect(function(hit)
		if collected then return end

		local character = hit.Parent
		if not character then return end
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if not humanoid or humanoid.Health <= 0 then return end

		local player = Players:GetPlayerFromCharacter(character)
		if not player then return end

		if playerHasSword(player) then
			local userId = player.UserId
			local now = tick()
			if not swordDeniedCooldowns[userId] or (now - swordDeniedCooldowns[userId]) >= DENIED_COOLDOWN then
				swordDeniedCooldowns[userId] = now
				if swordSpawnedRemote then
					swordSpawnedRemote:FireClient(player, { denied = true })
				end
			end
			return
		end

		collected = true
		pickupModel:Destroy()

		giveSwordToPlayer(player, roundNumber)
	end)
	table.insert(touchConnections, conn)

	pickupModel.Parent = getPickupsFolder()

	_swordsSpawnedThisRound += 1
	table.insert(activePickups, { model = pickupModel, spawnRound = roundNumber })

	log(string.format(
		"Sword pickup spawned at (%.0f, %.0f, %.0f) for round %d (round total: %d)",
		spawnPos.X, spawnPos.Y, spawnPos.Z, roundNumber, _swordsSpawnedThisRound
	))

	if swordSpawnedRemote then
		fireSwordSpawnMatchAlert()
	end
end

local function cleanupExpiredSwords(currentRound: number)
	local remaining = {}
	for _, entry in ipairs(activePickups) do
		if currentRound >= entry.spawnRound + SWORD_LIFESPAN_ROUNDS then
			if entry.model and entry.model.Parent then
				entry.model:Destroy()
				log(string.format("Expired pickup from round %d (now round %d)", entry.spawnRound, currentRound))
			end
		else
			table.insert(remaining, entry)
		end
	end
	activePickups = remaining

	for player, data in pairs(swordHolders) do
		if currentRound >= data.spawnRound + SWORD_LIFESPAN_ROUNDS then
			log(string.format(
				"Expired sword from %s (spawned round %d, now round %d)",
				player.Name, data.spawnRound, currentRound
			))
			removeSwordFromPlayer(player)
		end
	end
end

local function onAnyPlayerDied(victim: Player)
	local character = victim.Character
	if not character then return end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then return end

	local creatorTag = humanoid:FindFirstChild("creator")
	if not creatorTag or not creatorTag:IsA("ObjectValue") then return end

	local killer = creatorTag.Value
	if not killer or not killer:IsA("Player") then return end

	if PlayerStateService.GetState(victim) ~= PlayerState.States.InMatch then
		return
	end
	if EliminationTracker.IsEliminated(victim) then
		log(string.format("[ElimSkip] player=%s skippedCause=Sword reason=already_eliminated", victim.Name))
		return
	end

	local round = math.max(_currentRound, 1)
	EliminationTracker.RecordElimination(victim, round, "Sword", killer)
	PlayerStateService.SetState(victim, PlayerState.States.Lobby)

	local aliveCount = #PlayerStateService.GetPlayersInState(PlayerState.States.InMatch)
	log(string.format("[SwordElim] killer=%s victim=%s authoritative=true", killer.Name, victim.Name))
	log(string.format("[RoundAlive] aliveCount=%d", aliveCount))
	if aliveCount <= 1 then
		log("[RoundEnd] triggerCause=SwordFinalKill")
	end

	onSwordKill(killer, victim)
end

fireSwordSpawnMatchAlert = function()
	if not swordSpawnedRemote then
		return
	end
	local recipients = {}
	local recipientNames = {}
	for _, player in ipairs(Players:GetPlayers()) do
		local state = PlayerStateService.GetState(player)
		if state == PlayerState.States.InMatch then
			table.insert(recipients, player)
			table.insert(recipientNames, player.Name)
		else
			log(string.format("[MatchAlertSkip] player=%s state=%s reason=not_in_match", player.Name, tostring(state)))
		end
	end
	for _, player in ipairs(recipients) do
		swordSpawnedRemote:FireClient(player, {
			soundId = SOUND_ID,
			matchOnly = true,
			alertType = "SwordSpawn",
		})
	end
	log(string.format(
		"[MatchAlert] type=SwordSpawn recipients=%s",
		(#recipientNames > 0) and table.concat(recipientNames, ",") or "none"
	))
	local feedback = getFeedback()
	if feedback and feedback.OnSwordSpawn then
		pcall(feedback.OnSwordSpawn, recipients)
	end
end

function SwordSpawnService.Init()
	if initialized then return end
	initialized = true

	local remotesFolder = ReplicatedStorage:FindFirstChild("Remotes")
	if not remotesFolder then
		remotesFolder = Instance.new("Folder")
		remotesFolder.Name = "Remotes"
		remotesFolder.Parent = ReplicatedStorage
	end

	local existing = remotesFolder:FindFirstChild("SwordSpawned")
	if not existing then
		swordSpawnedRemote = Instance.new("RemoteEvent")
		swordSpawnedRemote.Name = "SwordSpawned"
		swordSpawnedRemote.Parent = remotesFolder
	else
		swordSpawnedRemote = existing
	end

	local function hookPlayer(player: Player)
		player.CharacterAdded:Connect(function(character)
			local humanoid = character:WaitForChild("Humanoid", 10)
			if humanoid then
				humanoid.Died:Connect(function()
					onAnyPlayerDied(player)
				end)
			end
		end)
		if player.Character then
			local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
			if humanoid then
				humanoid.Died:Connect(function()
					onAnyPlayerDied(player)
				end)
			end
		end
	end

	for _, player in ipairs(Players:GetPlayers()) do
		hookPlayer(player)
	end
	Players.PlayerAdded:Connect(hookPlayer)

	Players.PlayerRemoving:Connect(function(player)
		if swordHolders[player] then
			removeSwordFromPlayer(player)
		end
		swordDeniedCooldowns[player.UserId] = nil
	end)

	log(string.format("Initialized — interval=%d–%ds, maxAlive=%d, initialChance=%.0f%%",
		SPAWN_INTERVAL_MIN, SPAWN_INTERVAL_MAX, MAX_SWORDS_ALIVE, INITIAL_SPAWN_CHANCE * 100))
end

function SwordSpawnService.OnRoundStart(roundNumber: number)
	cleanupExpiredSwords(roundNumber)

	-- Stop any loop from the previous round before setting new state
	_spawnLoopActive = false
	_currentRound = roundNumber
	_swordsSpawnedThisRound = 0

	if not isSpawnRoundAllowed(roundNumber) then
		if roundNumber < MIN_SPAWN_ROUND then
			log(string.format("Round %d < %d — skipping sword spawns for opening round", roundNumber, MIN_SPAWN_ROUND))
		else
			log(string.format("Round %d > %d — force removing all swords", roundNumber, MAX_SPAWN_ROUND))
		end
		removeAllSwords()
		clearPickupsFolder()
		disconnectTouched()
		activePickups = {}
		return
	end

	-- 50% chance of an immediate spawn at round start (prevents swords every single round)
	if math.random() < INITIAL_SPAWN_CHANCE and countActivePickups() < MAX_SWORDS_ALIVE then
		spawnSwordPickup(roundNumber)
	else
		log(string.format("Round %d: skipping initial spawn (chance or cap)", roundNumber))
	end

	-- Periodic loop: one attempt every 16–22 s, capped at 1 sword total per round
	_spawnLoopActive = true
	task.spawn(function()
		while _spawnLoopActive and _currentRound == roundNumber do
			local interval = SPAWN_INTERVAL_MIN + math.random() * (SPAWN_INTERVAL_MAX - SPAWN_INTERVAL_MIN)
			task.wait(interval)
			if not _spawnLoopActive or _currentRound ~= roundNumber then break end
			if _swordsSpawnedThisRound >= 1 then
				log(string.format("Round %d: per-round cap reached — no further spawns", roundNumber))
				break
			end
			local alive = countActivePickups()
			if alive < MAX_SWORDS_ALIVE then
				spawnSwordPickup(roundNumber)
			else
				log(string.format("Round %d: %d/%d swords active — skipping periodic spawn", roundNumber, alive, MAX_SWORDS_ALIVE))
			end
		end
		log(string.format("Spawn loop ended for round %d", roundNumber))
	end)
end

function SwordSpawnService.OnRoundEnd()
	_spawnLoopActive = false
	for _, entry in ipairs(activePickups) do
		if entry.model and entry.model.Parent then
			entry.model:Destroy()
			log(string.format("Round ended — despawned unpicked sword from round %d", entry.spawnRound))
		end
	end
	activePickups = {}
end

function SwordSpawnService.OnMatchEnd()
	_spawnLoopActive = false
	removeAllSwords()
	clearPickupsFolder()
	disconnectTouched()
	activePickups = {}
	log("Match ended — all swords cleaned up")
end

function SwordSpawnService.PlayerHasSword(player: Player): boolean
	return playerHasSword(player)
end

return SwordSpawnService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="103">
        <Properties>
          <string name="Name">TungTungSahurService</string>
          <string name="Source"><![CDATA[--[[
	TungTungSahurService
	Server-side hazard: TungTungSahur NPC for "Brainrot" mode, rounds 2-6.

	Attack model:
	  - Distance-based: NPC chases player, performs a real arm-swing when within
	    AttackRange studs.
	  - Arm swing uses Motor6D.C0 tweening (RightShoulder + RightElbow) — always
	    visible regardless of animation-asset availability. Since Animator writes
	    to Motor6D.Transform and this code tweens Motor6D.C0, there is no
	    conflict; the effects are additive.
	  - Damage = 55 per hit (two hits to kill a 100-HP player).
	  - On lethal hit: records via EliminationTracker (fires KillFeedEvent
	    internally) and transitions player → Lobby to prevent OOB double-kill.

	Despawn rules:
	  - ONLY despawns when:
	      1) 30-second timer reaches 0
	      2) Round 6 ends (if spawned during round 6)
	      3) Match ends
	  - Does NOT despawn on other round transitions.

	API:
		Init()
		OnRoundStart(roundNumber, mode)
		OnRoundEnd(roundNumber)
		OnMatchEnd()
		OnFreezeBegin()
		OnFreezeEnd()
]]

local Players             = game:GetService("Players")
local ReplicatedStorage   = game:GetService("ReplicatedStorage")
local TweenService        = game:GetService("TweenService")
local Workspace           = game:GetService("Workspace")
local ServerScriptService = game:GetService("ServerScriptService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Server = ServerScriptService:WaitForChild("Server")

local PlayerState        = require(Shared:WaitForChild("PlayerState"))
local PlayerStateService = require(Server:WaitForChild("PlayerStateService"))

-- Lazy-load EliminationTracker to avoid circular dependency at require time
local _EliminationTracker = nil
local function getEliminationTracker()
	if _EliminationTracker then return _EliminationTracker end
	pcall(function()
		local et = Server:FindFirstChild("EliminationTracker")
		if et then _EliminationTracker = require(et) end
	end)
	return _EliminationTracker
end

-- --- CONFIG -------------------------------------------------------------------
local Config = {
	Enabled         = true,
	SpawnChance     = 0.70,
	SpawnChanceAfterFirstMultiplier = 0.4, -- reduce re-spawn odds after first spawn in a match
	DurationSeconds = 30,
	RoundsAllowed   = {2, 3, 4, 5, 6},
	Damage          = 55,    -- per hit; two hits to kill a 100-HP player
	WalkSpeed       = 26,    -- noticeably faster than a running player (default 16)
	AttackRange     = 5,     -- studs: distance that triggers a swing
	AttackResolveRange = 6.0, -- studs: guaranteed close-range kill handoff radius
	AttackProximityFallbackRange = 6.5, -- studs: per-tick radial fallback so overlap always resolves
	AttackCooldown  = 1.25,  -- seconds between attacks on same player
	ChaseInterval   = 0.2,   -- re-evaluate target every 0.2s (logic still throttles MoveTo calls)
	RepathInterval  = 0.45,  -- minimum interval between MoveTo updates
	RepathTargetMoveDelta = 4.0, -- or when target moved this far since last MoveTo
	AttackDisengageRange = 6.5, -- hysteresis to avoid rapid chase/attack flipping
	-- Lunge: speed burst when player is within LungeRange studs
	LungeRange      = 12,    -- studs: triggers lunge
	LungeCooldown   = 3.0,   -- seconds between lunges
	LungeSpeed      = 55,    -- WalkSpeed during lunge burst
	LungeDuration   = 0.6,   -- seconds lunge lasts
	-- Contact damage: applied when a player physically touches the NPC body
	ContactDamage   = 30,    -- damage per body-touch event
	ContactCooldown = 0.8,   -- cooldown per player to prevent rapid stacking
	-- Arm-swing phases (seconds): total = ArmWindup + ArmSwing + ArmRecovery
	ArmWindup       = 0.10,
	ArmSwing        = 0.12,
	ArmRecovery     = 0.20,
	WalkAnimId      = "rbxassetid://507777826",
	FreezeDanceAnimIds = {
		"rbxassetid://507771019",
		"rbxassetid://507776043",
		"rbxassetid://507777268",
	},
	NpcFolderName   = "TungTungSahurNPC",
	RemoteName      = "TungTungSahurEvent",
	-- Brainrot-only NPC presentation + obstacle jump tuning
	BrainrotScale   = 1.85,  -- clear visual size increase for Save a Brainrot
	ObstacleJumpEnabled = true,
	ObstacleJumpCooldown = 1.2,
	ObstacleProbeDistance = 6.0,
	ObstacleProbeHeights = { 1.2, 2.6, 4.0 }, -- multi-height forward probes for varied obstacle heights
	ObstacleBlockedForwardSpeedThreshold = 2.2, -- forward speed considered "stuck"
	ObstacleBlockedChecksRequired = 2,   -- require repeated obstruction checks
	ObstacleBlockedResetSeconds = 0.8,
	ObstacleJumpPower = 72,
	ObstacleMinStepHeight = 1.1,         -- ignore tiny edges/steps
	ObstacleMaxJumpHeight = 7.5,         -- ignore very tall blockers for jump trigger
	-- Close-range anti-jitter tuning
	CloseRangeHoldEnterDistance = 6.5,   -- enter close-hold when within this range
	CloseRangeHoldExitDistance = 8.0,    -- exit hold only after this distance (hysteresis)
	ChaseStandOffDistance = 4.2,         -- keep pressure without pushing into target center
	CloseRangeNoJumpDistance = 8.0,      -- blocked-path jump disabled near target
	StateLogInterval = 0.8,              -- throttle debug state logs
}

-- --- INTERNAL STATE -----------------------------------------------------------
local initialized  = false
local active       = false
local frozen       = false
local spawnRound   = 0
local currentRound = 0
local npcModel:    Model?                  = nil
local chaseThread: thread?                = nil
local timerThread: thread?                = nil
local healthConn:  RBXScriptConnection?   = nil
local moveToConn:  RBXScriptConnection?   = nil
local walkTrack:   AnimationTrack?        = nil
local freezeDanceTrack: AnimationTrack?   = nil
local hitDebounce:     {[number]: number} = {}
local contactDebounce: {[number]: number} = {}
local contactConns:    {RBXScriptConnection} = {}
local lastLungeTick:   number = 0
local npcFolder:   Folder?               = nil
local eventRemote: RemoteEvent?          = nil
local killFeedRemote: RemoteEvent?       = nil
local hasSpawnedThisMatch: boolean       = false
local spawnCountThisMatch: number        = 0
local lastObstacleJumpAt: number         = 0
local lastBlockedObstacleKey: string?    = nil
local blockedObstacleChecks: number      = 0
local lastBlockedCheckAt: number         = 0

local TungTungSahurService = {}

-- --- HELPERS ------------------------------------------------------------------

local function log(...)
	print("[TungTungSahur]", ...)
end

local function isRoundAllowed(round: number): boolean
	for _, r in ipairs(Config.RoundsAllowed) do
		if r == round then return true end
	end
	return false
end

local function getOrCreateNpcFolder(): Folder
	if npcFolder and npcFolder.Parent then return npcFolder end
	npcFolder = Workspace:FindFirstChild(Config.NpcFolderName)
	if not npcFolder then
		npcFolder = Instance.new("Folder")
		npcFolder.Name   = Config.NpcFolderName
		npcFolder.Parent = Workspace
	end
	return npcFolder
end

-- Returns the nearest InMatch alive player, or nil if none.
local function getNearestPlayer(): Player?
	if not npcModel or not npcModel.PrimaryPart then return nil end
	local npcPos     = npcModel.PrimaryPart.Position
	local nearest: Player? = nil
	local nearestDist      = math.huge
	for _, player in ipairs(Players:GetPlayers()) do
		local ok, state = pcall(function() return PlayerStateService.GetState(player) end)
		if not ok or state ~= PlayerState.States.InMatch then continue end
		local char = player.Character
		if not char then continue end
		local hrp = char:FindFirstChild("HumanoidRootPart")
		if not hrp then continue end
		local hum = char:FindFirstChildOfClass("Humanoid")
		if not hum or hum.Health <= 0 then continue end
		local dist = (hrp.Position - npcPos).Magnitude
		if dist < nearestDist then
			nearestDist = dist
			nearest     = player
		end
	end
	return nearest
end

-- --- WALK ANIMATION -----------------------------------------------------------

local function getAnimator(): Animator?
	if not npcModel then return nil end
	local humanoid = npcModel:FindFirstChildOfClass("Humanoid")
	if not humanoid then return nil end
	local animator = humanoid:FindFirstChildOfClass("Animator")
	if not animator then
		animator        = Instance.new("Animator")
		animator.Parent = humanoid
	end
	return animator
end

local function startWalkAnim()
	if not npcModel then return end
	local animator = getAnimator()
	if not animator then return end
	if walkTrack then
		pcall(function() walkTrack:Stop() end)
		walkTrack = nil
	end
	local anim          = Instance.new("Animation")
	anim.AnimationId    = Config.WalkAnimId
	local ok, track     = pcall(function() return animator:LoadAnimation(anim) end)
	anim:Destroy()
	if ok and track then
		walkTrack        = track
		walkTrack.Looped = true
		walkTrack:Play()
	else
		warn("[TungTungSahur] Walk animation failed:", tostring(track))
	end
end

local function stopWalkAnim()
	if walkTrack then
		pcall(function() walkTrack:Stop() end)
		walkTrack = nil
	end
end

local function stopFreezeDanceAnim(reason: string?)
	if freezeDanceTrack then
		pcall(function()
			freezeDanceTrack:Stop(0.18)
		end)
		freezeDanceTrack = nil
		log(string.format("[TTS FreezeDance] stopped reason=%s", tostring(reason or "unspecified")))
	end
end

local function startFreezeDanceAnim()
	if not npcModel or not frozen then
		return
	end
	local animator = getAnimator()
	if not animator then
		warn("[TungTungSahur] Freeze dance start skipped: missing animator")
		return
	end

	stopFreezeDanceAnim("replace_existing")
	local danceIds = Config.FreezeDanceAnimIds or {}
	if #danceIds == 0 then
		return
	end

	local animationId = danceIds[math.random(1, #danceIds)]
	local animation = Instance.new("Animation")
	animation.AnimationId = animationId
	local okLoad, trackOrErr = pcall(function()
		return animator:LoadAnimation(animation)
	end)
	animation:Destroy()
	if not okLoad or not trackOrErr then
		warn(string.format("[TungTungSahur] Freeze dance failed to load: %s", tostring(trackOrErr)))
		return
	end

	local track: AnimationTrack = trackOrErr
	track.Priority = Enum.AnimationPriority.Action
	track.Looped = true
	local okPlay, playErr = pcall(function()
		track:Play(0.12, 1, 1)
	end)
	if not okPlay then
		warn(string.format("[TungTungSahur] Freeze dance failed to play: %s", tostring(playErr)))
		return
	end

	freezeDanceTrack = track
	log(string.format("[TTS FreezeDance] started animationId=%s", animationId))
end

-- --- ATTACK ANIMATION (Motor6D arm swing) ------------------------------------
--[[
	playAttackAnim()
	Drives RightShoulder + RightElbow Motor6D.C0 to produce a visible club-swing.
	Animator writes to Motor6D.Transform; this code tweens Motor6D.C0 — the two
	are additive, so they do NOT conflict.

	To avoid the walk animation competing visually during the swing,
	stopWalkAnim() is called first and startWalkAnim() restarts after recovery.

	Timeline relative to playAttackAnim() call:
	  0.00s               → Wind-up begins  (arm raises back)
	  ArmWindup           → Swing begins    (arm swings down)
	  ArmWindup+ArmSwing  → IMPACT          (damage applied by caller)
	  ...+ArmRecovery     → Arm back to rest, walk restarts
]]
local function playAttackAnim()
	if frozen then return end
	if not npcModel then return end

	local shoulder = npcModel:FindFirstChild("RightShoulder", true)
	if not (shoulder and shoulder:IsA("Motor6D")) then return end
	local elbow = npcModel:FindFirstChild("RightElbow", true)
	if not (elbow   and elbow:IsA("Motor6D"))   then elbow = nil end

	-- Pause walk so the walk animation Transform doesn't visually fight C0 tween
	stopWalkAnim()

	local origS = shoulder.C0
	local origE = elbow and elbow.C0

	-- Phase 1: Wind-up — raise arm up and back
	TweenService:Create(shoulder, TweenInfo.new(Config.ArmWindup, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		C0 = origS * CFrame.Angles(-math.rad(85), 0, math.rad(15)),
	}):Play()
	if elbow and origE then
		TweenService:Create(elbow, TweenInfo.new(Config.ArmWindup, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			C0 = origE * CFrame.Angles(math.rad(45), 0, 0),
		}):Play()
	end

	-- Phase 2: Swing down to impact
	task.delay(Config.ArmWindup, function()
		if not shoulder or not shoulder.Parent then return end
		TweenService:Create(shoulder, TweenInfo.new(Config.ArmSwing, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
			C0 = origS * CFrame.Angles(math.rad(55), 0, -math.rad(10)),
		}):Play()
		if elbow and origE then
			TweenService:Create(elbow, TweenInfo.new(Config.ArmSwing, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
				C0 = origE * CFrame.Angles(-math.rad(35), 0, 0),
			}):Play()
		end

		-- Phase 3: Recovery — return to rest, restart walk
		task.delay(Config.ArmSwing, function()
			if not shoulder or not shoulder.Parent then return end
			TweenService:Create(shoulder, TweenInfo.new(Config.ArmRecovery, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				C0 = origS,
			}):Play()
			if elbow and origE then
				TweenService:Create(elbow, TweenInfo.new(Config.ArmRecovery, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
					C0 = origE,
				}):Play()
			end
			task.delay(Config.ArmRecovery, function()
				if active and not frozen then startWalkAnim() end
			end)
		end)
	end)
end

-- --- NAMEPLATE ----------------------------------------------------------------

local function setupNameplate()
	if not npcModel then return end
	local rootPart = npcModel.PrimaryPart or npcModel:FindFirstChild("HumanoidRootPart")
	if not rootPart then return end

	local humanoid = npcModel:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	end

	for _, desc in ipairs(npcModel:GetDescendants()) do
		if desc:IsA("BillboardGui") then desc:Destroy() end
	end

	local billboard          = Instance.new("BillboardGui")
	billboard.Name           = "TungTungNameplate"
	billboard.Size           = UDim2.new(0, 200, 0, 32)
	billboard.StudsOffset    = Vector3.new(0, 2.8, 0)
	billboard.AlwaysOnTop    = true
	billboard.Enabled        = true
	billboard.MaxDistance    = 80
	billboard.ResetOnSpawn   = false
	billboard.Parent         = rootPart

	local label                     = Instance.new("TextLabel")
	label.Name                      = "NameLabel"
	label.AnchorPoint               = Vector2.new(0.5, 0.5)
	label.Position                  = UDim2.new(0.5, 0, 0.5, 0)
	label.Size                      = UDim2.new(1, 0, 1, 0)
	label.BackgroundTransparency    = 1
	label.Font                      = Enum.Font.GothamBold
	label.Text                      = "TungTungSahur"
	label.TextColor3                = Color3.fromRGB(255, 80, 80)
	label.TextSize                  = 16
	label.TextScaled                = false
	label.TextXAlignment            = Enum.TextXAlignment.Center
	label.Parent                    = billboard

	local stroke             = Instance.new("UIStroke")
	stroke.Color             = Color3.fromRGB(50, 0, 0)
	stroke.Thickness         = 2
	stroke.Transparency      = 0.3
	stroke.Parent            = label

	log("[TTS Nameplate] default hidden, custom active")
end

local function applyBrainrotScale()
	if not npcModel then return end
	local scale = Config.BrainrotScale or 1
	if scale <= 1 then return end

	local appliedWithModelScale = false
	local okScale, errScale = pcall(function()
		npcModel:ScaleTo(scale)
		appliedWithModelScale = true
	end)
	if not okScale then
		warn("[TungTungSahur] Model:ScaleTo failed, using fallback part scaling:", tostring(errScale))
	end

	-- Fallback for rigs/templates that do not respond reliably to ScaleTo at runtime.
	if not appliedWithModelScale then
		for _, desc in ipairs(npcModel:GetDescendants()) do
			if desc:IsA("BasePart") then
				desc.Size = desc.Size * scale
			end
		end
	end

	-- Do NOT scale HipHeight directly; that can create hover/floating behavior.

	local reportedScale = 0
	local okGetScale, gotScale = pcall(function()
		return npcModel:GetScale()
	end)
	if okGetScale and type(gotScale) == "number" then
		reportedScale = gotScale
	end
	log(string.format(
		"[TTS Scale] applied mode=Brainrot requested=%.2f reported=%.2f method=%s",
		scale, reportedScale, appliedWithModelScale and "ScaleTo" or "FallbackParts"
	))
end

local function isHumanoidGrounded(hum: Humanoid): boolean
	if hum.FloorMaterial == Enum.Material.Air then
		return false
	end
	local st = hum:GetState()
	if st == Enum.HumanoidStateType.Jumping
		or st == Enum.HumanoidStateType.Freefall
		or st == Enum.HumanoidStateType.FallingDown
	then
		return false
	end
	return true
end

local function getCharacterOwnerFromPart(part: Instance?): Player?
	if not part then return nil end
	local model = part:FindFirstAncestorOfClass("Model")
	if not model then return nil end
	return Players:GetPlayerFromCharacter(model)
end

local function maybeJumpObstacle(hum: Humanoid, targetPos: Vector3, distToTarget: number?)
	if not Config.ObstacleJumpEnabled then return end
	if not npcModel or not npcModel.PrimaryPart then return end
	if distToTarget and distToTarget <= Config.CloseRangeNoJumpDistance then
		lastBlockedObstacleKey = nil
		blockedObstacleChecks = 0
		return
	end
	local now = tick()
	if (now - lastObstacleJumpAt) < Config.ObstacleJumpCooldown then
		return
	end
	if not isHumanoidGrounded(hum) then
		log(string.format("[TTS Obstacle] jump request blocked state=airborne dist=%.2f",
			(distToTarget or -1)))
		return
	end

	local root = npcModel.PrimaryPart
	local toTarget = targetPos - root.Position
	local flatToTarget = Vector3.new(toTarget.X, 0, toTarget.Z)
	local flatDistance = flatToTarget.Magnitude
	if flatDistance < 1 then return end

	local direction = flatToTarget.Unit
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { npcModel }

	local hit = nil
	for _, probeY in ipairs(Config.ObstacleProbeHeights) do
		local origin = root.Position + Vector3.new(0, probeY, 0)
		local r = Workspace:Raycast(origin, direction * Config.ObstacleProbeDistance, params)
		if r and r.Instance then
			hit = r
			break
		end
	end

	if not hit or not hit.Instance then
		lastBlockedObstacleKey = nil
		blockedObstacleChecks = 0
		return
	end

	local owner = getCharacterOwnerFromPart(hit.Instance)
	if owner then
		log(string.format("[TTS Obstacle] player obstruction ignored player=%s part=%s",
			owner.Name, hit.Instance.Name))
		lastBlockedObstacleKey = nil
		blockedObstacleChecks = 0
		return
	end

	if hit.Instance:IsA("BasePart") and not hit.Instance.CanCollide then
		return
	end

	local blockerClass = hit.Instance.ClassName
	local blockerType = "world_geometry"
	local obstacleHeight = 0
	local rootBottomY = root.Position.Y - (root.Size.Y * 0.5)
	if hit.Instance:IsA("BasePart") then
		local topY = hit.Instance.Position.Y + (hit.Instance.Size.Y * 0.5)
		obstacleHeight = topY - rootBottomY
	end
	if obstacleHeight > 0 and obstacleHeight < Config.ObstacleMinStepHeight then
		log(string.format(
			"[TTS Obstacle] ignored type=%s class=%s reason=trivial_height obstacleHeight=%.2f",
			blockerType, blockerClass, obstacleHeight
		))
		return
	end
	if obstacleHeight > Config.ObstacleMaxJumpHeight then
		log(string.format(
			"[TTS Obstacle] ignored type=%s class=%s reason=too_tall obstacleHeight=%.2f",
			blockerType, blockerClass, obstacleHeight
		))
		return
	end

	local forwardSpeed = Vector3.new(root.AssemblyLinearVelocity.X, 0, root.AssemblyLinearVelocity.Z):Dot(direction)
	local obstacleKey = string.format("%s|%s", hit.Instance:GetFullName(), hit.Instance.ClassName)
	if (now - lastBlockedCheckAt) > Config.ObstacleBlockedResetSeconds or lastBlockedObstacleKey ~= obstacleKey then
		blockedObstacleChecks = 0
	end
	lastBlockedCheckAt = now
	lastBlockedObstacleKey = obstacleKey
	blockedObstacleChecks += 1

	log(string.format(
		"[TTS Obstacle] detected type=%s part=%s class=%s checks=%d forwardSpeed=%.2f obstacleHeight=%.2f grounded=%s",
		blockerType, hit.Instance.Name, blockerClass, blockedObstacleChecks, forwardSpeed, obstacleHeight,
		tostring(isHumanoidGrounded(hum))
	))

	if blockedObstacleChecks < Config.ObstacleBlockedChecksRequired then
		return
	end
	if forwardSpeed > Config.ObstacleBlockedForwardSpeedThreshold then
		return
	end

	hum.UseJumpPower = true
	hum.JumpPower = math.max(hum.JumpPower, Config.ObstacleJumpPower)
	hum.Jump = true
	hum:ChangeState(Enum.HumanoidStateType.Jumping)
	lastObstacleJumpAt = now
	blockedObstacleChecks = 0
	log(string.format("[TTS Obstacle] jump triggered over=%s jumpPower=%.1f",
		hit.Instance.Name, hum.JumpPower))
end

-- --- CLEANUP ------------------------------------------------------------------

local function cancelThread(t: thread?)
	if t then pcall(task.cancel, t) end
end

local function disconnectAll()
	cancelThread(chaseThread)
	cancelThread(timerThread)
	chaseThread = nil
	timerThread = nil
	if moveToConn then
		pcall(function() moveToConn:Disconnect() end)
		moveToConn = nil
	end
	if healthConn then
		pcall(function() healthConn:Disconnect() end)
		healthConn = nil
	end
end

local _DQS = nil
local function getDQS()
	if _DQS ~= nil then return _DQS end
	local ok, mod = pcall(require, Server:FindFirstChild("DailyQuestService"))
	if ok and mod then _DQS = mod else _DQS = false end
	return _DQS
end

local function fireMatchOnlyEvent(action: string, extraArg: any, alertType: string)
	if not eventRemote then
		return
	end
	local recipients = {}
	local recipientNames = {}
	for _, player in ipairs(Players:GetPlayers()) do
		local ok, state = pcall(function()
			return PlayerStateService.GetState(player)
		end)
		if ok and state == PlayerState.States.InMatch then
			table.insert(recipients, player)
			table.insert(recipientNames, player.Name)
		else
			log(string.format("[MatchAlertSkip] player=%s state=%s reason=not_in_match", player.Name, tostring(state)))
		end
	end
	for _, player in ipairs(recipients) do
		eventRemote:FireClient(player, action, extraArg)
	end
	log(string.format(
		"[MatchAlert] type=%s recipients=%s",
		alertType,
		(#recipientNames > 0) and table.concat(recipientNames, ",") or "none"
	))
end

local function fireCleanupEventAll(action: string, extraArg: any, alertType: string)
	if not eventRemote then
		return
	end
	local recipients = {}
	for _, player in ipairs(Players:GetPlayers()) do
		table.insert(recipients, player.Name)
		eventRemote:FireClient(player, action, extraArg)
	end
	log(string.format(
		"[TungCleanup] reason=%s activeBefore=true timerStopped=true npcDespawned=true uiHidden=true recipients=%s",
		alertType,
		(#recipients > 0) and table.concat(recipients, ",") or "none"
	))
end

local function despawn(reason: string)
	if not active then return end
	active = false
	frozen = false
	log("Despawning:", reason)

	disconnectAll()
	stopWalkAnim()
	stopFreezeDanceAnim("despawn")
	hitDebounce    = {}
	contactDebounce = {}
	lastLungeTick  = 0
	lastObstacleJumpAt = 0
	lastBlockedObstacleKey = nil
	blockedObstacleChecks = 0
	lastBlockedCheckAt = 0

	if npcModel and npcModel.Parent then
		npcModel:Destroy()
	end
	npcModel = nil

	-- Despawn/cleanup must reach everyone, including players already moved out of InMatch,
	-- so stale countdown UI cannot persist into results/lobby.
	fireCleanupEventAll("Despawn", reason == "timer", "TungTungSahurDespawn")

	-- Quest: reward all alive InMatch players when TTS ends due timer OR round-6 cleanup.
	if reason == "timer" or reason == "round6" then
		local dqs = getDQS()
		if dqs and dqs.OnTTSSurvive then
			for _, player in ipairs(Players:GetPlayers()) do
				local ok2, state = pcall(function() return PlayerStateService.GetState(player) end)
				if ok2 and state == PlayerState.States.InMatch then
					local char = player.Character
					local hum  = char and char:FindFirstChildOfClass("Humanoid")
					if hum and hum.Health > 0 then
						pcall(dqs.OnTTSSurvive, player)
					end
				end
			end
		end
	end

	log("Despawn complete -- reason:", reason)
end

-- --- HIT / ELIMINATION --------------------------------------------------------
local function eliminateVictim(player: Player, humanoid: Humanoid, source: string)
	if humanoid.Health > 0 then
		humanoid.Health = 0
	end

	local et = getEliminationTracker()
	if et then
		et.RecordElimination(player, currentRound, "TungTungSahur")
	else
		if killFeedRemote then
			killFeedRemote:FireAllClients(player.Name, "TungTungSahur")
		end
		warn("[TungTungSahur] EliminationTracker unavailable for", player.Name)
	end
	-- Transition BEFORE character can respawn so OOB loop won't kill them again
	PlayerStateService.SetState(player, PlayerState.States.Lobby)
	log(string.format("[TTS Kill] source=%s victim=%s round=%d", source, player.Name, currentRound))
end

local function applyHitDamage(player: Player, humanoid: Humanoid, source: string)
	if humanoid.Health <= 0 then
		return
	end

	local damage = Config.Damage
	if source == "ContactTouch" then
		damage = Config.ContactDamage
	end
	damage = math.max(1, tonumber(damage) or 1)

	local before = humanoid.Health
	humanoid:TakeDamage(damage)
	local after = humanoid.Health
	log(string.format("[TTS Hit] source=%s target=%s damage=%d health=%.1f->%.1f",
		source, player.Name, damage, before, after))

	if after <= 0 then
		eliminateVictim(player, humanoid, source)
	end
end

local function tryResolveCloseRangeKill(target: Player, source: string, maxRange: number?): boolean
	if not active then
		log(string.format("[TTS AttackRejected] source=%s reason=npc_inactive", source))
		return false
	end
	if frozen then
		log(string.format("[TTS AttackRejected] source=%s reason=npc_frozen", source))
		return false
	end
	if not target or not target.Parent then
		log(string.format("[TTS AttackRejected] source=%s reason=target_missing", source))
		return false
	end
	local okState, state = pcall(function()
		return PlayerStateService.GetState(target)
	end)
	if not okState or state ~= PlayerState.States.InMatch then
		log(string.format("[TTS AttackRejected] source=%s target=%s reason=invalid_state state=%s",
			source, target.Name, tostring(state)))
		return false
	end
	local char = target.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hum or hum.Health <= 0 or not hrp then
		log(string.format("[TTS AttackRejected] source=%s target=%s reason=target_not_alive_or_missing_parts",
			source, target.Name))
		return false
	end
	if not npcModel or not npcModel.PrimaryPart then
		log(string.format("[TTS AttackRejected] source=%s target=%s reason=npc_missing_primary", source, target.Name))
		return false
	end
	local dist = (hrp.Position - npcModel.PrimaryPart.Position).Magnitude
	if maxRange and dist > maxRange then
		log(string.format("[TTS AttackRejected] source=%s target=%s reason=out_of_range dist=%.2f max=%.2f",
			source, target.Name, dist, maxRange))
		return false
	end

	local uid = target.UserId
	local now = tick()
	local last = hitDebounce[uid]
	if last and (now - last) < Config.AttackCooldown then
		log(string.format("[TTS AttackRejected] source=%s target=%s reason=debounce remaining=%.2f",
			source, target.Name, Config.AttackCooldown - (now - last)))
		return false
	end
	hitDebounce[uid] = now

	log(string.format("[TTS AttackAttempt] source=%s target=%s dist=%.2f", source, target.Name, dist))
	applyHitDamage(target, hum, source)
	return true
end

local function tryResolveAnyNearbyVictim(maxRange: number, source: string): boolean
	if not active or frozen then
		return false
	end
	if not npcModel or not npcModel.PrimaryPart then
		return false
	end
	local npcPos = npcModel.PrimaryPart.Position
	local bestTarget: Player? = nil
	local bestDist = math.huge

	for _, player in ipairs(Players:GetPlayers()) do
		local okState, state = pcall(function()
			return PlayerStateService.GetState(player)
		end)
		if not okState or state ~= PlayerState.States.InMatch then
			continue
		end
		local char = player.Character
		if not char then continue end
		local hum = char:FindFirstChildOfClass("Humanoid")
		local hrp = char:FindFirstChild("HumanoidRootPart")
		if not hum or hum.Health <= 0 or not hrp then
			continue
		end
		local dist = (hrp.Position - npcPos).Magnitude
		if dist <= maxRange and dist < bestDist then
			bestDist = dist
			bestTarget = player
		end
	end

	if not bestTarget then
		return false
	end

	log(string.format("[TTS ProximityFallback] target=%s dist=%.2f range=%.2f",
		bestTarget.Name, bestDist, maxRange))
	return tryResolveCloseRangeKill(bestTarget, source, maxRange)
end

--[[
	applyHit(player, humanoid)
	  - Deals Config.Damage (55) per hit.
	  - On lethal hit: records via EliminationTracker (fires KillFeedEvent
	    internally with "TungTungSahur" reason) and moves player → Lobby to
	    prevent OOB double-kill on auto-respawn.
	  - On non-lethal hit: just damages, no state change.
]]
local function applyHit(player: Player, humanoid: Humanoid)
	applyHitDamage(player, humanoid, "LegacyApplyHit")
end

-- --- SWORD IMMUNITY -----------------------------------------------------------

local function setupSwordImmunity()
	if not npcModel then return end
	local humanoid = npcModel:FindFirstChildOfClass("Humanoid")
	if not humanoid then return end

	humanoid.MaxHealth = 10000
	humanoid.Health    = 10000

	healthConn = humanoid.HealthChanged:Connect(function(hp: number)
		if hp < humanoid.MaxHealth then
			humanoid.Health = humanoid.MaxHealth
		end
	end)
	log("Sword immunity active (MaxHealth=10000)")
end

-- --- CONTACT DAMAGE (anti-cheese: touching NPC body deals damage) --------------
local function setupContactDamage()
	if not npcModel then return end
	for _, c in ipairs(contactConns) do pcall(function() c:Disconnect() end) end
	contactConns = {}
	contactDebounce = {}
	local partCount = 0
	for _, part in ipairs(npcModel:GetDescendants()) do
		if part:IsA("BasePart") then
			partCount += 1
			local conn = part.Touched:Connect(function(hit)
				if not active or frozen then return end
				local char = hit.Parent
				if not char or char == npcModel then return end
				local player = Players:GetPlayerFromCharacter(char)
				if not player then return end
				local ok2, state = pcall(function() return PlayerStateService.GetState(player) end)
				if not ok2 or state ~= PlayerState.States.InMatch then return end
				local hum = char:FindFirstChildOfClass("Humanoid")
				if not hum or hum.Health <= 0 then return end
				local uid = player.UserId
				local now = tick()
				if contactDebounce[uid] and (now - contactDebounce[uid]) < Config.ContactCooldown then return end
				contactDebounce[uid] = now
				tryResolveCloseRangeKill(player, "ContactTouch", nil)
			end)
			table.insert(contactConns, conn)
		end
	end
	log(string.format("Contact damage wired to %d parts (cooldown=%.1fs dmg=%d)", partCount, Config.ContactCooldown, Config.ContactDamage))
end

-- --- CHASE + ATTACK LOOP ------------------------------------------------------
local function startChaseLoop()
	cancelThread(chaseThread)
	if moveToConn then
		pcall(function() moveToConn:Disconnect() end)
		moveToConn = nil
	end
	lastLungeTick = 0

	chaseThread = task.spawn(function()
		local lunging = false
		local lastMoveToAt = 0
		local lastMoveToTargetPos: Vector3? = nil
		local inAttackRange = false
		local previousInAttackRange = false
		local inCloseHold = false
		local movementState = "Idle"
		local lastStateLogAt = 0
		local lastTargetUserId: number? = nil

		local hum = npcModel and npcModel:FindFirstChildOfClass("Humanoid")

		while active and npcModel and npcModel.Parent do
			if not frozen then
				-- Fallback: if anyone is physically in kill radius, resolve immediately.
				-- This prevents overlap/touch timing gaps where NPC appears to walk on a player.
				if tryResolveAnyNearbyVictim(Config.AttackProximityFallbackRange, "ProximityFallback") then
					task.wait(Config.ChaseInterval)
					continue
				end

				local target = getNearestPlayer()
				if target and target.Character and npcModel and npcModel.PrimaryPart then
					if lastTargetUserId ~= target.UserId then
						lastTargetUserId = target.UserId
						log(string.format("[TTS TargetAcquired] target=%s", target.Name))
					end
					local hrp = target.Character:FindFirstChild("HumanoidRootPart")
					if hrp then
						hum = npcModel:FindFirstChildOfClass("Humanoid")
						if hum and hum.Health > 0 then
							local dist = (hrp.Position - npcModel.PrimaryPart.Position).Magnitude

							if dist <= Config.AttackRange then
								inAttackRange = true
							elseif dist >= Config.AttackDisengageRange then
								inAttackRange = false
							end

							if inAttackRange then
								if not previousInAttackRange then
									log(string.format("[TTS AttackRangeEntered] target=%s dist=%.2f range=%.2f",
										target.Name, dist, Config.AttackResolveRange))
								end
								movementState = "AttackHold"
								-- Melee attack
								lunging = false
								local now  = tick()
								-- Stop issuing movement while in attack hold (anti-jitter near target).
								hum:Move(Vector3.zero, false)
								if (now - lastMoveToAt) >= Config.RepathInterval then
									hum:MoveTo(npcModel.PrimaryPart.Position)
									lastMoveToAt = now
									lastMoveToTargetPos = nil
								end
								if tryResolveCloseRangeKill(target, "AttackRangeHandoff", Config.AttackResolveRange) then
									hum.WalkSpeed = 0
									playAttackAnim()
									if active and not frozen and npcModel then
										local hum3 = npcModel:FindFirstChildOfClass("Humanoid")
										if hum3 then hum3.WalkSpeed = Config.WalkSpeed end
									end
								end
							else
								-- Chase with stand-off target to prevent close-range shove jitter.
								local now = tick()
								local toTarget = hrp.Position - npcModel.PrimaryPart.Position
								local chaseTargetPos = hrp.Position
								if toTarget.Magnitude > 0.01 then
									chaseTargetPos = hrp.Position - toTarget.Unit * Config.ChaseStandOffDistance
								end

								if inCloseHold then
									if dist >= Config.CloseRangeHoldExitDistance then
										inCloseHold = false
									end
								else
									if dist <= Config.CloseRangeHoldEnterDistance then
										inCloseHold = true
									end
								end

								if inCloseHold then
									movementState = "CloseHold"
									lunging = false
									hum.WalkSpeed = Config.WalkSpeed
									hum:Move(Vector3.zero, false)
									if (now - lastMoveToAt) >= Config.RepathInterval then
										hum:MoveTo(npcModel.PrimaryPart.Position)
										lastMoveToAt = now
									end
									lastMoveToTargetPos = nil
									if (now - lastStateLogAt) >= Config.StateLogInterval then
										lastStateLogAt = now
										log(string.format(
											"[TTS Move] state=%s dist=%.2f grounded=%s blockedKey=%s repathAge=%.2f",
											movementState, dist, tostring(isHumanoidGrounded(hum)), tostring(lastBlockedObstacleKey), now - lastMoveToAt
										))
									end
									task.wait(Config.ChaseInterval)
									continue
								end

								-- Chase — trigger lunge only when not in close approach range.
								if not lunging
									and dist <= Config.LungeRange
									and dist > (Config.CloseRangeHoldEnterDistance + 1.0)
									and (now - lastLungeTick) >= Config.LungeCooldown
								then
									lastLungeTick = now
									lunging = true
									movementState = "Lunge"
									hum.WalkSpeed = Config.LungeSpeed
									log(string.format("[TTS] Lunge! dist=%.1f studs", dist))
									task.delay(Config.LungeDuration, function()
										lunging = false
										if active and not frozen and npcModel then
											local h = npcModel:FindFirstChildOfClass("Humanoid")
											if h then h.WalkSpeed = Config.WalkSpeed end
										end
									end)
								elseif not lunging then
									movementState = "Chase"
									hum.WalkSpeed = Config.WalkSpeed
								end
								local shouldRepath = false
								if (now - lastMoveToAt) >= Config.RepathInterval then
									shouldRepath = true
								elseif lastMoveToTargetPos and (chaseTargetPos - lastMoveToTargetPos).Magnitude >= Config.RepathTargetMoveDelta then
									shouldRepath = true
								elseif not lastMoveToTargetPos then
									shouldRepath = true
								end

								if shouldRepath then
									local repathAge = now - lastMoveToAt
									hum:MoveTo(chaseTargetPos)
									lastMoveToAt = now
									lastMoveToTargetPos = chaseTargetPos
									if (now - lastStateLogAt) >= Config.StateLogInterval then
										lastStateLogAt = now
										log(string.format(
											"[TTS Move] state=%s dist=%.2f grounded=%s moveToIssued=true moveTo=(%.1f,%.1f,%.1f) repathAge=%.2f",
											movementState, dist, tostring(isHumanoidGrounded(hum)), chaseTargetPos.X, chaseTargetPos.Y, chaseTargetPos.Z, repathAge
										))
									end
								end
								maybeJumpObstacle(hum, chaseTargetPos, dist)
							end
							previousInAttackRange = inAttackRange
						end
					end
				end
			end
			task.wait(Config.ChaseInterval)
		end
	end)
end

-- --- DURATION TIMER -----------------------------------------------------------

local function startDurationTimer()
	cancelThread(timerThread)
	timerThread = task.spawn(function()
		task.wait(Config.DurationSeconds)
		if active then despawn("timer") end
	end)
end

-- --- SPAWN --------------------------------------------------------------------

local function spawnNpc(roundNumber: number)
	if active then
		log("Already active -- skipping spawn")
		return
	end

	local assets   = ReplicatedStorage:FindFirstChild("Assets")
	local hazards  = assets  and assets:FindFirstChild("Hazards")
	local template = hazards and hazards:FindFirstChild("TungTungSahur")
	if not template then
		warn("[TungTungSahur] Template not found at ReplicatedStorage.Assets.Hazards.TungTungSahur")
		return
	end

	local clone = template:Clone()

	for _, scriptName in ipairs({"Chase", "Manager", "Script"}) do
		local s = clone:FindFirstChild(scriptName)
		if s and (s:IsA("Script") or s:IsA("LocalScript")) then
			s.Enabled = false
		end
	end

	clone:SetAttribute("IsTungTungSahur", true)

	local spawnCF = CFrame.new(0, 8, 0)
	local ok, MapManager = pcall(function()
		return require(Server:WaitForChild("MapManager", 5))
	end)
	if ok and MapManager then
		local spawnFrames = MapManager.GetArenaSpawnCFrames(1)
		if spawnFrames and spawnFrames[1] then
			spawnCF = spawnFrames[1] * CFrame.new(0, 3, 0)
		end
	end

	clone:PivotTo(spawnCF)
	clone.Parent  = getOrCreateNpcFolder()
	npcModel      = clone
	active        = true
	frozen        = false
	spawnRound    = roundNumber
	hitDebounce   = {}

	log(string.format("NPC spawned for round %d at (%.0f, %.0f, %.0f)",
		roundNumber, spawnCF.Position.X, spawnCF.Position.Y, spawnCF.Position.Z))

	applyBrainrotScale()
	setupSwordImmunity()
	setupNameplate()
	startWalkAnim()
	startChaseLoop()
	startDurationTimer()

	fireMatchOnlyEvent("Spawn", Config.DurationSeconds, "TungTungSahurSpawn")
end

-- --- PUBLIC API ---------------------------------------------------------------

function TungTungSahurService.Init()
	if initialized then return end

	local remotes = ReplicatedStorage:FindFirstChild("Remotes")
	if not remotes then
		remotes        = Instance.new("Folder")
		remotes.Name   = "Remotes"
		remotes.Parent = ReplicatedStorage
	end

	local existing = remotes:FindFirstChild(Config.RemoteName)
	if existing and existing:IsA("RemoteEvent") then
		eventRemote = existing
	else
		eventRemote        = Instance.new("RemoteEvent")
		eventRemote.Name   = Config.RemoteName
		eventRemote.Parent = remotes
	end

	killFeedRemote = remotes:FindFirstChild("KillFeedEvent")
	if not killFeedRemote then
		task.spawn(function()
			killFeedRemote = remotes:WaitForChild("KillFeedEvent", 15)
		end)
	end

	initialized = true
	log(string.format(
		"Initialized -- enabled=%s chance=%.0f%% duration=%ds rounds=%s",
		tostring(Config.Enabled),
		Config.SpawnChance * 100,
		Config.DurationSeconds,
		table.concat((function()
			local t = {}
			for _, r in ipairs(Config.RoundsAllowed) do table.insert(t, tostring(r)) end
			return t
		end)(), ",")
	))
end

function TungTungSahurService.OnRoundStart(roundNumber: number, mode: string)
	if not initialized then return end
	currentRound = roundNumber  -- always track, even when TTS doesn't spawn
	if roundNumber <= 1 then
		-- Safety reset in case match teardown callback was skipped.
		hasSpawnedThisMatch = false
		spawnCountThisMatch = 0
	end
	if not Config.Enabled then return end
	if mode ~= "Brainrot" then return end
	if not isRoundAllowed(roundNumber) then
		log(string.format("Round %d: not in allowed list -- skip spawn", roundNumber))
		return
	end

	local spawnChance = Config.SpawnChance
	if hasSpawnedThisMatch then
		spawnChance = spawnChance * Config.SpawnChanceAfterFirstMultiplier
	end

	local roll = math.random()
	if roll >= spawnChance then
		log(string.format(
			"Round %d: roll %.2f >= %.2f -- spawn skipped (spawnedBefore=%s count=%d)",
			roundNumber,
			roll,
			spawnChance,
			tostring(hasSpawnedThisMatch),
			spawnCountThisMatch
		))
		return
	end

	log(string.format(
		"Round %d: roll %.2f < %.2f -- spawning! (spawnedBefore=%s count=%d)",
		roundNumber,
		roll,
		spawnChance,
		tostring(hasSpawnedThisMatch),
		spawnCountThisMatch
	))
	hasSpawnedThisMatch = true
	spawnCountThisMatch += 1
	spawnNpc(roundNumber)
end

--[[
	OnRoundEnd(roundNumber)
	ONLY despawns if round 6 is ending. Earlier spawns persist until 30s timer.
]]
function TungTungSahurService.OnRoundEnd(roundNumber: number)
	if not initialized then return end
	if not active then return end

	if roundNumber == 6 then
		log(string.format("Round 6 ended -- force despawning TTS (spawned in round %d)", spawnRound))
		despawn("round6")
	else
		log(string.format("Round %d ended -- TTS remains active (spawned round %d, timer still running)", roundNumber, spawnRound))
	end
end

function TungTungSahurService.OnMatchEnd()
	if not initialized then return end
	if active then despawn("match") end
	hasSpawnedThisMatch = false
	spawnCountThisMatch = 0
end

function TungTungSahurService.OnFreezeBegin()
	if not active or frozen then return end
	if currentRound <= 0 then return end
	frozen = true
	log(string.format("[SaveTheBrainrot] freeze_started round=%d", currentRound))

	if npcModel then
		local hum = npcModel:FindFirstChildOfClass("Humanoid")
		if hum then
			hum.WalkSpeed = 0
			hum:MoveTo(hum.RootPart and hum.RootPart.Position or npcModel.PrimaryPart.Position)
		end
	end

	stopWalkAnim()
	startFreezeDanceAnim()
end

function TungTungSahurService.OnFreezeEnd()
	if not active or not frozen then return end
	frozen = false
	log(string.format("[SaveTheBrainrot] freeze_ended round=%d", currentRound))

	if npcModel then
		local hum = npcModel:FindFirstChildOfClass("Humanoid")
		if hum then hum.WalkSpeed = Config.WalkSpeed end
	end

	stopFreezeDanceAnim("freeze_end")
	startWalkAnim()
end

return TungTungSahurService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="104">
        <Properties>
          <string name="Name">TutorialService</string>
          <string name="Source"><![CDATA[--[[
	TutorialService
	Server-side onboarding persistence bridge for the first-join tutorial.

	API:
	  Init()              -> create remotes and wire handlers
	  GetStatus(player)   -> { dataLoaded: boolean, tutorialCompleted: boolean }
	  Acknowledge(player) -> marks completion and saves immediately
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Server = ServerScriptService:WaitForChild("Server")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local PlayerState = require(Shared:WaitForChild("PlayerState"))

local TutorialService = {}

local initialized = false
local acknowledgeLocks: { [number]: boolean } = {}
local characterConnections: { [Player]: RBXScriptConnection } = {}

local TUTORIAL_MOVEMENT_LOCK_ATTRIBUTE = "TutorialMovementLocked"
local TUTORIAL_COMPLETED_ATTRIBUTE = "TutorialCompleted"

local _playerDataService = nil
local _playerStateService = nil
local _statService = nil

local function getPlayerDataService()
	if _playerDataService then
		return _playerDataService
	end

	local ok, mod = pcall(require, Server:WaitForChild("PlayerDataService", 5))
	if ok and mod then
		_playerDataService = mod
	end

	return _playerDataService
end

local function getPlayerStateService()
	if _playerStateService then
		return _playerStateService
	end

	local ok, mod = pcall(require, Server:WaitForChild("PlayerStateService", 5))
	if ok and mod then
		_playerStateService = mod
	end

	return _playerStateService
end

local function getStatService()
	if _statService then
		return _statService
	end

	local ok, mod = pcall(require, Server:WaitForChild("StatService", 5))
	if ok and mod then
		_statService = mod
	end

	return _statService
end

local function log(...)
	print("[TutorialService]", ...)
end

local function getHumanoid(player: Player): Humanoid?
	local character = player.Character
	if not character then
		return nil
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		return humanoid
	end

	local descendant = character:FindFirstChild("Humanoid", true)
	if descendant and descendant:IsA("Humanoid") then
		return descendant
	end
	return nil
end

local function applyMovementLock(player: Player)
	local humanoid = getHumanoid(player)
	if not humanoid then
		return
	end

	humanoid.UseJumpPower = true
	humanoid.WalkSpeed = 0
	humanoid.JumpPower = 0
	humanoid.JumpHeight = 0

	local rootPart = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if rootPart and rootPart:IsA("BasePart") then
		rootPart.AssemblyLinearVelocity = Vector3.zero
		rootPart.AssemblyAngularVelocity = Vector3.zero
	end
end

local function setTutorialMovementLocked(player: Player, locked: boolean)
	player:SetAttribute(TUTORIAL_MOVEMENT_LOCK_ATTRIBUTE, locked)

	if locked then
		applyMovementLock(player)
		return
	end

	local statService = getStatService()
	if statService and type(statService.RecalculateStats) == "function" then
		statService.RecalculateStats(player)
	end
end

local function setTutorialState(player: Player, completed: boolean, reason: string)
	local playerStateService = getPlayerStateService()
	if not playerStateService then
		warn(string.format("[TutorialService] PlayerStateService unavailable while applying tutorial gate for %s", player.Name))
		return
	end

	local currentState = playerStateService.GetState(player)
	if completed then
		player:SetAttribute(TUTORIAL_COMPLETED_ATTRIBUTE, true)
		setTutorialMovementLocked(player, false)
		if currentState == PlayerState.States.TutorialLocked then
			playerStateService.SetState(player, PlayerState.States.Lobby)
		end
		log(string.format("Gameplay unlocked for %s reason=%s state=%s", player.Name, reason, tostring(playerStateService.GetState(player))))
		return
	end

	player:SetAttribute(TUTORIAL_COMPLETED_ATTRIBUTE, false)
	if currentState ~= PlayerState.States.TutorialLocked then
		playerStateService.SetState(player, PlayerState.States.TutorialLocked)
	end
	setTutorialMovementLocked(player, true)
	log(string.format("Gameplay locked for %s reason=%s", player.Name, reason))
end

local function bindCharacterLock(player: Player)
	local existing = characterConnections[player]
	if existing then
		existing:Disconnect()
	end

	characterConnections[player] = player.CharacterAdded:Connect(function()
		task.defer(function()
			if player.Parent and player:GetAttribute(TUTORIAL_MOVEMENT_LOCK_ATTRIBUTE) == true then
				applyMovementLock(player)
				log(string.format("Re-applied tutorial movement lock after respawn for %s", player.Name))
			end
		end)
	end)
end

function TutorialService.PrimePlayer(player: Player)
	if not player or not player.Parent then
		return
	end

	local playerDataService = getPlayerDataService()
	if playerDataService and playerDataService.IsLoaded(player) then
		local completed = playerDataService.GetField(player, "TutorialCompleted") == true
		bindCharacterLock(player)
		setTutorialState(player, completed, completed and "join_prime_loaded_complete" or "join_prime_loaded_incomplete")
		return
	end

	if player:GetAttribute(TUTORIAL_COMPLETED_ATTRIBUTE) == true and player:GetAttribute(TUTORIAL_MOVEMENT_LOCK_ATTRIBUTE) ~= true then
		bindCharacterLock(player)
		setTutorialState(player, true, "join_prime_attribute_complete")
		return
	end

	player:SetAttribute(TUTORIAL_COMPLETED_ATTRIBUTE, false)
	player:SetAttribute(TUTORIAL_MOVEMENT_LOCK_ATTRIBUTE, true)
	bindCharacterLock(player)
	setTutorialState(player, false, "join_prime")
end

function TutorialService.ApplyLoadedState(player: Player)
	bindCharacterLock(player)

	local playerDataService = getPlayerDataService()
	if not playerDataService or not playerDataService.IsLoaded(player) then
		setTutorialState(player, false, "profile_not_loaded")
		return
	end

	local completed = playerDataService.GetField(player, "TutorialCompleted") == true
	local playerStateService = getPlayerStateService()
	local currentState = if playerStateService then playerStateService.GetState(player) else nil
	if not completed and currentState == PlayerState.States.InMatch then
		player:SetAttribute(TUTORIAL_COMPLETED_ATTRIBUTE, false)
		player:SetAttribute(TUTORIAL_MOVEMENT_LOCK_ATTRIBUTE, false)
		log(string.format(
			"Skipped tutorial relock for %s reason=profile_loaded_incomplete state=%s",
			player.Name,
			tostring(currentState)
		))
		return
	end
	setTutorialState(player, completed, completed and "profile_loaded_complete" or "profile_loaded_incomplete")
end

function TutorialService.GetStatus(player: Player)
	local playerDataService = getPlayerDataService()
	if not playerDataService or not playerDataService.IsLoaded(player) then
		return {
			dataLoaded = false,
			tutorialCompleted = false,
		}
	end

	return {
		dataLoaded = true,
		tutorialCompleted = playerDataService.GetField(player, "TutorialCompleted") == true,
	}
end

function TutorialService.Acknowledge(player: Player)
	local userId = player.UserId
	if acknowledgeLocks[userId] then
		return {
			success = false,
			reason = "AlreadySaving",
		}
	end

	acknowledgeLocks[userId] = true

	local playerDataService = getPlayerDataService()
	if not playerDataService or not playerDataService.IsLoaded(player) then
		acknowledgeLocks[userId] = nil
		return {
			success = false,
			reason = "DataNotLoaded",
		}
	end

	if playerDataService.GetField(player, "TutorialCompleted") == true then
		acknowledgeLocks[userId] = nil
		setTutorialState(player, true, "ack_already_complete")
		log(string.format("Acknowledge skipped for %s -- already completed", player.Name))
		return {
			success = true,
			alreadyCompleted = true,
			persisted = true,
			tutorialCompleted = true,
		}
	end

	local setOk = playerDataService.SetField(player, "TutorialCompleted", true)
	if not setOk then
		acknowledgeLocks[userId] = nil
		warn(string.format("[TutorialService] Failed to set TutorialCompleted for %s", player.Name))
		return {
			success = false,
			reason = "SetFieldFailed",
		}
	end

	local saved = playerDataService.SavePlayer(player)
	acknowledgeLocks[userId] = nil
	setTutorialState(player, true, "acknowledged")

	if saved then
		log(string.format("Tutorial completion saved for %s", player.Name))
	else
		warn(string.format("[TutorialService] Tutorial completion marked but immediate save failed for %s", player.Name))
	end

	return {
		success = true,
		persisted = saved,
		tutorialCompleted = true,
	}
end

function TutorialService.Init()
	if initialized then
		return
	end
	initialized = true

	local remotesFolder = ReplicatedStorage:FindFirstChild("Remotes")
	if not remotesFolder then
		remotesFolder = Instance.new("Folder")
		remotesFolder.Name = "Remotes"
		remotesFolder.Parent = ReplicatedStorage
	end

	local getStatusFunction = remotesFolder:FindFirstChild("Tutorial_GetStatus")
	if not getStatusFunction then
		getStatusFunction = Instance.new("RemoteFunction")
		getStatusFunction.Name = "Tutorial_GetStatus"
		getStatusFunction.Parent = remotesFolder
	end
	getStatusFunction.OnServerInvoke = function(player)
		return TutorialService.GetStatus(player)
	end

	local acknowledgeFunction = remotesFolder:FindFirstChild("Tutorial_Acknowledge")
	if not acknowledgeFunction then
		acknowledgeFunction = Instance.new("RemoteFunction")
		acknowledgeFunction.Name = "Tutorial_Acknowledge"
		acknowledgeFunction.Parent = remotesFolder
	end
	acknowledgeFunction.OnServerInvoke = function(player)
		return TutorialService.Acknowledge(player)
	end

	Players.PlayerRemoving:Connect(function(player)
		acknowledgeLocks[player.UserId] = nil
		local connection = characterConnections[player]
		if connection then
			connection:Disconnect()
			characterConnections[player] = nil
		end
	end)

	log("Initialized")
end

return TutorialService
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="105">
        <Properties>
          <string name="Name">WalkerPetBootstrap</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--[[
	WalkerPetBootstrap
	Starts the server-side walker-pet NPC controller.
	Runs once on server start (after PlayerData/State are available).
]]

local ServerScriptService = game:GetService("ServerScriptService")
local Server = ServerScriptService:WaitForChild("Server")

task.wait(0.5) -- ensure data services are up

local WalkerPetServerController = require(Server:WaitForChild("WalkerPetServerController"))
WalkerPetServerController.Init()
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="106">
        <Properties>
          <string name="Name">WalkerPetServerController</string>
          <string name="Source"><![CDATA[--[[
	WalkerPetServerController
	Server-side walker pet NPC controller.

	Mirrors TungTungSahurService's exact loop/animation pattern but targets
	owner follow position instead of the nearest enemy.

	Loop parity (from TungTungSahurService):
	  - ChaseInterval   = 0.2   (task.wait between loop ticks)
	  - RepathInterval  = 0.45  (min seconds between MoveTo calls)
	  - RepathTargetMoveDelta = 4.0  (repath if target moved this many studs)
	  - WalkAnimId = "rbxassetid://507777826"
	  - Animation loaded via Humanoid -> Animator:LoadAnimation (exactly as TungTung)
	  - Network owner set to nil (server owns physics)

	Walker pets:
	  Bonnie / Chica / Foxy / FreddyFazbear

	API (called from InventoryService/AttributeChange watcher):
	  WalkerPetServerController.Init()
]]

local Players           = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace         = game:GetService("Workspace")

local Shared            = ReplicatedStorage:WaitForChild("Shared")
local ItemCatalog       = require(Shared:WaitForChild("ItemCatalog"))
local ItemModelRegistry = require(Shared:WaitForChild("ItemModelRegistry"))

local Remotes           = ReplicatedStorage:WaitForChild("Remotes")
local EquipRemote       = Remotes:WaitForChild("EquipWalkerPet")
local UnequipRemote     = Remotes:WaitForChild("UnequipWalkerPet")

local AnimateTemplate   = Shared:WaitForChild("AnimateR15_NPC")

local TAG = "[WalkerPetSV]"

local WALK_SPEED        = 16
local FOLLOW_INTERVAL   = 0.15
local FOLLOW_DISTANCE   = 5
local STOP_DISTANCE     = 3
local TELEPORT_DISTANCE = 60
local HIP_HEIGHT        = 2.0
local ROOT_FOLDER_NAME  = "_EquippedPets"

-- ── Allowed walker pet model names (exactly as in ItemModels) ─────────────────
local WALKER_NAMES: { [string]: boolean } = {
	-- FNAF pets reverted to floating/bobble controller only.
	-- Intentionally empty so server walker spawner never handles them.
}

-- ── State ─────────────────────────────────────────────────────────────────────
-- _active[player] = { model, thread, walkTrack }
type ActiveEntry = {
	model: Model,
	thread: thread,
}

local _active: { [Player]: ActiveEntry } = {}

-- ── Helpers ───────────────────────────────────────────────────────────────────
local function getRootFolder(): Folder
	local root = Workspace:FindFirstChild(ROOT_FOLDER_NAME)
	if root and root:IsA("Folder") then
		return root
	end
	root = Instance.new("Folder")
	root.Name = ROOT_FOLDER_NAME
	root.Parent = Workspace
	return root
end

local function getPlayerFolder(player: Player): Folder
	local root = getRootFolder()
	local name = tostring(player.UserId)
	local f = root:FindFirstChild(name)
	if f and f:IsA("Folder") then
		return f
	end
	f = Instance.new("Folder")
	f.Name = name
	f.Parent = root
	return f
end

local function getPetDef(petId: string)
	if not petId or petId == "" then
		return nil
	end
	return ItemCatalog.Pets and ItemCatalog.Pets[petId]
end

local function getModelName(petId: string): string?
	local def = ItemCatalog.Pets and ItemCatalog.Pets[petId]
	if not def then return nil end
	if typeof(def.modelName) == "string" and def.modelName ~= "" then
		return def.modelName
	end
	return nil
end

local function ensureAnimator(humanoid: Humanoid): Animator
	local a = humanoid:FindFirstChildOfClass("Animator")
	if a then return a end
	a = Instance.new("Animator")
	a.Parent = humanoid
	return a
end

local function despawnFor(player: Player)
	local entry = _active[player]
	if not entry then return end
	pcall(function() task.cancel(entry.thread) end)
	if entry.model and entry.model.Parent then
		entry.model:Destroy()
	end
	_active[player] = nil
end

local function findHumanoid(model: Model): Humanoid?
	local direct = model:FindFirstChildOfClass("Humanoid")
	if direct then
		return direct
	end
	local nested = model:FindFirstChild("Humanoid", true)
	if nested and nested:IsA("Humanoid") then
		return nested
	end
	return nil
end

local function findHRP(model: Model): BasePart?
	local hrp = model:FindFirstChild("HumanoidRootPart", true)
	if hrp and hrp:IsA("BasePart") then
		return hrp
	end
	return nil
end

local function findFallbackRoot(model: Model, hum: Humanoid?): BasePart?
	if hum and hum.RootPart then
		return hum.RootPart
	end
	if model.PrimaryPart then
		return model.PrimaryPart
	end
	local anyPart = model:FindFirstChildWhichIsA("BasePart", true)
	if anyPart then
		return anyPart
	end
	return nil
end

local function normalizeWalkerRig(model: Model): (Model, Humanoid?, BasePart?)
	local hum = findHumanoid(model)
	local hrp = findHRP(model)

	-- If Humanoid is inside a nested rig model, normalize onto that model.
	if hum and hum.Parent and hum.Parent:IsA("Model") then
		model = hum.Parent
		hum = findHumanoid(model)
		hrp = findHRP(model)
	end

	-- Some imported rigs are missing Humanoid; create one so MoveTo works.
	if not hum then
		hum = Instance.new("Humanoid")
		hum.Name = "Humanoid"
		hum.Parent = model
	end

	if not hrp then
		hrp = findFallbackRoot(model, hum)
	end

	if hum and not hum:FindFirstChildOfClass("Animator") then
		local animator = Instance.new("Animator")
		animator.Parent = hum
	end

	if hrp then
		model.PrimaryPart = hrp
	end

	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			d.Anchored = false
			d.CanCollide = false
		end
	end

	return model, hum, hrp
end

local function isValidWalkerRig(model: Model, hum: Humanoid?, hrp: BasePart?): (boolean, string)
	if not hum then
		return false, "missing Humanoid"
	end
	if not hrp then
		return false, "missing root part"
	end
	if model.PrimaryPart ~= hrp then
		return false, "PrimaryPart not root"
	end
	return true, "ok"
end

local function injectAnimateScript(model: Model): boolean
	local existing = model:FindFirstChild("Animate")
	if existing and existing:IsA("Script") then
		existing:Destroy()
	end
	local clone = AnimateTemplate:Clone()
	clone.Name = "Animate"
	clone.Parent = model
	clone.Disabled = false
	return true
end

local function zeroPitchRoll(hrp: BasePart, faceYaw: number)
	local pos = hrp.Position
	hrp.CFrame = CFrame.new(pos) * CFrame.Angles(0, faceYaw, 0)
end

local function startFollowLoop(model: Model, player: Player, hum: Humanoid, hrp: BasePart): thread
	return task.spawn(function()
		while model.Parent do
			local char = player.Character
			local ownerHrp = char and char:FindFirstChild("HumanoidRootPart")
			if ownerHrp and ownerHrp:IsA("BasePart") and hum.Health > 0 and model.PrimaryPart then
				local targetPos = ownerHrp.Position - ownerHrp.CFrame.LookVector * FOLLOW_DISTANCE
				local petPos = model.PrimaryPart.Position
				local dist = (targetPos - petPos).Magnitude

				if dist > TELEPORT_DISTANCE or petPos.Y < -50 then
					local yaw = math.atan2(-ownerHrp.CFrame.LookVector.X, -ownerHrp.CFrame.LookVector.Z)
					hrp.CFrame = CFrame.new(targetPos + Vector3.new(0, 3, 0)) * CFrame.Angles(0, yaw, 0)
				elseif dist > STOP_DISTANCE then
					hum:MoveTo(targetPos)
				end
			end

			task.wait(FOLLOW_INTERVAL)
		end
	end)
end

local function spawnFor(player: Player, petId: string)
	despawnFor(player)

	local modelName = getModelName(petId)
	if not modelName or not WALKER_NAMES[modelName] then
		return
	end

	local petDef = getPetDef(petId)
	local sourceModel: Instance? = nil
	if petDef and typeof(petDef.modelPath) == "string" and petDef.modelPath ~= "" then
		sourceModel = ItemModelRegistry.Get(petDef.modelPath)
	end
	if not sourceModel then
		sourceModel = ItemModelRegistry.GetByExactName(modelName)
	end
	if not sourceModel then
		warn(TAG, "Model not found:", modelName)
		return
	end

	local char = player.Character
	local ownerHrp = char and char:FindFirstChild("HumanoidRootPart")
	if not ownerHrp then return end

	local clone = sourceModel:Clone() :: Model
	local sourcePath = sourceModel:GetFullName()
	clone:SetAttribute("IsPet", true)

	-- Disable embedded scripts on the PET clone so no internal hitbox/attack
	-- logic can damage players. Enemy asset remains unchanged.
	for _, d in ipairs(clone:GetDescendants()) do
		if d:IsA("Script") or d:IsA("LocalScript") then
			d.Disabled = true
		end
	end

	clone, hum, hrp = normalizeWalkerRig(clone)
	local okRig, reason = isValidWalkerRig(clone, hum, hrp)
	if not okRig then
		warn(TAG, string.format("Invalid walker rig: %s reason=%s source=%s",
			modelName, reason, sourcePath))
		clone:Destroy()
		return
	end

	-- Unanchor and disable collisions to avoid floor snagging.
	for _, d in ipairs(clone:GetDescendants()) do
		if d:IsA("BasePart") then
			d.Anchored = false
			d.CanCollide = false
			d.CanQuery = false
			d.CanTouch = false
		end
	end
	hrp.CanCollide = false

	hum.WalkSpeed = WALK_SPEED
	hum.AutoRotate = true
	hum.PlatformStand = false
	hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	hum.BreakJointsOnDeath = false
	hum.RequiresNeck = false
	if hum.HipHeight < HIP_HEIGHT then
		hum.HipHeight = HIP_HEIGHT
	end

	ensureAnimator(hum)

	clone.Name = "_WalkerPet_" .. player.Name
	clone.Parent = getPlayerFolder(player)

	local targetPos = ownerHrp.Position - ownerHrp.CFrame.LookVector * FOLLOW_DISTANCE + Vector3.new(0, 3, 0)
	local yaw = math.atan2(-ownerHrp.CFrame.LookVector.X, -ownerHrp.CFrame.LookVector.Z)
	hrp.CFrame = CFrame.new(targetPos) * CFrame.Angles(0, yaw, 0)
	zeroPitchRoll(hrp, yaw)

	pcall(function() hrp:SetNetworkOwner(nil) end)
	local injected = injectAnimateScript(clone)
	local thread = startFollowLoop(clone, player, hum, hrp)
	_active[player] = { model = clone, thread = thread }

	local hasAnimator = hum:FindFirstChildOfClass("Animator") ~= nil
	print(string.format(
		"%s spawned %s HRP=%s Humanoid=%s Animator=%s AnimateInjected=%s",
		TAG,
		modelName,
		tostring(hrp ~= nil),
		tostring(hum ~= nil),
		tostring(hasAnimator),
		tostring(injected)
	))
end

-- ── Public API ────────────────────────────────────────────────────────────────
local WalkerPetServerController = {}

function WalkerPetServerController.Init()
	EquipRemote.OnServerEvent:Connect(function(player: Player, petId: string)
		if typeof(petId) ~= "string" then return end
		spawnFor(player, petId)
	end)

	UnequipRemote.OnServerEvent:Connect(function(player: Player)
		despawnFor(player)
	end)

	Players.PlayerRemoving:Connect(function(player)
		despawnFor(player)
	end)

	-- Re-spawn pet after character respawn
	Players.PlayerAdded:Connect(function(player)
		player.CharacterAdded:Connect(function()
			-- Small delay to let character fully load
			task.wait(1)
			local petId = player:GetAttribute("EquippedPet")
			if petId and petId ~= "" then
				local modelName = getModelName(petId)
				if modelName and WALKER_NAMES[modelName] then
					spawnFor(player, petId)
				end
			end
		end)
	end)

	for _, player in ipairs(Players:GetPlayers()) do
		player.CharacterAdded:Connect(function()
			task.wait(1)
			local petId = player:GetAttribute("EquippedPet")
			if petId and petId ~= "" then
				local modelName = getModelName(petId)
				if modelName and WALKER_NAMES[modelName] then
					spawnFor(player, petId)
				end
			end
		end)
	end

	print(TAG, "Initialized")
end

return WalkerPetServerController
