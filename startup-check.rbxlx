          <string name="Source"><![CDATA[--[[
	MatchConfig
	Shared match pacing configuration for intermission flow.
]]

local MatchConfig = {}

MatchConfig.IntermissionSeconds = 12
MatchConfig.VoteRevealRemainingSeconds = 7
