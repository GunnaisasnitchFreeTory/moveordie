      <Item class="ModuleScript" referent="3">
        <Properties>
          <string name="Name">NpcLocomotion</string>
          <string name="Source"><![CDATA[--[[
	NpcLocomotion
	Direct TungTungSahur locomotion/animation extraction for reuse.

	Core parity:
	  - Loop cadence: 0.2s
	  - MoveTo repath interval: 0.45s
	  - Repath target delta: 4.0 studs
	  - Walk animation loaded through Humanoid.Animator:LoadAnimation
]]

local RunService = game:GetService("RunService")

local NpcLocomotion = {}
NpcLocomotion.__index = NpcLocomotion

local DEFAULTS = {
	WalkSpeed = 26,
	ChaseInterval = 0.2,
	RepathInterval = 0.45,
	RepathTargetMoveDelta = 4.0,
	WalkAnimId = "rbxassetid://507777826",
	IdleAnimId = "rbxassetid://507766666",
	HipHeight = 2.0,
}

local function findRoot(model: Model): BasePart?
	local root = model:FindFirstChild("HumanoidRootPart", true)
	if root and root:IsA("BasePart") then
		model.PrimaryPart = root
		return root
	end
	local primary = model.PrimaryPart
	if primary and primary:IsA("BasePart") then
		return primary
	end
	return nil
end

local function ensureAnimator(humanoid: Humanoid): Animator
	local animator = humanoid:FindFirstChildOfClass("Animator")
	if animator then
		return animator
	end
	animator = Instance.new("Animator")
	animator.Parent = humanoid
	return animator
end

local function loadTrack(humanoid: Humanoid, animId: string): AnimationTrack?
	local animator = ensureAnimator(humanoid)
	local anim = Instance.new("Animation")
	anim.AnimationId = animId
	local ok, track = pcall(function()
		return animator:LoadAnimation(anim)
	end)
	anim:Destroy()
	if ok and track then
		track.Looped = true
		return track
	end
	return nil
end

function NpcLocomotion.attach(model: Model, cfg)
	cfg = cfg or {}
	local self = setmetatable({}, NpcLocomotion)
	self._model = model
	self._cfg = {
		WalkSpeed = cfg.WalkSpeed or DEFAULTS.WalkSpeed,
		ChaseInterval = cfg.ChaseInterval or DEFAULTS.ChaseInterval,
		RepathInterval = cfg.RepathInterval or DEFAULTS.RepathInterval,
		RepathTargetMoveDelta = cfg.RepathTargetMoveDelta or DEFAULTS.RepathTargetMoveDelta,
		WalkAnimId = cfg.WalkAnimId or DEFAULTS.WalkAnimId,
		IdleAnimId = cfg.IdleAnimId or DEFAULTS.IdleAnimId,
		HipHeight = cfg.HipHeight or DEFAULTS.HipHeight,
	}
	self._target = nil :: Vector3?
	self._active = true
	self._acc = 0
	self._lastMoveToAt = 0
	self._lastMoveToTargetPos = nil :: Vector3?
	self._runConn = nil :: RBXScriptConnection?
	self._loopConn = nil :: RBXScriptConnection?
	self._walkTrack = nil :: AnimationTrack?
	self._idleTrack = nil :: AnimationTrack?
	self._isMoving = false

	local hum = model:FindFirstChildOfClass("Humanoid")
	if not hum then
		hum = Instance.new("Humanoid")
		hum.Parent = model
	end
	self._humanoid = hum
	self._root = findRoot(model)
	if self._root then
		model.PrimaryPart = self._root
	end

	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			d.Anchored = false
		end
	end

	hum.WalkSpeed = self._cfg.WalkSpeed
	hum.AutoRotate = true
	hum.PlatformStand = false
	hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	hum.BreakJointsOnDeath = false
	hum.RequiresNeck = false
	if self._root then
		local minHip = math.max(2.0, (self._root.Size.Y * 0.5) + 0.5)
		hum.HipHeight = math.max(self._cfg.HipHeight, minHip)
	else
		hum.HipHeight = self._cfg.HipHeight
	end
	pcall(function()
		hum:ChangeState(Enum.HumanoidStateType.Running)
	end)

	self._walkTrack = loadTrack(hum, self._cfg.WalkAnimId)
	self._idleTrack = loadTrack(hum, self._cfg.IdleAnimId)
	if self._walkTrack then
		self._walkTrack.Looped = true
	end
	if self._idleTrack then
		self._idleTrack.Looped = true
	end

	local function setMoving(moving: boolean)
		if self._isMoving == moving then
			return
		end
		self._isMoving = moving
		if moving then
			if self._idleTrack and self._idleTrack.IsPlaying then
				pcall(function()
					self._idleTrack:Stop(0.2)
				end)
			end
			if self._walkTrack and not self._walkTrack.IsPlaying then
				pcall(function()
					self._walkTrack:Play(0.2)
				end)
			end
		else
			if self._walkTrack and self._walkTrack.IsPlaying then
				pcall(function()
					self._walkTrack:Stop(0.2)
				end)
			end
			if self._idleTrack and not self._idleTrack.IsPlaying then
				pcall(function()
					self._idleTrack:Play(0.2)
				end)
			end
		end
	end

	if self._idleTrack then
		pcall(function()
			self._idleTrack:Play(0.2)
		end)
	end

	self._runConn = hum.Running:Connect(function(speed)
		setMoving(speed > 0.5)
	end)

	self._loopConn = RunService.Heartbeat:Connect(function(dt)
		if not self._active then
			return
		end
		if not self._model or not self._model.Parent then
			return
		end
		self._acc += dt
		if self._acc < self._cfg.ChaseInterval then
			return
		end
		self._acc = 0

		local root = self._root
		local humanoid = self._humanoid
		if not root or not root.Parent or not humanoid or humanoid.Health <= 0 then
			return
		end

		local target = self._target
		if not target then
			humanoid:MoveTo(root.Position)
			return
		end

		local now = tick()
		local shouldRepath = false
		if (now - self._lastMoveToAt) >= self._cfg.RepathInterval then
			shouldRepath = true
		elseif self._lastMoveToTargetPos and (target - self._lastMoveToTargetPos).Magnitude >= self._cfg.RepathTargetMoveDelta then
			shouldRepath = true
		elseif not self._lastMoveToTargetPos then
			shouldRepath = true
		end

		if shouldRepath then
			humanoid:MoveTo(target)
			self._lastMoveToAt = now
			self._lastMoveToTargetPos = target
		end
	end)

	return self
end

function NpcLocomotion:SetTarget(targetPos: Vector3)
	self._target = targetPos
end

function NpcLocomotion:Stop()
	self._target = nil
	if self._humanoid and self._root then
		self._humanoid:MoveTo(self._root.Position)
	end
end

function NpcLocomotion:IsWalkAnimLoaded(): boolean
	return self._walkTrack ~= nil
end

function NpcLocomotion:IsIdleAnimLoaded(): boolean
	return self._idleTrack ~= nil
end

function NpcLocomotion:Destroy()
	self._active = false
	if self._loopConn then
		self._loopConn:Disconnect()
		self._loopConn = nil
	end
	if self._runConn then
		self._runConn:Disconnect()
		self._runConn = nil
	end
	if self._walkTrack then
		pcall(function()
			self._walkTrack:Stop()
		end)
		self._walkTrack = nil
	end
	if self._idleTrack then
		pcall(function()
			self._idleTrack:Stop()
		end)
		self._idleTrack = nil
	end
	self._humanoid = nil
	self._root = nil
	self._model = nil
end

return NpcLocomotion
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="Folder" referent="4">
      <Properties>
        <string name="Name">Pets</string>
      </Properties>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">PetNpcFollower</string>
          <string name="Source"><![CDATA[--[[
	PetNpcFollower
	Walker-pet follow brain that reuses NpcLocomotion (TungTung-style loop).
]]

local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local TungtungLocomotionAdapter = require(ReplicatedStorage:WaitForChild("Pets"):WaitForChild("TungtungLocomotionAdapter"))

local PetNpcFollower = {}

local DEFAULTS = {
	FollowDistance = 5,
	StopDistance = 3,
	UpdateInterval = 0.2,
	TeleportDistance = 60,
	WalkSpeed = 26,
	ChaseInterval = 0.2,
	RepathInterval = 0.45,
	RepathTargetMoveDelta = 4.0,
	WalkAnimId = "rbxassetid://507777826",
	IdleAnimId = "rbxassetid://507766666",
	HipHeight = 2.0,
}

export type FollowHandle = {
	Destroy: (self: FollowHandle) -> (),
	IsWalkAnimLoaded: (self: FollowHandle) -> boolean,
	IsIdleAnimLoaded: (self: FollowHandle) -> boolean,
}

function PetNpcFollower.Start(model: Model, owner: Player, opts): FollowHandle?
	if not model or not owner then
		return nil
	end
	opts = opts or {}
	local cfg = {
		FollowDistance = opts.FollowDistance or DEFAULTS.FollowDistance,
		StopDistance = opts.StopDistance or DEFAULTS.StopDistance,
		UpdateInterval = opts.UpdateInterval or DEFAULTS.UpdateInterval,
		TeleportDistance = opts.TeleportDistance or DEFAULTS.TeleportDistance,
		WalkSpeed = opts.WalkSpeed or DEFAULTS.WalkSpeed,
		ChaseInterval = opts.ChaseInterval or DEFAULTS.ChaseInterval,
		RepathInterval = opts.RepathInterval or DEFAULTS.RepathInterval,
		RepathTargetMoveDelta = opts.RepathTargetMoveDelta or DEFAULTS.RepathTargetMoveDelta,
		WalkAnimId = opts.WalkAnimId or DEFAULTS.WalkAnimId,
		IdleAnimId = opts.IdleAnimId or DEFAULTS.IdleAnimId,
		HipHeight = opts.HipHeight or DEFAULTS.HipHeight,
	}

	local adapter = TungtungLocomotionAdapter.attach(model, owner, {
		FollowDistance = cfg.FollowDistance,
		WalkSpeed = cfg.WalkSpeed,
		ChaseInterval = cfg.ChaseInterval,
		RepathInterval = cfg.RepathInterval,
		RepathTargetMoveDelta = cfg.RepathTargetMoveDelta,
		WalkAnimId = cfg.WalkAnimId,
		IdleAnimId = cfg.IdleAnimId,
		HipHeight = cfg.HipHeight,
	})

	local acc = 0
	local conn = RunService.Heartbeat:Connect(function(dt)
		acc += dt
		if acc < cfg.UpdateInterval then
			return
		end
		acc = 0

		if not model.Parent then
			return
		end

		local char = owner.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		if not hrp or not hrp:IsA("BasePart") then
			adapter:Stop()
			return
		end

		local followPos = adapter:GetTargetPosition()
		if not followPos then
			adapter:Stop()
			return
		end

		local root = model:FindFirstChild("HumanoidRootPart", true)
		local petPos = root and root:IsA("BasePart") and root.Position or (model.PrimaryPart and model.PrimaryPart.Position)
		if not petPos then
			return
		end

		local dist = (followPos - petPos).Magnitude
		if dist > cfg.TeleportDistance or petPos.Y < -50 then
			model:PivotTo(CFrame.new(followPos + Vector3.new(0, 2, 0)))
			adapter:Stop()
			return
		end

		if dist > cfg.StopDistance then
			adapter:SetTarget(followPos)
		else
			adapter:Stop()
		end
	end)

	local handle = {}
	function handle:Destroy()
		if conn then
			conn:Disconnect()
		end
		if adapter then
			adapter:Destroy()
		end
	end
	function handle:IsWalkAnimLoaded(): boolean
		return adapter and adapter:IsWalkAnimLoaded() or false
	end
	function handle:IsIdleAnimLoaded(): boolean
		return adapter and adapter:IsIdleAnimLoaded() or false
	end
	return handle
end

return PetNpcFollower
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">RigNormalizer</string>
          <string name="Source"><![CDATA[--[[
	RigNormalizer
	Walker-pet rig normalization helpers.
]]

local RigNormalizer = {}

local function findFirstBasePart(model: Model): BasePart?
	return model:FindFirstChildWhichIsA("BasePart", true)
end

local function findTorsoRoot(model: Model): BasePart?
	local lower = model:FindFirstChild("LowerTorso", true)
	if lower and lower:IsA("BasePart") then
		return lower
	end
	local upper = model:FindFirstChild("UpperTorso", true)
	if upper and upper:IsA("BasePart") then
		return upper
	end
	return nil
end

function RigNormalizer.EnsureHumanoidRootPart(model: Model): BasePart?
	local existing = model:FindFirstChild("HumanoidRootPart", true)
	if existing and existing:IsA("BasePart") then
		model.PrimaryPart = existing
		return existing
	end

	local torso = findTorsoRoot(model)
	local rootRef = torso or model.PrimaryPart or findFirstBasePart(model)
	if not rootRef then
		return nil
	end

	local hrp = Instance.new("Part")
	hrp.Name = "HumanoidRootPart"
	hrp.Size = Vector3.new(2, 2, 1)
	hrp.Transparency = 1
	hrp.CanCollide = false
	hrp.CanQuery = false
	hrp.CanTouch = false
	hrp.Massless = false
	hrp.Anchored = false
	hrp.CFrame = rootRef.CFrame
	hrp.Parent = model

	local jointTarget = torso or rootRef
	local existingRootJoint = hrp:FindFirstChild("RootJoint")
	if existingRootJoint then
		existingRootJoint:Destroy()
	end
	local rootJoint = Instance.new("Motor6D")
	rootJoint.Name = "RootJoint"
	rootJoint.Part0 = hrp
	rootJoint.Part1 = jointTarget
	rootJoint.C0 = CFrame.new()
	rootJoint.C1 = jointTarget.CFrame:ToObjectSpace(hrp.CFrame)
	rootJoint.Parent = hrp

	model.PrimaryPart = hrp
	return hrp
end

return RigNormalizer
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">TungtungLocomotionAdapter</string>
          <string name="Source"><![CDATA[--[[
	TungtungLocomotionAdapter
	Wrapper that binds TungTung locomotion core to a pet-owner target provider.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local NpcLocomotion = require(ReplicatedStorage:WaitForChild("NPC"):WaitForChild("NpcLocomotion"))

local Adapter = {}
Adapter.__index = Adapter

local DEFAULTS = {
	FollowDistance = 5,
	WalkSpeed = 26,
	ChaseInterval = 0.2,
	RepathInterval = 0.45,
	RepathTargetMoveDelta = 4.0,
	WalkAnimId = "rbxassetid://507777826",
	IdleAnimId = "rbxassetid://507766666",
	HipHeight = 2.0,
}

function Adapter.attach(model: Model, owner: Player, config)
	config = config or {}
	local self = setmetatable({}, Adapter)
	self._owner = owner
	self._followDistance = config.FollowDistance or DEFAULTS.FollowDistance
	self._loco = NpcLocomotion.attach(model, {
		WalkSpeed = config.WalkSpeed or DEFAULTS.WalkSpeed,
		ChaseInterval = config.ChaseInterval or DEFAULTS.ChaseInterval,
		RepathInterval = config.RepathInterval or DEFAULTS.RepathInterval,
		RepathTargetMoveDelta = config.RepathTargetMoveDelta or DEFAULTS.RepathTargetMoveDelta,
		WalkAnimId = config.WalkAnimId or DEFAULTS.WalkAnimId,
		IdleAnimId = config.IdleAnimId or DEFAULTS.IdleAnimId,
		HipHeight = config.HipHeight or DEFAULTS.HipHeight,
	})
	return self
end

function Adapter:GetTargetPosition(): Vector3?
	local owner = self._owner
	local char = owner and owner.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp or not hrp:IsA("BasePart") then
		return nil
	end
	return hrp.Position - (hrp.CFrame.LookVector * self._followDistance)
end

function Adapter:SetTarget(targetPos: Vector3)
	self._loco:SetTarget(targetPos)
end

function Adapter:Stop()
	self._loco:Stop()
end

function Adapter:IsWalkAnimLoaded(): boolean
	return self._loco:IsWalkAnimLoaded()
end

function Adapter:IsIdleAnimLoaded(): boolean
	return self._loco:IsIdleAnimLoaded()
end

function Adapter:Destroy()
	self._loco:Destroy()
end

return Adapter
]]></string>
        </Properties>
      </Item>
    </Item>
