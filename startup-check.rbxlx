      <Item class="Script" referent="98">
        <Properties>
          <string name="Name">SpecialPetMotorRig</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local HttpService = game:GetService("HttpService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local ItemCatalog = require(Shared:WaitForChild("ItemCatalog"))
local ItemModelRegistry = require(Shared:WaitForChild("ItemModelRegistry"))

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local EquipRemote = Remotes:WaitForChild("EquipWalkerPet")
local UnequipRemote = Remotes:WaitForChild("UnequipWalkerPet")

local TAG = "[SpecialPetMotorRig]"
local ROOT_FOLDER_NAME = "_EquippedPetsMotor"
local DEBUG_SPECIAL_PET_RIG = RunService:IsStudio()
local TARGET_MAX_DIM = 3.0
local SCALE_HARD_MAX = 5.0

local PET_SCALE_MULTIPLIER: { [string]: number } = {
	pet_pink_butterfly = 1.5,
	pet_glitched_dragon = 1.8,
	pet_dark_winged_dragon = 1.6, -- Music Winged Dragon
	pet_dark_falcon = 1.4, -- Dark Goblem
}

local TARGET_PETS: { [string]: boolean } = {
	pet_pink_butterfly = true,
	pet_glitched_dragon = true,
	pet_dark_winged_dragon = true, -- Music Winged Dragon
	pet_dark_falcon = true, -- Dark Goblem
}

-- Pets in this set should keep spawn/orbit/weld behavior but never create animated Motor6D joints.
local STATIC_SPECIAL_PETS_NO_MOTOR: { [string]: boolean } = {
	pet_dark_falcon = true, -- Dark Goblem
}

local ORBIT_PETS: { [string]: boolean } = {
	pet_pink_butterfly = true,
	pet_glitched_dragon = true,
	pet_dark_winged_dragon = true,
}

local YAW_OVERRIDE_RAD: { [string]: number } = {
	pet_pink_butterfly = math.rad(-90),
	pet_glitched_dragon = math.rad(90),
	pet_dark_winged_dragon = 0,
	pet_dark_falcon = math.rad(180),
}

local PINK_BUTTERFLY_FLAP_SPEED = 8.0
local PINK_BUTTERFLY_FLAP_AMP_RAD = math.rad(35)
local DARK_GOBLEM_BOB_AMP = 0.55
local DARK_GOBLEM_BOB_SPEED = 2.4
local DARK_GOBLEM_SWAY_AMP = 0.22
local DARK_GOBLEM_SWAY_SPEED = 1.6
local DARK_GOBLEM_YAW_BOB_AMP_RAD = math.rad(6)

type MotorInfo = {
	motor: Motor6D,
	baseC0: CFrame,
	mode: "wing_h" | "wing_v" | "arm",
	sign: number,
	wingRole: "primary" | "secondary" | nil,
}

type ActiveEntry = {
	player: Player,
	petId: string,
	model: Model,
	root: BasePart,
	rootWeld: Weld,
	motors: { MotorInfo },
	orbitEnabled: boolean,
	t0: number,
	phase: number,
	animDebugLogged: boolean,
}

local _active: { [Player]: ActiveEntry } = {}
local _scaleApplyCountByModel: { [string]: number } = {}
local _spawnLoopCountByPlayer: { [number]: number } = {}

local function normalizedName(name: string): string
	return string.lower((string.gsub(name, "^%s*(.-)%s*$", "%1")))
end

local function isAnimatedTargetPart(petId: string, part: BasePart): boolean
	local name = normalizedName(part.Name)
	if petId == "pet_pink_butterfly" then
		return name == "butterflywing"
	elseif petId == "pet_glitched_dragon" then
		return name == "wingsfloatdrag"
	elseif petId == "pet_dark_winged_dragon" then
		return name == "wingsfloat"
	elseif petId == "pet_dark_falcon" then
		return string.find(name, "arm", 1, true) ~= nil
	end
	return false
end

local function getRootFolder(): Folder
	local root = Workspace:FindFirstChild(ROOT_FOLDER_NAME)
	if root and root:IsA("Folder") then
		return root
	end
	root = Instance.new("Folder")
	root.Name = ROOT_FOLDER_NAME
	root.Parent = Workspace
	return root
end

local function getPlayerFolder(player: Player): Folder
	local root = getRootFolder()
	local key = tostring(player.UserId)
	local folder = root:FindFirstChild(key)
	if folder and folder:IsA("Folder") then
		return folder
	end
	folder = Instance.new("Folder")
	folder.Name = key
	folder.Parent = root
	return folder
end

local function chooseRoot(model: Model): BasePart?
	local preferred = { "HumanoidRootPart", "Root", "RootPart", "Handle", "UpperTorso", "Torso", "LowerTorso" }
	for _, name in ipairs(preferred) do
		local p = model:FindFirstChild(name, true)
		if p and p:IsA("BasePart") then
			model.PrimaryPart = p
			return p
		end
	end

	local best: BasePart? = nil
	local bestVolume = -1
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			local n = normalizedName(d.Name)
			if n == "butterflywing" or n == "wingsfloatdrag" or n == "wingsfloat" then
				continue
			end
			local v = d.Size.X * d.Size.Y * d.Size.Z
			if v > bestVolume then
				bestVolume = v
				best = d
			end
		end
	end
	if best then
		model.PrimaryPart = best
	end
	return best
end

local function sanitizeParts(model: Model)
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			d.Anchored = false
			d.CanCollide = false
			d.CanQuery = false
			d.CanTouch = false
			d.Massless = true
		elseif d:IsA("Script") or d:IsA("LocalScript") then
			d:Destroy()
		end
	end
end

local function removePartJoints(model: Model, part: BasePart)
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("Motor6D") or d:IsA("Weld") or d:IsA("WeldConstraint") then
			local p0 = (d :: any).Part0
			local p1 = (d :: any).Part1
			if p0 == part or p1 == part then
				d:Destroy()
			end
		end
	end
end

local function hasJointForPart(model: Model, part: BasePart): boolean
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("Motor6D") or d:IsA("Weld") or d:IsA("WeldConstraint") then
			local p0 = (d :: any).Part0
			local p1 = (d :: any).Part1
			if p0 == part or p1 == part then
				return true
			end
		end
	end
	return false
end

local function ensureStaticWelds(model: Model, root: BasePart, skipParts: { [BasePart]: boolean })
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") and d ~= root and not skipParts[d] then
			if not hasJointForPart(model, d) then
				local wc = Instance.new("WeldConstraint")
				wc.Name = "_PetStaticWeld"
				wc.Part0 = root
				wc.Part1 = d
				wc.Parent = root
			end
		end
	end
end

local function enforceDarkGoblemFullAssembly(model: Model, root: BasePart)
	-- Dark Goblem is a static special pet now; force a rigid root assembly
	-- so no body chunks are left disconnected by legacy intra-model joints.
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") and d ~= root then
			removePartJoints(model, d)
			d.Anchored = false
			d.CanCollide = false
			d.CanQuery = false
			d.CanTouch = false
			d.Massless = true

			local wc = Instance.new("WeldConstraint")
			wc.Name = "_DarkGoblemFullBodyWeld"
			wc.Part0 = root
			wc.Part1 = d
			wc.Parent = root
		end
	end
end

local function getPartNameCounts(inst: Instance?): { [string]: number }
	local counts: { [string]: number } = {}
	if not inst then
		return counts
	end
	for _, d in ipairs(inst:GetDescendants()) do
		if d:IsA("BasePart") then
			counts[d.Name] = (counts[d.Name] or 0) + 1
		end
	end
	return counts
end

local function countParts(inst: Instance?): number
	local n = 0
	if not inst then
		return n
	end
	for _, d in ipairs(inst:GetDescendants()) do
		if d:IsA("BasePart") then
			n += 1
		end
	end
	return n
end

local function darkGoblemMissingParts(sourceInst: Instance?, equippedModel: Model): string
	local src = getPartNameCounts(sourceInst)
	local eq = getPartNameCounts(equippedModel)
	local missing: { string } = {}
	for name, sourceCount in pairs(src) do
		local equippedCount = eq[name] or 0
		if equippedCount < sourceCount then
			table.insert(missing, string.format("%s x%d", name, sourceCount - equippedCount))
		end
	end
	table.sort(missing)
	return (#missing > 0) and table.concat(missing, ", ") or "none"
end

local function getMaxDim(model: Model): number
	local _, size = model:GetBoundingBox()
	return math.max(size.X, size.Y, size.Z, 0.01)
end

local function ensurePinkButterflyVfxAttachment(model: Model, root: BasePart)
	if model:GetAttribute("_pinkVfxFixed") == true then
		return
	end

	local function asPath(inst: Instance?): string
		if not inst then
			return "nil"
		end
		local ok, full = pcall(function()
			return inst:GetFullName()
		end)
		return (ok and full) and full or inst.Name
	end

	local function isValidLocalAttachment(att: Attachment?): boolean
		if not att then
			return false
		end
		local parent = att.Parent
		return parent ~= nil and parent:IsA("BasePart") and att:IsDescendantOf(model)
	end

	local function findAttachmentCandidate(name: string?): Attachment?
		if type(name) ~= "string" or name == "" then
			return nil
		end
		for _, d in ipairs(model:GetDescendants()) do
			if d:IsA("Attachment") and d.Name == name and isValidLocalAttachment(d) then
				return d
			end
		end
		return nil
	end

	local function logPinkBeam(beam: Beam, valid: boolean, action: string)
		print(string.format(
			"[PinkButterflyBeam] beamValid=%s attachment0=%s attachment1=%s action=%s beam=%s",
			tostring(valid),
			asPath(beam.Attachment0),
			asPath(beam.Attachment1),
			action,
			asPath(beam)
		))
	end

	local anchor = root:FindFirstChild("VFX_Attachment")
	if anchor and not anchor:IsA("Attachment") then
		anchor:Destroy()
		anchor = nil
	end
	if not anchor then
		local newAnchor = Instance.new("Attachment")
		newAnchor.Name = "VFX_Attachment"
		-- Keep the effect attached near the butterfly body (not on ground).
		newAnchor.Position = Vector3.new(0, -0.35, -0.45)
		newAnchor.Parent = root
		anchor = newAnchor
	end

	-- Move invalid/orphan VFX under a rig-bound Attachment so it follows the pet.
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("Attachment") then
			local parent = d.Parent
			if not (parent and parent:IsA("BasePart")) then
				local hasVfxChild = false
				for _, child in ipairs(d:GetChildren()) do
					if child:IsA("ParticleEmitter") or child:IsA("Beam") or child:IsA("Trail") then
						hasVfxChild = true
						break
					end
				end
				if hasVfxChild then
					pcall(function()
						d.Parent = root
					end)
				end
			end
		elseif d:IsA("ParticleEmitter") then
			local hostPart = d:FindFirstAncestorWhichIsA("BasePart")
			local hostAttachment = d:FindFirstAncestorWhichIsA("Attachment")
			if not hostPart and not hostAttachment then
				pcall(function()
					d.Parent = anchor
				end)
			end
		end
	end

	-- Pink Butterfly only: strict beam validation/rebinding on the LIVE clone.
	for _, d in ipairs(model:GetDescendants()) do
		if not d:IsA("Beam") then
			continue
		end
		local beam = d
		local wantedEnabled = beam.Enabled
		beam.Enabled = false

		local action = "kept"
		local a0 = beam.Attachment0
		local a1 = beam.Attachment1
		local originalA0 = a0
		local originalA1 = a1

		if not isValidLocalAttachment(a0) then
			local rebound = findAttachmentCandidate(a0 and a0.Name or nil)
			if rebound then
				beam.Attachment0 = rebound
			end
		end
		if not isValidLocalAttachment(a1) then
			local rebound = findAttachmentCandidate(a1 and a1.Name or nil)
			if rebound then
				beam.Attachment1 = rebound
			end
		end

		a0 = beam.Attachment0
		a1 = beam.Attachment1
		if (a0 ~= originalA0) or (a1 ~= originalA1) then
			action = "rebound"
		end

		local validNow = isValidLocalAttachment(a0) and isValidLocalAttachment(a1)
		if not validNow then
			logPinkBeam(beam, false, "destroyed")
			beam:Destroy()
		else
			beam.Enabled = wantedEnabled
			logPinkBeam(beam, true, action)

			local alive = true
			local function enforceRuntime()
				if not alive or not beam.Parent then
					alive = false
					return
				end
				local ok = isValidLocalAttachment(beam.Attachment0) and isValidLocalAttachment(beam.Attachment1)
				if not ok then
					logPinkBeam(beam, false, "destroyed")
					alive = false
					beam:Destroy()
				end
			end
			beam:GetPropertyChangedSignal("Attachment0"):Connect(enforceRuntime)
			beam:GetPropertyChangedSignal("Attachment1"):Connect(enforceRuntime)
			if beam.Attachment0 then
				beam.Attachment0.AncestryChanged:Connect(enforceRuntime)
			end
			if beam.Attachment1 then
				beam.Attachment1.AncestryChanged:Connect(enforceRuntime)
			end
			beam.AncestryChanged:Connect(enforceRuntime)
		end
	end

	model:SetAttribute("_pinkVfxFixed", true)
end

local function getRigInstanceId(model: Model): string
	local existing = model:GetAttribute("RigInstanceGuid")
	if type(existing) == "string" and existing ~= "" then
		return existing
	end

	local guid: string? = nil
	local ok, generated = pcall(HttpService.GenerateGUID, HttpService, false)
	if ok and type(generated) == "string" and generated ~= "" then
		guid = generated
	else
		-- Fallback is runtime-safe and avoids plugin-only APIs.
		guid = string.format("%s|%s", model.Name, tostring(model))
	end

	pcall(function()
		model:SetAttribute("RigInstanceGuid", guid)
	end)
	return guid
end

local function applyDeterministicScale(model: Model, petId: string)
	local baselineScale = model:GetAttribute("_baselineScale")
	if type(baselineScale) ~= "number" then
		baselineScale = model:GetScale()
		model:SetAttribute("_baselineScale", baselineScale)
	end

	local baselineMaxDim = model:GetAttribute("_baselineMaxDim")
	if type(baselineMaxDim) ~= "number" then
		baselineMaxDim = getMaxDim(model)
		model:SetAttribute("_baselineMaxDim", baselineMaxDim)
	end

	local normalizeMul = TARGET_MAX_DIM / math.max(baselineMaxDim, 0.01)
	local finalMul = normalizeMul * (PET_SCALE_MULTIPLIER[petId] or 1.0)
	finalMul = math.clamp(finalMul, 0.05, SCALE_HARD_MAX)

	local targetScale = (baselineScale :: number) * finalMul
	targetScale = math.clamp(targetScale, 0.01, SCALE_HARD_MAX)

	model:ScaleTo(targetScale)
	model:SetAttribute("_appliedScale", targetScale)
	model:SetAttribute("_scaleAppliedOnce", true)

	local key = getRigInstanceId(model)
	_scaleApplyCountByModel[key] = (_scaleApplyCountByModel[key] or 0) + 1

	if DEBUG_SPECIAL_PET_RIG and TARGET_PETS[petId] then
		pcall(function()
			local _, box = model:GetBoundingBox()
			local primarySize = model.PrimaryPart and model.PrimaryPart.Size or Vector3.zero
			print(string.format(
				"[PetScaleDbg] pet=%s guid=%s scale=%.3f primarySize=<%.2f,%.2f,%.2f> bounds=<%.2f,%.2f,%.2f> appliedCount=%d",
				tostring(petId),
				key,
				targetScale,
				primarySize.X, primarySize.Y, primarySize.Z,
				box.X, box.Y, box.Z,
				_scaleApplyCountByModel[key]
			))
		end)
	end
end

local function motorFromRoot(root: BasePart, part: BasePart, name: string): Motor6D
	local m = Instance.new("Motor6D")
	m.Name = name
	m.Part0 = root
	m.Part1 = part
	m.C0 = root.CFrame:ToObjectSpace(part.CFrame)
	m.C1 = CFrame.new()
	m.Parent = root
	return m
end

local function findDarkGoblemHead(model: Model): BasePart?
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			local n = normalizedName(d.Name)
			if string.find(n, "head", 1, true) then
				return d
			end
			if d:FindFirstChild("Eyes") then
				return d
			end
		end
	end
	return nil
end

local function ensureDarkGoblemHead(model: Model, root: BasePart): BasePart?
	local head = findDarkGoblemHead(model)
	if not head then
		return nil
	end
	head.Transparency = math.min(head.Transparency, 0)
	head.Anchored = false

	local hasRootJoint = false
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("Weld") or d:IsA("WeldConstraint") or d:IsA("Motor6D") then
			local p0 = (d :: any).Part0
			local p1 = (d :: any).Part1
			if (p0 == root and p1 == head) or (p0 == head and p1 == root) then
				hasRootJoint = true
				break
			end
		end
	end
	if not hasRootJoint then
		local wc = Instance.new("WeldConstraint")
		wc.Name = "_PetHeadWeld"
		wc.Part0 = root
		wc.Part1 = head
		wc.Parent = root
	end
	return head
end

local function collectAnimatedParts(model: Model, petId: string): ({ BasePart }, { MotorInfo })
	local parts: { BasePart } = {}
	local motors: { MotorInfo } = {}
	local root = model.PrimaryPart
	if not root then
		return parts, motors
	end
	if STATIC_SPECIAL_PETS_NO_MOTOR[petId] then
		return parts, motors
	end

	local function addPart(part: BasePart, mode: "wing_h" | "wing_v" | "arm")
		if part == root then
			return
		end
		removePartJoints(model, part)
		part.Anchored = false
		local localPos = root.CFrame:PointToObjectSpace(part.Position)
		local sign = localPos.X >= 0 and 1 or -1
		local m = motorFromRoot(root, part, "_PetAnimMotor_" .. part.Name)
		pcall(function()
			m:SetAttribute("MotionRole", mode)
			m:SetAttribute("MotionTargetPart", part.Name)
		end)
		table.insert(parts, part)
		table.insert(motors, {
			motor = m,
			baseC0 = m.C0,
			mode = mode,
			sign = sign,
			wingRole = nil,
		})
	end

	local wantedMode: "wing_h" | "wing_v" | "arm" = "wing_h"
	if petId == "pet_glitched_dragon" or petId == "pet_dark_winged_dragon" then
		wantedMode = "wing_v"
	elseif petId == "pet_dark_falcon" then
		wantedMode = "arm"
	end

	local found = 0
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") and isAnimatedTargetPart(petId, d) then
			addPart(d, wantedMode)
			found += 1
		end
	end

	if found == 0 then
		if petId == "pet_pink_butterfly" then
			warn("[PetRigWarn] pet=Pink Butterfly missingPart=ButterFlyWing*")
		elseif petId == "pet_glitched_dragon" then
			warn("[PetRigWarn] pet=Glitched Dragon missingPart=WingsFloatDrag*")
		elseif petId == "pet_dark_winged_dragon" then
			warn("[PetRigWarn] pet=Music Winged Dragon missingPart=WingsFloat*")
		elseif petId == "pet_dark_falcon" then
			warn("[PetRigWarn] pet=Dark Goblem missingPart=*arm*")
		end
	end

	-- Pink Butterfly: motorsCreated=8 is too broad to animate as independent flappers.
	-- Mark one primary motor per side; all others are secondary followers.
	if petId == "pet_pink_butterfly" and #motors > 0 then
		local leftPrimary: MotorInfo? = nil
		local rightPrimary: MotorInfo? = nil
		local leftDist = -1
		local rightDist = -1
		for _, info in ipairs(motors) do
			local part = info.motor.Part1
			if part then
				local localPos = root.CFrame:PointToObjectSpace(part.Position)
				local lateral = math.abs(localPos.X)
				if info.sign < 0 then
					if lateral > leftDist then
						leftDist = lateral
						leftPrimary = info
					end
				else
					if lateral > rightDist then
						rightDist = lateral
						rightPrimary = info
					end
				end
			end
		end
		for _, info in ipairs(motors) do
			info.wingRole = "secondary"
		end
		if leftPrimary then
			leftPrimary.wingRole = "primary"
		end
		if rightPrimary then
			rightPrimary.wingRole = "primary"
		end
	end

	return parts, motors
end

local function debugLogWingRigDiagnostics(petId: string, motors: { MotorInfo })
	if not DEBUG_SPECIAL_PET_RIG then
		return
	end
	if petId ~= "pet_pink_butterfly" and petId ~= "pet_glitched_dragon" then
		return
	end
	local jointInfo: { string } = {}
	for _, info in ipairs(motors) do
		local m = info.motor
		local p0Name = m.Part0 and m.Part0.Name or "nil"
		local p1Name = m.Part1 and m.Part1.Name or "nil"
		local target = m.Part1 and isAnimatedTargetPart(petId, m.Part1) or false
		local attachedAtRest = false
		if m.Part0 and m.Part1 then
			local expected = (m.Part0.CFrame * m.C0 * m.Transform * m.C1:Inverse()).Position
			attachedAtRest = (expected - m.Part1.Position).Magnitude <= 0.2
		end
		table.insert(jointInfo, string.format(
			"%s parent=%s p0=%s p1=%s mode=%s target=%s restAttached=%s C0=%s C1=%s",
			m.Name,
			m.Parent and m.Parent.Name or "nil",
			p0Name,
			p1Name,
			info.mode,
			tostring(target),
			tostring(attachedAtRest),
			tostring(m.C0),
			tostring(m.C1)
		))
	end
	print(string.format("[PetWingRigDbg] pet=%s movingJoints=%d", petId, #motors))
	if #jointInfo > 0 then
		print("[PetWingRigDbg] joints:", table.concat(jointInfo, " | "))
	end
	if petId == "pet_glitched_dragon" then
		print("[PetWingRigDbg] glitchedMovingJointsChosen=true")
	end
end

local function ensurePinkFaceAttachment(model: Model, root: BasePart)
	local face = model:FindFirstChild("AnimatedFace", true)
	if not (face and face:IsA("BasePart")) then
		return
	end

	-- Ensure the face/body piece remains rigidly attached to the pet root.
	removePartJoints(model, face)
	local wc = Instance.new("WeldConstraint")
	wc.Name = "_PetPinkFaceWeld"
	wc.Part0 = root
	wc.Part1 = face
	wc.Parent = root
end

local function debugLogRigAssembly(
	model: Model,
	petId: string,
	motors: { MotorInfo },
	orientationApplied: boolean,
	headExists: boolean
)
	if not DEBUG_SPECIAL_PET_RIG or not TARGET_PETS[petId] then
		return
	end
	if model:GetAttribute("_rigAssemblyLogged") == true then
		return
	end

	local basePartList: { string } = {}
	local motorList: { string } = {}
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			table.insert(basePartList, d.Name .. "@" .. d:GetFullName())
		elseif d:IsA("Motor6D") then
			local p0 = d.Part0 and d.Part0.Name or "nil"
			local p1 = d.Part1 and d.Part1.Name or "nil"
			table.insert(motorList, string.format("%s p0=%s p1=%s parent=%s", d.Name, p0, p1, d.Parent and d.Parent.Name or "nil"))
		end
	end

	local resolvedMotors: { string } = {}
	for _, info in ipairs(motors) do
		local m = info.motor
		local p0 = m.Part0 and m.Part0.Name or "nil"
		local p1 = m.Part1 and m.Part1.Name or "nil"
		table.insert(resolvedMotors, string.format("%s(%s) p0=%s p1=%s", m.Name, info.mode, p0, p1))
	end

	pcall(function()
		print(string.format(
			"[PetRigDbg] pet=%s orientationApplied=%s headExists=%s resolvedMovingJoints=%d",
			petId,
			tostring(orientationApplied),
			tostring(headExists),
			#resolvedMotors
		))
		print("[PetRigDbg] movingJoints:", table.concat(resolvedMotors, " | "))
		print("[PetRigDbg] baseParts:", table.concat(basePartList, " | "))
		print("[PetRigDbg] motors:", table.concat(motorList, " | "))
	end)
	model:SetAttribute("_rigAssemblyLogged", true)
end

local function petDisplayName(petId: string): string
	local petDef = ItemCatalog.Pets and ItemCatalog.Pets[petId]
	if petDef and type(petDef.name) == "string" and petDef.name ~= "" then
		return petDef.name
	end
	return petId
end

local function resolveSource(petId: string): Instance?
	local petDef = ItemCatalog.Pets and ItemCatalog.Pets[petId]
	if not petDef then
		return nil
	end

	if type(petDef.modelPath) == "string" and petDef.modelPath ~= "" then
		local byPath = ItemModelRegistry.Get(petDef.modelPath)
		if byPath then
			return byPath
		end
	end

	if type(petDef.modelName) == "string" and petDef.modelName ~= "" then
		local byName = ItemModelRegistry.GetByExactName(petDef.modelName)
		if byName then
			return byName
		end
		local byAlias = ItemModelRegistry.Get(petDef.modelName)
		if byAlias then
			return byAlias
		end
	end

	return nil
end

local function destroyFor(player: Player)
	local entry = _active[player]
	if not entry then
		return
	end
	if entry.model and entry.model.Parent then
		entry.model:Destroy()
	end
	_active[player] = nil
end

local function makeRootWeld(ownerHrp: BasePart, root: BasePart): Weld
	local weld = Instance.new("Weld")
	weld.Name = "_PetRootWeld"
	weld.Part0 = ownerHrp
	weld.Part1 = root
	weld.C1 = CFrame.new()
	weld.C0 = CFrame.new(3, 2.8, 2)
	weld.Parent = ownerHrp
	return weld
end

local function spawnFor(player: Player, petId: string)
	if not TARGET_PETS[petId] then
		destroyFor(player)
		return
	end
	local existing = _active[player]
	if existing and existing.petId == petId and existing.model and existing.model.Parent then
		return
	end

	local char = player.Character
	local ownerHrp = char and char:FindFirstChild("HumanoidRootPart")
	if not ownerHrp or not ownerHrp:IsA("BasePart") then
		return
	end

	local source = resolveSource(petId)
	if not source then
		warn(TAG, "source not found for", petId)
		return
	end

	destroyFor(player)

	local cloneInst = source:Clone()
	local model: Model
	if cloneInst:IsA("Model") then
		model = cloneInst
	elseif cloneInst:IsA("BasePart") then
		model = Instance.new("Model")
		model.Name = cloneInst.Name
		cloneInst.Parent = model
		model.PrimaryPart = cloneInst
	else
		local firstPart = cloneInst:FindFirstChildWhichIsA("BasePart", true)
		if not firstPart then
			cloneInst:Destroy()
			return
		end
		model = Instance.new("Model")
		model.Name = cloneInst.Name
		cloneInst.Parent = model
		model.PrimaryPart = firstPart
	end

	model.Name = "_MotorPet_" .. player.Name
	model:SetAttribute("IsPet", true)
	model:SetAttribute("_petId", petId)
	model:SetAttribute("_owner", player.Name)
	model:SetAttribute("_serverMotorRig", true)
	model.Parent = getPlayerFolder(player)

	sanitizeParts(model)

	local root = chooseRoot(model)
	if not root then
		model:Destroy()
		return
	end
	model.PrimaryPart = root
	pcall(function() root:SetNetworkOwner(nil) end)

	applyDeterministicScale(model, petId)

	local animatedParts, motors = collectAnimatedParts(model, petId)
	local skip: { [BasePart]: boolean } = {}
	for _, p in ipairs(animatedParts) do
		skip[p] = true
	end
	if petId == "pet_pink_butterfly" then
		ensurePinkFaceAttachment(model, root)
	end
	ensureStaticWelds(model, root, skip)
	if petId == "pet_dark_falcon" then
		enforceDarkGoblemFullAssembly(model, root)
	end
	if petId == "pet_pink_butterfly" then
		ensurePinkButterflyVfxAttachment(model, root)
	end
	local head = if petId == "pet_dark_falcon" then ensureDarkGoblemHead(model, root) else nil

	local rootWeld = makeRootWeld(ownerHrp, root)
	root.CFrame = ownerHrp.CFrame * rootWeld.C0

	print(string.format("[PetRig] pet=%s root=%s motorsCreated=%d",
		petDisplayName(petId),
		root:GetFullName(),
		#motors))
	print(string.format("[PetAnim] pet=%s loopRunning=true", petDisplayName(petId)))
	print(string.format("[PetOrbit] pet=%s orbitEnabled=%s attachType=weld",
		petDisplayName(petId),
		tostring(ORBIT_PETS[petId] == true)))
	if petId == "pet_dark_falcon" then
		local sourceParts = countParts(source)
		local equippedParts = countParts(model)
		local missing = darkGoblemMissingParts(source, model)
		local result = if missing == "none" then "SUCCESS" else "FAIL"
		print(string.format("[DarkGoblemBuild] sourceParts=%d", sourceParts))
		print(string.format("[DarkGoblemBuild] equippedParts=%d", equippedParts))
		print(string.format("[DarkGoblemBuild] missingParts=%s", missing))
		print(string.format("[DarkGoblemBuild] result=%s", result))
	end
	if petId == "pet_glitched_dragon" then
		print("[PetAnimCfg] pet=pet_glitched_dragon flapDisabled=true")
	end
	debugLogRigAssembly(model, petId, motors, YAW_OVERRIDE_RAD[petId] ~= nil, head ~= nil)
	debugLogWingRigDiagnostics(petId, motors)

	_active[player] = {
		player = player,
		petId = petId,
		model = model,
		root = root,
		rootWeld = rootWeld,
		motors = motors,
		orbitEnabled = ORBIT_PETS[petId] == true,
		t0 = tick(),
		phase = (player.UserId % 37) * 0.17,
		animDebugLogged = false,
	}

	_spawnLoopCountByPlayer[player.UserId] = (_spawnLoopCountByPlayer[player.UserId] or 0) + 1
	if DEBUG_SPECIAL_PET_RIG then
		print(string.format(
			"[PetSpawnDbg] pet=%s loopsCreated=%d motors=%d orbit=%s",
			petDisplayName(petId),
			_spawnLoopCountByPlayer[player.UserId],
			#motors,
			tostring(ORBIT_PETS[petId] == true)
		))
	end
end

local function updateEntry(entry: ActiveEntry, dt: number)
	local player = entry.player
	local char = player.Character
	local ownerHrp = char and char:FindFirstChild("HumanoidRootPart")
	if not ownerHrp or not ownerHrp:IsA("BasePart") then
		return
	end
	if not entry.model.Parent or not entry.root.Parent then
		return
	end
	if not entry.rootWeld.Parent then
		return
	end

	local t = tick() - entry.t0

	local yaw = YAW_OVERRIDE_RAD[entry.petId] or 0
	if entry.orbitEnabled then
		local radius = 4.2
		local orbitSpeed = 0.9
		local bobAmp = 0.9
		local bobSpeed = 2.1
		local theta = t * orbitSpeed + entry.phase
		local x = math.cos(theta) * radius
		local z = math.sin(theta) * radius
		local y = 2.6 + math.sin(t * bobSpeed + entry.phase) * bobAmp
		entry.rootWeld.C0 = CFrame.new(x, y, z) * CFrame.Angles(0, yaw, 0)
	else
		if entry.petId == "pet_dark_falcon" then
			-- Dark Goblem: floating/bobbling idle at a fixed follow offset (no orbit).
			local sx = math.sin(t * DARK_GOBLEM_SWAY_SPEED + entry.phase) * DARK_GOBLEM_SWAY_AMP
			local sy = math.sin(t * DARK_GOBLEM_BOB_SPEED + entry.phase) * DARK_GOBLEM_BOB_AMP
			local sz = math.cos(t * (DARK_GOBLEM_SWAY_SPEED * 0.9) + entry.phase) * (DARK_GOBLEM_SWAY_AMP * 0.7)
			local yawBob = math.sin(t * 1.2 + entry.phase) * DARK_GOBLEM_YAW_BOB_AMP_RAD
			entry.rootWeld.C0 = CFrame.new(3 + sx, 2.8 + sy, 2 + sz) * CFrame.Angles(0, yaw + yawBob, 0)
		else
			entry.rootWeld.C0 = CFrame.new(3, 2.8, 2) * CFrame.Angles(0, yaw, 0)
		end
	end

	local applied = 0
	for _, info in ipairs(entry.motors) do
		if not info.motor.Parent or not info.motor.Part0 or not info.motor.Part1 then
			continue
		end
		if not info.motor.Part1:IsDescendantOf(entry.model) or info.motor.Part1.Anchored then
			continue
		end
		if not isAnimatedTargetPart(entry.petId, info.motor.Part1) then
			continue
		end
		if info.mode == "wing_h" then
			if entry.petId == "pet_pink_butterfly" then
				-- Pink Butterfly: explicit assembly groups, same direction sync.
				local flap = math.sin(t * PINK_BUTTERFLY_FLAP_SPEED) * PINK_BUTTERFLY_FLAP_AMP_RAD
				local ampMul = if info.wingRole == "secondary" then 0.55 else 1.0
				info.motor.C0 = CFrame.Angles(0, flap * ampMul, 0) * info.baseC0
			else
				local flap = math.sin(t * 8.0) * math.rad(35)
				info.motor.C0 = info.baseC0 * CFrame.Angles(0, flap, 0)
			end
			applied += 1
		elseif info.mode == "wing_v" then
			-- Music Winged Dragon reference behavior; Glitched Dragon shares this exactly.
			if entry.petId == "pet_glitched_dragon" then
				-- Explicit no-flap rule: keep orbit/spawn/orientation but no wing/arm motion updates.
				info.motor.C0 = info.baseC0
				continue
			end
			local flap = math.sin(t * 7.0) * math.rad(30)
			info.motor.C0 = info.baseC0 * CFrame.Angles(flap * info.sign, 0, 0)
			applied += 1
		elseif info.mode == "arm" then
			local sway = math.sin(t * 3.8 + info.sign * 0.2) * math.rad(18)
			info.motor.C0 = info.baseC0 * CFrame.Angles(0, 0, sway * info.sign)
			applied += 1
		end
	end

	if DEBUG_SPECIAL_PET_RIG and not entry.animDebugLogged and TARGET_PETS[entry.petId] then
		entry.animDebugLogged = true
		print(string.format(
			"[PetAnimDbg] pet=%s animationLoopStarted=true movingJoints=%d appliedThisTick=%d",
			entry.petId,
			#entry.motors,
			applied
		))
	end
end

local function syncFor(player: Player)
	local petId = player:GetAttribute("EquippedPet")
	if type(petId) ~= "string" or petId == "" then
		destroyFor(player)
		return
	end
	if not TARGET_PETS[petId] then
		destroyFor(player)
		return
	end

	local active = _active[player]
	if active and active.petId == petId and active.model.Parent then
		return
	end
	spawnFor(player, petId)
end

EquipRemote.OnServerEvent:Connect(function(player: Player, petId: string)
	if type(petId) ~= "string" then
		return
	end
	if not TARGET_PETS[petId] then
		return
	end
	if player:GetAttribute("EquippedPet") ~= petId then
		return
	end
	spawnFor(player, petId)
end)

UnequipRemote.OnServerEvent:Connect(function(player: Player)
	local equipped = player:GetAttribute("EquippedPet")
	if type(equipped) ~= "string" or equipped == "" or not TARGET_PETS[equipped] then
		destroyFor(player)
	end
end)

Players.PlayerAdded:Connect(function(player)
	player:GetAttributeChangedSignal("EquippedPet"):Connect(function()
		syncFor(player)
	end)
	player.CharacterAdded:Connect(function()
		task.wait(0.25)
		syncFor(player)
	end)
	player.CharacterRemoving:Connect(function()
		destroyFor(player)
	end)
	task.defer(function()
		syncFor(player)
	end)
end)

Players.PlayerRemoving:Connect(function(player)
	destroyFor(player)
end)

for _, player in ipairs(Players:GetPlayers()) do
	task.defer(function()
		syncFor(player)
	end)
	player:GetAttributeChangedSignal("EquippedPet"):Connect(function()
		syncFor(player)
	end)
	player.CharacterAdded:Connect(function()
		task.wait(0.25)
		syncFor(player)
	end)
	player.CharacterRemoving:Connect(function()
		destroyFor(player)
	end)
end

RunService.Heartbeat:Connect(function(dt)
	for player, entry in pairs(_active) do
		if not player.Parent then
			destroyFor(player)
		else
			updateEntry(entry, dt)
		end
	end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="99">
        <Properties>
          <string name="Name">SpinWheelBootstrap</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--[[
	SpinWheelBootstrap
	Server script that initializes the Spin The Wheel system.

	Creates:
	  • RemoteFunction: SpinWheel_GetData
	  • RemoteFunction: SpinWheel_RequestSpin
	  • RemoteFunction: SpinWheel_BuySpins
	  • ProximityPrompt on a ground-level invisible anchor near SpinTheWheel

	Also:
	  • Removes ClickDetectors from SpinTheWheel (no click-to-spin)
	  • Removes/disables embedded Scripts/LocalScripts (bad sound assets, old logic)
	  • Handles MarketplaceService.ProcessReceipt for Robux spin purchases

	FIX: ProximityPrompt is now on a dedicated invisible anchor Part at ground level
	     so the "Press E" UI is visible from all angles and distance measurements
	     are consistent between the prompt trigger and the auto-close check.

	Wires player join/leave for data persistence.
]]

local Players = game:GetService("Players")
local ServerScriptService = game:GetService("ServerScriptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local MarketplaceService = game:GetService("MarketplaceService")
local RunService = game:GetService("RunService")

-- Ensure Remotes folder
local remotesFolder = ReplicatedStorage:FindFirstChild("Remotes")
if not remotesFolder then
	remotesFolder = Instance.new("Folder")
	remotesFolder.Name = "Remotes"
	remotesFolder.Parent = ReplicatedStorage
end
local purchaseGrantedRE = remotesFolder:FindFirstChild("PurchaseGranted")
if not purchaseGrantedRE then
	purchaseGrantedRE = Instance.new("RemoteEvent")
	purchaseGrantedRE.Name = "PurchaseGranted"
	purchaseGrantedRE.Parent = remotesFolder
end

-- Create RemoteFunctions
local function ensureRemoteFunc(name: string): RemoteFunction
	local rf = remotesFolder:FindFirstChild(name)
	if not rf then
		rf = Instance.new("RemoteFunction")
		rf.Name = name
		rf.Parent = remotesFolder
	end
	return rf
end

local getDataRF    = ensureRemoteFunc("SpinWheel_GetData")
local requestSpinRF = ensureRemoteFunc("SpinWheel_RequestSpin")
local buySpinsRF    = ensureRemoteFunc("SpinWheel_BuySpins")
local canPurchaseGamepassRF = ensureRemoteFunc("CanPurchaseGamepassReward")

-- Load service + config
local Server = ServerScriptService:WaitForChild("Server")
local SpinWheelService = require(Server:WaitForChild("SpinWheelService"))

local Shared = ReplicatedStorage:WaitForChild("Shared")
local SpinWheelConfig = require(Shared:WaitForChild("SpinWheelConfig"))
local UIConfig = require(Shared:WaitForChild("UIConfig"))
local MonetizationConfig = require(Shared:WaitForChild("MonetizationConfig"))
local DeveloperProductConfig = require(Shared:WaitForChild("DeveloperProductConfig"))
local PerkCatalog = require(Shared:WaitForChild("PerkCatalog"))
local FreezePlayerProductService = require(Server:WaitForChild("FreezePlayerProductService"))
local ForceNextModeProductService = require(Server:WaitForChild("ForceNextModeProductService"))
local PerkProductService = require(Server:WaitForChild("PerkProductService"))

SpinWheelService.Init()
FreezePlayerProductService.Init()
ForceNextModeProductService.Init()
PerkProductService.Init()

-- Wire RemoteFunctions
getDataRF.OnServerInvoke = function(player)
	print("[SpinWheelBootstrap] GetData requested by", player.Name)
	return SpinWheelService.GetPlayerData(player)
end

requestSpinRF.OnServerInvoke = function(player)
	print("[SpinWheelBootstrap] RequestSpin from", player.Name)
	local result = SpinWheelService.RequestSpin(player)
	print("[SpinWheelBootstrap] RequestSpin result:", result.success, result.rewardName or result.reason or "")
	return result
end

buySpinsRF.OnServerInvoke = function(player, packageIndex)
	if type(packageIndex) ~= "number" then return { success = false, reason = "Invalid input" } end
	print("[SpinWheelBootstrap] BuySpins from", player.Name, "package:", packageIndex)
	return SpinWheelService.BuySpins(player, packageIndex)
end

-- Wire player events
Players.PlayerAdded:Connect(function(player)
	SpinWheelService.OnPlayerJoined(player)
end)

-- Handle players already in game (Studio)
for _, player in ipairs(Players:GetPlayers()) do
	task.spawn(function()
		SpinWheelService.OnPlayerJoined(player)
	end)
end

Players.PlayerRemoving:Connect(function(player)
	SpinWheelService.OnPlayerLeaving(player)
end)

-- Save all on shutdown
game:BindToClose(function()
	SpinWheelService.SaveAll()
end)

-- ═══════════════════════════════════════════════════════════════════
-- SHARED SERVICE REFERENCES (lazy-loaded)
-- ═══════════════════════════════════════════════════════════════════

local _InventoryService, _EconomyService, _CrateService, _ItemCatalog, _PlayerDataService, _GrantService, _StatService
local GAMEPASS_REWARD_MAP: { [number]: { type: string, [string]: any } }
local _BundleCatalog

local function getInventoryService()
	if not _InventoryService then
		_InventoryService = require(Server:WaitForChild("InventoryService", 5))
	end
	return _InventoryService
end

local function getEconomyService()
	if not _EconomyService then
		_EconomyService = require(Server:WaitForChild("EconomyService", 5))
	end
	return _EconomyService
end

local function getCrateService()
	if not _CrateService then
		_CrateService = require(Server:WaitForChild("CrateService", 5))
	end
	return _CrateService
end

local function getPlayerDataService()
	if not _PlayerDataService then
		_PlayerDataService = require(Server:WaitForChild("PlayerDataService", 5))
	end
	return _PlayerDataService
end

local function getGrantService()
	if not _GrantService then
		_GrantService = require(Server:WaitForChild("GrantService", 5))
	end
	return _GrantService
end

local function getStatService()
	if not _StatService then
		_StatService = require(Server:WaitForChild("StatService", 5))
	end
	return _StatService
end

local function getItemCatalog()
	if not _ItemCatalog then
		local SharedMod = ReplicatedStorage:FindFirstChild("Shared")
		if SharedMod then
			local mod = SharedMod:FindFirstChild("ItemCatalog")
			if mod then _ItemCatalog = require(mod) end
		end
	end
	return _ItemCatalog
end

local function getBundleCatalog()
	if not _BundleCatalog then
		local SharedMod = ReplicatedStorage:FindFirstChild("Shared")
		if SharedMod then
			local mod = SharedMod:FindFirstChild("BundleCatalog")
			if mod then _BundleCatalog = require(mod) end
		end
	end
	return _BundleCatalog
end

local function notifyClient(player: Player, reason: string, data: any?)
	local remotes = ReplicatedStorage:FindFirstChild("Remotes")
	local invUpdate = remotes and remotes:FindFirstChild("InventoryUpdated")
	if invUpdate then
		invUpdate:FireClient(player, reason, data)
	end
end

local function syncVipBundleEntitlement(player: Player, reward: { [string]: any }, source: string)
	if type(reward) ~= "table" or tostring(reward.bundleId or "") ~= "bundle_vip" then
		return
	end

	local stat = getStatService()
	if stat and type(stat.SetVipOwnership) == "function" then
		stat.SetVipOwnership(player, true, source)
	else
		player:SetAttribute("OwnsVIP", true)
	end

	print(string.format("[VIPSync] player=%s bundle=%s source=%s vip=true",
		player.Name, tostring(reward.bundleId), tostring(source)))
	warn(string.format("[VIPPersistence] player=%s vipBundleOwned=%s purchase=true",
		player.Name, tostring(player:GetAttribute("VIPBundleOwned") == true)))
end

local function isVipBundleReward(reward: { [string]: any }?): boolean
	return type(reward) == "table" and tostring(reward.bundleId or "") == "bundle_vip"
end

local function hasVipBundleEntitlement(player: Player): boolean
	local stat = getStatService()
	if stat and type(stat.HasVipEntitlement) == "function" then
		return stat.HasVipEntitlement(player) == true
	end

	return player:GetAttribute("VIPBundleOwned") == true or player:GetAttribute("OwnsVIP") == true
end

local function getGamepassPurchaseGate(player: Player, gamepassId: number): { allowed: boolean, alreadyOwned: boolean, vipOwned: boolean, marketplaceOwned: boolean, reason: string? }
	local reward = GAMEPASS_REWARD_MAP[gamepassId]
	if not reward then
		return {
			allowed = false,
			alreadyOwned = false,
			vipOwned = false,
			marketplaceOwned = false,
			reason = "UNKNOWN_GAMEPASS",
		}
	end

	local vipOwned = isVipBundleReward(reward) and hasVipBundleEntitlement(player)
	local marketplaceOwned = false
	local okOwns, owns = pcall(function()
		return MarketplaceService:UserOwnsGamePassAsync(player.UserId, gamepassId)
	end)
	if okOwns then
		marketplaceOwned = owns == true
	end

	local alreadyOwned = vipOwned or marketplaceOwned
	local reason = alreadyOwned and "ALREADY_OWNED" or nil
	warn(string.format(
		"[VIPPurchaseGate] player=%s gamepassId=%d vipOwned=%s marketplaceOwned=%s purchaseBlocked=%s",
		player.Name,
		gamepassId,
		tostring(vipOwned),
		tostring(marketplaceOwned),
		tostring(alreadyOwned)
	))

	return {
		allowed = not alreadyOwned,
		alreadyOwned = alreadyOwned,
		vipOwned = vipOwned,
		marketplaceOwned = marketplaceOwned,
		reason = reason,
	}
end

local function toRewardTypeFromCategory(category: string): string
	if category == "Crowns" then return "Crown" end
	if category == "Pets" then return "Pet" end
	if category == "IconImages" then return "IconImage" end
	return "Pet"
end

local function emitShopPurchaseGranted(player: Player, gamepassId: number, reward: { [string]: any })
	if reward.type == "Bundle" then
		return
	end
	local itemCatalog = getItemCatalog()
	local category = tostring(reward.category or "")
	local itemId = tostring(reward.itemId or "")
	local entry = itemCatalog and itemCatalog.Get and itemCatalog.Get(category, itemId) or nil
	local payload = {
		type = toRewardTypeFromCategory(category),
		id = itemId,
		category = category,
		name = entry and entry.name or tostring(reward.label or itemId),
		rarity = entry and entry.rarity or "Common",
		imageAssetId = entry and entry.image or "",
		source = "GamePass",
		gamepassId = gamepassId,
	}
	print(string.format("[ShopGrant] type=%s id=%s passId=%d result=SUCCESS",
		tostring(payload.type), itemId, tonumber(gamepassId) or 0))
	if purchaseGrantedRE then
		purchaseGrantedRE:FireClient(player, payload)
	end
end

-- ═══════════════════════════════════════════════════════════════════
-- CENTRAL PRODUCT_REWARD_MAP (Developer Products → rewards)
--
-- All Developer Product IDs and their reward logic in one table.
-- ProcessReceipt looks up productId here before falling back.
-- ═══════════════════════════════════════════════════════════════════

local PRODUCT_REWARD_MAP: { [number]: { type: string, [string]: any } } = {}

local function registerConfigProductReward(configId: string, reward: { type: string, [string]: any })
	local productId = MonetizationConfig.GetDeveloperProductId(configId)
	if type(productId) == "number" and productId > 0 then
		PRODUCT_REWARD_MAP[productId] = reward
	else
		warn(string.format("[PurchaseSystem] Missing developer product config for %s", configId))
	end
end

registerConfigProductReward("crate_crown_6", { type = "Crate", crateId = "crate_crown",      quantity = 6, label = "6 Crown Crates" })
registerConfigProductReward("crate_pet_common_6", { type = "Crate", crateId = "crate_pet_common", quantity = 6, label = "6 Common Pet Crates" })
registerConfigProductReward("crate_pet_rare_6", { type = "Crate", crateId = "crate_pet_rare",   quantity = 6, label = "6 Rare Pet Crates" })
registerConfigProductReward("crate_pet_epic_6", { type = "Crate", crateId = "crate_pet_epic",   quantity = 6, label = "6 Epic Pet Crates" })

local freezeProductId = tonumber(DeveloperProductConfig.FreezePlayer.productId) or 0
if freezeProductId > 0 then
	PRODUCT_REWARD_MAP[freezeProductId] = {
		type = "FreezePlayer",
		label = tostring(DeveloperProductConfig.FreezePlayer.name or "Freeze Player"),
	}
else
	warn("[PurchaseSystem] FreezePlayer productId is not configured (>0 required)")
end

local forceNextModeProductId = tonumber(DeveloperProductConfig.ForceNextMode.productId) or 0
if forceNextModeProductId > 0 then
	PRODUCT_REWARD_MAP[forceNextModeProductId] = {
		type = "ForceNextMode",
		label = tostring(DeveloperProductConfig.ForceNextMode.name or "FORCE NEXT MODE!"),
	}
else
	warn("[PurchaseSystem] ForceNextMode productId is not configured (>0 required)")
end

local function registerAbilityProduct(configKey: string, abilityId: string)
	local config = DeveloperProductConfig[configKey]
	local productId = config and tonumber(config.productId) or 0
	if productId > 0 then
		PRODUCT_REWARD_MAP[productId] = {
			type = "Ability",
			abilityId = abilityId,
			label = tostring(config.name or abilityId),
		}
	else
		warn(string.format("[PurchaseSystem] %s productId is not configured (>0 required)", configKey))
	end
end

registerAbilityProduct("PerkSpeed", PerkCatalog.Speed.id)
registerAbilityProduct("PerkJump", PerkCatalog.Jump.id)

-- Auto-populate Fate Coin developer products from UIConfig (single source for shop UI + receipts)
for _, item in ipairs(UIConfig.MockPremiumItems or {}) do
	if item.type == "Currency" and type(item.productId) == "number" and item.productId > 0 then
		local amount = tonumber(item.coinsAmount) or 0
		if amount > 0 then
			PRODUCT_REWARD_MAP[item.productId] = {
				type = "Coins",
				amount = amount,
				label = tostring(item.name or (tostring(amount) .. " Fate Coins")),
			}
		end
	end
end

-- Auto-populate spin products from config
for _, pkg in ipairs(SpinWheelConfig.SpinPrices) do
	if pkg.productId and pkg.productId > 0 then
		PRODUCT_REWARD_MAP[pkg.productId] = { type = "Spins", amount = pkg.spins, label = pkg.label }
	end
end

print(string.format("[PurchaseSystem] PRODUCT_REWARD_MAP built: %d entries", (function()
	local n = 0; for _ in pairs(PRODUCT_REWARD_MAP) do n += 1 end; return n
end)()))

local function validateConfiguredRobuxProducts()
	-- Coins from shop config
	for _, entry in ipairs(UIConfig.MockPremiumItems or {}) do
		if entry.type == "Currency" and type(entry.productId) == "number" and entry.productId > 0 then
			if not PRODUCT_REWARD_MAP[entry.productId] then
				warn(string.format("[ReceiptMap] Missing mapping for coin productId=%d (%s)",
					entry.productId, tostring(entry.id)))
			end
		end
	end

	-- Crates from crate shop config
	for _, crate in ipairs(UIConfig.MockCrates or {}) do
		for _, price in ipairs(crate.prices or {}) do
			if price.currency == "Robux" and type(price.productId) == "number" and price.productId > 0 then
				if not PRODUCT_REWARD_MAP[price.productId] then
					warn(string.format("[ReceiptMap] Missing mapping for crate productId=%d (%s)",
						price.productId, tostring(crate.id)))
				end
			end
		end
	end

	-- Spins from spin config
	for _, pkg in ipairs(SpinWheelConfig.SpinPrices or {}) do
		if type(pkg.productId) == "number" and pkg.productId > 0 then
			if not PRODUCT_REWARD_MAP[pkg.productId] then
				warn(string.format("[ReceiptMap] Missing mapping for spin productId=%d (%s)",
					pkg.productId, tostring(pkg.label)))
			end
		end
	end
end

validateConfiguredRobuxProducts()

-- ═══════════════════════════════════════════════════════════════════
-- GAMEPASS_REWARD_MAP (Gamepasses → permanent unlocks)
--
-- Maps gamepassId → item category + id for granting via InventoryService.
-- Bundles map to a list of items to grant.
-- ═══════════════════════════════════════════════════════════════════

GAMEPASS_REWARD_MAP = {}

local function registerGamePassReward(configId: string, reward: { type: string, [string]: any })
	local gamepassId = MonetizationConfig.GetGamePassId(configId)
	if type(gamepassId) == "number" and gamepassId > 0 then
		GAMEPASS_REWARD_MAP[gamepassId] = reward
	else
		warn(string.format("[PurchaseSystem] Missing gamepass config for %s", configId))
	end
end

registerGamePassReward("pet_dark_falcon", { type = "Pet", category = "Pets", itemId = "pet_dark_falcon", label = "Dark Goblem" })
registerGamePassReward("pet_dark_winged_dragon", { type = "Pet", category = "Pets", itemId = "pet_dark_winged_dragon", label = "Music Winged Dragon" })
