local _DQS = nil
local function getDQS()
	if _DQS ~= nil then return _DQS end
	local ok, mod = pcall(require, Server:FindFirstChild("DailyQuestService"))
	if ok and mod then _DQS = mod else _DQS = false end
	return _DQS
end

local _Feedback = nil
local function getFeedback()
	if _Feedback ~= nil then return _Feedback end
	local ok, mod = pcall(require, Server:FindFirstChild("MatchFeedbackService"))
	if ok and mod then _Feedback = mod else _Feedback = false end
	return _Feedback
end

--[[ CONFIGURATION ]]
local Config = {
	EndingSeconds = 7,
	MinPlayersToStart = 1,
	DebugLog = true,
}
local FIRST_MATCH_BONUS_COINS = 100

--[[ INTERNAL STATE ]]
local currentState: string = MatchState.States.Intermission
local phaseEndTime: number = 0
local initialized = false
local loopRunning = false
local currentMode: string = "Normal"

local replicatedState: StringValue = nil
local replicatedRound: IntValue = nil
local replicatedRoundPhase: StringValue = nil
local replicatedPhaseEnd: NumberValue = nil
local replicatedMovementCountdownVisible: BoolValue = nil
local replicatedMovementCountdownEndTime: NumberValue = nil
local replicatedMode: StringValue = nil
local replicatedVoteActive: BoolValue = nil
local replicatedVoteEndTime: NumberValue = nil
local replicatedVoteLocked: BoolValue = nil
local replicatedVoteLockedMode: StringValue = nil
local matchResultsEvent: RemoteEvent = nil
local abilityActivationWarningRemote: RemoteEvent = nil

-- Vote state
local voteRemote: RemoteEvent = nil
local votes: { [Player]: string } = {}
local voteActive = false
local voteLocked = false
local lockedVoteMode: string? = nil
local lockedVoteReceiptKey: string? = nil
local lockedVoteUpcomingMatchId = 0

type PendingForcedModeReservation = {
	receiptKey: string,
	forcedMode: string,
	upcomingMatchId: number,
}

local pendingForcedModeReservation: PendingForcedModeReservation? = nil

local MatchManager = {}

--[[ HELPERS ]]

-- Get the surrounding crown milestones for a given win count
local function getMilestoneContext(wins: number)
	local milestones = ItemCatalog.LevelCrownMilestones
	local prev, next_ = nil, nil
	for _, m in ipairs(milestones) do
		if m.wins <= wins then prev = m end
		if m.wins > wins and not next_ then next_ = m end
	end
	if not prev then prev = { wins = 0, crownId = "" } end
	return prev, next_
end

local function log(...)
	if Config.DebugLog then
		print("[MatchManager]", ...)
	end
end

local function getServerTime(): number
	return workspace:GetServerTimeNow()
end

-- GLBS direct call (lazy require, no BindableEvent)
local _GLBS = nil
local function getGLBS()
	if _GLBS ~= nil then return _GLBS end
	local ok, mod = pcall(function()
		return require(Server:WaitForChild("GlobalLeaderboardService", 10))
	end)
	if ok and mod then
		_GLBS = mod
		warn("[MatchManager] GLBS loaded via direct require")
	else
		_GLBS = false
		warn("[MatchManager] GLBS not available:", tostring(mod))
	end
	return _GLBS
end

local function reportStats(userId: number, username: string, updates: { [string]: number })
	local GLBS = getGLBS()
	if not GLBS or GLBS == false then return end

	for statKey, value in pairs(updates) do
		local callOk, callErr = pcall(function()
			GLBS.ReportStatById(userId, statKey, value)
		end)
		if callOk then
			log(string.format("DIRECT CALL OK: ReportStatById(%d, '%s', %d)", userId, statKey, value))
		else
			warn(string.format("[MatchManager] DIRECT CALL FAILED: ReportStatById(%d, '%s', %d) err=%s",
				userId, statKey, value, tostring(callErr)))
		end
	end
end

local function isCanonicalMatchEndReason(reason: string?): boolean
	return reason == "Winner" or reason == "NoWinners" or reason == "CapReached"
end

-- Mode Vote helpers

local function getVoteCounts(): (number, number)
	local normal, brainrot = 0, 0
	for voter, choice in pairs(votes) do
		if voter and voter.Parent and voter:GetAttribute("TutorialCompleted") == true and not PlayerStateService.IsAFK(voter) then
			if choice == "Normal" then
				normal = normal + 1
			elseif choice == "Brainrot" then
				brainrot = brainrot + 1
			end
		end
	end
	return normal, brainrot
end

local function broadcastVoteCounts()
	if not voteRemote then return end
	local normal, brainrot = getVoteCounts()
	for _, player in ipairs(MatchManager.GetEligiblePlayers()) do
		voteRemote:FireClient(player, "Update", { normal = normal, brainrot = brainrot })
	end
end

local function setReplicatedVoteLockState(locked: boolean, forcedMode: string?)
	if replicatedVoteLocked then
		replicatedVoteLocked.Value = locked
	end
	if replicatedVoteLockedMode then
		replicatedVoteLockedMode.Value = if locked and type(forcedMode) == "string" then forcedMode else ""
	end
end

local function clearCurrentVoteLockState()
	voteLocked = false
	lockedVoteMode = nil
	lockedVoteReceiptKey = nil
	lockedVoteUpcomingMatchId = 0
	setReplicatedVoteLockState(false, nil)
end

local function startVote()
	votes = {}
	clearCurrentVoteLockState()

	local upcomingMatchId = EliminationTracker.GetMatchId() + 1
	local forcedEntry = ForceNextModeProductService.PeekEligibleForUpcomingMatch(upcomingMatchId)
	voteLocked = forcedEntry ~= nil
	voteActive = not voteLocked

	if voteLocked and forcedEntry then
		lockedVoteMode = forcedEntry.requestedMode
		lockedVoteReceiptKey = forcedEntry.receiptKey
		lockedVoteUpcomingMatchId = upcomingMatchId
		setReplicatedVoteLockState(true, lockedVoteMode)
	end

	-- Replicate vote-active state so late-joining / slow clients can catch up
	if replicatedVoteActive then
		replicatedVoteActive.Value = true
	end
	if replicatedVoteEndTime then
		replicatedVoteEndTime.Value = phaseEndTime
	end

	if voteRemote then
		for _, player in ipairs(MatchManager.GetEligiblePlayers()) do
			voteRemote:FireClient(player, "Start", {
				locked = voteLocked,
				forcedMode = lockedVoteMode,
			})
		end
	end

	if voteLocked and forcedEntry then
		log(string.format(
			"[ModeVoteLocked] upcomingMatchId=%d mode=%s receipt=%s purchaser=%s",
			upcomingMatchId,
			tostring(lockedVoteMode),
			tostring(lockedVoteReceiptKey),
			forcedEntry.purchaserName
		))
	else
		log("Mode vote started")
	end
end

local function endVote(): string
	voteActive = false

	-- Clear replicated vote state
	if replicatedVoteActive then
		replicatedVoteActive.Value = false
	end
	if replicatedVoteEndTime then
		replicatedVoteEndTime.Value = 0
	end

	local normal = 0
	local brainrot = 0
	local result = "Normal"
	local wasLocked = voteLocked and lockedVoteMode ~= nil and lockedVoteReceiptKey ~= nil
	if wasLocked then
		result = lockedVoteMode or "Normal"
		pendingForcedModeReservation = {
			receiptKey = lockedVoteReceiptKey or "",
			forcedMode = result,
			upcomingMatchId = lockedVoteUpcomingMatchId,
		}
	else
		normal, brainrot = getVoteCounts()
		if brainrot > normal then
			result = "Brainrot"
		end
	end
	currentMode = result

	if replicatedMode then
		replicatedMode.Value = result
	end

	if voteRemote then
		for _, player in ipairs(Players:GetPlayers()) do
			voteRemote:FireClient(player, "End", {
				winner = result,
				normal = normal,
				brainrot = brainrot,
				locked = wasLocked,
				forcedMode = if wasLocked then result else nil,
			})
		end
	end

	votes = {}
	if wasLocked then
		log(string.format(
			"[ModeVoteLockedResult] mode=%s receipt=%s upcomingMatchId=%d",
			result,
			tostring(lockedVoteReceiptKey),
			lockedVoteUpcomingMatchId
		))
	else
		log(string.format("Mode vote ended - %s wins (Normal=%d, Brainrot=%d)", result, normal, brainrot))
	end
	clearCurrentVoteLockState()
	return result
end

local function replicatePhaseEnd(absoluteServerTime: number)
	if replicatedPhaseEnd then
		replicatedPhaseEnd.Value = absoluteServerTime
		log(string.format("Replicated PhaseEndTime -> %.3f", replicatedPhaseEnd.Value))
	else
		log("replicatedPhaseEnd is nil - skipping replication")
	end
end

local function isIntermissionCountdownActive(): boolean
	return currentState == MatchState.States.Intermission and phaseEndTime > getServerTime()
end

local function replicateRound(round: number)
	if replicatedRound then
		replicatedRound.Value = round
		log(string.format("Replicated Round -> %d", round))
	else
		log("replicatedRound is nil - skipping replication")
	end
end

local function restoreEnvironment(context: string?)
	local ctx = if type(context) == "string" and context ~= "" then context else "unknown"
	log(string.format("[EnvRestore] context=%s", ctx))
	ModeLightingService.RestoreDefault()
	MapManager.RestoreDefaultMap()
end

local function applyEnvironmentForMode(modeName: string)
	local mode = if type(modeName) == "string" and modeName ~= "" then modeName else "Normal"
	log(string.format("[EnvApply] selectedMode=%s", mode))
	MapManager.ConfigureForMode(mode)
	ModeLightingService.ApplyForMode(mode)
end

local function setMatchState(newState: string)
	if not MatchState.IsValid(newState) then
		warn("[MatchManager] Invalid state:", newState)
		return
	end
	
	if currentState == newState then
		return
	end
	
	local oldState = currentState
	currentState = newState
	log(string.format("State: %s -> %s", oldState, newState))

	if replicatedState then
		replicatedState.Value = newState
	end
end

-- Force-unseat: detach player from any seat before teleport
local function forceUnseat(player: Player): boolean
	local character = player.Character
	if not character then return false end
	
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then return false end
	
	local wasSeated = humanoid.SeatPart ~= nil
		or humanoid:GetState() == Enum.HumanoidStateType.Seated
		or humanoid.Sit
	
	if wasSeated then
		humanoid.Sit = false
		humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
		humanoid.PlatformStand = false
	end
	
	return wasSeated
end

local function safeTeleport(player: Player, targetCFrame: CFrame): boolean
	local character = player.Character
	if not character then return false end
	
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local rootPart = character:FindFirstChild("HumanoidRootPart")
	
	if not humanoid or not rootPart then return false end
	if humanoid.Health <= 0 then return false end
	
	rootPart.CFrame = targetCFrame
	rootPart.AssemblyLinearVelocity = Vector3.zero
	rootPart.AssemblyAngularVelocity = Vector3.zero
	
	return true
end

local function restoreLobbyHealth(player: Player)
	local character = player.Character
	if not character then
		return
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end
	if humanoid.MaxHealth <= 0 then
		return
	end
	local before = humanoid.Health
	humanoid.Health = humanoid.MaxHealth
	log(string.format("Lobby health restore: %s %.0f->%.0f", player.Name, before, humanoid.Health))
end

local function teleportPlayersToArena(players: { Player })
	if #players == 0 then return end
	
	local spawnCFrames = MapManager.GetArenaSpawnCFrames(#players)
	if #spawnCFrames == 0 then
		warn("[MatchManager] No arena spawn CFrames available")
		return
	end
	
	-- Force all players to stand up before teleporting (fixes chair/seat bug)
	local unseatedAny = false
	for _, player in ipairs(players) do
		if forceUnseat(player) then
			unseatedAny = true
		end
	end
	
	-- Brief wait so Roblox properly detaches seats from characters
	if unseatedAny then
		task.wait(0.15)
	end
	
	local teleported = 0
	
	for i, player in ipairs(players) do
		local spawnCFrame = spawnCFrames[((i - 1) % #spawnCFrames) + 1]
		
		if safeTeleport(player, spawnCFrame) then
			teleported = teleported + 1
			
			-- Post-teleport verify: ensure player is not still seated
			task.spawn(function()
				task.wait(0.1)
				local character = player.Character
				if character then
					local humanoid = character:FindFirstChildOfClass("Humanoid")
					if humanoid and (humanoid.Sit or humanoid.SeatPart ~= nil) then
						humanoid.Sit = false
						humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
						humanoid.PlatformStand = false
					end
				end
			end)
		else
			task.spawn(function()
				for _ = 1, SpawnConfig.MaxTeleportRetries do
					task.wait(SpawnConfig.TeleportRetryDelay)
					if safeTeleport(player, spawnCFrame) then
						break
					end
				end
			end)
		end
	end
	
	log(string.format("Teleported %d players to Arena", teleported))
end

local function formatPlayerNames(players: { Player }): string
	if #players == 0 then
		return "none"
	end

	local names = {}
	for _, player in ipairs(players) do
		table.insert(names, player.Name)
	end
	return table.concat(names, ",")
end

local function logMatchEntrySnapshot(tag: string, player: Player, included: boolean, reason: string)
	local state = PlayerStateService.GetState(player)
	local isAFK = PlayerStateService.IsAFK(player)
	local pendingAbility = PerkMatchEffectService.GetPendingAbility(player)
	local activeAbility = PerkMatchEffectService.GetActiveAbility(player)
	log(string.format(
		"[%s] player=%s state=%s afk=%s pendingAbility=%s activeMatchAbility=%s included=%s reason=%s",
		tag,
		player.Name,
		tostring(state),
		tostring(isAFK),
		tostring(pendingAbility),
		tostring(activeAbility),
		tostring(included),
		reason
	))
end

local function getParticipantRejectReason(player: Player): string?
	if not player or not player.Parent then
		return "unknown"
	end
	if player:GetAttribute("TutorialCompleted") ~= true then
		return "tutorial incomplete"
	end
	if PlayerStateService.IsAFK(player) then
		return "AFK"
	end

	local state = PlayerStateService.GetState(player)
	if state ~= PlayerState.States.Waiting then
		return "invalid state"
	end

	return nil
end

local function collectWaitingParticipants(): ({ Player }, { { player: Player, reason: string } })
	local waitingPlayers = PlayerStateService.GetPlayersInState(PlayerState.States.Waiting)
	log(string.format("[MatchCandidates] count=%d names=%s", #waitingPlayers, formatPlayerNames(waitingPlayers)))

	local accepted = {}
	local rejected = {}
	for _, player in ipairs(waitingPlayers) do
		local rejectReason = getParticipantRejectReason(player)
		if rejectReason then
			table.insert(rejected, {
				player = player,
				reason = rejectReason,
			})
			log(string.format("[MatchCandidate] player=%s result=rejected reason=%s", player.Name, rejectReason))
			logMatchEntrySnapshot("FinalParticipantFilter", player, false, rejectReason)
		else
			table.insert(accepted, player)
			log(string.format("[MatchCandidate] player=%s result=accepted reason=accepted", player.Name))
			logMatchEntrySnapshot("FinalParticipantFilter", player, true, "accepted")
		end
	end

	log(string.format("[MatchCandidatesFinalFilter] accepted=%d rejected=%d names=%s",
		#accepted,
		#rejected,
		formatPlayerNames(accepted)
	))
	return accepted, rejected
end

local function ensureCharacterReadyForCommit(player: Player): (Model?, Humanoid?, BasePart?, string)
	local character = player.Character
	if not character then
		local ok = pcall(function()
			player:LoadCharacter()
		end)
		if not ok then
			return nil, nil, nil, "load_character_failed"
		end
		character = player.Character or player.CharacterAdded:Wait()
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid") or character:WaitForChild("Humanoid", 5)
	local rootPart = character:FindFirstChild("HumanoidRootPart") or character:WaitForChild("HumanoidRootPart", 5)
	if not humanoid or not rootPart or not rootPart:IsA("BasePart") then
		return character, nil, nil, "character_not_ready"
	end
	if humanoid.Health <= 0 then
		return character, humanoid, rootPart, "not_alive_for_commit"
	end
	return character, humanoid, rootPart, "ready"
end

local function teleportPlayerToArenaWithRetry(player: Player, targetCFrame: CFrame): (boolean, string)
	local attempts = math.max(1, SpawnConfig.MaxTeleportRetries + 1)
	for attempt = 1, attempts do
		if safeTeleport(player, targetCFrame) then
			return true, string.format("attempt_%d", attempt)
		end
		if attempt < attempts then
			task.wait(SpawnConfig.TeleportRetryDelay)
		end
	end
	return false, "teleport failure"
end

local function commitWaitingParticipantsToMatch(): ({ Player }, string?)
	local accepted = collectWaitingParticipants()
	if #accepted == 0 then
		log(string.format("[MatchCommitAbort] reason=%s accepted=0 minRequired=%d", "no_valid_participants", Config.MinPlayersToStart))
		return {}, "no_valid_participants"
	end

	local spawnCFrames = MapManager.GetArenaSpawnCFrames(#accepted)
	if #spawnCFrames == 0 then
		for _, player in ipairs(accepted) do
			log(string.format("[MatchCandidate] player=%s result=rejected reason=%s", player.Name, "map/spawn unavailable"))
		end
		log(string.format("[MatchCommitAbort] reason=%s accepted=%d minRequired=%d", "map/spawn unavailable", #accepted, Config.MinPlayersToStart))
		return {}, "map/spawn unavailable"
	end

	local unseatedAny = false
	for _, player in ipairs(accepted) do
		if forceUnseat(player) then
			unseatedAny = true
		end
	end
	if unseatedAny then
		task.wait(0.15)
	end

	local committed = {}
	for index, player in ipairs(accepted) do
		local currentState = PlayerStateService.GetState(player)
		if currentState ~= PlayerState.States.Waiting then
			log(string.format("[MatchCandidate] player=%s result=rejected reason=%s", player.Name, "stale round data"))
			logMatchEntrySnapshot("ParticipantCommit", player, false, "stale round data")
			continue
		end
		local _, _, _, readinessDetail = ensureCharacterReadyForCommit(player)
		if readinessDetail ~= "ready" then
			log(string.format("[MatchCandidate] player=%s result=rejected reason=%s", player.Name, readinessDetail))
			logMatchEntrySnapshot("ParticipantCommit", player, false, readinessDetail)
			continue
		end
		log(string.format(
			"[MatchPlayerStatePreTeleport] player=%s state=%s pendingAbility=%s activeAbility=%s",
			player.Name,
			tostring(currentState),
			tostring(PerkMatchEffectService.GetPendingAbility(player)),
			tostring(PerkMatchEffectService.GetActiveAbility(player))
		))

		local spawnCFrame = spawnCFrames[((index - 1) % #spawnCFrames) + 1]
		log(string.format("[MatchTeleportStart] player=%s index=%d target=(%.1f, %.1f, %.1f)",
			player.Name,
			index,
			spawnCFrame.Position.X,
			spawnCFrame.Position.Y,
			spawnCFrame.Position.Z
		))
		local teleported, detail = teleportPlayerToArenaWithRetry(player, spawnCFrame)
		if not teleported then
			log(string.format("[MatchCandidate] player=%s result=rejected reason=%s", player.Name, detail))
			logMatchEntrySnapshot("ParticipantCommit", player, false, detail)
			continue
		end

		log(string.format("[MatchTeleportSuccess] player=%s detail=%s", player.Name, detail))
		PlayerStateService.SetState(player, PlayerState.States.InMatch)
		log(string.format(
			"[MatchPlayerCommitted] player=%s state=%s pendingAbility=%s activeAbility=%s",
			player.Name,
			tostring(PlayerStateService.GetState(player)),
			tostring(PerkMatchEffectService.GetPendingAbility(player)),
			tostring(PerkMatchEffectService.GetActiveAbility(player))
		))
		logMatchEntrySnapshot("ParticipantCommit", player, true, "teleported_and_committed")
		table.insert(committed, player)
	end

	log(string.format("[MatchParticipantsCommitted] count=%d names=%s", #committed, formatPlayerNames(committed)))
	if #committed < Config.MinPlayersToStart then
		log(string.format("[MatchCommitAbort] reason=%s committed=%d minRequired=%d initialAccepted=%d",
			"below_min_players_after_filter",
			#committed,
			Config.MinPlayersToStart,
			#accepted
		))
		return committed, "below_min_players_after_filter"
	end

	return committed, nil
end

local function teleportPlayersToLobby(players: { Player })
	if #players == 0 then return end
	if not SpawnConfig.ReturnToLobbyOnEnd then return end
	
	local lobbyCFrame = MapManager.GetLobbySpawnCFrame()
	local teleported = 0
	
	for i, player in ipairs(players) do
		local offset = Vector3.new(
			(i % 5 - 2) * 3,
			0,
			math.floor(i / 5) * 3
		)
		local targetCFrame = lobbyCFrame + offset
		
		if safeTeleport(player, targetCFrame) then
			teleported = teleported + 1
			restoreLobbyHealth(player)
		else
			task.spawn(function()
				for _ = 1, SpawnConfig.MaxTeleportRetries do
					task.wait(SpawnConfig.TeleportRetryDelay)
					if safeTeleport(player, targetCFrame) then
						restoreLobbyHealth(player)
						break
					end
				end
			end)
		end
	end
	
	log(string.format("Returned %d players to Lobby spawn", teleported))
end

local function fireAbilityActivationWarnings(players: { Player })
	if not abilityActivationWarningRemote then
		return
	end

	for _, player in ipairs(players) do
		if player and player.Parent then
			local message = PerkMatchEffectService.GetPendingAbilityActivationMessage(player)
			if message then
				abilityActivationWarningRemote:FireClient(player, message)
			end
		end
	end
end

local function forceVoteClosedForMatchStart(context: string)
	if replicatedVoteActive then
		replicatedVoteActive.Value = false
	end
	if replicatedVoteEndTime then
		replicatedVoteEndTime.Value = 0
	end
	clearCurrentVoteLockState()
	log(string.format("[ModeVoteForceClosed] context=%s active=false", context))
end

function MatchManager.GetEligiblePlayers(): { Player }
	local eligible = {}
	
	for _, player in ipairs(Players:GetPlayers()) do
		local state = PlayerStateService.GetState(player)
		local isAFK = PlayerStateService.IsAFK(player)
		local tutorialCompleted = player:GetAttribute("TutorialCompleted") == true
		
		if tutorialCompleted and not isAFK and (state == PlayerState.States.Lobby or state == PlayerState.States.Waiting) then
			table.insert(eligible, player)
		end
	end
	
	return eligible
end

local function setEligibleToWaiting()
	local eligible = MatchManager.GetEligiblePlayers()
	for _, player in ipairs(eligible) do
		local state = PlayerStateService.GetState(player)
		if state == PlayerState.States.Lobby then
			PlayerStateService.SetState(player, PlayerState.States.Waiting)
		end
	end
end

local function setMatchPlayersToLobby()
	local inMatchPlayers = PlayerStateService.GetPlayersInState(PlayerState.States.InMatch)
	
	if #inMatchPlayers == 0 then
		log("No remaining InMatch players to return")
		return
	end
	
	teleportPlayersToLobby(inMatchPlayers)
	
	for _, player in ipairs(inMatchPlayers) do
		PlayerStateService.SetState(player, PlayerState.States.Lobby)
		restoreLobbyHealth(player)
	end
	
	log(string.format("Returned %d remaining players to Lobby", #inMatchPlayers))
end

--[[ PHASE HANDLERS ]]

local function runIntermission()
	restoreEnvironment("IntermissionStart")
	setMatchState(MatchState.States.Intermission)
	phaseEndTime = getServerTime() + MatchConfig.IntermissionSeconds
	replicatePhaseEnd(phaseEndTime)
	replicateRound(0)
	clearCurrentVoteLockState()
	if replicatedVoteActive then
		replicatedVoteActive.Value = false
	end
	if replicatedVoteEndTime then
		replicatedVoteEndTime.Value = 0
	end
	-- Reset mode to Normal at start of intermission
	currentMode = "Normal"
	if replicatedMode then
		replicatedMode.Value = "Normal"
	end
	log(string.format(
		"[IntermissionStart] duration=%.1fs phaseEnd=%.3f waiting=%d mode=%s",
		MatchConfig.IntermissionSeconds,
		phaseEndTime,
		#PlayerStateService.GetPlayersInState(PlayerState.States.Waiting),
		tostring(currentMode)
	))
	local lastActiveCount = 0
	local voteStarted = false
	local abilityWarningSent = false
	while getServerTime() < phaseEndTime do
		setEligibleToWaiting()
		local waiting = PlayerStateService.GetPlayersInState(PlayerState.States.Waiting)
		local activeCount = 0
		for _, p in ipairs(waiting) do
			if not PlayerStateService.IsAFK(p) then
				activeCount = activeCount + 1
			end
		end
		if activeCount ~= lastActiveCount then
			log(string.format(
				"[IntermissionTick] activeWaiting=%d->%d remaining=%.1fs phaseEndStable=true",
				lastActiveCount,
				activeCount,
				phaseEndTime - getServerTime()
			))
		end
		lastActiveCount = activeCount
		local timeLeft = phaseEndTime - getServerTime()
		if not abilityWarningSent and timeLeft <= MatchConfig.AbilityWarningRemainingSeconds then
			abilityWarningSent = true
			fireAbilityActivationWarnings(MatchManager.GetEligiblePlayers())
		end
		if not voteStarted and timeLeft <= MatchConfig.VoteRevealRemainingSeconds then
			voteStarted = true
			log(string.format(
				"[VoteReveal] remaining=%.2fs revealAt=%.2fs phaseEnd=%.3f",
				timeLeft,
				MatchConfig.VoteRevealRemainingSeconds,
				phaseEndTime
			))
			startVote()
		end
		task.wait(MatchConfig.IntermissionTickSeconds)
	end
	log(string.format("[IntermissionEnding] waiting=%d eligible=%d mode=%s",
		#PlayerStateService.GetPlayersInState(PlayerState.States.Waiting),
		#MatchManager.GetEligiblePlayers(),
		tostring(currentMode)
	))
	if voteStarted then
		endVote()
	end
	forceVoteClosedForMatchStart("IntermissionComplete")
	setEligibleToWaiting()
end

local function runPlaying()
	setEligibleToWaiting()
	local waitingPlayers = PlayerStateService.GetPlayersInState(PlayerState.States.Waiting)
	for _, player in ipairs(waitingPlayers) do
		logMatchEntrySnapshot("RunPlayingWaitingSnapshot", player, true, "waiting_at_run_playing_start")
	end
	
	if #waitingPlayers < Config.MinPlayersToStart then
		if pendingForcedModeReservation then
			log(string.format(
				"[ForceModeHold] reason=NO_PLAYERS receipt=%s mode=%s upcomingMatchId=%d",
				pendingForcedModeReservation.receiptKey,
				pendingForcedModeReservation.forcedMode,
				pendingForcedModeReservation.upcomingMatchId
			))
			pendingForcedModeReservation = nil
		end
		log(string.format("[MatchStartAbort] reason=%s waiting=%d minRequired=%d names=%s",
			"initial_waiting_below_min",
			#waitingPlayers,
			Config.MinPlayersToStart,
			formatPlayerNames(waitingPlayers)
		))
		for _, player in ipairs(waitingPlayers) do
			PlayerStateService.SetState(player, PlayerState.States.Lobby)
		end
		return false
	end
	
	if pendingForcedModeReservation then
		local reservation = pendingForcedModeReservation
		pendingForcedModeReservation = nil
		local consumed = ForceNextModeProductService.ConsumeReservedForStartedMatch(
			reservation.receiptKey,
			reservation.upcomingMatchId
		)
		if consumed then
			log(string.format(
				"[ForceModeApplied] mode=%s receipt=%s upcomingMatchId=%d",
				reservation.forcedMode,
				reservation.receiptKey,
				reservation.upcomingMatchId
			))
		else
			warn(string.format(
				"[MatchManager] Failed to consume forced mode reservation receipt=%s mode=%s upcomingMatchId=%d",
				reservation.receiptKey,
				reservation.forcedMode,
				reservation.upcomingMatchId
			))
		end
	end
	log(string.format("[MatchStartBegin] mode=%s waitingPlayers=%d", currentMode, #waitingPlayers))

	local played = false
	local startedMatchPlayers: { Player } = {}
	local ok, err = xpcall(function()
		log(string.format("[MatchStartStep] step=%s mode=%s", "ApplyEnvironment", currentMode))
		applyEnvironmentForMode(currentMode)

		log("[MatchStartStep] step=MapManager.OnMatchStart")
		MapManager.OnMatchStart()
		forceVoteClosedForMatchStart("RunPlayingStart")
		log("[MatchStartStep] step=CommitWaitingParticipants")
		local matchPlayers, commitAbortReason = commitWaitingParticipantsToMatch()
		startedMatchPlayers = matchPlayers
		if commitAbortReason then
			error(string.format("MATCH_COMMIT_ABORT:%s", commitAbortReason))
		end
		log(string.format("[MatchStartPlayers] teleported=%d names=%s",
			#matchPlayers,
			formatPlayerNames(matchPlayers)
		))
		log("[MatchStartStep] step=EliminationTracker.Reset")
		EliminationTracker.Reset(matchPlayers)
		local matchId = EliminationTracker.GetMatchId()
		setMatchState(MatchState.States.Playing)
		log(string.format("[MatchStartCommitted] state=%s matchId=%d mode=%s", MatchState.States.Playing, matchId, currentMode))
		do
			local dqs = getDQS()
			if dqs and dqs.OnMatchStart then
				pcall(dqs.OnMatchStart, matchPlayers)
			end
		end
		do
			local feedback = getFeedback()
			if feedback and feedback.OnMatchStart then
				pcall(feedback.OnMatchStart, matchPlayers, currentMode)
			end
		end

		if currentMode == "Brainrot" then
			BrainrotModeService.OnMatchStart()
		end

		EconomyService.ResetMatchCoins()

		log(string.format("[BeamPhaseStartRequest] mode=%s players=%d", currentMode, #matchPlayers))
		RoundManager.StartRoundLoop(currentMode)
		log(string.format("[BeamPhaseStartIssued] running=%s round=%d phase=%s",
			tostring(RoundManager.IsRunning()),
			RoundManager.GetCurrentRound(),
			tostring(RoundManager.GetCurrentPhase())
		))
		if not RoundManager.IsRunning() then
			error("MATCH_COMMIT_ABORT:round_loop_not_running_after_start")
		end
		log(string.format("[MatchStartStep] step=AbilityMatchStart matchId=%d participants=%d", matchId, #matchPlayers))
		PerkMatchEffectService.OnMatchStart(matchPlayers, matchId)

		while RoundManager.IsRunning() do
			task.wait(0.5)
		end

		local endReason = RoundManager.GetMatchEndReason()
		local canonicalEnd = isCanonicalMatchEndReason(endReason)
		local remainingInMatch = #PlayerStateService.GetPlayersInState(PlayerState.States.InMatch)
		log(string.format(
			"[BeamPhaseComplete] reason=%s canonical=%s remainingInMatch=%d finalRound=%d",
			endReason or "unknown",
			tostring(canonicalEnd),
			remainingInMatch,
			RoundManager.GetCurrentRound()
		))
		do
			local dqs = getDQS()
			if dqs and dqs.OnMatchEnd then
				pcall(dqs.OnMatchEnd)
			end
		end
		do
			local feedback = getFeedback()
			if feedback and feedback.OnMatchEnd then
				pcall(feedback.OnMatchEnd)
			end
		end

		if currentMode == "Brainrot" then
			BrainrotModeService.OnMatchEnd()
		end

		PerkMatchEffectService.OnMatchEnd()
		SwordSpawnService.OnMatchEnd()
		TungTungSahurService.OnMatchEnd()
		MapManager.OnMatchEnd()
		if canonicalEnd then
			played = true
		else
			log(string.format(
				"[MatchLoopGuard] canonicalEnd=false reason=%s remainingInMatch=%d action=reset_to_lobby_without_results",
				tostring(endReason),
				remainingInMatch
			))
			setMatchPlayersToLobby()
		end
	end, debug.traceback)

	if not ok then
		warn("[MatchManager] runPlaying failed:", err)
		log(string.format("[MatchStartAbort] reason=runPlaying_failed startedPlayers=%d startedNames=%s err=%s",
			#startedMatchPlayers,
			formatPlayerNames(startedMatchPlayers),
			tostring(err)
		))
		pcall(function()
			RoundManager.StopRoundLoop()
		end)
		do
			local dqs = getDQS()
			if dqs and dqs.OnMatchEnd then
				pcall(dqs.OnMatchEnd)
			end
		end
		do
			local feedback = getFeedback()
			if feedback and feedback.OnMatchEnd then
				pcall(feedback.OnMatchEnd)
			end
		end
		pcall(function()
			if currentMode == "Brainrot" then
				BrainrotModeService.OnMatchEnd()
			end
		end)
		pcall(function() PerkMatchEffectService.OnMatchEnd() end)
		pcall(function() SwordSpawnService.OnMatchEnd() end)
		pcall(function() TungTungSahurService.OnMatchEnd() end)
		pcall(function() MapManager.OnMatchEnd() end)
		pcall(function() setMatchPlayersToLobby() end)
		pcall(function()
			for _, player in ipairs(PlayerStateService.GetPlayersInState(PlayerState.States.Waiting)) do
				log(string.format("[MatchStartAbortReset] player=%s state=%s -> Lobby", player.Name, PlayerState.States.Waiting))
				PlayerStateService.SetState(player, PlayerState.States.Lobby)
			end
		end)
	end

	restoreEnvironment("PlayingCleanup")
	return played
end

local function resolveRankingsAndReward()
	local survivors = PlayerStateService.GetPlayersInState(PlayerState.States.InMatch)
	local rankings = EliminationTracker.BuildRankings(survivors)
	
	if #rankings == 0 then
		log("No rankings to process (no players)")
		return rankings
	end
	
	local totalAwarded = 0
	local matchId = EliminationTracker.GetMatchId()
	
	local PDS = nil
	do
		local ok, mod = pcall(function()
			return require(Server:WaitForChild("PlayerDataService", 2))
		end)
		if ok and mod then PDS = mod end
	end
	
	local crownGrants: { [number]: string } = {}
	local placementAwards: { [number]: number } = {}
	local firstMatchBonusAwards: { [number]: number } = {}
	local currentCoinsAfterRewards: { [number]: number } = {}
	local nextGoalsByPlayer: { [number]: any } = {}
	local replayMessagesByPlayer: { [number]: string } = {}

	local function resolveReplayMessage(nextGoal: any): string
		if not nextGoal then
			return "Next match starts soon - go for another win."
		end
		if (nextGoal.remainingCoins or 0) > 0 then
			return string.format("Earn %d more coins for %s.", nextGoal.remainingCoins, nextGoal.name)
		end
		return string.format("You can unlock %s now.", nextGoal.name)
	end
	
	for _, group in ipairs(rankings) do
		for _, entry in ipairs(group.players) do
			if entry.player and entry.player.Parent then
				local player = entry.player
				local awardedCoins = 0
				if group.coins > 0 then
					local awardOk, finalAward = EconomyService.AwardCoins(
						player,
						group.coins,
						string.format("Match#%d Place#%d", matchId, group.placement)
					)
					if awardOk then
						awardedCoins = finalAward or 0
						totalAwarded = totalAwarded + awardedCoins
					end
				end
				placementAwards[entry.playerId] = awardedCoins

				local firstMatchBonusCoins = 0
				if PDS then
					local lifetimeMatchesCompleted = PDS.GetField(player, "LifetimeMatchesCompleted") or 0
					if lifetimeMatchesCompleted <= 0 then
						local bonusOk, finalBonus = EconomyService.AwardCoins(
							player,
							FIRST_MATCH_BONUS_COINS,
							string.format("Match#%d FirstMatchBonus", matchId),
							true
						)
						if bonusOk then
							firstMatchBonusCoins = finalBonus or FIRST_MATCH_BONUS_COINS
							totalAwarded = totalAwarded + firstMatchBonusCoins
							PDS.SetField(player, "LifetimeMatchesCompleted", 1)
							log(string.format(
								"[FirstMatchBonus] player=%s matchId=%d amount=%d",
								player.Name,
								matchId,
								firstMatchBonusCoins
							))
						else
							warn(string.format("[MatchManager] First match bonus failed for %s matchId=%d", player.Name, matchId))
						end
					else
						PDS.SetField(player, "LifetimeMatchesCompleted", lifetimeMatchesCompleted + 1)
					end
				end
				firstMatchBonusAwards[entry.playerId] = firstMatchBonusCoins
				
				if group.placement == 1 and PDS then
					local lifetimeWins = (PDS.GetField(player, "LifetimeWins") or 0) + 1
					PDS.SetField(player, "LifetimeWins", lifetimeWins)

					local weeklyWins = (PDS.GetField(player, "WeeklyWins") or 0) + 1
					PDS.SetField(player, "WeeklyWins", weeklyWins)

					local dqs = getDQS()
					if dqs and dqs.OnPlayerWon then pcall(dqs.OnPlayerWon, player) end

					log(string.format("%s won! LifetimeWins=%d WeeklyWins=%d",
						player.Name, lifetimeWins, weeklyWins))

					reportStats(player.UserId, player.Name, {
						LifetimeWins = lifetimeWins,
						WeeklyWins   = weeklyWins,
					})
					
					local _, nextM = getMilestoneContext(lifetimeWins - 1)
					if nextM and lifetimeWins >= nextM.wins then
						crownGrants[entry.playerId] = nextM.crownId
					end
				end

				local playerData = if PDS then PDS.GetData(player) else nil
				local currentCoins = EconomyService.GetCoins(player)
				currentCoinsAfterRewards[entry.playerId] = currentCoins
				local nextGoal = ProgressionGoalResolver.Resolve({
					coins = currentCoins,
					ownedCrowns = playerData and playerData.OwnedCrowns or {},
					ownedPets = playerData and playerData.OwnedPets or {},
				})
				nextGoalsByPlayer[entry.playerId] = nextGoal
				replayMessagesByPlayer[entry.playerId] = resolveReplayMessage(nextGoal)
				if nextGoal then
					log(string.format(
						"[NextGoalResolved] player=%s goalId=%s price=%d remaining=%d",
						player.Name,
						nextGoal.id,
						nextGoal.price,
						nextGoal.remainingCoins
					))
				else
					log(string.format("[NextGoalResolved] player=%s goalId=<none>", player.Name))
				end

				local matchCoinsCollected = EconomyService.GetMatchCoins(player)
				local totalCoinsEarned = awardedCoins + matchCoinsCollected + firstMatchBonusCoins
				log(string.format(
					"[RewardSummary] player=%s placement=%d placementCoins=%d matchCoins=%d firstMatchBonus=%d total=%d balance=%d",
					player.Name,
					group.placement,
					awardedCoins,
					matchCoinsCollected,
					firstMatchBonusCoins,
					totalCoinsEarned,
					currentCoins
				))
			end
		end
	end
	
	log(string.format("Awarded %d total coins across %d placement groups", totalAwarded, #rankings))
	
	if matchResultsEvent then
		local flatRankings = {}
		for _, group in ipairs(rankings) do
			for _, entry in ipairs(group.players) do
				table.insert(flatRankings, {
					placement = group.placement,
					playerName = entry.playerName,
					coins = placementAwards[entry.playerId] or 0,
					matchCoinsCollected = entry.player and EconomyService.GetMatchCoins(entry.player) or 0,
				})
			end
		end
		
		for _, group in ipairs(rankings) do
			for _, entry in ipairs(group.players) do
				if entry.player and entry.player.Parent then
					local player = entry.player
					local lifetimeWins = 0
					if PDS then
						lifetimeWins = PDS.GetField(player, "LifetimeWins") or 0
					end
					local prevM, nextM = getMilestoneContext(lifetimeWins)
					local matchCoinsCollected = EconomyService.GetMatchCoins(player)
					local placementCoins = placementAwards[entry.playerId] or 0
					local firstMatchBonusCoins = firstMatchBonusAwards[entry.playerId] or 0
					local totalCoinsEarned = placementCoins + matchCoinsCollected + firstMatchBonusCoins
					
					local payload = {
						yourPlacement = group.placement,
						yourCoins = placementCoins,
						placementCoins = placementCoins,
						yourXP = 0,
						matchCoinsCollected = matchCoinsCollected,
						firstMatchBonusCoins = firstMatchBonusCoins,
						firstMatchBonusGranted = firstMatchBonusCoins > 0,
						totalCoinsEarned = totalCoinsEarned,
						currentCoinsAfterRewards = currentCoinsAfterRewards[entry.playerId] or EconomyService.GetCoins(player),
						replayMessage = replayMessagesByPlayer[entry.playerId] or "Next match starts soon - go for another win.",
						nextGoal = nextGoalsByPlayer[entry.playerId],
						rankings = flatRankings,
						lifetimeWins = lifetimeWins,
						crownGranted = crownGrants[entry.playerId] or nil,
						nextMilestone = nextM,
						prevMilestone = prevM,
					}
					log(string.format(
						"[RewardPresentation] player=%s placement=%d totalCoinsEarned=%d firstMatchBonus=%d",
						player.Name,
						group.placement,
						totalCoinsEarned,
						firstMatchBonusCoins
					))
					
					local fireOk, fireErr = pcall(function()
						matchResultsEvent:FireClient(player, payload)
					end)
					if not fireOk then
						warn("[MatchManager] Failed to fire results to", entry.playerName, fireErr)
					end
				end
			end
		end
		log("Fired MatchResultsEvent to all match participants")

		log("[MatchManager] Results -> triggering fireworks (always)")
		local remotes = ReplicatedStorage:FindFirstChild("Remotes")
		local fwRemote = remotes and remotes:FindFirstChild("PlayFireworks")
		if fwRemote then
			fwRemote:FireAllClients()
			log("[MatchManager] PlayFireworks fired to: AllClients")
		else
			warn("[MatchManager] PlayFireworks remote not found in Remotes folder")
		end
	end
	
	return rankings
end

local function runEnding()
	setMatchState(MatchState.States.Ending)
	phaseEndTime = getServerTime() + Config.EndingSeconds
	replicatePhaseEnd(phaseEndTime)
	
	local matchEndReason = RoundManager.GetMatchEndReason()
	local winner = RoundManager.GetWinner()
	
	if matchEndReason == "Winner" and winner then
		log(string.format("Ending started (%ds) - WINNER: %s", Config.EndingSeconds, winner.Name))
	elseif matchEndReason == "NoWinners" then
		log(string.format("Ending started (%ds) - No winners", Config.EndingSeconds))
	else
		log(string.format("Ending started (%ds)", Config.EndingSeconds))
	end
	
	if matchEndReason == "Winner" and winner and winner.Parent then
		local remotes = ReplicatedStorage:FindFirstChild("Remotes")
		local sfxRemote = remotes and remotes:FindFirstChild("PlaySFX")
		if sfxRemote then
			sfxRemote:FireClient(winner, "Win")
		end
	end

	resolveRankingsAndReward()
	setMatchPlayersToLobby()
	
	while getServerTime() < phaseEndTime do
		task.wait(MatchConfig.IntermissionTickSeconds)
	end
end

--[[ PUBLIC API ]]

function MatchManager.Init()
	if initialized then
		warn("[MatchManager] Already initialized")
		return
	end

	local matchStatusFolder = Instance.new("Folder")
	matchStatusFolder.Name = "MatchStatus"

	replicatedState = Instance.new("StringValue")
	replicatedState.Name = "State"
	replicatedState.Value = MatchState.States.Intermission
	replicatedState.Parent = matchStatusFolder

	replicatedRound = Instance.new("IntValue")
	replicatedRound.Name = "Round"
	replicatedRound.Value = 0
	replicatedRound.Parent = matchStatusFolder

	replicatedRoundPhase = Instance.new("StringValue")
	replicatedRoundPhase.Name = "RoundPhase"
	replicatedRoundPhase.Value = ""
	replicatedRoundPhase.Parent = matchStatusFolder

	replicatedPhaseEnd = Instance.new("NumberValue")
	replicatedPhaseEnd.Name = "PhaseEndTime"
	replicatedPhaseEnd.Value = 0
	replicatedPhaseEnd.Parent = matchStatusFolder

	replicatedMovementCountdownVisible = Instance.new("BoolValue")
	replicatedMovementCountdownVisible.Name = "MovementCountdownVisible"
	replicatedMovementCountdownVisible.Value = false
	replicatedMovementCountdownVisible.Parent = matchStatusFolder

	replicatedMovementCountdownEndTime = Instance.new("NumberValue")
	replicatedMovementCountdownEndTime.Name = "MovementCountdownEndTime"
	replicatedMovementCountdownEndTime.Value = 0
	replicatedMovementCountdownEndTime.Parent = matchStatusFolder

	replicatedMode = Instance.new("StringValue")
	replicatedMode.Name = "Mode"
	replicatedMode.Value = "Normal"
	replicatedMode.Parent = matchStatusFolder

	replicatedVoteActive = Instance.new("BoolValue")
	replicatedVoteActive.Name = "ModeVoteActive"
	replicatedVoteActive.Value = false
	replicatedVoteActive.Parent = matchStatusFolder

	replicatedVoteLocked = Instance.new("BoolValue")
	replicatedVoteLocked.Name = "ModeVoteLocked"
	replicatedVoteLocked.Value = false
	replicatedVoteLocked.Parent = matchStatusFolder

	replicatedVoteLockedMode = Instance.new("StringValue")
	replicatedVoteLockedMode.Name = "ModeVoteLockedMode"
	replicatedVoteLockedMode.Value = ""
	replicatedVoteLockedMode.Parent = matchStatusFolder

	replicatedVoteEndTime = Instance.new("NumberValue")
	replicatedVoteEndTime.Name = "ModeVoteEndTime"
	replicatedVoteEndTime.Value = 0
	replicatedVoteEndTime.Parent = matchStatusFolder

	matchStatusFolder.Parent = ReplicatedStorage
	log("MatchStatus folder + replicated values created")

	local remotesFolder = ReplicatedStorage:FindFirstChild("Remotes")
	if not remotesFolder then
		remotesFolder = Instance.new("Folder")
		remotesFolder.Name = "Remotes"
		remotesFolder.Parent = ReplicatedStorage
	end
	local existing = remotesFolder:FindFirstChild("MatchResultsEvent")
	if not existing then
		matchResultsEvent = Instance.new("RemoteEvent")
		matchResultsEvent.Name = "MatchResultsEvent"
		matchResultsEvent.Parent = remotesFolder
	else
		matchResultsEvent = existing
	end
	log("MatchResultsEvent remote created")

	local existingAbilityWarning = remotesFolder:FindFirstChild("AbilityActivationWarning")
	if not existingAbilityWarning then
		abilityActivationWarningRemote = Instance.new("RemoteEvent")
		abilityActivationWarningRemote.Name = "AbilityActivationWarning"
		abilityActivationWarningRemote.Parent = remotesFolder
	else
		abilityActivationWarningRemote = existingAbilityWarning
	end
	log("AbilityActivationWarning remote created")

	local existingFW = remotesFolder:FindFirstChild("PlayFireworks")
	if not existingFW then
		local fwRemote = Instance.new("RemoteEvent")
		fwRemote.Name = "PlayFireworks"
		fwRemote.Parent = remotesFolder
	end
	log("PlayFireworks remote created")

	local existingVote = remotesFolder:FindFirstChild("ModeVote")
	if not existingVote then
		voteRemote = Instance.new("RemoteEvent")
		voteRemote.Name = "ModeVote"
		voteRemote.Parent = remotesFolder
	else
		voteRemote = existingVote
	end

	voteRemote.OnServerEvent:Connect(function(player, action, data)
		if action == "Cast" and data and typeof(data) == "string" then
			if voteLocked then
				log(string.format(
					"[ModeVoteRejectedLocked] player=%s attempted=%s forcedMode=%s",
					player.Name,
					data,
					tostring(lockedVoteMode or "")
				))
				return
			end
			if not voteActive then
				return
			end
			if PlayerStateService.IsAFK(player) then return end
			if player:GetAttribute("TutorialCompleted") ~= true then
				log(string.format("[ModeVoteRejectedTutorial] player=%s attempted=%s", player.Name, data))
				return
			end
			local state = PlayerStateService.GetState(player)
			if state ~= PlayerState.States.Lobby and state ~= PlayerState.States.Waiting then
				return
			end
			if data == "Normal" or data == "Brainrot" then
				votes[player] = data
				broadcastVoteCounts()
			end
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		if votes[player] then
			votes[player] = nil
			if voteActive then
				broadcastVoteCounts()
			end
		end
	end)

	Players.PlayerAdded:Connect(function(player)
		if not isIntermissionCountdownActive() then
			return
		end
		local serverRemaining = math.max(0, phaseEndTime - getServerTime())
		local replicatedRemaining = if replicatedPhaseEnd
			then math.max(0, replicatedPhaseEnd.Value - getServerTime())
			else 0
		log(string.format(
			"[IntermissionJoin] player=%s currentRemaining=%.1fs replicatedRemaining=%.1fs replicatedPhaseEnd=%.1f resetBlocked=true",
			player.Name,
			serverRemaining,
			replicatedRemaining,
			replicatedPhaseEnd and replicatedPhaseEnd.Value or 0
		))
	end)

	log("ModeVote remote created")

	BrainrotModeService.Init()
	ModeLightingService.Init()
	FreezePlayerProductService.Init()
	ForceNextModeProductService.Init()
	RoundCoinService.Init()
	TungTungSahurService.Init()

	MapManager.Init()
	RoundManager.Init()
	EconomyService.Init()
	SwordSpawnService.Init()
	
	PlayerStateService.OnPlayerRemoval(function(player, oldState)
		if currentState == MatchState.States.Playing and oldState == PlayerState.States.InMatch then
			local round = RoundManager.GetCurrentRound()
			EliminationTracker.RecordElimination(player, round, "Disconnect")
		end
	end)
	
	task.spawn(function()
		getGLBS()
	end)
	
	initialized = true
	log("Initialized (leaderboard updates via direct GLBS calls)")
end

function MatchManager.GetState(): string
	return currentState
end

function MatchManager.GetTimeRemaining(): number
	local remaining = phaseEndTime - getServerTime()
	return math.max(0, math.floor(remaining))
end

function MatchManager.StartLoop()
	if loopRunning then
		warn("[MatchManager] Loop already running")
		return
	end
	loopRunning = true
	log("Loop started - waiting for first eligible player before intermission")
	
	task.spawn(function()
		while loopRunning do
			local eligible = MatchManager.GetEligiblePlayers()
			if #eligible > 0 then
				log(string.format("First eligible player found (%s) - beginning match loop", eligible[1].Name))
				break
			end
			task.wait(0.5)
		end
		
		while loopRunning do
			runIntermission()
			local playedMatch = runPlaying()
			if playedMatch then
				runEnding()
			end
		end
	end)
end

function MatchManager.StopLoop()
	loopRunning = false
	restoreEnvironment("StopLoop")
	log("Loop stopped")
end

return MatchManager
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="86">
        <Properties>
          <string name="Name">ModeLightingService</string>
          <string name="Source"><![CDATA[--[[
	ModeLightingService
	Centralized mode-based lighting preset application/restoration.

	Behavior:
	- Snapshots default Lighting properties + children before exclusive mode preset.
	- Applies preset children from configured ServerStorage folder EXCLUSIVELY.
	- Removes all non-preset Lighting content while preset is active.
	- Restores exact default snapshot on cleanup.
	- Keeps all edits centralized to avoid scattered Lighting mutations.
]]

local Lighting = game:GetService("Lighting")
local ServerStorage = game:GetService("ServerStorage")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local ModeEnvironmentConfig = require(Shared:WaitForChild("ModeEnvironmentConfig"))

local ModeLightingService = {}

local initialized = false
local activeState: string = "DefaultOnly"
local activeMode: string = ModeEnvironmentConfig.DefaultMode

local PROPERTY_KEYS = {
	"Brightness",
	"ClockTime",
	"Ambient",
	"OutdoorAmbient",
	"ExposureCompensation",
	"FogEnd",
	"FogStart",
	"FogColor",
	"GeographicLatitude",
	"EnvironmentDiffuseScale",
	"EnvironmentSpecularScale",
	"ShadowSoftness",
}

local defaultPropertySnapshot: { [string]: any }? = nil
local defaultChildrenSnapshot: { Instance } = {}
local presetChildrenNames: { [string]: boolean } = {}
local hasDefaultSnapshot = false

local function log(...)
	print("[ModeLightingService]", ...)
end

local function resolveByPath(pathText: string?): Instance?
	if type(pathText) ~= "string" or pathText == "" then return nil end
	local segments = string.split(pathText, ".")
	if #segments == 0 then return nil end
	local current: Instance? = nil
	if segments[1] == "ServerStorage" then
		current = ServerStorage
	elseif segments[1] == "Lighting" then
		current = Lighting
	else
		return nil
	end
	for i = 2, #segments do
		if not current then return nil end
		current = current:FindFirstChild(segments[i])
	end
	return current
end

local function cloneChildren(parentInst: Instance): { Instance }
	local out = {}
	for _, child in ipairs(parentInst:GetChildren()) do
		local ok, clone = pcall(function()
			return child:Clone()
		end)
		if ok and clone then
			table.insert(out, clone)
		end
	end
	return out
end

local function destroyChildren(parentInst: Instance)
	for _, child in ipairs(parentInst:GetChildren()) do
		child:Destroy()
	end
end

local function captureDefaultSnapshot()
	for i = #defaultChildrenSnapshot, 1, -1 do
		defaultChildrenSnapshot[i] = nil
	end

	local props: { [string]: any } = {}
	for _, key in ipairs(PROPERTY_KEYS) do
		local ok, value = pcall(function()
			return Lighting[key]
		end)
		if ok then
			props[key] = value
		end
	end
	defaultPropertySnapshot = props
	defaultChildrenSnapshot = cloneChildren(Lighting)
	hasDefaultSnapshot = true
	log(string.format("Default lighting snapshot captured (children=%d properties=%d)",
		#defaultChildrenSnapshot, #PROPERTY_KEYS))
end

local function applyPropertySnapshot(snapshot: { [string]: any }?)
	if not snapshot then return end
	for _, key in ipairs(PROPERTY_KEYS) do
		if snapshot[key] ~= nil then
			pcall(function()
				Lighting[key] = snapshot[key]
			end)
		end
	end
end

local function applyPresetProperties(presetFolder: Instance)
	for _, key in ipairs(PROPERTY_KEYS) do
		local valueObj = presetFolder:FindFirstChild(key)
		if valueObj and valueObj:IsA("ValueBase") then
			local value = valueObj.Value
			pcall(function()
				Lighting[key] = value
			end)
		end
	end
end

local function setExclusiveFlag(enabled: boolean)
	Lighting:SetAttribute("ModeLightingExclusive", enabled)
end

function ModeLightingService.Init()
	if initialized then return end
	initialized = true
	activeMode = ModeEnvironmentConfig.DefaultMode
	activeState = "DefaultOnly"
	setExclusiveFlag(false)
	log("Initialized")
end

function ModeLightingService.ApplyForMode(modeName: string?)
	if not initialized then
		ModeLightingService.Init()
	end
	ModeLightingService.RestoreDefault()

	local mode = if type(modeName) == "string" and modeName ~= "" then modeName else ModeEnvironmentConfig.DefaultMode
	local env = ModeEnvironmentConfig.Get(mode)
	local presetPath = env and env.lightingPresetPath or nil
	if type(presetPath) ~= "string" or presetPath == "" then
		ModeLightingService.RestoreDefault()
		activeMode = mode
		activeState = "DefaultOnly"
		log(string.format("Mode=%s state=%s (default lighting only)", mode, activeState))
		return
	end

	local presetFolder = resolveByPath(presetPath)
	if not presetFolder then
		warn(string.format("[ModeLightingService] Preset folder not found: %s", tostring(presetPath)))
		activeMode = mode
		activeState = "DefaultOnly"
		return
	end

	captureDefaultSnapshot()
	setExclusiveFlag(true)
	destroyChildren(Lighting)
	presetChildrenNames = {}
	local appliedCount = 0
	for _, child in ipairs(presetFolder:GetChildren()) do
		local clone = child:Clone()
		clone.Parent = Lighting
		presetChildrenNames[child.Name] = true
		appliedCount += 1
	end
	applyPresetProperties(presetFolder)

	activeMode = mode
	activeState = "BrainrotExclusive"
	log(string.format("Mode=%s appliedPreset=%s exclusively (children=%d)", mode, presetPath, appliedCount))
end

function ModeLightingService.RestoreDefault()
	if not initialized then
		ModeLightingService.Init()
	end

	if not hasDefaultSnapshot then
		setExclusiveFlag(false)
		activeMode = ModeEnvironmentConfig.DefaultMode
		activeState = "DefaultOnly"
		log("Restore requested with no snapshot yet; default state preserved")
		return
	end

	local removed = #Lighting:GetChildren()
	destroyChildren(Lighting)
	presetChildrenNames = {}

	local restoredChildren = 0
	for _, childClone in ipairs(defaultChildrenSnapshot) do
		local restored = childClone:Clone()
		restored.Parent = Lighting
		restoredChildren += 1
	end
	applyPropertySnapshot(defaultPropertySnapshot)
	setExclusiveFlag(false)

	activeMode = ModeEnvironmentConfig.DefaultMode
	activeState = "DefaultOnly"
	log(string.format("UnwrapInLighting removed (children=%d), default lighting restored (children=%d, state=%s)",
		removed, restoredChildren, activeState))
end

function ModeLightingService.GetActiveMode(): string
	return activeMode
end

function ModeLightingService.GetActiveState(): string
	return activeState
end

return ModeLightingService
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="87">
        <Properties>
          <string name="Name">ModelMover</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--[[
	ModelMover
	Server startup script — moves pet/crown model folders from Workspace
	to ReplicatedStorage.ItemModels so clients can clone them for ViewportFrame.

	Runs ONCE on server start, before any UI needs the models.
	Source folders are deleted from Workspace after cloning.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local LOG_PREFIX = "[ModelMover]"

-- ── Folder mapping: Workspace source → ReplicatedStorage destination ──
local FOLDER_MAP = {
	{ source = "Common Pets",     dest = { "ItemModels", "Pets", "Common" } },
	{ source = "Rare Pets",       dest = { "ItemModels", "Pets", "Rare" } },
	{ source = "Epic Pets",       dest = { "ItemModels", "Pets", "Epic" } },
	{ source = "Legendary Pets",  dest = { "ItemModels", "Pets", "Legendary" } },
	{ source = "Findable Crowns", dest = { "ItemModels", "Crowns", "Findable" } },
	{ source = "Exclusive Crowns",dest = { "ItemModels", "Crowns", "Exclusive" } },
	{ source = "Level Crowns",    dest = { "ItemModels", "Crowns", "Level" } },
}

local function ensureFolder(parent: Instance, name: string): Folder
	local existing = parent:FindFirstChild(name)
	if existing and existing:IsA("Folder") then
		return existing
	end
	local folder = Instance.new("Folder")
	folder.Name = name
	folder.Parent = parent
	return folder
end

local function ensurePath(root: Instance, pathParts: { string }): Folder
	local current = root
	for _, part in ipairs(pathParts) do
		current = ensureFolder(current, part)
	end
	return current :: Folder
end

local totalMoved = 0

for _, mapping in ipairs(FOLDER_MAP) do
	local sourceFolder = workspace:FindFirstChild(mapping.source)
	if not sourceFolder then
		warn(string.format("%s Source folder '%s' not found in Workspace — skipped", LOG_PREFIX, mapping.source))
		continue
	end

	local destFolder = ensurePath(ReplicatedStorage, mapping.dest)
	local count = 0

	for _, child in ipairs(sourceFolder:GetChildren()) do
		-- Skip if already exists in destination (idempotent)
		if destFolder:FindFirstChild(child.Name) then
			count += 1
			continue
		end

		local clone = child:Clone()
		if clone then
			-- Anchor all parts so they don't fall in ViewportFrame
			for _, desc in ipairs(clone:GetDescendants()) do
				if desc:IsA("BasePart") then
					desc.Anchored = true
					desc.CanCollide = false
					desc.CanTouch = false
					desc.CanQuery = false
				end
			end
			if clone:IsA("BasePart") then
				clone.Anchored = true
				clone.CanCollide = false
				clone.CanTouch = false
				clone.CanQuery = false
			end
			clone.Parent = destFolder
			count += 1
		end
	end

	-- Remove source folder from Workspace (no longer needed)
	sourceFolder:Destroy()

	totalMoved += count
	print(string.format("%s Moved %d items: Workspace.%s → %s",
		LOG_PREFIX, count, mapping.source, table.concat(mapping.dest, ".")))
end

print(string.format("%s Done — %d total models in ReplicatedStorage.ItemModels", LOG_PREFIX, totalMoved))
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="88">
        <Properties>
          <string name="Name">PerkMatchEffectService</string>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Server = ServerScriptService:WaitForChild("Server")

local AbilityCatalog = require(Shared:WaitForChild("PerkCatalog"))
local StatService = require(Server:WaitForChild("StatService"))
local PlayerStateService = require(Server:WaitForChild("PlayerStateService"))

local PerkMatchEffectService = {}

local STATUS_NONE = "None"
local STATUS_QUEUED = "Queued"
local STATUS_ACTIVE = "Active"

local SPEED_BONUS_KEY = "PerkSpeed"
local JUMP_BONUS_KEY = "PerkJump"
local ABILITY_VFX_EMITTER_NAME = "ActiveAbilityVfx"
local ABILITY_VFX_TEXTURE = "rbxasset://textures/particles/sparkles_main.dds"

local initialized = false
local characterConnections: { [number]: RBXScriptConnection } = {}
local characterDiedConnections: { [number]: RBXScriptConnection } = {}
local playerStateConnections: { [number]: RBXScriptConnection } = {}
local pendingAbilityByUserId: { [number]: string } = {}
local activeMatchAbilityByUserId: { [number]: string } = {}
local matchParticipantsByUserId: { [number]: boolean } = {}
local activeMatchRunning = false
local activeMatchId = 0
local clearActiveAbility
local getAbilityVfxRoot

local function log(message: string)
	print("[AbilityMatchEffect] " .. message)
end

local function getAbility(abilityId: string)
	return AbilityCatalog.Get(abilityId)
end

local function getAbilityStatusAttribute(abilityId: string): string?
	local ability = getAbility(abilityId)
	return ability and ability.statusAttribute or nil
end

local function getPendingAbilityId(player: Player): string?
	return pendingAbilityByUserId[player.UserId]
end

local function getActiveAbilityId(player: Player): string?
	return activeMatchAbilityByUserId[player.UserId]
end

local function isQueued(player: Player, abilityId: string): boolean
	return getPendingAbilityId(player) == abilityId
end

local function isActive(player: Player, abilityId: string): boolean
	return getActiveAbilityId(player) == abilityId
end

local function setAbilityStatus(player: Player, abilityId: string, status: string)
	local attributeName = getAbilityStatusAttribute(abilityId)
	if attributeName then
		player:SetAttribute(attributeName, status)
	end
end

local function refreshPlayerStatuses(player: Player)
	local state = tostring(player:GetAttribute("PlayerState"))
	local activeAbilityId = getActiveAbilityId(player)
	local inActiveContext = state == "InMatch"
	local contextReason = if inActiveContext then "in_match" else "player_not_in_match_state"
	if activeAbilityId and not inActiveContext then
		log(string.format(
			"[AbilityStateGuard] Corrected invalid active state for player %s: playerState=%s ability=%s reason=%s -> ClearOnly",
			player.Name,
			state,
			activeAbilityId,
			contextReason
		))
		clearActiveAbility(player, activeAbilityId, "OutOfMatchNormalize")
		log(string.format("[AbilityStateGuard] player=%s action=clear_stale_active ability=%s", player.Name, activeAbilityId))
		activeMatchAbilityByUserId[player.UserId] = nil
		activeAbilityId = nil
	end

	for _, ability in ipairs(AbilityCatalog.All) do
		local attributeName = getAbilityStatusAttribute(ability.id)
		local rawStatus = if attributeName then player:GetAttribute(attributeName) else nil
		local status = STATUS_NONE
		if isActive(player, ability.id) and inActiveContext then
			status = STATUS_ACTIVE
		elseif isQueued(player, ability.id) then
			status = STATUS_QUEUED
		end
		if rawStatus == STATUS_ACTIVE and status ~= STATUS_ACTIVE then
			log(string.format(
				"[AbilityStateGuard] Invalid status attribute player=%s ability=%s rawStatus=%s playerState=%s activeMatchAbility=%s -> correctedStatus=%s",
				player.Name,
				ability.id,
				tostring(rawStatus),
				state,
				tostring(activeAbilityId),
				status
			))
		end
		setAbilityStatus(player, ability.id, status)
	end
end

local function playerHasSword(player: Player): boolean
	local backpack = player:FindFirstChild("Backpack")
	if backpack then
		for _, child in ipairs(backpack:GetChildren()) do
			if child:IsA("Tool") and child.Name == "ClassicSword" then
				return true
			end
		end
	end

	local character = player.Character
	if character then
		for _, child in ipairs(character:GetChildren()) do
			if child:IsA("Tool") and child.Name == "ClassicSword" then
				return true
			end
		end
	end

	return false
end

local function getActiveCharacterAndHumanoid(player: Player): (Model?, Humanoid?, BasePart?)
	local character = player.Character
	if not character then
		return nil, nil, nil
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local rootPart = getAbilityVfxRoot(character)
	return character, humanoid, rootPart
end

local function clearCharacterAbilityVfx(character: Model?)
	if not character then
		return
	end

	for _, descendant in ipairs(character:GetDescendants()) do
		if descendant:IsA("ParticleEmitter") and descendant.Name == ABILITY_VFX_EMITTER_NAME then
			descendant:Destroy()
		end
	end
end

getAbilityVfxRoot = function(character: Model?): BasePart?
	if not character then
		return nil
	end

	return character:FindFirstChild("HumanoidRootPart")
		or character:FindFirstChild("UpperTorso")
		or character:FindFirstChild("Torso")
end

local function ensureActiveAbilityVfx(player: Player, abilityId: string, reason: string)
	if player:GetAttribute("PlayerState") ~= "InMatch" then
		clearCharacterAbilityVfx(player.Character)
		return
	end

	local character, _, rootPart = getActiveCharacterAndHumanoid(player)
	if not character or not rootPart then
		log(string.format(
			"[AbilityVfxSkipped] player=%s ability=%s reason=%s hasCharacter=%s hasRoot=%s",
			player.Name,
			abilityId,
			reason,
			tostring(character ~= nil),
			tostring(rootPart ~= nil)
		))
		return
	end

	clearCharacterAbilityVfx(character)

	local emitter = Instance.new("ParticleEmitter")
	emitter.Name = ABILITY_VFX_EMITTER_NAME
	emitter.Texture = ABILITY_VFX_TEXTURE
	emitter.Color = ColorSequence.new(
		Color3.fromRGB(112, 255, 149),
		Color3.fromRGB(196, 255, 211)
	)
	emitter.LightEmission = 0.65
	emitter.LightInfluence = 0
	emitter.Brightness = 2
	emitter.Enabled = true
	emitter.Lifetime = NumberRange.new(0.7, 1.1)
	emitter.Rate = 24
	emitter.Speed = NumberRange.new(2.5, 4)
	emitter.SpreadAngle = Vector2.new(40, 40)
	emitter.EmissionDirection = Enum.NormalId.Top
	emitter.Acceleration = Vector3.new(0, 5, 0)
	emitter.Drag = 2.5
	emitter.LockedToPart = true
	emitter.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.4),
		NumberSequenceKeypoint.new(0.6, 0.22),
		NumberSequenceKeypoint.new(1, 0),
	})
	emitter.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0),
		NumberSequenceKeypoint.new(0.75, 0.15),
		NumberSequenceKeypoint.new(1, 1),
	})
	emitter.Parent = rootPart
	emitter:Emit(12)
	log(string.format(
		"[AbilityVfxAttached] player=%s ability=%s root=%s rate=%.1f reason=%s",
		player.Name,
		abilityId,
		rootPart.Name,
		emitter.Rate,
		reason
	))
end

local function enforceActiveAbilityHumanoidStats(player: Player, abilityId: string, reason: string)
	local _, humanoid = getActiveCharacterAndHumanoid(player)
	if not humanoid then
		log(string.format(
			"[AbilityHumanoidPending] player=%s ability=%s reason=%s humanoidReady=false",
			player.Name,
			abilityId,
			reason
		))
		return
	end

	if abilityId == AbilityCatalog.Jump.id then
		humanoid.UseJumpPower = true
		log(string.format(
			"[JumpApplyFinal] player=%s ability=%s finalJumpPower=%.1f useJumpPower=%s reason=%s",
			player.Name,
			abilityId,
			humanoid.JumpPower,
			tostring(humanoid.UseJumpPower),
			reason
		))
	elseif abilityId == AbilityCatalog.Speed.id then
		log(string.format(
			"[SpeedApplyFinal] player=%s ability=%s finalWalkSpeed=%.1f reason=%s",
			player.Name,
			abilityId,
			humanoid.WalkSpeed,
			reason
		))
	end
end

local function queueAbilityReapplyAfterCharacterReady(player: Player, abilityId: string, reason: string)
	task.spawn(function()
		local character = player.Character
		if not character then
			return
		end

		character:WaitForChild("Humanoid", 5)
		character:WaitForChild("HumanoidRootPart", 5)
		if not player.Parent or activeMatchAbilityByUserId[player.UserId] ~= abilityId then
			return
		end

		enforceActiveAbilityHumanoidStats(player, abilityId, reason .. ":HumanoidReady")
		ensureActiveAbilityVfx(player, abilityId, reason .. ":HumanoidReady")
	end)
end

local function clearActiveAbilityVfx(player: Player)
	clearCharacterAbilityVfx(player.Character)
end

local function clearActiveAbilityForPlayer(player: Player, reason: string)
	local activeAbilityId = activeMatchAbilityByUserId[player.UserId]
	if not activeAbilityId then
		return
	end

	clearActiveAbility(player, activeAbilityId, reason)
	activeMatchAbilityByUserId[player.UserId] = nil
	refreshPlayerStatuses(player)
end

local function applyActiveAbility(player: Player, abilityId: string, reason: string)
	local ability = getAbility(abilityId)
	if not ability then
		return
	end

	if abilityId == AbilityCatalog.Speed.id then
		local hasSword = playerHasSword(player)
		local walkSpeedBonus = hasSword and (ability.swordWalkSpeedBonus or 0) or (ability.walkSpeedBonus or 0)
		StatService.SetTemporaryMovementBonus(player, SPEED_BONUS_KEY, {
			WalkSpeed = walkSpeedBonus,
		})
		log(string.format(
			"[SpeedApply] player=%s ability=%s sword=%s walkBonus=%.1f reason=%s",
			player.Name,
			abilityId,
			tostring(hasSword),
			walkSpeedBonus,
			reason
		))
	elseif abilityId == AbilityCatalog.Jump.id then
		local jumpPowerBonus = tonumber(ability.jumpPowerBonus) or 0
		StatService.SetTemporaryMovementBonus(player, JUMP_BONUS_KEY, {
			JumpPower = jumpPowerBonus,
		})
		log(string.format(
			"[JumpApply] player=%s ability=%s jumpBonus=%.1f reason=%s",
			player.Name,
			abilityId,
			jumpPowerBonus,
			reason
		))
	end

	enforceActiveAbilityHumanoidStats(player, abilityId, reason)
	ensureActiveAbilityVfx(player, abilityId, reason)
	queueAbilityReapplyAfterCharacterReady(player, abilityId, reason)
end

clearActiveAbility = function(player: Player, abilityId: string, reason: string)
	if abilityId == AbilityCatalog.Speed.id then
		StatService.ClearTemporaryMovementBonus(player, SPEED_BONUS_KEY)
	elseif abilityId == AbilityCatalog.Jump.id then
		StatService.ClearTemporaryMovementBonus(player, JUMP_BONUS_KEY)
	end

	clearActiveAbilityVfx(player)

	log(string.format("[AbilityClear] player=%s ability=%s reason=%s", player.Name, abilityId, reason))
end

local function bindCharacterHumanoid(player: Player, character: Model?)
	local existing = characterDiedConnections[player.UserId]
	if existing then
		existing:Disconnect()
		characterDiedConnections[player.UserId] = nil
	end

	if not character then
		return
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end

	characterDiedConnections[player.UserId] = humanoid.Died:Connect(function()
		clearActiveAbilityForPlayer(player, "HumanoidDied")
	end)
end

local function bindCharacter(player: Player)
	local existing = characterConnections[player.UserId]
	if existing then
		existing:Disconnect()
	end

	characterConnections[player.UserId] = player.CharacterAdded:Connect(function()
		local character = player.Character
		bindCharacterHumanoid(player, character)
		task.spawn(function()
			if character then
				character:WaitForChild("Humanoid", 10)
				character:WaitForChild("HumanoidRootPart", 10)
			end
			if not player.Parent then
				return
			end
			local activeAbilityId = activeMatchAbilityByUserId[player.UserId]
			if not activeAbilityId then
				return
			end
			local ok, err = pcall(function()
				applyActiveAbility(player, activeAbilityId, "CharacterAdded")
			end)
			if not ok then
				warn(string.format(
					"[AbilityMatchEffect] applyActiveAbility failed player=%s ability=%s context=CharacterAdded err=%s",
					player.Name,
					tostring(activeAbilityId),
					tostring(err)
				))
			end
		end)
	end)
end

local function bindPlayerState(player: Player)
	local existing = playerStateConnections[player.UserId]
	if existing then
		existing:Disconnect()
	end

	playerStateConnections[player.UserId] = player:GetAttributeChangedSignal("PlayerState"):Connect(function()
		local newState = tostring(player:GetAttribute("PlayerState"))
		if newState ~= "InMatch" then
			matchParticipantsByUserId[player.UserId] = nil
		end
		local activeAbilityId = activeMatchAbilityByUserId[player.UserId]
		if newState ~= "InMatch" and activeAbilityId then
			clearActiveAbilityForPlayer(player, "PlayerStateChanged")
			log(string.format(
				"[PlayerStateExit] player=%s state=%s clearedActiveAbility=%s",
				player.Name,
				newState,
				activeAbilityId
			))
		end
		refreshPlayerStatuses(player)
	end)
end

local function registerPlayer(player: Player)
	for _, ability in ipairs(AbilityCatalog.All) do
		setAbilityStatus(player, ability.id, STATUS_NONE)
	end
	bindCharacter(player)
	bindPlayerState(player)
	bindCharacterHumanoid(player, player.Character)
end

function PerkMatchEffectService.Init()
	if initialized then
		return
	end

	for _, player in ipairs(Players:GetPlayers()) do
		registerPlayer(player)
	end

	Players.PlayerAdded:Connect(registerPlayer)
	Players.PlayerRemoving:Connect(function(player)
		PerkMatchEffectService.OnPlayerRemoving(player)
	end)
	PlayerStateService.OnStateChanged(function(player: Player, _oldState: string?, _newState: string)
		if player and player.Parent then
			refreshPlayerStatuses(player)
		end
	end)

	initialized = true
	log("Initialized")
end

function PerkMatchEffectService.GetPendingAbility(player: Player): string?
	return getPendingAbilityId(player)
end

function PerkMatchEffectService.GetActiveAbility(player: Player): string?
	return getActiveAbilityId(player)
end

function PerkMatchEffectService.HasPendingOrActiveAbility(player: Player): boolean
	return getPendingAbilityId(player) ~= nil or getActiveAbilityId(player) ~= nil
end

function PerkMatchEffectService.GetPendingAbilityActivationMessage(player: Player): string?
	local abilityId = getPendingAbilityId(player)
	local ability = abilityId and getAbility(abilityId) or nil
	if not ability then
		return nil
	end
	return string.format("%s active this match", tostring(ability.name or "Ability"))
end

function PerkMatchEffectService.IsQueuedOrActive(player: Player, abilityId: string): boolean
	return isQueued(player, abilityId) or isActive(player, abilityId)
end

function PerkMatchEffectService.QueuePerk(player: Player, abilityId: string): (boolean, string)
	PerkMatchEffectService.Init()

	local ability = getAbility(abilityId)
	if not ability then
		return false, "UNKNOWN_ABILITY"
	end

	local pendingAbilityId = getPendingAbilityId(player)
	if pendingAbilityId then
		if pendingAbilityId == abilityId then
			return false, "ALREADY_QUEUED"
		end
		return false, "PENDING_ABILITY_EXISTS"
	end

	local activeAbilityId = getActiveAbilityId(player)
	if activeAbilityId then
		if activeAbilityId == abilityId then
			return false, "ALREADY_ACTIVE"
		end
		return false, "ACTIVE_ABILITY_EXISTS"
	end

	pendingAbilityByUserId[player.UserId] = abilityId
	refreshPlayerStatuses(player)
	log(string.format(
		"[AbilityLifecycle] player=%s action=pending_set ability=%s pending=%s active=%s playerState=%s",
		player.Name,
		abilityId,
		tostring(pendingAbilityByUserId[player.UserId]),
		tostring(activeMatchAbilityByUserId[player.UserId]),
		tostring(player:GetAttribute("PlayerState"))
	))
	return true, "QUEUED"
end

function PerkMatchEffectService.ActivatePendingAbilities(matchPlayers: { Player }, matchId: number): { { player: Player, abilityId: string } }
	PerkMatchEffectService.Init()

	local activated = {}
	for _, player in ipairs(matchPlayers) do
		local playerState = player:GetAttribute("PlayerState")
		if playerState ~= "InMatch" then
			log(string.format(
				"[AbilityLifecycle] player=%s action=activate_skip reason=not_in_match playerState=%s pending=%s active=%s matchId=%d",
				player.Name,
				tostring(playerState),
				tostring(getPendingAbilityId(player)),
				tostring(getActiveAbilityId(player)),
				matchId
			))
			refreshPlayerStatuses(player)
			continue
		end
		local pendingAbilityId = getPendingAbilityId(player)
		if pendingAbilityId and not getActiveAbilityId(player) then
			local ok, err = pcall(function()
				pendingAbilityByUserId[player.UserId] = nil
				activeMatchAbilityByUserId[player.UserId] = pendingAbilityId
				log(string.format(
					"[AbilityLifecycle] player=%s action=promote_pending_to_active ability=%s pending=%s active=%s matchId=%d playerState=%s",
					player.Name,
					pendingAbilityId,
					tostring(getPendingAbilityId(player)),
					tostring(getActiveAbilityId(player)),
					matchId,
					tostring(playerState)
				))
				applyActiveAbility(player, pendingAbilityId, string.format("MatchStart#%d", matchId))
			end)
			if ok then
				table.insert(activated, {
					player = player,
					abilityId = pendingAbilityId,
				})
			else
				warn(string.format(
					"[AbilityMatchEffect] ActivatePendingAbilities recoverable failure player=%s ability=%s matchId=%d err=%s",
					player.Name,
					tostring(pendingAbilityId),
					matchId,
					tostring(err)
				))
				activeMatchAbilityByUserId[player.UserId] = nil
				if not pendingAbilityByUserId[player.UserId] then
					pendingAbilityByUserId[player.UserId] = pendingAbilityId
				end
			end
		end
		refreshPlayerStatuses(player)
	end

	log(string.format("[MatchStart] matchId=%d activatedAbilities=%d participants=%d", matchId, #activated, #matchPlayers))
	return activated
end

function PerkMatchEffectService.OnMatchStart(matchPlayers: { Player }, matchId: number)
	local ok, err = pcall(function()
		PerkMatchEffectService.ActivatePendingAbilities(matchPlayers, matchId)
	end)
	if not ok then
		warn(string.format(
			"[AbilityMatchEffect] OnMatchStart ability activation failed but match continues matchId=%d err=%s",
			matchId,
			tostring(err)
		))
	end
end

function PerkMatchEffectService.OnMatchEnd()
	PerkMatchEffectService.Init()

	for userId, abilityId in pairs(activeMatchAbilityByUserId) do
		local player = Players:GetPlayerByUserId(userId)
		if player then
			log(string.format(
				"[AbilityLifecycle] player=%s action=active_consumed reason=match_end ability=%s pending=%s active=%s",
				player.Name,
				abilityId,
				tostring(getPendingAbilityId(player)),
				tostring(getActiveAbilityId(player))
			))
			clearActiveAbility(player, abilityId, "MatchEnd")
			activeMatchAbilityByUserId[userId] = nil
			refreshPlayerStatuses(player)
			log(string.format(
				"[AbilityLifecycle] player=%s action=active_cleared_post_match ability=%s pending=%s active=%s",
				player.Name,
				abilityId,
				tostring(getPendingAbilityId(player)),
				tostring(getActiveAbilityId(player))
			))
		end
	end

	activeMatchAbilityByUserId = {}
	log("[MatchEnd] clearedActiveAbilities=true")
end

function PerkMatchEffectService.OnSwordStateChanged(player: Player, _hasSword: boolean, reason: string?)
	PerkMatchEffectService.Init()

	if not isActive(player, AbilityCatalog.Speed.id) then
		return
	end

	local ok, err = pcall(function()
		applyActiveAbility(player, AbilityCatalog.Speed.id, reason or "SwordStateChanged")
	end)
	if not ok then
		warn(string.format(
			"[AbilityMatchEffect] OnSwordStateChanged failed player=%s err=%s",
			player.Name,
			tostring(err)
		))
	end
end

function PerkMatchEffectService.OnPlayerRemoving(player: Player)
	local userId = player.UserId
	local activeAbilityId = activeMatchAbilityByUserId[userId]
	if activeAbilityId and player.Parent then
		clearActiveAbility(player, activeAbilityId, "PlayerRemoving")
	end

	activeMatchAbilityByUserId[userId] = nil
	pendingAbilityByUserId[userId] = nil

	local connection = characterConnections[userId]
	if connection then
		connection:Disconnect()
		characterConnections[userId] = nil
	end

	local stateConnection = playerStateConnections[userId]
	if stateConnection then
		stateConnection:Disconnect()
		playerStateConnections[userId] = nil
	end

	local diedConnection = characterDiedConnections[userId]
	if diedConnection then
		diedConnection:Disconnect()
		characterDiedConnections[userId] = nil
	end
end

return PerkMatchEffectService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="89">
        <Properties>
          <string name="Name">PerkProductService</string>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local MarketplaceService = game:GetService("MarketplaceService")
local ServerScriptService = game:GetService("ServerScriptService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Server = ServerScriptService:WaitForChild("Server")

local DeveloperProductConfig = require(Shared:WaitForChild("DeveloperProductConfig"))
local AbilityCatalog = require(Shared:WaitForChild("PerkCatalog"))
local PerkMatchEffectService = require(Server:WaitForChild("PerkMatchEffectService"))

local PerkProductService = {}

local REQUEST_COOLDOWN_SECONDS = 0.8
local PROMPT_IN_FLIGHT_TIMEOUT_SECONDS = 90

local initialized = false
local requestRemote: RemoteEvent? = nil
local requestCooldownByUserId: { [number]: number } = {}
local promptInFlightByUserId: { [number]: { abilityId: string, productId: number, createdAt: number } } = {}
local abilityProductIdToAbilityId: { [number]: string } = {}

local function log(message: string)
	print("[AbilityProduct] " .. message)
end

local function ensureRemotes(): RemoteEvent
	local remotesFolder = ReplicatedStorage:FindFirstChild("Remotes")
	if not remotesFolder then
		remotesFolder = Instance.new("Folder")
		remotesFolder.Name = "Remotes"
		remotesFolder.Parent = ReplicatedStorage
		log("[Init] Created ReplicatedStorage.Remotes folder")
	end

	local existing = remotesFolder:FindFirstChild("PerkProductPromptRequest")
	if existing and existing:IsA("RemoteEvent") then
		log("[Init] Using existing remote Remotes.PerkProductPromptRequest")
		return existing
	end

	local remote = Instance.new("RemoteEvent")
	remote.Name = "PerkProductPromptRequest"
	remote.Parent = remotesFolder
	log("[Init] Created remote Remotes.PerkProductPromptRequest")
	return remote
end

local function getProductConfigForAbility(abilityId: string)
	local ability = AbilityCatalog.Get(abilityId)
	if not ability then
		return nil, nil
	end

	local configKey = tostring(ability.productConfigKey or "")
	if configKey == "" then
		return ability, nil
	end

	return ability, DeveloperProductConfig[configKey]
end

local function clearPromptInFlight(userId: number, reason: string?)
	local existing = promptInFlightByUserId[userId]
	promptInFlightByUserId[userId] = nil
	if existing then
		log(string.format(
			"[PromptLockCleared] userId=%d ability=%s productId=%d reason=%s",
			userId,
			tostring(existing.abilityId),
			tonumber(existing.productId) or 0,
			tostring(reason or "UNKNOWN")
		))
	end
end

local function getActivePromptInFlight(userId: number, now: number)
	local promptState = promptInFlightByUserId[userId]
	if not promptState then
		return nil
	end
	if (now - promptState.createdAt) > PROMPT_IN_FLIGHT_TIMEOUT_SECONDS then
		clearPromptInFlight(userId, "TIMEOUT")
		return nil
	end
	return promptState
end

local function buildAbilityProductIndex()
	abilityProductIdToAbilityId = {}
	for _, ability in ipairs(AbilityCatalog.All) do
		local productId = PerkProductService.GetProductId(ability.id)
		if productId > 0 then
			abilityProductIdToAbilityId[productId] = ability.id
		end
	end
end

function PerkProductService.GetProductId(abilityId: string): number
	local _, config = getProductConfigForAbility(abilityId)
	if not config then
		return 0
	end
	return tonumber(config.productId) or 0
end

function PerkProductService.ConsumePendingReceipt(player: Player, receiptKey: string, expectedAbilityId: string?): (boolean, string)
	if not player or not player.Parent then
		return false, "PLAYER_MISSING"
	end

	local pending = promptInFlightByUserId[player.UserId]
	clearPromptInFlight(player.UserId, "RECEIPT_CONSUMED")

	if not pending then
		log(string.format(
			"[ReceiptRejected] player=%s receipt=%s reason=NO_PROMPT_IN_FLIGHT",
			player.Name,
			tostring(receiptKey)
		))
		return true, "NO_PROMPT_IN_FLIGHT"
	end

	if expectedAbilityId and pending.abilityId ~= expectedAbilityId then
		log(string.format(
			"[ReceiptRejected] player=%s receipt=%s pending=%s expected=%s reason=PROMPT_ABILITY_ID_MISMATCH",
			player.Name,
			tostring(receiptKey),
			pending.abilityId,
			expectedAbilityId
		))
		return true, "PROMPT_ABILITY_ID_MISMATCH"
	end

	local queueOk, queueReason = PerkMatchEffectService.QueuePerk(player, pending.abilityId)
	log(string.format(
		"[PendingAbilityGrant] player=%s receipt=%s ability=%s result=%s reason=%s playerState=%s pending=%s active=%s",
		player.Name,
		tostring(receiptKey),
		pending.abilityId,
		tostring(queueOk),
		queueReason,
		tostring(player:GetAttribute("PlayerState")),
		tostring(PerkMatchEffectService.GetPendingAbility(player)),
		tostring(PerkMatchEffectService.GetActiveAbility(player))
	))

	return queueOk
		or queueReason == "ALREADY_QUEUED"
		or queueReason == "ALREADY_ACTIVE"
		or queueReason == "PENDING_ABILITY_EXISTS"
		or queueReason == "ACTIVE_ABILITY_EXISTS",
		queueReason
end

function PerkProductService.Init()
	if initialized then
		return
	end

	PerkMatchEffectService.Init()
	requestRemote = ensureRemotes()
	buildAbilityProductIndex()
	log(string.format(
		"[Init] RemoteReady=%s Class=%s ProductMapSize=%d",
		requestRemote:GetFullName(),
		requestRemote.ClassName,
		#AbilityCatalog.All
	))

	requestRemote.OnServerEvent:Connect(function(player: Player, abilityId: string)
		local now = workspace:GetServerTimeNow()
		local cooldownUntil = requestCooldownByUserId[player.UserId] or 0
		if now < cooldownUntil then
			return
		end
		requestCooldownByUserId[player.UserId] = now + REQUEST_COOLDOWN_SECONDS

		local ability, config = getProductConfigForAbility(abilityId)
		if not ability or not config then
			log(string.format(
				"[PromptRejected] player=%s ability=%s reason=UNKNOWN_ABILITY",
				player.Name,
				tostring(abilityId)
			))
			return
		end

		local pendingAbilityId = PerkMatchEffectService.GetPendingAbility(player)
		if pendingAbilityId then
			log(string.format(
				"[PromptRejected] player=%s ability=%s reason=PENDING_ABILITY_EXISTS current=%s",
				player.Name,
				abilityId,
				pendingAbilityId
			))
			return
		end

		local activeAbilityId = PerkMatchEffectService.GetActiveAbility(player)
		if activeAbilityId then
			log(string.format(
				"[PromptRejected] player=%s ability=%s reason=ACTIVE_ABILITY_EXISTS current=%s",
				player.Name,
				abilityId,
				activeAbilityId
			))
			return
		end

		if getActivePromptInFlight(player.UserId, now) then
			log(string.format(
				"[PromptRejected] player=%s ability=%s reason=PENDING_PURCHASE_EXISTS",
				player.Name,
				abilityId
			))
			return
		end

		local productId = tonumber(config.productId) or 0
		if productId <= 0 then
			log(string.format(
				"[PromptRejected] player=%s ability=%s reason=PRODUCT_ID_NOT_CONFIGURED",
				player.Name,
				abilityId
			))
			return
		end

		promptInFlightByUserId[player.UserId] = {
			abilityId = abilityId,
			productId = productId,
			createdAt = now,
		}

		log(string.format(
			"[PromptOpened] player=%s ability=%s productId=%d",
			player.Name,
			abilityId,
			productId
		))
		local promptOk, promptErr = pcall(function()
			MarketplaceService:PromptProductPurchase(player, productId)
		end)
		if not promptOk then
			log(string.format(
				"[PromptFailedToOpen] player=%s ability=%s productId=%d err=%s",
				player.Name,
				abilityId,
				productId,
				tostring(promptErr)
			))
			clearPromptInFlight(player.UserId, "PROMPT_OPEN_ERROR")
		end
	end)

	MarketplaceService.PromptProductPurchaseFinished:Connect(function(a, b, c)
		local userId: number? = nil
		local productId: number? = nil
		local wasPurchased: boolean? = nil

		if typeof(a) == "Instance" and a:IsA("Player") then
			userId = a.UserId
			productId = tonumber(b)
			wasPurchased = (c == true)
		else
			userId = tonumber(a)
			productId = tonumber(b)
			wasPurchased = (c == true)
		end

		if not userId or not productId or productId <= 0 then
			return
		end
		if not abilityProductIdToAbilityId[productId] then
			return
		end

		local promptState = promptInFlightByUserId[userId]
		if not promptState then
			return
		end
		if promptState.productId ~= productId then
			return
		end

		if wasPurchased then
			log(string.format(
				"[PromptSuccessAwaitingReceipt] userId=%d ability=%s productId=%d",
				userId,
				tostring(promptState.abilityId),
				productId
			))
			return
		end

		log(string.format(
			"[PromptCancelled] userId=%d ability=%s productId=%d",
			userId,
			tostring(promptState.abilityId),
			productId
		))
		clearPromptInFlight(userId, "PROMPT_CLOSED_OR_CANCELLED")
	end)

	Players.PlayerRemoving:Connect(function(player)
		clearPromptInFlight(player.UserId, "PLAYER_REMOVING")
		requestCooldownByUserId[player.UserId] = nil
	end)

	initialized = true
	log("Initialized")
end

return PerkProductService
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="90">
        <Properties>
          <string name="Name">PlayerDataBootstrap</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--[[
	PlayerDataBootstrap
	Initializes the persistence + equip + crate + level crown systems and wires player events.

	Runs once on server start. Must run EARLY (before MatchBootstrap).

	Systems initialized:
	  * PlayerDataService  (DataStore load / save)
	  * InventoryService   (equip / unequip validation)
	  * StatService         (stat calculation)
	  * CrateService        (crate opening logic)
	  * LevelCrownService   (wins milestone crown granting)
	  * RemoteEvents/Functions for client equip + crate actions
	  * Leaderboard seed-on-join (via GlobalLeaderboardService)
]]

local Players             = game:GetService("Players")
local ServerScriptService = game:GetService("ServerScriptService")
local ReplicatedStorage   = game:GetService("ReplicatedStorage")
local RunService          = game:GetService("RunService")

local Server = ServerScriptService:WaitForChild("Server")

local PlayerDataService   = require(Server:WaitForChild("PlayerDataService"))
local InventoryService    = require(Server:WaitForChild("InventoryService"))
local StatService         = require(Server:WaitForChild("StatService"))
local CrateService        = require(Server:WaitForChild("CrateService"))
local LevelCrownService   = require(Server:WaitForChild("LevelCrownService"))
local CrownAttachService  = require(Server:WaitForChild("CrownAttachService"))
local DailyRewardService  = require(Server:WaitForChild("DailyRewardService"))
local TutorialService     = require(Server:WaitForChild("TutorialService"))

local PlayerStateService  = require(Server:WaitForChild("PlayerStateService"))

local Shared      = ReplicatedStorage:WaitForChild("Shared")
local PlayerState = require(Shared:WaitForChild("PlayerState"))
local ItemCatalog = require(Shared:WaitForChild("ItemCatalog"))

local IS_STUDIO = RunService:IsStudio()

-- =====================================================================
-- BUILD_ID + SERVER IDENTITY  (visible in-game for version verification)
-- =====================================================================
local BUILD_ID = os.date("!%Y%m%d_%H%M", os.time())
local BUILD_LABEL = string.format("v%s | Place:%s | Game:%s",
	BUILD_ID, tostring(game.PlaceId), tostring(game.GameId))

warn("[BUILD] " .. BUILD_LABEL)

do
	local buildVal = ReplicatedStorage:FindFirstChild("BUILD_ID")
	if not buildVal then
		buildVal = Instance.new("StringValue")
		buildVal.Name = "BUILD_ID"
		buildVal.Parent = ReplicatedStorage
	end
	buildVal.Value = BUILD_LABEL
end

if ItemCatalog.ValidateAcquisitionLabels then
	ItemCatalog.ValidateAcquisitionLabels()
end

-- =====================================================================
-- STUDIO DEBUG: Grant all crowns + pets on join  (set to false to disable)
-- STUDIO_RESET_STATS: Reset ALL stats to 0 on join so testing starts fresh
-- =====================================================================
local STUDIO_GRANT_ALL   = false
local STUDIO_RESET_STATS = false

local function stripFNAFRigging()
	local function getOrCreateRoot(model: Model): BasePart?
		local root = model:FindFirstChild("Root")
		if root and root:IsA("BasePart") then
			model.PrimaryPart = root
			return root
		end
		local primary = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart", true)
		if not primary then
			return nil
		end
		primary.Name = "Root"
		model.PrimaryPart = primary
		return primary
	end

	local function ensureUnifiedAssembly(model: Model, root: BasePart)
		local connected = { [root] = true }
		for _, part in ipairs(root:GetConnectedParts(true)) do
			connected[part] = true
		end
		for _, d in ipairs(model:GetDescendants()) do
			if d:IsA("BasePart") then
				if not connected[d] and d ~= root then
					local weld = Instance.new("WeldConstraint")
					weld.Part0 = root
					weld.Part1 = d
					weld.Parent = d
				end
				d.CanCollide = false
				d.CanQuery = false
				d.CanTouch = false
				d.Massless = true
			end
		end
	end

	local function cleanupContainer(container: Instance?)
		if not container then return end
		for _, model in ipairs(container:GetChildren()) do
			if model:IsA("Model") then
				local root = getOrCreateRoot(model)
				for _, d in ipairs(model:GetDescendants()) do
					if d:IsA("Motor6D")
						or d:IsA("AnimationController")
						or d:IsA("Animator")
						or (d:IsA("Folder") and (d.Name == "Rig" or d.Name == "Motors"))
						or (d:IsA("Script") and string.find(string.lower(d.Name), "rig", 1, true))
					then
						d:Destroy()
					end
				end
				if root then
					ensureUnifiedAssembly(model, root)
				end
			end
		end
	end

	local petsRoot = ReplicatedStorage:FindFirstChild("Pets")
	local fnafDirect = petsRoot and petsRoot:FindFirstChild("Epic") and petsRoot.Epic:FindFirstChild("FNAF")
	cleanupContainer(fnafDirect)

	local itemModels = ReplicatedStorage:FindFirstChild("ItemModels")
	local fnafCatalog = itemModels
		and itemModels:FindFirstChild("Pets")
		and itemModels.Pets:FindFirstChild("Epic")
		and itemModels.Pets.Epic:FindFirstChild("FNAF")
	cleanupContainer(fnafCatalog)
end

-- Initialize services
PlayerDataService.Init()
InventoryService.Init()
StatService.Init()
CrateService.Init()
LevelCrownService.Init()
CrownAttachService.Init()
DailyRewardService.Init()
TutorialService.Init()
stripFNAFRigging()

-- =====================================================================
-- LAZY-LOAD GLBS (avoid circular require; GLBS may not be init yet)
-- =====================================================================
local _GLBS = nil
local function getGLBS()
	if _GLBS ~= nil then return _GLBS end
	local ok, mod = pcall(function()
		return require(Server:WaitForChild("GlobalLeaderboardService", 10))
	end)
	if ok and mod then
		_GLBS = mod
	else
		_GLBS = false
		warn("[PlayerDataBootstrap] GLBS not available:", tostring(mod))
	end
	return _GLBS
end

local function isValidUserId(userId: number): boolean
	if type(userId) ~= "number" then return false end
	if userId == 0 then return false end
	if userId > 0 then return true end
	return IS_STUDIO
end

-- =====================================================================
-- REMOTE EVENTS FOR EQUIP / UNEQUIP
-- =====================================================================

local remotesFolder = ReplicatedStorage:FindFirstChild("Remotes")
if not remotesFolder then
	remotesFolder = Instance.new("Folder")
	remotesFolder.Name = "Remotes"
	remotesFolder.Parent = ReplicatedStorage
end

local function ensureRemote(name: string): RemoteEvent
	local event = remotesFolder:FindFirstChild(name)
	if not event then
		event = Instance.new("RemoteEvent")
		event.Name = name
		event.Parent = remotesFolder
	end
	return event
end

local function ensureRemoteFunction(name: string): RemoteFunction
	local func = remotesFolder:FindFirstChild(name)
	if not func then
		func = Instance.new("RemoteFunction")
		func.Name = name
		func.Parent = remotesFolder
	end
	return func
end

local equipEvent      = ensureRemote("EquipItem")
local unequipEvent    = ensureRemote("UnequipItem")
local equipIconEvent  = ensureRemote("EquipIconEvent")
local inventoryUpdate = ensureRemote("InventoryUpdated")
local openCrateFunc   = ensureRemoteFunction("OpenCrate")
local buyCrateFunc    = ensureRemoteFunction("BuyCrate")
local getCratesFunc   = ensureRemoteFunction("GetOwnedCrates")
local openOwnedCratesFunc = ensureRemoteFunction("OpenOwnedCrates")

equipEvent.OnServerEvent:Connect(function(player, category, id)
	if type(category) ~= "string" or type(id) ~= "string" then return end
	if not PlayerDataService.IsLoaded(player) then
		warn("[PlayerDataBootstrap] Equip rejected -- data not loaded for", player.Name)
		return
	end

	local state = PlayerStateService.GetState(player)
	if state == PlayerState.States.InMatch then
		warn(string.format("[PlayerDataBootstrap] Equip rejected -- %s is InMatch (cannot change %s/%s)",
			player.Name, category, id))
		return
	end

	local result = InventoryService.EquipItem(player, category, id)
	if result.success then
		StatService.RecalculateStats(player)
	else
		warn(string.format("[PlayerDataBootstrap] Equip failed %s: %s/%s -- %s",
			player.Name, category, id, result.reason or "unknown"))
	end
end)

unequipEvent.OnServerEvent:Connect(function(player, category)
	if type(category) ~= "string" then return end
	if not PlayerDataService.IsLoaded(player) then return end

	local state = PlayerStateService.GetState(player)
	if state == PlayerState.States.InMatch then
		warn(string.format("[PlayerDataBootstrap] Unequip rejected -- %s is InMatch (cannot change %s)",
			player.Name, category))
		return
	end

	local result = InventoryService.UnequipItem(player, category)
	if result.success then
		StatService.RecalculateStats(player)
	end
end)

equipIconEvent.OnServerEvent:Connect(function(player, iconId)
	if type(iconId) ~= "string" or iconId == "" then
		equipIconEvent:FireClient(player, {
			success = false,
			reason = "Invalid icon id",
			equippedIconId = player:GetAttribute("EquippedIconImage") or "",
		})
		return
	end
	if not PlayerDataService.IsLoaded(player) then
		equipIconEvent:FireClient(player, {
			success = false,
			reason = "Data not loaded",
			equippedIconId = player:GetAttribute("EquippedIconImage") or "",
		})
		return
	end

	local state = PlayerStateService.GetState(player)
	if state == PlayerState.States.InMatch then
		equipIconEvent:FireClient(player, {
			success = false,
			reason = "Cannot change icons during match",
			equippedIconId = player:GetAttribute("EquippedIconImage") or "",
		})
		return
	end

	local iconDef = ItemCatalog.Get("IconImages", iconId)
	if not iconDef then
		equipIconEvent:FireClient(player, {
			success = false,
			reason = "Icon not found in catalog",
			equippedIconId = player:GetAttribute("EquippedIconImage") or "",
		})
		return
	end

	if not InventoryService.OwnsItem(player, "IconImages", iconId) then
		equipIconEvent:FireClient(player, {
			success = false,
			reason = "Icon not owned",
			equippedIconId = player:GetAttribute("EquippedIconImage") or "",
		})
		return
	end

	local currentlyEquipped = PlayerDataService.GetField(player, "EquippedIconImage")
	local result
	local newEquippedIconId = ""
	if currentlyEquipped == iconId then
		result = InventoryService.UnequipItem(player, "IconImages")
		newEquippedIconId = ""
	else
		result = InventoryService.EquipItem(player, "IconImages", iconId)
		newEquippedIconId = iconId
	end

	local success = result and result.success == true
	equipIconEvent:FireClient(player, {
		success = success,
		reason = success and "" or tostring(result and result.reason or "Unknown error"),
		equippedIconId = success and newEquippedIconId or (player:GetAttribute("EquippedIconImage") or ""),
	})
end)

-- =====================================================================
-- CRATE OPENING (RemoteFunction -- client needs the result back)
-- =====================================================================

openCrateFunc.OnServerInvoke = function(player, crateId, quantity)
	if not PlayerDataService.IsLoaded(player) then
		return { results = {}, success = false, error = "Data not loaded" }
	end

	local result = CrateService.OpenCrate(player, crateId, quantity)

	if result.success and #result.results > 0 then
		inventoryUpdate:FireClient(player, "CrateOpened", result.results)
	end

	return result
end

buyCrateFunc.OnServerInvoke = function(player, crateId, quantity, currencyCode)
	print(string.format("[CrateBuy] START player=%s crateType=%s qty=%s currency=%s",
		player.Name, tostring(crateId), tostring(quantity), tostring(currencyCode)))
	if not PlayerDataService.IsLoaded(player) then
		print("[CrateBuy] FAIL reason=Data not loaded")
		return { success = false, reason = "Data not loaded" }
	end
	if type(currencyCode) ~= "string" then
		print("[CrateBuy] FAIL reason=Invalid currency")
		return { success = false, reason = "Invalid currency" }
	end
	if currencyCode ~= "Coins" then
		print("[CrateBuy] FAIL reason=Robux must use product prompt")
		return { success = false, reason = "Robux must use product prompt" }
	end

	local result = CrateService.BuyCrateWithCoins(player, crateId, quantity)
	if result.success then
		local counts = CrateService.GetCrateCounts(player)
		inventoryUpdate:FireClient(player, "CrateBalance", {
			crateId = crateId,
			newCount = result.newCount,
			counts = counts,
			qty = quantity,
		})
		print(string.format("[CrateBuy] SUCCESS player=%s crateType=%s qty=%s newCount=%s",
			player.Name, tostring(crateId), tostring(quantity), tostring(result.newCount)))
	else
		print(string.format("[CrateBuy] FAIL reason=%s", tostring(result.reason)))
	end
	return result
end

getCratesFunc.OnServerInvoke = function(player)
	if not PlayerDataService.IsLoaded(player) then
		return {}
	end
	return CrateService.GetCrateCounts(player)
end

openOwnedCratesFunc.OnServerInvoke = function(player, crateId, quantity)
	print(string.format("[CrateOpen] START player=%s crateType=%s qty=%s",
		player.Name, tostring(crateId), tostring(quantity)))
	if not PlayerDataService.IsLoaded(player) then
		print("[CrateOpen] FAIL reason=Data not loaded")
		return { results = {}, success = false, error = "Data not loaded" }
	end
	local result = CrateService.OpenOwnedCrates(player, crateId, quantity)
	if result.success then
		local counts = CrateService.GetCrateCounts(player)
		inventoryUpdate:FireClient(player, "CrateBalance", {
			crateId = crateId,
			newCount = result.newCount,
			counts = counts,
		})
		inventoryUpdate:FireClient(player, "CrateOpened", result.results)
		local rewardsCount = type(result.results) == "table" and #result.results or 0
		print(string.format("[CrateOpen] RESULT player=%s crateType=%s qty=%s rewards=%d",
			player.Name, tostring(crateId), tostring(quantity), rewardsCount))
	else
		print(string.format("[CrateOpen] FAIL reason=%s", tostring(result.error)))
	end
	return result
end

-- =====================================================================
-- PLAYER LIFECYCLE
-- =====================================================================

local function onPlayerAdded(player: Player)
	local data = PlayerDataService.LoadPlayer(player)

	if STUDIO_GRANT_ALL and data then
		local granted = 0
		if ItemCatalog.Crowns then
			for crownId, _ in pairs(ItemCatalog.Crowns) do
				if not InventoryService.OwnsItem(player, "Crowns", crownId) then
					InventoryService.GrantItem(player, "Crowns", crownId)
					granted += 1
				end
			end
		end
		if ItemCatalog.Pets then
			for petId, _ in pairs(ItemCatalog.Pets) do
				if not InventoryService.OwnsItem(player, "Pets", petId) then
					InventoryService.GrantItem(player, "Pets", petId)
					granted += 1
				end
			end
		end
		if ItemCatalog.IconImages then
			for iconId, _ in pairs(ItemCatalog.IconImages) do
				if not InventoryService.OwnsItem(player, "IconImages", iconId) then
					InventoryService.GrantItem(player, "IconImages", iconId)
					granted += 1
				end
			end
		end
		if (data.Coins or 0) < 50000 then
			data.Coins = 50000
			PlayerDataService.SetField(player, "Coins", 50000)
		end
		PlayerDataService.SetField(player, "LastDailyRewardTime", 0)
		PlayerDataService.SetField(player, "DailyStreak", 0)
		print("[DEBUG] Daily rewards RESET for", player.Name, "(Studio testing)")

		if granted > 0 then
			print(string.format("[DEBUG] Granted %d items to %s (Studio grant-all)", granted, player.Name))
		end
	end

	if STUDIO_RESET_STATS and data then
		local statsToZero = {
			"LifetimeWins", "WeeklyWins", "LifetimeCoinsAchieved",
			"WeeklyCoinsAchieved", "LifetimeDeaths", "TimePlayedSeconds",
		}
		for _, key in ipairs(statsToZero) do
			data[key] = 0
			PlayerDataService.SetField(player, key, 0)
		end
		data.Coins = 0
		PlayerDataService.SetField(player, "Coins", 0)
		data.OwnedCrowns = {}
		PlayerDataService.SetField(player, "OwnedCrowns", {})
		data.EquippedCrown = nil
		PlayerDataService.SetField(player, "EquippedCrown", nil)
		data.OwnedPets = {}
		PlayerDataService.SetField(player, "OwnedPets", {})
		data.EquippedPet = nil
		PlayerDataService.SetField(player, "EquippedPet", nil)
		data.OwnedIcons = {}
		PlayerDataService.SetField(player, "OwnedIcons", {})
		data.EquippedIcon = nil
		PlayerDataService.SetField(player, "EquippedIcon", nil)
		data.OwnedIconImages = {}
		PlayerDataService.SetField(player, "OwnedIconImages", {})
		data.EquippedIconImage = nil
		PlayerDataService.SetField(player, "EquippedIconImage", nil)
		data.LastDailyRewardTime = 0
		PlayerDataService.SetField(player, "LastDailyRewardTime", 0)
		data.DailyStreak = 0
		PlayerDataService.SetField(player, "DailyStreak", 0)
		print(string.format("[DEBUG] All stats RESET to 0 for %s (Studio clean testing)", player.Name))
	end

	TutorialService.ApplyLoadedState(player)
	StatService.RecalculateStats(player)

	task.spawn(function()
		local milestoneResult = LevelCrownService.CheckMilestones(player)
		if milestoneResult.granted and #milestoneResult.granted > 0 then
			inventoryUpdate:FireClient(player, "LevelCrowns", milestoneResult.granted)
			StatService.RecalculateStats(player)
		end
	end)

	player:GetAttributeChangedSignal("LifetimeWins"):Connect(function()
		if not PlayerDataService.IsLoaded(player) then return end
		local milestoneResult = LevelCrownService.CheckMilestones(player)
		if milestoneResult.granted and #milestoneResult.granted > 0 then
			inventoryUpdate:FireClient(player, "LevelCrowns", milestoneResult.granted)
			StatService.RecalculateStats(player)
		end
	end)

	if data and isValidUserId(player.UserId) then
		task.spawn(function()
			task.wait(1.5)

			local GLBS = getGLBS()
			if GLBS and GLBS ~= false and type(GLBS.SeedPlayerBoardsFromSavedData) == "function" then
				warn(string.format("[PlayerDataBootstrap] Seeding leaderboard for %s (userId=%d, studio=%s)", player.Name, player.UserId, tostring(IS_STUDIO)))

				if type(GLBS.Init) == "function" then
					pcall(GLBS.Init)
				end

				GLBS.SeedPlayerBoardsFromSavedData(player.UserId, data)

				task.delay(3, function()
					if GLBS and type(GLBS.RefreshAll) == "function" then
						warn("[PlayerDataBootstrap] Post-seed RefreshAll for " .. player.Name)
						pcall(GLBS.RefreshAll)
					end
				end)
			else
				warn("[PlayerDataBootstrap] GLBS.SeedPlayerBoardsFromSavedData not available -- skipping seed")
			end
		end)
	end

	player.CharacterAdded:Connect(function()
		task.wait(0.1)
		StatService.RecalculateStats(player)
	end)
end

local function onPlayerRemoving(player: Player)
	PlayerDataService.SavePlayer(player)
	StatService.OnPlayerRemoving(player)
	PlayerDataService.UnloadPlayer(player)
end

Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(onPlayerRemoving)

for _, player in ipairs(Players:GetPlayers()) do
	task.spawn(function()
		onPlayerAdded(player)
	end)
end

game:BindToClose(function()
	PlayerDataService.SaveAll()
end)

-- =====================================================================
-- TIME PLAYED TRACKING
-- =====================================================================
task.spawn(function()
	while true do
		task.wait(1)
		for _, player in ipairs(Players:GetPlayers()) do
			if PlayerDataService.IsLoaded(player) then
				local secs = (PlayerDataService.GetField(player, "TimePlayedSeconds") or 0) + 1
				PlayerDataService.SetField(player, "TimePlayedSeconds", secs)
			end
		end
	end
end)

-- =====================================================================
-- CREATOR-ONLY ADMIN COMMANDS (works in both Studio + Live)
--   !wipe             -- wipe own profile + own leaderboard entries
--   !wipeid <userId>  -- wipe a specific userId (profile + boards)
--   !wipeall          -- wipe ALL profiles on server + clear ALL boards
--   !boards           -- dump full leaderboard state for debugging
--   !setcoins <n>     -- set own coins
--   !shutdown          -- kick all + save
--   !purge             -- remove negative userId entries from ODS
--   !season            -- show current leaderboard season
--   !buildid           -- show build + season info
-- =====================================================================
local CREATOR_ID = game.CreatorId

local function isCreator(player: Player): boolean
	if game.CreatorType == Enum.CreatorType.User then
		return player.UserId == CREATOR_ID
	end
	return player:GetRankInGroup(CREATOR_ID) >= 255
end

local function wipePlayerProfile(targetPlayer: Player)
	local defaults = require(Shared:WaitForChild("PlayerData")).GetDefaults()
	for key, val in pairs(defaults) do
		PlayerDataService.SetField(targetPlayer, key, val)
	end
	PlayerDataService.SavePlayer(targetPlayer)
	StatService.RecalculateStats(targetPlayer)
end

local function wipeOfflineUserId(targetId: number)
	local DataStoreService = game:GetService("DataStoreService")
	local PlayerDataModule = require(Shared:WaitForChild("PlayerData"))
	local storeName = PlayerDataModule.STORE_NAME
	local key = PlayerDataModule.KEY_PREFIX .. tostring(targetId)
	local defaults = PlayerDataModule.GetDefaults()

	local ok, err = pcall(function()
		local store = DataStoreService:GetDataStore(storeName)
		store:SetAsync(key, defaults)
	end)
	if ok then
		warn(string.format("[ADMIN] Wiped offline userId=%d DataStore (%s / %s)", targetId, storeName, key))
	else
		warn(string.format("[ADMIN] FAILED to wipe offline userId=%d: %s", targetId, tostring(err)))
	end
	return ok
end

local function removeFromLeaderboards(targetId: number)
	local GLBS = getGLBS()
	if GLBS and GLBS ~= false then
		if type(GLBS.RemovePlayerEntries) == "function" then
			GLBS.RemovePlayerEntries(targetId)
			warn(string.format("[ADMIN] Leaderboard entries removed for userId=%d", targetId))
		else
			warn("[ADMIN] GLBS.RemovePlayerEntries not available!")
		end
		if type(GLBS.ClearSeedFlag) == "function" then
			GLBS.ClearSeedFlag(targetId)
		end
	else
		warn("[ADMIN] GLBS not loaded — cannot remove leaderboard entries")
	end
end

local function handleAdminCommand(player: Player, message: string)
	if not isCreator(player) then return end
	local args = string.split(string.lower(message), " ")
	local cmd = args[1]

	if cmd == "!wipe" then
		wipePlayerProfile(player)
		warn(string.format("[ADMIN] %s (userId=%d) wiped OWN profile — defaults restored, saved", player.Name, player.UserId))
		removeFromLeaderboards(player.UserId)
		warn(string.format("[ADMIN] !wipe affects only YOUR userId=%d. Use !wipeid <id> for alts, or !wipeall to nuke everything.", player.UserId))

	elseif cmd == "!wipeid" then
		local targetId = tonumber(args[2])
		if not targetId then
			warn("[ADMIN] Usage: !wipeid <userId>")
			return
		end
		targetId = math.floor(targetId)
		warn(string.format("[ADMIN] %s requested wipe of userId=%d", player.Name, targetId))

		local targetPlayer = nil
		for _, p in ipairs(Players:GetPlayers()) do
			if p.UserId == targetId then
				targetPlayer = p
				break
			end
		end

		if targetPlayer then
			wipePlayerProfile(targetPlayer)
			warn(string.format("[ADMIN] Wiped in-server player %s (userId=%d)", targetPlayer.Name, targetId))
		else
			wipeOfflineUserId(targetId)
		end

		removeFromLeaderboards(targetId)

	elseif cmd == "!wipeall" then
		warn(string.format("[ADMIN] %s requested FULL WIPE — all profiles + all boards", player.Name))

		for _, p in ipairs(Players:GetPlayers()) do
			if PlayerDataService.IsLoaded(p) then
				wipePlayerProfile(p)
				warn(string.format("[ADMIN] Wiped profile: %s (userId=%d)", p.Name, p.UserId))
			end
		end

		local GLBS = getGLBS()
		if GLBS and GLBS ~= false then
			if type(GLBS.ClearAllBoards) == "function" then
				GLBS.ClearAllBoards()
				warn("[ADMIN] All leaderboard boards CLEARED + refreshed")
			else
				for _, p in ipairs(Players:GetPlayers()) do
					removeFromLeaderboards(p.UserId)
				end
			end
		end

	elseif cmd == "!boards" then
		warn(string.format("[ADMIN] %s requested board state dump", player.Name))
		local GLBS = getGLBS()
		if GLBS and GLBS ~= false and type(GLBS.DumpBoardState) == "function" then
			GLBS.DumpBoardState()
		else
			warn("[ADMIN] GLBS.DumpBoardState not available")
		end

	elseif cmd == "!setcoins" then
		local amount = tonumber(args[2])
		if not amount then return end
		amount = math.clamp(math.floor(amount), 0, 9999999)
		PlayerDataService.SetField(player, "Coins", amount)
		warn(string.format("[ADMIN] %s set coins to %d", player.Name, amount))

	elseif cmd == "!shutdown" then
		warn(string.format("[ADMIN] %s requested server shutdown", player.Name))
		task.defer(function()
			for _, p in ipairs(Players:GetPlayers()) do
				p:Kick("Server restarting -- please rejoin for the latest version.")
			end
			task.wait(1)
			PlayerDataService.SaveAll()
		end)

	elseif cmd == "!purge" then
		warn(string.format("[ADMIN] %s requested test entry purge", player.Name))
		task.spawn(function()
			local GLBS = getGLBS()
			if GLBS and GLBS ~= false and type(GLBS.PurgeTestEntries) == "function" then
				GLBS.PurgeTestEntries()
			end
		end)

	elseif cmd == "!season" then
		local GLBS = getGLBS()
		local season = (GLBS and GLBS ~= false and GLBS.SEASON) or "?"
		warn(string.format("[ADMIN] Leaderboard season: %s  (bump LEADERBOARD_SEASON in GlobalLeaderboardService to reset all boards)", season))

	elseif cmd == "!buildid" then
		local GLBS = getGLBS()
		local season = (GLBS and GLBS ~= false and GLBS.SEASON) or "?"
		warn(string.format("[ADMIN] BUILD_ID for %s: %s  SEASON=%s", player.Name, BUILD_LABEL, season))
	end
end

Players.PlayerAdded:Connect(function(player)
	player.Chatted:Connect(function(msg)
		if string.sub(msg, 1, 1) == "!" then
			handleAdminCommand(player, msg)
		end
	end)
end)
for _, player in ipairs(Players:GetPlayers()) do
	player.Chatted:Connect(function(msg)
		if string.sub(msg, 1, 1) == "!" then
			handleAdminCommand(player, msg)
		end
	end)
end

print("[PlayerDataBootstrap] Persistence + equip + crate + level crowns + daily rewards + tutorial onboarding + leaderboard seed + stats tracking + admin commands ready")
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="91">
        <Properties>
          <string name="Name">PlayerDataService</string>
          <string name="Source"><![CDATA[--[[
	PlayerDataService
	Server-authoritative persistent player data.

	Loads from DataStore on PlayerAdded, saves on PlayerRemoving and
	server shutdown.  In-memory cache for fast access.  Replicates key
	fields to client via player attributes.

	API:
		Init()
		LoadPlayer(player)        -> data table
		SavePlayer(player)        -> boolean
		UnloadPlayer(player)
		GetData(player)           -> data table | nil
		IsLoaded(player)          -> boolean
		SetField(player, key, v)  -> boolean
		GetField(player, key)     -> value
		SaveAll()
]]

local DataStoreService  = game:GetService("DataStoreService")
local Players           = game:GetService("Players")
local HttpService       = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService        = game:GetService("RunService")

local IS_STUDIO = RunService:IsStudio()

local Shared     = ReplicatedStorage:WaitForChild("Shared")
local PlayerData = require(Shared:WaitForChild("PlayerData"))
local ItemCatalog = require(Shared:WaitForChild("ItemCatalog"))

local PlayerDataService = {}

local dataStore: DataStore? = nil
local playerCache: { [number]: { [string]: any } } = {}
local loadedPlayers: { [number]: boolean } = {}
local initialized = false

local DEBUG_LOG          = true
local RETRY_ATTEMPTS     = 3
local RETRY_DELAY        = 1
local AUTO_SAVE_INTERVAL = 300

local function log(...)
	if DEBUG_LOG then print("[PlayerDataService]", ...) end
end

local function listContainsString(listValue: any, needle: string): boolean
	if type(listValue) ~= "table" or type(needle) ~= "string" or needle == "" then
		return false
	end
	for _, entry in ipairs(listValue) do
		if entry == needle then
			return true
		end
	end
	return false
end

local function sanitizeEquippedCosmeticOwnership(data: { [string]: any }, playerName: string, context: string): boolean
	local changed = false

	local mappings = {
		{
			equippedKey = "EquippedPet",
			ownedKey = "OwnedPets",
			catalogCategory = "Pets",
		},
		{
			equippedKey = "EquippedCrown",
			ownedKey = "OwnedCrowns",
			catalogCategory = "Crowns",
		},
		{
			equippedKey = "EquippedIconImage",
			ownedKey = "OwnedIconImages",
			catalogCategory = "IconImages",
		},
	}

	for _, mapping in ipairs(mappings) do
		local equippedId = data[mapping.equippedKey]
		if type(equippedId) == "string" and equippedId ~= "" then
			local ownsEquipped = listContainsString(data[mapping.ownedKey], equippedId)
			local inCatalog = ItemCatalog.Get(mapping.catalogCategory, equippedId) ~= nil
			if not ownsEquipped or not inCatalog then
				data[mapping.equippedKey] = nil
				changed = true
				warn(string.format(
					"[PlayerDataService] Cleared invalid equipped item player=%s context=%s equippedKey=%s equippedId=%s owns=%s inCatalog=%s",
					playerName,
					context,
					mapping.equippedKey,
					equippedId,
					tostring(ownsEquipped),
					tostring(inCatalog)
				))
			end
		end
	end

	return changed
end

-- =====================================================================
-- ATTRIBUTE REPLICATION
-- =====================================================================

local function replicateToClient(player: Player, data: { [string]: any })
	local A = PlayerData.Attributes

	player:SetAttribute(A.Coins,         data.Coins or 0)
	player:SetAttribute(A.LifetimeWins,  data.LifetimeWins or 0)
	player:SetAttribute(A.CoinMultiplier, 1)
	player:SetAttribute(A.VIPBundleOwned, data.VIPBundleOwned == true)

	player:SetAttribute(A.LifetimeCoinsAchieved, data.LifetimeCoinsAchieved or 0)
	player:SetAttribute(A.WeeklyWins,             data.WeeklyWins or 0)
	player:SetAttribute(A.WeeklyCoinsAchieved,    data.WeeklyCoinsAchieved or 0)

	player:SetAttribute(A.EquippedPet,   data.EquippedPet or "")
	player:SetAttribute(A.EquippedCrown, data.EquippedCrown or "")
	player:SetAttribute(A.EquippedIcon,  data.EquippedIcon or "")

	player:SetAttribute(A.OwnedPets,   HttpService:JSONEncode(data.OwnedPets or {}))
	player:SetAttribute(A.OwnedCrowns, HttpService:JSONEncode(data.OwnedCrowns or {}))
	player:SetAttribute(A.OwnedIcons,  HttpService:JSONEncode(data.OwnedIcons or {}))

	player:SetAttribute(A.EquippedIconImage, data.EquippedIconImage or "")
	player:SetAttribute(A.OwnedIconImages,   HttpService:JSONEncode(data.OwnedIconImages or {}))
	player:SetAttribute(A.OwnedCrates,       HttpService:JSONEncode(data.OwnedCrates or {}))

	player:SetAttribute(A.LifetimeDeaths,    data.LifetimeDeaths or 0)
	player:SetAttribute(A.TimePlayedSeconds, data.TimePlayedSeconds or 0)
	player:SetAttribute(A.TutorialCompleted, data.TutorialCompleted == true)
end

local function replicateField(player: Player, key: string, value: any)
	local A = PlayerData.Attributes

	if key == "Coins" then
		player:SetAttribute(A.Coins, value or 0)
	elseif key == "LifetimeWins" then
		player:SetAttribute(A.LifetimeWins, value or 0)
	elseif key == "VIPBundleOwned" then
		player:SetAttribute(A.VIPBundleOwned, value == true)
	elseif key == "LifetimeCoinsAchieved" then
		player:SetAttribute(A.LifetimeCoinsAchieved, value or 0)
	elseif key == "WeeklyWins" then
		player:SetAttribute(A.WeeklyWins, value or 0)
	elseif key == "WeeklyCoinsAchieved" then
		player:SetAttribute(A.WeeklyCoinsAchieved, value or 0)
	elseif key == "EquippedPet" then
		player:SetAttribute(A.EquippedPet, value or "")
	elseif key == "EquippedCrown" then
		player:SetAttribute(A.EquippedCrown, value or "")
	elseif key == "EquippedIcon" then
		player:SetAttribute(A.EquippedIcon, value or "")
	elseif key == "OwnedPets" then
		player:SetAttribute(A.OwnedPets, HttpService:JSONEncode(value or {}))
	elseif key == "OwnedCrowns" then
		player:SetAttribute(A.OwnedCrowns, HttpService:JSONEncode(value or {}))
	elseif key == "OwnedIcons" then
		player:SetAttribute(A.OwnedIcons, HttpService:JSONEncode(value or {}))
	elseif key == "EquippedIconImage" then
		player:SetAttribute(A.EquippedIconImage, value or "")
	elseif key == "OwnedIconImages" then
		player:SetAttribute(A.OwnedIconImages, HttpService:JSONEncode(value or {}))
	elseif key == "OwnedCrates" then
		player:SetAttribute(A.OwnedCrates, HttpService:JSONEncode(value or {}))
	elseif key == "LifetimeDeaths" then
		player:SetAttribute(A.LifetimeDeaths, value or 0)
	elseif key == "TimePlayedSeconds" then
		player:SetAttribute(A.TimePlayedSeconds, value or 0)
	elseif key == "TutorialCompleted" then
		player:SetAttribute(A.TutorialCompleted, value == true)
	end
end

-- =====================================================================
-- DATASTORE OPERATIONS
-- =====================================================================

local function getKey(userId: number): string
	return PlayerData.KEY_PREFIX .. tostring(userId)
end

local function loadFromStore(userId: number): { [string]: any }?
	if not dataStore then return nil end

	local key = getKey(userId)
	for attempt = 1, RETRY_ATTEMPTS do
		local ok, result = pcall(function()
			return dataStore:GetAsync(key)
		end)
		if ok then return result end
		warn(string.format("[PlayerDataService] Load attempt %d/%d failed for userId %d: %s",
			attempt, RETRY_ATTEMPTS, userId, tostring(result)))
		if attempt < RETRY_ATTEMPTS then task.wait(RETRY_DELAY) end
	end
	warn(string.format("[PlayerDataService] All load attempts failed for userId %d", userId))
	return nil
end

local function saveToStore(userId: number, data: { [string]: any }): boolean
	if not dataStore then return false end

	local key = getKey(userId)
	for attempt = 1, RETRY_ATTEMPTS do
		local ok, err = pcall(function()
			dataStore:SetAsync(key, data)
		end)
		if ok then return true end
		warn(string.format("[PlayerDataService] Save attempt %d/%d failed for userId %d: %s",
			attempt, RETRY_ATTEMPTS, userId, tostring(err)))
		if attempt < RETRY_ATTEMPTS then task.wait(RETRY_DELAY) end
	end
	warn(string.format("[PlayerDataService] All save attempts failed for userId %d", userId))
	return false
end

-- =====================================================================
-- PUBLIC API
-- =====================================================================

function PlayerDataService.Init()
	if initialized then
		warn("[PlayerDataService] Already initialized")
		return
	end
	initialized = true

	local ok, store = pcall(function()
		return DataStoreService:GetDataStore(PlayerData.STORE_NAME)
	end)
	if ok then
		dataStore = store
		log("DataStore connected:", PlayerData.STORE_NAME)
	else
		warn("[PlayerDataService] DataStore unavailable:", tostring(store))
	end

	task.spawn(function()
		while true do
			task.wait(AUTO_SAVE_INTERVAL)
			PlayerDataService.SaveAll()
		end
	end)

	log("Initialized")
end

function PlayerDataService.LoadPlayer(player: Player): { [string]: any }
	local userId = player.UserId
	if playerCache[userId] then
		log(player.Name, "already loaded -- returning cached data")
		return playerCache[userId]
	end

	local rawData = loadFromStore(userId)
	local data: { [string]: any }

	if rawData and type(rawData) == "table" then
		data = PlayerData.Validate(rawData)
		sanitizeEquippedCosmeticOwnership(data, player.Name, "LoadPlayer")
		log(string.format("%s loaded from DataStore (Coins=%d Pets=%d Crowns=%d Wins=%d)",
			player.Name, data.Coins, #data.OwnedPets, #data.OwnedCrowns, data.LifetimeWins))
	else
		data = PlayerData.GetDefaults()
		log(string.format("%s -- new player, using defaults", player.Name))
	end

	playerCache[userId]  = data
	loadedPlayers[userId] = true

	replicateToClient(player, data)
	warn(string.format("[VIPPersistence] player=%s vipBundleOwned=%s loaded=true",
		player.Name, tostring(data.VIPBundleOwned == true)))
	return data
end

function PlayerDataService.SavePlayer(player: Player): boolean
	local userId = player.UserId
	local data = playerCache[userId]
	if not data then
		log(player.Name, "-- no cached data to save")
		return false
	end
	local success = saveToStore(userId, data)
	if success then
		log(player.Name, "saved")
		warn(string.format("[VIPPersistence] player=%s vipBundleOwned=%s saved=true",
			player.Name, tostring(data.VIPBundleOwned == true)))
	end
	return success
end

function PlayerDataService.UnloadPlayer(player: Player)
	local userId = player.UserId
	playerCache[userId]   = nil
	loadedPlayers[userId] = nil
end

function PlayerDataService.GetData(player: Player): { [string]: any }?
	return playerCache[player.UserId]
end

function PlayerDataService.IsLoaded(player: Player): boolean
	return loadedPlayers[player.UserId] == true
end

function PlayerDataService.SetField(player: Player, key: string, value: any): boolean
	local data = playerCache[player.UserId]
	if not data then
		warn("[PlayerDataService] SetField failed -- data not loaded for", player.Name)
		return false
	end
	data[key] = value
	if key == "VIPBundleOwned" then
		warn(string.format("[VIPPersistence] player=%s vipBundleOwned=%s saved=true",
			player.Name, tostring(value == true)))
	end
	local corrected = sanitizeEquippedCosmeticOwnership(data, player.Name, "SetField_" .. key)
	replicateField(player, key, data[key])
	if corrected then
		replicateField(player, "EquippedPet", data.EquippedPet)
		replicateField(player, "EquippedCrown", data.EquippedCrown)
		replicateField(player, "EquippedIconImage", data.EquippedIconImage)
	end
	return true
end

function PlayerDataService.GetField(player: Player, key: string): any
	local data = playerCache[player.UserId]
	if not data then return nil end
	return data[key]
end

function PlayerDataService.SaveAll()
	local count = 0
	for userId, data in pairs(playerCache) do
		local success = saveToStore(userId, data)
		if success then count += 1 end
	end
	if count > 0 then
		log(string.format("Saved %d player(s)", count))
	end
end

return PlayerDataService
]]></string>
