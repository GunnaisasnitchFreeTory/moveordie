	footer.Size = UDim2.new(1, -24, 0, 20)
	footer.BackgroundTransparency = 1
	footer.Font = Enum.Font.GothamSemibold
	footer.TextColor3 = Color3.fromRGB(220, 225, 240)
	footer.TextSize = 13
	footer.Text = "This does not cast a real vote. Purchase validation is server-side."
	footer.ZIndex = PANEL_ZINDEX + 2
	footer.Parent = panelFrame

	refreshSubtitle()
end

function ForceNextModePanel.Init(onClose)
	if initialized then
		return
	end
	initialized = true
	closeCallback = onClose

	createGui()
	ResetForceNextModeVisualState()
	if backdropFrame then
		backdropFrame.Visible = false
	end
	if panelFrame then
		panelFrame.Visible = false
	end
	if gui then
		gui.Enabled = false
	end

	task.spawn(function()
		local remotes = ReplicatedStorage:WaitForChild("Remotes", 15)
		if remotes then
			promptRemote = remotes:WaitForChild("ForceNextModePromptRequest", 15)
		end

		local matchStatus = ReplicatedStorage:WaitForChild("MatchStatus", 15)
		if matchStatus then
			local stateInst = matchStatus:WaitForChild("State", 5)
			local voteActiveInst = matchStatus:WaitForChild("ModeVoteActive", 5)

			if stateInst and stateInst:IsA("StringValue") then
				stateValue = stateInst
				stateValue.Changed:Connect(function()
					refreshSubtitle()
					if isPlayingState() and visible then
						hidePanel()
					end
				end)
			end

			if voteActiveInst and voteActiveInst:IsA("BoolValue") then
				voteActiveValue = voteActiveInst
				voteActiveValue.Changed:Connect(function()
					refreshSubtitle()
				end)
			end
		end

		refreshSubtitle()
	end)

	log("Initialized")
end

function ForceNextModePanel.Show()
	if visible then
		log("Show skipped: panel already open")
		return
	end

	if isPlayingState() then
		log("Show skipped: match is already playing")
		return
	end

	if not gui then
		createGui()
	end
	if not gui or not panelFrame then
		return
	end

	lifecycleVersion += 1
	refreshSubtitle()
	visible = true
	setGuiPreferredEnabled(true)
	ResetForceNextModeVisualState()
	gui.Enabled = true
	playOpenAnimation()
	logVisualState("Show")
	log("Shown")
end

function ForceNextModePanel.Hide()
	hidePanel()
end

function ForceNextModePanel.Toggle()
	if visible then
		hidePanel()
	else
		ForceNextModePanel.Show()
	end
end

function ForceNextModePanel.IsVisible(): boolean
	return visible
end

return ForceNextModePanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="153">
            <Properties>
              <string name="Name">HUDPanel</string>
              <string name="Source"><![CDATA[--[[
	HUDPanel
	Always-visible heads-up display:
	  * Coin counter (top-left) -- glossy capsule, gold "F" icon
	  * Round badge (top-center) -- shows "Lobby" / "Round X" / "Results"
	  * Timer label (below round badge) -- shows seconds left
	  * 2x4 sidebar grid (left) -- Shop, Crowns, Pets, Index,
	    Spectate, Settings, AFK toggle, Icon Images
	  * Intermission bar (top-center) -- single bright horizontal pill
	    REPLACES the round badge during intermission (no duplicate!)

	KEY FIX: During intermission, the round badge + state label HIDE,
	and a single horizontal bar shows "Game starting in X".
	When playing, the bar hides and round badge returns.

	FIX: SetBannerOverrideHidden hides ALL top-center banners
	(intermission bar + round badge + timer) when a panel is open.

	FIX: Countdown uses server-authoritative PhaseEndTime
	(workspace:GetServerTimeNow). Even if UI loads late,
	the banner instantly shows the correct remaining time.

	Used by: UIController
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared", 10)
local UIConfig = require(Shared:WaitForChild("UIConfig", 10))

local Client = script.Parent
local AnimUtil   = require(Client:WaitForChild("AnimUtil"))
local SoundUtil  = require(Client:WaitForChild("SoundUtil"))
local Components = require(Client:WaitForChild("Components"))

local C = UIConfig.Colors
local S = UIConfig.Sizes
local LocalPlayer = Players.LocalPlayer

local coinLabel: TextLabel = nil
local coinScale: UIScale = nil
local roundFrame: Frame = nil
local roundLabel: TextLabel = nil
local stateLabel: TextLabel = nil
local forceNextModeBtn: TextButton? = nil
local matchStateValue: StringValue? = nil
local movementCountdownVisibleValue: BoolValue? = nil
local movementCountdownEndTimeValue: NumberValue? = nil
local stateLabelScale: UIScale? = nil
local movementWarningToken: number = 0
local movementWarningAnimating = false
local topRightButtons: {GuiObject} = {}
local rightSideSafeArea: Frame? = nil

local MOVEMENT_WARNING_THRESHOLD = 3.7
local MOVEMENT_WARNING_COLOR = Color3.fromRGB(255, 78, 78)
local RIGHT_SAFE_AREA_NAME = "HUDRightSafeArea"
local RIGHT_SAFE_AREA_GAP = 16

local function stopMovementWarningVisual()
	movementWarningToken += 1
	movementWarningAnimating = false
	if stateLabel then
		stateLabel.TextColor3 = C.TextLight
	end
	if stateLabelScale then
		stateLabelScale.Scale = 1
	end
end

local function startMovementWarningVisual()
	if movementWarningAnimating then
		return
	end
	movementWarningAnimating = true
	movementWarningToken += 1
	local token = movementWarningToken
	task.spawn(function()
		while movementWarningAnimating and token == movementWarningToken do
			if stateLabelScale then
				local tIn = TweenService:Create(
					stateLabelScale,
					TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
					{ Scale = 1.07 }
				)
				tIn:Play()
				tIn.Completed:Wait()
				if not movementWarningAnimating or token ~= movementWarningToken then break end
				local tOut = TweenService:Create(
					stateLabelScale,
					TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
					{ Scale = 1.0 }
				)
				tOut:Play()
				tOut.Completed:Wait()
			else
				task.wait(0.16)
			end
		end
	end)
end

-- Intermission bar elements
local intermissionBar: Frame = nil
local intermissionLabel: TextLabel = nil
local intermissionVisible = false
local bannerOverrideHidden = false

local HUDPanel = {}
local isMobileTouch = UserInputService.TouchEnabled
local coinRestScale = 1

local function formatCoins(n: number): string
	if n >= 1000000 then return string.format("%.1fM", n / 1000000) end
	if n >= 10000 then return string.format("%.1fK", n / 1000) end
	return tostring(n)
end

local function setPreferredVisible(guiObject: GuiObject?, visible: boolean)
	local rawValue = LocalPlayer:GetAttribute(attributeName)
	if type(rawValue) ~= "string" or rawValue == "" then
		return {}
	end
	local ok, decoded = pcall(HttpService.JSONDecode, HttpService, rawValue)
	if ok and type(decoded) == "table" then
		return decoded
	end
	return {}
end

local function updateNextGoal()
	if not nextGoalTitleLabel or not nextGoalDetailLabel then
		return
	end

	local goal = ProgressionGoalResolver.Resolve({
		coins = LocalPlayer:GetAttribute("Coins") or 0,
		ownedCrowns = decodeOwnedList("OwnedCrowns"),
		ownedPets = decodeOwnedList("OwnedPets"),
	})

	if goal then
		nextGoalTitleLabel.Text = "Next Goal: " .. goal.name
		nextGoalDetailLabel.Text = string.format(
			"%s F • You have %s",
			formatCoins(goal.price),
			formatCoins(goal.currentCoins)
		)
		nextGoalDetailLabel.TextColor3 = if goal.remainingCoins > 0 then NEXT_GOAL_ACCENT else NEXT_GOAL_UNLOCKED
	else
		nextGoalTitleLabel.Text = "All coin goals unlocked"
		nextGoalDetailLabel.Text = "Nothing left to buy with Fate Coins"
		nextGoalDetailLabel.TextColor3 = NEXT_GOAL_UNLOCKED
	end
end

local function setPreferredVisible(guiObject: GuiObject?, visible: boolean)
	if not guiObject then
		return
	end
	guiObject:SetAttribute("PreferredVisible", visible)
	guiObject.Visible = visible
end

-- Use local GUI coordinates so the safe area stays correct under ResponsiveScale.
local function updateRightSideSafeArea()
	if not rightSideSafeArea then
		return
	end

	local rightScale, rightOffset
	local minY, maxBottom, maxWidth
	for _, button in ipairs(topRightButtons) do
		if button.Visible then
			local top = button.Position.Y.Offset
			local bottom = top + button.Size.Y.Offset
			local width = button.Size.X.Offset

			rightScale = rightScale or button.Position.X.Scale
			if rightOffset == nil then
				rightOffset = button.Position.X.Offset
			else
				rightOffset = math.min(rightOffset, button.Position.X.Offset)
			end
			minY = minY and math.min(minY, top) or top
			maxBottom = maxBottom and math.max(maxBottom, bottom) or bottom
			maxWidth = maxWidth and math.max(maxWidth, width) or width
		end
	end

	if not minY or not maxBottom or not maxWidth then
		rightSideSafeArea.Position = UDim2.fromOffset(0, 0)
		rightSideSafeArea.Size = UDim2.fromOffset(0, 0)
		rightSideSafeArea:SetAttribute("BottomOffset", 0)
		return
	end

	rightSideSafeArea.AnchorPoint = Vector2.new(1, 0)
	rightSideSafeArea.Position = UDim2.new(rightScale or 1, rightOffset or -16, 0, math.floor(minY))
	rightSideSafeArea.Size = UDim2.fromOffset(math.ceil(maxWidth), math.ceil(maxBottom - minY))
	rightSideSafeArea:SetAttribute("BottomOffset", math.ceil(maxBottom))
end

local function trackTopRightButton(button: GuiObject)
	table.insert(topRightButtons, button)
	button:GetPropertyChangedSignal("Position"):Connect(updateRightSideSafeArea)
	button:GetPropertyChangedSignal("Size"):Connect(updateRightSideSafeArea)
	button:GetPropertyChangedSignal("Visible"):Connect(updateRightSideSafeArea)
	task.defer(updateRightSideSafeArea)
end

