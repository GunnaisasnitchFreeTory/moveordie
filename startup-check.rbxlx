	sbgStroke.Transparency = 0.65
	sbgStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	sbgStroke.Parent = sidebarBg

	Components.AddStudTexture(sidebarBg, 18)

	local sidebar = Instance.new("Frame")
	sidebar.Name = "Sidebar"
	sidebar.AnchorPoint = Vector2.new(0, 0)
	sidebar.Position = UDim2.fromOffset(18, 80)
	sidebar.Size = UDim2.fromOffset(
		S.SideBtnW * 2 + S.SideBtnGap,
		S.SideBtnH * SIDEBAR_ROWS + S.SideBtnGap * (SIDEBAR_ROWS - 1)
	)
	sidebar.BackgroundTransparency = 1
	sidebar.BorderSizePixel = 0
	sidebar.Parent = screenGui

	local sGrid = Instance.new("UIGridLayout")
	sGrid.CellSize = UDim2.fromOffset(S.SideBtnW, S.SideBtnH)
	sGrid.CellPadding = UDim2.fromOffset(S.SideBtnGap, S.SideBtnGap)
	sGrid.FillDirection = Enum.FillDirection.Horizontal
	sGrid.SortOrder = Enum.SortOrder.LayoutOrder
	sGrid.Parent = sidebar

	Components.CreateSideButton(sidebar, "Shop",     "", C.SideShop,     1, function() if callbacks.onShop then callbacks.onShop() end end, "rbxassetid://107098750187021")
	Components.CreateSideButton(sidebar, "Crowns",   "", C.SideCrowns,   2, function() if callbacks.onCrowns then callbacks.onCrowns() end end, "rbxassetid://89367687221894")
	Components.CreateSideButton(sidebar, "Pets",     "", C.SidePets,     3, function() if callbacks.onPets then callbacks.onPets() end end, "rbxassetid://73191619361965")
	Components.CreateSideButton(sidebar, "Index",    "", C.SideIndex,    4, function() if callbacks.onIndex then callbacks.onIndex() end end, "rbxassetid://116320041810735")
	Components.CreateSideButton(sidebar, "Spectate", "", C.SideSpectate, 5, function() if callbacks.onSpectate then callbacks.onSpectate() end end, "rbxassetid://79490615087008")
	Components.CreateSideButton(sidebar, "Settings", "",  C.SideSettings, 6, function() if callbacks.onSettings then callbacks.onSettings() end end, "rbxassetid://98012855587350")

	local afkBtn = Components.CreateSideButton(
		sidebar,
		"Go AFK",
		"",
		C.SideAFK,
		7,
		function()
			if callbacks.onAFK then callbacks.onAFK() end
		end,
		"rbxassetid://93630249524250"
	)

	local afkLabel = afkBtn:FindFirstChild("Label")
	local afkIcon = afkBtn:FindFirstChild("Icon")
	local isAFK = false

	local function setSideButtonColor(btn: GuiObject, baseColor: Color3)
		btn.BackgroundColor3 = baseColor
		local grad = btn:FindFirstChildOfClass("UIGradient")
		if grad then
			local r, g, b = baseColor.R, baseColor.G, baseColor.B
			local lighterColor = Color3.new(
				math.min(r + 0.22, 1),
				math.min(g + 0.22, 1),
				math.min(b + 0.22, 1)
			)
			local darkerColor = Color3.new(
				math.max(r - 0.10, 0),
				math.max(g - 0.10, 0),
				math.max(b - 0.10, 0)
			)
			grad.Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, lighterColor),
				ColorSequenceKeypoint.new(0.5, baseColor),
				ColorSequenceKeypoint.new(1, darkerColor),
			})
		end
	end

	local function updateAFKVisual()
		local state = LocalPlayer:GetAttribute("PlayerState")
		isAFK = (state == "AFK")
		if afkLabel then
			afkLabel.Text = isAFK and "Return" or "Go AFK"
		end
		if afkIcon then
			if afkIcon:IsA("ImageLabel") then
				afkIcon.Image = isAFK and "rbxassetid://92632399407544" or "rbxassetid://93630249524250"
				afkIcon.BackgroundTransparency = 1
				afkIcon.ScaleType = Enum.ScaleType.Fit
				afkIcon.AnchorPoint = Vector2.new(0.5, 0.5)
				afkIcon.Position = UDim2.fromScale(0.5, 0.45)
				afkIcon.Size = UDim2.fromScale(0.55, 0.55)
				if not afkIcon:FindFirstChildOfClass("UIAspectRatioConstraint") then
					local ar = Instance.new("UIAspectRatioConstraint")
					ar.AspectRatio = 1
					ar.Parent = afkIcon
				end
			elseif afkIcon:IsA("TextLabel") then
				afkIcon.Text = ""
				afkIcon.Visible = false
			end
		end
		setSideButtonColor(afkBtn, isAFK and C.Green or C.SideAFK)
	end
	updateAFKVisual()
	LocalPlayer:GetAttributeChangedSignal("PlayerState"):Connect(updateAFKVisual)

	Components.CreateSideButton(sidebar, "Icons", "", C.SideIcons, 8, function() if callbacks.onIcons then callbacks.onIcons() end end, "rbxassetid://112403972973605")

	rightSideSafeArea = Instance.new("Frame")
	rightSideSafeArea.Name = RIGHT_SAFE_AREA_NAME
	rightSideSafeArea.Position = UDim2.fromOffset(0, 0)
	rightSideSafeArea.Size = UDim2.fromOffset(0, 0)
	rightSideSafeArea.BackgroundTransparency = 1
	rightSideSafeArea.BorderSizePixel = 0
	rightSideSafeArea.Active = false
	rightSideSafeArea.ZIndex = 0
	rightSideSafeArea.Parent = screenGui
	rightSideSafeArea:SetAttribute("RecommendedGap", RIGHT_SAFE_AREA_GAP)
	rightSideSafeArea:SetAttribute("BottomOffset", 0)

	-- TOP-RIGHT BUTTON HELPER
	local function createTopRightPill(name, yOffset, text, bgColor, gradTop, gradBot, onClick, width, textSize)
		local btn = Instance.new("TextButton")
		btn.Name = name
		btn.AnchorPoint = Vector2.new(1, 0)
		btn.Position = UDim2.new(1, -16, 0, yOffset)
		btn.Size = UDim2.fromOffset(width or 100, 38)
		btn.BackgroundColor3 = bgColor
		btn.BorderSizePixel = 0
		btn.Font = Enum.Font.GothamBold
		btn.TextColor3 = Color3.fromRGB(255, 255, 255)
		btn.TextSize = textSize or 14
		btn.Text = text
		btn.AutoButtonColor = true
		btn.ZIndex = 5
		btn.Parent = screenGui
		btn:SetAttribute("PreferredVisible", true)
		Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 19)

		local stroke = Instance.new("UIStroke")
		stroke.Color = Color3.fromRGB(255, 255, 255)
		stroke.Thickness = 1.8
		stroke.Transparency = 0.55
		stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		stroke.Parent = btn

		local shadow = Instance.new("Frame")
		shadow.Name = "Shadow"
		shadow.AnchorPoint = Vector2.new(0.5, 0.5)
		shadow.Position = UDim2.new(0.5, 2, 0.5, 3)
		shadow.Size = UDim2.new(1, 10, 1, 10)
		shadow.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
		shadow.BackgroundTransparency = 0.55
		shadow.BorderSizePixel = 0
		shadow.ZIndex = 4
		shadow.Parent = btn
		Instance.new("UICorner", shadow).CornerRadius = UDim.new(0, 24)

		local grad = Instance.new("UIGradient")
		grad.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, gradTop),
			ColorSequenceKeypoint.new(0.5, bgColor),
			ColorSequenceKeypoint.new(1, gradBot),
		})
		grad.Rotation = 90
		grad.Parent = btn

		local textStroke = Instance.new("UIStroke")
		textStroke.Color = Color3.fromRGB(0, 0, 0)
		textStroke.Thickness = 1.5
		textStroke.Transparency = 0.2
		textStroke.Parent = btn

		AnimUtil.WireButton(btn, onClick)
		trackTopRightButton(btn)
		return btn
	end

	forceNextModeBtn = createTopRightPill(
		"ForceNextModeBtn", 44,
		"FORCE NEXT MODE!",
		Color3.fromRGB(225, 120, 26),
		Color3.fromRGB(255, 182, 78),
		Color3.fromRGB(156, 72, 8),
		function() if callbacks.onForceNextMode then callbacks.onForceNextMode() end end,
		176,
		13
	)
	setPreferredVisible(forceNextModeBtn, false)

	-- TOP-RIGHT: Stats button
	createTopRightPill(
		"StatsBtn", 96,
		"Stats",
		C.SideStats,
		Color3.fromRGB(80, 240, 220),
		Color3.fromRGB(20, 140, 130),
		function() if callbacks.onStats then callbacks.onStats() end end
	)

	-- TOP-RIGHT: Daily Rewards button
	createTopRightPill(
		"DailyBtn", 140,
		"Daily",
		C.SideDaily,
		Color3.fromRGB(100, 210, 255),
		Color3.fromRGB(30, 120, 200),
		function() if callbacks.onDaily then callbacks.onDaily() end end
	)

	-- TOP-RIGHT: Daily Quests button
	local questsBtn = createTopRightPill(
		"QuestsBtn", 184,
		"Quests",
		Color3.fromRGB(180, 30, 30),
		Color3.fromRGB(255, 70, 70),
		Color3.fromRGB(120, 12, 12),
		function() if callbacks.onQuests then callbacks.onQuests() end end
	)

	local function updateForceNextModeButtonVisibility()
		local state = matchStateValue and matchStateValue.Value or ""
		local shouldShow = state == "Intermission" or state == "Ending"
		setPreferredVisible(forceNextModeBtn, shouldShow)
		task.defer(updateRightSideSafeArea)
	end

	task.defer(updateRightSideSafeArea)

	-- INTERMISSION SHOW/HIDE HELPERS
	local function showIntermission()
		if intermissionVisible then return end
		intermissionVisible = true

		roundFrame.Visible = false
		stateLabel.Visible = false

		if not bannerOverrideHidden then
			intermissionBar.Visible = true
			ibScale.Scale = 0.88
			local t = TweenService:Create(ibScale, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 })
			t:Play()
		end
	end

	local function hideIntermission()
		if not intermissionVisible then return end
		intermissionVisible = false

		local t = TweenService:Create(ibScale, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Scale = 0.88 })
		t:Play()
		task.spawn(function()
			t.Completed:Wait()
			if not intermissionVisible then
				intermissionBar.Visible = false
			end
		end)

		if not bannerOverrideHidden then
			roundFrame.Visible = true
			stateLabel.Visible = true
		end
	end

	-- REACTIVITY
	local function updateCoins()
		local coins = LocalPlayer:GetAttribute("Coins") or 0
		local newText = formatCoins(coins)
		if coinLabel.Text ~= newText then
			coinLabel.Text = newText
			-- Always return to the platform's resting scale after each pulse.
			coinScale.Scale = coinRestScale
			local bumpPeak = coinRestScale * (UIConfig.Anim.CoinBumpScale or 1.15)
			AnimUtil.Bump(coinScale, bumpPeak, UIConfig.Anim.CoinBumpDuration, coinRestScale)
			if isMobileTouch then
				print(string.format(
					"[CoinFrameAnim] platform=Mobile start=%.3f animated=%.3f final=%.3f",
					coinRestScale,
					bumpPeak,
					coinRestScale
				))
				print("[CoinFrameAnim] resetToMobileRestingState=true")
			end
			SoundUtil.CoinCollect()
		end
	end

	coinLabel.Text = formatCoins(LocalPlayer:GetAttribute("Coins") or 0)
	LocalPlayer:GetAttributeChangedSignal("Coins"):Connect(updateCoins)

	-- MatchStatus: wait for folder + children (atomic: server parents children before folder)
	local matchStatus = ReplicatedStorage:FindFirstChild("MatchStatus") or ReplicatedStorage:WaitForChild("MatchStatus", 10)
	if matchStatus then
		local stateVal = matchStatus:WaitForChild("State", 10)
		local roundVal = matchStatus:WaitForChild("Round", 10)
		local phaseEndVal = matchStatus:WaitForChild("PhaseEndTime", 10)
		local moveCountdownVisibleVal = matchStatus:WaitForChild("MovementCountdownVisible", 10)
		local moveCountdownEndTimeVal = matchStatus:WaitForChild("MovementCountdownEndTime", 10)
		matchStateValue = stateVal
		movementCountdownVisibleValue = moveCountdownVisibleVal
		movementCountdownEndTimeValue = moveCountdownEndTimeVal

		-- Helper: compute and display remaining time immediately (no waiting for Heartbeat)
		local function updateCountdownNow()
			if not phaseEndVal then return end
			local endTime = phaseEndVal.Value
			if endTime > 0 then
				local remaining = math.max(0, endTime - workspace:GetServerTimeNow())
				if remaining > 0.5 then
					local secs = math.ceil(remaining)
					if intermissionVisible and intermissionLabel then
						intermissionLabel.Text = "Game starting in " .. tostring(secs)
					end
				end
			end
		end

		local function updateMovementCountdownLabel()
			if not stateLabel then return end
			local isPlaying = stateVal and stateVal.Value == "Playing"
			if not isPlaying then
				stopMovementWarningVisual()
				return
			end
			local canShow = isPlaying
				and not intermissionVisible
				and moveCountdownVisibleVal
				and moveCountdownVisibleVal.Value == true
				and moveCountdownEndTimeVal
				and moveCountdownEndTimeVal.Value > 0
			if not canShow then
				stateLabel.Text = ""
				stateLabel.Visible = false
				stopMovementWarningVisual()
				return
			end
			local remaining = math.max(0, moveCountdownEndTimeVal.Value - workspace:GetServerTimeNow())
			if remaining <= 0 then
				stateLabel.Text = ""
				stateLabel.Visible = false
				stopMovementWarningVisual()
				return
			end
			stateLabel.Text = string.format("Players will be frozen in: %.1f", remaining)
			stateLabel.Visible = not bannerOverrideHidden
			local warningNow = remaining <= MOVEMENT_WARNING_THRESHOLD
			if warningNow then
				stateLabel.TextColor3 = MOVEMENT_WARNING_COLOR
				startMovementWarningVisual()
			else
				stopMovementWarningVisual()
			end
		end

		if stateVal then
			local function onStateChange()
				local st = stateVal.Value
				if st == "Playing" then
					local r = roundVal and roundVal.Value or 0
					roundLabel.Text = "Round " .. tostring(math.max(r, 1))
					hideIntermission()
					updateMovementCountdownLabel()
					if not bannerOverrideHidden then
						roundFrame.Visible = true
						stateLabel.Visible = stateLabel.Text ~= ""
					end
				elseif st == "Intermission" then
					stopMovementWarningVisual()
					stateLabel.Text = ""
					stateLabel.Visible = false
					showIntermission()
					-- Immediately show correct remaining time (don't wait for Heartbeat)
					updateCountdownNow()
				elseif st == "Ending" then
					stopMovementWarningVisual()
					roundLabel.Text = "Results"
					stateLabel.Text = "Match ended!"
					if not bannerOverrideHidden then
						roundFrame.Visible = true
						stateLabel.Visible = true
					end
					hideIntermission()
				else
					stopMovementWarningVisual()
					roundLabel.Text = "Lobby"
					stateLabel.Text = ""
					if not bannerOverrideHidden then
						roundFrame.Visible = true
						stateLabel.Visible = false
					end
					hideIntermission()
				end
				updateForceNextModeButtonVisibility()
			end
			stateVal.Changed:Connect(onStateChange)
			onStateChange()
		end

		if roundVal then
			roundVal.Changed:Connect(function()
				local r = roundVal.Value
				if r > 0 then
					roundLabel.Text = "Round " .. tostring(r)
					AnimUtil.SlideIn(roundFrame, roundFrame.Position, -20)
				end
			end)
		end

		if phaseEndVal then
			RunService.Heartbeat:Connect(function()
				local endTime = phaseEndVal.Value
				if endTime > 0 then
					local remaining = math.max(0, endTime - workspace:GetServerTimeNow())
					if remaining > 0.5 then
						local secs = math.ceil(remaining)
						if intermissionVisible and intermissionLabel then
							intermissionLabel.Text = "Game starting in " .. tostring(secs)
						end
					end
				end
				updateMovementCountdownLabel()
			end)
		end

		if moveCountdownVisibleVal then
			moveCountdownVisibleVal.Changed:Connect(updateMovementCountdownLabel)
		end
		if moveCountdownEndTimeVal then
			moveCountdownEndTimeVal.Changed:Connect(updateMovementCountdownLabel)
		end
	end
end

-- BANNER OVERRIDE (for panels -- SpinWheel, Shop, etc.)
-- Hides ALL top-center banners when a panel is open.
-- Countdown text keeps updating in the background so when
-- the banner becomes visible again, it shows the correct time.

function HUDPanel.SetBannerOverrideHidden(hidden: boolean)
	bannerOverrideHidden = hidden
	if hidden then
		-- Hide ALL top-center banners
		if intermissionBar then intermissionBar.Visible = false end
		if roundFrame then roundFrame.Visible = false end
		if stateLabel then stateLabel.Visible = false end
	else
		-- Restore based on current match state
		if intermissionVisible then
			if intermissionBar then intermissionBar.Visible = true end
			if roundFrame then roundFrame.Visible = false end
			if stateLabel then stateLabel.Visible = false end
		else
			if intermissionBar then intermissionBar.Visible = false end
			if roundFrame then roundFrame.Visible = true end
			if stateLabel then
				local isPlaying = matchStateValue and matchStateValue.Value == "Playing"
				if isPlaying then
					local canShow = movementCountdownVisibleValue
						and movementCountdownVisibleValue.Value == true
						and movementCountdownEndTimeValue
						and movementCountdownEndTimeValue.Value > workspace:GetServerTimeNow()
					stateLabel.Visible = canShow == true
				else
					stateLabel.Visible = stateLabel.Text ~= ""
				end
			end
		end
	end
end

function HUDPanel.SetVisible(vis: boolean)
	-- HUD is always visible; no-op
end

return HUDPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="154">
            <Properties>
              <string name="Name">IconImagesPanel</string>
              <string name="Source">--[[
	IconImagesPanel
	Icon Image collection / equip grid — shows all icon images (owned + locked).

	Icon Images are 3D follower companions (like pets) that follow the player
	and can be equipped simultaneously with a pet (on the opposite side).

	Equip category: "IconImages"
	Attribute: "EquippedIconImage"
	Catalog: ItemCatalog.IconImages

	Used by: UIController (sidebar "Icons" button)
]]

local Players           = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService       = game:GetService("HttpService")

local Shared = ReplicatedStorage:WaitForChild("Shared", 60)
if not Shared then
	warn("[IconImagesPanel] Shared not found after 60s -- disabled")
	return { Init = function() end, Show = function() end, Hide = function() end,
		IsVisible = function() return false end, Toggle = function() end }
end

local CDPModule = Shared:WaitForChild("ClientDepsProvider", 60)
if not CDPModule then
	local _children = {}
	for _, c in ipairs(Shared:GetChildren()) do table.insert(_children, c.Name.."("..c.ClassName..")") end
	warn("[IconImagesPanel] ClientDepsProvider MISSING. Shared path:", Shared:GetFullName(), "| Shared children:", table.concat(_children, ", "))
	return { Init = function() end, Show = function() end, Hide = function() end,
		IsVisible = function() return false end, Toggle = function() end }
end

local ok, Deps = pcall(require, CDPModule)
if not ok or not Deps then
	warn("[IconImagesPanel] require(ClientDepsProvider) FAILED:", Deps)
	return { Init = function() end, Show = function() end, Hide = function() end,
		IsVisible = function() return false end, Toggle = function() end }
end
local UIConfig = Deps.UIConfig
local ItemCatalog = Deps.ItemCatalog

local Client = script.Parent
local AnimUtil   = require(Client:WaitForChild("AnimUtil"))
local SoundUtil  = require(Client:WaitForChild("SoundUtil"))
local Components = require(Client:WaitForChild("Components"))

local C = UIConfig.Colors
local S = UIConfig.Sizes

local player = Players.LocalPlayer

local canvas: CanvasGroup = nil
local uiScale: UIScale = nil
local overlay: Frame = nil
local contentFrame: ScrollingFrame = nil
local visible = false
local closeCallback: (() -&gt; ())? = nil

local equippedId: string? = nil
local _equipDebounce = false
local _equipIconRequestRemote: RemoteEvent? = nil

local IconImagesPanel = {}

local RARITY_COLORS = {
	Common    = C.Common,
	Uncommon  = C.Uncommon,
	Rare      = C.Rare,
	Epic      = C.Epic,
	Legendary = C.Legendary,
	Impossible = C.Impossible,
}

local function getOwnedIconImageSet(): { [string]: boolean }
	local json = player:GetAttribute("OwnedIconImages") or "[]"
	local success, list = pcall(HttpService.JSONDecode, HttpService, json)
	if not success or type(list) ~= "table" then return {} end
	local set = {}
	for _, id in ipairs(list) do
		set[id] = true
	end
	return set
end

local function getEquipIconRequestRemote(): RemoteEvent?
	local remotes = ReplicatedStorage:FindFirstChild("Remotes")
	if not remotes then return nil end
	local remote = remotes:FindFirstChild("EquipIconEvent")
	if remote and remote:IsA("RemoteEvent") then
		return remote
	end
	return nil
end

local function clearContent()
	for _, child in ipairs(contentFrame:GetChildren()) do
		if child:IsA("Frame") then child:Destroy() end
	end
end

local function refresh()
	clearContent()

	local ownedSet = getOwnedIconImageSet()
	if not _equipDebounce then
		equippedId = player:GetAttribute("EquippedIconImage") or nil
		if equippedId == "" then equippedId = nil end
	end

	local allIcons = {}
	if ItemCatalog.GetAllIconImagesSorted then
		allIcons = ItemCatalog.GetAllIconImagesSorted()
	end

	for i, item in ipairs(allIcons) do
		local isOwned = ownedSet[item.id] == true
		local isEquipped = isOwned and (item.id == equippedId)
		local actionText = nil
		local actionColor = nil
		local subLabel = nil

		if isOwned then
			if isEquipped then
				actionText = "EQUIPPED"
				actionColor = C.Equipped or Color3.fromRGB(80, 200, 80)
				subLabel = "Tap to unequip"
			else
				actionText = "EQUIP"
				actionColor = C.Equip or Color3.fromRGB(80, 160, 255)
			end
		else
			local acqLabel = ItemCatalog.GetIconImageAcquisitionLabel and ItemCatalog.GetIconImageAcquisitionLabel(item.id)
			subLabel = acqLabel or "Locked"
		end

		local rarityStr = item.rarity or "Legendary"
		local iconColor = RARITY_COLORS[rarityStr] or C.Legendary
		local catalogImage = ItemCatalog.GetImage(item)

		Components.CreateViewportItemCard(contentFrame, {
			name = item.name or "MISSING ITEM",
			rarity = rarityStr,
			iconColor = iconColor,
			iconText = item.iconText or "",
			image = catalogImage,
			modelPath = item.modelPath,
			locked = not isOwned,
			equipped = isEquipped,
			owned = isOwned,
			subLabel = subLabel,
			actionText = actionText,
			actionColor = actionColor,
			onAction = function()
				if not isOwned then return end
				if _equipDebounce then return end
				local equipIconRemote = _equipIconRequestRemote or getEquipIconRequestRemote()
				if not equipIconRemote then
					warn("[IconImagesPanel] EquipIconEvent missing")
					return
				end
				_equipDebounce = true
				equipIconRemote:FireServer(item.id)

				task.delay(4, function()
					_equipDebounce = false
				end)
			end,
		}).LayoutOrder = i
	end
end

function IconImagesPanel.Init(screenGui: ScreenGui, onClose: () -&gt; ())
	closeCallback = onClose

	overlay = Components.CreateDimOverlay(screenGui, function()
		IconImagesPanel.Hide()
	end)

	local content, closeBtn
	canvas, uiScale, content, closeBtn = Components.CreatePanel(screenGui, "ICON IMAGES", C.HeaderIcons, "Icons")
	contentFrame = content

	Components.AddGridLayout(content)

	closeBtn.MouseButton1Click:Connect(function()
		SoundUtil.Close()
		IconImagesPanel.Hide()
	end)

	refresh()

	_equipIconRequestRemote = getEquipIconRequestRemote()
	if _equipIconRequestRemote then
		_equipIconRequestRemote.OnClientEvent:Connect(function(payload)
			local success = type(payload) == "table" and payload.success == true
			if success then
				local newEquipped = type(payload.equippedIconId) == "string" and payload.equippedIconId or ""
				equippedId = (newEquipped ~= "") and newEquipped or nil
				SoundUtil.Equip()
			else
				if type(payload) == "table" and payload.reason and payload.reason ~= "" then
					warn(string.format("[IconImagesPanel] Equip rejected: %s", tostring(payload.reason)))
				end
			end
			_equipDebounce = false
			if visible then
				refresh()
			end
		end)
	end

	player:GetAttributeChangedSignal("EquippedIconImage"):Connect(function()
		if visible then refresh() end
	end)
	player:GetAttributeChangedSignal("OwnedIconImages"):Connect(function()
		if visible then refresh() end
	end)
	player:GetAttributeChangedSignal("PlayerState"):Connect(function()
		if player:GetAttribute("PlayerState") == "InMatch" and visible then
			IconImagesPanel.Hide()
		end
	end)
end

function IconImagesPanel.Show()
	if visible then return end
	if player:GetAttribute("PlayerState") == "InMatch" then
		print("[IconImagesPanel] Blocked Show while InMatch")
		return
	end
	visible = true
	overlay.Visible = true
	refresh()
	SoundUtil.Open()
	AnimUtil.OpenPanel(canvas, uiScale)
end

function IconImagesPanel.Hide()
	if not visible then return end
	visible = false
	overlay.Visible = false
	local t = AnimUtil.ClosePanel(canvas, uiScale)
	task.spawn(function()
		t.Completed:Wait()
		canvas.Visible = false
	end)
	if closeCallback then closeCallback() end
end

function IconImagesPanel.IsVisible(): boolean
	return visible
end

function IconImagesPanel.Toggle()
	if visible then IconImagesPanel.Hide() else IconImagesPanel.Show() end
end

return IconImagesPanel</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="155">
            <Properties>
              <string name="Name">IndexPanel</string>
              <string name="Source"><![CDATA[--[[
	IndexPanel
	Discovery/collection grid -- ALL crowns AND pets in the game.
	  * Owned  -> full-color ViewportFrame + name + rarity
	  * Locked -> greyed-out ViewportFrame + lock overlay + source label

	Features:
	  * Tab bar: Crowns / Pets / Icon Images
	  * All tabs sourced from ItemCatalog (single source of truth)
	  * Ownership from player attributes (OwnedCrowns / OwnedPets / OwnedIconImages)
	  * ViewportFrame 3D model previews for all items
	  * Live refresh on ownership changes + InventoryUpdated event

	Used by: UIController (sidebar "Index" button)
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")

local Shared = ReplicatedStorage:WaitForChild("Shared", 60)
if not Shared then
	warn("[IndexPanel] Shared not found after 60s -- disabled")
	return { Init = function() end, Show = function() end, Hide = function() end,
		IsVisible = function() return false end, Toggle = function() end }
end

local CDPModule = Shared:WaitForChild("ClientDepsProvider", 60)
if not CDPModule then
	warn("[IndexPanel] ClientDepsProvider MISSING")
	return { Init = function() end, Show = function() end, Hide = function() end,
		IsVisible = function() return false end, Toggle = function() end }
end

local ok, Deps = pcall(require, CDPModule)
if not ok or not Deps then
	warn("[IndexPanel] require(ClientDepsProvider) FAILED:", Deps)
	return { Init = function() end, Show = function() end, Hide = function() end,
		IsVisible = function() return false end, Toggle = function() end }
end
local UIConfig = Deps.UIConfig
local ItemCatalog = Deps.ItemCatalog

if not UIConfig then
	warn("[IndexPanel] UIConfig not available -- disabled")
	return { Init = function() end, Show = function() end, Hide = function() end,
		IsVisible = function() return false end, Toggle = function() end }
end

local Client = script.Parent
local AnimUtil          = require(Client:WaitForChild("AnimUtil"))
local SoundUtil         = require(Client:WaitForChild("SoundUtil"))
local Components        = require(Client:WaitForChild("Components"))
local ThumbnailRenderer = require(Client:WaitForChild("ThumbnailRenderer"))

local C = UIConfig.Colors
local S = UIConfig.Sizes

local player = Players.LocalPlayer

local canvas: CanvasGroup = nil
local uiScale: UIScale = nil
local overlay: Frame = nil
local contentFrame: ScrollingFrame = nil
local visible = false
local closeCallback: (() -> ())? = nil
local activeTab = 1

local TABS = {
	{ label = "Crowns" },
	{ label = "Pets" },
	{ label = "Icon Images" },
}

local IndexPanel = {}

local function clearCards()
	if not contentFrame then return end
	for _, child in ipairs(contentFrame:GetChildren()) do
		if child:IsA("Frame") then child:Destroy() end
	end
end

local function ensureGrid()
	if not contentFrame then return end
	if not contentFrame:FindFirstChildOfClass("UIGridLayout") then
		Components.AddGridLayout(contentFrame)
	end
end

local function getOwnedSet(attrName: string): { [string]: boolean }
	local json = player:GetAttribute(attrName) or "[]"
	local decOk, list = pcall(HttpService.JSONDecode, HttpService, json)
	if not decOk or type(list) ~= "table" then return {} end
	local set = {}
	for _, id in ipairs(list) do
		set[id] = true
	end
	return set
end

--- Apply desaturation + grey overlay + lock icon on a ViewportFrame for locked items
local function applyLockOverlay(vpFrame: ViewportFrame)
	-- Desaturate the viewport rendering
	vpFrame.ImageColor3 = Color3.fromRGB(90, 90, 90)
	vpFrame.ImageTransparency = 0.15

	-- Semi-transparent dark overlay
	local greyOverlay = Instance.new("Frame")
	greyOverlay.Name = "LockOverlay"
	greyOverlay.Size = UDim2.fromScale(1, 1)
	greyOverlay.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
	greyOverlay.BackgroundTransparency = 0.55
	greyOverlay.BorderSizePixel = 0
	greyOverlay.ZIndex = 2
	greyOverlay.Parent = vpFrame
	local oc = Instance.new("UICorner")
	oc.CornerRadius = UDim.new(0, 10)
	oc.Parent = greyOverlay

	-- Lock icon on top
	local lockIcon = Instance.new("TextLabel")
	lockIcon.Name = "LockIcon"
	lockIcon.Size = UDim2.fromOffset(32, 32)
	lockIcon.AnchorPoint = Vector2.new(0.5, 0.5)
	lockIcon.Position = UDim2.fromScale(0.5, 0.5)
	lockIcon.BackgroundTransparency = 1
	lockIcon.Font = Enum.Font.GothamBold
	lockIcon.Text = ""
	lockIcon.TextColor3 = Color3.fromRGB(160, 165, 190)
	lockIcon.TextSize = 28
	lockIcon.ZIndex = 3
	lockIcon.Parent = vpFrame
end

--- Build sub-label for unowned crowns (delegates to ItemCatalog)
local function getCrownSubLabel(crown): string?
	return ItemCatalog.GetCrownAcquisitionLabel(crown.id)
end

local function populateCrowns()
	clearCards()
	ensureGrid()

	local allCrowns = ItemCatalog.GetAllCrownsSorted()
	local ownedSet = getOwnedSet("OwnedCrowns")

	for i, crown in ipairs(allCrowns) do
		local isOwned = ownedSet[crown.id] == true
		local resolved = ItemCatalog.ResolveCrownOrPetImage and ItemCatalog.ResolveCrownOrPetImage(crown.id, "CROWN") or nil
		local resolvedImage = (resolved and resolved.mode == "STATIC" and resolved.image) or ItemCatalog.GetImage(crown)
		local resolvedModelPath = (resolved and resolved.mode == "RENDERER" and resolved.rendererKey) or nil
		local subLabel = nil
		if not isOwned then
			subLabel = getCrownSubLabel(crown)
		end

		local card = Components.CreateViewportItemCard(contentFrame, {
			name = crown.name,
			rarity = crown.rarity,
			iconColor = crown.iconColor,
			thumbnailBgColor = crown.thumbnailBgColor,
			iconText = crown.iconText or "",
			image = resolvedImage,
			modelPath = resolvedModelPath,
			locked = not isOwned,
			owned = isOwned,
			subLabel = subLabel,
		})
		card.LayoutOrder = i

		-- Only use ThumbnailRenderer if the item has NO static image asset
		local hasStaticImage = (type(resolvedImage) == "string" and resolvedImage ~= "")
		if not hasStaticImage then
			local vpFrame = card:FindFirstChild("ModelPreview", true)
			if vpFrame and vpFrame:IsA("ViewportFrame") then
				ThumbnailRenderer.RenderItemToViewport(vpFrame, crown)
			end
		end
		if not isOwned then
			local vpFrame = card:FindFirstChild("ModelPreview", true)
			if vpFrame then applyLockOverlay(vpFrame) end
		end
	end
end

local function populatePets()
	clearCards()
	ensureGrid()

	local allPets = ItemCatalog.GetAllPetsSorted()
	local ownedSet = getOwnedSet("OwnedPets")

	for i, pet in ipairs(allPets) do
		local isOwned = ownedSet[pet.id] == true
		local resolved = ItemCatalog.ResolveCrownOrPetImage and ItemCatalog.ResolveCrownOrPetImage(pet.id, "PET") or nil
		local resolvedImage = (resolved and resolved.mode == "STATIC" and resolved.image) or ItemCatalog.GetImage(pet)
		local resolvedModelPath = (resolved and resolved.mode == "RENDERER" and resolved.rendererKey) or nil
		local isFNAFPet = pet.collection == "FNAF"
		local subLabel = nil
		if not isOwned then
			subLabel = ItemCatalog.GetPetAcquisitionLabel(pet.id)
		end

		local card = Components.CreateViewportItemCard(contentFrame, {
			name = pet.name,
			rarity = pet.rarity,
			iconColor = pet.iconColor,
			thumbnailBgColor = pet.thumbnailBgColor,
			iconText = pet.iconText or "",
			image = resolvedImage,
			modelPath = resolvedModelPath,
			locked = not isOwned,
			owned = isOwned,
			subLabel = subLabel,
		})
		card.LayoutOrder = i

		-- Only use ThumbnailRenderer if the item has NO static image asset
		local hasStaticImage = (type(resolvedImage) == "string" and resolvedImage ~= "")
		if not hasStaticImage then
			local vpFrame = card:FindFirstChild("ModelPreview", true)
			if vpFrame and vpFrame:IsA("ViewportFrame") and not isFNAFPet then
				ThumbnailRenderer.RenderItemToViewport(vpFrame, pet)
			end
		end
		if not isOwned then
			local vpFrame = card:FindFirstChild("ModelPreview", true)
			if vpFrame then applyLockOverlay(vpFrame) end
		end
	end
end

local function populateIconImages()
	clearCards()
	ensureGrid()

	local allIconImages = {}
	if ItemCatalog.GetAllIconImagesSorted then
		allIconImages = ItemCatalog.GetAllIconImagesSorted()
	end
	local ownedSet = getOwnedSet("OwnedIconImages")

	for i, iconImg in ipairs(allIconImages) do
		local isOwned = ownedSet[iconImg.id] == true
		local subLabel = nil
		if not isOwned then
			subLabel = ItemCatalog.GetIconImageAcquisitionLabel(iconImg.id)
		end

		local card = Components.CreateViewportItemCard(contentFrame, {
			name = iconImg.name,
			rarity = iconImg.rarity,
			iconColor = iconImg.iconColor,
			iconText = iconImg.iconText or "",
			image = ItemCatalog.GetImage(iconImg),
			modelPath = iconImg.modelPath,
			locked = not isOwned,
			owned = isOwned,
			subLabel = subLabel,
		})
		card.LayoutOrder = i

		if not isOwned then
			local vpFrame = card:FindFirstChild("ModelPreview", true)
			if vpFrame then applyLockOverlay(vpFrame) end
		end
	end
end

local function showTab(idx: number)
	if idx == 1 then
		populateCrowns()
	elseif idx == 2 then
		populatePets()
	elseif idx == 3 then
		populateIconImages()
	end
end

function IndexPanel.Init(screenGui: ScreenGui, onClose: () -> ())
	closeCallback = onClose

	overlay = Components.CreateDimOverlay(screenGui, function()
		IndexPanel.Hide()
	end)

	local content, closeBtn
	canvas, uiScale, content, closeBtn = Components.CreatePanel(screenGui, "INDEX", C.HeaderIndex, "Index")
	contentFrame = content

	if closeBtn then
		AnimUtil.WireButton(closeBtn, function()
			SoundUtil.Close()
			IndexPanel.Hide()
		end)
	end

	-- Override stud texture to Fate Beams asset (only this panel)
	do
		local stud = canvas:FindFirstChild("StudTexture")
		if stud then
			stud.Image = "rbxassetid://84772207963553"
			stud.TileSize = UDim2.fromOffset(96, 96)
			stud.ImageTransparency = 0.88
			stud.ImageColor3 = Color3.fromRGB(255, 255, 255)
		end
	end

	local setActiveTab: ((number) -> ())? = nil
	local tabBar
	tabBar, setActiveTab = Components.CreateTabBar(canvas, TABS, function(idx)
		activeTab = idx
		if type(setActiveTab) == "function" then
			setActiveTab(idx)
		end
		showTab(idx)
	end)

	if tabBar then
		tabBar.AnchorPoint = Vector2.new(0.5, 0)
		tabBar.Position = UDim2.new(0.5, 0, 0, S.PanelHeaderHeight + 4)
		tabBar.Size = UDim2.new(1, -20, 0, S.TabHeight + 8)
	end

	if content then
		content.Position = UDim2.new(0, 12, 0, S.PanelHeaderHeight + S.TabHeight + 18)
		content.Size = UDim2.new(1, -24, 1, -(S.PanelHeaderHeight + S.TabHeight + 28))
	end

	Components.AddGridLayout(contentFrame)
	if type(setActiveTab) == "function" then
		setActiveTab(1)
	end
	showTab(1)

	-- Live refresh on ownership changes
	player:GetAttributeChangedSignal("OwnedPets"):Connect(function()
		if visible and activeTab == 2 then showTab(2) end
	end)
	player:GetAttributeChangedSignal("OwnedCrowns"):Connect(function()
		if visible and activeTab == 1 then showTab(1) end
	end)
	player:GetAttributeChangedSignal("OwnedIconImages"):Connect(function()
		if visible and activeTab == 3 then showTab(3) end
	end)

	-- Listen for InventoryUpdated remote
	task.spawn(function()
		local remotes = ReplicatedStorage:WaitForChild("Remotes", 10)
		if remotes then
			local invUpdate = remotes:FindFirstChild("InventoryUpdated")
			if invUpdate and invUpdate:IsA("RemoteEvent") then
				invUpdate.OnClientEvent:Connect(function()
					if visible then showTab(activeTab) end
				end)
			end
		end
	end)
end

function IndexPanel.Show()
	if visible then return end
	visible = true
	if overlay then overlay.Visible = true end
	showTab(activeTab)
	SoundUtil.Open()
	if canvas and uiScale then
		AnimUtil.OpenPanel(canvas, uiScale)
	end
end

function IndexPanel.Hide()
	if not visible then return end
	visible = false
	if overlay then overlay.Visible = false end
	if canvas and uiScale then
		local t = AnimUtil.ClosePanel(canvas, uiScale)
		task.spawn(function()
			t.Completed:Wait()
			canvas.Visible = false
		end)
	end
	if closeCallback then closeCallback() end
end

function IndexPanel.IsVisible(): boolean
	return visible
end

function IndexPanel.Toggle()
	if visible then IndexPanel.Hide() else IndexPanel.Show() end
end

return IndexPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="156">
            <Properties>
              <string name="Name">KillFeed</string>
              <string name="Source"><![CDATA[--[[
	KillFeed
	Right-side kill feed — shows elimination messages with slide-in + fade-out.

	* Listens for KillFeedEvent RemoteEvent (fired by server on elimination)
	* Also listens for player Humanoid.Died as a local fallback
	* Each message disappears after ~3 seconds
	* Stacks nicely (max 5 visible at once)
	* Vibrant, readable text with dark stroke

	Position: top-right, anchored below the HUD's right-side safe area.
	This keeps the feed clear of the top-right button stack.

	Used by: UIController (initialized once)
]]

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local UIConfig = require(Shared:WaitForChild("UIConfig"))

local C = UIConfig.Colors
local DEBUG_LOGS = RunService:IsStudio() and UIConfig.DebugLogs == true

local KillFeed = {}

local feedGui = nil
local feedContainer = nil
local safeAreaFrame: GuiObject? = nil
local MAX_MESSAGES = 5
local MESSAGE_LIFETIME = 2.6
local SLIDE_DURATION = 0.25
local FADE_DURATION = 0.4
local FEED_MIN_WIDTH = 340
local FEED_MAX_WIDTH = 440
local FEED_WIDTH_RATIO = 0.52
local FEED_ENTRY_HEIGHT = 36
local FEED_ENTRY_GAP = 6
local FEED_RIGHT_MARGIN = 16
local FEED_FALLBACK_TOP_OFFSET = 240
local RIGHT_SAFE_AREA_NAME = "HUDRightSafeArea"
local FEED_TEXT_PADDING = 12
local FEED_MAX_TEXT_SIZE = 15
local FEED_MIN_TEXT_SIZE = 10

local REASON_MAP = {
	Beam           = "Beam",
	OOB            = "Barrier",
	Barrier        = "Barrier",
	Disconnect     = "Disconnect",
	InactiveNoMove = "Inactivity",
	Sword          = "Sword",
	TungTungSahur  = "TungTungSahur",
	Unknown        = "Unknown",
}

-- Color override per reason key (nil = default white)
local REASON_COLOR = {
	Beam          = Color3.fromRGB(255, 165, 0),  -- orange
	OOB           = Color3.fromRGB(220, 50, 50),  -- red
	Barrier       = Color3.fromRGB(220, 50, 50),  -- red
	TungTungSahur = Color3.fromRGB(255, 60, 180), -- hot pink
}

local function trim(s: string): string
	return (string.gsub(string.gsub(s, "^%s+", ""), "%s+$", ""))
end

local function normalizeReasonKey(rawReason: any): string
	if typeof(rawReason) ~= "string" then
		return tostring(rawReason or "")
	end

	local reason = trim(rawReason)
	local lowered = string.lower(reason)
	local compact = string.gsub(lowered, "[^%a%d]", "")

	if compact == "beam" then
		return "Beam"
	end
	if compact == "oob" or compact == "barrier" or compact == "outofbounds" then
		return "OOB"
	end
	if compact == "disconnect" or compact == "disconnected" then
		return "Disconnect"
	end
	if compact == "inactivenomove" or compact == "inactive" then
		return "InactiveNoMove"
	end
	if compact == "sword" then
		return "Sword"
	end
	if compact == "tungtungsahur" or compact == "tungtung" or compact == "sahur" or compact == "tts" then
		return "TungTungSahur"
	end
	if compact == "unknown" then
		return "Unknown"
	end

	return reason
end

local function resolvePlayerKillerName(rawReason: any): string?
	local reasonType = typeof(rawReason)
	if reasonType == "Instance" then
		if rawReason:IsA("Player") then
			return rawReason.Name
		end
		return nil
	end
	if reasonType == "number" then
		local killerPlayer = Players:GetPlayerByUserId(rawReason)
		return killerPlayer and killerPlayer.Name or nil
	end
	if reasonType ~= "string" then
		return nil
	end

	local reason = trim(rawReason)
	if reason == "" or reason == "..." then
		return nil
	end

	local normalized = normalizeReasonKey(reason)
	if REASON_MAP[normalized] ~= nil then
		return nil
	end

	return reason
end

local function getViewportWidth(): number
	local camera = Workspace.CurrentCamera
	if camera then
		return camera.ViewportSize.X
	end
	return FEED_MIN_WIDTH
end

local function getResolvedFeedWidth(): number
	return math.clamp(math.floor(getViewportWidth() * FEED_WIDTH_RATIO), FEED_MIN_WIDTH, FEED_MAX_WIDTH)
end

local function debugLogKillFeed(sourceLabel: string, text: string)
	if not DEBUG_LOGS then
		return
	end
	print(string.format("[KillFeed] source=%s text=%s", sourceLabel, text))
end

local function formatKillFeedMessage(playerName: any, rawReason: any): (string, string, string)
	local victimName = tostring(playerName or "Unknown")
	local reason = normalizeReasonKey(rawReason)
	local killerName = resolvePlayerKillerName(rawReason)
	if killerName then
		return string.format("%s eliminated %s", tostring(killerName), victimName), reason, "Player"
	end

	local sourceName = REASON_MAP[reason]
	if sourceName == nil or sourceName == "" then
		sourceName = "Unknown"
	end

	return string.format("%s eliminated %s", sourceName, victimName), reason, sourceName
end

local function resizeFeedContainer()
	if not feedContainer then
		return
	end

	feedContainer.Size = UDim2.new(
		0,
		getResolvedFeedWidth(),
		0,
		(FEED_ENTRY_HEIGHT * MAX_MESSAGES) + (FEED_ENTRY_GAP * math.max(MAX_MESSAGES - 1, 0))
	)
end

local function repositionFeedContainer()
	if not feedContainer then
		return
	end

	local topOffset = FEED_FALLBACK_TOP_OFFSET
	if safeAreaFrame and safeAreaFrame.Parent then
		local recommendedGap = safeAreaFrame:GetAttribute("RecommendedGap")
		if typeof(recommendedGap) ~= "number" then
			recommendedGap = 16
		end
		topOffset = safeAreaFrame.Position.Y.Offset + safeAreaFrame.Size.Y.Offset + recommendedGap
	end

	feedContainer.AnchorPoint = Vector2.new(1, 0)
	feedContainer.Position = UDim2.new(1, -FEED_RIGHT_MARGIN, 0, math.floor(topOffset))
end

local function bindViewportResize()
	local cameraConn: RBXScriptConnection? = nil

	local function attachCamera(camera: Camera?)
		if cameraConn then
			cameraConn:Disconnect()
			cameraConn = nil
		end

		if camera then
			cameraConn = camera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
				resizeFeedContainer()
				repositionFeedContainer()
			end)
		end

		resizeFeedContainer()
		repositionFeedContainer()
	end

	Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
		attachCamera(Workspace.CurrentCamera)
	end)

	attachCamera(Workspace.CurrentCamera)
end

local function bindSafeArea(frame: GuiObject)
	if safeAreaFrame == frame then
		repositionFeedContainer()
		return
	end

	safeAreaFrame = frame
	frame:GetPropertyChangedSignal("Position"):Connect(repositionFeedContainer)
	frame:GetPropertyChangedSignal("Size"):Connect(repositionFeedContainer)
	frame:GetAttributeChangedSignal("RecommendedGap"):Connect(repositionFeedContainer)
	repositionFeedContainer()
end

local function observeSafeArea(screenGui: ScreenGui)
	local existing = screenGui:FindFirstChild(RIGHT_SAFE_AREA_NAME)
	if existing and existing:IsA("GuiObject") then
		bindSafeArea(existing)
	end

	screenGui.ChildAdded:Connect(function(child)
		if child.Name == RIGHT_SAFE_AREA_NAME and child:IsA("GuiObject") then
			bindSafeArea(child)
		end
	end)
end

local function createFeedEntry(text, color)
	color = color or C.TextWhite

	local children = {}
	for _, child in ipairs(feedContainer:GetChildren()) do
		if child:IsA("Frame") then table.insert(children, child) end
	end
	while #children >= MAX_MESSAGES do
		local oldest = children[1]
		oldest:Destroy()
		table.remove(children, 1)
	end

	local entry = Instance.new("Frame")
	entry.Name = "FeedEntry"
	entry.Size = UDim2.new(1, 0, 0, FEED_ENTRY_HEIGHT)
	entry.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
	entry.BackgroundTransparency = 0.45
	entry.BorderSizePixel = 0
	entry.ClipsDescendants = false
	entry.ZIndex = 2
	entry.Parent = feedContainer

	Instance.new("UICorner", entry).CornerRadius = UDim.new(0, 8)

	local label = Instance.new("TextLabel")
	label.Name = "Text"
	label.Size = UDim2.new(1, -(FEED_TEXT_PADDING * 2), 1, 0)
	label.Position = UDim2.fromOffset(FEED_TEXT_PADDING, 0)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBold
	label.TextColor3 = color
	label.TextSize = FEED_MAX_TEXT_SIZE
	label.TextScaled = true
	label.Text = text
	label.TextWrapped = false
	label.TextXAlignment = Enum.TextXAlignment.Right
	label.TextYAlignment = Enum.TextYAlignment.Center
	label.TextTruncate = Enum.TextTruncate.None
	label.ZIndex = 3
	label.Parent = entry

	local textSizeConstraint = Instance.new("UITextSizeConstraint")
	textSizeConstraint.MaxTextSize = FEED_MAX_TEXT_SIZE
	textSizeConstraint.MinTextSize = FEED_MIN_TEXT_SIZE
	textSizeConstraint.Parent = label

	local ls = Instance.new("UIStroke")
	ls.Color = Color3.fromRGB(0, 0, 0)
	ls.Thickness = 1.5
	ls.Transparency = 0.15
	ls.Parent = label

	local startPos = entry.Position
	entry.Position = UDim2.new(0, 40, startPos.Y.Scale, startPos.Y.Offset)
	entry.BackgroundTransparency = 1
	label.TextTransparency = 1

	TweenService:Create(entry, TweenInfo.new(SLIDE_DURATION, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
		Position = startPos,
		BackgroundTransparency = 0.45,
	}):Play()
	TweenService:Create(label, TweenInfo.new(SLIDE_DURATION, Enum.EasingStyle.Quad), {
		TextTransparency = 0,
	}):Play()

	task.delay(MESSAGE_LIFETIME, function()
		if not entry or not entry.Parent then return end
		TweenService:Create(entry, TweenInfo.new(FADE_DURATION, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
			BackgroundTransparency = 1,
		}):Play()
		TweenService:Create(label, TweenInfo.new(FADE_DURATION, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
			TextTransparency = 1,
		}):Play()
		task.delay(FADE_DURATION + 0.1, function()
			if entry and entry.Parent then
				entry:Destroy()
			end
		end)
	end)
end

function KillFeed.Init(screenGui)
	feedGui = screenGui

	feedContainer = Instance.new("Frame")
	feedContainer.Name = "KillFeedContainer"
	feedContainer.Size = UDim2.new(0, 0, 0, 0)
	feedContainer.BackgroundTransparency = 1
	feedContainer.BorderSizePixel = 0
	feedContainer.ClipsDescendants = false
	feedContainer.ZIndex = 2
	feedContainer.Parent = screenGui

	bindViewportResize()
	resizeFeedContainer()
	repositionFeedContainer()
	observeSafeArea(screenGui)

	local layout = Instance.new("UIListLayout")
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Padding = UDim.new(0, FEED_ENTRY_GAP)
	layout.FillDirection = Enum.FillDirection.Vertical
	layout.VerticalAlignment = Enum.VerticalAlignment.Top
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Right
	layout.Parent = feedContainer

	task.spawn(function()
		local remotes = ReplicatedStorage:WaitForChild("Remotes", 15)
		if not remotes then return end
		local killFeedEvent = remotes:WaitForChild("KillFeedEvent", 10)
		if killFeedEvent then
			killFeedEvent.OnClientEvent:Connect(function(playerName, rawReason)
				local text, reason, sourceLabel = formatKillFeedMessage(playerName, rawReason)
				debugLogKillFeed(sourceLabel, text)
				local color = REASON_COLOR[reason] or C.TextWhite
				createFeedEntry(text, color)
			end)
		end
	end)
end

function KillFeed.Push(text, color)
	createFeedEntry(text, color)
end

return KillFeed
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="157">
            <Properties>
              <string name="Name">MatchResultsPanel</string>
              <string name="Source"><![CDATA[--[[
	MatchResultsPanel
	Auto-shows at end of match when MatchResultsEvent fires.
	Displays placement, coin rewards, player rankings, and crown progression bar.

	NOT a standard UIController panel — cannot be toggled by user.
	Self-dismisses after the results phase or on state transition.
	Can also be closed via X button, ESC, or clicking outside.

	Reliability:
	  • Uses a dedicated ScreenGui (DisplayOrder 100) so no other panel can
	    block the close button.
	  • Hooks MatchStatus.State (replicated StringValue) to auto-close when
	    the server transitions out of "Ending".
	  • Hard failsafe timer as final backup.
	  • UIScale tween starts AFTER final card size is set (no mid-tween shift).

	API:
	  Init(screenGui)  — wire up remote listener
	  Show(data)       — build + display results
	  Hide()           — fade out + destroy
]]

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer
local Shared = ReplicatedStorage:WaitForChild("Shared")
local UIConfig = require(Shared:WaitForChild("UIConfig"))
local DEBUG_LOGS = RunService:IsStudio() and UIConfig.DebugLogs == true

local Client = script.Parent
local AnimUtil = require(Client:WaitForChild("AnimUtil"))

local MatchResultsPanel = {}

local _UIController = nil
local function getUIController()
	if _UIController then return _UIController end
	pcall(function()
		local playerScripts = LocalPlayer:FindFirstChild("PlayerScripts")
		local clientFolder = playerScripts and playerScripts:FindFirstChild("Client")
		local mod = clientFolder and clientFolder:FindFirstChild("UIController")
		if mod then _UIController = require(mod) end
	end)
	return _UIController
end

local _RewardPopup = nil
local function getRewardPopup()
	if _RewardPopup then return _RewardPopup end
	pcall(function()
		local mod = script.Parent:FindFirstChild("RewardPopup")
		if mod then _RewardPopup = require(mod) end
	end)
	return _RewardPopup
end

local _gui: ScreenGui? = nil
local _overlay: Frame? = nil
local _active = false
local _hideTimer: thread? = nil
local _escConn: RBXScriptConnection? = nil
local _stateConn: RBXScriptConnection? = nil
local _globalStateConn: RBXScriptConnection? = nil
local _matchStateVal: StringValue? = nil  -- ReplicatedStorage.MatchStatus.State

-- ═══════════════════════════════════════════
-- CONSTANTS
-- ═══════════════════════════════════════════

local DISPLAY_SECONDS = 7

local PLACEMENT_SUFFIXES = { "st", "nd", "rd" }
local function ordinal(n: number): string
	if n >= 11 and n <= 13 then return tostring(n) .. "th" end
	local s = PLACEMENT_SUFFIXES[n % 10]
	return tostring(n) .. (s or "th")
end

local function formatCoinText(n: number): string
	if n >= 1000000 then
		return string.format("%.1fM", n / 1000000)
	end
	if n >= 10000 then
		return string.format("%.1fK", n / 1000)
	end
	return tostring(math.floor(n))
end

local PLACEMENT_COLORS = {
	[1] = Color3.fromRGB(255, 215, 0),   -- gold
	[2] = Color3.fromRGB(200, 200, 210),  -- silver
	[3] = Color3.fromRGB(205, 127, 50),   -- bronze
}

-- ═══════════════════════════════════════════
-- LAZY ITEMCATALOG
-- ═══════════════════════════════════════════
local _ItemCatalog = nil
local function getItemCatalog()
	if _ItemCatalog then return _ItemCatalog end
	pcall(function()
		local Shared = ReplicatedStorage:FindFirstChild("Shared")
		if Shared then
			local cdp = Shared:FindFirstChild("ClientDepsProvider")
			if cdp then
				local Deps = require(cdp)
				_ItemCatalog = Deps and Deps.ItemCatalog
			end
		end
	end)
	return _ItemCatalog
end

-- ═══════════════════════════════════════════
-- DISMISS
-- ═══════════════════════════════════════════
local function cleanupStaleWrappers(reason: string): number
	if not _gui or not _gui.Parent then
		return 0
	end
	local removed = 0
	for _, child in ipairs(_gui:GetChildren()) do
		if child:IsA("Frame") and child.Name == "ModalWrapper" then
			child:Destroy()
			removed += 1
		end
	end
	if removed > 0 then
		print(string.format("[MatchResultsPanel] stale cleanup reason=%s removedWrappers=%d", reason, removed))
	end
	return removed
end

function MatchResultsPanel.Hide()
	local wasActive = _active
	_active = false
	if _hideTimer then
		task.cancel(_hideTimer)
		_hideTimer = nil
	end
	if _escConn then
		_escConn:Disconnect()
		_escConn = nil
	end
	if _stateConn then
		_stateConn:Disconnect()
		_stateConn = nil
	end
	local ov = _overlay
	if ov and ov.Parent then
		local panel = ov:FindFirstChild("ResultsCard")
		print("[Modal] Hide MatchResults -> tween out -> hidden")
		if panel then
			AnimUtil.PopupClose(panel, ov)
		else
			task.delay(0.25, function()
				if ov and ov.Parent then ov:Destroy() end
			end)
		end
	end
	_overlay = nil
	cleanupStaleWrappers("Hide")
	print(string.format("[MatchResultsPanel] closed wasActive=%s", tostring(wasActive)))
end

-- ═══════════════════════════════════════════
-- SHOW
-- ═══════════════════════════════════════════
function MatchResultsPanel.Show(data)
	if not data then return end

	cleanupStaleWrappers("ShowPreOpen")

	local uic = getUIController()
	if uic and uic.CloseAllPanels then uic.CloseAllPanels() end

	local rp = getRewardPopup()
	if rp and rp.IsActive and rp.IsActive() then rp.Dismiss() end

	-- Clean up existing
	if _active then
		MatchResultsPanel.Hide()
		task.wait(0.1)
	end

	if not _gui or not _gui.Parent then return end

	_active = true
	print(string.format("[MatchResultsPanel] opened placement=%s coins=%s rankings=%d",
		tostring(data.yourPlacement),
		tostring(data.yourCoins),
		type(data.rankings) == "table" and #data.rankings or 0
	))

	local wrapper = Instance.new("Frame")
	wrapper.Name = "ModalWrapper"
	wrapper.Size = UDim2.fromScale(1, 1)
	wrapper.BackgroundTransparency = 1
	wrapper.BorderSizePixel = 0
	wrapper.ZIndex = 40
	wrapper.Parent = _gui
	_overlay = wrapper

	local clickCatcher = Instance.new("TextButton")
	clickCatcher.Name = "ClickCatcher"
	clickCatcher.Size = UDim2.fromScale(1, 1)
	clickCatcher.BackgroundTransparency = 1
	clickCatcher.BorderSizePixel = 0
	clickCatcher.Text = ""
	clickCatcher.AutoButtonColor = false
	clickCatcher.Active = true
	clickCatcher.ZIndex = 40
	clickCatcher.Parent = wrapper
	clickCatcher.MouseButton1Click:Connect(function()
		print("[MatchResultsPanel] close clicked source=overlay")
		MatchResultsPanel.Hide()
	end)

	-- ESC to close
	_escConn = UserInputService.InputBegan:Connect(function(input, processed)
		if processed then return end
		if input.KeyCode == Enum.KeyCode.Escape then
			print("[MatchResultsPanel] close clicked source=escape")
			MatchResultsPanel.Hide()
		end
	end)

	if _matchStateVal then
		_stateConn = _matchStateVal.Changed:Connect(function(newVal)
			if _active and newVal ~= "Ending" then
				print("[MatchResultsPanel] MatchStatus.State →", newVal, "— auto-closing")
				MatchResultsPanel.Hide()
			end
		end)
	end

	local CARD_W, CARD_H = 420, 480
	local card = Instance.new("TextButton")
	card.Name = "ResultsCard"
	card.AnchorPoint = Vector2.new(0.5, 0.5)
	card.Position = UDim2.fromScale(0.5, 0.5)
	card.Size = UDim2.fromOffset(CARD_W, CARD_H)
	card.BackgroundColor3 = Color3.fromRGB(20, 22, 35)
	card.BackgroundTransparency = 0.03
	card.BorderSizePixel = 0
	card.Text = ""
	card.AutoButtonColor = false
	card.ZIndex = 41
	card.Parent = wrapper

	card.MouseButton1Click:Connect(function()
		print("[MatchResultsPanel] close clicked source=card")
		MatchResultsPanel.Hide()
	end)

	Instance.new("UICorner", card).CornerRadius = UDim.new(0, 18)
	local cardStroke = Instance.new("UIStroke")
	cardStroke.Color = Color3.fromRGB(80, 100, 180)
	cardStroke.Thickness = 2
	cardStroke.Transparency = 0.2
	cardStroke.Parent = card

	-- ── Close "X" button (top-right, high ZIndex) ──
	local closeBtn = Instance.new("TextButton")
	closeBtn.Name = "CloseBtn"
	closeBtn.AnchorPoint = Vector2.new(1, 0)
	closeBtn.Position = UDim2.new(1, -6, 0, 6)
	closeBtn.Size = UDim2.fromOffset(36, 36)
	closeBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 60)
	closeBtn.BackgroundTransparency = 0.15
	closeBtn.Font = Enum.Font.GothamBold
	closeBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
	closeBtn.TextSize = 18
	closeBtn.Text = "X"
	closeBtn.BorderSizePixel = 0
	closeBtn.AutoButtonColor = true
	closeBtn.ZIndex = 55
	closeBtn.Parent = card
	Instance.new("UICorner", closeBtn).CornerRadius = UDim.new(1, 0)
	closeBtn.MouseButton1Click:Connect(function()
		print("[MatchResultsPanel] close clicked source=button")
		MatchResultsPanel.Hide()
	end)

	local yOffset = 12

	-- ── Header: MATCH RESULTS ──
	local header = Instance.new("TextLabel")
	header.Name = "Header"
	header.AnchorPoint = Vector2.new(0.5, 0)
	header.Position = UDim2.new(0.5, 0, 0, yOffset)
	header.Size = UDim2.new(1, -20, 0, 28)
	header.BackgroundTransparency = 1
	header.Font = Enum.Font.GothamBold
	header.TextColor3 = Color3.fromRGB(255, 255, 255)
	header.TextSize = 22
	header.Text = "MATCH RESULTS"
	header.ZIndex = 42
	header.Parent = card
	local hs = Instance.new("UIStroke")
	hs.Color = Color3.fromRGB(0, 0, 0)
	hs.Thickness = 2
	hs.Parent = header
	yOffset += 34

	-- ── Your placement + rewards ──
	local placementColor = PLACEMENT_COLORS[data.yourPlacement] or Color3.fromRGB(180, 180, 200)
	local placementText = ordinal(data.yourPlacement)

	local placeLbl = Instance.new("TextLabel")
	placeLbl.AnchorPoint = Vector2.new(0.5, 0)
	placeLbl.Position = UDim2.new(0.5, 0, 0, yOffset)
	placeLbl.Size = UDim2.new(1, -20, 0, 32)
	placeLbl.BackgroundTransparency = 1
	placeLbl.Font = Enum.Font.GothamBold
	placeLbl.TextColor3 = placementColor
	placeLbl.TextSize = 28
	placeLbl.Text = placementText .. " Place"
	placeLbl.ZIndex = 42
	placeLbl.Parent = card
	local ps = Instance.new("UIStroke")
	ps.Color = Color3.fromRGB(0, 0, 0)
	ps.Thickness = 2
	ps.Parent = placeLbl
	yOffset += 36

	local placementCoins = tonumber(data.placementCoins or data.yourCoins) or 0
	local matchCoins = tonumber(data.matchCoinsCollected) or 0
	local firstMatchBonusCoins = tonumber(data.firstMatchBonusCoins) or 0
	local totalEarned = tonumber(data.totalCoinsEarned) or (placementCoins + matchCoins + firstMatchBonusCoins)
	local currentCoinsAfterRewards = tonumber(data.currentCoinsAfterRewards) or 0
	local rewardLabelText = if data.yourPlacement == 1 then "Win Bonus" else "Placement Bonus"

	local function addRewardLine(text: string, color: Color3, size: number, font: Enum.Font)
		local line = Instance.new("TextLabel")
		line.AnchorPoint = Vector2.new(0.5, 0)
		line.Position = UDim2.new(0.5, 0, 0, yOffset)
		line.Size = UDim2.new(1, -24, 0, size + 4)
		line.BackgroundTransparency = 1
		line.Font = font
		line.TextColor3 = color
		line.TextSize = size
		line.Text = text
		line.ZIndex = 42
		line.Parent = card

		local stroke = Instance.new("UIStroke")
		stroke.Color = Color3.fromRGB(0, 0, 0)
		stroke.Thickness = if size >= 18 then 1.5 else 1.2
		stroke.Transparency = 0.15
		stroke.Parent = line

		yOffset += size + 6
	end

	addRewardLine(string.format("+%d %s", placementCoins, rewardLabelText), Color3.fromRGB(255, 220, 60), 16, Enum.Font.GothamSemibold)
	if matchCoins > 0 then
		addRewardLine(string.format("+%d Coins Collected", matchCoins), Color3.fromRGB(100, 220, 255), 14, Enum.Font.GothamSemibold)
	end
	if firstMatchBonusCoins > 0 then
		addRewardLine(string.format("+%d First Match Bonus", firstMatchBonusCoins), Color3.fromRGB(120, 232, 166), 14, Enum.Font.GothamSemibold)
	end
	addRewardLine(string.format("TOTAL EARNED  +%d F", totalEarned), Color3.fromRGB(255, 255, 255), 19, Enum.Font.GothamBold)
	if currentCoinsAfterRewards > 0 then
		addRewardLine(string.format("Balance Now: %s F", formatCoinText(currentCoinsAfterRewards)), Color3.fromRGB(195, 205, 235), 13, Enum.Font.GothamMedium)
	end

	if DEBUG_LOGS then
		print(string.format(
			"[MatchResultsPanel] placement=%s placementCoins=%s matchCoins=%s firstMatchBonus=%s total=%s",
			tostring(data.yourPlacement),
			tostring(placementCoins),
			tostring(matchCoins),
			tostring(firstMatchBonusCoins),
			tostring(totalEarned)
		))
	end
	yOffset += 2

	-- Separator
	local sep1 = Instance.new("Frame")
	sep1.Size = UDim2.new(1, -30, 0, 1)
	sep1.Position = UDim2.new(0, 15, 0, yOffset)
	sep1.BackgroundColor3 = Color3.fromRGB(60, 70, 110)
	sep1.BackgroundTransparency = 0.3
	sep1.BorderSizePixel = 0
	sep1.ZIndex = 42
	sep1.Parent = card
	yOffset += 8

	-- ── Player rankings list ──
	local rankingsData = data.rankings or {}
	local listHeight = math.min(#rankingsData * 24, 120)

	local listFrame = Instance.new("ScrollingFrame")
	listFrame.Name = "RankingsList"
	listFrame.AnchorPoint = Vector2.new(0.5, 0)
	listFrame.Position = UDim2.new(0.5, 0, 0, yOffset)
	listFrame.Size = UDim2.new(1, -24, 0, listHeight)
	listFrame.BackgroundTransparency = 1
	listFrame.BorderSizePixel = 0
	listFrame.ScrollBarThickness = 3
	listFrame.ScrollBarImageColor3 = Color3.fromRGB(100, 110, 150)
	listFrame.CanvasSize = UDim2.fromOffset(0, #rankingsData * 24)
	listFrame.ZIndex = 42
	listFrame.Parent = card

	local listLayout = Instance.new("UIListLayout")
	listLayout.FillDirection = Enum.FillDirection.Vertical
	listLayout.SortOrder = Enum.SortOrder.LayoutOrder
	listLayout.Padding = UDim.new(0, 2)
	listLayout.Parent = listFrame

	for i, r in ipairs(rankingsData) do
		local row = Instance.new("Frame")
		row.Name = "Row" .. i
		row.Size = UDim2.new(1, 0, 0, 22)
		row.BackgroundTransparency = 1
		row.LayoutOrder = i
		row.ZIndex = 43
		row.Parent = listFrame

		local isYou = r.playerName == LocalPlayer.Name
		local rowColor = isYou and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(160, 170, 200)
		local rowFont = isYou and Enum.Font.GothamBold or Enum.Font.Gotham

		local placeCol = PLACEMENT_COLORS[r.placement] or Color3.fromRGB(140, 140, 160)

		local placeTxt = Instance.new("TextLabel")
		placeTxt.Size = UDim2.new(0, 30, 1, 0)
		placeTxt.Position = UDim2.fromOffset(4, 0)
		placeTxt.BackgroundTransparency = 1
		placeTxt.Font = Enum.Font.GothamBold
		placeTxt.TextColor3 = placeCol
		placeTxt.TextSize = 13
		placeTxt.Text = "#" .. tostring(r.placement)
		placeTxt.TextXAlignment = Enum.TextXAlignment.Left
		placeTxt.ZIndex = 43
		placeTxt.Parent = row

		local nameTxt = Instance.new("TextLabel")
		nameTxt.Size = UDim2.new(1, -90, 1, 0)
		nameTxt.Position = UDim2.fromOffset(36, 0)
		nameTxt.BackgroundTransparency = 1
		nameTxt.Font = rowFont
		nameTxt.TextColor3 = rowColor
		nameTxt.TextSize = 13
		nameTxt.Text = r.playerName .. (isYou and " (You)" or "")
		nameTxt.TextXAlignment = Enum.TextXAlignment.Left
		nameTxt.TextTruncate = Enum.TextTruncate.AtEnd
		nameTxt.ZIndex = 43
		nameTxt.Parent = row

		local rMatchCoins = r.matchCoinsCollected or 0
		if rMatchCoins > 0 then
			local collectedTxt = Instance.new("TextLabel")
			collectedTxt.Size = UDim2.new(0, 46, 1, 0)
			collectedTxt.AnchorPoint = Vector2.new(1, 0)
			collectedTxt.Position = UDim2.new(1, -56, 0, 0)
			collectedTxt.BackgroundTransparency = 1
			collectedTxt.Font = Enum.Font.Gotham
			collectedTxt.TextColor3 = Color3.fromRGB(100, 220, 255)
			collectedTxt.TextSize = 11
			collectedTxt.Text = string.format("[%d]", rMatchCoins)
			collectedTxt.TextXAlignment = Enum.TextXAlignment.Right
			collectedTxt.ZIndex = 43
			collectedTxt.Parent = row
		end

		local coinsTxt = Instance.new("TextLabel")
		coinsTxt.Size = UDim2.new(0, 50, 1, 0)
		coinsTxt.AnchorPoint = Vector2.new(1, 0)
		coinsTxt.Position = UDim2.new(1, -4, 0, 0)
		coinsTxt.BackgroundTransparency = 1
		coinsTxt.Font = Enum.Font.GothamSemibold
		coinsTxt.TextColor3 = Color3.fromRGB(255, 220, 60)
		coinsTxt.TextSize = 12
		coinsTxt.Text = "+" .. tostring(r.coins)
		coinsTxt.TextXAlignment = Enum.TextXAlignment.Right
		coinsTxt.ZIndex = 43
		coinsTxt.Parent = row
	end
	yOffset += listHeight + 10

	-- Separator
	local sep2 = Instance.new("Frame")
	sep2.Size = UDim2.new(1, -30, 0, 1)
	sep2.Position = UDim2.new(0, 15, 0, yOffset)
	sep2.BackgroundColor3 = Color3.fromRGB(60, 70, 110)
	sep2.BackgroundTransparency = 0.3
	sep2.BorderSizePixel = 0
	sep2.ZIndex = 42
	sep2.Parent = card
	yOffset += 10

	-- ══════════════════════════════════════════════
	-- CROWN PROGRESSION BAR
	-- ══════════════════════════════════════════════
	local prevM = data.prevMilestone or { wins = 0, crownId = "" }
	local nextM = data.nextMilestone
	local lifetimeWins = data.lifetimeWins or 0
	local crownGranted = data.crownGranted

	local BAR_H = 22
	local BAR_W = CARD_W - 50

	-- Section label
	local crownLabel = Instance.new("TextLabel")
	crownLabel.AnchorPoint = Vector2.new(0.5, 0)
	crownLabel.Position = UDim2.new(0.5, 0, 0, yOffset)
	crownLabel.Size = UDim2.new(1, -30, 0, 18)
	crownLabel.BackgroundTransparency = 1
	crownLabel.Font = Enum.Font.GothamBold
	crownLabel.TextColor3 = Color3.fromRGB(255, 215, 0)
	crownLabel.TextSize = 13
	crownLabel.Text = "CROWN PROGRESS"
	crownLabel.ZIndex = 42
	crownLabel.Parent = card
	yOffset += 22

	-- Progress bar background
	local barBg = Instance.new("Frame")
	barBg.Name = "BarBg"
	barBg.AnchorPoint = Vector2.new(0.5, 0)
	barBg.Position = UDim2.new(0.5, 0, 0, yOffset)
	barBg.Size = UDim2.fromOffset(BAR_W, BAR_H)
	barBg.BackgroundColor3 = Color3.fromRGB(35, 38, 55)
	barBg.BorderSizePixel = 0
	barBg.ZIndex = 42
	barBg.Parent = card
	Instance.new("UICorner", barBg).CornerRadius = UDim.new(0, 8)

	-- Progress bar fill
	local fillFraction = 0
	if nextM and nextM.wins > prevM.wins then
		fillFraction = math.clamp((lifetimeWins - prevM.wins) / (nextM.wins - prevM.wins), 0, 1)
	elseif not nextM then
		fillFraction = 1
	end

	local barFill = Instance.new("Frame")
	barFill.Name = "BarFill"
	barFill.Size = UDim2.new(0, 0, 1, 0)
	barFill.BackgroundColor3 = Color3.fromRGB(80, 200, 120)
	barFill.BorderSizePixel = 0
	barFill.ZIndex = 43
	barFill.Parent = barBg
	Instance.new("UICorner", barFill).CornerRadius = UDim.new(0, 8)

	local targetFillW = math.floor(BAR_W * fillFraction)
	task.delay(0.3, function()
		if barFill and barFill.Parent then
			TweenService:Create(barFill, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				Size = UDim2.new(0, targetFillW, 1, 0)
			}):Play()
		end
	end)

	-- Wins text overlay
	local winsText = Instance.new("TextLabel")
	winsText.AnchorPoint = Vector2.new(0.5, 0.5)
	winsText.Position = UDim2.fromScale(0.5, 0.5)
	winsText.Size = UDim2.fromScale(1, 1)
	winsText.BackgroundTransparency = 1
	winsText.Font = Enum.Font.GothamBold
	winsText.TextColor3 = Color3.fromRGB(255, 255, 255)
	winsText.TextSize = 12
	winsText.ZIndex = 44
	winsText.Parent = barBg
	local ws = Instance.new("UIStroke")
	ws.Color = Color3.fromRGB(0, 0, 0)
	ws.Thickness = 1.5
	ws.Parent = winsText

	if nextM then
		winsText.Text = string.format("%d / %d Wins", lifetimeWins, nextM.wins)
	else
		winsText.Text = string.format("%d Wins (All Crowns!)", lifetimeWins)
	end

	-- Crown icon at the right end of the bar
	if nextM and nextM.crownId then
		local IC = getItemCatalog()
		local crownImage = ""
		if IC and IC.Crowns and IC.Crowns[nextM.crownId] then
			crownImage = IC.Crowns[nextM.crownId].image or ""
		end
		if crownImage ~= "" then
			local crownIcon = Instance.new("ImageLabel")
			crownIcon.Name = "CrownIcon"
			crownIcon.AnchorPoint = Vector2.new(0.5, 0.5)
			crownIcon.Position = UDim2.new(1, 16, 0.5, 0)
			crownIcon.Size = UDim2.fromOffset(28, 28)
			crownIcon.BackgroundTransparency = 1
			crownIcon.Image = crownImage
			crownIcon.ScaleType = Enum.ScaleType.Fit
			crownIcon.ZIndex = 44
			crownIcon.Parent = barBg
		end
	end
	yOffset += BAR_H + 8

	-- Crown granted animation
	if crownGranted then
		local grantLbl = Instance.new("TextLabel")
		grantLbl.AnchorPoint = Vector2.new(0.5, 0)
		grantLbl.Position = UDim2.new(0.5, 0, 0, yOffset)
		grantLbl.Size = UDim2.new(1, -30, 0, 24)
		grantLbl.BackgroundTransparency = 1
		grantLbl.Font = Enum.Font.GothamBold
		grantLbl.TextColor3 = Color3.fromRGB(255, 215, 0)
		grantLbl.TextSize = 16
		grantLbl.Text = "NEW CROWN UNLOCKED!"
		grantLbl.ZIndex = 42
		grantLbl.Parent = card

		local gs = Instance.new("UIStroke")
		gs.Color = Color3.fromRGB(0, 0, 0)
		gs.Thickness = 2
		gs.Parent = grantLbl

		local grantScale = Instance.new("UIScale")
		grantScale.Scale = 0.5
		grantScale.Parent = grantLbl
	task.delay(0.6, function()
		if grantScale and grantScale.Parent then
			TweenService:Create(grantScale, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Scale = 1 }):Play()
			end
		end)
		yOffset += 28
	end

	local replayLabel = Instance.new("TextLabel")
	replayLabel.AnchorPoint = Vector2.new(0.5, 0)
	replayLabel.Position = UDim2.new(0.5, 0, 0, yOffset)
	replayLabel.Size = UDim2.new(1, -28, 0, 28)
	replayLabel.BackgroundTransparency = 1
	replayLabel.Font = Enum.Font.GothamSemibold
	replayLabel.TextColor3 = Color3.fromRGB(255, 236, 138)
	replayLabel.TextSize = 13
	replayLabel.TextWrapped = true
	replayLabel.Text = tostring(data.replayMessage or "Next match starts soon - go for another win.")
	replayLabel.ZIndex = 42
	replayLabel.Parent = card
	yOffset += 30

	local nextGoal = data.nextGoal
	local nextGoalText = "All Fate Coin goals complete"
	if type(nextGoal) == "table" and tostring(nextGoal.name or "") ~= "" then
		if tonumber(nextGoal.remainingCoins) and tonumber(nextGoal.remainingCoins) > 0 then
			nextGoalText = string.format(
				"Next Goal: %s - %s F (%s more)",
				tostring(nextGoal.name),
				formatCoinText(tonumber(nextGoal.price) or 0),
				formatCoinText(tonumber(nextGoal.remainingCoins) or 0)
			)
		else
			nextGoalText = string.format(
				"Next Goal: %s - ready to unlock",
				tostring(nextGoal.name)
			)
		end
	end

	local nextGoalLabel = Instance.new("TextLabel")
	nextGoalLabel.AnchorPoint = Vector2.new(0.5, 0)
	nextGoalLabel.Position = UDim2.new(0.5, 0, 0, yOffset)
	nextGoalLabel.Size = UDim2.new(1, -28, 0, 32)
	nextGoalLabel.BackgroundTransparency = 1
	nextGoalLabel.Font = Enum.Font.Gotham
	nextGoalLabel.TextColor3 = Color3.fromRGB(190, 198, 225)
	nextGoalLabel.TextSize = 12
	nextGoalLabel.TextWrapped = true
	nextGoalLabel.Text = nextGoalText
	nextGoalLabel.ZIndex = 42
	nextGoalLabel.Parent = card
	yOffset += 34

	-- Finalize card size THEN start the scale-in animation
	card.Size = UDim2.fromOffset(CARD_W, yOffset + 14)
	AnimUtil.PopupOpen(card)

	task.defer(function()
		if card and card.Parent then
			print(string.format("[Modal] Show MatchResults parent=%s anchor=(%.1f,%.1f) pos=(%.2f,%.2f) absPos=(%.0f,%.0f) absSize=(%.0f,%.0f)",
				_gui.Name,
				card.AnchorPoint.X, card.AnchorPoint.Y,
				card.Position.X.Scale, card.Position.Y.Scale,
				card.AbsolutePosition.X, card.AbsolutePosition.Y,
				card.AbsoluteSize.X, card.AbsoluteSize.Y))
		end
	end)

	-- ── Auto-dismiss timer (hard failsafe) ──
	_hideTimer = task.delay(DISPLAY_SECONDS + 0.2, function()
		if _active then
			MatchResultsPanel.Hide()
		end
	end)
end

-- ═══════════════════════════════════════════
-- INIT
-- ═══════════════════════════════════════════
function MatchResultsPanel.Init(screenGui: ScreenGui)
	-- Create a dedicated high-priority ScreenGui so results always render
	-- above other panels (PanelGui DisplayOrder 10). This ensures the
	-- close button is never blocked by Pets/Crowns/Shop overlays.
	local pg = LocalPlayer:WaitForChild("PlayerGui")
	local resultsGui = Instance.new("ScreenGui")
	resultsGui.Name = "MatchResultsGui"
	resultsGui.DisplayOrder = 100
	resultsGui.IgnoreGuiInset = true
	resultsGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	resultsGui.ResetOnSpawn = false
	resultsGui.Parent = pg
	print("[Modal] MatchResultsGui ready (DisplayOrder=100, Global ZIndex)")
	_gui = resultsGui

	-- Cache MatchStatus.State (replicated StringValue) for auto-close
	task.spawn(function()
		local matchStatus = ReplicatedStorage:WaitForChild("MatchStatus", 15)
		if matchStatus then
			_matchStateVal = matchStatus:WaitForChild("State", 10)
			if _matchStateVal then
				print("[MatchResultsPanel] MatchStatus.State cached for auto-close")
				if _globalStateConn then
					_globalStateConn:Disconnect()
				end
				_globalStateConn = _matchStateVal.Changed:Connect(function(newVal)
					if newVal ~= "Ending" then
						local cleaned = cleanupStaleWrappers("RoundTransition:" .. tostring(newVal))
						if _active or cleaned > 0 then
							print(string.format("[MatchResultsPanel] round transition cleanup state=%s cleaned=%d",
								tostring(newVal), cleaned))
						end
						MatchResultsPanel.Hide()
					end
				end)
			end
		end
	end)

	task.spawn(function()
		local remotes = ReplicatedStorage:WaitForChild("Remotes", 15)
		if not remotes then
			warn("[MatchResultsPanel] Remotes folder not found")
			return
		end
		local event = remotes:WaitForChild("MatchResultsEvent", 15)
		if not event then
			warn("[MatchResultsPanel] MatchResultsEvent not found")
			return
		end
		event.OnClientEvent:Connect(function(payload)
			print("[MatchResultsPanel] Received match results")
			MatchResultsPanel.Show(payload)
		end)
		print("[MatchResultsPanel] Listening for MatchResultsEvent")
	end)
end

return MatchResultsPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="158">
            <Properties>
              <string name="Name">ModeVotePanel</string>
              <string name="Source"><![CDATA[--[[
	ModeVotePanel
	Client-side mode vote overlay shown during intermission.

	Appears during the mode vote window and stays catch-up safe through
	replicated MatchStatus values for late joiners and slow-loading clients.

	Top-right layout:
	  Vote reopen btn : Y=8
	  Force next mode : Y=44
	  Stats btn       : Y=96
	  Daily btn       : Y=140
]]

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local AnimUtil = require(script.Parent:WaitForChild("AnimUtil"))

local ModeVotePanel = {}

local player = Players.LocalPlayer
local initialized = false
local panelReady = false

local gui: ScreenGui? = nil
local panelFrame: Frame? = nil
local titleLabel: TextLabel? = nil
local subtitleLabel: TextLabel? = nil
local normalBtn: TextButton? = nil
local brainrotBtn: TextButton? = nil
local disasterBtn: TextButton? = nil
local normalCountLbl: TextLabel? = nil
local brainrotCountLbl: TextLabel? = nil
local voteRemote: RemoteEvent? = nil
local reopenBtn: TextButton? = nil
local voteLockedValue: BoolValue? = nil
local voteLockedModeValue: StringValue? = nil
local voteActiveValue: BoolValue? = nil
local matchStateValue: StringValue? = nil

local currentVote: string? = nil
local voteWindowOpen = false
local currentVoteLocked = false
local forcedVoteMode: string? = nil

local VOTE_DISPLAY_ORDER = 150

local eventQueue = {}

local PANEL_BG = Color3.fromRGB(22, 25, 38)
local HEADER_COLOR = Color3.fromRGB(255, 215, 48)
local BTN_NORMAL_COLOR = Color3.fromRGB(50, 160, 80)
local BTN_BRAINROT_COLOR = Color3.fromRGB(178, 48, 255)
local BTN_LOCKED_COLOR = Color3.fromRGB(95, 95, 105)
local BTN_SELECTED_STROKE = Color3.fromRGB(255, 255, 255)
local BTN_UNSELECTED_STROKE = Color3.fromRGB(60, 65, 85)
local TEXT_COLOR = Color3.fromRGB(255, 255, 255)

local NORMAL_MODE_IMAGE = "rbxassetid://90452980108887"
local BRAINROT_MODE_IMAGE = "rbxassetid://134040200136136"

local updateSelection

local function isPlayerAFK(): boolean
	local state = player:GetAttribute("PlayerState")
	return state == "AFK"
end

local function isTutorialBlocked(): boolean
	if player:GetAttribute("TutorialCompleted") ~= true then
		return true
	end
	return player:GetAttribute("PlayerState") == "TutorialLocked"
end

local function getReplicatedVotePayload()
	return {
		locked = voteLockedValue and voteLockedValue.Value or false,
		forcedMode = voteLockedModeValue and voteLockedModeValue.Value or nil,
	}
end

local function setGuiPreferredEnabled(enabled: boolean)
	if gui then
		gui:SetAttribute("PreferredEnabled", enabled)
	end
end

local function getModeDisplayName(modeName: string?): string
	if modeName == "Brainrot" then
		return "Save the Brainrot"
	end
	return "Normal Mode"
end

local function setVoteLockState(locked: boolean, forcedMode: string?)
	currentVoteLocked = locked == true
	if currentVoteLocked and (forcedMode == "Normal" or forcedMode == "Brainrot") then
		forcedVoteMode = forcedMode
	else
		forcedVoteMode = nil
	end

	if titleLabel then
		titleLabel.Text = currentVoteLocked and "NEXT MODE LOCKED" or "CHOOSE NEXT MODE"
	end

	if subtitleLabel then
		if currentVoteLocked then
			subtitleLabel.Text = string.format(
				"Voting is locked. Next match is forced to %s.",
				getModeDisplayName(forcedVoteMode)
			)
		else
			subtitleLabel.Text = "Vote for the next match mode"
		end
	end
end

local function createGui()
	if gui and gui.Parent then
		return
	end

	local playerGui = player:FindFirstChild("PlayerGui")
	if not playerGui then
		return
	end

	gui = Instance.new("ScreenGui")
	gui.Name = "ModeVoteGui"
	gui.DisplayOrder = VOTE_DISPLAY_ORDER
	gui.IgnoreGuiInset = true
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Global
	gui.Enabled = false
	gui.Parent = playerGui
	setGuiPreferredEnabled(false)

	panelFrame = Instance.new("Frame")
	panelFrame.Name = "VotePanel"
	panelFrame.AnchorPoint = Vector2.new(0.5, 0.5)
	panelFrame.Position = UDim2.fromScale(0.5, 0.42)
	panelFrame.Size = UDim2.fromOffset(580, 220)
	panelFrame.BackgroundColor3 = PANEL_BG
	panelFrame.BackgroundTransparency = 0.04
	panelFrame.BorderSizePixel = 0
	panelFrame.Visible = false
	panelFrame.ZIndex = 2
	panelFrame.ClipsDescendants = true
	panelFrame.Parent = gui

	Instance.new("UICorner", panelFrame).CornerRadius = UDim.new(0, 16)

	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(60, 65, 85)
	stroke.Thickness = 2
	stroke.Transparency = 0.3
	stroke.Parent = panelFrame

	local studTex = Instance.new("ImageLabel")
	studTex.Name = "StudTexture"
	studTex.Size = UDim2.fromScale(1, 1)
	studTex.Position = UDim2.fromScale(0, 0)
	studTex.BackgroundTransparency = 1
	studTex.Image = "rbxassetid://84772207963553"
	studTex.ScaleType = Enum.ScaleType.Tile
	studTex.TileSize = UDim2.fromOffset(96, 96)
	studTex.ImageTransparency = 0.88
	studTex.ImageColor3 = Color3.fromRGB(255, 255, 255)
	studTex.ZIndex = 2
	studTex.Parent = panelFrame
	Instance.new("UICorner", studTex).CornerRadius = UDim.new(0, 16)

	local closeBtn = Instance.new("TextButton")
	closeBtn.Name = "CloseBtn"
	closeBtn.AnchorPoint = Vector2.new(1, 0)
	closeBtn.Position = UDim2.new(1, -6, 0, 6)
	closeBtn.Size = UDim2.fromOffset(30, 30)
	closeBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
	closeBtn.BackgroundTransparency = 0.1
	closeBtn.BorderSizePixel = 0
	closeBtn.Font = Enum.Font.GothamBold
	closeBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
	closeBtn.TextSize = 18
	closeBtn.Text = "X"
	closeBtn.AutoButtonColor = true
	closeBtn.ZIndex = 10
	closeBtn.Parent = panelFrame

	Instance.new("UICorner", closeBtn).CornerRadius = UDim.new(0, 8)

	local closeBtnStroke = Instance.new("UIStroke")
	closeBtnStroke.Color = Color3.fromRGB(120, 30, 30)
	closeBtnStroke.Thickness = 1.5
	closeBtnStroke.Parent = closeBtn

	closeBtn.MouseButton1Click:Connect(function()
		if panelFrame then
			AnimUtil.PopupClose(panelFrame)
		end
		task.delay(0.25, function()
			if panelFrame then
				panelFrame.Visible = false
			end
			if reopenBtn then
				reopenBtn.Visible = voteWindowOpen
			end
		end)
		print("[ModeVote] Closed by player")
	end)

	titleLabel = Instance.new("TextLabel")
	titleLabel.Name = "Title"
	titleLabel.AnchorPoint = Vector2.new(0.5, 0)
	titleLabel.Position = UDim2.new(0.5, 0, 0, 14)
	titleLabel.Size = UDim2.new(1, -20, 0, 30)
	titleLabel.BackgroundTransparency = 1
	titleLabel.Font = Enum.Font.GothamBold
	titleLabel.TextColor3 = HEADER_COLOR
	titleLabel.TextSize = 22
	titleLabel.Text = "CHOOSE NEXT MODE"
	titleLabel.ZIndex = 3
	titleLabel.Parent = panelFrame

	local titleStroke = Instance.new("UIStroke")
	titleStroke.Color = Color3.fromRGB(0, 0, 0)
	titleStroke.Thickness = 2
	titleStroke.Parent = titleLabel

	subtitleLabel = Instance.new("TextLabel")
	subtitleLabel.Name = "Subtitle"
	subtitleLabel.AnchorPoint = Vector2.new(0.5, 0)
	subtitleLabel.Position = UDim2.new(0.5, 0, 0, 44)
	subtitleLabel.Size = UDim2.new(1, -20, 0, 18)
	subtitleLabel.BackgroundTransparency = 1
	subtitleLabel.Font = Enum.Font.GothamSemibold
	subtitleLabel.TextColor3 = Color3.fromRGB(180, 185, 200)
	subtitleLabel.TextSize = 13
	subtitleLabel.Text = "Vote for the next match mode"
	subtitleLabel.ZIndex = 3
	subtitleLabel.Parent = panelFrame

	local btnContainer = Instance.new("Frame")
	btnContainer.Name = "Buttons"
	btnContainer.AnchorPoint = Vector2.new(0.5, 0)
	btnContainer.Position = UDim2.new(0.5, 0, 0, 72)
	btnContainer.Size = UDim2.new(1, -32, 0, 130)
	btnContainer.BackgroundTransparency = 1
	btnContainer.ZIndex = 3
	btnContainer.Parent = panelFrame

	local listLayout = Instance.new("UIListLayout")
	listLayout.FillDirection = Enum.FillDirection.Horizontal
	listLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	listLayout.VerticalAlignment = Enum.VerticalAlignment.Center
	listLayout.Padding = UDim.new(0, 16)
	listLayout.Parent = btnContainer

	local function createVoteButton(
		buttonName: string,
		label: string,
		imageId: string,
		bgColor: Color3,
		layoutOrder: number,
		locked: boolean
	)
		local btn = Instance.new("TextButton")
		btn.Name = buttonName
		btn.Size = UDim2.fromOffset(170, 120)
		btn.BackgroundColor3 = bgColor
		btn.BackgroundTransparency = locked and 0.2 or 0.08
		btn.BorderSizePixel = 0
		btn.Text = ""
		btn.AutoButtonColor = not locked
		btn.Active = not locked
		btn.LayoutOrder = layoutOrder
		btn.ClipsDescendants = true
		btn.ZIndex = 4
		btn.Parent = btnContainer

		Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 12)

		local btnStroke = Instance.new("UIStroke")
		btnStroke.Name = "SelectStroke"
		btnStroke.Color = BTN_UNSELECTED_STROKE
		btnStroke.Thickness = 2.5
		btnStroke.Transparency = 0.3
		btnStroke.Parent = btn

		if imageId ~= "" then
			local bgImage = Instance.new("ImageLabel")
			bgImage.Name = "BackgroundImage"
			bgImage.Position = UDim2.fromScale(0, 0)
			bgImage.Size = UDim2.fromScale(1, 1)
			bgImage.BackgroundTransparency = 1
			bgImage.Image = imageId
			bgImage.ScaleType = Enum.ScaleType.Crop
			if locked then
				bgImage.ImageColor3 = Color3.fromRGB(125, 125, 125)
			end
			bgImage.ZIndex = 5
			bgImage.Parent = btn
		end

		local darkOverlay = Instance.new("Frame")
		darkOverlay.Name = "DarkOverlay"
		darkOverlay.Position = UDim2.fromScale(0, 0)
		darkOverlay.Size = UDim2.fromScale(1, 1)
		darkOverlay.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
		darkOverlay.BackgroundTransparency = locked and 0.25 or 0.5
		darkOverlay.BorderSizePixel = 0
		darkOverlay.ZIndex = 6
		darkOverlay.Parent = btn

		local lblText = Instance.new("TextLabel")
		lblText.Name = "Label"
		lblText.AnchorPoint = Vector2.new(0.5, 0.5)
		lblText.Position = UDim2.fromScale(0.5, 0.42)
		lblText.Size = UDim2.new(1, -12, 0, 28)
		lblText.BackgroundTransparency = 1
		lblText.Font = Enum.Font.GothamBold
		lblText.TextColor3 = TEXT_COLOR
		lblText.TextSize = 15
		lblText.Text = label
		lblText.TextWrapped = true
		lblText.ZIndex = 7
		lblText.Parent = btn

		local lblStroke = Instance.new("UIStroke")
		lblStroke.Color = Color3.fromRGB(0, 0, 0)
		lblStroke.Thickness = 2
		lblStroke.Parent = lblText

		local countLbl = Instance.new("TextLabel")
		countLbl.Name = "Count"
		countLbl.AnchorPoint = Vector2.new(0.5, 1)
		countLbl.Position = UDim2.new(0.5, 0, 1, -10)
		countLbl.Size = UDim2.new(1, -12, 0, 22)
		countLbl.BackgroundTransparency = 1
		countLbl.Font = Enum.Font.GothamSemibold
		countLbl.TextColor3 = Color3.fromRGB(220, 225, 240)
		countLbl.TextSize = 16
		countLbl.Text = locked and "" or "0 votes"
		countLbl.ZIndex = 7
		countLbl.Parent = btn

		local countStroke = Instance.new("UIStroke")
		countStroke.Color = Color3.fromRGB(0, 0, 0)
		countStroke.Thickness = 1.5
		countStroke.Parent = countLbl

		if not locked then
			btn.MouseEnter:Connect(function()
				if currentVoteLocked then
					return
				end
				TweenService:Create(darkOverlay, TweenInfo.new(0.15), { BackgroundTransparency = 0.65 }):Play()
			end)
			btn.MouseLeave:Connect(function()
				if currentVoteLocked then
					return
				end
				TweenService:Create(darkOverlay, TweenInfo.new(0.15), { BackgroundTransparency = 0.5 }):Play()
			end)
		else
			local lockLbl = Instance.new("TextLabel")
			lockLbl.Name = "LockLabel"
			lockLbl.AnchorPoint = Vector2.new(0.5, 0.5)
			lockLbl.Position = UDim2.fromScale(0.5, 0.66)
			lockLbl.Size = UDim2.new(1, -12, 0, 20)
			lockLbl.BackgroundTransparency = 1
			lockLbl.Font = Enum.Font.GothamBold
			lockLbl.TextColor3 = Color3.fromRGB(230, 230, 230)
			lockLbl.TextSize = 16
			lockLbl.Text = "LOCKED"
			lockLbl.ZIndex = 7
			lockLbl.Parent = btn

			local soonLbl = Instance.new("TextLabel")
			soonLbl.Name = "ComingSoonLabel"
			soonLbl.AnchorPoint = Vector2.new(0.5, 0.5)
			soonLbl.Position = UDim2.fromScale(0.5, 0.82)
			soonLbl.Size = UDim2.new(1, -12, 0, 18)
			soonLbl.BackgroundTransparency = 1
			soonLbl.Font = Enum.Font.GothamBold
			soonLbl.TextColor3 = Color3.fromRGB(215, 215, 220)
			soonLbl.TextSize = 12
			soonLbl.Text = "coming soon"
			soonLbl.ZIndex = 7
			soonLbl.Parent = btn
		end

		return btn, countLbl
	end

	brainrotBtn, brainrotCountLbl = createVoteButton("BrainrotBtn", "Save the Brainrot", BRAINROT_MODE_IMAGE, BTN_BRAINROT_COLOR, 1, false)
	normalBtn, normalCountLbl = createVoteButton("NormalBtn", "Normal Mode", NORMAL_MODE_IMAGE, BTN_NORMAL_COLOR, 2, false)
	disasterBtn = createVoteButton("DisasterBtn", "Disaster Mode", "", BTN_LOCKED_COLOR, 3, true)
	print("[ModeVote] Added locked placeholder: Disaster Mode (disabled)")

	normalBtn.MouseButton1Click:Connect(function()
		if currentVoteLocked then
			return
		end
		if currentVote == "Normal" then
			return
		end
		currentVote = "Normal"
		updateSelection()
		if voteRemote then
			voteRemote:FireServer("Cast", "Normal")
		end
	end)

	brainrotBtn.MouseButton1Click:Connect(function()
		if currentVoteLocked then
			return
		end
		if currentVote == "Brainrot" then
			return
		end
		currentVote = "Brainrot"
		updateSelection()
		if voteRemote then
			voteRemote:FireServer("Cast", "Brainrot")
		end
	end)

	reopenBtn = Instance.new("TextButton")
	reopenBtn.Name = "ReopenVoteBtn"
	reopenBtn.AnchorPoint = Vector2.new(1, 0)
	reopenBtn.Position = UDim2.new(1, -16, 0, 8)
	reopenBtn.Size = UDim2.fromOffset(100, 36)
	reopenBtn.BackgroundColor3 = Color3.fromRGB(50, 160, 80)
	reopenBtn.BackgroundTransparency = 0.1
	reopenBtn.BorderSizePixel = 0
	reopenBtn.Font = Enum.Font.GothamBold
	reopenBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
	reopenBtn.TextSize = 14
	reopenBtn.Text = "Vote"
	reopenBtn.AutoButtonColor = true
	reopenBtn.Visible = false
	reopenBtn.ZIndex = 6
	reopenBtn.Parent = gui

	Instance.new("UICorner", reopenBtn).CornerRadius = UDim.new(0, 18)

	local reopenStroke = Instance.new("UIStroke")
	reopenStroke.Color = Color3.fromRGB(30, 100, 50)
	reopenStroke.Thickness = 1.5
	reopenStroke.Parent = reopenBtn

	local reopenTextStroke = Instance.new("UIStroke")
	reopenTextStroke.Color = Color3.fromRGB(0, 0, 0)
	reopenTextStroke.Thickness = 1.5
	reopenTextStroke.Transparency = 0.2
	reopenTextStroke.Parent = reopenBtn

	reopenBtn.MouseButton1Click:Connect(function()
		if isTutorialBlocked() then
			print("[ModeVote] Reopen blocked -- tutorial incomplete")
			return
		end
		if panelFrame and voteWindowOpen then
			panelFrame.BackgroundTransparency = 0.04
			panelFrame.Visible = true
			reopenBtn.Visible = false
			AnimUtil.PopupOpen(panelFrame)
			print("[ModeVote] Reopened by player")
		end
	end)
end

updateSelection = function()
	if not normalBtn or not brainrotBtn then
		return
	end

	local function applyChoiceState(btn: TextButton?, countLbl: TextLabel?, modeName: string)
		if not btn then
			return
		end

		local isForced = currentVoteLocked and forcedVoteMode == modeName
		local isSelected = (not currentVoteLocked) and currentVote == modeName
		local isHighlighted = isForced or isSelected

		local stroke = btn:FindFirstChild("SelectStroke")
		local bgImage = btn:FindFirstChild("BackgroundImage")
		local darkOverlay = btn:FindFirstChild("DarkOverlay")

		btn.Active = not currentVoteLocked
		btn.AutoButtonColor = not currentVoteLocked
		btn.BackgroundTransparency = currentVoteLocked and 0.18 or 0.08

		if stroke and stroke:IsA("UIStroke") then
			stroke.Color = isHighlighted and BTN_SELECTED_STROKE or BTN_UNSELECTED_STROKE
			stroke.Thickness = isHighlighted and 3 or 2.5
			stroke.Transparency = isHighlighted and 0 or 0.3
		end

		if bgImage and bgImage:IsA("ImageLabel") then
			bgImage.ImageColor3 = currentVoteLocked
				and (isForced and Color3.fromRGB(230, 230, 230) or Color3.fromRGB(125, 125, 125))
				or Color3.fromRGB(255, 255, 255)
		end

		if darkOverlay and darkOverlay:IsA("Frame") then
			darkOverlay.BackgroundTransparency = currentVoteLocked
				and (isForced and 0.34 or 0.18)
				or 0.5
		end

		if countLbl then
			if currentVoteLocked then
				countLbl.Text = isForced and "FORCED NEXT" or "LOCKED"
				countLbl.TextColor3 = isForced and Color3.fromRGB(255, 240, 185) or Color3.fromRGB(220, 225, 240)
			else
				countLbl.TextColor3 = Color3.fromRGB(220, 225, 240)
			end
		end
	end

	applyChoiceState(normalBtn, normalCountLbl, "Normal")
	applyChoiceState(brainrotBtn, brainrotCountLbl, "Brainrot")
end

local function showPanel(data)
	if isPlayerAFK() then
		print("[ModeVote] Skipping show -- player is AFK")
		return
	end
	if isTutorialBlocked() then
		print("[ModeVote] Skipping show -- tutorial incomplete")
		return
	end

	if not gui then
		createGui()
	end
	if not gui or not panelFrame then
		return
	end

	if voteWindowOpen then
		setVoteLockState(data and data.locked == true, data and data.forcedMode or nil)
		updateSelection()
		print("[ModeVote] Show ignored -- already open")
		return
	end

	currentVote = nil
	voteWindowOpen = true
	setVoteLockState(data and data.locked == true, data and data.forcedMode or nil)
	updateSelection()

	if not currentVoteLocked then
		if normalCountLbl then
			normalCountLbl.Text = "0 votes"
		end
		if brainrotCountLbl then
			brainrotCountLbl.Text = "0 votes"
		end
	end

	gui.Enabled = true
	setGuiPreferredEnabled(true)
	panelFrame.BackgroundTransparency = 0.04
	panelFrame.Visible = true
	if reopenBtn then
		reopenBtn.Visible = false
	end

	AnimUtil.PopupOpen(panelFrame)

	print(string.format(
		"[ModeVote] Showing UI displayOrder=%d enabled=%s visible=%s locked=%s forcedMode=%s",
		gui.DisplayOrder,
		tostring(gui.Enabled),
		tostring(panelFrame.Visible),
		tostring(currentVoteLocked),
		tostring(forcedVoteMode)
	))
end

local function hidePanel()
	voteWindowOpen = false
	if not gui then
		return
	end

	setGuiPreferredEnabled(false)

	if panelFrame then
		AnimUtil.PopupClose(panelFrame)
	end

	task.delay(0.25, function()
		if gui then
			gui.Enabled = false
		end
		if panelFrame then
			panelFrame.Visible = false
		end
		if reopenBtn then
			reopenBtn.Visible = false
		end
		setVoteLockState(false, nil)
	end)

	print("[ModeVote] Hidden")
end

local function updateCounts(data)
	if not data then
		return
	end

	if currentVoteLocked then
		updateSelection()
		return
	end

	local normal = data.normal or 0
	local brainrot = data.brainrot or 0

	if normalCountLbl then
		normalCountLbl.Text = normal == 1 and "1 vote" or (normal .. " votes")
	end
	if brainrotCountLbl then
		brainrotCountLbl.Text = brainrot == 1 and "1 vote" or (brainrot .. " votes")
	end
end

local function handleVoteEvent(action, data)
	print("[ModeVote] Received:", action)
	if action == "Start" then
		showPanel(data)
	elseif action == "Update" then
		updateCounts(data)
	elseif action == "End" then
		updateCounts(data)
		hidePanel()
	end
end

local function drainQueue()
	if #eventQueue == 0 then
		return
	end
	print(string.format("[ModeVote] Draining %d queued events", #eventQueue))
	for _, entry in ipairs(eventQueue) do
		handleVoteEvent(entry.action, entry.data)
	end
	table.clear(eventQueue)
end

function ModeVotePanel.Init()
	if initialized then
		return
	end
	initialized = true

	print("[ModeVote] Init starting...")
	createGui()

	task.spawn(function()
		local remotes = ReplicatedStorage:WaitForChild("Remotes", 15)
		if not remotes then
			warn("[ModeVote] Remotes folder not found")
			return
		end

		voteRemote = remotes:WaitForChild("ModeVote", 15)
		if not voteRemote then
			warn("[ModeVote] ModeVote remote not found")
			return
		end

		voteRemote.OnClientEvent:Connect(function(action, data)
			if panelReady then
				handleVoteEvent(action, data)
			else
				table.insert(eventQueue, { action = action, data = data })
				print("[ModeVote] Queued event (panel not ready):", action)
			end
		end)

		print("[ModeVote] Connected to ModeVote remote")

		panelReady = true
		drainQueue()
		print("[ModeVote] Panel ready")

		local matchStatus = ReplicatedStorage:WaitForChild("MatchStatus", 10)
		if not matchStatus then
			warn("[ModeVote] MatchStatus folder not found - replicated catch-up disabled")
			return
		end

		local voteActiveVal = matchStatus:WaitForChild("ModeVoteActive", 5)
		local lockedVal = matchStatus:WaitForChild("ModeVoteLocked", 5)
		local lockedModeVal = matchStatus:WaitForChild("ModeVoteLockedMode", 5)

		if voteActiveVal and voteActiveVal:IsA("BoolValue") then
			voteActiveValue = voteActiveVal
		end

		if lockedVal and lockedVal:IsA("BoolValue") then
			voteLockedValue = lockedVal
		end
		if lockedModeVal and lockedModeVal:IsA("StringValue") then
			voteLockedModeValue = lockedModeVal
		end

		if voteActiveVal then
			if voteActiveVal.Value == true and not voteWindowOpen then
				print("[ModeVote] Replicated active detected on init - showing UI")
				showPanel(getReplicatedVotePayload())
			end

			voteActiveVal.Changed:Connect(function(newVal)
				print("[ModeVote] ModeVoteActive changed to:", tostring(newVal))
				if newVal == true and not voteWindowOpen then
					print("[ModeVote] Replicated active detected - showing UI")
					showPanel(getReplicatedVotePayload())
				elseif newVal == false and voteWindowOpen then
					print("[ModeVote] Replicated inactive detected - force hiding UI")
					hidePanel()
				end
			end)

			print("[ModeVote] Watching MatchStatus.ModeVoteActive for changes")
		else
			warn("[ModeVote] ModeVoteActive value not found in MatchStatus")
		end

		if voteLockedValue then
			voteLockedValue.Changed:Connect(function(newVal)
				setVoteLockState(newVal == true, voteLockedModeValue and voteLockedModeValue.Value or nil)
				updateSelection()
			end)
		end

		if voteLockedModeValue then
			voteLockedModeValue.Changed:Connect(function(newVal)
				if currentVoteLocked or (voteLockedValue and voteLockedValue.Value == true) then
					setVoteLockState(true, newVal)
					updateSelection()
				end
			end)
		end

		local stateVal = matchStatus:WaitForChild("State", 5)
		if stateVal and stateVal:IsA("StringValue") then
			matchStateValue = stateVal
			stateVal.Changed:Connect(function(newVal)
				print("[ModeVote] MatchStatus.State changed to:", tostring(newVal))
				if newVal ~= "Intermission" and voteWindowOpen then
					print("[ModeVote] Match state left intermission - force hiding UI")
					hidePanel()
				end
			end)
		end

		player:GetAttributeChangedSignal("TutorialCompleted"):Connect(function()
			local completed = player:GetAttribute("TutorialCompleted") == true
			print("[ModeVote] TutorialCompleted changed to:", tostring(completed))
			if not completed and voteWindowOpen then
				hidePanel()
				return
			end
			if completed and voteActiveValue and voteActiveValue.Value == true and not voteWindowOpen then
				showPanel(getReplicatedVotePayload())
			end
		end)

		player:GetAttributeChangedSignal("PlayerState"):Connect(function()
			local state = tostring(player:GetAttribute("PlayerState"))
			print("[ModeVote] PlayerState changed to:", state)
			if isTutorialBlocked() then
				if voteWindowOpen then
					hidePanel()
				end
				return
			end
			if voteActiveValue and voteActiveValue.Value == true and not voteWindowOpen then
				showPanel(getReplicatedVotePayload())
			end
		end)
	end)

	print("[ModeVote] Initialized")
end

return ModeVotePanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="159">
            <Properties>
              <string name="Name">NpcDialoguePanel</string>
              <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared", 60)
if not Shared then
	warn("[NpcDialoguePanel] Shared not found")
	return {
		Init = function() end,
		Show = function() end,
		Hide = function() end,
		IsVisible = function() return false end,
		Toggle = function() end,
		SetDialogue = function() end,
		SetResponseHandlers = function() end,
	}
end

local UIConfig = require(Shared:WaitForChild("UIConfig"))

local Client = script.Parent
local AnimUtil = require(Client:WaitForChild("AnimUtil"))
local SoundUtil = require(Client:WaitForChild("SoundUtil"))
local Components = require(Client:WaitForChild("Components"))

local C = UIConfig.Colors

local NpcDialoguePanel = {}

local HEADER_COLOR = Color3.fromRGB(76, 182, 255)
local CARD_BG = Color3.fromRGB(14, 18, 42)
local CARD_BG_ALT = Color3.fromRGB(20, 28, 58)
local CARD_STROKE = Color3.fromRGB(122, 212, 255)
local MESSAGE_TEXT = Color3.fromRGB(240, 246, 255)
local MUTED_TEXT = Color3.fromRGB(170, 194, 228)
local YES_COLOR = Color3.fromRGB(44, 205, 114)
local NO_COLOR = Color3.fromRGB(78, 94, 138)

local canvas: CanvasGroup? = nil
local uiScale: UIScale? = nil
local overlay: TextButton? = nil
local visible = false
local closeCallback: (() -> ())? = nil
local responseHandlers = {
	onYes = nil :: ((any) -> ())?,
	onNo = nil :: ((any) -> ())?,
}
local activeDialogue = {
		title = "NPC DIALOGUE",
		speaker = "NPC",
		message = "Choose an option.",
		acceptText = "Yes",
		declineText = "No",
		nextPanel = "EmoteShop",
	}
local responseLocked = false

local titleLabel: TextLabel? = nil
local speakerLabel: TextLabel? = nil
local messageLabel: TextLabel? = nil
local yesButton: TextButton? = nil
local noButton: TextButton? = nil

local function applyDialogue(dialogueData)
	activeDialogue = dialogueData or activeDialogue

	if titleLabel then
		titleLabel.Text = tostring(activeDialogue.title or "NPC DIALOGUE")
	end
	if speakerLabel then
		speakerLabel.Text = tostring(activeDialogue.speaker or "NPC")
	end
	if messageLabel then
		messageLabel.Text = tostring(activeDialogue.message or "Choose an option.")
	end
	if yesButton then
		yesButton.Text = tostring(activeDialogue.acceptText or "Yes")
	end
	if noButton then
		noButton.Text = tostring(activeDialogue.declineText or "No")
	end
end

local function handleResponse(kind: "Yes" | "No")
	if responseLocked or not visible then
		return
	end
	responseLocked = true

	local handler = if kind == "Yes" then responseHandlers.onYes else responseHandlers.onNo
	if handler then
		handler(activeDialogue)
	else
		NpcDialoguePanel.Hide()
	end

	task.delay(0.2, function()
		responseLocked = false
	end)
end

function NpcDialoguePanel.SetDialogue(dialogueData)
	applyDialogue(dialogueData)
end

function NpcDialoguePanel.SetResponseHandlers(handlers)
	if typeof(handlers) ~= "table" then
		return
	end

	responseHandlers.onYes = handlers.onYes
	responseHandlers.onNo = handlers.onNo
end

function NpcDialoguePanel.Init(screenGui: ScreenGui, onClose: () -> ())
	closeCallback = onClose

	overlay = Components.CreateDimOverlay(screenGui, function()
		NpcDialoguePanel.Hide()
	end)

	local content: ScrollingFrame
	local closeBtn: TextButton
	canvas, uiScale, content, closeBtn = Components.CreatePanel(screenGui, "NPC DIALOGUE", HEADER_COLOR, "Spectate")
	canvas.Size = UDim2.fromScale(0.42, 0.36)
	content.Size = UDim2.new(1, -24, 1, -86)
	content.Position = UDim2.new(0, 12, 0, 68)
	content.AutomaticCanvasSize = Enum.AutomaticSize.None
	content.ScrollingEnabled = false
	content.CanvasSize = UDim2.fromScale(0, 0)
	content.ScrollBarThickness = 0

	AnimUtil.WireButton(closeBtn, function()
		NpcDialoguePanel.Hide()
	end)

	local header = canvas:FindFirstChild("Header")
	if header and header:IsA("Frame") then
		local maybeTitle = header:FindFirstChild("Title")
		if maybeTitle and maybeTitle:IsA("TextLabel") then
			titleLabel = maybeTitle
		end
	end

	local body = Instance.new("Frame")
	body.Name = "Body"
	body.AnchorPoint = Vector2.new(0.5, 0)
	body.Position = UDim2.new(0.5, 0, 0, 4)
	body.Size = UDim2.new(1, 0, 1, -4)
	body.BackgroundTransparency = 1
	body.BorderSizePixel = 0
	body.Parent = content

	local bodyLayout = Instance.new("UIListLayout")
	bodyLayout.FillDirection = Enum.FillDirection.Vertical
	bodyLayout.Padding = UDim.new(0, 12)
	bodyLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	bodyLayout.VerticalAlignment = Enum.VerticalAlignment.Top
	bodyLayout.Parent = body

	local speechCard = Instance.new("Frame")
	speechCard.Name = "SpeechCard"
	speechCard.Size = UDim2.new(1, -10, 0, 126)
	speechCard.BackgroundColor3 = CARD_BG
	speechCard.BorderSizePixel = 0
	speechCard.LayoutOrder = 1
	speechCard.Parent = body
	Instance.new("UICorner", speechCard).CornerRadius = UDim.new(0, 12)

	local speechStroke = Instance.new("UIStroke")
	speechStroke.Color = CARD_STROKE
	speechStroke.Thickness = 2
	speechStroke.Transparency = 0.18
	speechStroke.Parent = speechCard

	local speechGrad = Instance.new("UIGradient")
	speechGrad.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, CARD_BG_ALT),
		ColorSequenceKeypoint.new(1, CARD_BG),
	})
	speechGrad.Rotation = 90
	speechGrad.Parent = speechCard

	local promptLabel = Instance.new("TextLabel")
	promptLabel.Name = "PromptLabel"
	promptLabel.AnchorPoint = Vector2.new(0.5, 0)
	promptLabel.Position = UDim2.new(0.5, 0, 0, 16)
	promptLabel.Size = UDim2.new(1, -24, 0, 18)
	promptLabel.BackgroundTransparency = 1
	promptLabel.Font = Enum.Font.GothamBold
	promptLabel.Text = "NPC"
	promptLabel.TextColor3 = CARD_STROKE
	promptLabel.TextSize = 13
	promptLabel.ZIndex = 7
	promptLabel.Parent = speechCard

	speakerLabel = Instance.new("TextLabel")
	speakerLabel.Name = "SpeakerLabel"
	speakerLabel.AnchorPoint = Vector2.new(0.5, 0)
	speakerLabel.Position = UDim2.new(0.5, 0, 0, 38)
	speakerLabel.Size = UDim2.new(1, -24, 0, 24)
	speakerLabel.BackgroundTransparency = 1
	speakerLabel.Font = Enum.Font.GothamBlack
	speakerLabel.Text = ""
	speakerLabel.TextColor3 = C.TextWhite
	speakerLabel.TextSize = 22
	speakerLabel.ZIndex = 7
	speakerLabel.Parent = speechCard

	local speakerStroke = Instance.new("UIStroke")
	speakerStroke.Color = Color3.new(0, 0, 0)
	speakerStroke.Thickness = 1.3
	speakerStroke.Transparency = 0.2
	speakerStroke.Parent = speakerLabel

	messageLabel = Instance.new("TextLabel")
	messageLabel.Name = "MessageLabel"
	messageLabel.AnchorPoint = Vector2.new(0.5, 0)
	messageLabel.Position = UDim2.new(0.5, 0, 0, 68)
	messageLabel.Size = UDim2.new(1, -30, 0, 42)
	messageLabel.BackgroundTransparency = 1
	messageLabel.Font = Enum.Font.GothamSemibold
	messageLabel.Text = ""
	messageLabel.TextWrapped = true
	messageLabel.TextColor3 = MESSAGE_TEXT
	messageLabel.TextSize = 17
	messageLabel.ZIndex = 7
	messageLabel.Parent = speechCard

	local buttonRow = Instance.new("Frame")
	buttonRow.Name = "ButtonRow"
	buttonRow.Size = UDim2.new(1, -10, 0, 54)
	buttonRow.BackgroundTransparency = 1
	buttonRow.BorderSizePixel = 0
	buttonRow.LayoutOrder = 2
	buttonRow.Parent = body

	local buttonLayout = Instance.new("UIListLayout")
	buttonLayout.FillDirection = Enum.FillDirection.Horizontal
	buttonLayout.Padding = UDim.new(0, 10)
	buttonLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	buttonLayout.VerticalAlignment = Enum.VerticalAlignment.Center
	buttonLayout.Parent = buttonRow

	noButton = Instance.new("TextButton")
	noButton.Name = "NoButton"
	noButton.Size = UDim2.fromOffset(124, 46)
	noButton.BackgroundColor3 = NO_COLOR
	noButton.BorderSizePixel = 0
	noButton.Font = Enum.Font.GothamBold
	noButton.TextColor3 = C.TextWhite
	noButton.TextSize = 18
	noButton.LayoutOrder = 1
	noButton.Parent = buttonRow
	Instance.new("UICorner", noButton).CornerRadius = UDim.new(0, 10)

	yesButton = Instance.new("TextButton")
	yesButton.Name = "YesButton"
	yesButton.Size = UDim2.fromOffset(124, 46)
	yesButton.BackgroundColor3 = YES_COLOR
	yesButton.BorderSizePixel = 0
	yesButton.Font = Enum.Font.GothamBold
	yesButton.TextColor3 = C.TextWhite
	yesButton.TextSize = 18
	yesButton.LayoutOrder = 2
	yesButton.Parent = buttonRow
	Instance.new("UICorner", yesButton).CornerRadius = UDim.new(0, 10)

	local hintLabel = Instance.new("TextLabel")
	hintLabel.Name = "HintLabel"
	hintLabel.Size = UDim2.new(1, -10, 0, 18)
	hintLabel.BackgroundTransparency = 1
	hintLabel.Font = Enum.Font.GothamMedium
	hintLabel.Text = "Choose an option to continue."
	hintLabel.TextColor3 = MUTED_TEXT
	hintLabel.TextSize = 13
	hintLabel.LayoutOrder = 3
	hintLabel.Parent = body

	AnimUtil.WireButton(noButton, function()
		handleResponse("No")
	end)
	AnimUtil.WireButton(yesButton, function()
		handleResponse("Yes")
	end)

	applyDialogue(activeDialogue)
end

function NpcDialoguePanel.Show(dialogueData)
	if not canvas or not uiScale or not overlay then
		return
	end
	if dialogueData then
		applyDialogue(dialogueData)
	end
	if visible then
		return
	end

	responseLocked = false
	visible = true
	overlay.Visible = true
	SoundUtil.Open()
	AnimUtil.OpenPanel(canvas, uiScale)
end

function NpcDialoguePanel.Hide()
	if not canvas or not uiScale or not overlay or not visible then
		return
	end

	visible = false
	responseLocked = false
	overlay.Visible = false
	local tween = AnimUtil.ClosePanel(canvas, uiScale)
	task.spawn(function()
		tween.Completed:Wait()
		if canvas then
			canvas.Visible = false
		end
	end)

	if closeCallback then
		closeCallback()
	end
end

function NpcDialoguePanel.IsVisible(): boolean
	return visible
end

function NpcDialoguePanel.Toggle()
	if visible then
		NpcDialoguePanel.Hide()
	else
		NpcDialoguePanel.Show()
	end
end

return NpcDialoguePanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="160">
            <Properties>
              <string name="Name">PerkShopPanel</string>
              <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared", 60)
if not Shared then
	warn("[AbilityShopPanel] Shared not found")
	return {
		Init = function() end,
		Show = function() end,
		Hide = function() end,
		IsVisible = function() return false end,
		Toggle = function() end,
	}
end

local UIConfig = require(Shared:WaitForChild("UIConfig"))
local PerkCatalog = require(Shared:WaitForChild("PerkCatalog"))

local Client = script.Parent
local AnimUtil = require(Client:WaitForChild("AnimUtil"))
local SoundUtil = require(Client:WaitForChild("SoundUtil"))
local Components = require(Client:WaitForChild("Components"))

local LocalPlayer = Players.LocalPlayer

local AbilityShopPanel = {}

local HEADER_COLOR = Color3.fromRGB(25, 118, 67)
local PANEL_BG = Color3.fromRGB(9, 14, 11)
local PANEL_HEADER_BG = Color3.fromRGB(16, 70, 43)
local PANEL_STROKE = Color3.fromRGB(62, 162, 108)
local PANEL_STUD = Color3.fromRGB(122, 194, 153)
local CARD_BG = Color3.fromRGB(14, 20, 16)
local CARD_BG_ALT = Color3.fromRGB(22, 34, 27)
local CARD_STROKE = Color3.fromRGB(72, 155, 110)
local CARD_ACCENT = Color3.fromRGB(98, 214, 143)
local BUTTON_BG = Color3.fromRGB(30, 122, 73)
local BUTTON_BG_DISABLED = Color3.fromRGB(43, 58, 49)
local TEXT_PRIMARY = Color3.fromRGB(244, 250, 246)
local TEXT_MUTED = Color3.fromRGB(166, 190, 175)
local BADGE_BG = Color3.fromRGB(16, 48, 31)
local ROBUX_ICON_IMAGE = "rbxassetid://138917867019056"

local STATUS_NONE = "None"
local STATUS_QUEUED = "Queued"
local STATUS_ACTIVE = "Active"

local canvas: CanvasGroup? = nil
local uiScale: UIScale? = nil
local overlay: TextButton? = nil
local visible = false
local closeCallback: (() -> ())? = nil
local requestRemote: RemoteEvent? = nil
local requestRemoteLogged = false

local actionButtons: { [string]: TextButton } = {}
local statusLabels: { [string]: TextLabel } = {}
local cardsGridLayout: UIGridLayout? = nil
local lastRenderedStatusByAbility: { [string]: string } = {}

local function getRequestRemote(): RemoteEvent?
	if requestRemote and requestRemote.Parent then
		return requestRemote
	end

	local remotes = ReplicatedStorage:FindFirstChild("Remotes") or ReplicatedStorage:WaitForChild("Remotes", 5)
	if not remotes then
		return nil
	end

	local remote = remotes:FindFirstChild("PerkProductPromptRequest") or remotes:WaitForChild("PerkProductPromptRequest", 5)
	if remote and remote:IsA("RemoteEvent") then
		requestRemote = remote
		if not requestRemoteLogged then
			requestRemoteLogged = true
			print(string.format("[AbilityShopPanel] Purchase remote ready: %s", remote:GetFullName()))
		end
	elseif remote then
		warn(string.format("[AbilityShopPanel] PerkProductPromptRequest has wrong class: %s", remote.ClassName))
	end

	return requestRemote
end

local function getReplicatedMatchState(): string
	local matchStatus = ReplicatedStorage:FindFirstChild("MatchStatus")
	if not matchStatus then
		return ""
	end
	local stateValue = matchStatus:FindFirstChild("State")
	if stateValue and stateValue:IsA("StringValue") then
		return stateValue.Value
	end
	return ""
end

local function getAbilityStatus(abilityId: string): string
	local ability = PerkCatalog.Get(abilityId)
	if not ability then
		return STATUS_NONE
	end

	local value = LocalPlayer:GetAttribute(ability.statusAttribute)
	local playerState = tostring(LocalPlayer:GetAttribute("PlayerState") or "")
	local roundRunning = getReplicatedMatchState() == "Playing"
	if value == STATUS_ACTIVE and (playerState ~= "InMatch" or not roundRunning) then
		print(string.format(
			"[AbilityStateGuardUI] Invalid active status ability=%s playerState=%s roundRunning=%s rawStatus=%s -> effectiveStatus=%s",
			abilityId,
			playerState,
			tostring(roundRunning),
			tostring(value),
			STATUS_QUEUED
		))
		return STATUS_QUEUED
	end
	if value == STATUS_QUEUED or value == STATUS_ACTIVE then
		return value
	end
	return STATUS_NONE
end

local function refreshAbilityCard(abilityId: string)
	local button = actionButtons[abilityId]
	local statusLabel = statusLabels[abilityId]
	local ability = PerkCatalog.Get(abilityId)
	if not button or not statusLabel or not ability then
		return
	end

	local buyGroup = button:FindFirstChild("RobuxBuyGroup")
	local status = getAbilityStatus(abilityId)
	if status == STATUS_QUEUED then
		if buyGroup then
			buyGroup:Destroy()
		end
		button.Text = "QUEUED"
		button.BackgroundColor3 = BUTTON_BG_DISABLED
		statusLabel.Text = "NEXT MATCH"
		statusLabel.TextColor3 = CARD_ACCENT
	elseif status == STATUS_ACTIVE then
		if buyGroup then
			buyGroup:Destroy()
		end
		button.Text = "ACTIVE"
		button.BackgroundColor3 = BUTTON_BG_DISABLED
		statusLabel.Text = "LIVE NOW"
		statusLabel.TextColor3 = CARD_ACCENT
	else
		local robuxAmount = tostring(tonumber(ability.robux) or 5)
		button.Text = string.format("%s ROBUX", robuxAmount)
		button.BackgroundColor3 = BUTTON_BG
		Components.ApplyRobuxBuyStyle(button, robuxAmount, ROBUX_ICON_IMAGE)
		statusLabel.Text = "ONE MATCH"
		statusLabel.TextColor3 = TEXT_MUTED
	end

	local statusLogToken = string.format(
		"status=%s raw=%s playerState=%s matchState=%s button=%s",
		tostring(status),
		tostring(LocalPlayer:GetAttribute(ability.statusAttribute)),
		tostring(LocalPlayer:GetAttribute("PlayerState") or ""),
		getReplicatedMatchState(),
		button.Text
	)
	if lastRenderedStatusByAbility[abilityId] ~= statusLogToken then
		lastRenderedStatusByAbility[abilityId] = statusLogToken
		print(string.format("[AbilityShopStatus] ability=%s %s", abilityId, statusLogToken))
	end

end

local function refreshAllAbilityCards()
	for _, perk in ipairs(PerkCatalog.All) do
		refreshAbilityCard(perk.id)
	end
end

local function createAbilityCard(parent: Instance, ability, layoutOrder: number?)
	local card = Instance.new("Frame")
	card.Name = ability.id .. "_Card"
	card.Size = UDim2.fromOffset(246, 228)
	card.LayoutOrder = layoutOrder or 0
	card.BackgroundColor3 = CARD_BG
	card.BorderSizePixel = 0
	card.Parent = parent
	Instance.new("UICorner", card).CornerRadius = UDim.new(0, 18)
	Components.AddStudTexture(card, 18)

	local cardTexture = card:FindFirstChild("StudTexture")
	if cardTexture and cardTexture:IsA("ImageLabel") then
		cardTexture.ImageColor3 = PANEL_STUD
		cardTexture.ImageTransparency = 0.94
		cardTexture.TileSize = UDim2.fromOffset(60, 60)
		cardTexture.ZIndex = 3
	end

	local stroke = Instance.new("UIStroke")
	stroke.Color = CARD_STROKE
	stroke.Thickness = 2
	stroke.Transparency = 0.08
	stroke.Parent = card

	local gradient = Instance.new("UIGradient")
	gradient.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, CARD_BG_ALT),
		ColorSequenceKeypoint.new(1, CARD_BG),
	})
	gradient.Rotation = 90
	gradient.Parent = card

	local badge = Instance.new("TextLabel")
	badge.Name = "Badge"
	badge.AnchorPoint = Vector2.new(0.5, 0)
	badge.Position = UDim2.new(0.5, 0, 0, 14)
	badge.Size = UDim2.fromOffset(116, 24)
	badge.BackgroundColor3 = BADGE_BG
	badge.BorderSizePixel = 0
	badge.Font = Enum.Font.GothamBold
	badge.Text = "ABILITY SHOP"
	badge.TextColor3 = TEXT_PRIMARY
	badge.TextSize = 12
	badge.ZIndex = 4
	badge.Parent = card
	Instance.new("UICorner", badge).CornerRadius = UDim.new(0, 12)

	local title = Instance.new("TextLabel")
	title.Name = "Title"
	title.AnchorPoint = Vector2.new(0.5, 0)
	title.Position = UDim2.new(0.5, 0, 0, 48)
	title.Size = UDim2.new(1, -24, 0, 32)
	title.BackgroundTransparency = 1
	title.Font = Enum.Font.GothamBlack
	title.Text = ability.name
	title.TextColor3 = TEXT_PRIMARY
	title.TextSize = 24
	title.ZIndex = 4
	title.Parent = card

	local titleStroke = Instance.new("UIStroke")
	titleStroke.Color = Color3.new(0, 0, 0)
	titleStroke.Thickness = 1.4
	titleStroke.Transparency = 0.28
	titleStroke.Parent = title

	local statusLabel = Instance.new("TextLabel")
	statusLabel.Name = "Status"
	statusLabel.AnchorPoint = Vector2.new(0.5, 0)
	statusLabel.Position = UDim2.new(0.5, 0, 0, 82)
	statusLabel.Size = UDim2.new(1, -28, 0, 18)
	statusLabel.BackgroundTransparency = 1
	statusLabel.Font = Enum.Font.GothamBold
	statusLabel.Text = "ONE MATCH"
	statusLabel.TextColor3 = TEXT_MUTED
	statusLabel.TextSize = 12
	statusLabel.ZIndex = 4
	statusLabel.Parent = card
	statusLabels[ability.id] = statusLabel

	local description = Instance.new("TextLabel")
	description.Name = "Description"
	description.AnchorPoint = Vector2.new(0.5, 0)
	description.Position = UDim2.new(0.5, 0, 0, 108)
	description.Size = UDim2.new(1, -28, 0, 66)
	description.BackgroundTransparency = 1
	description.Font = Enum.Font.GothamMedium
	description.Text = ability.description
	description.TextColor3 = TEXT_MUTED
	description.TextSize = 14
	description.TextWrapped = true
	description.ZIndex = 4
	description.Parent = card

	local accentLine = Instance.new("Frame")
	accentLine.Name = "AccentLine"
	accentLine.AnchorPoint = Vector2.new(0.5, 0)
	accentLine.Position = UDim2.new(0.5, 0, 0, 178)
	accentLine.Size = UDim2.new(1, -34, 0, 2)
	accentLine.BackgroundColor3 = CARD_ACCENT
	accentLine.BorderSizePixel = 0
	accentLine.ZIndex = 4
	accentLine.Parent = card

	local button = Instance.new("TextButton")
	button.Name = "BuyButton"
	button.AnchorPoint = Vector2.new(0.5, 1)
	button.Position = UDim2.new(0.5, 0, 1, -16)
	button.Size = UDim2.new(1, -28, 0, 36)
	button.BackgroundColor3 = BUTTON_BG
	button.BorderSizePixel = 0
	button.AutoButtonColor = false
	button.Font = Enum.Font.GothamBold
	button.Text = "BUY"
	button.TextColor3 = TEXT_PRIMARY
	button.TextSize = 15
	button.TextXAlignment = Enum.TextXAlignment.Center
	button.ZIndex = 4
	button.Parent = card
	Instance.new("UICorner", button).CornerRadius = UDim.new(0, 12)

	local buttonStroke = Instance.new("UIStroke")
	buttonStroke.Color = Color3.fromRGB(218, 255, 230)
	buttonStroke.Thickness = 1
	buttonStroke.Transparency = 0.36
	buttonStroke.Parent = button

	actionButtons[ability.id] = button

	AnimUtil.WireButton(button, function()
		if getAbilityStatus(ability.id) ~= STATUS_NONE then
			return
		end

		local remote = getRequestRemote()
		if not remote then
			warn("[AbilityShopPanel] PerkProductPromptRequest remote missing")
			return
		end

		SoundUtil.Click()
		remote:FireServer(ability.id)
	end)

	refreshAbilityCard(ability.id)
end

function AbilityShopPanel.Init(screenGui: ScreenGui, onClose: () -> ())
	closeCallback = onClose

	overlay = Components.CreateDimOverlay(screenGui, function()
		AbilityShopPanel.Hide()
	end)

	local content: ScrollingFrame
	local closeBtn: TextButton
	canvas, uiScale, content, closeBtn = Components.CreatePanel(screenGui, "ABILITY SHOP", HEADER_COLOR, "Shop")
	canvas.Size = UDim2.fromScale(0.58, 0.5)
	canvas.BackgroundColor3 = PANEL_BG
	content.ScrollingEnabled = true
	content.ScrollingDirection = Enum.ScrollingDirection.Y
	content.AutomaticCanvasSize = Enum.AutomaticSize.Y
	content.CanvasSize = UDim2.fromOffset(0, 0)
	content.ScrollBarThickness = 8
	content.ElasticBehavior = Enum.ElasticBehavior.Always

	local panelStroke = canvas:FindFirstChildWhichIsA("UIStroke")
	if panelStroke then
		panelStroke.Color = PANEL_STROKE
		panelStroke.Transparency = 0.06
	end

	local centerGlow = canvas:FindFirstChild("CenterGlow")
	if centerGlow then
		centerGlow:Destroy()
	end

	local sunburst = canvas:FindFirstChild("Sunburst")
	if sunburst then
		sunburst:Destroy()
	end

	for _, child in ipairs(canvas:GetChildren()) do
		if string.match(child.Name, "^Sparkle") then
			child:Destroy()
		end
	end

	local studTexture = canvas:FindFirstChild("StudTexture")
	if studTexture and studTexture:IsA("ImageLabel") then
		studTexture.ImageColor3 = PANEL_STUD
		studTexture.ImageTransparency = 0.92
		studTexture.TileSize = UDim2.fromOffset(74, 74)
	end

	local header = canvas:FindFirstChild("Header")
	if header and header:IsA("Frame") then
		header.BackgroundColor3 = PANEL_HEADER_BG

		local bottomMask = header:FindFirstChild("BottomMask")
		if bottomMask and bottomMask:IsA("Frame") then
			bottomMask.BackgroundColor3 = PANEL_HEADER_BG
		end

		local highlightLine = header:FindFirstChild("HighlightLine")
		if highlightLine and highlightLine:IsA("Frame") then
			highlightLine.BackgroundColor3 = Color3.fromRGB(177, 240, 200)
			highlightLine.BackgroundTransparency = 0.7
		end
	end

	closeBtn.BackgroundColor3 = UIConfig.Colors.CloseBtn
	closeBtn.TextColor3 = UIConfig.Colors.TextWhite
	AnimUtil.WireButton(closeBtn, function()
		AbilityShopPanel.Hide()
	end)

	local wrapper = Instance.new("Frame")
	wrapper.Name = "Wrapper"
	wrapper.Size = UDim2.new(1, -18, 0, 0)
	wrapper.AutomaticSize = Enum.AutomaticSize.Y
	wrapper.BackgroundTransparency = 1
	wrapper.BorderSizePixel = 0
	wrapper.Parent = content

	local wrapperLayout = Instance.new("UIListLayout")
	wrapperLayout.FillDirection = Enum.FillDirection.Vertical
	wrapperLayout.Padding = UDim.new(0, 10)
	wrapperLayout.SortOrder = Enum.SortOrder.LayoutOrder
	wrapperLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	wrapperLayout.Parent = wrapper

	local intro = Instance.new("TextLabel")
	intro.Name = "Intro"
	intro.Size = UDim2.new(1, -20, 0, 42)
	intro.BackgroundTransparency = 1
	intro.Font = Enum.Font.GothamSemibold
	intro.Text = "Single-match abilities from AbilitySeller. These expire after one match and never become permanent."
	intro.TextColor3 = TEXT_MUTED
	intro.TextSize = 15
	intro.TextWrapped = true
	intro.LayoutOrder = 1
	intro.Parent = wrapper

	local cardsHolder = Instance.new("Frame")
	cardsHolder.Name = "CardsHolder"
	cardsHolder.Size = UDim2.new(1, -20, 0, 0)
	cardsHolder.BackgroundTransparency = 1
	cardsHolder.BorderSizePixel = 0
	cardsHolder.LayoutOrder = 2
	cardsHolder.Parent = wrapper

	cardsGridLayout = Instance.new("UIGridLayout")
	cardsGridLayout.CellSize = UDim2.new(0.5, -8, 0, 228)
	cardsGridLayout.CellPadding = UDim2.fromOffset(10, 10)
	cardsGridLayout.SortOrder = Enum.SortOrder.LayoutOrder
	cardsGridLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	cardsGridLayout.VerticalAlignment = Enum.VerticalAlignment.Top
	cardsGridLayout.Parent = cardsHolder

	local function updateCardsHolderHeight()
		if not cardsGridLayout then
			return
		end
		cardsHolder.Size = UDim2.new(1, -20, 0, cardsGridLayout.AbsoluteContentSize.Y)
	end

	cardsGridLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(updateCardsHolderHeight)

	for index, ability in ipairs(PerkCatalog.All) do
		createAbilityCard(cardsHolder, ability, index)
		LocalPlayer:GetAttributeChangedSignal(ability.statusAttribute):Connect(function()
			refreshAbilityCard(ability.id)
		end)
	end
	LocalPlayer:GetAttributeChangedSignal("PlayerState"):Connect(function()
		refreshAllAbilityCards()
	end)

	updateCardsHolderHeight()
end

function AbilityShopPanel.Show()
	if not canvas or not uiScale or not overlay or visible then
		return
	end

	visible = true
	overlay.Visible = true
	refreshAllAbilityCards()
	SoundUtil.Open()
	AnimUtil.OpenPanel(canvas, uiScale)
end

function AbilityShopPanel.Hide()
	if not canvas or not uiScale or not overlay or not visible then
		return
	end

	visible = false
	overlay.Visible = false
	local tween = AnimUtil.ClosePanel(canvas, uiScale)
	task.spawn(function()
		tween.Completed:Wait()
		if canvas then
			canvas.Visible = false
		end
	end)

	if closeCallback then
		closeCallback()
	end
end

function AbilityShopPanel.IsVisible(): boolean
	return visible
end

function AbilityShopPanel.Toggle()
	if visible then
		AbilityShopPanel.Hide()
	else
		AbilityShopPanel.Show()
	end
end

return AbilityShopPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="161">
            <Properties>
              <string name="Name">PetsPanel</string>
              <string name="Source"><![CDATA[--[[
	PetsPanel
	Pet collection / equip grid — shows ALL pets (owned + locked).

	DARK + VIBRANT theme — front-page quality:
	  * Dark card backgrounds with rarity-glow borders
	  * Pet icons using ItemCatalog images
	  * Equip / Equipped buttons
	  * Locked pets shown as "???" with dim styling

	Data source: ItemCatalog (single source of truth)
	Ownership:   Player "OwnedPets" attribute (JSON array of catalog IDs)

	Used by: UIController (sidebar "Pets" button)
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")

local Shared = ReplicatedStorage:WaitForChild("Shared", 60)
if not Shared then
	warn("[PetsPanel] Shared not found after 60s -- disabled")
	return { Init = function() end, Show = function() end, Hide = function() end,
		IsVisible = function() return false end, Toggle = function() end }
end

local CDPModule = Shared:WaitForChild("ClientDepsProvider", 60)
if not CDPModule then
	local _children = {}
	for _, c in ipairs(Shared:GetChildren()) do table.insert(_children, c.Name.."("..c.ClassName..")") end
	warn("[PetsPanel] ClientDepsProvider MISSING. Shared path:", Shared:GetFullName(), "| Shared children:", table.concat(_children, ", "))
	return { Init = function() end, Show = function() end, Hide = function() end,
		IsVisible = function() return false end, Toggle = function() end }
end

local ok, Deps = pcall(require, CDPModule)
if not ok or not Deps then
	warn("[PetsPanel] require(ClientDepsProvider) FAILED:", Deps)
	return { Init = function() end, Show = function() end, Hide = function() end,
		IsVisible = function() return false end, Toggle = function() end }
end
local UIConfig = Deps.UIConfig
local ItemCatalog = Deps.ItemCatalog

if not UIConfig then
	warn("[PetsPanel] UIConfig not available -- disabled")
	return { Init = function() end, Show = function() end, Hide = function() end,
		IsVisible = function() return false end, Toggle = function() end }
end

local Client = script.Parent
local AnimUtil   = require(Client:WaitForChild("AnimUtil"))
local SoundUtil  = require(Client:WaitForChild("SoundUtil"))
local Components = require(Client:WaitForChild("Components"))

local C = UIConfig.Colors

local player = Players.LocalPlayer

local canvas: CanvasGroup = nil
local uiScale: UIScale = nil
local overlay: Frame = nil
local contentFrame: ScrollingFrame = nil
local visible = false
local closeCallback: (() -> ())? = nil

local equippedId: string? = nil
local _equipDebounce = false  -- prevents double-fire + preserves optimistic equippedId

local PetsPanel = {}

-- Pet UI-only thumbnail overrides (bypass viewport renderer for specific pets).
local PetThumbnailOverrides: { [string]: string } = {
	GoldbearPlush = "rbxassetid://85974611929141",
	FurryHugs = "rbxassetid://140636018152057",
}

local function getOwnedPetSet(): { [string]: boolean }
	local json = player:GetAttribute("OwnedPets") or "[]"
	local ok, list = pcall(HttpService.JSONDecode, HttpService, json)
	if not ok or type(list) ~= "table" then return {} end
	local set = {}
	for _, id in ipairs(list) do
		set[id] = true
	end
	return set
end

local function clearContent()
	for _, child in ipairs(contentFrame:GetChildren()) do
		if child:IsA("Frame") then child:Destroy() end
	end
end

local function getEquipRemote(): RemoteEvent?
	local remotes = ReplicatedStorage:FindFirstChild("Remotes")
	if not remotes then return nil end
	return remotes:FindFirstChild("EquipItem")
end

local function getUnequipRemote(): RemoteEvent?
	local remotes = ReplicatedStorage:FindFirstChild("Remotes")
	if not remotes then return nil end
	return remotes:FindFirstChild("UnequipItem")
end

local function refresh()
	clearContent()

	local ownedSet = getOwnedPetSet()
	-- During debounce, keep the optimistic equippedId so the UI updates instantly.
	-- Otherwise, sync with the authoritative server attribute.
	if not _equipDebounce then
		equippedId = player:GetAttribute("EquippedPet") or nil
	end
	local allPets = ItemCatalog.GetAllPetsSorted()

	for i, pet in ipairs(allPets) do
		local isOwned = ownedSet[pet.id] == true
		local isEquipped = isOwned and (pet.id == equippedId)
		local resolved = ItemCatalog.ResolveCrownOrPetImage and ItemCatalog.ResolveCrownOrPetImage(pet.id, "PET") or nil
		local resolvedImage = (resolved and resolved.mode == "STATIC" and resolved.image) or ItemCatalog.GetImage(pet)
		local resolvedModelPath = (resolved and resolved.mode == "RENDERER" and resolved.rendererKey) or nil
		local forcedThumb = PetThumbnailOverrides[pet.name]
		if forcedThumb and forcedThumb ~= "" then
			resolvedImage = forcedThumb
			resolvedModelPath = nil
		end
		if pet.id == "pet_fredbear_plush" or pet.id == "pet_huggy_wuggy" then
			local source = "CatalogImage"
			if resolved and resolved.mode == "STATIC" then
				source = "ResolveCrownOrPetImage:STATIC"
			elseif resolved and resolved.mode == "RENDERER" then
				source = "ResolveCrownOrPetImage:RENDERER"
			end
			if forcedThumb then
				source = "PetThumbnailOverrides"
			end
			print(string.format("[PetThumb] pet=%s source=%s image=%s modelPath=%s",
				tostring(pet.name or pet.id),
				source,
				tostring(resolvedImage or ""),
				tostring(resolvedModelPath or "")))
		end
		local actionText = nil
		local actionColor = nil
		local subLabel = nil

		if isOwned then
			actionText = isEquipped and "Equipped" or "Equip"
			actionColor = isEquipped and C.Green or C.EquipButton
		else
			subLabel = ItemCatalog.GetPetAcquisitionLabel(pet.id)
		end

		Components.CreateViewportItemCard(contentFrame, {
			id = pet.id,
			name = pet.name,
			rarity = pet.rarity,
			iconColor = pet.iconColor,
			thumbnailBgColor = pet.thumbnailBgColor,
			iconText = pet.iconText or "",
			image = resolvedImage,
			modelPath = resolvedModelPath,
			locked = not isOwned,
			equipped = isEquipped,
			owned = isOwned,
			subLabel = subLabel,
			actionText = actionText,
			actionColor = actionColor,
			onAction = function()
				if not isOwned then return end
				if _equipDebounce then return end -- prevent double-fire
				_equipDebounce = true

				if isEquipped then
					-- Unequip
					local unequipRemote = getUnequipRemote()
					if unequipRemote then
						unequipRemote:FireServer("Pets")
					end
					equippedId = nil
				else
					-- Equip via server
					local equipRemote = getEquipRemote()
					if equipRemote then
						equipRemote:FireServer("Pets", pet.id)
					end
					equippedId = pet.id
				end

				SoundUtil.Equip()
				refresh() -- instant optimistic UI update

				-- Release debounce after attribute has time to replicate,
				-- then do a final sync refresh.
				task.delay(0.5, function()
					_equipDebounce = false
					if visible then refresh() end
				end)
			end,
		}).LayoutOrder = i
	end
end

function PetsPanel.Init(screenGui: ScreenGui, onClose: () -> ())
	closeCallback = onClose

	overlay = Components.CreateDimOverlay(screenGui, function()
		PetsPanel.Hide()
	end)

	local content, closeBtn
	canvas, uiScale, content, closeBtn = Components.CreatePanel(screenGui, "PETS", C.HeaderPets, "Pets")
	contentFrame = content

	Components.AddGridLayout(content)

	closeBtn.MouseButton1Click:Connect(function()
		SoundUtil.Close()
		PetsPanel.Hide()
	end)

	-- Override stud texture to Fate Beams asset (only this panel)
	do
		local stud = canvas:FindFirstChild("StudTexture")
		if stud then
			stud.Image = "rbxassetid://84772207963553"
			stud.TileSize = UDim2.fromOffset(96, 96)
			stud.ImageTransparency = 0.88
			stud.ImageColor3 = Color3.fromRGB(255, 255, 255)
		end
	end

	player:GetAttributeChangedSignal("OwnedPets"):Connect(function()
		if visible then refresh() end
	end)

	refresh()
end

function PetsPanel.Show()
	if visible then return end
	visible = true
	overlay.Visible = true
	refresh()
	SoundUtil.Open()
	AnimUtil.OpenPanel(canvas, uiScale)
end

function PetsPanel.Hide()
	if not visible then return end
	visible = false
	overlay.Visible = false
	local t = AnimUtil.ClosePanel(canvas, uiScale)
	task.spawn(function()
		t.Completed:Wait()
		canvas.Visible = false
	end)
	if closeCallback then closeCallback() end
end

function PetsPanel.IsVisible(): boolean
	return visible
end

function PetsPanel.Toggle()
	if visible then PetsPanel.Hide() else PetsPanel.Show() end
end

return PetsPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="162">
            <Properties>
              <string name="Name">QuestsPanel</string>
              <string name="Source"><![CDATA[--[[
	QuestsPanel
	Daily quest UI — scrollable list of quests with progress bars.

	Theme: Glossy red, matching the rest of the UI aesthetic.
	Each row: left reward-card box (icon) + right progress rectangle.

	Rows are built DYNAMICALLY from the server status response, so they
	always reflect today's generated quests (including rotating quests).

	API:
	  Init(screenGui, onClose)
	  Show() / Hide() / IsVisible() / Toggle()
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService      = game:GetService("TweenService")
local RunService        = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared", 60)
if not Shared then
	warn("[QuestsPanel] Shared not found")
	return { Init=function()end, Show=function()end, Hide=function()end,
		IsVisible=function() return false end, Toggle=function()end }
end

local ok, Deps = pcall(require, Shared:WaitForChild("ClientDepsProvider", 60))
if not ok or not Deps then
	warn("[QuestsPanel] ClientDepsProvider failed:", Deps)
	return { Init=function()end, Show=function()end, Hide=function()end,
		IsVisible=function() return false end, Toggle=function()end }
end

local UIConfig = Deps.UIConfig

local okDQC, DailyQuestConfig = pcall(require, Shared:WaitForChild("DailyQuestConfig", 10))
if not okDQC or not DailyQuestConfig then
	warn("[QuestsPanel] DailyQuestConfig failed:", DailyQuestConfig)
	DailyQuestConfig = {
		StarterQuest = {
			id = "starter_survive_1_round",
		},
	}
end

local okIC, ItemCatalog = pcall(require, Shared:WaitForChild("ItemCatalog", 10))
if not okIC or not ItemCatalog then
	ItemCatalog = { Pets = {}, Crowns = {}, CoinImage = "" }
end
local okQI, QuestRewardIconResolver = pcall(require, Shared:WaitForChild("QuestRewardIconResolver", 10))
if not okQI or not QuestRewardIconResolver then
	QuestRewardIconResolver = { GetQuestRewardIcon = function() return nil end }
end

local Client            = script.Parent
local AnimUtil          = require(Client:WaitForChild("AnimUtil"))
local SoundUtil         = require(Client:WaitForChild("SoundUtil"))
local Components        = require(Client:WaitForChild("Components"))
local ThumbnailRenderer = require(Client:WaitForChild("ThumbnailRenderer"))
local RewardPopup       = require(Client:WaitForChild("RewardPopup"))
local STARTER_QUEST_ID = tostring(DailyQuestConfig.StarterQuest and DailyQuestConfig.StarterQuest.id or "starter_survive_1_round")

-- THEME

local HEADER_COLOR   = Color3.fromRGB(200, 30,  30)
local HEADER_TOP     = Color3.fromRGB(255, 70,  70)
local HEADER_BOT     = Color3.fromRGB(140, 15,  15)
local INNER_BG       = Color3.fromRGB(30,  8,   8)
local CARD_BG        = Color3.fromRGB(20,  5,   5)
local CARD_BORDER    = Color3.fromRGB(200, 50,  50)
local BAR_BG         = Color3.fromRGB(50,  12,  12)
local BAR_FILL       = Color3.fromRGB(255, 60,  60)
local BAR_COMPLETE   = Color3.fromRGB(80,  255, 120)
local TEXT_WHITE     = Color3.fromRGB(255, 255, 255)
local TEXT_MUTED     = Color3.fromRGB(200, 150, 150)
local CLAIM_GREEN    = Color3.fromRGB(50,  200, 80)
local CLAIM_DISABLED = Color3.fromRGB(60,  20,  20)
local CLAIMED_COLOR  = Color3.fromRGB(80,  80,  80)

-- STATE

local QuestsPanel = {}
local canvas       = nil
local uiScale      = nil
local overlay      = nil
local scrollFrame  = nil
local visible      = false
local closeCallback = nil

local _questRows   = {}
local _builtForDay = nil

local _status      = nil
local _getStatusFunc = nil
local _claimFunc     = nil
local _updateRemote  = nil
local _lastLoggedQuestPayloadSignature = nil
local _visibilityWatchConnected = false

local function log(message: string)
	print("[QuestsPanel] " .. message)
end

local function logStatusPayload(status, reason: string)
	if type(status) ~= "table" or type(status.quests) ~= "table" then
		return
	end

	local entries = table.create(#status.quests)
	local starterPresent = false
	for _, quest in ipairs(status.quests) do
		local questId = tostring(quest.id or "")
		if questId == STARTER_QUEST_ID then
			starterPresent = true
		end
		table.insert(entries, questId)
	end

	local payloadSignature = tostring(#status.quests) .. "::" .. table.concat(entries, "|")
	if _lastLoggedQuestPayloadSignature == payloadSignature then
		return
	end
	_lastLoggedQuestPayloadSignature = payloadSignature

	log(string.format(
		"authoritative_status_received reason=%s activeQuestCount=%d starterPresent=%s quests=%s",
		reason,
		#status.quests,
		tostring(starterPresent),
		table.concat(entries, ",")
	))
end

local function formatVector2(value: Vector2?): string
	if typeof(value) ~= "Vector2" then
		return "nil"
	end
	return string.format("(%.1f, %.1f)", value.X, value.Y)
end

local function formatUDim2(value: UDim2?): string
	if typeof(value) ~= "UDim2" then
		return "nil"
	end
	return string.format(
		"(%0.3f,%d,%0.3f,%d)",
		value.X.Scale,
		value.X.Offset,
		value.Y.Scale,
		value.Y.Offset
	)
end

local function getQuestScreenGui(): ScreenGui?
	local current = canvas
	while current do
		if current:IsA("ScreenGui") then
			return current
		end
		current = current.Parent
	end
	return nil
end

local function getAncestorVisibilityChain(instance: Instance?): string
	if not instance then
		return "nil"
	end

	local entries = {}
	local current = instance
	while current do
		if current:IsA("ScreenGui") then
			table.insert(entries, string.format("%s(ScreenGui Enabled=%s)", current.Name, tostring(current.Enabled)))
		elseif current:IsA("GuiObject") then
			table.insert(entries, string.format("%s(%s Visible=%s)", current.Name, current.ClassName, tostring(current.Visible)))
		else
			table.insert(entries, string.format("%s(%s)", current.Name, current.ClassName))
		end
		current = current.Parent
	end

	return table.concat(entries, " <- ")
end

local function getVisibilityDiagnostics()
	local screenGui = getQuestScreenGui()
	local absoluteSize = canvas and canvas.AbsoluteSize or Vector2.zero
	local absolutePosition = canvas and canvas.AbsolutePosition or Vector2.zero
	local questListPath = scrollFrame and scrollFrame:GetFullName() or "nil"

	return {
		targetPath = canvas and canvas:GetFullName() or "nil",
		trueVisibleRoot = canvas and canvas:GetFullName() or "nil",
		screenGuiPath = screenGui and screenGui:GetFullName() or "nil",
		screenGuiEnabled = screenGui ~= nil and screenGui.Enabled == true or false,
		canvasVisible = canvas ~= nil and canvas.Visible == true or false,
		contentVisible = scrollFrame ~= nil and scrollFrame.Visible == true or false,
		overlayVisible = overlay ~= nil and overlay.Visible == true or false,
		groupTransparency = canvas and canvas.GroupTransparency or 1,
		absolutePositionText = formatVector2(absolutePosition),
		absoluteSizeText = formatVector2(absoluteSize),
		absoluteSize = absoluteSize,
		zIndex = canvas and canvas.ZIndex or -1,
		positionText = canvas and formatUDim2(canvas.Position) or "nil",
		anchorPointText = canvas and formatVector2(canvas.AnchorPoint) or "nil",
		ancestorChain = getAncestorVisibilityChain(canvas),
		contentPath = questListPath,
	}
end

local function logVisibilityDiagnostics(reason: string)
	local diagnostics = getVisibilityDiagnostics()
	log(string.format(
		"visibility_check reason=%s target=%s trueVisibleRoot=%s screenGui=%s screenGuiEnabled=%s canvasVisible=%s contentVisible=%s overlayVisible=%s groupTransparency=%.2f absPos=%s absSize=%s zIndex=%d position=%s anchorPoint=%s contentPath=%s ancestors=%s",
		reason,
		diagnostics.targetPath,
		diagnostics.trueVisibleRoot,
		diagnostics.screenGuiPath,
		tostring(diagnostics.screenGuiEnabled),
		tostring(diagnostics.canvasVisible),
		tostring(diagnostics.contentVisible),
		tostring(diagnostics.overlayVisible),
		diagnostics.groupTransparency,
		diagnostics.absolutePositionText,
		diagnostics.absoluteSizeText,
		diagnostics.zIndex,
		diagnostics.positionText,
		diagnostics.anchorPointText,
		diagnostics.contentPath,
		diagnostics.ancestorChain
	))
end

local function connectVisibilityWatchers()
	if _visibilityWatchConnected or not canvas then
		return
	end

	_visibilityWatchConnected = true

	canvas:GetPropertyChangedSignal("Visible"):Connect(function()
		if visible and canvas and not canvas.Visible then
			logVisibilityDiagnostics("external_hide_canvas_visible_false")
		end
	end)

	if scrollFrame then
		scrollFrame:GetPropertyChangedSignal("Visible"):Connect(function()
			if visible and scrollFrame and not scrollFrame.Visible then
				logVisibilityDiagnostics("external_hide_quest_list_hidden")
			end
		end)
	end

	local screenGui = getQuestScreenGui()
	if screenGui then
		screenGui:GetPropertyChangedSignal("Enabled"):Connect(function()
			if visible and screenGui.Enabled == false then
				logVisibilityDiagnostics("external_hide_screen_gui_disabled")
			end
		end)
	end
end

-- REMOTE HELPERS

local function ensureRemotes()
	if _getStatusFunc and _claimFunc then return end
	pcall(function()
		local remotes = ReplicatedStorage:WaitForChild("Remotes", 5)
		if not remotes then return end
		_getStatusFunc = remotes:WaitForChild("DailyQuest_GetStatus", 5)
		_claimFunc     = remotes:WaitForChild("DailyQuest_Claim", 5)
		_updateRemote  = remotes:FindFirstChild("DailyQuest_Update")
	end)
end

local function fetchStatus()
	ensureRemotes()
	if _getStatusFunc then
		local s_ok, status = pcall(_getStatusFunc.InvokeServer, _getStatusFunc)
		if s_ok and status then return status end
	end
	return nil
end

local function claimQuestRemote(questId)
	ensureRemotes()
	if _claimFunc then
		local c_ok, result = pcall(_claimFunc.InvokeServer, _claimFunc, questId)
		if c_ok and result then return result end
	end
	return { success = false, reason = "Remote unavailable" }
end

-- REWARD CARD HELPERS

local function getItemDef(reward)
	if not reward then return nil end
	if reward.type == "Crown" then
		return ItemCatalog.Crowns and ItemCatalog.Crowns[reward.itemId]
	elseif reward.type == "Pet" then
		return ItemCatalog.Pets and ItemCatalog.Pets[reward.itemId]
	end
	return nil
end

local function isFateCoinReward(reward): boolean
	if type(reward) ~= "table" then
		return false
	end
	local rewardType = string.upper(tostring(reward.type or ""))
	return rewardType == "COINS" or rewardType == "FATECOINS" or rewardType == "FATE_COINS"
end

local function populateRewardCard(card, reward)
	if not reward then return end

	local questRewardIcon = QuestRewardIconResolver.GetQuestRewardIcon(reward)
	if questRewardIcon then
		local img = Instance.new("ImageLabel")
		img.AnchorPoint         = Vector2.new(0.5, 0.5)
		img.Position            = UDim2.fromScale(0.5, 0.5)
		img.Size                = UDim2.fromScale(1, 1)
		img.BackgroundTransparency = 1
		img.Image               = questRewardIcon
		img.ScaleType           = Enum.ScaleType.Crop
		img.ZIndex              = 9
		if isFateCoinReward(reward) then
			-- Fate Coin art includes empty padding, so crop a bit tighter in quest cards.
			img.Size = UDim2.fromScale(1.3, 1.3)
		end
		img.Parent              = card
	else
		local itemDef   = getItemDef(reward)
		local staticImg = itemDef and itemDef.image
		local isFNAFPet = itemDef and itemDef.collection == "FNAF"

		if staticImg and staticImg ~= "" then
			local img = Instance.new("ImageLabel")
			img.AnchorPoint         = Vector2.new(0.5, 0.5)
			img.Position            = UDim2.fromScale(0.5, 0.5)
			img.Size                = UDim2.fromScale(1, 1)
			img.BackgroundTransparency = 1
			img.Image               = staticImg
			img.ScaleType           = Enum.ScaleType.Crop
			img.ZIndex              = 9
			img.Parent              = card
		elseif itemDef and not isFNAFPet then
			local vp = Instance.new("ViewportFrame")
			vp.AnchorPoint         = Vector2.new(0.5, 0.5)
			vp.Position            = UDim2.fromScale(0.5, 0.5)
			vp.Size                = UDim2.fromScale(0.92, 0.92)
			vp.BackgroundTransparency = 1
			vp.BackgroundColor3    = Color3.new(0, 0, 0)
			vp.ZIndex              = 9
			vp.Parent              = card
			task.spawn(function()
				ThumbnailRenderer.RenderItemToViewport(vp, itemDef)
			end)
		else
			local lbl = Instance.new("TextLabel")
			lbl.AnchorPoint         = Vector2.new(0.5, 0.5)
			lbl.Position            = UDim2.fromScale(0.5, 0.5)
			lbl.Size                = UDim2.fromScale(0.85, 0.85)
			lbl.BackgroundTransparency = 1
			lbl.Font                = Enum.Font.GothamBold
			lbl.Text                = ""
			lbl.TextSize            = 28
			lbl.ZIndex              = 9
			lbl.Parent              = card
		end
	end
end

-- ROW UPDATE

local function updateRow(rowData, quest)
	if not rowData then return end

	local progress  = math.min(quest.progress or 0, quest.target or 1)
	local target    = quest.target or 1
	local completed = progress >= target
	local claimed   = quest.claimed

	local frac = math.clamp(progress / target, 0, 1)
	if rowData.progressFill then
		TweenService:Create(rowData.progressFill,
			TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
			{ Size = UDim2.new(frac, 0, 1, 0) }
		):Play()
		rowData.progressFill.BackgroundColor3 = (completed or claimed) and BAR_COMPLETE or BAR_FILL
	end

	if rowData.progressLabel then
		rowData.progressLabel.Text = string.format("%d / %d", progress, target)
	end

	if rowData.claimBtn then
		if claimed then
			rowData.claimBtn.Text = "CLAIMED"
			rowData.claimBtn.BackgroundColor3 = CLAIMED_COLOR
			rowData.claimBtn.TextColor3 = Color3.fromRGB(120, 120, 120)
			rowData.claimBtn.Active = false
			rowData.claimBtn.AutoButtonColor = false
		elseif completed then
			rowData.claimBtn.Text = "CLAIM"
			rowData.claimBtn.BackgroundColor3 = CLAIM_GREEN
			rowData.claimBtn.TextColor3 = TEXT_WHITE
			rowData.claimBtn.Active = true
			rowData.claimBtn.AutoButtonColor = true
		else
			rowData.claimBtn.Text = "LOCKED"
			rowData.claimBtn.BackgroundColor3 = CLAIM_DISABLED
			rowData.claimBtn.TextColor3 = TEXT_MUTED
			rowData.claimBtn.Active = false
			rowData.claimBtn.AutoButtonColor = false
		end
	end

	if rowData.card then
		local stroke = rowData.card:FindFirstChildOfClass("UIStroke")
		if stroke then
			stroke.Color = completed and BAR_COMPLETE or CARD_BORDER
			stroke.Transparency = completed and 0.0 or 0.35
		end
	end
end

-- DYNAMIC ROW BUILDING

local function clearQuestRows()
	for _, rowData in pairs(_questRows) do
		if rowData.row and rowData.row.Parent then
			rowData.row:Destroy()
		end
	end
	_questRows   = {}
	_builtForDay = nil
end

local function buildOneRow(sf, questData, rowIndex)
	local questId = questData.id
	local reward  = questData.reward

	local row = Instance.new("Frame")
	row.Name               = "QuestRow_" .. questId
	row.Size               = UDim2.new(1, 0, 0, 90)
	row.BackgroundColor3   = CARD_BG
	row.BackgroundTransparency = 0
	row.BorderSizePixel    = 0
	row.LayoutOrder        = rowIndex
	row.ZIndex             = 7
	row.Parent             = sf

	Instance.new("UICorner", row).CornerRadius = UDim.new(0, 10)

	local rowStroke = Instance.new("UIStroke")
	rowStroke.Color       = CARD_BORDER
	rowStroke.Thickness   = 1.5
	rowStroke.Transparency = 0.35
	rowStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	rowStroke.Parent      = row

	local rowGrad = Instance.new("UIGradient")
	rowGrad.Color    = ColorSequence.new({
		ColorSequenceKeypoint.new(0,   Color3.fromRGB(45, 10, 10)),
		ColorSequenceKeypoint.new(0.5, CARD_BG),
		ColorSequenceKeypoint.new(1,   Color3.fromRGB(30, 6, 6)),
	})
	rowGrad.Rotation = 90
	rowGrad.Parent   = row

	-- Left reward card
	-- Left reward card
	local card = Instance.new("Frame")
	card.Name              = "RewardCard"
	card.AnchorPoint       = Vector2.new(0, 0.5)
	card.Position          = UDim2.new(0, 8, 0.5, 0)
	card.Size              = UDim2.fromOffset(80, 80)
	card.BackgroundColor3  = Color3.fromRGB(15, 4, 4)
	card.BorderSizePixel   = 0
	card.ZIndex            = 8
	card.ClipsDescendants  = true
	card.Parent            = row
	Instance.new("UICorner", card).CornerRadius = UDim.new(0, 8)

	local cardStroke = Instance.new("UIStroke")
	cardStroke.Color       = CARD_BORDER
	cardStroke.Thickness   = 2
	cardStroke.Transparency = 0.35
	cardStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	cardStroke.Parent      = card

	local cardGrad = Instance.new("UIGradient")
	cardGrad.Color    = ColorSequence.new({
		ColorSequenceKeypoint.new(0,   Color3.fromRGB(60, 15, 15)),
		ColorSequenceKeypoint.new(0.5, Color3.fromRGB(30, 8, 8)),
		ColorSequenceKeypoint.new(1,   Color3.fromRGB(15, 3, 3)),
	})
	cardGrad.Rotation = 120
	cardGrad.Parent   = card

	populateRewardCard(card, reward)

	-- Right content
	local content = Instance.new("Frame")
	content.AnchorPoint       = Vector2.new(0, 0)
	content.Position          = UDim2.new(0, 100, 0, 8)
	content.Size              = UDim2.new(1, -210, 1, -16)
	content.BackgroundTransparency = 1
	content.BorderSizePixel   = 0
	content.ZIndex            = 8
	content.Parent            = row

	local questLabel = Instance.new("TextLabel")
	questLabel.AnchorPoint    = Vector2.new(0, 0)
	questLabel.Position       = UDim2.fromOffset(0, 0)
	questLabel.Size           = UDim2.new(1, 0, 0, 22)
	questLabel.BackgroundTransparency = 1
	questLabel.Font           = Enum.Font.GothamBold
	questLabel.Text           = questData.label or questId
	questLabel.TextColor3     = TEXT_WHITE
	questLabel.TextSize       = 16
	questLabel.TextXAlignment = Enum.TextXAlignment.Left
	questLabel.ZIndex         = 8
	questLabel.Parent         = content
	local qlStroke = Instance.new("UIStroke")
	qlStroke.Color       = Color3.new(0, 0, 0)
	qlStroke.Thickness   = 1.5
	qlStroke.Transparency = 0.2
	qlStroke.Parent      = questLabel

	local descLabel = Instance.new("TextLabel")
	descLabel.AnchorPoint    = Vector2.new(0, 0)
	descLabel.Position       = UDim2.fromOffset(0, 24)
	descLabel.Size           = UDim2.new(1, 0, 0, 16)
	descLabel.BackgroundTransparency = 1
	descLabel.Font           = Enum.Font.Gotham
	descLabel.Text           = questData.description or ""
	descLabel.TextColor3     = TEXT_MUTED
	descLabel.TextSize       = 12
	descLabel.TextXAlignment = Enum.TextXAlignment.Left
	descLabel.ZIndex         = 8
	descLabel.Parent         = content

	local barBg = Instance.new("Frame")
	barBg.AnchorPoint       = Vector2.new(0, 1)
	barBg.Position          = UDim2.new(0, 0, 1, 0)
	barBg.Size              = UDim2.new(1, 0, 0, 14)
	barBg.BackgroundColor3  = BAR_BG
	barBg.BorderSizePixel   = 0
	barBg.ZIndex            = 8
	barBg.Parent            = content
	Instance.new("UICorner", barBg).CornerRadius = UDim.new(1, 0)

	local progressFill = Instance.new("Frame")
	progressFill.AnchorPoint       = Vector2.new(0, 0)
	progressFill.Position          = UDim2.fromOffset(0, 0)
	progressFill.Size              = UDim2.new(0, 0, 1, 0)
	progressFill.BackgroundColor3  = BAR_FILL
	progressFill.BorderSizePixel   = 0
	progressFill.ZIndex            = 9
	progressFill.Parent            = barBg
	Instance.new("UICorner", progressFill).CornerRadius = UDim.new(1, 0)

	local progressLabel = Instance.new("TextLabel")
	progressLabel.AnchorPoint    = Vector2.new(1, 0.5)
	progressLabel.Position       = UDim2.new(1, 0, 0.5, 0)
	progressLabel.Size           = UDim2.fromOffset(60, 14)
	progressLabel.BackgroundTransparency = 1
	progressLabel.Font           = Enum.Font.GothamBold
	progressLabel.Text           = "0 / " .. tostring(questData.target)
	progressLabel.TextColor3     = TEXT_WHITE
	progressLabel.TextSize       = 11
	progressLabel.TextXAlignment = Enum.TextXAlignment.Right
	progressLabel.ZIndex         = 10
	progressLabel.Parent         = barBg

	-- Claim button
	local claimBtn = Instance.new("TextButton")
	claimBtn.AnchorPoint       = Vector2.new(1, 0.5)
	claimBtn.Position          = UDim2.new(1, -12, 0.5, 0)
	claimBtn.Size              = UDim2.fromOffset(80, 40)
	claimBtn.BackgroundColor3  = CLAIM_DISABLED
	claimBtn.BorderSizePixel   = 0
	claimBtn.Font              = Enum.Font.GothamBold
	claimBtn.Text              = "LOCKED"
	claimBtn.TextColor3        = TEXT_MUTED
	claimBtn.TextSize          = 13
	claimBtn.Active            = false
	claimBtn.AutoButtonColor   = false
	claimBtn.ZIndex            = 9
	claimBtn.Parent            = row
	Instance.new("UICorner", claimBtn).CornerRadius = UDim.new(0, 10)

	local claimStroke = Instance.new("UIStroke")
	claimStroke.Color       = Color3.fromRGB(255, 255, 255)
	claimStroke.Thickness   = 1.5
	claimStroke.Transparency = 0.6
	claimStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	claimStroke.Parent      = claimBtn

	local capturedId = questId
	AnimUtil.WireButton(claimBtn, function()
		if not claimBtn.Active then return end
		claimBtn.Active = false
		task.spawn(function()
			local result = claimQuestRemote(capturedId)
			if result and result.success then
				SoundUtil.Open()
				local rw = result.reward
				if rw then
					if rw.type == "Coins" then
						local questReward = { type = "Coins", amount = rw.amount }
						RewardPopup.Show({
							title      = "QUEST COMPLETE!",
							name       = tostring(rw.amount) .. " Fate Coins",
							itemType   = "Coins",
							icon       = QuestRewardIconResolver.GetQuestRewardIcon(questReward),
							questReward = questReward,
							rarityText = "Common",
							okText     = "CLAIM!",
						})
					elseif rw.type == "Crown" then
						local crownDef = ItemCatalog.Crowns and ItemCatalog.Crowns[rw.itemId]
						RewardPopup.Show({
							title      = "QUEST COMPLETE!",
							name       = crownDef and crownDef.name or rw.itemId,
							itemId     = rw.itemId,
							itemType   = "Crown",
							rarityText = crownDef and crownDef.rarity or "Epic",
							okText     = "CLAIM!",
						})
					elseif rw.type == "Pet" then
						local petDef = ItemCatalog.Pets and ItemCatalog.Pets[rw.itemId]
						RewardPopup.Show({
							title      = "QUEST COMPLETE!",
							name       = petDef and petDef.name or rw.itemId,
							itemId     = rw.itemId,
							itemType   = "Pet",
							rarityText = petDef and petDef.rarity or "Epic",
							okText     = "CLAIM!",
						})
					elseif rw.type == "IconImage" then
						local iconDef = ItemCatalog.IconImages and ItemCatalog.IconImages[rw.itemId]
						local questReward = { type = "IconImage", itemId = rw.itemId }
						RewardPopup.Show({
							title      = "QUEST COMPLETE!",
							name       = iconDef and iconDef.name or rw.itemId,
							itemId     = rw.itemId,
							itemType   = "IconImage",
							icon       = QuestRewardIconResolver.GetQuestRewardIcon(questReward),
							questReward = questReward,
							rarityText = iconDef and iconDef.rarity or "Legendary",
							okText     = "CLAIM!",
						})
					elseif rw.type == "Crate" then
						local questReward = { type = "Crate", crateId = rw.crateId, count = rw.count }
						local extra = result.extra
						if extra and extra.crateGrant then
							local cg = extra.crateGrant
							local isCrown = cg.category == "Crowns"
							local grantLabel = if cg.isDuplicate then " (Already Owned)" else ""
							RewardPopup.Show({
								title      = "QUEST COMPLETE!",
								name       = (cg.displayName or (isCrown and "Crown" or "Pet")) .. grantLabel,
								itemId     = cg.itemId,
								itemType   = isCrown and "Crown" or "Pet",
								icon       = QuestRewardIconResolver.GetQuestRewardIcon(questReward),
								questReward = questReward,
								rarityText = cg.rarity or "Common",
								okText     = "CLAIM!",
							})
						else
							local crateId = rw.crateId or "crate_crown"
							local crateDef = ItemCatalog.Crates and ItemCatalog.Crates[crateId]
							local crateName = (crateDef and crateDef.name) or (crateId == "crate_crown" and "Crown Crate" or "Pet Crate")
							RewardPopup.Show({
								title      = "QUEST COMPLETE!",
								name       = "1 " .. crateName .. " Opened!",
								itemId     = crateId,
								itemType   = "Crate",
								icon       = QuestRewardIconResolver.GetQuestRewardIcon(questReward),
								questReward = questReward,
								rarityText = "Common",
								okText     = "CLAIM!",
							})
						end
					elseif rw.type == "Spin" then
						local n = rw.count or 1
						local questReward = { type = "Spin", count = n, spinCount = n }
						RewardPopup.Show({
							title      = "QUEST COMPLETE!",
							name       = tostring(n) .. " Free Spin" .. (n == 1 and "" or "s") .. " Added!",
							itemType   = "Spin",
							icon       = QuestRewardIconResolver.GetQuestRewardIcon(questReward),
							questReward = questReward,
							rarityText = "Common",
							okText     = "CLAIM!",
						})
					end
				end
			else
				claimBtn.Active = true
			end
		end)
	end)

	return {
		row           = row,
		card          = card,
		progressFill  = progressFill,
		progressLabel = progressLabel,
		claimBtn      = claimBtn,
		barBg         = barBg,
	}
end

local function buildQuestRows(quests, day)
	if not scrollFrame then return end

	local sorted = {}
	for _, q in ipairs(quests) do
		table.insert(sorted, q)
	end
	table.sort(sorted, function(a, b) return (a.order or 99) < (b.order or 99) end)

	for i, quest in ipairs(sorted) do
		local rowData = buildOneRow(scrollFrame, quest, i)
		_questRows[quest.id] = rowData
		updateRow(rowData, quest)
	end

	_builtForDay = day
end

local function shouldRebuildRows(status)
	if not status or type(status.quests) ~= "table" then
		return false
	end
	if _builtForDay ~= status.day or next(_questRows) == nil then
		return true
	end

	local rowCount = 0
	for _ in pairs(_questRows) do
		rowCount += 1
	end
	if rowCount ~= #status.quests then
		return true
	end
	for _, quest in ipairs(status.quests) do
		if not _questRows[quest.id] then
			return true
		end
	end
	return false
end

local function syncEmptyStateLabel()
	if not scrollFrame then return end
	local lbl = scrollFrame:FindFirstChild("LoadingLabel")
	if not lbl or not lbl:IsA("TextLabel") then return end
	if next(_questRows) == nil then
		lbl.Text = "No active quests right now."
		lbl.Visible = true
	else
		lbl.Text = "Loading quests..."
		lbl.Visible = false
	end
end

-- FULL UI REFRESH

local function refreshUI()
	local status = fetchStatus()
	if not status or not status.quests or not status.dataLoaded then return end
	logStatusPayload(status, "fetch_status")
	_status = status

	if shouldRebuildRows(status) then
		clearQuestRows()
		buildQuestRows(status.quests, status.day)
		syncEmptyStateLabel()
	else
		for _, quest in ipairs(status.quests) do
			local rowData = _questRows[quest.id]
			if rowData then updateRow(rowData, quest) end
		end
	end
end

-- PANEL BUILD

