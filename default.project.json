{
  "name": "Fate Beams",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      },
      "Remotes": {
        "$className": "Folder",
        "SpectateTarget": {
          "$className": "RemoteEvent"
        },
        "OpenCrateShop": {
          "$className": "RemoteEvent"
        }
      }
    },

    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },

    "StarterPlayer": {
      "$properties": {
        "CharacterWalkSpeed": 20
      },
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },

    "StarterGui": {
      "$properties": {
        "ResetPlayerGuiOnSpawn": false
      }
    },

    "Workspace": {
      "$properties": {
        "FilteringEnabled": true
      },
      "Lobby": {
        "$className": "Folder"
      }
    },

    "Lighting": {
      "$properties": {
        "Ambient": [0.35, 0.28, 0.22],
        "Brightness": 2.2,
        "OutdoorAmbient": [0.5, 0.4, 0.3],
        "ColorShift_Top": [0.16, 0.1, 0.04],
        "ColorShift_Bottom": [0.1, 0.06, 0.02],
        "EnvironmentDiffuseScale": 0.4,
        "EnvironmentSpecularScale": 0.25,
        "GlobalShadows": true,
        "Outlines": false,
        "Technology": "ShadowMap"
      }
    },

    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      }
    }
  }
}