	titleLabel.Size = UDim2.new(0.8, 0, 0, 36)
	titleLabel.BackgroundTransparency = 1
	titleLabel.Font = Enum.Font.GothamBold
	titleLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
	titleLabel.TextTransparency = 0
	titleLabel.TextSize = 28
	titleLabel.TextXAlignment = Enum.TextXAlignment.Left
	titleLabel.TextYAlignment = Enum.TextYAlignment.Top
	titleLabel.Text = ""
	titleLabel.ZIndex = 9
	titleLabel.Parent = coverContainer

	local titleStroke = Instance.new("UIStroke")
	titleStroke.Color = Color3.fromRGB(0, 0, 0)
	titleStroke.Thickness = 2.5
	titleStroke.Transparency = 0.05
	titleStroke.Parent = titleLabel

	local btnRow = Instance.new("Frame")
	btnRow.Name = "ButtonRow"
	btnRow.Size = UDim2.new(1, 0, 0, 50)
	btnRow.AnchorPoint = Vector2.new(0, 1)
	btnRow.Position = UDim2.new(0, 0, 1, 0)
	btnRow.BackgroundTransparency = 1
	btnRow.BorderSizePixel = 0
	btnRow.ZIndex = 7
	btnRow.Parent = heroFrame

	viewBtn = createStyledButton(
		btnRow, "VIEW", C.Blue,
		UDim2.new(0.48, 0, 0, 42),
		UDim2.fromOffset(0, 4)
	)
	AnimUtil.WireButton(viewBtn, function()
		SoundUtil.Click()
		showDetailView()
	end)

	buyBtn = createStyledButton(
		btnRow, "BUY", C.BuyButton,
		UDim2.new(0.48, 0, 0, 42),
		UDim2.new(0.52, 0, 0, 4)
	)
	AnimUtil.WireButton(buyBtn, function()
		SoundUtil.Click()
		local bundle = BundleCatalog.Get(selectedBundleId)
		if not bundle then return end
		if not bundle.isAvailable then return end
		local coinRequestId = COIN_BUNDLE_REQUEST_IDS[bundle.id]
		if coinRequestId then
			local stateBefore = getCoinBundleState(bundle)
			if stateBefore.missingCount &lt;= 0 then
				_bundleOwnedLocal[bundle.id] = true
				selectBundle(selectedBundleId)
				return
			end

			local remotes = ReplicatedStorage:FindFirstChild("Remotes")
			local buyRF = remotes and remotes:FindFirstChild("Shop_BuyWithCoins")
			if not buyRF then
				warn("[BundlePanel] Shop_BuyWithCoins remote missing for coin bundle")
				return
			end
			local okBuy, result = pcall(buyRF.InvokeServer, buyRF, coinRequestId, "Bundle")
			if okBuy and result and result.success then
				selectBundle(selectedBundleId)
			elseif okBuy and result and result.reason == "INSUFFICIENT_COINS" then
				local productId = tonumber(result.productId)
				if productId and productId &gt; 0 then
					MarketplaceService:PromptProductPurchase(LocalPlayer, productId)
				else
					warn("[BundlePanel] Missing top-up productId for insufficient bundle coins")
				end
			elseif okBuy and result and result.reason == "ALREADY_OWNED" then
				_bundleOwnedLocal[bundle.id] = true
				selectBundle(selectedBundleId)
			end
		elseif bundle.gamepassId then
			MarketplaceService:PromptGamePassPurchase(LocalPlayer, bundle.gamepassId)
		elseif bundle.productId then
			MarketplaceService:PromptProductPurchase(LocalPlayer, bundle.productId)
		else
			print(string.format("[BundlePanel] Buy clicked: %s (%d ROBUX) -- no purchase ID set",
				bundle.id, bundle.priceRobux))
		end
	end)

	detailFrame = Instance.new("Frame")
	detailFrame.Name = "DetailView"
	detailFrame.Size = UDim2.new(0.68, -8, 1, -8)
	detailFrame.Position = UDim2.fromOffset(4, 4)
	detailFrame.BackgroundColor3 = Color3.fromRGB(20, 22, 40)
	detailFrame.BackgroundTransparency = 0.1
	detailFrame.BorderSizePixel = 0
	detailFrame.Visible = false
	detailFrame.ZIndex = 10
	detailFrame.Parent = bundleContainer

	local dfCorner = Instance.new("UICorner")
	dfCorner.CornerRadius = UDim.new(0, 12)
	dfCorner.Parent = detailFrame

	local detailHeader = Instance.new("Frame")
	detailHeader.Name = "DetailHeader"
	detailHeader.Size = UDim2.new(1, 0, 0, 42)
	detailHeader.BackgroundTransparency = 1
	detailHeader.ZIndex = 11
	detailHeader.Parent = detailFrame

	local backBtn = createStyledButton(
		detailHeader, "BACK", C.CloseBtn,
		UDim2.fromOffset(80, 34),
		UDim2.fromOffset(8, 4)
	)
	AnimUtil.WireButton(backBtn, function()
		SoundUtil.Click()
		hideDetailView()
	end)

	local detailTitle = Instance.new("TextLabel")
	detailTitle.Name = "DetailTitle"
	detailTitle.Size = UDim2.new(1, -100, 0, 34)
	detailTitle.Position = UDim2.fromOffset(96, 4)
	detailTitle.BackgroundTransparency = 1
	detailTitle.Font = Enum.Font.GothamBold
	detailTitle.TextColor3 = Color3.fromRGB(255, 255, 255)
	detailTitle.TextTransparency = 0
	detailTitle.TextSize = 18
	detailTitle.TextXAlignment = Enum.TextXAlignment.Left
	detailTitle.Text = "BUNDLE CONTENTS"
	detailTitle.ZIndex = 11
	detailTitle.Parent = detailHeader

	local dtStroke = Instance.new("UIStroke")
	dtStroke.Color = Color3.fromRGB(0, 0, 0)
	dtStroke.Thickness = 1.5
	dtStroke.Transparency = 0.1
	dtStroke.Parent = detailTitle

	selectorStrip = Instance.new("ScrollingFrame")
	selectorStrip.Name = "SelectorStrip"
	selectorStrip.Size = UDim2.new(0.30, -4, 1, -8)
	selectorStrip.Position = UDim2.new(0.70, 0, 0, 4)
	selectorStrip.BackgroundColor3 = STRIP_BG
	selectorStrip.BackgroundTransparency = 0.2
	selectorStrip.BorderSizePixel = 0
	selectorStrip.ScrollBarThickness = 4
	selectorStrip.ScrollBarImageColor3 = Color3.fromRGB(90, 95, 130)
	selectorStrip.CanvasSize = UDim2.fromScale(0, 0)
	selectorStrip.AutomaticCanvasSize = Enum.AutomaticSize.Y
	selectorStrip.ScrollingDirection = Enum.ScrollingDirection.Y
	selectorStrip.ZIndex = 5
	selectorStrip.Parent = bundleContainer

	local ssCorner = Instance.new("UICorner")
	ssCorner.CornerRadius = UDim.new(0, 12)
	ssCorner.Parent = selectorStrip

	local ssStroke = Instance.new("UIStroke")
	ssStroke.Color = Color3.fromRGB(55, 60, 90)
	ssStroke.Thickness = 1
	ssStroke.Transparency = 0.4
	ssStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	ssStroke.Parent = selectorStrip

	local ssPad = Instance.new("UIPadding")
	ssPad.PaddingTop = UDim.new(0, 6)
	ssPad.PaddingBottom = UDim.new(0, 6)
	ssPad.PaddingLeft = UDim.new(0, 6)
	ssPad.PaddingRight = UDim.new(0, 6)
	ssPad.Parent = selectorStrip

	local ssLayout = Instance.new("UIListLayout")
	ssLayout.FillDirection = Enum.FillDirection.Vertical
	ssLayout.Padding = UDim.new(0, 6)
	ssLayout.SortOrder = Enum.SortOrder.LayoutOrder
	ssLayout.Parent = selectorStrip

	selectorEntries = {}
	local allBundles = getBundlesForPanel()
	for i, bundle in ipairs(allBundles) do
		local entry = Instance.new("Frame")
		entry.Name = "Entry_" .. bundle.id
		entry.Size = UDim2.new(1, 0, 0, 72)
		entry.BackgroundColor3 = C.CardBg
		entry.BackgroundTransparency = 0
		entry.BorderSizePixel = 0
		entry.LayoutOrder = i
		entry.ZIndex = 6
		entry.Parent = selectorStrip

		local entryCorner = Instance.new("UICorner")
		entryCorner.CornerRadius = UDim.new(0, 8)
		entryCorner.Parent = entry

		local entryStroke = Instance.new("UIStroke")
		entryStroke.Color = C.CardStroke
		entryStroke.Thickness = 1.5
		entryStroke.Transparency = 0.3
		entryStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		entryStroke.Parent = entry

		local thumb = Instance.new("ImageLabel")
		thumb.Name = "Thumb"
		thumb.Size = UDim2.fromOffset(56, 56)
		thumb.Position = UDim2.fromOffset(8, 8)
		thumb.BackgroundColor3 = Color3.fromRGB(12, 14, 28)
		thumb.BorderSizePixel = 0
		thumb.ScaleType = Enum.ScaleType.Fit
		thumb.ZIndex = 7
		thumb.Parent = entry

		if bundle.coverImage and bundle.coverImage ~= "" then
			thumb.Image = bundle.coverImage
		else
			thumb.Image = ""
			local placeholder = Instance.new("TextLabel")
			placeholder.Size = UDim2.fromScale(1, 1)
			placeholder.BackgroundTransparency = 1
			placeholder.Font = Enum.Font.GothamBold
			placeholder.Text = "?"
			placeholder.TextColor3 = Color3.fromRGB(75, 80, 110)
			placeholder.TextSize = 28
			placeholder.ZIndex = 8
			placeholder.Parent = thumb
		end

		local thumbCorner = Instance.new("UICorner")
		thumbCorner.CornerRadius = UDim.new(0, 6)
		thumbCorner.Parent = thumb

		local nameLabel = Instance.new("TextLabel")
		nameLabel.Name = "BundleName"
		nameLabel.Size = UDim2.new(1, -76, 0, 20)
		nameLabel.Position = UDim2.fromOffset(70, 10)
		nameLabel.BackgroundTransparency = 1
		nameLabel.Font = Enum.Font.GothamBold
		nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
		nameLabel.TextTransparency = 0
		nameLabel.TextSize = 13
		nameLabel.TextXAlignment = Enum.TextXAlignment.Left
		nameLabel.TextTruncate = Enum.TextTruncate.AtEnd
		nameLabel.Text = bundle.displayName
		nameLabel.ZIndex = 7
		nameLabel.Parent = entry

		local ns = Instance.new("UIStroke")
		ns.Color = Color3.fromRGB(0, 0, 0)
		ns.Thickness = 1.2
		ns.Transparency = 0.15
		ns.Parent = nameLabel

		local tagText = ""
		if not bundle.isAvailable then
			tagText = "COMING SOON"
		elseif bundle.tag and bundle.tag ~= "" then
			tagText = bundle.tag
		end

		if tagText ~= "" then
			local tagBadge = Instance.new("TextLabel")
			tagBadge.Name = "Tag"
			tagBadge.Size = UDim2.new(1, -76, 0, 18)
			tagBadge.Position = UDim2.fromOffset(70, 34)
			tagBadge.BackgroundTransparency = 1
			tagBadge.Font = Enum.Font.GothamBold
			tagBadge.TextSize = 11
			tagBadge.TextXAlignment = Enum.TextXAlignment.Left
			tagBadge.TextTransparency = 0
			tagBadge.ZIndex = 7
			tagBadge.Parent = entry

			if not bundle.isAvailable then
				tagBadge.TextColor3 = C.TextMuted
				tagBadge.Text = "COMING SOON"
			else
				tagBadge.TextColor3 = C.Gold
				tagBadge.Text = bundle.tag
			end
		end

		local priceLabel = Instance.new("TextLabel")
		priceLabel.Name = "Price"
		priceLabel.Size = UDim2.new(1, -76, 0, 16)
		priceLabel.Position = UDim2.fromOffset(70, 52)
		priceLabel.BackgroundTransparency = 1
		priceLabel.Font = Enum.Font.GothamBold
		priceLabel.TextColor3 = C.Green
		priceLabel.TextTransparency = 0
		priceLabel.TextSize = 11
		priceLabel.TextXAlignment = Enum.TextXAlignment.Left
		local selectorOwned = false
		local isCoinBundle = COIN_BUNDLE_REQUEST_IDS[bundle.id] ~= nil
		if isCoinBundle then
			local state = getCoinBundleState(bundle)
			selectorOwned = state.missingCount &lt;= 0
		elseif bundle.gamepassId then
			local okS, ownsS = pcall(function()
				return MarketplaceService:UserOwnsGamePassAsync(LocalPlayer.UserId, bundle.gamepassId)
			end)
			selectorOwned = okS and ownsS == true
		end
		if selectorOwned then
			priceLabel.Text = "OWNED"
		elseif isCoinBundle then
			local state = getCoinBundleState(bundle)
			priceLabel.Text = string.format("%d F", state.finalCost)
		else
			priceLabel.Text = string.format("%d R$", bundle.priceRobux)
		end
		if selectorOwned then priceLabel.TextColor3 = C.TextMuted end
		priceLabel.ZIndex = 7
		priceLabel.Parent = entry

		local clickBtn = Instance.new("TextButton")
		clickBtn.Name = "ClickArea"
		clickBtn.Size = UDim2.fromScale(1, 1)
		clickBtn.BackgroundTransparency = 1
		clickBtn.Text = ""
		clickBtn.ZIndex = 10
		clickBtn.Parent = entry

		clickBtn.MouseButton1Click:Connect(function()
			SoundUtil.Click()
			selectBundle(bundle.id)
		end)

		selectorEntries[bundle.id] = entry
	end

	if allBundles[1] then
		selectBundle(allBundles[1].id)
	end
end

function BundlePanel.SelectBundle(bundleId: string)
	selectBundle(bundleId)
end

function BundlePanel.ShowItemPreviewIn(parent: Instance, itemData)
	externalPreviewHost = parent
	showItemPreview(itemData)
end

function BundlePanel.ClearContent()
	closeItemPreview()

	if bundleContainer then
		bundleContainer:Destroy()
		bundleContainer = nil
	end

	coverImage = nil
	titleLabel = nil
	viewBtn = nil
	buyBtn = nil
	heroFrame = nil
	detailFrame = nil
	selectorStrip = nil
	selectorEntries = {}
	selectedBundleId = ""
	inDetailView = false

	if contentParent then
		contentParent.AutomaticCanvasSize = Enum.AutomaticSize.Y
		contentParent.CanvasSize = UDim2.fromScale(0, 0)
		contentParent.ScrollBarThickness = 6
		contentParent.ScrollingDirection = Enum.ScrollingDirection.Y
	end
	contentParent = nil
	panelOptions = nil
	externalPreviewHost = nil
end

function BundlePanel.Show() end
function BundlePanel.Hide() end
function BundlePanel.IsVisible() return false end
function BundlePanel.Toggle() end

MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(a, b, c)
	local gamepassId: number? = nil
	local wasPurchased: boolean? = nil
	if typeof(a) == "Instance" and a:IsA("Player") then
		gamepassId = tonumber(b)
		wasPurchased = (c == true)
	else
		gamepassId = tonumber(a)
		wasPurchased = (b == true)
	end
	if wasPurchased and selectedBundleId and selectedBundleId ~= "" then
		task.wait(0.5)
		local remotes = ReplicatedStorage:FindFirstChild("Remotes")
		local verifyRF = remotes and remotes:FindFirstChild("VerifyGamepassPurchase")
		if verifyRF and gamepassId and gamepassId &gt; 0 then
			local okVerify, verifyResult = pcall(function()
				return verifyRF:InvokeServer(gamepassId)
			end)
			if okVerify and verifyResult and verifyResult.success then
				selectBundle(selectedBundleId)
			end
		end
	end
end)

return BundlePanel</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="113">
            <Properties>
              <string name="Name">Components</string>
              <string name="Source">--[[
	Components
	Reusable UI element factory functions.

	DARK + VIBRANT theme — front-page Roblox quality:
	  • Dark opaque panel backgrounds
	  • Visible stud texture overlay (lighter pattern on dark)
	  • PER-PANEL unique background animations (via UIStyle themes)
	  • Centered radial glow (soft bright circle, color from theme)
	  • Refined coloured borders (subtle, consistent)
	  • Glossy gradient on headers &amp; buttons
	  • High-contrast text with dark strokes
	  • Close button hover/press feedback (via UIStyle)

	Used by: every panel + HUDPanel + UIController
]]

local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local Shared = ReplicatedStorage:FindFirstChild("Shared") or ReplicatedStorage:WaitForChild("Shared", 5)
local UIConfig = require(Shared:WaitForChild("UIConfig"))
local ItemCatalog = require(Shared:WaitForChild("ItemCatalog"))
local ItemModelRegistry = require(Shared:WaitForChild("ItemModelRegistry"))

local Client = script.Parent
local AnimUtil  = require(Client:WaitForChild("AnimUtil"))
local SoundUtil = require(Client:WaitForChild("SoundUtil"))

-- UIStyle: instant load (NO blocking WaitForChild — never wait for UIStyle)
local _styleStart = tick()
local UIStyleModule = Client:FindFirstChild("UIStyle")
local UIStyle
if UIStyleModule then
	local ok, mod = pcall(require, UIStyleModule)
	if ok then
		UIStyle = mod
		print(string.format("[Components] UIStyle loaded instantly (%.0fms)", (tick() - _styleStart) * 1000))
	else
		warn("[Components] UIStyle failed to load:", mod, "— using built-in defaults")
	end
end
if not UIStyle then
	print(string.format("[Components] UIStyle not present — using built-in defaults (%.0fms, non-blocking)", (tick() - _styleStart) * 1000))
	UIStyle = {
		GetTheme = function(_themeName)
			return {
				accentColor   = Color3.fromRGB(72, 180, 255),
				glowColor     = Color3.fromRGB(75, 105, 195),
				glowAlpha     = 0.84,
				glowSize      = 1.4,
				bgAnimation   = "sunburst",
				sunburstSpeed = 8,
				sunburstAlpha = 0.85,
				sparkleCount  = 6,
				sparkleColor  = Color3.fromRGB(255, 255, 255),
			}
		end,
		ApplyBgAnimation = function() end,
		WireCloseButton = function() end,
	}
	-- Async: if UIStyle loads later, hot-swap it (non-blocking)
	task.spawn(function()
		local laterModule = Client:WaitForChild("UIStyle", 30)
		if laterModule then
			local ok2, mod2 = pcall(require, laterModule)
			if ok2 and mod2 then
				UIStyle = mod2
				print("[Components] UIStyle hot-swapped (loaded asynchronously)")
			end
		end
	end)
end

local C = UIConfig.Colors
local S = UIConfig.Sizes
local DEBUG_LOGS = RunService:IsStudio() and UIConfig.DebugLogs == true
local LOG_RATE_SECONDS = tonumber(UIConfig.LogRateSeconds) or 20
local _lastLogByKey: {[string]: number} = {}

local function shouldLog(key: string, minInterval: number?): boolean
	if not DEBUG_LOGS then
		return false
	end
	local now = tick()
	local interval = minInterval or LOG_RATE_SECONDS
	local last = _lastLogByKey[key] or 0
	if now - last &gt;= interval then
		_lastLogByKey[key] = now
		return true
	end
	return false
end

local Components = {}

-- ═══════════════════════════════════════════════════════════════════
-- INTERNAL HELPERS
-- ═══════════════════════════════════════════════════════════════════

--[[
	Subtle glossy sheen — white highlight at top, NO black darkening.
	This preserves the actual background color so buttons stay vibrant.
	topAlpha = how visible the white sheen is (lower = more visible)
]]
local function addGloss(frame: GuiObject, topAlpha: number?, _bottomAlpha: number?)
	topAlpha = topAlpha or 0.72
	local grad = Instance.new("UIGradient")
	grad.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 255)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 255, 255)),
	})
	grad.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, topAlpha),
		NumberSequenceKeypoint.new(0.4, 1),
		NumberSequenceKeypoint.new(1, 1),
	})
	grad.Rotation = 90
	grad.Parent = frame
end

--[[
	Strong glossy sheen for HEADER bars (brighter highlight).
]]
local function addHeaderGloss(frame: GuiObject)
	local grad = Instance.new("UIGradient")
	grad.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 255)),
		ColorSequenceKeypoint.new(0.5, Color3.fromRGB(220, 225, 240)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(0, 0, 0)),
	})
	grad.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.52),
		NumberSequenceKeypoint.new(0.35, 0.88),
		NumberSequenceKeypoint.new(0.65, 0.95),
		NumberSequenceKeypoint.new(1, 0.82),
	})
	grad.Rotation = 90
	grad.Parent = frame
end

--[[
	Offset drop-shadow behind a frame.
]]
local function addShadow(parent: GuiObject, radius: number?, ox: number?, oy: number?)
	radius = radius or S.PanelCorner + 8
	ox = ox or 3
	oy = oy or 6
	local shadow = Instance.new("Frame")
	shadow.Name = "DropShadow"
	shadow.AnchorPoint = Vector2.new(0.5, 0.5)
	shadow.Position = UDim2.new(0.5, ox, 0.5, oy)
	shadow.Size = UDim2.new(1, 20, 1, 20)
	shadow.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
	shadow.BackgroundTransparency = 0.48
	shadow.BorderSizePixel = 0
	shadow.ZIndex = 0
	shadow.Parent = parent
	local sc = Instance.new("UICorner")
	sc.CornerRadius = UDim.new(0, radius)
	sc.Parent = shadow
end

--[[
	Tileable stud texture overlay (lighter than dark bg = clearly visible).
]]
local function addStudTexture(parent: GuiObject, radius: number?)
	local tex = UIConfig.StudTexture
	local stud = Instance.new("ImageLabel")
	stud.Name = "StudTexture"
	stud.Size = UDim2.fromScale(1, 1)
	stud.BackgroundTransparency = 1
	stud.Image = tex.AssetId
	stud.ScaleType = Enum.ScaleType.Tile
	stud.TileSize = tex.TileSize
	stud.ImageTransparency = tex.Transparency
	stud.ImageColor3 = tex.Color
	stud.ZIndex = 1
	stud.Parent = parent
	if radius then
		local c = Instance.new("UICorner")
		c.CornerRadius = UDim.new(0, radius)
		c.Parent = stud
	end
end

-- Expose addStudTexture so other modules can add stud texture to backgrounds
Components.AddStudTexture = addStudTexture

--[[
	Centered radial glow — a big soft bright circle behind content.
	Creates a warm "spotlight" effect on the dark panel.
	Now accepts optional alpha and size from theme.
]]
local function addCenterGlow(parent: GuiObject, color: Color3?, alpha: number?, glowSize: number?)
	color = color or Color3.fromRGB(75, 105, 195)
	alpha = alpha or 0.84
	glowSize = glowSize or 1.4
	local glow = Instance.new("Frame")
	glow.Name = "CenterGlow"
	glow.Size = UDim2.new(glowSize, 0, glowSize * 0.85, 0)
	glow.AnchorPoint = Vector2.new(0.5, 0.5)
	glow.Position = UDim2.fromScale(0.5, 0.5)
	glow.BackgroundColor3 = color
	glow.BackgroundTransparency = alpha
	glow.BorderSizePixel = 0
	glow.ZIndex = 1
	glow.Parent = parent
	local gc = Instance.new("UICorner")
	gc.CornerRadius = UDim.new(0.5, 0)
	gc.Parent = glow

	-- Pulse
	local expandSize = glowSize + 0.1
	local shrinkSize = glowSize - 0.1
	task.spawn(function()
		while glow and glow.Parent do
			local t1 = TweenService:Create(glow, TweenInfo.new(3, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
				BackgroundTransparency = alpha,
				Size = UDim2.new(expandSize, 0, expandSize * 0.85, 0),
			})
			t1:Play()
			t1.Completed:Wait()
			local t2 = TweenService:Create(glow, TweenInfo.new(3, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
				BackgroundTransparency = alpha + 0.04,
				Size = UDim2.new(shrinkSize, 0, shrinkSize * 0.85, 0),
			})
			t2:Play()
			t2.Completed:Wait()
		end
	end)
end

--[[
	Slow-rotating "sunburst" light rays behind content.
	Now accepts optional speed and alpha from theme.
]]
local function addSunburst(parent: GuiObject, speed: number?, alpha: number?)
	speed = speed or (UIConfig.Anim.SunburstSpeed or 10)
	alpha = alpha or 0.85

	local burst = Instance.new("Frame")
	burst.Name = "Sunburst"
	burst.Size = UDim2.new(2.5, 0, 2.5, 0)
	burst.AnchorPoint = Vector2.new(0.5, 0.5)
	burst.Position = UDim2.fromScale(0.5, 0.5)
	burst.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	burst.BackgroundTransparency = alpha
	burst.BorderSizePixel = 0
	burst.ZIndex = 2
	burst.Parent = parent

	local grad = Instance.new("UIGradient")
	grad.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.58),
		NumberSequenceKeypoint.new(0.08, 0.96),
		NumberSequenceKeypoint.new(0.16, 0.62),
		NumberSequenceKeypoint.new(0.24, 0.96),
		NumberSequenceKeypoint.new(0.33, 0.58),
		NumberSequenceKeypoint.new(0.41, 0.96),
		NumberSequenceKeypoint.new(0.50, 0.62),
		NumberSequenceKeypoint.new(0.58, 0.96),
		NumberSequenceKeypoint.new(0.66, 0.58),
		NumberSequenceKeypoint.new(0.75, 0.96),
		NumberSequenceKeypoint.new(0.83, 0.62),
		NumberSequenceKeypoint.new(0.91, 0.96),
		NumberSequenceKeypoint.new(1, 0.58),
	})
	grad.Parent = burst

	local conn
	conn = RunService.Heartbeat:Connect(function(dt)
		if not burst.Parent then
			conn:Disconnect()
			return
		end
		grad.Rotation = (grad.Rotation + dt * speed) % 360
	end)
end

--[[
	Floating sparkle dots that fade in/out at random positions.
	Now accepts optional sparkle color from theme.
]]
local function addSparkles(parent: GuiObject, count: number?, sparkleColor: Color3?)
	count = count or 6
	sparkleColor = sparkleColor or Color3.fromRGB(255, 255, 255)
	for i = 1, count do
		local sparkle = Instance.new("Frame")
		sparkle.Name = "Sparkle" .. i
		sparkle.Size = UDim2.fromOffset(3, 3)
		sparkle.AnchorPoint = Vector2.new(0.5, 0.5)
		sparkle.Position = UDim2.fromScale(math.random() * 0.8 + 0.1, math.random() * 0.8 + 0.1)
		sparkle.BackgroundColor3 = sparkleColor
		sparkle.BackgroundTransparency = 1
		sparkle.BorderSizePixel = 0
		sparkle.ZIndex = 3
		sparkle.Parent = parent

		local sc = Instance.new("UICorner")
		sc.CornerRadius = UDim.new(1, 0)
		sc.Parent = sparkle

		task.spawn(function()
			task.wait(math.random() * 2)
			while sparkle and sparkle.Parent do
				sparkle.Position = UDim2.fromScale(math.random() * 0.8 + 0.1, math.random() * 0.8 + 0.1)
				local fadeIn = TweenService:Create(sparkle, TweenInfo.new(0.6, Enum.EasingStyle.Quad), {
					BackgroundTransparency = 0.20,
					Size = UDim2.fromOffset(6, 6),
				})
				fadeIn:Play()
				fadeIn.Completed:Wait()
				local fadeOut = TweenService:Create(sparkle, TweenInfo.new(0.6, Enum.EasingStyle.Quad), {
					BackgroundTransparency = 1,
					Size = UDim2.fromOffset(3, 3),
				})
				fadeOut:Play()
				fadeOut.Completed:Wait()
				task.wait(math.random() * 2 + 0.8)
			end
		end)
	end
end

-- ═══════════════════════════════════════════════════════════════════
-- SCREEN GUI
-- ═══════════════════════════════════════════════════════════════════

function Components.CreateScreenGui(name: string, displayOrder: number): ScreenGui
	local gui = Instance.new("ScreenGui")
	gui.Name = name
	gui.ResetOnSpawn = false
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.DisplayOrder = displayOrder
	gui.IgnoreGuiInset = false
	gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
	return gui
end

-- ═══════════════════════════════════════════════════════════════════
-- DIM OVERLAY
-- ═══════════════════════════════════════════════════════════════════

function Components.CreateDimOverlay(parent: Instance, onClose: () -&gt; ()): Frame
	-- Invisible full-screen click blocker that sits ABOVE all HUD elements
	-- (ZIndex 4) but BELOW the panel canvas (ZIndex 5).
	-- This prevents stray clicks on HUD buttons from reaching through to the
	-- underlying HUD while any panel is open, which would trigger a panel switch
	-- mid-purchase and fire the close animation on the wrong frame.
	local overlay = Instance.new("TextButton")
	overlay.Name = "DimOverlay"
	overlay.Size = UDim2.fromScale(1, 1)
	overlay.Position = UDim2.fromScale(0, 0)
	overlay.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
	overlay.BackgroundTransparency = 1  -- invisible but fully blocks input
	overlay.BorderSizePixel = 0
	overlay.Text = ""
	overlay.AutoButtonColor = false
	overlay.Active = true               -- must be true to intercept clicks
	overlay.ZIndex = 4                  -- above HUD (2-3), below canvas (5)
	overlay.Visible = false
	overlay.Parent = parent
	overlay.MouseButton1Click:Connect(function()
		SoundUtil.Close()
		if onClose then onClose() end
	end)
	return overlay
end

-- ═══════════════════════════════════════════════════════════════════
-- PANEL  (dark opaque bg + stud texture + coloured border + theme-specific animation)
-- 4th param: themeName (optional) — e.g. "Shop", "Crate", "Spectate"
-- Uses UIStyle to select unique background animation per panel.
-- Returns: canvasGroup, uiScale, contentScroll, closeBtn
-- ═══════════════════════════════════════════════════════════════════

function Components.CreatePanel(parent: Instance, title: string, headerColor: Color3?, themeName: string?)
	-- Resolve theme from UIStyle (defaults to "Default" if not provided)
	local theme = UIStyle.GetTheme(themeName or "Default")

	-- Use theme accent if no explicit headerColor was passed
	headerColor = headerColor or theme.accentColor or C.HeaderShop

	-- Canvas root (dark, opaque)
	local canvas = Instance.new("CanvasGroup")
	canvas.Name = title:gsub("[^%w]", "") .. "Panel"
	canvas.AnchorPoint = Vector2.new(0.5, 0.5)
	canvas.Position = UDim2.fromScale(0.5, 0.5)
	canvas.Size = UDim2.fromScale(S.PanelWidth, S.PanelHeight)
	canvas.BackgroundColor3 = C.PanelBg
	canvas.BackgroundTransparency = 0
	canvas.BorderSizePixel = 0
	canvas.GroupTransparency = 1
	canvas.Visible = false
	canvas.ZIndex = 5
	canvas.ClipsDescendants = true
	canvas.Parent = parent

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, S.PanelCorner)
	corner.Parent = canvas

	-- Refined coloured border (thinner, more transparent)
	local stroke = Instance.new("UIStroke")
	stroke.Color = headerColor
	stroke.Thickness = S.PanelStroke
	stroke.Transparency = 0.1
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent = canvas

	-- Drop shadow
	addShadow(canvas, S.PanelCorner + 8, 4, 8)

	-- Stud texture (visible on dark)
	addStudTexture(canvas, S.PanelCorner)

	-- Center glow (color + alpha from theme)
	addCenterGlow(canvas, theme.glowColor, theme.glowAlpha, theme.glowSize)

	-- ─── THEME-SPECIFIC BACKGROUND ANIMATION ───
	-- Instead of always sunburst+sparkles, each panel gets its own animation.
	local bgAnim = theme.bgAnimation or "sunburst"

	if bgAnim == "sunburst" then
		-- Classic rotating light rays
		addSunburst(canvas, theme.sunburstSpeed, theme.sunburstAlpha)
		addSparkles(canvas, theme.sparkleCount, theme.sparkleColor)
	elseif bgAnim == "none" then
		-- Clean / minimal — no animated background (Settings)
	else
		-- Use UIStyle's animated variants (shimmer, waves, stars, bubbles)
		UIStyle.ApplyBgAnimation(canvas, theme)
		-- Still add themed sparkles for most panels (except "none")
		if theme.sparkleCount and theme.sparkleCount &gt; 0 then
			addSparkles(canvas, theme.sparkleCount, theme.sparkleColor)
		end
	end

	-- UIScale for open/close animation
	local uiScale = Instance.new("UIScale")
	uiScale.Scale = UIConfig.Anim.OpenStartScale
	uiScale.Parent = canvas

	-- ─── GLOSSY HEADER ───
	local header = Instance.new("Frame")
	header.Name = "Header"
	header.Size = UDim2.new(1, 0, 0, S.PanelHeaderHeight)
	header.Position = UDim2.fromScale(0, 0)
	header.BackgroundColor3 = headerColor
	header.BorderSizePixel = 0
	header.ZIndex = 6
	header.Parent = canvas

	local hCorner = Instance.new("UICorner")
	hCorner.CornerRadius = UDim.new(0, S.PanelCorner)
	hCorner.Parent = header

	-- Mask bottom corners of header (so top corners round, bottom stays flat)
	local hMask = Instance.new("Frame")
	hMask.Name = "BottomMask"
	hMask.Size = UDim2.new(1, 0, 0, S.PanelCorner)
	hMask.Position = UDim2.new(0, 0, 1, -S.PanelCorner)
	hMask.BackgroundColor3 = headerColor
	hMask.BorderSizePixel = 0
	hMask.ZIndex = 6
	hMask.Parent = header

	addHeaderGloss(header)

	-- Header bottom highlight line (softer)
	local hLine = Instance.new("Frame")
	hLine.Name = "HighlightLine"
	hLine.Size = UDim2.new(1, -28, 0, 1)
	hLine.Position = UDim2.new(0, 14, 1, -1)
	hLine.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	hLine.BackgroundTransparency = 0.6
	hLine.BorderSizePixel = 0
	hLine.ZIndex = 7
	hLine.Parent = header

	-- Title text
	local titleLabel = Instance.new("TextLabel")
	titleLabel.Name = "Title"
	titleLabel.Size = UDim2.new(1, -S.CloseBtnSize - 32, 1, 0)
	titleLabel.Position = UDim2.fromOffset(22, 0)
	titleLabel.BackgroundTransparency = 1
	titleLabel.Font = Enum.Font.GothamBold
	titleLabel.TextColor3 = C.TextWhite
	titleLabel.TextSize = 30
	titleLabel.TextXAlignment = Enum.TextXAlignment.Left
	titleLabel.Text = title
	titleLabel.ZIndex = 7
	titleLabel.Parent = header
	local ts = Instance.new("UIStroke")
	ts.Color = Color3.fromRGB(0, 0, 0)
	ts.Thickness = 1.8
	ts.Transparency = 0.18
	ts.Parent = titleLabel

	-- Close button (red circle with white X)
	local closeBtn = Instance.new("TextButton")
	closeBtn.Name = "CloseBtn"
	closeBtn.AnchorPoint = Vector2.new(1, 0.5)
	closeBtn.Position = UDim2.new(1, -10, 0.5, 0)
	closeBtn.Size = UDim2.fromOffset(S.CloseBtnSize, S.CloseBtnSize)
	closeBtn.BackgroundColor3 = C.CloseBtn
	closeBtn.Font = Enum.Font.GothamBold
	closeBtn.Text = "X"
	closeBtn.TextColor3 = C.TextWhite
	closeBtn.TextSize = 26
	closeBtn.BorderSizePixel = 0
	closeBtn.AutoButtonColor = false
	closeBtn.ZIndex = 8
	closeBtn.Parent = header
	local cbCorner = Instance.new("UICorner")
	cbCorner.CornerRadius = UDim.new(0, S.CloseBtnSize / 2)
	cbCorner.Parent = closeBtn
	local cbStroke = Instance.new("UIStroke")
	cbStroke.Color = Color3.fromRGB(255, 255, 255)
	cbStroke.Thickness = 2
	cbStroke.Transparency = 0.35
	cbStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	cbStroke.Parent = closeBtn

	-- Close button hover/press feedback (via UIStyle)
	UIStyle.WireCloseButton(closeBtn, theme)

	-- Content scrolling area
	local content = Instance.new("ScrollingFrame")
	content.Name = "Content"
	content.Size = UDim2.new(1, -24, 1, -(S.PanelHeaderHeight + 18))
	content.Position = UDim2.new(0, 12, 0, S.PanelHeaderHeight + 8)
	content.BackgroundTransparency = 1
	content.BorderSizePixel = 0
	content.ScrollBarThickness = 5
	content.ScrollBarImageColor3 = Color3.fromRGB(75, 82, 108)
	content.CanvasSize = UDim2.fromScale(0, 0)
	content.AutomaticCanvasSize = Enum.AutomaticSize.Y
	content.ScrollingDirection = Enum.ScrollingDirection.Y
	content.ZIndex = 5
	content.Parent = canvas

	-- Safe padding at top/bottom to prevent content clipping at edges
	local contentPadding = Instance.new("UIPadding")
	contentPadding.PaddingTop = UDim.new(0, 4)
	contentPadding.PaddingBottom = UDim.new(0, 12)
	contentPadding.Parent = content

	return canvas, uiScale, content, closeBtn
end

-- ═══════════════════════════════════════════════════════════════════
-- TAB BAR  (for Premium Shop categories, Index tabs, etc.)
-- Returns: Frame, updateActive(index) function
-- ═══════════════════════════════════════════════════════════════════

function Components.CreateTabBar(parent: Instance, tabs: {{label: string}}, onSelect: (number) -&gt; ()): (Frame, (number) -&gt; ())
	local bar = Instance.new("Frame")
	bar.Name = "TabBar"
	bar.Size = UDim2.new(1, -20, 0, S.TabHeight + 8)
	bar.BackgroundTransparency = 1
	bar.BorderSizePixel = 0
	bar.ZIndex = 6
	bar.Parent = parent

	local layout = Instance.new("UIListLayout")
	layout.FillDirection = Enum.FillDirection.Horizontal
	layout.Padding = UDim.new(0, 6)
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.VerticalAlignment = Enum.VerticalAlignment.Center
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = bar

	local tabButtons: {TextButton} = {}

	for i, tab in ipairs(tabs) do
		local btn = Instance.new("TextButton")
		btn.Name = "Tab_" .. tab.label
		btn.Size = UDim2.fromOffset(math.max(#tab.label * 9 + 26, 72), S.TabHeight)
		btn.BackgroundColor3 = C.TabInactive
		btn.Font = Enum.Font.GothamBold
		btn.TextColor3 = C.TabTextInactive
		btn.TextSize = 15
		btn.Text = tab.label
		btn.BorderSizePixel = 0
		btn.AutoButtonColor = false
		btn.LayoutOrder = i
		btn.ZIndex = 6
		btn.Parent = bar

		local btnCorner = Instance.new("UICorner")
		btnCorner.CornerRadius = UDim.new(0, S.TabCorner)
		btnCorner.Parent = btn

		local btnStroke = Instance.new("UIStroke")
		btnStroke.Color = Color3.fromRGB(255, 255, 255)
		btnStroke.Thickness = 1.5
		btnStroke.Transparency = 0.7
		btnStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		btnStroke.Parent = btn

		tabButtons[i] = btn

		AnimUtil.WireButton(btn, function()
			SoundUtil.Click()
			onSelect(i)
		end)
	end

	local function updateActive(activeIdx: number)
		for i, btn in ipairs(tabButtons) do
			local stroke = btn:FindFirstChildWhichIsA("UIStroke")
			if i == activeIdx then
				btn.BackgroundColor3 = C.TabActive
				btn.TextColor3 = C.TabTextActive
				if stroke then
					stroke.Color = Color3.fromRGB(255, 255, 255)
					stroke.Transparency = 0.2
					stroke.Thickness = 2
				end
			else
				btn.BackgroundColor3 = C.TabInactive
				btn.TextColor3 = C.TabTextInactive
				if stroke then
					stroke.Color = Color3.fromRGB(255, 255, 255)
					stroke.Transparency = 0.75
					stroke.Thickness = 1.5
				end
			end
		end
	end

	return bar, updateActive
end

-- ═══════════════════════════════════════════════════════════════════
-- ITEM CARD  (dark bg, vibrant rarity border, glossy icon, white text)
-- Now supports optional `image` field — shows ImageLabel when provided,
-- falls back to text icon otherwise.
-- ═══════════════════════════════════════════════════════════════════

export type CardConfig = {
	name: string,
	rarity: string,
	iconColor: Color3,
	iconText: string?,
	image: string?,
	locked: boolean?,
	owned: boolean?,
	equipped: boolean?,
	actionText: string?,
	actionColor: Color3?,
	tag: string?,
	onAction: (() -&gt; ())?,
}

function Components.CreateItemCard(parent: Instance, data: CardConfig): Frame
	local rarityInfo = UIConfig.RarityInfo[data.rarity] or UIConfig.RarityInfo.Common
	local rarityColor = rarityInfo.color

	local card = Instance.new("Frame")
	card.Name = "Card_" .. data.name
	card.Size = UDim2.fromOffset(S.CardWidth, S.CardHeight)
	card.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
	card.BackgroundTransparency = 0
	card.BorderSizePixel = 0
	card.Parent = parent

	local cc = Instance.new("UICorner")
	cc.CornerRadius = UDim.new(0, S.CardCorner)
	cc.Parent = card

	local cStroke = Instance.new("UIStroke")
	cStroke.Color = data.locked and Color3.fromRGB(42, 45, 62) or rarityColor
	cStroke.Thickness = data.locked and 1.5 or 2.5
	cStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	cStroke.Transparency = data.locked and 0.4 or 0.1
	cStroke.Parent = card

	addStudTexture(card, S.CardCorner)

	local iconFrame = Instance.new("Frame")
	iconFrame.Name = "Icon"
	iconFrame.Size = UDim2.new(1, -16, 0, 90)
	iconFrame.Position = UDim2.fromOffset(8, 8)
	iconFrame.BorderSizePixel = 0
	iconFrame.ClipsDescendants = true
	iconFrame.Parent = card
	local iCorner = Instance.new("UICorner")
	iCorner.CornerRadius = UDim.new(0, 10)
	iCorner.Parent = iconFrame

	-- Consistent internal padding for the thumbnail window
	local iPadding = Instance.new("UIPadding")
	iPadding.PaddingLeft   = UDim.new(0, 6)
	iPadding.PaddingRight  = UDim.new(0, 6)
	iPadding.PaddingTop    = UDim.new(0, 6)
	iPadding.PaddingBottom = UDim.new(0, 6)
	iPadding.Parent = iconFrame

	local displayText = data.iconText or string.sub(data.name, 1, 1)

	if data.locked then
		iconFrame.BackgroundColor3 = Color3.fromRGB(0, 0, 0)

		if data.image and data.image ~= "" then
			-- Locked item with a static asset-id image: show it dimmed
			local img = Instance.new("ImageLabel")
			img.Name = "ItemImage"
			img.Size = UDim2.fromScale(1, 1)
			img.Position = UDim2.fromScale(0, 0)
			img.BackgroundTransparency = 1
			img.Image = data.image
			img.ScaleType = Enum.ScaleType.Crop
			img.ImageColor3 = Color3.fromRGB(80, 80, 80)
			img.ImageTransparency = 0.15
			img.ZIndex = 2
			img.Parent = iconFrame
			local imgCorner = Instance.new("UICorner")
			imgCorner.CornerRadius = UDim.new(0, 6)
			imgCorner.Parent = img

			-- Lock icon overlay
			local lockLabel = Instance.new("TextLabel")
			lockLabel.Name = "LockIcon"
			lockLabel.Size = UDim2.fromOffset(32, 32)
			lockLabel.AnchorPoint = Vector2.new(0.5, 0.5)
			lockLabel.Position = UDim2.fromScale(0.5, 0.5)
			lockLabel.BackgroundTransparency = 1
			lockLabel.Font = Enum.Font.GothamBold
			lockLabel.Text = ""
			lockLabel.TextColor3 = Color3.fromRGB(160, 165, 190)
			lockLabel.TextSize = 28
			lockLabel.ZIndex = 3
			lockLabel.Parent = iconFrame
		else
			local q = Instance.new("TextLabel")
			q.Size = UDim2.fromScale(1, 1)
			q.BackgroundTransparency = 1
			q.Font = Enum.Font.GothamBold
			q.Text = "?"
			q.TextColor3 = Color3.fromRGB(55, 58, 80)
			q.TextSize = 42
			q.Parent = iconFrame
			local qs = Instance.new("UIStroke")
			qs.Color = Color3.fromRGB(0, 0, 0)
			qs.Thickness = 1.5
			qs.Transparency = 0.35
			qs.Parent = q
		end
	else
		-- Fully black icon area — rarity only shown via card border stroke
		iconFrame.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
		iconFrame.BackgroundTransparency = 0

		if data.image and data.image ~= "" then
			local img = Instance.new("ImageLabel")
			img.Name = "ItemImage"
			img.Size = UDim2.fromScale(1, 1)
			img.Position = UDim2.fromScale(0, 0)
			img.BackgroundTransparency = 1
			img.Image = data.image
			img.ScaleType = Enum.ScaleType.Crop
			img.ZIndex = 2
			img.Parent = iconFrame
			-- Round the image corners to match the thumbnail window
			local imgCorner = Instance.new("UICorner")
			imgCorner.CornerRadius = UDim.new(0, 6)
			imgCorner.Parent = img
		else
			local letter = Instance.new("TextLabel")
			letter.Name = "Letter"
			letter.Size = UDim2.fromScale(1, 1)
			letter.BackgroundTransparency = 1
			letter.Font = Enum.Font.GothamBold
			letter.Text = displayText
			letter.TextColor3 = Color3.fromRGB(255, 255, 255)
			letter.TextSize = 34
			letter.TextTransparency = 0.02
			letter.Parent = iconFrame
			local ls = Instance.new("UIStroke")
			ls.Color = Color3.fromRGB(0, 0, 0)
			ls.Thickness = 1.8
			ls.Transparency = 0.2
			ls.Parent = letter
		end
	end

	if data.tag and data.tag ~= "" then
		local tagBadge = Instance.new("TextLabel")
		tagBadge.Name = "Tag"
		tagBadge.AnchorPoint = Vector2.new(0.5, 0)
		tagBadge.Position = UDim2.new(0.5, 0, 0, -8)
		tagBadge.Size = UDim2.fromOffset(math.max(#data.tag * 8 + 18, 48), 22)
		tagBadge.BackgroundColor3 = C.Gold
		tagBadge.Font = Enum.Font.GothamBold
		tagBadge.TextColor3 = Color3.fromRGB(62, 40, 0)
		tagBadge.TextSize = 12
		tagBadge.Text = data.tag
		tagBadge.BorderSizePixel = 0
		tagBadge.ZIndex = 10
		tagBadge.Parent = card
		local tc = Instance.new("UICorner")
		tc.CornerRadius = UDim.new(0, 7)
		tc.Parent = tagBadge
		local tcs = Instance.new("UIStroke")
		tcs.Color = Color3.fromRGB(175, 138, 0)
		tcs.Thickness = 1.5
		tcs.Transparency = 0.35
		tcs.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		tcs.Parent = tagBadge
	end

	if data.equipped then
		local check = Instance.new("TextLabel")
		check.Name = "Equipped"
		check.AnchorPoint = Vector2.new(1, 0)
		check.Position = UDim2.new(1, -4, 0, 4)
		check.Size = UDim2.fromOffset(26, 26)
		check.BackgroundColor3 = C.Green
		check.Font = Enum.Font.GothamBold
		check.Text = "\xe2\x9c\x93"
		check.TextColor3 = C.TextWhite
		check.TextSize = 15
		check.BorderSizePixel = 0
		check.ZIndex = 10
		check.Parent = card
		local chc = Instance.new("UICorner")
		chc.CornerRadius = UDim.new(1, 0)
		chc.Parent = check
		local chs = Instance.new("UIStroke")
		chs.Color = Color3.fromRGB(255, 255, 255)
		chs.Thickness = 1.5
		chs.Transparency = 0.3
		chs.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		chs.Parent = check
	end

	local nameLabel = Instance.new("TextLabel")
	nameLabel.Name = "ItemName"
	nameLabel.Size = UDim2.new(1, -10, 0, 18)
	nameLabel.Position = UDim2.new(0, 5, 0, 100)
	nameLabel.BackgroundTransparency = 1
	nameLabel.Font = Enum.Font.GothamBold
	nameLabel.TextColor3 = data.locked and Color3.fromRGB(130, 135, 155) or C.TextWhite
	nameLabel.TextSize = 12
	nameLabel.TextScaled = false
	nameLabel.TextWrapped = false
	nameLabel.TextTruncate = Enum.TextTruncate.AtEnd
	nameLabel.TextXAlignment = Enum.TextXAlignment.Center
	nameLabel.Text = data.name or "MISSING ITEM"
	nameLabel.Parent = card
	do
		local ns = Instance.new("UIStroke")
		ns.Color = Color3.fromRGB(0, 0, 0)
		ns.Thickness = 1.5
		ns.Transparency = 0.15
		ns.Parent = nameLabel
	end

	local rarLabel = Instance.new("TextLabel")
	rarLabel.Name = "Rarity"
	rarLabel.Size = UDim2.new(1, -10, 0, 16)
	rarLabel.Position = UDim2.new(0, 5, 0, 119)
	rarLabel.BackgroundTransparency = 1
	rarLabel.Font = Enum.Font.GothamBold
	rarLabel.TextColor3 = data.locked and Color3.fromRGB(100, 105, 125) or rarityColor
	rarLabel.TextSize = 12
	rarLabel.TextXAlignment = Enum.TextXAlignment.Center
	rarLabel.Text = rarityInfo.label
	rarLabel.Parent = card

	if data.subLabel and data.subLabel ~= "" then
		local subLbl = Instance.new("TextLabel")
		subLbl.Name = "SubLabel"
		subLbl.Size = UDim2.new(1, -10, 0, 14)
		subLbl.Position = UDim2.new(0, 5, 0, 135)
		subLbl.BackgroundTransparency = 1
		subLbl.Font = Enum.Font.GothamBold
		subLbl.TextColor3 = data.locked and Color3.fromRGB(100, 105, 135) or C.TextMuted
		subLbl.TextSize = 11
		subLbl.TextXAlignment = Enum.TextXAlignment.Center
		subLbl.Text = data.subLabel
		subLbl.Parent = card
	end

	if data.actionText and not data.locked then
		local btnColor = data.actionColor or C.BuyButton
		local btn = Instance.new("TextButton")
		btn.Name = "ActionBtn"
		btn.AnchorPoint = Vector2.new(0.5, 1)
		btn.Position = UDim2.new(0.5, 0, 1, -8)
		btn.Size = UDim2.new(1, -16, 0, 42)
		btn.BackgroundColor3 = btnColor
		btn.Font = Enum.Font.GothamBold
		btn.TextColor3 = C.TextWhite
		btn.TextSize = 15
		btn.Text = data.actionText
		btn.BorderSizePixel = 0
		btn.AutoButtonColor = false
		btn.Parent = card
		local bc = Instance.new("UICorner")
		bc.CornerRadius = UDim.new(0, S.SmBtnCorner)
		bc.Parent = btn

		local abr, abg, abb = btnColor.R, btnColor.G, btnColor.B
		local lighterAB = Color3.new(
			math.min(abr + 0.20, 1),
			math.min(abg + 0.20, 1),
			math.min(abb + 0.20, 1)
		)
		local darkerAB = Color3.new(
			math.max(abr - 0.10, 0),
			math.max(abg - 0.10, 0),
			math.max(abb - 0.10, 0)
		)
		local abGrad = Instance.new("UIGradient")
		abGrad.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, lighterAB),
			ColorSequenceKeypoint.new(0.5, btnColor),
			ColorSequenceKeypoint.new(1, darkerAB),
		})
		abGrad.Rotation = 90
		abGrad.Parent = btn

		local bs = Instance.new("UIStroke")
		bs.Color = Color3.fromRGB(255, 255, 255)
		bs.Thickness = 1.5
		bs.Transparency = 0.4
		bs.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		bs.Parent = btn

		local bts = Instance.new("UIStroke")
		bts.Color = Color3.fromRGB(0, 0, 0)
		bts.Thickness = 1.5
		bts.Transparency = 0.12
		bts.Parent = btn

		AnimUtil.WireButton(btn, function()
			SoundUtil.Click()
			if data.onAction then data.onAction() end
		end)
	end

	return card
end

-- ═══════════════════════════════════════════════════════════════════
-- CRATE SECTION  (for walk-up Crate Shop — big icon, drops, buy buttons)
-- ═══════════════════════════════════════════════════════════════════

export type CrateData = {
	name: string,
	iconColor: Color3,
	accentColor: Color3?,
	drops: {{ name: string, chance: number, rarity: string }},
	prices: {{ label: string, cost: number, currency: string }},
	onBuy: ((priceIndex: number) -&gt; ())?,
}

function Components.CreateCrateSection(parent: Instance, data: CrateData): Frame
	local accent = data.accentColor or data.iconColor

	local section = Instance.new("Frame")
	section.Name = "Crate_" .. data.name
	section.Size = UDim2.new(1, -20, 0, S.CrateSectionHeight)
	section.BackgroundColor3 = C.CardBg
	section.BorderSizePixel = 0
	section.Parent = parent
	local sc = Instance.new("UICorner")
	sc.CornerRadius = UDim.new(0, S.CardCorner)
	sc.Parent = section
	local ss = Instance.new("UIStroke")
	ss.Color = accent
	ss.Thickness = 2.5
	ss.Transparency = 0.12
	ss.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	ss.Parent = section

	addGloss(section, 0.82, 0.94)

	addStudTexture(section, S.CardCorner)

	local iconArea = Instance.new("Frame")
	iconArea.Name = "IconArea"
	iconArea.Size = UDim2.new(0, 120, 1, -14)
	iconArea.Position = UDim2.fromOffset(7, 7)
	iconArea.BackgroundColor3 = data.iconColor
	iconArea.BorderSizePixel = 0
	iconArea.Parent = section
	local iac = Instance.new("UICorner")
	iac.CornerRadius = UDim.new(0, 14)
	iac.Parent = iconArea
	addGloss(iconArea, 0.38, 0.75)
	local ias = Instance.new("UIStroke")
	ias.Color = Color3.fromRGB(255, 255, 255)
	ias.Thickness = 1.5
	ias.Transparency = 0.5
	ias.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	ias.Parent = iconArea

	local crateImg = Instance.new("ImageLabel")
	crateImg.Name = "CrateImage"
	crateImg.AnchorPoint = Vector2.new(0.5, 0)
	crateImg.Size = UDim2.new(0.78, 0, 0, 70)
	crateImg.Position = UDim2.new(0.5, 0, 0, 12)
	crateImg.BackgroundTransparency = 1
	crateImg.Image = "rbxassetid://108812530080296"
	crateImg.ScaleType = Enum.ScaleType.Fit
	crateImg.ImageTransparency = 0
	crateImg.ZIndex = 2
	crateImg.Parent = iconArea

	local crateName = Instance.new("TextLabel")
	crateName.Name = "Name"
	crateName.AnchorPoint = Vector2.new(0.5, 1)
	crateName.Position = UDim2.new(0.5, 0, 1, -10)
	crateName.Size = UDim2.new(1, -8, 0, 34)
	crateName.BackgroundTransparency = 1
	crateName.Font = Enum.Font.GothamBold
	crateName.TextColor3 = C.TextWhite
	crateName.TextSize = 15
	crateName.Text = data.name
	crateName.TextWrapped = true
	crateName.Parent = iconArea
	local cns = Instance.new("UIStroke")
	cns.Color = Color3.fromRGB(0, 0, 0)
	cns.Thickness = 1.5
	cns.Transparency = 0.22
	cns.Parent = crateName

	local titleR = Instance.new("TextLabel")
	titleR.Name = "Title"
	titleR.Size = UDim2.new(1, -150, 0, 28)
	titleR.Position = UDim2.fromOffset(138, 10)
	titleR.BackgroundTransparency = 1
	titleR.Font = Enum.Font.GothamBold
	titleR.TextColor3 = C.TextWhite
	titleR.TextSize = 19
	titleR.TextXAlignment = Enum.TextXAlignment.Left
	titleR.Text = data.name
	titleR.Parent = section
	local trs = Instance.new("UIStroke")
	trs.Color = Color3.fromRGB(0, 0, 0)
	trs.Thickness = 1.5
	trs.Transparency = 0.22
	trs.Parent = titleR

	for i, drop in ipairs(data.drops) do
		local dRarity = UIConfig.RarityInfo[drop.rarity] or UIConfig.RarityInfo.Common
		local dLabel = Instance.new("TextLabel")
		dLabel.Name = "Drop" .. i
		dLabel.Size = UDim2.new(0, 220, 0, 20)
		dLabel.Position = UDim2.fromOffset(138, 36 + (i - 1) * 22)
		dLabel.BackgroundTransparency = 1
		dLabel.Font = Enum.Font.GothamBold
		dLabel.TextColor3 = dRarity.color
		dLabel.TextSize = 14
		dLabel.TextXAlignment = Enum.TextXAlignment.Left
		dLabel.Text = string.format("%d%%  %s", drop.chance, drop.name)
		dLabel.Parent = section
		local ds = Instance.new("UIStroke")
		ds.Color = Color3.fromRGB(0, 0, 0)
		ds.Thickness = 1.2
		ds.Transparency = 0.18
		ds.Parent = dLabel
	end

	local btnRow = Instance.new("Frame")
	btnRow.Name = "BuyButtons"
	btnRow.AnchorPoint = Vector2.new(0, 1)
	btnRow.Position = UDim2.new(0, 138, 1, -10)
	btnRow.Size = UDim2.new(1, -150, 0, 54)
	btnRow.BackgroundTransparency = 1
	btnRow.BorderSizePixel = 0
	btnRow.Parent = section

	local bLayout = Instance.new("UIListLayout")
	bLayout.FillDirection = Enum.FillDirection.Horizontal
	bLayout.Padding = UDim.new(0, 8)
	bLayout.SortOrder = Enum.SortOrder.LayoutOrder
	bLayout.VerticalAlignment = Enum.VerticalAlignment.Bottom
	bLayout.Parent = btnRow

	for pi, price in ipairs(data.prices) do
		local isRobux = price.currency == "Robux"
		local priceText = isRobux and string.format("%d ROBUX", price.cost) or string.format("F %d", price.cost)
		local btnColor = isRobux and C.RobuxButton or C.BuyButton

		local pBtn = Instance.new("TextButton")
		pBtn.Name = "Price" .. pi
		pBtn.Size = UDim2.fromOffset(110, 54)
		pBtn.BackgroundColor3 = btnColor
		pBtn.Font = Enum.Font.GothamBold
		pBtn.TextColor3 = C.TextWhite
		pBtn.TextSize = 15
		pBtn.Text = priceText .. "\n" .. price.label
		pBtn.TextYAlignment = Enum.TextYAlignment.Center
		pBtn.BorderSizePixel = 0
		pBtn.AutoButtonColor = false
		pBtn.LayoutOrder = pi
		pBtn.Parent = btnRow
		local pbc = Instance.new("UICorner")
		pbc.CornerRadius = UDim.new(0, S.SmBtnCorner)
		pbc.Parent = pBtn

		local br, bg, bb = btnColor.R, btnColor.G, btnColor.B
		local lighterBtn = Color3.new(
			math.min(br + 0.20, 1),
			math.min(bg + 0.20, 1),
			math.min(bb + 0.20, 1)
		)
		local darkerBtn = Color3.new(
			math.max(br - 0.12, 0),
			math.max(bg - 0.12, 0),
			math.max(bb - 0.12, 0)
		)
		local pbGrad = Instance.new("UIGradient")
		pbGrad.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, lighterBtn),
			ColorSequenceKeypoint.new(0.5, btnColor),
			ColorSequenceKeypoint.new(1, darkerBtn),
		})
		pbGrad.Rotation = 90
		pbGrad.Parent = pBtn

		local pbs = Instance.new("UIStroke")
		pbs.Color = Color3.fromRGB(255, 255, 255)
		pbs.Thickness = 1.5
		pbs.Transparency = 0.4
		pbs.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		pbs.Parent = pBtn

		local pbts = Instance.new("UIStroke")
		pbts.Color = Color3.fromRGB(0, 0, 0)
		pbts.Thickness = 1.2
		pbts.Transparency = 0.18
		pbts.Parent = pBtn

		AnimUtil.WireButton(pBtn, function()
			SoundUtil.Click()
			if data.onBuy then data.onBuy(pi) end
		end)
	end

	return section
end

-- ═══════════════════════════════════════════════════════════════════
-- GRID LAYOUT  (for item cards)
-- ═══════════════════════════════════════════════════════════════════

function Components.AddGridLayout(parent: Instance, cellSize: Vector2?, padding: number?): UIGridLayout
	cellSize = cellSize or Vector2.new(S.CardWidth, S.CardHeight)
	padding = padding or S.CardPad
	local grid = Instance.new("UIGridLayout")
	grid.CellSize = UDim2.fromOffset(cellSize.X, cellSize.Y)
	grid.CellPadding = UDim2.fromOffset(padding, padding)
	grid.SortOrder = Enum.SortOrder.LayoutOrder
	grid.FillDirection = Enum.FillDirection.Horizontal
	grid.HorizontalAlignment = Enum.HorizontalAlignment.Center
	grid.Parent = parent
	local pad = Instance.new("UIPadding")
	pad.PaddingTop = UDim.new(0, 10)
	pad.PaddingBottom = UDim.new(0, 10)
	pad.PaddingLeft = UDim.new(0, 8)
	pad.PaddingRight = UDim.new(0, 8)
	pad.Parent = parent
	return grid
end

-- ═══════════════════════════════════════════════════════════════════
-- LIST LAYOUT  (for crate sections, stacked vertically)
-- ═══════════════════════════════════════════════════════════════════

function Components.AddListLayout(parent: Instance, padding: number?)
	padding = padding or 14
	local list = Instance.new("UIListLayout")
	list.SortOrder = Enum.SortOrder.LayoutOrder
	list.Padding = UDim.new(0, padding)
	list.FillDirection = Enum.FillDirection.Vertical
	list.HorizontalAlignment = Enum.HorizontalAlignment.Center
	list.Parent = parent
	local pad = Instance.new("UIPadding")
	pad.PaddingTop = UDim.new(0, 10)
	pad.PaddingBottom = UDim.new(0, 10)
	pad.PaddingLeft = UDim.new(0, 8)
	pad.PaddingRight = UDim.new(0, 8)
	pad.Parent = parent
end

-- ═══════════════════════════════════════════════════════════════════
-- SIDEBAR BUTTON  (dark, chunky, glossy — refined strokes)
-- ═══════════════════════════════════════════════════════════════════

function Components.CreateSideButton(parent: Instance, label: string, iconText: string, bgColor: Color3, layoutOrder: number, onClick: () -&gt; (), iconImage: string?): TextButton
	local btn = Instance.new("TextButton")
	btn.Name = "Side_" .. label
	btn.Size = UDim2.fromOffset(S.SideBtnW, S.SideBtnH)
	btn.BackgroundColor3 = bgColor
	btn.BorderSizePixel = 0
	btn.AutoButtonColor = false
	btn.Text = ""
	btn.LayoutOrder = layoutOrder
	btn.Parent = parent

	local co = Instance.new("UICorner")
	co.CornerRadius = UDim.new(0, S.SideBtnCorner)
	co.Parent = btn

	local st = Instance.new("UIStroke")
	st.Color = Color3.fromRGB(255, 255, 255)
	st.Thickness = 2.5
	st.Transparency = 0.28
	st.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	st.Parent = btn

	local r, g, b = bgColor.R, bgColor.G, bgColor.B
	local lighterColor = Color3.new(
		math.min(r + 0.22, 1),
		math.min(g + 0.22, 1),
		math.min(b + 0.22, 1)
	)
	local darkerColor = Color3.new(
		math.max(r - 0.10, 0),
		math.max(g - 0.10, 0),
		math.max(b - 0.10, 0)
	)
	local sideGrad = Instance.new("UIGradient")
	sideGrad.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, lighterColor),
		ColorSequenceKeypoint.new(0.5, bgColor),
		ColorSequenceKeypoint.new(1, darkerColor),
	})
	sideGrad.Rotation = 90
	sideGrad.Parent = btn

	local shadow = Instance.new("Frame")
	shadow.Name = "Shadow"
	shadow.AnchorPoint = Vector2.new(0.5, 0.5)
	shadow.Position = UDim2.new(0.5, 2, 0.5, 4)
	shadow.Size = UDim2.new(1, 10, 1, 10)
	shadow.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
	shadow.BackgroundTransparency = 0.5
	shadow.BorderSizePixel = 0
	shadow.ZIndex = 0
	shadow.Parent = btn
	local shc = Instance.new("UICorner")
	shc.CornerRadius = UDim.new(0, S.SideBtnCorner + 4)
	shc.Parent = shadow

	if iconImage and iconImage ~= "" then
		local icon = Instance.new("ImageLabel")
		icon.Name = "Icon"
		icon.AnchorPoint = Vector2.new(0.5, 0.5)
		icon.Size = UDim2.fromOffset(math.floor(S.SideBtnW * 0.68), math.floor(S.SideBtnH * 0.68))
		icon.Position = UDim2.fromScale(0.5, 0.45)
		icon.BackgroundTransparency = 1
		icon.Image = iconImage
		icon.ImageColor3 = Color3.fromRGB(255, 255, 255)
		icon.ScaleType = Enum.ScaleType.Fit
		icon.ResampleMode = Enum.ResamplerMode.Default
		icon.ZIndex = 2
		icon.Parent = btn
		local ar = Instance.new("UIAspectRatioConstraint")
		ar.AspectRatio = 1
		ar.Parent = icon
	else
		local icon = Instance.new("TextLabel")
		icon.Name = "Icon"
		icon.Size = UDim2.new(1, 0, 0, 40)
		icon.Position = UDim2.fromOffset(0, 6)
		icon.BackgroundTransparency = 1
		icon.Font = Enum.Font.GothamBold
		icon.TextColor3 = C.TextWhite
		icon.TextSize = 36
		icon.Text = iconText
		icon.ZIndex = 2
		icon.Parent = btn
		local is = Instance.new("UIStroke")
		is.Color = Color3.fromRGB(0, 0, 0)
		is.Thickness = 2
		is.Transparency = 0.15
		is.Parent = icon
	end

	local lbl = Instance.new("TextLabel")
	lbl.Name = "Label"
	lbl.Size = UDim2.new(1, 0, 0, 20)
	lbl.Position = UDim2.new(0, 0, 1, -24)
	lbl.BackgroundTransparency = 1
	lbl.Font = Enum.Font.GothamBold
	lbl.TextColor3 = C.TextWhite
	lbl.TextSize = 14
	lbl.Text = label
	lbl.ZIndex = 2
	lbl.Parent = btn
	local ls = Instance.new("UIStroke")
	ls.Color = Color3.fromRGB(0, 0, 0)
	ls.Thickness = 1.5
	ls.Transparency = 0.2
	ls.Parent = lbl

	AnimUtil.WireButton(btn, function()
		SoundUtil.Click()
		onClick()
	end)

	return btn
end

-- ═══════════════════════════════════════════════════════════════════
-- VIEWPORT ITEM CARD  (3D model preview via ViewportFrame)
-- ═══════════════════════════════════════════════════════════════════

--[[
	Creates an item card with a ViewportFrame showing the 3D model.
	Falls back to emoji/text if model not found in ReplicatedStorage.

	config fields (extends CardConfig):
	  modelPath: string  — dot-separated path in ReplicatedStorage
	  All other fields from CardConfig are supported.
]]

-- Model resolution via ItemModelRegistry (single source of truth, case-insensitive)
local function resolveModelPath(modelPath: string): Instance?
	if not modelPath or modelPath == "" then return nil end
	return ItemModelRegistry.Get(modelPath)
end

local function isInsideThumbnailVFX(part: Instance, root: Instance): boolean
	local parent = part.Parent
	while parent and parent ~= root do
		if parent:IsA("Folder") and parent.Name == "ThumbnailVFX" then return true end
		parent = parent.Parent
	end
	return false
end

local function getModelBounds(model: Instance): (Vector3, Vector3)
	-- Priority A: ThumbnailCameraTarget overrides everything
	local camTarget = model:FindFirstChild("ThumbnailCameraTarget", true)
	if camTarget and camTarget:IsA("BasePart") then
		local p, h = camTarget.Position, camTarget.Size / 2
		return
			Vector3.new(p.X - h.X, p.Y - h.Y, p.Z - h.Z),
			Vector3.new(p.X + h.X, p.Y + h.Y, p.Z + h.Z)
	end

	-- Priority B: PrimaryPart if model has one
	if model:IsA("Model") and model.PrimaryPart then
		local pp = model.PrimaryPart
		local p, h = pp.Position, pp.Size / 2
		return
			Vector3.new(p.X - h.X, p.Y - h.Y, p.Z - h.Z),
			Vector3.new(p.X + h.X, p.Y + h.Y, p.Z + h.Z)
	end

	-- Priority C: All visible BaseParts, excluding ThumbnailVFX contents
	local minBound = Vector3.new(math.huge, math.huge, math.huge)
	local maxBound = Vector3.new(-math.huge, -math.huge, -math.huge)

	local function proc(part: BasePart)
		local pos = part.Position
		local halfSize = part.Size / 2
		minBound = Vector3.new(
			math.min(minBound.X, pos.X - halfSize.X),
			math.min(minBound.Y, pos.Y - halfSize.Y),
			math.min(minBound.Z, pos.Z - halfSize.Z)
		)
		maxBound = Vector3.new(
			math.max(maxBound.X, pos.X + halfSize.X),
			math.max(maxBound.Y, pos.Y + halfSize.Y),
			math.max(maxBound.Z, pos.Z + halfSize.Z)
		)
	end

	if model:IsA("BasePart") then proc(model) end
	for _, desc in ipairs(model:GetDescendants()) do
		if desc:IsA("BasePart") and not isInsideThumbnailVFX(desc, model) then
			proc(desc)
		end
	end

	if minBound.X == math.huge then
		return Vector3.zero, Vector3.new(2, 2, 2)
	end

	return minBound, maxBound
end

local function setupViewportCamera(viewport: ViewportFrame, model: Instance, distanceMult: number?)
	local minB, maxB = getModelBounds(model)
	local center = (minB + maxB) / 2
	local size = maxB - minB
	local maxDim = math.max(size.X, size.Y, size.Z, 1)

	-- Wider framing: pull camera back so items are not overly zoomed in
	local distance = maxDim * (distanceMult or 2.0)
	local cameraPos = center + Vector3.new(distance * 0.5, distance * 0.35, distance * 0.8)

	local cam = Instance.new("Camera")
	cam.CameraType = Enum.CameraType.Scriptable
	cam.CFrame = CFrame.lookAt(cameraPos, center)
	cam.FieldOfView = 50
	cam.Parent = viewport

	viewport.CurrentCamera = cam
end

--- Safe clone: strips unsafe instances, anchors parts, keeps VFX for viewport rendering
local function cloneModelForViewport(modelInstance: Instance): Instance
	local clone = modelInstance:Clone()
	local descendants = clone:GetDescendants()

	for _, d in ipairs(descendants) do
		-- Strip scripts (can run code, cause errors)
		if d:IsA("Script") or d:IsA("LocalScript") or d:IsA("ModuleScript") then
			d:Destroy()
		-- Strip humanoids / animation controllers
		elseif d:IsA("Humanoid") or d:IsA("Animator") or d:IsA("AnimationController") then
			d:Destroy()
		-- Anchor all parts and disable collision
		elseif d:IsA("BasePart") then
			d.Anchored = true
			d.CanCollide = false
		end
	end

	return clone
end

-- VFX classes that indicate an item has visual effects
-- (VFX detect/proxy removed — static images with baked VFX are used instead)

--- Reposition a cloned model to the origin for proper framing in a ViewportFrame
local function resetModelPosition(clone: Instance)
	if clone:IsA("Model") and clone.PrimaryPart then
		clone:PivotTo(CFrame.new())
	elseif clone:IsA("BasePart") then
		clone.Position = Vector3.zero
	elseif clone:IsA("Model") then
		local firstPart = clone:FindFirstChildWhichIsA("BasePart", true)
		if firstPart then
			local offset = firstPart.Position
			for _, desc in ipairs(clone:GetDescendants()) do
				if desc:IsA("BasePart") then
					desc.Position = desc.Position - offset
				end
			end
		end
	end
end

-- Per-item thumbnail yaw correction (degrees) for viewport cards.
-- Rotates the model so its "face" points toward the camera. ONLY for thumbnails.
local CARD_THUMBNAIL_YAW: { [string]: number } = {
	pet_dog = 180,
}

-- Keep card thumbnails aligned with ThumbnailRenderer behavior.
local CARD_THUMBNAIL_OFFSET_CFRAME: { [string]: CFrame } = {
	pet_foxy_plush = CFrame.Angles(0, math.rad(180), 0),
	pet_chica_plush = CFrame.Angles(0, math.rad(180), 0),
	pet_freddy_plush = CFrame.Angles(0, math.rad(180), 0),
	pet_bonnie_plush = CFrame.Angles(0, math.rad(180), 0),
	pet_fredbear_plush = CFrame.new(),
	pet_huggy_wuggy = CFrame.new(),
}

local CARD_THUMBNAIL_DISTANCE_MULT: { [string]: number } = {
	pet_fredbear_plush = 2.8,
}

function Components.CreateViewportItemCard(parent: Instance, data): Frame
	local petEntry = (data and data.id and ItemCatalog.GetPet) and ItemCatalog.GetPet(data.id) or nil
	local isFNAFPet = petEntry and petEntry.collection == "FNAF"
	-- Hard rule: FNAF pets are always static-image cards (no ThumbnailRenderer).
	if isFNAFPet then
		local staticImage = data.image
		if staticImage == nil or staticImage == "" then
			staticImage = ItemCatalog.GetImage(petEntry)
		end
		local safeData = table.clone(data)
		safeData.image = staticImage or ""
		safeData.modelPath = nil
		if shouldLog("fnaf_static_components", 20) then
			print("[FNAFImages] Using static images (ThumbnailRenderer disabled for FNAF).")
		end
		return Components.CreateItemCard(parent, safeData)
	end

	-- ── Prefer explicit image (static screenshots with VFX baked in) ──
	-- If the catalog entry has an image, use CreateItemCard (ImageLabel) instead
	-- of the heavier 3D viewport path. This gives the best visual fidelity and
	-- eliminates the need for VFX proxy hacks.
	local hasExplicitImage = data.image and data.image ~= ""
	if hasExplicitImage then
		if shouldLog("components_static_image", 20) then
			print(string.format("[Components] STATIC image for %s", data.name or data.id or "?"))
		end
		return Components.CreateItemCard(parent, data)
	end

	-- Try to resolve the model for 3D rendering fallback
	local modelInstance = data.modelPath and resolveModelPath(data.modelPath) or nil
	local hasModel = modelInstance ~= nil

	-- If no model either, fall back to regular CreateItemCard
	if not hasModel then
		return Components.CreateItemCard(parent, data)
	end

	local rarityInfo = UIConfig.RarityInfo[data.rarity] or UIConfig.RarityInfo.Common
	local rarityColor = rarityInfo.color

	local card = Instance.new("Frame")
	card.Name = "Card_" .. (data.name or "Item")
	card.Size = UDim2.fromOffset(S.CardWidth, S.CardHeight)
	card.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
	card.BackgroundTransparency = 0
	card.BorderSizePixel = 0
	card.Parent = parent

	local cc = Instance.new("UICorner")
	cc.CornerRadius = UDim.new(0, S.CardCorner)
	cc.Parent = card

	local cStroke = Instance.new("UIStroke")
	cStroke.Color = data.locked and Color3.fromRGB(42, 45, 62) or rarityColor
	cStroke.Thickness = data.locked and 1.5 or 2.5
	cStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	cStroke.Transparency = data.locked and 0.4 or 0.1
	cStroke.Parent = card

	addStudTexture(card, S.CardCorner)

	-- ── ViewportFrame for 3D model preview (no-image fallback only) ──
	local vpFrame = Instance.new("ViewportFrame")
	vpFrame.Name = "ModelPreview"
	vpFrame.Size = UDim2.new(1, -16, 0, 90)
	vpFrame.Position = UDim2.fromOffset(8, 8)
	vpFrame.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
	vpFrame.BackgroundTransparency = 0
	vpFrame.BorderSizePixel = 0
	vpFrame.Ambient = Color3.fromRGB(180, 180, 200)
	vpFrame.LightColor = Color3.fromRGB(255, 255, 255)
	vpFrame.LightDirection = Vector3.new(-1, -1, -1)
	vpFrame.Parent = card

	local vpCorner = Instance.new("UICorner")
	vpCorner.CornerRadius = UDim.new(0, 10)
	vpCorner.Parent = vpFrame

	-- Clone model into viewport (no VFX proxy — images with VFX are preferred)
	do
		local clone = cloneModelForViewport(modelInstance)
		resetModelPosition(clone)

		-- Per-item thumbnail yaw correction (only rotates specific items).
		local thumbYaw = CARD_THUMBNAIL_YAW[data.id or ""] or 0
		if thumbYaw ~= 0 then
			local rot = CFrame.Angles(0, math.rad(thumbYaw), 0)
			if clone:IsA("Model") then
				for _, d in ipairs(clone:GetDescendants()) do
					if d:IsA("BasePart") then
						d.CFrame = rot * d.CFrame
					end
				end
			elseif clone:IsA("BasePart") then
				clone.CFrame = rot * clone.CFrame
			end
		end

		local thumbOffset = CARD_THUMBNAIL_OFFSET_CFRAME[data.id or ""]
		if thumbOffset then
			if clone:IsA("Model") then
				for _, d in ipairs(clone:GetDescendants()) do
					if d:IsA("BasePart") then
						d.CFrame = thumbOffset * d.CFrame
					end
				end
			elseif clone:IsA("BasePart") then
				clone.CFrame = thumbOffset * clone.CFrame
			end
		end
		local distMult = CARD_THUMBNAIL_DISTANCE_MULT[data.id or ""] or 2.0
		if data.id == "pet_fredbear_plush" or data.id == "pet_huggy_wuggy" then
			print(string.format("[ThumbRender] pet=%s yaw=%d scale=%.2f",
				tostring(data.name or data.id),
				thumbYaw,
				distMult))
		end

		clone.Parent = vpFrame
		setupViewportCamera(vpFrame, clone, distMult)
	end

	if data.locked then
		-- Desaturate the viewport for locked items
		vpFrame.ImageColor3 = Color3.fromRGB(90, 90, 90)
		vpFrame.ImageTransparency = 0.15

		-- Semi-transparent dark overlay
		local lockOverlay = Instance.new("Frame")
		lockOverlay.Name = "LockOverlay"
		lockOverlay.Size = UDim2.fromScale(1, 1)
		lockOverlay.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
		lockOverlay.BackgroundTransparency = 0.55
		lockOverlay.BorderSizePixel = 0
		lockOverlay.ZIndex = 2
		lockOverlay.Parent = vpFrame
		local olCorner = Instance.new("UICorner")
		olCorner.CornerRadius = UDim.new(0, 10)
		olCorner.Parent = lockOverlay

		-- Lock icon on top
		local lockLabel = Instance.new("TextLabel")
		lockLabel.Size = UDim2.fromOffset(32, 32)
		lockLabel.AnchorPoint = Vector2.new(0.5, 0.5)
		lockLabel.Position = UDim2.fromScale(0.5, 0.5)
		lockLabel.BackgroundTransparency = 1
		lockLabel.Font = Enum.Font.GothamBold
		lockLabel.Text = ""
		lockLabel.TextColor3 = Color3.fromRGB(160, 165, 190)
		lockLabel.TextSize = 28
		lockLabel.ZIndex = 3
		lockLabel.Parent = vpFrame
	end

	-- Equipped badge
	if data.equipped then
		local check = Instance.new("TextLabel")
		check.Name = "Equipped"
		check.AnchorPoint = Vector2.new(1, 0)
		check.Position = UDim2.new(1, -4, 0, 4)
		check.Size = UDim2.fromOffset(26, 26)
		check.BackgroundColor3 = C.Green
		check.Font = Enum.Font.GothamBold
		check.Text = "\xe2\x9c\x93"
		check.TextColor3 = C.TextWhite
		check.TextSize = 15
		check.BorderSizePixel = 0
		check.ZIndex = 10
		check.Parent = card
		local chc = Instance.new("UICorner")
		chc.CornerRadius = UDim.new(1, 0)
		chc.Parent = check
	end

	-- Tag badge
	if data.tag and data.tag ~= "" then
		local tagBadge = Instance.new("TextLabel")
		tagBadge.Name = "Tag"
		tagBadge.AnchorPoint = Vector2.new(0.5, 0)
		tagBadge.Position = UDim2.new(0.5, 0, 0, -8)
		tagBadge.Size = UDim2.fromOffset(math.max(#data.tag * 8 + 18, 48), 22)
		tagBadge.BackgroundColor3 = C.Gold
		tagBadge.Font = Enum.Font.GothamBold
		tagBadge.TextColor3 = Color3.fromRGB(62, 40, 0)
		tagBadge.TextSize = 12
		tagBadge.Text = data.tag
		tagBadge.BorderSizePixel = 0
		tagBadge.ZIndex = 10
		tagBadge.Parent = card
		local tc = Instance.new("UICorner")
		tc.CornerRadius = UDim.new(0, 7)
		tc.Parent = tagBadge
	end

	-- Name label
	local nameLabel = Instance.new("TextLabel")
	nameLabel.Name = "ItemName"
	nameLabel.Size = UDim2.new(1, -10, 0, 18)
	nameLabel.Position = UDim2.new(0, 5, 0, 100)
	nameLabel.BackgroundTransparency = 1
	nameLabel.Font = Enum.Font.GothamBold
	nameLabel.TextColor3 = data.locked and Color3.fromRGB(130, 135, 155) or C.TextWhite
	nameLabel.TextSize = 12
	nameLabel.TextScaled = false
	nameLabel.TextWrapped = false
	nameLabel.TextTruncate = Enum.TextTruncate.AtEnd
	nameLabel.TextXAlignment = Enum.TextXAlignment.Center
	nameLabel.Text = data.name or "MISSING ITEM"
	nameLabel.Parent = card
	do
		local ns = Instance.new("UIStroke")
		ns.Color = Color3.fromRGB(0, 0, 0)
		ns.Thickness = 1.5
		ns.Transparency = 0.15
		ns.Parent = nameLabel
	end

	-- Rarity label
	local rarLabel = Instance.new("TextLabel")
	rarLabel.Name = "Rarity"
	rarLabel.Size = UDim2.new(1, -10, 0, 16)
	rarLabel.Position = UDim2.new(0, 5, 0, 119)
	rarLabel.BackgroundTransparency = 1
	rarLabel.Font = Enum.Font.GothamBold
	rarLabel.TextColor3 = data.locked and Color3.fromRGB(100, 105, 125) or rarityColor
	rarLabel.TextSize = 12
	rarLabel.TextXAlignment = Enum.TextXAlignment.Center
	rarLabel.Text = rarityInfo.label
	rarLabel.Parent = card

	-- Sub-label (e.g. "20 Wins", "Crown Crate", "Shop Only")
	if data.subLabel and data.subLabel ~= "" then
		local subLbl = Instance.new("TextLabel")
		subLbl.Name = "SubLabel"
		subLbl.Size = UDim2.new(1, -10, 0, 14)
		subLbl.Position = UDim2.new(0, 5, 0, 135)
		subLbl.BackgroundTransparency = 1
		subLbl.Font = Enum.Font.GothamBold
		subLbl.TextColor3 = data.locked and Color3.fromRGB(100, 105, 135) or C.TextMuted
		subLbl.TextSize = 11
		subLbl.TextXAlignment = Enum.TextXAlignment.Center
		subLbl.Text = data.subLabel
		subLbl.Parent = card
	end

	-- Action button
	if data.actionText and not data.locked then
		local btnColor = data.actionColor or C.BuyButton
		local btn = Instance.new("TextButton")
		btn.Name = "ActionBtn"
		btn.AnchorPoint = Vector2.new(0.5, 1)
		btn.Position = UDim2.new(0.5, 0, 1, -8)
		btn.Size = UDim2.new(1, -16, 0, 42)
		btn.BackgroundColor3 = btnColor
		btn.Font = Enum.Font.GothamBold
		btn.TextColor3 = C.TextWhite
		btn.TextSize = 15
		btn.Text = data.actionText
		btn.BorderSizePixel = 0
		btn.AutoButtonColor = false
		btn.Parent = card
		local bc = Instance.new("UICorner")
		bc.CornerRadius = UDim.new(0, S.SmBtnCorner)
		bc.Parent = btn

		local abr, abg, abb = btnColor.R, btnColor.G, btnColor.B
		local lighterAB = Color3.new(
			math.min(abr + 0.20, 1), math.min(abg + 0.20, 1), math.min(abb + 0.20, 1)
		)
		local darkerAB = Color3.new(
			math.max(abr - 0.10, 0), math.max(abg - 0.10, 0), math.max(abb - 0.10, 0)
		)
		local abGrad = Instance.new("UIGradient")
		abGrad.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, lighterAB),
			ColorSequenceKeypoint.new(0.5, btnColor),
			ColorSequenceKeypoint.new(1, darkerAB),
		})
		abGrad.Rotation = 90
		abGrad.Parent = btn

		local bs = Instance.new("UIStroke")
		bs.Color = Color3.fromRGB(255, 255, 255)
		bs.Thickness = 1.5
		bs.Transparency = 0.4
		bs.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		bs.Parent = btn

		AnimUtil.WireButton(btn, function()
			SoundUtil.Click()
			if data.onAction then data.onAction() end
		end)
	end

	return card
end

--- Create a small ViewportFrame thumbnail (for crate preview slots)
function Components.CreateViewportThumbnail(parent: Instance, modelPath: string, size: UDim2?, bgColor: Color3?, fallbackText: string?): ViewportFrame
	local vpFrame = Instance.new("ViewportFrame")
	vpFrame.Name = "Thumbnail"
	vpFrame.Size = size or UDim2.fromOffset(60, 60)
	vpFrame.BackgroundColor3 = bgColor or C.CardBgDark
	vpFrame.BackgroundTransparency = 0.2
	vpFrame.BorderSizePixel = 0
	vpFrame.Ambient = Color3.fromRGB(180, 180, 200)
	vpFrame.LightColor = Color3.fromRGB(255, 255, 255)
	vpFrame.LightDirection = Vector3.new(-1, -1, -1)
	vpFrame.Parent = parent

	local vpCorner = Instance.new("UICorner")
	vpCorner.CornerRadius = UDim.new(0, 8)
	vpCorner.Parent = vpFrame

	local modelInstance = resolveModelPath(modelPath)
	if modelInstance then
		local clone = cloneModelForViewport(modelInstance)
		resetModelPosition(clone)
		clone.Parent = vpFrame
		setupViewportCamera(vpFrame, clone)
	else
		-- Fallback: show text/emoji if model not found
		local fb = Instance.new("TextLabel")
		fb.Name = "Fallback"
		fb.Size = UDim2.fromScale(1, 1)
		fb.BackgroundTransparency = 1
		fb.Font = Enum.Font.GothamBold
		fb.Text = fallbackText or "?"
		fb.TextColor3 = C.TextMuted
		fb.TextSize = 24
		fb.TextXAlignment = Enum.TextXAlignment.Center
		fb.TextYAlignment = Enum.TextYAlignment.Center
		fb.Parent = vpFrame
	end

	return vpFrame
end

-- ═══════════════════════════════════════════════════════════════════
-- RESPONSIVE SCALE  (viewport-adaptive UIScale on ScreenGuis)
-- Width-only baseline so PC (1920) stays at scale 1.0.
-- Mobile touch devices get a slight boost so tap targets remain large.
-- ═══════════════════════════════════════════════════════════════════

function Components.SetupResponsiveScale(screenGui: ScreenGui)
	local existing = screenGui:FindFirstChild("ResponsiveScale")
	if existing then return end
	local uiScale = Instance.new("UIScale")
	uiScale.Name = "ResponsiveScale"
	uiScale.Scale = 1
	uiScale.Parent = screenGui
end

return Components</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="114">
            <Properties>
              <string name="Name">CrateRevealUI</string>
              <string name="Source"><![CDATA[--[[
	CrateRevealUI
	Thin wrapper around RewardPopup (sibling in Client.UI folder).
	Preserves existing API so CrateShopPanel doesn't need changes.

	API:
	  CrateRevealUI.Init(screenGui)      -- no-op
	  CrateRevealUI.ShowReward(data)      -- single reward → RewardPopup.Show
	  CrateRevealUI.ShowRewards(items)    -- batch rewards → RewardPopup.ShowBatch

	Used by: CrateShopPanel
]]

local RewardPopup = nil
pcall(function()
	RewardPopup = require(script.Parent:WaitForChild("RewardPopup", 5))
end)

if not RewardPopup then
	warn("[CrateRevealUI] RewardPopup module not found in Client.UI — crate reveal disabled")
end

local CrateRevealUI = {}

function CrateRevealUI.Init(_screenGui)
	-- No-op: RewardPopup creates its own ScreenGui
end

function CrateRevealUI.ShowReward(data)
	if not data then return end
	if not RewardPopup then
		warn("[CrateRevealUI] RewardPopup not available")
		return
	end
	RewardPopup.Show({
		icon       = data.image or "",
		title      = "YOU WON!",
		name       = data.name or "MISSING ITEM",
		rarityText = data.rarity or "Common",
		okText     = "CLAIM",
		onDismiss  = nil,
		itemId     = data.itemId or "",
		itemType   = data.itemType or "",
		category   = data.category or "",
		iconText   = data.iconText or "",
		iconColor  = data.iconColor,
	})
end

-- Batch reveal for multi-crate purchases (3 or 6 crates)
function CrateRevealUI.ShowRewards(items)
	if not items or #items == 0 then return end
	if not RewardPopup then
		warn("[CrateRevealUI] RewardPopup not available")
		return
	end

	local mapped = {}
	for _, data in ipairs(items) do
		table.insert(mapped, {
			icon       = data.image or "",
			title      = "YOU WON!",
			name       = data.name or "MISSING ITEM",
			rarityText = data.rarity or "Common",
			itemId     = data.itemId or "",
			itemType   = data.itemType or "",
			category   = data.category or "",
			iconText   = data.iconText or "",
			iconColor  = data.iconColor,
			isDuplicate = data.isDuplicate or false,
		})
	end

	RewardPopup.ShowBatch(mapped)
end

return CrateRevealUI
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="115">
            <Properties>
              <string name="Name">CrateShopPanel</string>
              <string name="Source"><![CDATA[--[[
	CrateShopPanel
	Lobby crate shop UI — redesigned with 4 crate sections:
	  • Crown Crate (purple) — all Findable crowns
	  • Common Crate (green) — Common pets
	  • Rare Crate (blue) — Rare pets
	  • Epic Crate (purple) — Epic pets

	Each section shows:
	  • Left: Big ViewportFrame showing a representative model
	  • Right-top: All preview thumbnails with item names + drop % (horizontal scroll)
	  • Right-bottom: 3 buy buttons

	Reward popups are shown only from server-confirmed RewardGranted events.

	Used by: UIController (walk-up proximity or OpenCrateShop RemoteEvent)
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local MarketplaceService = game:GetService("MarketplaceService")

local Shared = ReplicatedStorage:WaitForChild("Shared", 60)
if not Shared then
	warn("[CrateShopPanel] Shared not found after 60s -- disabled")
	return { Init = function() end, Show = function() end, Hide = function() end,
		IsVisible = function() return false end, Toggle = function() end }
end

local CDPModule = Shared:WaitForChild("ClientDepsProvider", 60)
if not CDPModule then
	warn("[CrateShopPanel] ClientDepsProvider MISSING")
	return { Init = function() end, Show = function() end, Hide = function() end,
		IsVisible = function() return false end, Toggle = function() end }
end

local ok, Deps = pcall(require, CDPModule)
if not ok or not Deps then
	warn("[CrateShopPanel] require(ClientDepsProvider) FAILED:", Deps)
	return { Init = function() end, Show = function() end, Hide = function() end,
		IsVisible = function() return false end, Toggle = function() end }
end
local UIConfig = Deps.UIConfig
local ItemCatalog = Deps.ItemCatalog

local Client = script.Parent
local AnimUtil          = require(Client:WaitForChild("AnimUtil"))
local SoundUtil         = require(Client:WaitForChild("SoundUtil"))
local Components        = require(Client:WaitForChild("Components"))
local ThumbnailRenderer = require(Client:WaitForChild("ThumbnailRenderer"))

-- Lazy-load CrateRevealUI (created in same folder)
local _CrateRevealUI = nil
local function getRevealUI()
	if _CrateRevealUI then return _CrateRevealUI end
	local mod = Client:FindFirstChild("CrateRevealUI")
	if mod then
		local okReq, result = pcall(require, mod)
		if okReq then _CrateRevealUI = result end
	end
	return _CrateRevealUI
end

local C = UIConfig.Colors
local S = UIConfig.Sizes

local canvas: CanvasGroup = nil
local uiScale: UIScale = nil
local overlay: Frame = nil
local visible = false
local closeCallback: (() -> ())? = nil
local _inventoryUpdatedConn: RBXScriptConnection? = nil
local _crateCountLabels: { [string]: TextLabel } = {}
local _crateCounts: { [string]: number } = {}
local _pendingRobuxCrateBuys: { [string]: number } = {}
local _pendingRobuxCrateBuyExpiresAt: { [string]: number } = {}
local _buyOpenBusyByCrate: { [string]: boolean } = {}

local CrateShopPanel = {}

-- ═══════════════════════════════════════════════════════════════════
-- HELPERS
-- ═══════════════════════════════════════════════════════════════════

local function getOpenCrateFunc(): RemoteFunction?
	local remotes = ReplicatedStorage:FindFirstChild("Remotes")
	if not remotes then return nil end
	return remotes:FindFirstChild("OpenCrate")
end

local function getBuyCrateFunc(): RemoteFunction?
	local remotes = ReplicatedStorage:FindFirstChild("Remotes")
	if not remotes then return nil end
	return remotes:FindFirstChild("BuyCrate")
end

local function getOwnedCratesFunc(): RemoteFunction?
	local remotes = ReplicatedStorage:FindFirstChild("Remotes")
	if not remotes then return nil end
	return remotes:FindFirstChild("GetOwnedCrates")
end

local function getOpenOwnedCratesFunc(): RemoteFunction?
	local remotes = ReplicatedStorage:FindFirstChild("Remotes")
	if not remotes then return nil end
	return remotes:FindFirstChild("OpenOwnedCrates")
end

local function showToast(msg: string, okStyle: boolean?)
	if not canvas then return end
	local toast = Instance.new("TextLabel")
	toast.Name = "CrateToast"
	toast.AnchorPoint = Vector2.new(0.5, 0)
	toast.Position = UDim2.new(0.5, 0, 0, 10)
	toast.Size = UDim2.new(0.75, 0, 0, 30)
	toast.BackgroundColor3 = okStyle and Color3.fromRGB(40, 145, 75) or Color3.fromRGB(145, 45, 45)
	toast.BackgroundTransparency = 0.1
	toast.BorderSizePixel = 0
	toast.Font = Enum.Font.GothamBold
	toast.Text = msg
	toast.TextColor3 = Color3.fromRGB(255, 255, 255)
	toast.TextSize = 14
	toast.ZIndex = 200
	toast.Parent = canvas
	Instance.new("UICorner", toast).CornerRadius = UDim.new(0, 8)
	task.delay(2.2, function()
		if toast and toast.Parent then
			toast:Destroy()
		end
	end)
end

local function updateCrateCountLabel(crateId: string, count: number)
	_crateCounts[crateId] = count
	local lbl = _crateCountLabels[crateId]
	if lbl and lbl.Parent then
		lbl.Text = string.format("Owned: %d", math.max(0, math.floor(count)))
	end
end

local function getCrateDisplayName(crateId: string): string
	for _, crate in ipairs(UIConfig.MockCrates or {}) do
		if crate.id == crateId then
			return tostring(crate.name or crateId)
		end
	end
	local stripped = string.gsub(tostring(crateId or "Crate"), "^crate_", "")
	stripped = string.gsub(stripped, "_", " ")
	local titled = string.gsub(stripped, "(%a)([%w_]*)", function(first, rest)
		return string.upper(first) .. string.lower(rest)
	end)
	return titled .. " Crate"
end

local function pluralizeCrateName(displayName: string, qty: number): string
	if qty == 1 then
		return displayName
	end
	if string.sub(displayName, -5) == "Crate" then
		return string.sub(displayName, 1, -2) .. "s"
	end
	return displayName .. "s"
end

local function formatCratePurchaseToast(crateId: string, qty: number, ownedCount: number?): string
	local n = math.max(1, math.floor(tonumber(qty) or 1))
	local name = pluralizeCrateName(getCrateDisplayName(crateId), n)
	local msg = string.format("Purchased %d %s", n, name)
	if ownedCount ~= nil then
		msg = string.format("%s (Owned: %d)", msg, math.max(0, math.floor(ownedCount)))
	end
	return msg
end

--- Get random preview items for a crate from its drop table
local function getPreviewItems(crateId: string, count: number): { any }
	-- Find the MockCrates entry for this crateId
	for _, crate in ipairs(UIConfig.MockCrates) do
		if crate.id == crateId and crate.drops then
			local drops = {}
			for _, d in ipairs(crate.drops) do
				table.insert(drops, d)
			end
			-- Shuffle
			for i = #drops, 2, -1 do
				local j = math.random(1, i)
				drops[i], drops[j] = drops[j], drops[i]
			end
			local result = {}
			for i = 1, math.min(count, #drops) do
				table.insert(result, drops[i])
			end
			return result
		end
	end
	return {}
end

local function showCrateRewards(results)
	local revealUI = getRevealUI()
	if not revealUI then
		return false
	end
	local revealItems = {}
	for _, r in ipairs(results or {}) do
		local shouldShow = (r.grantSuccess == true) or (r.isDuplicate == true)
		if not shouldShow then
			continue
		end
		local entry = ItemCatalog.Get(r.category, r.itemId)
		table.insert(revealItems, {
			name = entry and entry.name or r.itemId,
			rarity = entry and entry.rarity or "Common",
			modelPath = entry and entry.modelPath,
			iconColor = entry and entry.iconColor,
			isDuplicate = r.isDuplicate or false,
			itemId = r.itemId,
			category = r.category,
			itemType = entry and entry.type or "",
			iconText = entry and entry.iconText or "",
			image = entry and entry.image or "",
		})
	end
	if #revealItems > 1 and revealUI.ShowRewards then
		revealUI.ShowRewards(revealItems)
		return true
	elseif #revealItems == 1 and revealUI.ShowReward then
		revealUI.ShowReward(revealItems[1])
		return true
	end
	return false
end

local function openPurchasedCrates(crateId: string, qty: number): boolean
	local openOwned = getOpenOwnedCratesFunc()
	if not openOwned then
		warn("[CrateShop] OpenOwnedCrates RemoteFunction not found")
		return false
	end
	local ok, result = pcall(openOwned.InvokeServer, openOwned, crateId, qty)
	if not ok or not result or not result.success then
		warn("[CrateShop] OpenOwnedCrates failed:", ok and (result.error or result.reason) or result)
		return false
	end
	if type(result.newCount) == "number" then
		updateCrateCountLabel(crateId, result.newCount)
	end
	print(string.format("[CrateUI] ShowingRewardModal crateType=%s qty=%d", crateId, qty))
	return showCrateRewards(result.results)
end

-- ═══════════════════════════════════════════════════════════════════
-- CRATE SECTION BUILDER
-- ═══════════════════════════════════════════════════════════════════

local function createCrateSection(parent: ScrollingFrame, crateData: { [string]: any }, layoutOrder: number)
	local accent = crateData.accentColor or crateData.iconColor

	local section = Instance.new("Frame")
	section.Name = "Crate_" .. crateData.id
	section.Size = UDim2.new(1, -20, 0, 230)
	section.BackgroundColor3 = C.CardBg
	section.BorderSizePixel = 0
	section.LayoutOrder = layoutOrder
	section.Parent = parent

	local sc = Instance.new("UICorner")
	sc.CornerRadius = UDim.new(0, S.CardCorner)
	sc.Parent = section

	local ss = Instance.new("UIStroke")
	ss.Color = accent
	ss.Thickness = 2.5
	ss.Transparency = 0.12
	ss.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	ss.Parent = section

	-- Colored left bar accent
	local leftBar = Instance.new("Frame")
	leftBar.Name = "AccentBar"
	leftBar.Size = UDim2.new(0, 4, 1, -8)
	leftBar.Position = UDim2.fromOffset(2, 4)
	leftBar.BackgroundColor3 = accent
	leftBar.BorderSizePixel = 0
	leftBar.Parent = section
	local lbc = Instance.new("UICorner")
	lbc.CornerRadius = UDim.new(0, 2)
	lbc.Parent = leftBar

	-- ── Left: Big model preview ──
	local bigPreview = Instance.new("Frame")
	bigPreview.Name = "BigPreview"
	bigPreview.Size = UDim2.new(0, 120, 1, -14)
	bigPreview.Position = UDim2.fromOffset(12, 7)
	bigPreview.BackgroundColor3 = crateData.iconColor
	bigPreview.BorderSizePixel = 0
	bigPreview.Parent = section

	local bpc = Instance.new("UICorner")
	bpc.CornerRadius = UDim.new(0, 14)
	bpc.Parent = bigPreview

	local bps = Instance.new("UIStroke")
	bps.Color = Color3.fromRGB(255, 255, 255)
	bps.Thickness = 1.5
	bps.Transparency = 0.5
	bps.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	bps.Parent = bigPreview

	-- All drops for this crate (show every item, no limit)
	local allDrops = crateData.drops or {}
	print(string.format("[CrateShop] %s: %d items to display", crateData.name, #allDrops))

	-- Big preview: show crate box representation (not a random drop item)
	do
		local crateModelPath = crateData.modelPath
		local rendered = false
		if crateModelPath and crateModelPath ~= "" then
			local vp = Components.CreateViewportThumbnail(
				bigPreview,
				crateModelPath,
				UDim2.new(1, -8, 0, 120),
				crateData.iconColor, "")
			vp.Position = UDim2.fromOffset(4, 10)
			vp.BackgroundTransparency = 1
			rendered = ThumbnailRenderer.RenderItemToViewport(vp, { modelPath = crateModelPath })
		end
		if not rendered then
			local crateImg = Instance.new("ImageLabel")
			crateImg.Name = "CrateImage"
			crateImg.AnchorPoint = Vector2.new(0.5, 0)
			crateImg.Size = UDim2.new(0.78, 0, 0, 84)
			crateImg.Position = UDim2.new(0.5, 0, 0, 14)
			crateImg.BackgroundTransparency = 1
			crateImg.Image = "rbxassetid://108812530080296"
			crateImg.ScaleType = Enum.ScaleType.Fit
			crateImg.ImageTransparency = 0
			crateImg.ZIndex = 2
			crateImg.Parent = bigPreview
		end
	end

	-- Crate name under big preview
	local crateName = Instance.new("TextLabel")
	crateName.Name = "Name"
	crateName.AnchorPoint = Vector2.new(0.5, 1)
	crateName.Position = UDim2.new(0.5, 0, 1, -8)
	crateName.Size = UDim2.new(1, -8, 0, 34)
	crateName.BackgroundTransparency = 1
	crateName.Font = Enum.Font.GothamBold
	crateName.TextColor3 = C.TextWhite
	crateName.TextSize = 14
	crateName.Text = crateData.name
	crateName.TextWrapped = true
	crateName.Parent = bigPreview
	local cns = Instance.new("UIStroke")
	cns.Color = Color3.fromRGB(0, 0, 0)
	cns.Thickness = 1.5
	cns.Transparency = 0.22
	cns.Parent = crateName

	-- ── Right side: Title ──
	local titleR = Instance.new("TextLabel")
	titleR.Name = "Title"
	titleR.Size = UDim2.new(1, -155, 0, 24)
	titleR.Position = UDim2.fromOffset(143, 8)
	titleR.BackgroundTransparency = 1
	titleR.Font = Enum.Font.GothamBold
	titleR.TextColor3 = C.TextWhite
	titleR.TextSize = 18
	titleR.TextXAlignment = Enum.TextXAlignment.Left
	titleR.Text = crateData.name
	titleR.Parent = section
	local trs = Instance.new("UIStroke")
	trs.Color = Color3.fromRGB(0, 0, 0)
	trs.Thickness = 1.5
	trs.Transparency = 0.22
	trs.Parent = titleR

	local countLbl = Instance.new("TextLabel")
	countLbl.Name = "OwnedCount"
	countLbl.Size = UDim2.new(1, -155, 0, 18)
	countLbl.Position = UDim2.fromOffset(143, 26)
	countLbl.BackgroundTransparency = 1
	countLbl.Font = Enum.Font.GothamBold
	countLbl.TextColor3 = Color3.fromRGB(255, 220, 120)
	countLbl.TextSize = 12
	countLbl.TextXAlignment = Enum.TextXAlignment.Left
	countLbl.Text = string.format("Owned: %d", _crateCounts[crateData.id] or 0)
	countLbl.Parent = section
	_crateCountLabels[crateData.id] = countLbl

	-- ── Right: Preview thumbnails row (horizontal scroll) ──
	local thumbRow = Instance.new("ScrollingFrame")
	thumbRow.Name = "Thumbnails"
	thumbRow.Size = UDim2.new(1, -155, 0, 104)
	thumbRow.Position = UDim2.fromOffset(143, 44)
	thumbRow.BackgroundTransparency = 1
	thumbRow.BorderSizePixel = 0
	thumbRow.ScrollingDirection = Enum.ScrollingDirection.X
	thumbRow.ScrollBarThickness = 4
	thumbRow.ScrollBarImageColor3 = Color3.fromRGB(180, 180, 180)
	thumbRow.ScrollBarImageTransparency = 0.3
	thumbRow.AutomaticCanvasSize = Enum.AutomaticSize.X
	thumbRow.CanvasSize = UDim2.fromScale(0, 0)
	thumbRow.Parent = section

	local thumbLayout = Instance.new("UIListLayout")
	thumbLayout.FillDirection = Enum.FillDirection.Horizontal
	thumbLayout.Padding = UDim.new(0, 6)
	thumbLayout.SortOrder = Enum.SortOrder.LayoutOrder
	thumbLayout.VerticalAlignment = Enum.VerticalAlignment.Top
	thumbLayout.Parent = thumbRow

	-- Compute total chances for percentage display
	local totalChance = 0
	for _, drop in ipairs(allDrops) do
		totalChance = totalChance + (drop.chance or 0)
	end

	local cardsCreated = 0
	for i, item in ipairs(allDrops) do
		local thumbContainer = Instance.new("Frame")
		thumbContainer.Name = "Thumb" .. i
		thumbContainer.Size = UDim2.fromOffset(68, 96)
		thumbContainer.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
		thumbContainer.BackgroundTransparency = 0
		thumbContainer.BorderSizePixel = 0
		thumbContainer.LayoutOrder = i
		thumbContainer.Parent = thumbRow
		Instance.new("UICorner", thumbContainer).CornerRadius = UDim.new(0, 6)

		-- THUMBNAIL_RENDERER_RULES:
		-- 1) explicit image -> STATIC
		-- 2) no explicit image -> ThumbnailRenderer
		local staticImage = ""
		local rendererKey = item.modelPath
		local itemType = if crateData.id == "crate_crown" then "CROWN" else "PET"
		if item.itemId and type(item.itemId) == "string" and string.match(item.itemId, "^crown_") then
			itemType = "CROWN"
		end
		if ItemCatalog.ResolveCrownOrPetImage and item.itemId then
			local resolved = ItemCatalog.ResolveCrownOrPetImage(item.itemId, itemType)
			if resolved and resolved.mode == "STATIC" then
				staticImage = resolved.image or ""
			elseif resolved and resolved.mode == "RENDERER" then
				rendererKey = resolved.rendererKey or rendererKey
			end
		end
		if staticImage == "" and type(item.image) == "string" and item.image ~= "" then
			staticImage = item.image
		end

		if staticImage ~= "" then
			local imgLbl = Instance.new("ImageLabel")
			imgLbl.Name = "ThumbImage"
			imgLbl.Position = UDim2.fromOffset(4, 0)
			imgLbl.Size = UDim2.fromOffset(60, 52)
			imgLbl.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
			imgLbl.BackgroundTransparency = 0
			imgLbl.BorderSizePixel = 0
			imgLbl.Image = staticImage
			imgLbl.ScaleType = Enum.ScaleType.Fit
			imgLbl.ZIndex = 3
			imgLbl.Parent = thumbContainer
			Instance.new("UICorner", imgLbl).CornerRadius = UDim.new(0, 6)
		elseif rendererKey and rendererKey ~= "" then
			local vp = Components.CreateViewportThumbnail(
				thumbContainer,
				rendererKey,
				UDim2.fromOffset(60, 52),
				Color3.fromRGB(0, 0, 0),
				item.name and string.sub(item.name, 1, 2) or "?"
			)
			vp.Position = UDim2.fromOffset(4, 0)
			ThumbnailRenderer.RenderItemToViewport(vp, {
				id = item.itemId,
				name = item.name,
				type = itemType,
				modelPath = rendererKey,
				rarity = item.rarity,
			})
		end

		-- Item name label (truncated)
		local nameLbl = Instance.new("TextLabel")
		nameLbl.Size = UDim2.new(1, 0, 0, 14)
		nameLbl.Position = UDim2.fromOffset(0, 54)
		nameLbl.BackgroundTransparency = 1
		nameLbl.Font = Enum.Font.GothamBold
		nameLbl.TextColor3 = C.TextWhite
		nameLbl.TextSize = 9
		nameLbl.Text = item.name or "MISSING ITEM"
		nameLbl.TextTruncate = Enum.TextTruncate.AtEnd
		nameLbl.TextXAlignment = Enum.TextXAlignment.Center
		nameLbl.Parent = thumbContainer

		-- Drop chance label
		local chancePercent = 0
		if totalChance > 0 and item.chance then
			chancePercent = item.chance
		end

		local rarColor = ItemCatalog.GetRarityColor(item.rarity)
		local chanceLbl = Instance.new("TextLabel")
		chanceLbl.Size = UDim2.new(1, 0, 0, 14)
		chanceLbl.Position = UDim2.fromOffset(0, 68)
		chanceLbl.BackgroundTransparency = 1
		chanceLbl.Font = Enum.Font.GothamBold
		chanceLbl.TextColor3 = rarColor or C.TextMuted
		chanceLbl.TextSize = 11
		chanceLbl.Text = string.format("%d%%", chancePercent)
		chanceLbl.TextXAlignment = Enum.TextXAlignment.Center
		chanceLbl.Parent = thumbContainer

		-- Rarity label
		local rarLbl = Instance.new("TextLabel")
		rarLbl.Size = UDim2.new(1, 0, 0, 12)
		rarLbl.Position = UDim2.fromOffset(0, 82)
		rarLbl.BackgroundTransparency = 1
		rarLbl.Font = Enum.Font.Gotham
		rarLbl.TextColor3 = rarColor or C.TextMuted
		rarLbl.TextSize = 9
		rarLbl.Text = item.rarity or ""
		rarLbl.TextXAlignment = Enum.TextXAlignment.Center
		rarLbl.Parent = thumbContainer
		cardsCreated += 1
	end
	print(string.format("[CrateShop] %s: %d cards created", crateData.name, cardsCreated))

	-- ── Buy buttons row ──
	local btnRow = Instance.new("Frame")
	btnRow.Name = "BuyButtons"
	btnRow.AnchorPoint = Vector2.new(0, 1)
	btnRow.Position = UDim2.new(0, 143, 1, -10)
	btnRow.Size = UDim2.new(1, -155, 0, 54)
	btnRow.BackgroundTransparency = 1
	btnRow.BorderSizePixel = 0
	btnRow.Parent = section

	local bLayout = Instance.new("UIListLayout")
	bLayout.FillDirection = Enum.FillDirection.Horizontal
	bLayout.Padding = UDim.new(0, 8)
	bLayout.SortOrder = Enum.SortOrder.LayoutOrder
	bLayout.VerticalAlignment = Enum.VerticalAlignment.Bottom
	bLayout.Parent = btnRow

	for pi, price in ipairs(crateData.prices) do
		local isRobux = price.currency == "Robux"
		local priceText = isRobux and string.format("%d ROBUX", price.cost) or string.format("F %d", price.cost)
		local btnColor = isRobux and C.RobuxButton or C.BuyButton

		local pBtn = Instance.new("TextButton")
		pBtn.Name = "Price" .. pi
		pBtn.Size = UDim2.fromOffset(105, 50)
		pBtn.BackgroundColor3 = btnColor
		pBtn.Font = Enum.Font.GothamBlack
		pBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
		pBtn.TextSize = 14
		pBtn.Text = priceText .. "\n" .. price.label
		pBtn.TextYAlignment = Enum.TextYAlignment.Center
		pBtn.BorderSizePixel = 0
		pBtn.AutoButtonColor = false
		pBtn.LayoutOrder = pi
		pBtn.Parent = btnRow

		local pbc = Instance.new("UICorner")
		pbc.CornerRadius = UDim.new(0, S.SmBtnCorner)
		pbc.Parent = pBtn

		-- Gradient
		local br, bg, bb = btnColor.R, btnColor.G, btnColor.B
		local pbGrad = Instance.new("UIGradient")
		pbGrad.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.new(math.min(br+0.2,1), math.min(bg+0.2,1), math.min(bb+0.2,1))),
			ColorSequenceKeypoint.new(0.5, btnColor),
			ColorSequenceKeypoint.new(1, Color3.new(math.max(br-0.12,0), math.max(bg-0.12,0), math.max(bb-0.12,0))),
		})
		pbGrad.Rotation = 90
		pbGrad.Parent = pBtn

		local pbs = Instance.new("UIStroke")
		pbs.Color = Color3.fromRGB(0, 0, 0)
		pbs.Thickness = 1.75
		pbs.Transparency = 0.05
		pbs.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
		pbs.Parent = pBtn

		-- Determine quantity from label
		local qty = tonumber(string.match(price.label, "(%d+)")) or 1

		AnimUtil.WireButton(pBtn, function()
			SoundUtil.Click()
			print(string.format("[CrateShopUI] Click buy crateType=%s qty=%d currency=%s",
				tostring(crateData.id), qty, isRobux and "Robux" or "F"))

			if isRobux then
				if price.productId and price.productId > 0 then
					_pendingRobuxCrateBuys[crateData.id] = (_pendingRobuxCrateBuys[crateData.id] or 0) + qty
					_pendingRobuxCrateBuyExpiresAt[crateData.id] = os.clock() + 45
					MarketplaceService:PromptProductPurchase(Players.LocalPlayer, price.productId)
				else
					print(string.format("[CrateShop] Robux purchase: %s — %s (no productId)", crateData.name, price.label))
				end
				return
			end

			-- Validate crate ID exists in catalog before firing remote
			if not ItemCatalog.Crates or not ItemCatalog.Crates[crateData.id] then
				warn("[CrateShop] Crate not configured:", crateData.id)
				return
			end

			local buyCrate = getBuyCrateFunc()
			if not buyCrate then
				warn("[CrateShop] BuyCrate RemoteFunction not found")
				return
			end

			local result = buyCrate:InvokeServer(crateData.id, qty, "Coins")
			if result and result.success then
				local newCount = tonumber(result.newCount) or (_crateCounts[crateData.id] or 0)
				updateCrateCountLabel(crateData.id, newCount)
				if _buyOpenBusyByCrate[crateData.id] then
					return
				end
				_buyOpenBusyByCrate[crateData.id] = true
				local opened = openPurchasedCrates(crateData.id, qty)
				_buyOpenBusyByCrate[crateData.id] = nil
				if not opened then
					showToast(formatCratePurchaseToast(crateData.id, qty, newCount), true)
				end
			elseif result then
				if tostring(result.reason) == "INSUFFICIENT_FUNDS" then
					showToast("Not enough Fate Coins", false)
				else
					showToast("Purchase failed", false)
				end
				warn("[CrateShop] Failed:", result.error or result.reason or "unknown")
			end
		end)
	end

	return section
end

-- ═══════════════════════════════════════════════════════════════════
-- PANEL LIFECYCLE
-- ═══════════════════════════════════════════════════════════════════

function CrateShopPanel.Init(screenGui: ScreenGui, onClose: () -> ())
	closeCallback = onClose
	_crateCountLabels = {}
	_crateCounts = {}
	_pendingRobuxCrateBuys = {}
	_pendingRobuxCrateBuyExpiresAt = {}
	_buyOpenBusyByCrate = {}

	overlay = Components.CreateDimOverlay(screenGui, function()
		CrateShopPanel.Hide()
	end)

	local content, closeBtn
	canvas, uiScale, content, closeBtn = Components.CreatePanel(screenGui, "CRATE SHOP", C.HeaderCrate, "Crate")

	closeBtn.MouseButton1Click:Connect(function()
		SoundUtil.Close()
		CrateShopPanel.Hide()
	end)

	-- Override stud texture to Fate Beams asset (only this panel)
	do
		local stud = canvas:FindFirstChild("StudTexture")
		if stud then
			stud.Image = "rbxassetid://70851348312450"
			stud.TileSize = UDim2.fromOffset(96, 96)
			stud.ImageTransparency = 0.88
			stud.ImageColor3 = Color3.fromRGB(255, 255, 255)
		end
	end

	Components.AddListLayout(content, 16)

	do
		local getOwned = getOwnedCratesFunc()
		if getOwned then
			local ok, counts = pcall(getOwned.InvokeServer, getOwned)
			if ok and type(counts) == "table" then
				for crateId, n in pairs(counts) do
					_crateCounts[crateId] = tonumber(n) or 0
				end
			end
		end
	end

	-- Build crate sections from UIConfig.MockCrates (now has 4 entries)
	for i, crate in ipairs(UIConfig.MockCrates) do
		createCrateSection(content, crate, i)
	end

	if not _inventoryUpdatedConn then
		task.spawn(function()
			local remotes = ReplicatedStorage:WaitForChild("Remotes", 10)
			local invUpdate = remotes and remotes:FindFirstChild("InventoryUpdated")
			if invUpdate and invUpdate:IsA("RemoteEvent") then
				_inventoryUpdatedConn = invUpdate.OnClientEvent:Connect(function(reason, data)
					if reason == "CrateBalance" and type(data) == "table" then
						if type(data.counts) == "table" then
							for crateId, n in pairs(data.counts) do
								updateCrateCountLabel(crateId, tonumber(n) or 0)
							end
						elseif type(data.crateId) == "string" then
							updateCrateCountLabel(data.crateId, tonumber(data.newCount) or 0)
						end
						if visible and tonumber(data.qty) and tonumber(data.qty) > 0 and type(data.crateId) == "string" then
							local pending = tonumber(_pendingRobuxCrateBuys[data.crateId]) or 0
							local expiresAt = tonumber(_pendingRobuxCrateBuyExpiresAt[data.crateId]) or 0
							if pending > 0 and os.clock() <= expiresAt then
								local qty = tonumber(data.qty) or 1
								_pendingRobuxCrateBuys[data.crateId] = math.max(0, pending - qty)
								if _pendingRobuxCrateBuys[data.crateId] <= 0 then
									_pendingRobuxCrateBuyExpiresAt[data.crateId] = nil
								end
								if not _buyOpenBusyByCrate[data.crateId] then
									_buyOpenBusyByCrate[data.crateId] = true
									local opened = openPurchasedCrates(data.crateId, qty)
									_buyOpenBusyByCrate[data.crateId] = nil
									if not opened then
										showToast(formatCratePurchaseToast(data.crateId, qty, tonumber(data.newCount)), true)
									end
								end
							end
						end
					end
				end)
			end
		end)
	end
end

function CrateShopPanel.Show()
	if visible then return end
	visible = true
	overlay.Visible = true
	SoundUtil.Open()
	AnimUtil.OpenPanel(canvas, uiScale)
end

function CrateShopPanel.Hide()
	if not visible then return end
	visible = false
	overlay.Visible = false
	local t = AnimUtil.ClosePanel(canvas, uiScale)
	task.spawn(function()
		t.Completed:Wait()
		canvas.Visible = false
	end)
	if closeCallback then closeCallback() end
end

function CrateShopPanel.IsVisible(): boolean
	return visible
end

function CrateShopPanel.Toggle()
	if visible then CrateShopPanel.Hide() else CrateShopPanel.Show() end
end

return CrateShopPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="116">
            <Properties>
              <string name="Name">DailyRewardsPanel</string>
              <string name="Source"><![CDATA[--[[
	DailyRewardsPanel
	Standard-size panel (matches Crate Shop) with 7-day reward grid.
	Uses Components.CreatePanel for consistent sizing/styling.

	Layout:
	  - Standard panel header ("DAILY REWARDS") — light blue theme
	  - Progress bar: "Day X / 7"
	  - Left: 3×2 grid of Day 1–6 cards
	  - Right: Large featured Day 7 card
	  - Bottom: Timer + Claim button

	API:
	  Init(screenGui, onClose)
	  Show() / Hide() / IsVisible() / Toggle()
	  TryAutoShow()
]]

local FORCE_OPEN_DAILY_ON_JOIN = false

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared", 60)
if not Shared then
	warn("[DailyRewardsPanel] Shared not found")
	return { Init = function() end, Show = function() end, Hide = function() end,
		IsVisible = function() return false end, Toggle = function() end, TryAutoShow = function() end }
end

local CDPModule = Shared:WaitForChild("ClientDepsProvider", 60)
if not CDPModule then
	warn("[DailyRewardsPanel] ClientDepsProvider MISSING")
	return { Init = function() end, Show = function() end, Hide = function() end,
		IsVisible = function() return false end, Toggle = function() end, TryAutoShow = function() end }
end

local ok, Deps = pcall(require, CDPModule)
if not ok or not Deps then
	warn("[DailyRewardsPanel] require(ClientDepsProvider) FAILED:", Deps)
	return { Init = function() end, Show = function() end, Hide = function() end,
		IsVisible = function() return false end, Toggle = function() end, TryAutoShow = function() end }
end

local UIConfig = Deps.UIConfig

local okConfig, DailyRewardConfig = pcall(require, Shared:WaitForChild("DailyRewardConfig", 10))
if not okConfig or not DailyRewardConfig then
	warn("[DailyRewardsPanel] DailyRewardConfig not found")
	return { Init = function() end, Show = function() end, Hide = function() end,
		IsVisible = function() return false end, Toggle = function() end, TryAutoShow = function() end }
end

local Client = script.Parent
local AnimUtil = require(Client:WaitForChild("AnimUtil"))
local SoundUtil = require(Client:WaitForChild("SoundUtil"))
local Components = require(Client:WaitForChild("Components"))

local C = UIConfig.Colors
local S = UIConfig.Sizes

local DailyRewardsPanel = {}

-- STATE
local canvas = nil
local uiScale = nil
local overlay = nil
local visible = false
local closeCallback = nil
local _hasAutoShown = false

-- UI refs
local _claimButton = nil
local _timerLabel = nil
local _dayCards = {}
local _streakLabel = nil
local _progressFill = nil
local _bgImage = nil
local _bgAnimToken = 0

-- State
local _status = nil
local _timerConn = nil

-- Remotes
local _getStatusFunc = nil
local _claimFunc = nil

-- Lazy RewardPopup
local _RewardPopup = nil
local function getRewardPopup()
	if _RewardPopup then return _RewardPopup end
	pcall(function()
		local ps = game:GetService("Players").LocalPlayer:FindFirstChild("PlayerScripts")
		local client = ps and ps:FindFirstChild("Client")
		local ui = client and client:FindFirstChild("UI")
		local rp = ui and ui:FindFirstChild("RewardPopup")
		if rp then _RewardPopup = require(rp) end
	end)
	return _RewardPopup
end

local function log(...) print("[DailyRewardsPanel]", ...) end

-- ═══════════════════════════════════════════════════════════════════
-- THEME — orange + dark/blackish palette
-- ═══════════════════════════════════════════════════════════════════

local HEADER_COLOR      = Color3.fromRGB(255, 122, 22)       -- panel header bar
local INNER_BG_COLOR    = Color3.fromRGB(14, 10, 8)          -- inner content base
local INNER_TINT_COLOR  = Color3.fromRGB(28, 18, 12)         -- subtle warm tint behind cards
local CARD_BG           = Color3.fromRGB(20, 14, 10)         -- card background (dark brown-black)
local CARD_BORDER       = Color3.fromRGB(145, 88, 22)        -- default card border
local PROGRESS_BG       = Color3.fromRGB(30, 20, 14)         -- progress bar bg
local PROGRESS_FILL     = Color3.fromRGB(255, 178, 38)       -- progress bar fill
local STREAK_TEXT       = Color3.fromRGB(255, 205, 92)       -- streak label
local TIMER_READY       = Color3.fromRGB(255, 188, 70)       -- "available now"
local TIMER_WAIT        = Color3.fromRGB(214, 188, 156)      -- countdown text
local CLAIM_GREEN       = Color3.fromRGB(255, 145, 30)       -- claim button (kept var name for compatibility)
local CLAIM_DISABLED    = Color3.fromRGB(44, 32, 24)         -- disabled button
local CLAIM_DISABLED_TEXT = Color3.fromRGB(145, 125, 102)
local LOCKED_TAG_BG     = Color3.fromRGB(88, 38, 24)
local REWARD_LABEL_TEXT = Color3.fromRGB(238, 218, 190)
local FALLBACK_ICON_TEXT = Color3.fromRGB(255, 195, 95)
local CLAIM_CHECK_COLOR = Color3.fromRGB(98, 255, 165)

-- Per-day accent colours (orange/gold spectrum)
local DAY_COLORS = {
	[1] = Color3.fromRGB(255, 186, 70),
	[2] = Color3.fromRGB(255, 168, 58),
	[3] = Color3.fromRGB(255, 152, 48),
	[4] = Color3.fromRGB(255, 136, 38),
	[5] = Color3.fromRGB(255, 122, 30),
	[6] = Color3.fromRGB(242, 182, 86),
	[7] = Color3.fromRGB(255, 208, 92),
}

-- ═══════════════════════════════════════════════════════════════════
-- HELPERS
-- ═══════════════════════════════════════════════════════════════════

local function formatTimer(seconds)
	local h = math.floor(seconds / 3600)
	local m = math.floor((seconds % 3600) / 60)
	local s = math.floor(seconds % 60)
	return string.format("%02d:%02d:%02d", h, m, s)
end

local function fetchStatus()
	if not _getStatusFunc then
		pcall(function()
			local remotes = ReplicatedStorage:WaitForChild("Remotes", 5)
			if remotes then
				_getStatusFunc = remotes:WaitForChild("DailyReward_GetStatus", 5)
				_claimFunc = remotes:WaitForChild("DailyReward_Claim", 5)
			end
		end)
	end
	if _getStatusFunc then
		local statusOk, status = pcall(_getStatusFunc.InvokeServer, _getStatusFunc)
		if statusOk and status then return status end
	end
	return nil
end

-- ═══════════════════════════════════════════════════════════════════
-- UI UPDATES
-- ═══════════════════════════════════════════════════════════════════

local function updateDayCards(status)
	if not status then return end
	local streak = status.streak or 0
	local canClaim = status.canClaim

	for i, card in ipairs(_dayCards) do
		local check = card:FindFirstChild("Check")
		local glow = card:FindFirstChild("GlowStroke")
		local dimOverlay = card:FindFirstChild("DimOverlay")
		local claimTag = card:FindFirstChild("ClaimTag")
		local lockedTag = card:FindFirstChild("LockedTag")

		if i <= streak then
			if check then check.Visible = true end
			if glow then glow.Enabled = false end
			if dimOverlay then dimOverlay.Visible = false end
			if claimTag then claimTag.Visible = false end
			if lockedTag then lockedTag.Visible = false end
		elseif i == streak + 1 and canClaim then
			if check then check.Visible = false end
			if glow then glow.Enabled = true end
			if dimOverlay then dimOverlay.Visible = false end
			if claimTag then claimTag.Visible = true end
			if lockedTag then lockedTag.Visible = false end
		else
			if check then check.Visible = false end
			if glow then glow.Enabled = false end
			if dimOverlay then dimOverlay.Visible = true end
			if claimTag then claimTag.Visible = false end
			if lockedTag then lockedTag.Visible = true end
		end
	end

	if _streakLabel then
		_streakLabel.Text = string.format("Day %d / %d", streak, DailyRewardConfig.MaxStreak)
	end

	if _progressFill then
		local frac = math.clamp(streak / DailyRewardConfig.MaxStreak, 0, 1)
		TweenService:Create(_progressFill, TweenInfo.new(0.4, Enum.EasingStyle.Quad), {
			Size = UDim2.new(frac, 0, 1, 0)
		}):Play()
	end

	if _claimButton then
		if canClaim then
			_claimButton.Text = "CLAIM REWARD"
			_claimButton.BackgroundColor3 = CLAIM_GREEN
			_claimButton.TextColor3 = Color3.fromRGB(255, 255, 255)
			_claimButton.Active = true
			_claimButton.AutoButtonColor = true
		else
			_claimButton.Text = "COME BACK LATER"
			_claimButton.BackgroundColor3 = CLAIM_DISABLED
			_claimButton.TextColor3 = CLAIM_DISABLED_TEXT
			_claimButton.Active = false
			_claimButton.AutoButtonColor = false
		end
	end

	if _timerLabel then
		if canClaim then
			_timerLabel.Text = "Reward available now!"
			_timerLabel.TextColor3 = TIMER_READY
		else
			local secs = status.secondsUntilNext or 0
			_timerLabel.Text = "Next reward in: " .. formatTimer(secs)
			_timerLabel.TextColor3 = TIMER_WAIT
		end
	end
end

local function startTimerLoop()
	if _timerConn then _timerConn:Disconnect() end
	local lastFetch = os.time()
	local serverSecs = _status and _status.secondsUntilNext or 0
	_timerConn = RunService.Heartbeat:Connect(function()
		if not visible or not _status then return end
		if _status.canClaim then return end
		local elapsed = os.time() - lastFetch
		local remaining = math.max(0, serverSecs - elapsed)
		if _timerLabel then
			if remaining <= 0 then
				_timerLabel.Text = "Reward available now!"
				_timerLabel.TextColor3 = TIMER_READY
				_status = fetchStatus()
				if _status then
					updateDayCards(_status)
					serverSecs = _status.secondsUntilNext or 0
					lastFetch = os.time()
				end
			else
				_timerLabel.Text = "Next reward in: " .. formatTimer(remaining)
			end
		end
	end)
end

local function stopTimerLoop()
	if _timerConn then _timerConn:Disconnect(); _timerConn = nil end
end

local function stopBgFadeLoop()
	_bgAnimToken += 1
	if _bgImage then
		_bgImage.ImageTransparency = 0.82
	end
end

local function startBgFadeLoop()
	if not _bgImage then return end
	_bgAnimToken += 1
	local token = _bgAnimToken
	task.spawn(function()
		while visible and _bgImage and _bgImage.Parent and token == _bgAnimToken do
			local fadeOut = TweenService:Create(_bgImage, TweenInfo.new(1.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
				ImageTransparency = 0.9,
			})
			fadeOut:Play()
			fadeOut.Completed:Wait()
			if not visible or token ~= _bgAnimToken then break end

			local fadeIn = TweenService:Create(_bgImage, TweenInfo.new(1.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
				ImageTransparency = 0.82,
			})
			fadeIn:Play()
			fadeIn.Completed:Wait()
		end
	end)
end

-- ═══════════════════════════════════════════════════════════════════
-- CLAIM
-- ═══════════════════════════════════════════════════════════════════

local _claiming = false
local function onClaim()
	if _claiming then return end
	if not _status or not _status.canClaim then return end
	_claiming = true
	if _claimButton then _claimButton.Text = "..."; _claimButton.Active = false end

	local result = nil
	if _claimFunc then
		local claimOk, claimResult = pcall(_claimFunc.InvokeServer, _claimFunc)
		if claimOk then result = claimResult end
	end

	if result and result.success then
		log("Claimed:", result.newStreak, result.reward and result.reward.label or "?")
		local popup = getRewardPopup()
		local reward = result.reward or {}

		-- Check if this was a crate reward with roll results
		if reward.crateResults and #reward.crateResults > 0 and popup and popup.ShowBatch then
			log(string.format("Day%d claimed -> resultsCount=%d crate rolls", result.newStreak, #reward.crateResults))
			local batchItems = {}
			for i, roll in ipairs(reward.crateResults) do
				log(string.format("  roll#%d: %s %s (dup=%s, coins=%s)",
					i, roll.category or "?", roll.itemId or "?",
					tostring(roll.isDuplicate), tostring(roll.coinsInstead)))
				table.insert(batchItems, {
					title = "DAILY REWARD!",
					name = roll.displayName or roll.itemId or "MISSING ITEM",
					itemId = roll.itemId or "",
					itemType = roll.category == "Crowns" and "Crown" or (roll.category == "Pets" and "Pet" or ""),
					category = roll.category or "",
					rarityText = roll.rarity or "Common",
					icon = "",  -- let RewardPopup resolve from catalog
					isDuplicate = roll.isDuplicate,
				})
			end
			popup.ShowBatch(batchItems)
		elseif popup and popup.Show then
			local iconColor = nil
			if reward.iconColor and type(reward.iconColor) == "table" then
				iconColor = Color3.fromRGB(reward.iconColor[1] or 200, reward.iconColor[2] or 200, reward.iconColor[3] or 200)
			end
			popup.Show({
				title = "DAILY REWARD!",
				name = reward.label or "Reward",
				icon = reward.icon or "",
				iconText = reward.iconText or "",
				iconColor = iconColor,
				rarityText = "Day " .. tostring(result.newStreak),
				itemId = reward.crownId or reward.crateId or "",
				itemType = reward.type or "",
			})
		end
		_status = fetchStatus()
		if _status then
			updateDayCards(_status)
			startTimerLoop()
		end
	else
		local reason = result and result.reason or "unknown"
		warn("[DailyRewardsPanel] Claim rejected:", reason)
		if _claimButton then
			if reason == "AlreadyClaimed" or reason == "On cooldown" then
				_claimButton.Text = "ALREADY CLAIMED"
				_claimButton.BackgroundColor3 = CLAIM_DISABLED
				_claimButton.TextColor3 = CLAIM_DISABLED_TEXT
				_claimButton.Active = false
				_claimButton.AutoButtonColor = false
			end
		end
		_status = fetchStatus()
		if _status then updateDayCards(_status) end
	end
	_claiming = false
end

-- ═══════════════════════════════════════════════════════════════════
-- BUILD DAY CARD  (scale-based, no fixed pixel sizes)
-- ═══════════════════════════════════════════════════════════════════

local function buildDayCard(parent, dayNum)
	local reward = DailyRewardConfig.Rewards[dayNum]
	local dayColor = DAY_COLORS[dayNum] or Color3.fromRGB(255, 158, 52)

	local card = Instance.new("Frame")
	card.Name = "Day" .. dayNum
	card.BackgroundColor3 = CARD_BG
	card.BorderSizePixel = 0
	card.ZIndex = 6
	card.Parent = parent
	Instance.new("UICorner", card).CornerRadius = UDim.new(0, 10)

	-- Border
	local stroke = Instance.new("UIStroke")
	stroke.Color = CARD_BORDER
	stroke.Thickness = 1.5
	stroke.Transparency = 0.3
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent = card

	-- Glow stroke (claimable)
	local glowStroke = Instance.new("UIStroke")
	glowStroke.Name = "GlowStroke"
	glowStroke.Color = dayColor
	glowStroke.Thickness = 2.5
	glowStroke.Enabled = false
	glowStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	glowStroke.Parent = card

	-- Day header
	local dayLbl = Instance.new("TextLabel")
	dayLbl.AnchorPoint = Vector2.new(0.5, 0)
	dayLbl.Position = UDim2.new(0.5, 0, 0, 4)
	dayLbl.Size = UDim2.new(1, 0, 0, 16)
	dayLbl.BackgroundTransparency = 1
	dayLbl.Font = Enum.Font.GothamBold
	dayLbl.TextColor3 = dayColor
	dayLbl.TextSize = 12
	dayLbl.Text = "DAY " .. dayNum
	dayLbl.ZIndex = 7
	dayLbl.Parent = card

	-- Icon
	if reward then
		local iconLbl
		if reward.icon and reward.icon ~= "" then
			iconLbl = Instance.new("ImageLabel")
			iconLbl.Image = reward.icon
			iconLbl.ScaleType = Enum.ScaleType.Fit
			iconLbl.BackgroundTransparency = 1
		else
			iconLbl = Instance.new("TextLabel")
			iconLbl.BackgroundTransparency = 1
			iconLbl.Font = Enum.Font.GothamBold
			iconLbl.TextScaled = true
			iconLbl.Text = reward.iconText or "?"
			local ic = reward.iconColor
			if ic and type(ic) == "table" then
				iconLbl.TextColor3 = Color3.fromRGB(ic[1] or 200, ic[2] or 200, ic[3] or 200)
			else
				iconLbl.TextColor3 = FALLBACK_ICON_TEXT
			end
		end
		iconLbl.Name = "RewardIcon"
		iconLbl.AnchorPoint = Vector2.new(0.5, 0.5)
		iconLbl.Position = UDim2.new(0.5, 0, 0.48, 0)
		iconLbl.Size = UDim2.new(0.6, 0, 0.45, 0)
		if reward.type == "Spins" then
			-- Slightly larger icon box keeps spins artwork legible without changing card layout.
			iconLbl.Position = UDim2.new(0.5, 0, 0.47, 0)
			iconLbl.Size = UDim2.new(0.72, 0, 0.52, 0)
		end
		iconLbl.ZIndex = 7
		iconLbl.Parent = card

		-- Label
		local rewLbl = Instance.new("TextLabel")
		rewLbl.AnchorPoint = Vector2.new(0.5, 1)
		rewLbl.Position = UDim2.new(0.5, 0, 1, -4)
		rewLbl.Size = UDim2.new(1, -8, 0, 14)
		rewLbl.BackgroundTransparency = 1
		rewLbl.Font = Enum.Font.GothamSemibold
		rewLbl.TextColor3 = REWARD_LABEL_TEXT
		rewLbl.TextSize = 10
		rewLbl.TextTruncate = Enum.TextTruncate.AtEnd
		rewLbl.Text = reward.label or ""
		rewLbl.ZIndex = 7
		rewLbl.Parent = card
	end

	-- Claim tag
	local claimTag = Instance.new("TextLabel")
	claimTag.Name = "ClaimTag"
	claimTag.AnchorPoint = Vector2.new(0.5, 0)
	claimTag.Position = UDim2.new(0.5, 0, 0, 20)
	claimTag.Size = UDim2.new(0.85, 0, 0, 16)
	claimTag.BackgroundColor3 = CLAIM_GREEN
	claimTag.Font = Enum.Font.GothamBold
	claimTag.TextColor3 = Color3.fromRGB(255, 255, 255)
	claimTag.TextSize = 9
	claimTag.Text = "CLAIM"
	claimTag.BorderSizePixel = 0
	claimTag.ZIndex = 8
	claimTag.Visible = false
	claimTag.Parent = card
	Instance.new("UICorner", claimTag).CornerRadius = UDim.new(0, 5)

	-- Locked tag
	local lockedTag = Instance.new("TextLabel")
	lockedTag.Name = "LockedTag"
	lockedTag.AnchorPoint = Vector2.new(0.5, 0)
	lockedTag.Position = UDim2.new(0.5, 0, 0, 20)
	lockedTag.Size = UDim2.new(0.85, 0, 0, 16)
	lockedTag.BackgroundColor3 = LOCKED_TAG_BG
	lockedTag.Font = Enum.Font.GothamBold
	lockedTag.TextColor3 = Color3.fromRGB(255, 255, 255)
	lockedTag.TextSize = 9
	lockedTag.Text = "LOCKED"
	lockedTag.BorderSizePixel = 0
	lockedTag.ZIndex = 8
	lockedTag.Visible = false
	lockedTag.Parent = card
	Instance.new("UICorner", lockedTag).CornerRadius = UDim.new(0, 5)

	-- Checkmark
	local check = Instance.new("TextLabel")
	check.Name = "Check"
	check.AnchorPoint = Vector2.new(0.5, 0.5)
	check.Position = UDim2.fromScale(0.5, 0.45)
	check.Size = UDim2.fromOffset(30, 30)
	check.BackgroundTransparency = 1
	check.Font = Enum.Font.GothamBold
	check.TextColor3 = CLAIM_CHECK_COLOR
	check.TextSize = 24
	check.Text = "\xE2\x9C\x93"
	check.ZIndex = 9
	check.Visible = false
	check.Parent = card

	-- Dim overlay (locked)
	local dimOv = Instance.new("Frame")
	dimOv.Name = "DimOverlay"
	dimOv.Size = UDim2.fromScale(1, 1)
	dimOv.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
	dimOv.BackgroundTransparency = 0.55
	dimOv.BorderSizePixel = 0
	dimOv.ZIndex = 8
	dimOv.Visible = false
	dimOv.Parent = card
	Instance.new("UICorner", dimOv).CornerRadius = UDim.new(0, 10)

	table.insert(_dayCards, card)
	return card
end

-- ═══════════════════════════════════════════════════════════════════
-- PANEL LIFECYCLE
-- ═══════════════════════════════════════════════════════════════════

function DailyRewardsPanel.Init(screenGui, onClose)
	closeCallback = onClose

	overlay = Components.CreateDimOverlay(screenGui, function()
		DailyRewardsPanel.Hide()
	end)

	local content, closeBtn
	canvas, uiScale, content, closeBtn = Components.CreatePanel(screenGui, "DAILY REWARDS", HEADER_COLOR, "Daily")

	-- Daily-only header divider tint (darker orange theme match).
	do
		local header = canvas and canvas:FindFirstChild("Header")
		local divider = header and header:FindFirstChild("HighlightLine")
		if divider and divider:IsA("Frame") then
			divider.BackgroundColor3 = Color3.fromRGB(170, 70, 0)
		end
	end

	closeBtn.MouseButton1Click:Connect(function()
		SoundUtil.Close()
		DailyRewardsPanel.Hide()
	end)

	-- Override stud texture to Fate Beams asset (only this panel)
	do
		local stud = canvas:FindFirstChild("StudTexture")
		if stud then
			stud.Image = "rbxassetid://70851348312450"
			stud.TileSize = UDim2.fromOffset(96, 96)
			stud.ImageTransparency = 0.88
			stud.ImageColor3 = Color3.fromRGB(255, 255, 255)
		end
	end

	-- Disable the scroll from CreatePanel — we do our own layout
	if content then
		content.ScrollingEnabled = false
		content.AutomaticCanvasSize = Enum.AutomaticSize.None
		content.CanvasSize = UDim2.fromScale(0, 0)
		content.ScrollBarThickness = 0
	end

	-- Decorative panel background (daily-only), kept subtle and behind content.
	local bgImage = Instance.new("ImageLabel")
	bgImage.Name = "DailyBgImage"
	bgImage.Size = UDim2.fromScale(1, 1)
	bgImage.Position = UDim2.fromScale(0, 0)
	bgImage.BackgroundTransparency = 1
	bgImage.Image = "rbxassetid://140656133488408"
	bgImage.ImageTransparency = 0.82
	bgImage.ScaleType = Enum.ScaleType.Crop
	bgImage.ZIndex = 4
	bgImage.Parent = content
	_bgImage = bgImage

	-- ── LIGHT BLUE INNER BACKGROUND ──────────────────────────────
	local innerBg = Instance.new("Frame")
	innerBg.Name = "InnerBg"
	innerBg.Size = UDim2.fromScale(1, 1)
	innerBg.BackgroundColor3 = INNER_TINT_COLOR
	innerBg.BackgroundTransparency = 0.72
	innerBg.BorderSizePixel = 0
	innerBg.ZIndex = 5
	innerBg.Parent = content
	Instance.new("UICorner", innerBg).CornerRadius = UDim.new(0, 8)
	local innerStroke = Instance.new("UIStroke")
	innerStroke.Color = CARD_BORDER
	innerStroke.Thickness = 1.2
	innerStroke.Transparency = 0.55
	innerStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	innerStroke.Parent = innerBg

	-- ── TOP: STREAK + PROGRESS BAR (fixed 40px strip) ───────────
	_streakLabel = Instance.new("TextLabel")
	_streakLabel.AnchorPoint = Vector2.new(0.5, 0)
	_streakLabel.Position = UDim2.new(0.5, 0, 0, 4)
	_streakLabel.Size = UDim2.new(1, -20, 0, 18)
	_streakLabel.BackgroundTransparency = 1
	_streakLabel.Font = Enum.Font.GothamBold
	_streakLabel.TextColor3 = STREAK_TEXT
	_streakLabel.TextSize = 14
	_streakLabel.Text = "Day 0 / 7"
	_streakLabel.ZIndex = 7
	_streakLabel.Parent = content

	local barBg = Instance.new("Frame")
	barBg.AnchorPoint = Vector2.new(0.5, 0)
	barBg.Position = UDim2.new(0.5, 0, 0, 26)
	barBg.Size = UDim2.new(0.7, 0, 0, 8)
	barBg.BackgroundColor3 = PROGRESS_BG
	barBg.BorderSizePixel = 0
	barBg.ZIndex = 7
	barBg.Parent = content
	Instance.new("UICorner", barBg).CornerRadius = UDim.new(1, 0)

	_progressFill = Instance.new("Frame")
	_progressFill.Size = UDim2.new(0, 0, 1, 0)
	_progressFill.BackgroundColor3 = PROGRESS_FILL
	_progressFill.BorderSizePixel = 0
	_progressFill.ZIndex = 8
	_progressFill.Parent = barBg
	Instance.new("UICorner", _progressFill).CornerRadius = UDim.new(1, 0)

	-- ── MIDDLE: CARDS AREA (fills available space) ──────────────
	-- Layout: 3-col × 2-row grid (days 1-6) on the left (~72%)
	--         tall Day 7 card on the right (~26%), 2% gap

	local TOP_OFFSET = 40     -- space for streak + progress bar
	local BOTTOM_OFFSET = 66  -- space for timer + claim button

	local cardsFrame = Instance.new("Frame")
	cardsFrame.Name = "CardsArea"
	cardsFrame.AnchorPoint = Vector2.new(0.5, 0)
	cardsFrame.Position = UDim2.new(0.5, 0, 0, TOP_OFFSET)
	cardsFrame.Size = UDim2.new(1, -16, 1, -(TOP_OFFSET + BOTTOM_OFFSET))
	cardsFrame.BackgroundTransparency = 1
	cardsFrame.ClipsDescendants = false
	cardsFrame.ZIndex = 6
	cardsFrame.Parent = content

	_dayCards = {}

	-- ── LEFT: 3×2 Grid container ────────────────────────────────
	local GRID_W_SCALE = 0.72
	local GAP_SCALE    = 0.02
	local DAY7_W_SCALE = 1 - GRID_W_SCALE - GAP_SCALE

	local gridFrame = Instance.new("Frame")
	gridFrame.Name = "GridDays"
	gridFrame.Size = UDim2.new(GRID_W_SCALE, 0, 1, 0)
	gridFrame.Position = UDim2.fromScale(0, 0)
	gridFrame.BackgroundTransparency = 1
	gridFrame.ZIndex = 6
	gridFrame.Parent = cardsFrame

	-- UIGridLayout for days 1-6
	local COLS, ROWS = 3, 2
	local CELL_PAD = 6
	local grid = Instance.new("UIGridLayout")
	grid.CellSize = UDim2.new(1 / COLS, -CELL_PAD, 1 / ROWS, -CELL_PAD)
	grid.CellPadding = UDim2.fromOffset(CELL_PAD, CELL_PAD)
	grid.FillDirection = Enum.FillDirection.Horizontal
	grid.SortOrder = Enum.SortOrder.LayoutOrder
	grid.HorizontalAlignment = Enum.HorizontalAlignment.Center
	grid.VerticalAlignment = Enum.VerticalAlignment.Center
	grid.Parent = gridFrame

	for i = 1, 6 do
		local c = buildDayCard(gridFrame, i)
		c.LayoutOrder = i
	end

	-- ── RIGHT: Day 7 featured card ──────────────────────────────
	local day7Frame = Instance.new("Frame")
	day7Frame.Name = "Day7Frame"
	day7Frame.AnchorPoint = Vector2.new(1, 0)
	day7Frame.Size = UDim2.new(DAY7_W_SCALE, 0, 1, 0)
	day7Frame.Position = UDim2.fromScale(1, 0)
	day7Frame.BackgroundTransparency = 1
	day7Frame.ZIndex = 6
	day7Frame.Parent = cardsFrame

	local c7 = buildDayCard(day7Frame, 7)
	c7.Size = UDim2.fromScale(1, 1)

	-- ── BOTTOM: Timer + Claim ───────────────────────────────────
	_timerLabel = Instance.new("TextLabel")
	_timerLabel.AnchorPoint = Vector2.new(0.5, 1)
	_timerLabel.Position = UDim2.new(0.5, 0, 1, -48)
	_timerLabel.Size = UDim2.new(1, -20, 0, 18)
	_timerLabel.BackgroundTransparency = 1
	_timerLabel.Font = Enum.Font.GothamSemibold
	_timerLabel.TextColor3 = TIMER_WAIT
	_timerLabel.TextSize = 13
	_timerLabel.Text = "Loading..."
	_timerLabel.ZIndex = 7
	_timerLabel.Parent = content

	_claimButton = Instance.new("TextButton")
	_claimButton.Name = "ClaimButton"
	_claimButton.AnchorPoint = Vector2.new(0.5, 1)
	_claimButton.Position = UDim2.new(0.5, 0, 1, -8)
	_claimButton.Size = UDim2.new(0.45, 0, 0, 36)
	_claimButton.BackgroundColor3 = CLAIM_GREEN
	_claimButton.BorderSizePixel = 0
	_claimButton.Font = Enum.Font.GothamBold
	_claimButton.TextColor3 = Color3.fromRGB(255, 255, 255)
	_claimButton.TextSize = 16
	_claimButton.Text = "CLAIM REWARD"
	_claimButton.AutoButtonColor = true
	_claimButton.ZIndex = 7
	_claimButton.Parent = content
	Instance.new("UICorner", _claimButton).CornerRadius = UDim.new(0, 10)
	local btnStroke = Instance.new("UIStroke")
	btnStroke.Color = Color3.fromRGB(255, 206, 120)
	btnStroke.Thickness = 1.5
	btnStroke.Transparency = 0.5
	btnStroke.Parent = _claimButton

	_claimButton.MouseButton1Click:Connect(onClaim)

	log("Initialized")
end

-- ═══════════════════════════════════════════════════════════════════
-- SHOW / HIDE / TOGGLE
-- ═══════════════════════════════════════════════════════════════════

function DailyRewardsPanel.Show()
	if visible then return end
	visible = true
	overlay.Visible = true
	SoundUtil.Open()
	AnimUtil.OpenPanel(canvas, uiScale)
	startBgFadeLoop()

	task.spawn(function()
		_status = fetchStatus()
		if _status then
			updateDayCards(_status)
			startTimerLoop()
		end
	end)
end

function DailyRewardsPanel.Hide()
	if not visible then return end
	visible = false
	stopBgFadeLoop()
	stopTimerLoop()
	overlay.Visible = false
	local t = AnimUtil.ClosePanel(canvas, uiScale)
	task.spawn(function()
		t.Completed:Wait()
		canvas.Visible = false
	end)
	if closeCallback then closeCallback() end
end

function DailyRewardsPanel.IsVisible()
	return visible
end

function DailyRewardsPanel.Toggle()
	if visible then DailyRewardsPanel.Hide() else DailyRewardsPanel.Show() end
end

function DailyRewardsPanel.TryAutoShow(openerFn)
	if _hasAutoShown then return end
	_hasAutoShown = true
	local doOpen = openerFn or function() DailyRewardsPanel.Show() end
	task.spawn(function()
		task.wait(2)
		if FORCE_OPEN_DAILY_ON_JOIN then
			log("FORCE_OPEN: auto-opening Daily Rewards")
			doOpen()
			return
		end
		-- Retry until PlayerData is loaded on the server (up to ~18 s total)
		local MAX_ATTEMPTS = 6
		local RETRY_WAIT  = 3
		for attempt = 1, MAX_ATTEMPTS do
			local status = fetchStatus()
			if status then
				if status.canClaim then
					log(string.format("Auto-opening: reward available (attempt %d)", attempt))
					doOpen()
					return
				elseif status.dataLoaded ~= false then
					-- Data is fully loaded but no reward is available yet
					log("Auto-show: data loaded, no reward available")
					return
				end
				log(string.format("Auto-show: data not loaded yet (attempt %d/%d), retrying in %ds", attempt, MAX_ATTEMPTS, RETRY_WAIT))
			end
			if attempt < MAX_ATTEMPTS then
				task.wait(RETRY_WAIT)
			end
		end
		log("Auto-show: gave up waiting for data after " .. MAX_ATTEMPTS .. " attempts")
	end)
end

return DailyRewardsPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="117">
            <Properties>
              <string name="Name">FateCrownsPanel</string>
              <string name="Source"><![CDATA[--[[
	FateCrownsPanel
	Crown collection / equip grid — shows ALL 17 crowns organized by source.

	Display order:
	  • Level Crowns   (earned by wins milestones)
	  • Findable Crowns (from Crown Crate / Spin Wheel)
	  • Exclusive Crowns (Shop-only, Robux)

	Each card:
	  • ViewportFrame showing the 3D crown model
	  • Owned = full color + Equip button (server-wired)
	  • Unowned = greyed/locked + source label:
	      Level → "X Wins"
	      Findable → "Crown Crate"
	      Exclusive → "Shop Only"

	Data source: ItemCatalog.GetAllCrownsSorted()
	Ownership:   Player "OwnedCrowns" attribute (JSON array of catalog IDs)

	Used by: UIController (sidebar "Crowns" button)
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")
local MarketplaceService = game:GetService("MarketplaceService")

local Shared = ReplicatedStorage:WaitForChild("Shared", 60)
if not Shared then
	warn("[FateCrownsPanel] Shared not found after 60s -- disabled")
	return { Init = function() end, Show = function() end, Hide = function() end,
		IsVisible = function() return false end, Toggle = function() end }
end

local CDPModule = Shared:WaitForChild("ClientDepsProvider", 60)
if not CDPModule then
	warn("[FateCrownsPanel] ClientDepsProvider MISSING")
	return { Init = function() end, Show = function() end, Hide = function() end,
		IsVisible = function() return false end, Toggle = function() end }
end

local ok, Deps = pcall(require, CDPModule)
if not ok or not Deps then
	warn("[FateCrownsPanel] require(ClientDepsProvider) FAILED:", Deps)
	return { Init = function() end, Show = function() end, Hide = function() end,
		IsVisible = function() return false end, Toggle = function() end }
end
local UIConfig = Deps.UIConfig
local ItemCatalog = Deps.ItemCatalog

-- Build a crownId → gamepassId map from MockPremiumItems so the inventory
-- can fall back to gamepass ownership for exclusive crowns (same source as Shop).
local _crownGamepassMap: {[string]: number} = {}
for _, item in ipairs(UIConfig.MockPremiumItems) do
	if item.type == "ExclusiveCrown" and item.gamepassId and item.id then
		_crownGamepassMap[item.id] = item.gamepassId
	end
end

local Client = script.Parent
local AnimUtil   = require(Client:WaitForChild("AnimUtil"))
local SoundUtil  = require(Client:WaitForChild("SoundUtil"))
local Components = require(Client:WaitForChild("Components"))

local C = UIConfig.Colors

local player = Players.LocalPlayer

local canvas: CanvasGroup = nil
local uiScale: UIScale = nil
local overlay: Frame = nil
local contentFrame: ScrollingFrame = nil
local visible = false
local closeCallback: (() -> ())? = nil

local equippedId: string? = nil

local FateCrownsPanel = {}

local function getOwnedCrownSet(): { [string]: boolean }
	local json = player:GetAttribute("OwnedCrowns") or "[]"
	local okDec, list = pcall(HttpService.JSONDecode, HttpService, json)
	if not okDec or type(list) ~= "table" then list = {} end
	local set = {}
	for _, id in ipairs(list) do
		set[id] = true
	end
	-- Ownership is inventory-driven only; server grant confirmation updates attributes.
	return set
end

local function getEquipRemote(): RemoteEvent?
	local remotes = ReplicatedStorage:FindFirstChild("Remotes")
	if not remotes then return nil end
	return remotes:FindFirstChild("EquipItem")
end

local function getUnequipRemote(): RemoteEvent?
	local remotes = ReplicatedStorage:FindFirstChild("Remotes")
	if not remotes then return nil end
	return remotes:FindFirstChild("UnequipItem")
end

local function clearContent()
	for _, child in ipairs(contentFrame:GetChildren()) do
		if child:IsA("Frame") then child:Destroy() end
	end
end

--- Build a sub-label for unowned crowns based on source (delegates to ItemCatalog)
local function getSubLabel(crown): string?
	return ItemCatalog.GetCrownAcquisitionLabel(crown.id)
end

local function refresh()
	clearContent()

	local ownedSet = getOwnedCrownSet()
	equippedId = player:GetAttribute("EquippedCrown") or nil
	local allCrowns = ItemCatalog.GetAllCrownsSorted()
	for _, crown in ipairs(allCrowns) do
		if crown.name == "Aura Crown" then
			print(string.format("[CrownCatalog] AuraCrown id=%s", tostring(crown.id)))
			break
		end
	end

	for i, crown in ipairs(allCrowns) do
		local isOwned = ownedSet[crown.id] == true
		local isEquipped = isOwned and (crown.id == equippedId)
		local actionText = nil
		local actionColor = nil
		local subLabel = nil

		if isOwned then
			actionText = isEquipped and "Equipped" or "Equip"
			actionColor = isEquipped and C.Green or C.EquipButton
		else
			subLabel = getSubLabel(crown)
		end

		Components.CreateViewportItemCard(contentFrame, {
			name = crown.name,
			rarity = crown.rarity,
			iconColor = crown.iconColor,
			thumbnailBgColor = crown.thumbnailBgColor,
			iconText = crown.iconText or "",
			image = ItemCatalog.GetImage(crown),
			modelPath = crown.modelPath,
			locked = not isOwned,
			equipped = isEquipped,
			owned = isOwned,
			subLabel = subLabel,
			actionText = actionText,
			actionColor = actionColor,
			onAction = function()
				if isOwned then
					if isEquipped then
						-- Unequip
						local unequipRemote = getUnequipRemote()
						if unequipRemote then
							unequipRemote:FireServer("Crowns")
						end
						equippedId = nil
					else
						-- Equip via server
						local equipRemote = getEquipRemote()
						if equipRemote then
							equipRemote:FireServer("Crowns", crown.id)
						end
						equippedId = crown.id
					end
					SoundUtil.Equip()
					refresh()
				end
			end,
		}).LayoutOrder = i
	end
end

function FateCrownsPanel.Init(screenGui: ScreenGui, onClose: () -> ())
	closeCallback = onClose

	overlay = Components.CreateDimOverlay(screenGui, function()
		FateCrownsPanel.Hide()
	end)

	local content, closeBtn
	canvas, uiScale, content, closeBtn = Components.CreatePanel(screenGui, "FATE CROWNS", C.HeaderCrowns, "Crowns")
	contentFrame = content

	Components.AddGridLayout(content)

	closeBtn.MouseButton1Click:Connect(function()
		SoundUtil.Close()
		FateCrownsPanel.Hide()
	end)

	-- Override stud texture to Fate Beams asset (only this panel)
	do
		local stud = canvas:FindFirstChild("StudTexture")
		if stud then
			stud.Image = "rbxassetid://70851348312450"
			stud.TileSize = UDim2.fromOffset(96, 96)
			stud.ImageTransparency = 0.88
			stud.ImageColor3 = Color3.fromRGB(255, 255, 255)
		end
	end

	-- Refresh when ownership/equip changes
	player:GetAttributeChangedSignal("OwnedCrowns"):Connect(function()
		if visible then refresh() end
	end)
	player:GetAttributeChangedSignal("EquippedCrown"):Connect(function()
		if visible then refresh() end
	end)

	-- Also listen for InventoryUpdated remote
	task.spawn(function()
		local remotes = ReplicatedStorage:WaitForChild("Remotes", 10)
		if remotes then
			local invUpdate = remotes:FindFirstChild("InventoryUpdated")
			if invUpdate and invUpdate:IsA("RemoteEvent") then
				invUpdate.OnClientEvent:Connect(function()
					if visible then refresh() end
				end)
			end
		end
	end)

	refresh()
end

function FateCrownsPanel.Show()
	if visible then return end
	visible = true
	overlay.Visible = true
	refresh()
	SoundUtil.Open()
	AnimUtil.OpenPanel(canvas, uiScale)
end

function FateCrownsPanel.Hide()
	if not visible then return end
	visible = false
	overlay.Visible = false
	local t = AnimUtil.ClosePanel(canvas, uiScale)
	task.spawn(function()
		t.Completed:Wait()
		canvas.Visible = false
	end)
	if closeCallback then closeCallback() end
end

function FateCrownsPanel.IsVisible(): boolean
	return visible
end

function FateCrownsPanel.Toggle()
	if visible then FateCrownsPanel.Hide() else FateCrownsPanel.Show() end
end

return FateCrownsPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="118">
            <Properties>
              <string name="Name">HUDPanel</string>
              <string name="Source"><![CDATA[--[[
	HUDPanel
	Always-visible heads-up display:
	  * Coin counter (top-left) -- glossy capsule, gold "F" icon
	  * Round badge (top-center) -- shows "Lobby" / "Round X" / "Results"
	  * Timer label (below round badge) -- shows seconds left
	  * 2x4 sidebar grid (left) -- Shop, Crowns, Pets, Index,
	    Spectate, Settings, AFK toggle, Icon Images
	  * Intermission bar (top-center) -- single bright horizontal pill
	    REPLACES the round badge during intermission (no duplicate!)

	KEY FIX: During intermission, the round badge + state label HIDE,
	and a single horizontal bar shows "Game starting in X".
	When playing, the bar hides and round badge returns.

	FIX: SetBannerOverrideHidden hides ALL top-center banners
	(intermission bar + round badge + timer) when a panel is open.

	FIX: Countdown uses server-authoritative PhaseEndTime
	(workspace:GetServerTimeNow). Even if UI loads late,
	the banner instantly shows the correct remaining time.

	Used by: UIController
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared", 10)
local UIConfig = require(Shared:WaitForChild("UIConfig", 10))

local Client = script.Parent
local AnimUtil   = require(Client:WaitForChild("AnimUtil"))
local SoundUtil  = require(Client:WaitForChild("SoundUtil"))
local Components = require(Client:WaitForChild("Components"))

local C = UIConfig.Colors
local S = UIConfig.Sizes
local LocalPlayer = Players.LocalPlayer

local coinLabel: TextLabel = nil
local coinScale: UIScale = nil
local roundFrame: Frame = nil
local roundLabel: TextLabel = nil
local stateLabel: TextLabel = nil

-- Intermission bar elements
local intermissionBar: Frame = nil
local intermissionLabel: TextLabel = nil
local intermissionVisible = false
local bannerOverrideHidden = false

local HUDPanel = {}
local isMobileTouch = UserInputService.TouchEnabled
local coinRestScale = 1

local function formatCoins(n: number): string
	if n >= 1000000 then return string.format("%.1fM", n / 1000000) end
	if n >= 10000 then return string.format("%.1fK", n / 1000) end
	return tostring(n)
end

function HUDPanel.Init(screenGui: ScreenGui, callbacks: {
	onShop: () -> (),
	onCrowns: () -> (),
	onPets: () -> (),
	onIndex: () -> (),
	onSpectate: () -> (),
	onSettings: () -> (),
	onAFK: () -> (),
	onIcons: () -> (),
	onDaily: () -> (),
	onStats: () -> (),
	onQuests: () -> (),
})
	-- COIN COUNTER (glossy capsule)
	local coinFrame = Instance.new("Frame")
	coinFrame.Name = "CoinFrame"
	coinFrame.AnchorPoint = Vector2.new(0, 0)
	coinFrame.Position = UDim2.fromOffset(16, 16)
	coinFrame.Size = UDim2.fromOffset(S.HudCoinW, S.HudCoinH)
	coinFrame.BackgroundColor3 = C.HudCoinBg
	coinFrame.BackgroundTransparency = 0
	coinFrame.BorderSizePixel = 0
	coinFrame.Parent = screenGui

	local coinCorner = Instance.new("UICorner")
	coinCorner.CornerRadius = UDim.new(0, S.HudCoinH / 2)
	coinCorner.Parent = coinFrame

	local coinStroke = Instance.new("UIStroke")
	coinStroke.Color = C.Gold
	coinStroke.Thickness = 2.5
	coinStroke.Transparency = 0.18
	coinStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	coinStroke.Parent = coinFrame

	local coinGrad = Instance.new("UIGradient")
	coinGrad.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(58, 65, 100)),
		ColorSequenceKeypoint.new(0.5, Color3.fromRGB(36, 40, 70)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(22, 25, 50)),
	})
	coinGrad.Rotation = 90
	coinGrad.Parent = coinFrame

	Components.AddStudTexture(coinFrame, S.HudCoinH / 2)

	local coinShadow = Instance.new("Frame")
	coinShadow.Name = "Shadow"
	coinShadow.AnchorPoint = Vector2.new(0.5, 0.5)
	coinShadow.Position = UDim2.new(0.5, 2, 0.5, 3)
	coinShadow.Size = UDim2.new(1, 12, 1, 12)
	coinShadow.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
	coinShadow.BackgroundTransparency = 0.5
	coinShadow.BorderSizePixel = 0
	coinShadow.ZIndex = 0
	coinShadow.Parent = coinFrame
	local csc = Instance.new("UICorner")
	csc.CornerRadius = UDim.new(0, S.HudCoinH / 2 + 6)
	csc.Parent = coinShadow

	coinScale = Instance.new("UIScale")
	coinScale.Parent = coinFrame
	-- Mobile: shrink the coin frame so it doesn't crowd the sidebar
	coinRestScale = isMobileTouch and 0.75 or 1
	coinScale.Scale = coinRestScale

	local coinIcon = Instance.new("TextLabel")
	coinIcon.Name = "CoinIcon"
	coinIcon.Size = UDim2.fromOffset(36, 36)
	coinIcon.Position = UDim2.fromOffset(7, (S.HudCoinH - 36) / 2)
	coinIcon.BackgroundColor3 = C.Gold
	coinIcon.Font = Enum.Font.GothamBold
	coinIcon.Text = "F"
	coinIcon.TextColor3 = Color3.fromRGB(105, 70, 0)
	coinIcon.TextSize = 22
	coinIcon.BorderSizePixel = 0
	coinIcon.ZIndex = 2
	coinIcon.Parent = coinFrame
	local icCorner = Instance.new("UICorner")
	icCorner.CornerRadius = UDim.new(1, 0)
	icCorner.Parent = coinIcon
	local icStroke = Instance.new("UIStroke")
	icStroke.Color = Color3.fromRGB(190, 155, 22)
	icStroke.Thickness = 2
	icStroke.Transparency = 0.15
	icStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	icStroke.Parent = coinIcon

	coinLabel = Instance.new("TextLabel")
	coinLabel.Name = "CoinAmount"
	coinLabel.Size = UDim2.new(1, -56, 1, 0)
	coinLabel.Position = UDim2.fromOffset(52, 0)
	coinLabel.BackgroundTransparency = 1
	coinLabel.Font = Enum.Font.GothamBold
	coinLabel.TextColor3 = C.TextWhite
	coinLabel.TextSize = 24
	coinLabel.TextXAlignment = Enum.TextXAlignment.Left
	coinLabel.Text = "0"
	coinLabel.ZIndex = 2
	coinLabel.Parent = coinFrame
	local clStroke = Instance.new("UIStroke")
	clStroke.Color = Color3.fromRGB(0, 0, 0)
	clStroke.Thickness = 1.8
	clStroke.Transparency = 0.15
	clStroke.Parent = coinLabel

	-- ROUND BADGE (top-center, glossy pill)
	roundFrame = Instance.new("Frame")
	roundFrame.Name = "RoundFrame"
	roundFrame.AnchorPoint = Vector2.new(0.5, 0)
	roundFrame.Position = UDim2.new(0.5, 0, 0, 16)
	roundFrame.Size = UDim2.fromOffset(S.HudRoundW, S.HudRoundH)
	roundFrame.BackgroundColor3 = C.HudRoundBg
	roundFrame.BorderSizePixel = 0
	roundFrame.Parent = screenGui

	local rCorner = Instance.new("UICorner")
	rCorner.CornerRadius = UDim.new(0, S.HudRoundH / 2)
	rCorner.Parent = roundFrame
	local rStroke = Instance.new("UIStroke")
	rStroke.Color = Color3.fromRGB(255, 218, 115)
	rStroke.Thickness = 2.5
	rStroke.Transparency = 0.12
	rStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	rStroke.Parent = roundFrame

	local rGrad = Instance.new("UIGradient")
	rGrad.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 208, 98)),
		ColorSequenceKeypoint.new(0.5, Color3.fromRGB(248, 162, 42)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(195, 108, 15)),
	})
	rGrad.Rotation = 90
	rGrad.Parent = roundFrame

	Components.AddStudTexture(roundFrame, S.HudRoundH / 2)

	local rShadow = Instance.new("Frame")
	rShadow.Name = "Shadow"
	rShadow.AnchorPoint = Vector2.new(0.5, 0.5)
	rShadow.Position = UDim2.new(0.5, 2, 0.5, 3)
	rShadow.Size = UDim2.new(1, 12, 1, 12)
	rShadow.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
	rShadow.BackgroundTransparency = 0.48
	rShadow.BorderSizePixel = 0
	rShadow.ZIndex = 0
	rShadow.Parent = roundFrame
	local rsc = Instance.new("UICorner")
