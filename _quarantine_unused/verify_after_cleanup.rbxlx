      <Item class="Script" referent="16">
        <Properties>
          <string name="Name">AnimateR15_NPC</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--[[
	NPC-safe R15 Animate script.
	Adapted for server-driven NPC humanoids:
	- No UserSettings() calls
	- No LocalPlayer chat hooks
	- No PlayEmote bindable dependencies
]]

local model = script.Parent
if not model or not model:IsA("Model") then
	return
end

local humanoid = model:FindFirstChildOfClass("Humanoid")
if not humanoid then
	return
end

local animator = humanoid:FindFirstChildOfClass("Animator")
if not animator then
	animator = Instance.new("Animator")
	animator.Parent = humanoid
end

-- Explicit NPC-safe defaults requested by caller.
local userNoUpdateOnLoop = false
local userAnimateScaleRun = false

local function getAnimId(name: string, fallback: string): string
	local node = script:FindFirstChild(name)
	if node and node:IsA("StringValue") and node.Value ~= "" then
		return node.Value
	end
	return fallback
end

local animIds = {
	idle = getAnimId("idle", "rbxassetid://507766666"),
	walk = getAnimId("walk", "rbxassetid://507777826"),
	run = getAnimId("run", "rbxassetid://507767714"),
	jump = getAnimId("jump", "rbxassetid://507765000"),
	fall = getAnimId("fall", "rbxassetid://507767968"),
}

local tracks: {[string]: AnimationTrack?} = {}
local current = ""

local function loadTrack(name: string, priority: Enum.AnimationPriority): AnimationTrack?
	local anim = Instance.new("Animation")
	anim.AnimationId = animIds[name]
	local ok, track = pcall(function()
		return animator:LoadAnimation(anim)
	end)
	anim:Destroy()
	if not ok or not track then
		return nil
	end
	track.Priority = priority
	track.Looped = (name == "idle" or name == "walk" or name == "run")
	return track
end

tracks.idle = loadTrack("idle", Enum.AnimationPriority.Core)
tracks.walk = loadTrack("walk", Enum.AnimationPriority.Movement)
tracks.run = loadTrack("run", Enum.AnimationPriority.Movement)
tracks.jump = loadTrack("jump", Enum.AnimationPriority.Action)
tracks.fall = loadTrack("fall", Enum.AnimationPriority.Action)

local function stopMovementTracks()
	if tracks.walk and tracks.walk.IsPlaying then
		pcall(function() tracks.walk:Stop(0.15) end)
	end
	if tracks.run and tracks.run.IsPlaying then
		pcall(function() tracks.run:Stop(0.15) end)
	end
	if tracks.idle and tracks.idle.IsPlaying then
		pcall(function() tracks.idle:Stop(0.15) end)
	end
end

local function setState(state: string)
	if current == state and userNoUpdateOnLoop == false then
		-- Keep processing updates; this mirrors default animate behavior.
	end
	current = state

	if state == "idle" then
		if tracks.walk and tracks.walk.IsPlaying then
			pcall(function() tracks.walk:Stop(0.15) end)
		end
		if tracks.run and tracks.run.IsPlaying then
			pcall(function() tracks.run:Stop(0.15) end)
		end
		if tracks.idle and not tracks.idle.IsPlaying then
			pcall(function() tracks.idle:Play(0.15) end)
		end
		return
	end

	if state == "walk" then
		if tracks.idle and tracks.idle.IsPlaying then
			pcall(function() tracks.idle:Stop(0.15) end)
		end
		if tracks.run and tracks.run.IsPlaying then
			pcall(function() tracks.run:Stop(0.15) end)
		end
		if tracks.walk and not tracks.walk.IsPlaying then
			pcall(function() tracks.walk:Play(0.1) end)
		end
		if tracks.walk then
			local speedScale = userAnimateScaleRun and 1.0 or 1.0
			pcall(function() tracks.walk:AdjustSpeed(speedScale) end)
		end
		return
	end

	if state == "run" then
		if tracks.idle and tracks.idle.IsPlaying then
			pcall(function() tracks.idle:Stop(0.1) end)
		end
		if tracks.walk and tracks.walk.IsPlaying then
			pcall(function() tracks.walk:Stop(0.1) end)
		end
		if tracks.run and not tracks.run.IsPlaying then
			pcall(function() tracks.run:Play(0.1) end)
		end
		return
	end

	if state == "jump" then
		stopMovementTracks()
		if tracks.jump then
			pcall(function() tracks.jump:Play(0.05) end)
		end
		return
	end

	if state == "fall" then
		stopMovementTracks()
		if tracks.fall then
			pcall(function() tracks.fall:Play(0.05) end)
		end
		return
	end
end

humanoid.Running:Connect(function(speed)
	if speed > 10 then
		setState("run")
	elseif speed > 0.5 then
		setState("walk")
	else
		setState("idle")
	end
end)

humanoid.Jumping:Connect(function()
	setState("jump")
end)

humanoid.FreeFalling:Connect(function(isFalling)
	if isFalling then
		setState("fall")
	else
		setState("idle")
	end
end)

humanoid.Died:Connect(function()
	for _, t in pairs(tracks) do
		if t and t.IsPlaying then
			pcall(function() t:Stop(0.1) end)
		end
	end
end)

setState("idle")
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">BundleCatalog</string>
          <string name="Source">--[[
	BundleCatalog
	Data module listing all purchasable bundles.
	Used only by BundlePanel for rendering the bundle shop UI.

	Each bundle entry contains:
	  id           – unique string identifier
	  displayName  – UI-visible name
	  coverImage   – rbxassetid for the hero cover art
	  isAvailable  – whether the bundle can currently be purchased
	  isLimited    – show LIMITED badge
	  priceRobux   – Robux price (display only; actual charge via gamepassId/productId)
	  gamepassId   – Game Pass ID for permanent bundles (nil = not yet wired)
	  productId    – Developer Product ID for consumable bundles (nil = not yet wired)
	  tag          – badge text ("NEW", "VIP", "DEAL", "LIMITED", etc.)
	  rarity       – rarity string for border color
	  includes     – ordered list of { category, itemId } pairs

	API:
	  BundleCatalog.GetAll()   → ordered array of bundle entries
	  BundleCatalog.Get(id)    → single entry or nil
]]

local BundleCatalog = {}

local COIN_PRICING_DEFAULTS = {
	-- Keep this in the requested 10%-40% cap range.
	maxDiscountPercent = 0.30,
	minDiscountCapPercent = 0.10,
	maxDiscountCapPercent = 0.40,
}

local _bundles = {
	{
		id           = "fnaf_pets_bundle",
		displayName  = "FNAF Pets",
		coverImage   = "rbxassetid://72168519670720",
		isAvailable  = true,
		isLimited    = false,
		priceFateCoins = 150000,
		coinPricing = {
			baseCost = 150000,
			maxDiscountPercent = COIN_PRICING_DEFAULTS.maxDiscountPercent,
		},
		priceRobux   = 500,
		gamepassId   = 1732407562,
		productId    = nil,
		tag          = "NEW",
		rarity       = "Epic",
		includes     = {
			{ category = "Pets", itemId = "pet_freddy_fazbear" },
			{ category = "Pets", itemId = "pet_bonnie" },
			{ category = "Pets", itemId = "pet_chica" },
			{ category = "Pets", itemId = "pet_foxy" },
			{ category = "Pets", itemId = "pet_golden_freddy" },
			{ category = "Pets", itemId = "pet_the_puppet" },
			{ category = "Pets", itemId = "pet_cupcake" },
		},
	},
	{
		id           = "brainrot_bundle",
		displayName  = "Brainrot Bundle",
		coverImage   = "rbxassetid://137027689618122",
		isAvailable  = true,
		isLimited    = false,
		priceFateCoins = 150000,
		coinPricing = {
			baseCost = 150000,
			maxDiscountPercent = COIN_PRICING_DEFAULTS.maxDiscountPercent,
		},
		priceRobux   = 800,
		gamepassId   = 1714491142,
		productId    = nil,
		tag          = "NEW",
		rarity       = "Legendary",
		includes     = {
			{ category = "Pets",       itemId = "pet_67" },
			{ category = "Pets",       itemId = "pet_dragon_cannelloni" },
			{ category = "Pets",       itemId = "pet_frigo_camelo" },
			{ category = "Pets",       itemId = "pet_tigroligre_frutonni" },
			{ category = "Pets",       itemId = "pet_trenostruzzo_turbo_3000" },
			{ category = "Crowns",     itemId = "crown_67" },
			{ category = "IconImages", itemId = "icon_67_kid" },
			{ category = "IconImages", itemId = "icon_steve_harrington" },
		},
	},
	{
		id           = "jjk_bundle",
		displayName  = "JJK Bundle",
		coverImage   = "rbxassetid://98977461567105",
		isAvailable  = false,
		isLimited    = false,
		priceRobux   = 1000,
		productId    = nil,
		tag          = "",
		rarity       = "Legendary",
		includes     = {},
	},
	{
		id           = "bundle_vip",
		displayName  = "VIP Bundle",
		coverImage   = "",
		isAvailable  = false,
		isLimited    = false,
		priceRobux   = 500,
		productId    = nil,
		tag          = "VIP",
		rarity       = "Legendary",
		includes     = {},
	},
	{
		id           = "bundle_starter",
		displayName  = "Starter Pack",
		coverImage   = "",
		isAvailable  = false,
		isLimited    = false,
		priceRobux   = 100,
		productId    = nil,
		tag          = "DEAL",
		rarity       = "Rare",
		includes     = {},
	},
}

local _byId: { [string]: any } = {}
for _, bundle in ipairs(_bundles) do
	_byId[bundle.id] = bundle
end

function BundleCatalog.GetAll()
	return _bundles
end

function BundleCatalog.Get(id: string)
	return _byId[id]
end

function BundleCatalog.GetCoinPricing(id: string): { baseCost: number, maxDiscountPercent: number }?
	local bundle = _byId[id]
	if not bundle then
		return nil
	end
	local pricing = bundle.coinPricing
	if type(pricing) ~= "table" then
		return nil
	end
	local baseCost = tonumber(pricing.baseCost) or tonumber(bundle.priceFateCoins) or 0
	local maxDiscountPercent = tonumber(pricing.maxDiscountPercent) or COIN_PRICING_DEFAULTS.maxDiscountPercent
	maxDiscountPercent = math.clamp(
		maxDiscountPercent,
		COIN_PRICING_DEFAULTS.minDiscountCapPercent,
		COIN_PRICING_DEFAULTS.maxDiscountCapPercent
	)
	return {
		baseCost = math.max(0, math.floor(baseCost)),
		maxDiscountPercent = maxDiscountPercent,
	}
end

function BundleCatalog.ComputeCoinCost(id: string, ownedCount: number, totalCount: number): number?
	local pricing = BundleCatalog.GetCoinPricing(id)
	if not pricing then
		return nil
	end
	local total = math.max(0, math.floor(totalCount or 0))
	if total &lt;= 0 then
		return pricing.baseCost
	end
	local owned = math.clamp(math.floor(ownedCount or 0), 0, total)
	local discountPercent = math.clamp((owned / total) * pricing.maxDiscountPercent, 0, pricing.maxDiscountPercent)
	return math.floor(pricing.baseCost * (1 - discountPercent))
end

return BundleCatalog</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">ClientDepsProvider</string>
          <string name="Source"><![CDATA[--[[
	ClientDepsProvider
	Centralized dependency loader for all client UI scripts.

	Usage:
	  -- In init.client.luau (once, before requiring UIController):
	  local CDP = require(Shared:WaitForChild("ClientDepsProvider", 10))
	  local ok, deps = CDP.WaitUntilReady(5)

	  -- In panel modules (instant — cached from first call):
	  local Deps = require(Shared.ClientDepsProvider)
	  local ItemCatalog = Deps.ItemCatalog

	WaitUntilReady uses ChildAdded events (not polling loops) to wait
	for required modules. Returns (ok, self) so callers can check.
]]

local Shared = script.Parent
local TAG = "[ClientDeps]"
local _bootTime = tick()

local function ts()
	return string.format("%.3f", tick() - _bootTime)
end

-- ═══════════════════════════════════════════
-- Deps table — returned by require(); mutated in place by WaitUntilReady
-- ═══════════════════════════════════════════
local Deps = {
	ItemCatalog = nil,
	UIConfig = nil,
	SpinWheelConfig = nil,
	_ready = false,
}

local REQUIRED = { "ItemCatalog", "UIConfig" }
local OPTIONAL = { "SpinWheelConfig" }

local function safeRequire(name)
	local mod = Shared:FindFirstChild(name)
	if not mod then return nil end
	local ok, result = pcall(require, mod)
	if ok then
		print(TAG, "t=" .. ts(), name, "loaded OK")
		return result
	end
	warn(TAG, "t=" .. ts(), name, "require FAILED:", tostring(result))
	return nil
end

local function tryLoadAll(): boolean
	if Deps._ready then return true end
	for _, name in ipairs(REQUIRED) do
		if not Shared:FindFirstChild(name) then return false end
	end
	for _, name in ipairs(REQUIRED) do
		if not Deps[name] then
			local mod = safeRequire(name)
			if not mod then return false end
			Deps[name] = mod
		end
	end
	for _, name in ipairs(OPTIONAL) do
		if not Deps[name] then
			Deps[name] = safeRequire(name)
		end
	end
	Deps._ready = true
	return true
end

-- ═══════════════════════════════════════════
-- WaitUntilReady: call once from init.client before UIController
-- Uses ChildAdded events (not polling) with bounded timeout.
-- ═══════════════════════════════════════════
function Deps.WaitUntilReady(timeout: number?): (boolean, typeof(Deps))
	timeout = timeout or 5
	if Deps._ready then return true, Deps end

	print(TAG, "t=" .. ts(), "WaitUntilReady (timeout=" .. timeout .. "s)")

	if tryLoadAll() then
		print(TAG, "t=" .. ts(), "deps ready (instant)")
		return true, Deps
	end

	local startTime = tick()
	local conn
	conn = Shared.ChildAdded:Connect(function()
		tryLoadAll()
	end)

	while not Deps._ready and (tick() - startTime) < timeout do
		tryLoadAll()
		task.wait(0.05)
	end

	if conn then conn:Disconnect() end

	if Deps._ready then
		print(TAG, "t=" .. ts(), string.format("deps ready (%.2fs)", tick() - startTime))
		return true, Deps
	end

	warn(TAG, "t=" .. ts(), "deps NOT ready after " .. timeout .. "s — installing fallbacks")
	if not Deps.ItemCatalog then
		Deps.ItemCatalog = {
			Get = function() return nil end,
			GetImage = function() return "" end,
			GetImageById = function() return "" end,
			GetPet = function() return nil end,
			GetAllPetsSorted = function() return {} end,
			GetAllIconsSorted = function() return {} end,
			GetByName = function() return nil end,
			Currency = {},
			CoinImage = "",
		}
	end
	Deps._ready = true
	return false, Deps
end

-- Try loading immediately (instant if Rojo-synced)
tryLoadAll()

local Players = game:GetService("Players")
local playerName = "?"
pcall(function() playerName = Players.LocalPlayer and Players.LocalPlayer.Name or "?" end)
print(TAG, "t=" .. ts(), "module loaded for", playerName, "ready=" .. tostring(Deps._ready))

return Deps
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">CoinConfig</string>
          <string name="Source"><![CDATA[--[[
	CoinConfig
	Shared configuration for match coin rewards.
	
	Used by: EliminationTracker, EconomyService, MatchManager
]]

local CoinConfig = {}

-- Reward amounts per placement (5–12 player matches)
CoinConfig.FirstPlace = 100
CoinConfig.SecondPlace = 60
CoinConfig.ThirdPlace = 35
CoinConfig.Participation = 15
CoinConfig.LastPlace = 0

-- Small match threshold: if playerCount <= this, use SmallMatchPayouts table
CoinConfig.SmallMatchMaxPlayers = 4

-- Per-placement payout tables for small lobbies (indexed by player count).
-- Every placement earns coins — last place is always > 0.
-- Values are coin amounts per placement rank (1st, 2nd, 3rd, 4th).
CoinConfig.SmallMatchPayouts = {
	[2] = { 100, 50 },            -- 1st=100, 2nd=50
	[3] = { 100, 60, 30 },        -- 1st=100, 2nd=60, 3rd=30
	[4] = { 100, 70, 40, 20 },    -- 1st=100, 2nd=70, 3rd=40, 4th=20
}

-- Time window (seconds) for grouping simultaneous eliminations into same placement
-- Players eliminated within this window of each other share the same rank
CoinConfig.SimultaneousWindow = 0.1

-- Debug logging
CoinConfig.DebugLog = true

return CoinConfig
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">DailyQuestConfig</string>
          <string name="Source"><![CDATA[--[[
	DailyQuestConfig
	Template pool for the automated daily quest generator.

	PERMANENT quests always appear (reward specific items like crowns / pets).
	ROTATING quests (RotatingCount per day) are picked from the Templates pool
	using the UTC date as a deterministic seed -- same quests for all players on
	the same day, automatically different every day.

	Quest types (used as progress counter keys):
	  TimePlayed          -- seconds of session time (read from TimePlayedSeconds)
	  WinsToday           -- match wins today
	  SwordKillsToday     -- sword kills today
	  EliminationsToday   -- any player kill today (same source as SwordKillsToday)
	  SurviveRoundsToday  -- rounds survived today
	  TTSSurvivalsToday   -- TungTungSahur 30s-timer survival events today

	Reward types:
	  { type="Coins",  amount=N }
	  { type="Crown",  itemId="..." }
	  { type="Pet",    itemId="..." }
	  { type="Crate",  crateId="crate_pet"|"crate_crown", count=1 }
	  { type="Spin",   count=1 }
]]

local DailyQuestConfig = {}

-- Permanent quests (always shown, specific item rewards)
DailyQuestConfig.Permanent = {
	{
		id          = "quest_play_15min",
		label       = "Time Traveler",
		description = "Get 700 Fate Coins for playing for 15 minutes straight!",
		type        = "TimePlayed",
		target      = 900,
		order       = 1,
		reward      = { type = "Coins", amount = 700 },
		icon        = "",
		iconColor   = { 255, 220, 60 },
	},
	{
		id          = "quest_win_3games",
		label       = "3x Champion",
		description = "Get the Disco Party Crown for winning 3 straight games!",
		type        = "WinsToday",
		target      = 3,
		order       = 2,
		reward      = { type = "Crown", itemId = "crown_disco_party" },
		icon        = "",
		iconColor   = { 255, 200, 50 },
	},
	{
		id          = "quest_sword_kills",
		label       = "Sword Master",
		description = "Get the Chill Face Pet for killing 4 players with a sword!",
		type        = "SwordKillsToday",
		target      = 4,
		order       = 3,
		reward      = { type = "Pet", itemId = "pet_chill_face" },
		icon        = "",
		iconColor   = { 220, 80, 80 },
	},
	{
		id          = "quest_survive_tts",
		label       = "TungTung Survivor",
		description = "Get the TungTungSahur pet for surviving TungTung 7 times!",
		type        = "TTSSurvivalsToday",
		target      = 7,
		order       = 4,
		reward      = { type = "Pet", itemId = "pet_tungtungsahur" },
		icon        = "",
		iconColor   = { 255, 60, 60 },
	},
}

-- Rotating template pool -- 3 are picked each day.
-- Duplicate types with Permanent quests are automatically skipped.
DailyQuestConfig.Templates = {
	{
		type = "TimePlayed",
		icon = "", iconColor = { 255, 220, 60 },
		tiers = {
			{ target = 300,  label = "Early Bird",   desc = "Play for 5 minutes",   reward = { type = "Coins", amount = 200 } },
			{ target = 600,  label = "Regular",      desc = "Play for 10 minutes",  reward = { type = "Coins", amount = 350 } },
			{ target = 1200, label = "Dedicated",    desc = "Play for 20 minutes",  reward = { type = "Crate", crateId = "crate_pet", count = 1 } },
		},
	},
	{
		type = "WinsToday",
		icon = "", iconColor = { 255, 200, 50 },
		tiers = {
			{ target = 1, label = "First Win",   desc = "Win 1 match",   reward = { type = "Coins", amount = 300 } },
			{ target = 5, label = "Win Streak",  desc = "Win 5 matches", reward = { type = "Crate", crateId = "crate_crown", count = 1 } },
		},
	},
	{
		type = "EliminationsToday",
		icon = "", iconColor = { 255, 120, 40 },
		tiers = {
			{ target = 2, label = "Lethal",     desc = "Eliminate 2 players",  reward = { type = "Coins", amount = 250 } },
			{ target = 5, label = "Slayer",     desc = "Eliminate 5 players",  reward = { type = "Spin",  count = 1 } },
			{ target = 8, label = "Destroyer",  desc = "Eliminate 8 players",  reward = { type = "Crate", crateId = "crate_pet", count = 1 } },
		},
	},
	{
		type = "SurviveRoundsToday",
		icon = "", iconColor = { 80, 200, 255 },
		tiers = {
			{ target = 3, label = "Survivor",    desc = "Survive 3 rounds", reward = { type = "Coins", amount = 250 } },
			{ target = 5, label = "Endurance",   desc = "Survive 5 rounds", reward = { type = "Spin",  count = 1 } },
			{ target = 8, label = "Unstoppable", desc = "Survive 8 rounds", reward = { type = "Crate", crateId = "crate_crown", count = 1 } },
		},
	},
	{
		type = "SwordKillsToday",
		icon = "", iconColor = { 220, 80, 80 },
		tiers = {
			{ target = 1, label = "First Blood",   desc = "Get 1 sword kill",  reward = { type = "Coins", amount = 200 } },
			{ target = 3, label = "Blade Dancer",  desc = "Get 3 sword kills", reward = { type = "Crate", crateId = "crate_pet", count = 1 } },
		},
	},
	{
		type = "TTSSurvivalsToday",
		icon = "", iconColor = { 255, 60, 60 },
		tiers = {
			{ target = 2, label = "TTS Dodger", desc = "Survive TungTungSahur 2 times", reward = { type = "Coins", amount = 300 } },
			{ target = 5, label = "TTS Hunter", desc = "Survive TungTungSahur 5 times", reward = { type = "Spin",  count = 1 } },
		},
	},
}

-- How many rotating quests to add per day (on top of Permanent)
DailyQuestConfig.RotatingCount = 3

-- Returns a human-readable reward label for descriptions and popups
function DailyQuestConfig.GetRewardLabel(reward): string
	if not reward then return "a reward" end
	if reward.type == "Coins" then
		return tostring(reward.amount) .. " Fate Coins"
	elseif reward.type == "Crate" then
		return "1 " .. (reward.crateId == "crate_crown" and "Crown Crate" or "Pet Crate")
	elseif reward.type == "Spin" then
		local n = reward.count or 1
		return tostring(n) .. " Free Spin" .. (n == 1 and "" or "s")
	elseif reward.type == "Crown" then
		return "a Crown"
	elseif reward.type == "Pet" then
		return "a Pet"
	end
	return "a reward"
end

-- Seeded daily generator.
-- dayString: UTC date "2026_02_25"
-- Returns ordered array: Permanent quests first, then RotatingCount rotating quests.
-- Deterministic: same day -> same quests for all players on all servers.
function DailyQuestConfig.GenerateDailyQuests(dayString: string): { { [string]: any } }
	local seed = 0
	for c in string.gmatch(dayString, ".") do
		seed = (seed * 31 + string.byte(c)) % 2147483647
	end
	local rng = Random.new(seed)

	-- Shuffle a copy of Templates (Knuth shuffle)
	local pool: { any } = {}
	for _, tmpl in ipairs(DailyQuestConfig.Templates) do
		table.insert(pool, tmpl)
	end
	for i = #pool, 2, -1 do
		local j = rng:NextInteger(1, i)
		pool[i], pool[j] = pool[j], pool[i]
	end

	-- Track types already occupied by Permanent quests
	local usedTypes: { [string]: boolean } = {}
	for _, pq in ipairs(DailyQuestConfig.Permanent) do
		usedTypes[pq.type] = true
	end

	-- Pick rotating quests (avoid duplicate types)
	local rotating: { { [string]: any } } = {}
	for _, tmpl in ipairs(pool) do
		if #rotating >= DailyQuestConfig.RotatingCount then break end
		if not usedTypes[tmpl.type] then
			usedTypes[tmpl.type] = true
			local tierIdx = rng:NextInteger(1, #tmpl.tiers)
			local tier = tmpl.tiers[tierIdx]
			local rewardLabel = DailyQuestConfig.GetRewardLabel(tier.reward)
			local desc = (tier.desc or "") .. ". Reward: " .. rewardLabel .. "!"
			local dateDigits = dayString:gsub("[^%d]", "")
			local typeSlug   = tmpl.type:lower():gsub("[^%a%d]", "")
			table.insert(rotating, {
				id          = "daily_" .. typeSlug .. "_" .. dateDigits,
				label       = tier.label,
				description = desc,
				type        = tmpl.type,
				target      = tier.target,
				order       = #DailyQuestConfig.Permanent + #rotating + 1,
				reward      = tier.reward,
				icon        = tmpl.icon,
				iconColor   = tmpl.iconColor,
			})
		end
	end

	-- Assemble: permanent first (copy so callers can mutate safely), then rotating
	local all: { { [string]: any } } = {}
	for i, q in ipairs(DailyQuestConfig.Permanent) do
		local copy: { [string]: any } = {}
		for k, v in pairs(q) do copy[k] = v end
		copy.order = i
		table.insert(all, copy)
	end
	for _, q in ipairs(rotating) do
		table.insert(all, q)
	end

	return all
end

return DailyQuestConfig
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">DailyRewardConfig</string>
          <string name="Source"><![CDATA[--[[
