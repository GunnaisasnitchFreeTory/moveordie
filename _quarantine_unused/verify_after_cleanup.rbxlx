-- SHOW / HIDE

function QuestsPanel.Show()
	if not canvas then return end
	visible = true
	canvas.Visible = true

	if overlay then
		overlay.Visible = true
		TweenService:Create(overlay, TweenInfo.new(0.18), { BackgroundTransparency = 0.55 }):Play()
	end

	uiScale.Scale = 0.88
	TweenService:Create(canvas,  TweenInfo.new(0.18), { GroupTransparency = 0 }):Play()
	TweenService:Create(uiScale, TweenInfo.new(0.28, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()

	SoundUtil.Open()

	task.spawn(function()
		refreshUI()
		if scrollFrame then
			local lbl = scrollFrame:FindFirstChild("LoadingLabel")
			if lbl and next(_questRows) ~= nil then lbl.Visible = false end
		end
	end)
end

function QuestsPanel.Hide()
	if not canvas then return end
	visible = false

	TweenService:Create(canvas,  TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { GroupTransparency = 1 }):Play()
	TweenService:Create(uiScale, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Scale = 0.92 }):Play()

	if overlay then
		TweenService:Create(overlay, TweenInfo.new(0.18), { BackgroundTransparency = 1 }):Play()
	end

	task.delay(0.2, function()
		if not visible and canvas then
			canvas.Visible = false
			if overlay then overlay.Visible = false end
		end
	end)

	SoundUtil.Close()
end

function QuestsPanel.IsVisible()
	return visible
end

function QuestsPanel.Toggle()
	if visible then QuestsPanel.Hide() else QuestsPanel.Show() end
end

-- INIT

function QuestsPanel.Init(screenGui, onClose)
	closeCallback = onClose

	buildPanel(screenGui)

	task.spawn(function()
		ensureRemotes()
		if not _updateRemote then
			pcall(function()
				local remotes = ReplicatedStorage:WaitForChild("Remotes", 10)
				if remotes then
					_updateRemote = remotes:WaitForChild("DailyQuest_Update", 10)
				end
			end)
		end
		if _updateRemote then
			_updateRemote.OnClientEvent:Connect(function(status)
				_status = status
				if not status or not status.quests then return end
				if _builtForDay ~= status.day or next(_questRows) == nil then
					clearQuestRows()
					buildQuestRows(status.quests, status.day)
					if scrollFrame then
						local lbl = scrollFrame:FindFirstChild("LoadingLabel")
						if lbl then lbl.Visible = false end
					end
				elseif visible then
					for _, quest in ipairs(status.quests) do
						local rowData = _questRows[quest.id]
						if rowData then updateRow(rowData, quest) end
					end
				end
			end)
		end
	end)
end

return QuestsPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="126">
            <Properties>
              <string name="Name">RewardPopup</string>
              <string name="Source">--[[
	RewardPopup
	Shared reward popup used by both Spin Wheel and Crate Shop.
	Lives in StarterPlayerScripts (safe from SharedSanity cleanup).

	Style: Dark rounded card, "YOU WON!" header, medium icon,
	       reward name, rarity line, green OK button.
	       Confetti burst + win sound on reveal.

	API:
	  RewardPopup.Show({...})       -- single reward
	  RewardPopup.ShowBatch({...})  -- multiple rewards (grid layout)
	  RewardPopup.IsActive() → boolean
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local WIN_SFX_ID = "rbxassetid://111217342629113"
local WIN_SFX_VOLUME = 0.5

local AnimUtil = require(script.Parent:WaitForChild("AnimUtil"))

local RewardPopup = {}

local player = Players.LocalPlayer
local _active = false
local _overlay: Frame? = nil
local _onDismissCallback: (() -&gt; ())? = nil
local _ignoreBackdropUntil = 0

local function isMobileTouchDevice(): boolean
	return UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
end

-- ═══════════════════════════════════════════
-- LAZY-LOAD ITEMCATALOG + THUMBNAILRENDERER
-- ═══════════════════════════════════════════
local _ItemCatalog = nil
local function getItemCatalog()
	if _ItemCatalog then return _ItemCatalog end
	pcall(function()
		local Shared = ReplicatedStorage:FindFirstChild("Shared")
		if Shared then
			local cdp = Shared:FindFirstChild("ClientDepsProvider")
			if cdp then
				local Deps = require(cdp)
				_ItemCatalog = Deps and Deps.ItemCatalog
			end
		end
	end)
	return _ItemCatalog
end

local _ThumbnailRenderer = nil
local function getThumbnailRenderer()
	if _ThumbnailRenderer then return _ThumbnailRenderer end
	pcall(function()
		local playerScripts = player:FindFirstChild("PlayerScripts")
		local clientUI = playerScripts and playerScripts:FindFirstChild("Client")
		clientUI = clientUI and clientUI:FindFirstChild("UI")
		local mod = clientUI and clientUI:FindFirstChild("ThumbnailRenderer")
		if mod then _ThumbnailRenderer = require(mod) end
	end)
	return _ThumbnailRenderer
end

local _QuestRewardIconResolver = nil
local function getQuestRewardIconResolver()
	if _QuestRewardIconResolver then return _QuestRewardIconResolver end
	pcall(function()
		local Shared = ReplicatedStorage:FindFirstChild("Shared")
		if Shared then
			local mod = Shared:FindFirstChild("QuestRewardIconResolver")
			if mod then _QuestRewardIconResolver = require(mod) end
		end
	end)
	return _QuestRewardIconResolver
end

-- ═══════════════════════════════════════════
-- LOOKUP CATALOG ENTRY (shared helper)
-- ═══════════════════════════════════════════
local function lookupCatalogEntry(data)
	local IC = getItemCatalog()
	if not IC then return nil end
	if not data.itemId or data.itemId == "" then return nil end
	local t = string.lower(data.itemType or "")

	local entry = nil
	if data.category and data.category ~= "" then
		if IC.Get then entry = IC.Get(data.category, data.itemId) end
	end
	if not entry then
		if t == "pet" and IC.Pets then
			entry = IC.Pets[data.itemId]
		elseif t == "crown" and IC.Crowns then
			entry = IC.Crowns[data.itemId]
		elseif (t == "crate" or t == "crates") and IC.Crates then
			entry = IC.Crates[data.itemId]
		end
	end
	if not entry then
		if IC.Pets and IC.Pets[data.itemId] then entry = IC.Pets[data.itemId]
		elseif IC.Crowns and IC.Crowns[data.itemId] then entry = IC.Crowns[data.itemId]
		elseif IC.Crates and IC.Crates[data.itemId] then entry = IC.Crates[data.itemId] end
	end
	return entry
end

-- ═══════════════════════════════════════════
-- RESOLVE RARITY (authoritative from ItemCatalog)
-- For Pets/Crowns: ALWAYS use catalog rarity, never trust caller.
-- For Coins: use fixed rule based on amount, or caller's value.
-- ═══════════════════════════════════════════
local function resolveRarity(data)
	local callerRarity = data.rarityText or "Common"
	local itemType = data.itemType or ""

	-- Coins: no catalog rarity, use caller's value (which should be set intentionally)
	if itemType == "Coins" or itemType == "FateCoins" then
		print(string.format("[RewardPopup] type=Coins rarity=%s (coins use caller value)", callerRarity))
		return callerRarity
	end

	-- For Pets and Crowns: look up canonical rarity from ItemCatalog
	local entry = lookupCatalogEntry(data)
	if entry and entry.rarity then
		local catalogRarity = entry.rarity
		if catalogRarity ~= callerRarity then
			warn(string.format("[RewardPopup] RARITY MISMATCH! type=%s id=%s catalogRarity=%s callerRarity=%s → using catalog",
				itemType, data.itemId or "?", catalogRarity, callerRarity))
		else
			print(string.format("[RewardPopup] type=%s id=%s catalogRarity=%s popupRarity=%s",
				itemType, data.itemId or "?", catalogRarity, catalogRarity))
		end
		return catalogRarity
	end

	-- Catalog entry not found — use caller's value but warn
	if data.itemId and data.itemId ~= "" then
		warn(string.format("[RewardPopup] No catalog entry for type=%s id=%s — using caller rarity: %s",
			itemType, data.itemId or "?", callerRarity))
	end
	return callerRarity
end

-- ═══════════════════════════════════════════
-- BRAINROT PLACEHOLDER (used when no image asset set for brainrot items)
-- ═══════════════════════════════════════════
local BRAINROT_PLACEHOLDER_IMAGE = "rbxassetid://85473787445447"
local CRATE_FALLBACK_IMAGE = "rbxassetid://108812530080296"

-- ═══════════════════════════════════════════
-- RESOLVE ICON (multi-level fallback + ThumbnailRenderer)
-- Rule: If catalog has a non-empty image → use it (static).
--       No static image but has modelPath → return entry for ThumbnailRenderer.
--       Else → emoji fallback / placeholder.
-- Returns: resolvedImage, fallbackEmoji, fallbackColor, catalogEntry (for ThumbnailRenderer)
-- ═══════════════════════════════════════════
local function resolveIcon(data)
	-- Quest-specific mapping takes precedence when a quest reward descriptor exists.
	local questIconResolver = getQuestRewardIconResolver()
	if questIconResolver and questIconResolver.GetQuestRewardIcon then
		local questIcon = questIconResolver.GetQuestRewardIcon(data.questReward)
		if questIcon and questIcon ~= "" then
			return questIcon, nil, nil, nil
		end
	end

	local t = string.lower(data.itemType or "")
	local entry = lookupCatalogEntry(data)

	-- For crown rewards, always resolve from the won crown id first.
	-- This prevents stale/default wheel icon overrides from showing the wrong crown art.
	if t == "crown" and entry then
		if entry.image and entry.image ~= "" then
			return entry.image, nil, nil, entry
		end
		if entry.modelPath and entry.modelPath ~= "" then
			return nil, entry.iconText or data.iconText, entry.iconColor or data.iconColor, entry
		end
	end

	-- Explicit icon from caller (e.g. wheel-specific asset IDs) is a fallback,
	-- except when crown catalog data above was available.
	if data.icon and data.icon ~= "" then
		return data.icon, nil, nil, nil
	end

	if entry then
		-- If catalog has a non-empty static image, use it
		if entry.image and entry.image ~= "" then
			return entry.image, nil, nil, entry
		end
		-- Crates should never render blank icon in popup.
		if t == "crate" or t == "crates" then
			return CRATE_FALLBACK_IMAGE, nil, nil, entry
		end
		-- No static image but has modelPath → allow ThumbnailRenderer (works for all items)
		if entry.modelPath and entry.modelPath ~= "" then
			return nil, entry.iconText or data.iconText, entry.iconColor or data.iconColor, entry
		end
		-- No image and no modelPath: use placeholder for brainrots, emoji for others
		if entry.source == "brainrot_mode" then
			print("[RewardPopup] Brainrot item with no image or modelPath — using placeholder for:", entry.name or "?")
			return BRAINROT_PLACEHOLDER_IMAGE, nil, nil, entry
		end
		return nil, entry.iconText or data.iconText, entry.iconColor or data.iconColor, entry
	end

	if data.iconText and data.iconText ~= "" then
		return nil, data.iconText, data.iconColor, nil
	end
	warn("[RewardPopup] Missing icon for", data.itemType or "?", data.itemId or "?", data.name or "?")
	return CRATE_FALLBACK_IMAGE, nil, nil, nil
end

-- ═══════════════════════════════════════════
-- RARITY COLORS
-- ═══════════════════════════════════════════
local RARITY_COLORS = {
	Common    = Color3.fromRGB(180, 200, 180),
	Uncommon  = Color3.fromRGB(80, 200, 80),
	Rare      = Color3.fromRGB(60, 140, 255),
	Epic      = Color3.fromRGB(178, 60, 255),
	Legendary = Color3.fromRGB(255, 180, 40),
	Exclusive = Color3.fromRGB(255, 58, 58),
}

-- ═══════════════════════════════════════════
-- WIN SOUND
-- ═══════════════════════════════════════════
local _winSound: Sound? = nil

local function playWinSound()
	if _winSound and _winSound.IsPlaying then
		_winSound:Stop()
	end
	if not _winSound or not _winSound.Parent then
		_winSound = Instance.new("Sound")
		_winSound.Name = "CrateWinSFX"
		_winSound.SoundId = WIN_SFX_ID
		_winSound.Looped = false
		_winSound.Volume = WIN_SFX_VOLUME
		_winSound.Parent = SoundService
	end
	_winSound:Play()
end

-- ═══════════════════════════════════════════
-- CONFETTI BURST (self-contained, same style as Spin Wheel)
-- ═══════════════════════════════════════════
local CONFETTI_COLORS = {
	Color3.fromRGB(255, 0, 0),
	Color3.fromRGB(0, 255, 0),
	Color3.fromRGB(0, 0, 255),
	Color3.fromRGB(255, 255, 0),
	Color3.fromRGB(255, 0, 255),
	Color3.fromRGB(0, 255, 255),
	Color3.fromRGB(255, 128, 0),
	Color3.fromRGB(255, 255, 255),
}

local function spawnConfettiBurst(parent: GuiObject)
	local screenW = parent.AbsoluteSize.X
	local screenH = parent.AbsoluteSize.Y
	if screenW &lt; 10 or screenH &lt; 10 then return end

	local centerX = screenW * 0.5
	local centerY = screenH * 0.5
	local velScale = math.min(screenW, screenH) / 1000

	for _ = 1, 60 do
		local piece = Instance.new("Frame")
		piece.AnchorPoint = Vector2.new(0.5, 0.5)
		piece.BorderSizePixel = 0
		local s = math.random(4, 10)
		piece.Size = UDim2.fromOffset(s, s * math.random(10, 30) / 10)
		piece.Position = UDim2.fromOffset(centerX, centerY)
		piece.BackgroundColor3 = CONFETTI_COLORS[math.random(1, #CONFETTI_COLORS)]
		piece.Rotation = math.random(0, 360)
		piece.ZIndex = 200
		piece.Parent = parent

		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 2)
		corner.Parent = piece

		local angle = math.random() * math.pi * 2
		local speed = math.random(800, 1600) * velScale
		local vx = math.cos(angle) * speed
		local vy = math.sin(angle) * speed - math.random(600, 1000) * velScale
		local gravity = 1800 * velScale
		local drag = 0.98
		local rotSpeed = math.random(200, 600) * (math.random(0, 1) == 0 and 1 or -1)
		local t0 = tick()
		local px, py = 0, 0

		local conn
		conn = RunService.Heartbeat:Connect(function(dt)
			if not piece.Parent then
				conn:Disconnect()
				return
			end
			local elapsed = tick() - t0
			if elapsed &gt; 3.5 or py &gt; screenH + 80 then
				piece:Destroy()
				conn:Disconnect()
				return
			end
			vy = vy + gravity * dt
			vx = vx * drag
			px = px + vx * dt
			py = py + vy * dt
			piece.Position = UDim2.fromOffset(centerX + px, centerY + py)
			piece.Rotation = piece.Rotation + rotSpeed * dt
			if elapsed &gt; 2.5 then
				piece.BackgroundTransparency = (elapsed - 2.5) / 1.0
			end
		end)
	end
end

-- ═══════════════════════════════════════════
-- SCREEN GUI
-- ═══════════════════════════════════════════
local _gui: ScreenGui? = nil

local function getGui(): ScreenGui?
	if _gui and _gui.Parent then return _gui end
	local pg = player:FindFirstChild("PlayerGui")
	if not pg then return nil end
	local existing = pg:FindFirstChild("RewardPopupGui")
	if existing and existing:IsA("ScreenGui") then
		existing.ResetOnSpawn = false
		existing.IgnoreGuiInset = true
		existing.DisplayOrder = math.max(existing.DisplayOrder, 500)
		existing.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
		existing.Enabled = true
		_gui = existing
		return existing
	end
	local sg = Instance.new("ScreenGui")
	sg.Name = "RewardPopupGui"
	sg.DisplayOrder = 500
	sg.IgnoreGuiInset = true
	sg.ResetOnSpawn = false
	sg.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	sg.Enabled = true
	sg.Parent = pg
	print("[Modal] RewardPopupGui ready (DisplayOrder=500)")
	_gui = sg
	return sg
end

-- ═══════════════════════════════════════════
-- DISMISS
-- ═══════════════════════════════════════════
local function dismiss()
	if not _active then return end
	_active = false
	local ov = _overlay
	if ov and ov.Parent then
		local panel = ov:FindFirstChild("Card") or ov:FindFirstChild("BatchPanel")
		local modalName = panel and panel.Name or "RewardPopup"
		print(string.format("[Modal] Hide %s -&gt; tween out -&gt; hidden", modalName))
		if panel then
			AnimUtil.PopupClose(panel, ov)
		else
			task.delay(0.25, function()
				if ov and ov.Parent then ov:Destroy() end
			end)
		end
	end
	_overlay = nil
	if _onDismissCallback then
		task.spawn(_onDismissCallback)
		_onDismissCallback = nil
	end
end

-- ═══════════════════════════════════════════
-- HELPER: build icon inside a parent frame
-- Supports: static image, ThumbnailRenderer (ViewportFrame for pets), emoji fallback
-- ═══════════════════════════════════════════
local function buildIcon(parent, resolvedImage, fallbackEmoji, fallbackColor, posY, iconSize, zIdx, catalogEntry, imageScaleType)
	for _, child in ipairs(parent:GetChildren()) do
		if child.Name == "RewardIcon" then
			child:Destroy()
		end
	end

	if resolvedImage and resolvedImage ~= "" then
		local icon = Instance.new("ImageLabel")
		icon.Name = "RewardIcon"
		icon.AnchorPoint = Vector2.new(0.5, 0)
		icon.Position = UDim2.new(0.5, 0, 0, posY)
		icon.Size = UDim2.fromOffset(iconSize, iconSize)
		icon.BackgroundTransparency = 1
		icon.Image = resolvedImage
		icon.ImageTransparency = 0
		icon.ScaleType = imageScaleType or Enum.ScaleType.Fit
		icon.Visible = true
		icon.ZIndex = zIdx
		icon.Parent = parent
		local asp = Instance.new("UIAspectRatioConstraint")
		asp.AspectRatio = 1
		asp.Parent = icon
		return
	end

	-- ThumbnailRenderer fallback: for pets/crowns with a modelPath but no static image
	if catalogEntry and catalogEntry.modelPath and catalogEntry.modelPath ~= "" then
		local TR = getThumbnailRenderer()
		if TR then
			local vpFrame = Instance.new("ViewportFrame")
			vpFrame.Name = "RewardIcon"
			vpFrame.AnchorPoint = Vector2.new(0.5, 0)
			vpFrame.Position = UDim2.new(0.5, 0, 0, posY)
			vpFrame.Size = UDim2.fromOffset(iconSize, iconSize)
			vpFrame.BackgroundTransparency = 1
			vpFrame.BorderSizePixel = 0
			vpFrame.Visible = true
			vpFrame.ZIndex = zIdx
			vpFrame.Parent = parent
			Instance.new("UIAspectRatioConstraint", vpFrame).AspectRatio = 1

			local renderOk = TR.RenderItemToViewport(vpFrame, {
				modelPath = catalogEntry.modelPath,
				id = catalogEntry.id or catalogEntry.name,
				name = catalogEntry.name or catalogEntry.modelName,
				type = catalogEntry.type,
				rarity = catalogEntry.rarity,
			})
			if renderOk then
				print("[RewardPopup] ThumbnailRenderer used for:", catalogEntry.modelPath)
				return
			else
				warn("[RewardPopup] ThumbnailRenderer failed for:", catalogEntry.modelPath, "— falling back to emoji")
				vpFrame:Destroy()
			end
		end
	end

	-- Emoji fallback
	if fallbackEmoji and fallbackEmoji ~= "" then
		local emojiHolder = Instance.new("Frame")
		emojiHolder.Name = "RewardIcon"
		emojiHolder.AnchorPoint = Vector2.new(0.5, 0)
		emojiHolder.Position = UDim2.new(0.5, 0, 0, posY)
		emojiHolder.Size = UDim2.fromOffset(iconSize, iconSize)
		emojiHolder.BackgroundColor3 = fallbackColor or Color3.fromRGB(60, 65, 85)
		emojiHolder.BackgroundTransparency = 0.15
		emojiHolder.BorderSizePixel = 0
		emojiHolder.Visible = true
		emojiHolder.ZIndex = zIdx
		emojiHolder.Parent = parent
		Instance.new("UICorner", emojiHolder).CornerRadius = UDim.new(0.5, 0)
		Instance.new("UIAspectRatioConstraint", emojiHolder).AspectRatio = 1
		local ehs = Instance.new("UIStroke")
		ehs.Color = Color3.fromRGB(255, 255, 255)
		ehs.Thickness = 2
		ehs.Transparency = 0.5
		ehs.Parent = emojiHolder
		local emojiLbl = Instance.new("TextLabel")
		emojiLbl.Size = UDim2.fromScale(1, 1)
		emojiLbl.BackgroundTransparency = 1
		emojiLbl.Font = Enum.Font.GothamBold
		emojiLbl.Text = fallbackEmoji
		emojiLbl.TextScaled = true
		emojiLbl.TextColor3 = Color3.fromRGB(255, 255, 255)
		emojiLbl.ZIndex = zIdx + 1
		emojiLbl.Parent = emojiHolder
	end
end

-- ═══════════════════════════════════════════
-- SHOW (single reward)
-- ═══════════════════════════════════════════
function RewardPopup.Show(data)
	if not data then return end

	if _active and _overlay and _overlay.Parent then
		_overlay:Destroy()
		_overlay = nil
		_active = false
	end
	local gui = getGui()
	if not gui then return end
	gui.Enabled = true

	_active = true
	_onDismissCallback = data.onDismiss
	_ignoreBackdropUntil = os.clock() + 0.2

	local titleText = data.title or "YOU WON!"
	local nameText = data.name or "MISSING ITEM"
	local rarityStr = resolveRarity(data)
	local okText = data.okText or "OK"
	local rarityColor = RARITY_COLORS[rarityStr] or RARITY_COLORS.Common
	local resolvedImage, fallbackEmoji, fallbackColor, catalogEntry = resolveIcon(data)

	local wrapper = Instance.new("Frame")
	wrapper.Name = "ModalWrapper"
	wrapper.Size = UDim2.fromScale(1, 1)
	wrapper.BackgroundTransparency = 1
	wrapper.BorderSizePixel = 0
	wrapper.ZIndex = 50
	wrapper.Parent = gui
	_overlay = wrapper

	local clickCatcher = Instance.new("TextButton")
	clickCatcher.Name = "ClickCatcher"
	clickCatcher.Size = UDim2.fromScale(1, 1)
	clickCatcher.BackgroundTransparency = 1
	clickCatcher.BorderSizePixel = 0
	clickCatcher.Text = ""
	clickCatcher.AutoButtonColor = false
	clickCatcher.Active = true
	clickCatcher.ZIndex = 50
	clickCatcher.Parent = wrapper
	clickCatcher.MouseButton1Click:Connect(function()
		if os.clock() &lt; _ignoreBackdropUntil then
			return
		end
		dismiss()
	end)

	local card = Instance.new("Frame")
	card.Name = "Card"
	card.AnchorPoint = Vector2.new(0.5, 0.5)
	card.Position = UDim2.fromScale(0.5, 0.5)
	card.Size = UDim2.fromOffset(260, 310)
	card.BackgroundColor3 = Color3.fromRGB(25, 28, 42)
	card.BackgroundTransparency = 0.02
	card.BorderSizePixel = 0
	card.ZIndex = 51
	card.Parent = wrapper

	Instance.new("UICorner", card).CornerRadius = UDim.new(0, 16)
	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(60, 65, 85)
	stroke.Thickness = 2
	stroke.Transparency = 0.3
	stroke.Parent = card

	AnimUtil.PopupOpen(card)
	-- Shop purchase popups can render immediately on mobile before the tween is perceptible.
	-- Re-trigger an explicit open tween for mobile shop/gamepass sources only.
	do
		local source = tostring(data.popupSource or "")
		local isShopSource = source == "Shop" or source == "GamePass" or source == "DevProduct"
		if isShopSource and isMobileTouchDevice() then
			task.defer(function()
				if not card or not card.Parent then return end
				local sc = card:FindFirstChildOfClass("UIScale")
				if sc then
					sc.Scale = math.min(sc.Scale, 0.84)
				end
				AnimUtil.PopupOpen(card)
				print("[ShopPopup] platform=Mobile animationPlayed=true")
			end)
		end
	end

	task.defer(function()
		if card and card.Parent then
			print(string.format("[Modal] Show %s parent=%s anchor=(%.1f,%.1f) pos=(%.2f,%.2f) absPos=(%.0f,%.0f) absSize=(%.0f,%.0f)",
				titleText, gui.Name,
				card.AnchorPoint.X, card.AnchorPoint.Y,
				card.Position.X.Scale, card.Position.Y.Scale,
				card.AbsolutePosition.X, card.AbsolutePosition.Y,
				card.AbsoluteSize.X, card.AbsoluteSize.Y))
			print(string.format("[CrateModalDebug] parent=%s visible=%s size=%s pos=%s screenEnabled=%s displayOrder=%d zindex=%d",
				card.Parent and card.Parent:GetFullName() or "nil",
				tostring(card.Visible),
				tostring(card.Size),
				tostring(card.Position),
				tostring(gui.Enabled),
				gui.DisplayOrder,
				card.ZIndex))
		end
	end)

	playWinSound()
	task.delay(0.15, function()
		if overlay and overlay.Parent then
			spawnConfettiBurst(overlay)
		end
	end)

	local header = Instance.new("TextLabel")
	header.Name = "Header"
	header.AnchorPoint = Vector2.new(0.5, 0)
	header.Position = UDim2.new(0.5, 0, 0, 14)
	header.Size = UDim2.new(1, -20, 0, 30)
	header.BackgroundTransparency = 1
	header.Font = Enum.Font.GothamBold
	header.TextColor3 = Color3.fromRGB(255, 215, 0)
	header.TextSize = 22
	header.Text = titleText
	header.ZIndex = 52
	header.Parent = card
	local hs = Instance.new("UIStroke")
	hs.Color = Color3.fromRGB(0, 0, 0)
	hs.Thickness = 2
	hs.Parent = header

	local isCoinReward = (data.itemType == "Coins" or data.itemType == "FateCoins")
	local iconY = isCoinReward and 34 or 55
	local iconSize = isCoinReward and 140 or 90
	local imageScaleType = isCoinReward and Enum.ScaleType.Crop or Enum.ScaleType.Fit
	buildIcon(card, resolvedImage, fallbackEmoji, fallbackColor, iconY, iconSize, 52, catalogEntry, imageScaleType)

	local nameLbl = Instance.new("TextLabel")
	nameLbl.Name = "Name"
	nameLbl.AnchorPoint = Vector2.new(0.5, 0)
	nameLbl.Position = UDim2.new(0.5, 0, 0, 190)
	nameLbl.Size = UDim2.new(1, -24, 0, 28)
	nameLbl.BackgroundTransparency = 1
	nameLbl.Font = Enum.Font.GothamBold
	nameLbl.TextColor3 = Color3.fromRGB(255, 255, 255)
	nameLbl.TextSize = 20
	nameLbl.Text = nameText
	nameLbl.ZIndex = 52
	nameLbl.Parent = card
	local ns = Instance.new("UIStroke")
	ns.Color = Color3.fromRGB(0, 0, 0)
	ns.Thickness = 1.5
	ns.Parent = nameLbl

	local rarLbl = Instance.new("TextLabel")
	rarLbl.Name = "Rarity"
	rarLbl.AnchorPoint = Vector2.new(0.5, 0)
	rarLbl.Position = UDim2.new(0.5, 0, 0, 220)
	rarLbl.Size = UDim2.new(1, -24, 0, 20)
	rarLbl.BackgroundTransparency = 1
	rarLbl.Font = Enum.Font.GothamSemibold
	rarLbl.TextColor3 = rarityColor
	rarLbl.TextSize = 14
	rarLbl.Text = rarityStr
	rarLbl.ZIndex = 52
	rarLbl.Parent = card

	local okBtn = Instance.new("TextButton")
	okBtn.Name = "OkBtn"
	okBtn.AnchorPoint = Vector2.new(0.5, 1)
	okBtn.Position = UDim2.new(0.5, 0, 1, -18)
	okBtn.Size = UDim2.new(1, -50, 0, 40)
	okBtn.BackgroundColor3 = Color3.fromRGB(50, 180, 80)
	okBtn.Font = Enum.Font.GothamBold
	okBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
	okBtn.TextSize = 18
	okBtn.Text = okText
	okBtn.BorderSizePixel = 0
	okBtn.AutoButtonColor = true
	okBtn.ZIndex = 52
	okBtn.Parent = card
	Instance.new("UICorner", okBtn).CornerRadius = UDim.new(0, 10)

	okBtn.MouseButton1Click:Connect(dismiss)

	local thisOverlay = overlay
	task.delay(8, function()
		if _overlay == thisOverlay and _active then dismiss() end
	end)
end

-- ═══════════════════════════════════════════
-- SHOWBATCH (multiple rewards — grid layout)
-- Used by crate opening (3 or 6 crates)
-- ═══════════════════════════════════════════
function RewardPopup.ShowBatch(items)
	if not items or #items == 0 then return end
	if #items == 1 then
		RewardPopup.Show(items[1])
		return
	end

	if _active and _overlay and _overlay.Parent then
		_overlay:Destroy()
		_overlay = nil
		_active = false
	end

	local gui = getGui()
	if not gui then return end
	gui.Enabled = true

	_active = true
	_onDismissCallback = nil
	_ignoreBackdropUntil = os.clock() + 0.2

	local count = #items
	local CARD_W, CARD_H = 150, 200
	local COLS = math.min(count, 3)
	local ROWS = math.ceil(count / COLS)
	local GAP = 14
	local containerW = COLS * CARD_W + (COLS - 1) * GAP
	local containerH = ROWS * CARD_H + (ROWS - 1) * GAP

	local wrapper = Instance.new("Frame")
	wrapper.Name = "ModalWrapper"
	wrapper.Size = UDim2.fromScale(1, 1)
	wrapper.BackgroundTransparency = 1
	wrapper.BorderSizePixel = 0
	wrapper.ZIndex = 50
	wrapper.Parent = gui
	_overlay = wrapper

	local clickCatcher = Instance.new("TextButton")
	clickCatcher.Name = "ClickCatcher"
	clickCatcher.Size = UDim2.fromScale(1, 1)
	clickCatcher.BackgroundTransparency = 1
	clickCatcher.BorderSizePixel = 0
	clickCatcher.Text = ""
	clickCatcher.AutoButtonColor = false
	clickCatcher.Active = true
	clickCatcher.ZIndex = 50
	clickCatcher.Parent = wrapper
	clickCatcher.MouseButton1Click:Connect(function()
		if os.clock() &lt; _ignoreBackdropUntil then
			return
		end
		dismiss()
	end)

	-- Main panel
	local panelW = containerW + 40
	local panelH = containerH + 100
	local panel = Instance.new("Frame")
	panel.Name = "BatchPanel"
	panel.AnchorPoint = Vector2.new(0.5, 0.5)
	panel.Position = UDim2.fromScale(0.5, 0.5)
	panel.Size = UDim2.fromOffset(panelW, panelH)
	panel.BackgroundColor3 = Color3.fromRGB(20, 22, 35)
	panel.BackgroundTransparency = 0.05
	panel.BorderSizePixel = 0
	panel.ZIndex = 51
	panel.Parent = wrapper

	Instance.new("UICorner", panel).CornerRadius = UDim.new(0, 16)
	local panelStroke = Instance.new("UIStroke")
	panelStroke.Color = Color3.fromRGB(60, 65, 85)
	panelStroke.Thickness = 2
	panelStroke.Transparency = 0.3
	panelStroke.Parent = panel

	AnimUtil.PopupOpen(panel)

	task.defer(function()
		if panel and panel.Parent then
			print(string.format("[Modal] ShowBatch parent=%s anchor=(%.1f,%.1f) pos=(%.2f,%.2f) absPos=(%.0f,%.0f) absSize=(%.0f,%.0f)",
				gui.Name,
				panel.AnchorPoint.X, panel.AnchorPoint.Y,
				panel.Position.X.Scale, panel.Position.Y.Scale,
				panel.AbsolutePosition.X, panel.AbsolutePosition.Y,
				panel.AbsoluteSize.X, panel.AbsoluteSize.Y))
			print(string.format("[CrateModalDebug] parent=%s visible=%s size=%s pos=%s screenEnabled=%s displayOrder=%d zindex=%d",
				panel.Parent and panel.Parent:GetFullName() or "nil",
				tostring(panel.Visible),
				tostring(panel.Size),
				tostring(panel.Position),
				tostring(gui.Enabled),
				gui.DisplayOrder,
				panel.ZIndex))
		end
	end)

	playWinSound()
	task.delay(0.15, function()
		if overlay and overlay.Parent then
			spawnConfettiBurst(overlay)
		end
	end)

	-- Header
	local header = Instance.new("TextLabel")
	header.AnchorPoint = Vector2.new(0.5, 0)
	header.Position = UDim2.new(0.5, 0, 0, 10)
	header.Size = UDim2.new(1, 0, 0, 28)
	header.BackgroundTransparency = 1
	header.Font = Enum.Font.GothamBold
	header.TextColor3 = Color3.fromRGB(255, 215, 0)
	header.TextSize = 20
	header.Text = "YOU WON!"
	header.ZIndex = 52
	header.Parent = panel
	local hs = Instance.new("UIStroke")
	hs.Color = Color3.fromRGB(0, 0, 0)
	hs.Thickness = 2
	hs.Parent = header

	-- Card grid container
	local grid = Instance.new("Frame")
	grid.Name = "CardGrid"
	grid.AnchorPoint = Vector2.new(0.5, 0)
	grid.Position = UDim2.new(0.5, 0, 0, 44)
	grid.Size = UDim2.fromOffset(containerW, containerH)
	grid.BackgroundTransparency = 1
	grid.ZIndex = 52
	grid.Parent = panel

	local gridLayout = Instance.new("UIGridLayout")
	gridLayout.CellSize = UDim2.fromOffset(CARD_W, CARD_H)
	gridLayout.CellPadding = UDim2.fromOffset(GAP, GAP)
	gridLayout.FillDirection = Enum.FillDirection.Horizontal
	gridLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	gridLayout.SortOrder = Enum.SortOrder.LayoutOrder
	gridLayout.Parent = grid

	-- Build mini-cards
	for idx, item in ipairs(items) do
		local resolvedImage, fallbackEmoji, fallbackColor, catalogEntry = resolveIcon(item)
		local rarityStr = resolveRarity(item)
		local rarityColor = RARITY_COLORS[rarityStr] or RARITY_COLORS.Common

		local card = Instance.new("Frame")
		card.Name = "Card" .. idx
		card.BackgroundColor3 = Color3.fromRGB(30, 33, 50)
		card.BorderSizePixel = 0
		card.LayoutOrder = idx
		card.ZIndex = 53
		card.Parent = grid

		Instance.new("UICorner", card).CornerRadius = UDim.new(0, 12)
		local cardStroke = Instance.new("UIStroke")
		cardStroke.Color = rarityColor
		cardStroke.Thickness = 1.5
		cardStroke.Transparency = 0.4
		cardStroke.Parent = card

		-- Icon
		local isCoinReward = (item.itemType == "Coins" or item.itemType == "FateCoins")
		local iconSize = isCoinReward and 78 or 60
		local imageScaleType = isCoinReward and Enum.ScaleType.Crop or Enum.ScaleType.Fit
		buildIcon(card, resolvedImage, fallbackEmoji, fallbackColor, 12, iconSize, 54, catalogEntry, imageScaleType)

		-- Name
		local nameLbl = Instance.new("TextLabel")
		nameLbl.AnchorPoint = Vector2.new(0.5, 0)
		nameLbl.Position = UDim2.new(0.5, 0, 0, 78)
		nameLbl.Size = UDim2.new(1, -12, 0, 36)
		nameLbl.BackgroundTransparency = 1
		nameLbl.Font = Enum.Font.GothamBold
		nameLbl.TextColor3 = Color3.fromRGB(255, 255, 255)
		nameLbl.TextSize = 13
		nameLbl.Text = item.name or "MISSING ITEM"
		nameLbl.TextWrapped = true
		nameLbl.ZIndex = 54
		nameLbl.Parent = card

		-- Rarity
		local rarLbl = Instance.new("TextLabel")
		rarLbl.AnchorPoint = Vector2.new(0.5, 0)
		rarLbl.Position = UDim2.new(0.5, 0, 0, 116)
		rarLbl.Size = UDim2.new(1, -12, 0, 16)
		rarLbl.BackgroundTransparency = 1
		rarLbl.Font = Enum.Font.GothamSemibold
		rarLbl.TextColor3 = rarityColor
		rarLbl.TextSize = 11
		rarLbl.Text = rarityStr
		rarLbl.ZIndex = 54
		rarLbl.Parent = card

		-- Duplicate tag
		if item.isDuplicate then
			local dupLbl = Instance.new("TextLabel")
			dupLbl.AnchorPoint = Vector2.new(0.5, 1)
			dupLbl.Position = UDim2.new(0.5, 0, 1, -8)
			dupLbl.Size = UDim2.new(1, -12, 0, 16)
			dupLbl.BackgroundTransparency = 1
			dupLbl.Font = Enum.Font.GothamBold
			dupLbl.TextColor3 = Color3.fromRGB(255, 180, 40)
			dupLbl.TextSize = 10
			dupLbl.Text = "ALREADY OWNED"
			dupLbl.ZIndex = 54
			dupLbl.Parent = card
		end
	end

	-- CLAIM ALL button
	local claimBtn = Instance.new("TextButton")
	claimBtn.AnchorPoint = Vector2.new(0.5, 1)
	claimBtn.Position = UDim2.new(0.5, 0, 1, -12)
	claimBtn.Size = UDim2.new(0, math.min(containerW, 200), 0, 38)
	claimBtn.BackgroundColor3 = Color3.fromRGB(50, 180, 80)
	claimBtn.Font = Enum.Font.GothamBold
	claimBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
	claimBtn.TextSize = 16
	claimBtn.Text = "CLAIM ALL"
	claimBtn.BorderSizePixel = 0
	claimBtn.AutoButtonColor = true
	claimBtn.ZIndex = 52
	claimBtn.Parent = panel
	Instance.new("UICorner", claimBtn).CornerRadius = UDim.new(0, 10)
	claimBtn.MouseButton1Click:Connect(dismiss)

	local thisWrapper = wrapper
	task.delay(12, function()
		if _overlay == thisWrapper and _active then dismiss() end
	end)
end

function RewardPopup.IsActive(): boolean
	return _active
end

function RewardPopup.Dismiss()
	dismiss()
end

return RewardPopup</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="127">
            <Properties>
              <string name="Name">SettingsPanel</string>
              <string name="Source"><![CDATA[--[[
	SettingsPanel
	Player settings — music toggle + volume slider.

	• Background Music ON/OFF toggle
	• Music volume slider (0–100)
	• Instantly affects currently playing background music
	• Same glossy/vibrant style as other panels

	Used by: UIController (sidebar "Settings" button)
]]

local SoundService = game:GetService("SoundService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local UIConfig = require(Shared:WaitForChild("UIConfig"))

local Client = script.Parent
local AnimUtil   = require(Client:WaitForChild("AnimUtil"))
local SoundUtil  = require(Client:WaitForChild("SoundUtil"))
local Components = require(Client:WaitForChild("Components"))

local C = UIConfig.Colors
local S = UIConfig.Sizes

local canvas: CanvasGroup = nil
local uiScale: UIScale = nil
local overlay: Frame = nil
local visible = false
local closeCallback: (() -> ())? = nil

-- Settings state
local musicEnabled = true
local musicVolume = 50 -- 0–100

local SettingsPanel = {}

-- ─── FIND BACKGROUND MUSIC ───

local function findBGMusic(): { Sound }
	local sounds = {}
	-- Check SoundService
	for _, child in ipairs(SoundService:GetChildren()) do
		if child:IsA("Sound") then
			table.insert(sounds, child)
		end
	end
	-- Check Workspace
	for _, child in ipairs(workspace:GetChildren()) do
		if child:IsA("Sound") then
			table.insert(sounds, child)
		end
	end
	-- Check SoundGroup named "Music" or "BGM"
	local sg = SoundService:FindFirstChild("Music") or SoundService:FindFirstChild("BGM")
	if sg then
		for _, child in ipairs(sg:GetChildren()) do
			if child:IsA("Sound") then
				table.insert(sounds, child)
			end
		end
	end
	return sounds
end

local function applyMusicSettings()
	local vol = musicEnabled and (musicVolume / 100) or 0

	-- Prefer setting SoundGroup volume (lets MusicController manage per-sound fades)
	local bgmGroup = SoundService:FindFirstChild("BGM") or SoundService:FindFirstChild("Music")
	if bgmGroup and bgmGroup:IsA("SoundGroup") then
		bgmGroup.Volume = vol
	end

	-- Also apply to any orphan sounds not managed by a group
	local sounds = findBGMusic()
	for _, sound in ipairs(sounds) do
		if not sound.SoundGroup or sound.SoundGroup == SoundService then
			sound.Volume = vol
		end
	end
end

-- ─── BUILD ───

local toggleBtn: TextButton = nil
local toggleLabel: TextLabel = nil
local volumeLabel: TextLabel = nil
local sliderFill: Frame = nil

local function updateToggleVisual()
	if not toggleBtn then return end
	if musicEnabled then
		toggleBtn.BackgroundColor3 = C.Green
		toggleLabel.Text = "ON"
	else
		toggleBtn.BackgroundColor3 = C.Red
		toggleLabel.Text = "OFF"
	end
end

local function updateVolumeVisual()
	if not volumeLabel then return end
	volumeLabel.Text = tostring(musicVolume) .. "%"
	if sliderFill then
		sliderFill.Size = UDim2.new(musicVolume / 100, 0, 1, 0)
	end
end

function SettingsPanel.Init(screenGui: ScreenGui, onClose: () -> ())
	closeCallback = onClose

	overlay = Components.CreateDimOverlay(screenGui, function()
		SettingsPanel.Hide()
	end)

	local content, closeBtn
	canvas, uiScale, content, closeBtn = Components.CreatePanel(screenGui, "SETTINGS", C.HeaderSettings, "Settings")

	-- Hide scrolling, use fixed layout
	content.ScrollBarThickness = 0
	content.ScrollingEnabled = false

	-- ─── MUSIC TOGGLE ROW ───
	local row1 = Instance.new("Frame")
	row1.Name = "MusicRow"
	row1.Size = UDim2.new(1, -40, 0, 56)
	row1.Position = UDim2.new(0, 20, 0, S.PanelHeaderHeight + 24)
	row1.BackgroundColor3 = C.CardBg
	row1.BorderSizePixel = 0
	row1.Parent = canvas

	local r1c = Instance.new("UICorner")
	r1c.CornerRadius = UDim.new(0, S.BtnCorner)
	r1c.Parent = row1

	local r1s = Instance.new("UIStroke")
	r1s.Color = C.CardStroke
	r1s.Thickness = S.PanelStroke
	r1s.Transparency = 0.35
	r1s.Parent = row1

	-- Stud texture on row
	Components.AddStudTexture(row1, S.BtnCorner)

	local r1pad = Instance.new("UIPadding")
	r1pad.PaddingLeft = UDim.new(0, 16)
	r1pad.PaddingRight = UDim.new(0, 14)
	r1pad.Parent = row1

	local musicText = Instance.new("TextLabel")
	musicText.Size = UDim2.new(0.6, 0, 1, 0)
	musicText.Position = UDim2.fromOffset(0, 0)
	musicText.BackgroundTransparency = 1
	musicText.Font = Enum.Font.GothamBold
	musicText.TextColor3 = C.TextWhite
	musicText.TextSize = 20
	musicText.Text = "Background Music"
	musicText.TextXAlignment = Enum.TextXAlignment.Left
	musicText.Parent = row1

	local mts = Instance.new("UIStroke")
	mts.Color = Color3.fromRGB(0, 0, 0)
	mts.Thickness = 1.5
	mts.Transparency = 0.22
	mts.Parent = musicText

	toggleBtn = Instance.new("TextButton")
	toggleBtn.Name = "ToggleBtn"
	toggleBtn.Size = UDim2.fromOffset(80, 36)
	toggleBtn.AnchorPoint = Vector2.new(1, 0.5)
	toggleBtn.Position = UDim2.new(1, 0, 0.5, 0)
	toggleBtn.BackgroundColor3 = C.Green
	toggleBtn.BorderSizePixel = 0
	toggleBtn.AutoButtonColor = false
	toggleBtn.Text = ""
	toggleBtn.Parent = row1

	local tbc = Instance.new("UICorner")
	tbc.CornerRadius = UDim.new(0, S.BtnCorner)
	tbc.Parent = toggleBtn

	local tbs = Instance.new("UIStroke")
	tbs.Color = Color3.fromRGB(255, 255, 255)
	tbs.Thickness = S.PanelStroke
	tbs.Transparency = 0.4
	tbs.Parent = toggleBtn

	toggleLabel = Instance.new("TextLabel")
	toggleLabel.Size = UDim2.fromScale(1, 1)
	toggleLabel.BackgroundTransparency = 1
	toggleLabel.Font = Enum.Font.GothamBold
	toggleLabel.TextColor3 = C.TextWhite
	toggleLabel.TextSize = 18
	toggleLabel.Text = "ON"
	toggleLabel.Parent = toggleBtn

	local tls = Instance.new("UIStroke")
	tls.Color = Color3.fromRGB(0, 0, 0)
	tls.Thickness = 1.5
	tls.Transparency = 0.2
	tls.Parent = toggleLabel

	AnimUtil.WireButton(toggleBtn, function()
		SoundUtil.Click()
		musicEnabled = not musicEnabled
		updateToggleVisual()
		applyMusicSettings()
	end)

	-- ─── VOLUME SLIDER ROW ───
	local row2 = Instance.new("Frame")
	row2.Name = "VolumeRow"
	row2.Size = UDim2.new(1, -40, 0, 56)
	row2.Position = UDim2.new(0, 20, 0, S.PanelHeaderHeight + 92)
	row2.BackgroundColor3 = C.CardBg
	row2.BorderSizePixel = 0
	row2.Parent = canvas

	local r2c = Instance.new("UICorner")
	r2c.CornerRadius = UDim.new(0, S.BtnCorner)
	r2c.Parent = row2

	local r2s = Instance.new("UIStroke")
	r2s.Color = C.CardStroke
	r2s.Thickness = S.PanelStroke
	r2s.Transparency = 0.35
	r2s.Parent = row2

	-- Stud texture on row
	Components.AddStudTexture(row2, S.BtnCorner)

	local r2pad = Instance.new("UIPadding")
	r2pad.PaddingLeft = UDim.new(0, 16)
	r2pad.PaddingRight = UDim.new(0, 14)
	r2pad.Parent = row2

	local volText = Instance.new("TextLabel")
	volText.Size = UDim2.new(0, 120, 1, 0)
	volText.Position = UDim2.fromOffset(0, 0)
	volText.BackgroundTransparency = 1
	volText.Font = Enum.Font.GothamBold
	volText.TextColor3 = C.TextWhite
	volText.TextSize = 20
	volText.Text = "Volume"
	volText.TextXAlignment = Enum.TextXAlignment.Left
	volText.Parent = row2

	local vts = Instance.new("UIStroke")
	vts.Color = Color3.fromRGB(0, 0, 0)
	vts.Thickness = 1.5
	vts.Transparency = 0.22
	vts.Parent = volText

	-- Volume percentage label
	volumeLabel = Instance.new("TextLabel")
	volumeLabel.Size = UDim2.fromOffset(50, 30)
	volumeLabel.AnchorPoint = Vector2.new(1, 0.5)
	volumeLabel.Position = UDim2.new(1, 0, 0.5, 0)
	volumeLabel.BackgroundTransparency = 1
	volumeLabel.Font = Enum.Font.GothamBold
	volumeLabel.TextColor3 = C.Gold
	volumeLabel.TextSize = 18
	volumeLabel.Text = "50%"
	volumeLabel.Parent = row2

	local vls = Instance.new("UIStroke")
	vls.Color = Color3.fromRGB(0, 0, 0)
	vls.Thickness = 1.5
	vls.Transparency = 0.22
	vls.Parent = volumeLabel

	-- Slider track
	local sliderTrack = Instance.new("TextButton")
	sliderTrack.Name = "SliderTrack"
	sliderTrack.Size = UDim2.new(1, -220, 0, 16)
	sliderTrack.AnchorPoint = Vector2.new(0, 0.5)
	sliderTrack.Position = UDim2.new(0, 134, 0.5, 0)
	sliderTrack.BackgroundColor3 = C.CardBgDark
	sliderTrack.BorderSizePixel = 0
	sliderTrack.AutoButtonColor = false
	sliderTrack.Text = ""
	sliderTrack.Parent = row2

	local stc = Instance.new("UICorner")
	stc.CornerRadius = UDim.new(0, 8)
	stc.Parent = sliderTrack

	-- Slider fill
	sliderFill = Instance.new("Frame")
	sliderFill.Name = "Fill"
	sliderFill.Size = UDim2.new(0.5, 0, 1, 0)
	sliderFill.BackgroundColor3 = C.Blue
	sliderFill.BorderSizePixel = 0
	sliderFill.Parent = sliderTrack

	local sfc = Instance.new("UICorner")
	sfc.CornerRadius = UDim.new(0, 8)
	sfc.Parent = sliderFill

	-- Slider interaction
	local dragging = false

	local function updateSliderFromInput(input)
		local trackAbsPos = sliderTrack.AbsolutePosition.X
		local trackAbsSize = sliderTrack.AbsoluteSize.X
		local relX = math.clamp((input.Position.X - trackAbsPos) / trackAbsSize, 0, 1)
		musicVolume = math.floor(relX * 100 + 0.5)
		updateVolumeVisual()
		applyMusicSettings()
	end

	sliderTrack.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			updateSliderFromInput(input)
		end
	end)

	sliderTrack.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)

	game:GetService("UserInputService").InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			updateSliderFromInput(input)
		end
	end)

	-- ─── CLOSE ───
	AnimUtil.WireButton(closeBtn, function()
		SoundUtil.Close()
		SettingsPanel.Hide()
	end)

	updateToggleVisual()
	updateVolumeVisual()
end

function SettingsPanel.Show()
	if visible then return end
	visible = true
	overlay.Visible = true
	SoundUtil.Open()
	AnimUtil.OpenPanel(canvas, uiScale)
end

function SettingsPanel.Hide()
	if not visible then return end
	visible = false
	overlay.Visible = false
	local t = AnimUtil.ClosePanel(canvas, uiScale)
	task.spawn(function()
		t.Completed:Wait()
		canvas.Visible = false
	end)
	if closeCallback then closeCallback() end
end

function SettingsPanel.IsVisible(): boolean
	return visible
end

function SettingsPanel.Toggle()
	if visible then SettingsPanel.Hide() else SettingsPanel.Show() end
end

return SettingsPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="128">
            <Properties>
              <string name="Name">ShopPanel</string>
              <string name="Source">--[[
	ShopPanel  (Premium / Robux Shop)
	Sells Fate Coins, exclusive Crowns, exclusive Pets, VIP bundles.
	All prices are in Robux.

	Features:
	  * Category tabs (Coins, Crowns, Pets, Bundles)
	  * Dark vibrant card grid with rarity borders
	  * Stud texture + sunburst background (via Components.CreatePanel)
	  * Item images from ItemCatalog (single source of truth)

	Used by: UIController (sidebar "Shop" button)
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local MarketplaceService = game:GetService("MarketplaceService")
local TweenService       = game:GetService("TweenService")
local Players            = game:GetService("Players")
local HttpService        = game:GetService("HttpService")
local RunService         = game:GetService("RunService")
local ContentProvider    = game:GetService("ContentProvider")
local UserInputService   = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer

local Shared = ReplicatedStorage:WaitForChild("Shared", 60)
if not Shared then
	warn("[ShopPanel] Shared not found after 60s -- disabled")
	return { Init = function() end, Show = function() end, Hide = function() end,
		IsVisible = function() return false end, Toggle = function() end }
end

local CDPModule = Shared:WaitForChild("ClientDepsProvider", 60)
if not CDPModule then
	local _children = {}
	for _, c in ipairs(Shared:GetChildren()) do table.insert(_children, c.Name.."("..c.ClassName..")") end
	warn("[ShopPanel] ClientDepsProvider MISSING. Shared path:", Shared:GetFullName(), "| Shared children:", table.concat(_children, ", "))
	return { Init = function() end, Show = function() end, Hide = function() end,
		IsVisible = function() return false end, Toggle = function() end }
end

local ok, Deps = pcall(require, CDPModule)
if not ok or not Deps then
	warn("[ShopPanel] require(ClientDepsProvider) FAILED:", Deps)
	return { Init = function() end, Show = function() end, Hide = function() end,
		IsVisible = function() return false end, Toggle = function() end }
end
local UIConfig = Deps.UIConfig
local ItemCatalog = Deps.ItemCatalog

local Client = script.Parent
local AnimUtil          = require(Client:WaitForChild("AnimUtil"))
local SoundUtil         = require(Client:WaitForChild("SoundUtil"))
local Components        = require(Client:WaitForChild("Components"))
local ThumbnailRenderer = require(Client:WaitForChild("ThumbnailRenderer"))
local RewardPopup       = require(Client:WaitForChild("RewardPopup"))

local C = UIConfig.Colors
local S = UIConfig.Sizes

local canvas: CanvasGroup = nil
local uiScale: UIScale = nil
local overlay: Frame = nil
local contentFrame: ScrollingFrame = nil
local coinsBgArt: ImageLabel? = nil
-- FadeOverlays: a Frame child of coinsBgArt used as container + duplicate guard.
-- Overlays are ImageLabels inside it, created once and reused across open/close cycles.
local _fadeContainer: Frame? = nil           -- "FadeOverlays" frame inside coinsBgArt
local _fadeOverlays: {ImageLabel} = {}       -- the 6 overlay ImageLabels
local _fadeThreads: {thread} = {}            -- per-overlay animation threads
local visible = false
local closeCallback: (() -&gt; ())? = nil
local activeTab = 1
local _setActiveTab: ((number) -&gt; ())? = nil

local CATEGORIES = {
	{ label = "Coins",   filter = "Currency" },
	{ label = "Crowns",  filter = "ExclusiveCrown" },
	{ label = "Pets",    filter = "ExclusivePet" },
	{ label = "Bundles", filter = "Bundle" },
}

local ShopPanel = {}

local function isMobileTouchDevice(): boolean
	return UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
end

local _bundlePanelOk, _BundlePanel = false, nil
do
	local bpModule = Client:WaitForChild("BundlePanel", 10)
	if bpModule then
		_bundlePanelOk, _BundlePanel = pcall(require, bpModule)
		if not _bundlePanelOk then
			warn("[ShopPanel] BundlePanel failed to load:", _BundlePanel)
			_BundlePanel = nil
		end
	else
		warn("[ShopPanel] BundlePanel module not found -- bundle tab will be empty")
	end
end

local _warnedMissing = {}
-- Items purchased this session: avoids waiting for OwnedCrowns attribute to propagate
local _locallyOwned: {[string]: true} = {}
local _isPopulating = false  -- guard: prevents duplicate populate runs
local _inventoryUpdatedConn: RBXScriptConnection? = nil
-- ─── Crown background animation state ─────────────────────────────
-- Crown images collected once at module load from ItemCatalog.Crowns.
local _crownBgImages: {string} = {}
do
	if ItemCatalog and ItemCatalog.Crowns then
		for _, data in pairs(ItemCatalog.Crowns) do
			local img = (ItemCatalog.GetImage and ItemCatalog.GetImage(data)) or data.image or ""
			if img ~= "" then
				table.insert(_crownBgImages, img)
			end
		end
	end
	print(string.format("[CrownBG] Collected %d crown images", #_crownBgImages))
end

local crownBgFrame: Frame? = nil            -- container Frame, created in Init
local petsBgFrame: Frame? = nil             -- pets tab background matching crown panel color
local _crownSlots: {ImageLabel} = {}        -- 3 reusable ImageLabel slots
local _crownBgThread: thread? = nil         -- single animation coroutine
local _crownBgRunning = false               -- guard: prevents duplicate loops
local _petsBgImages: {string} = {
	"rbxassetid://125284831618843",
	"rbxassetid://134436052421277",
	"rbxassetid://104828243058275",
	"rbxassetid://91529728615582",
	"rbxassetid://99697942325285",
	"rbxassetid://110624123106515",
	"rbxassetid://96775279467975",
}
local _petsBgSlidesRoot: Frame? = nil
local _petsBgSlots: {ImageLabel} = {}
local _petsBgThread: thread? = nil
local _petsBgRunning = false

local function clearCards()
	for _, child in ipairs(contentFrame:GetChildren()) do
		local keep = child:IsA("UIGridLayout") or child:IsA("UIPadding") or child:IsA("UIListLayout")
		if not keep then child:Destroy() end
	end
end

local function showShopToast(message: string)
	if not canvas or not canvas.Parent then return end

	local old = canvas:FindFirstChild("ShopToast")
	if old then old:Destroy() end

	local toast = Instance.new("TextLabel")
	toast.Name = "ShopToast"
	toast.AnchorPoint = Vector2.new(0.5, 1)
	toast.Position = UDim2.new(0.5, 0, 1, -18)
	toast.Size = UDim2.new(0, 320, 0, 36)
	toast.BackgroundColor3 = Color3.fromRGB(20, 24, 42)
	toast.BackgroundTransparency = 0.08
	toast.TextColor3 = Color3.fromRGB(255, 255, 255)
	toast.Font = Enum.Font.GothamBold
	toast.TextSize = 14
	toast.Text = tostring(message or "")
	toast.TextTransparency = 1
	toast.BorderSizePixel = 0
	toast.ZIndex = 80
	toast.Parent = canvas
	Instance.new("UICorner", toast).CornerRadius = UDim.new(0, 10)

	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(0, 0, 0)
	stroke.Thickness = 1.3
	stroke.Transparency = 0.25
	stroke.Parent = toast

	TweenService:Create(toast, TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		TextTransparency = 0
	}):Play()

	task.delay(1.8, function()
		if not toast or not toast.Parent then return end
		local fade = TweenService:Create(toast, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
			TextTransparency = 1,
			BackgroundTransparency = 1
		})
		fade:Play()
		fade.Completed:Connect(function()
			if toast then toast:Destroy() end
		end)
	end)
end

local NUM_OVERLAYS = 6

-- Stop animation threads and reset overlays to fully transparent.
-- Does NOT destroy overlays — they are reused on the next open.
local function stopCoinsBgAnim()
	for _, t in ipairs(_fadeThreads) do
		pcall(task.cancel, t)
	end
	_fadeThreads = {}
	for _, ovl in ipairs(_fadeOverlays) do
		TweenService:Create(ovl, TweenInfo.new(0), { ImageTransparency = 0.97 }):Play()
	end
	print("[PremiumShopBG] Fade stopped")
end

-- Build the FadeOverlays container + 6 overlay ImageLabels (only once).
-- Subsequent calls are no-ops if FadeOverlays already exists.
local function ensureFadeOverlays()
	if not coinsBgArt then return end
	if _fadeContainer and _fadeContainer.Parent then return end  -- already built

	-- Transparent full-size container parented to coinsBgArt
	local container = Instance.new("Frame")
	container.Name               = "FadeOverlays"
	container.AnchorPoint        = Vector2.new(0, 0)
	container.Position           = UDim2.fromScale(0, 0)
	container.Size               = UDim2.fromScale(1, 1)
	container.BackgroundTransparency = 1
	container.BorderSizePixel    = 0
	container.ZIndex             = coinsBgArt.ZIndex + 1
	container.Parent             = coinsBgArt
	_fadeContainer               = container
	_fadeOverlays                = {}

	for i = 1, NUM_OVERLAYS do
		local ovl = Instance.new("ImageLabel")
		ovl.Name                   = "Overlay" .. i
		ovl.AnchorPoint            = Vector2.new(0.5, 0.5)
		-- Slight random position offset: center ± 0.005–0.015 scale
		local ox = (math.random() * 0.02 - 0.01)
		local oy = (math.random() * 0.02 - 0.01)
		ovl.Position               = UDim2.fromScale(0.5 + ox, 0.5 + oy)
		ovl.Size                   = UDim2.fromScale(1.02, 1.02)  -- very slightly oversized to cover seams
		ovl.BackgroundTransparency = 1
		ovl.Image                  = coinsBgArt.Image
		ovl.ScaleType              = Enum.ScaleType.Crop
		ovl.ZIndex                 = container.ZIndex
		ovl.Rotation               = (math.random() * 4 - 2)     -- -2 to +2 degrees
		ovl.ImageTransparency      = 0.97
		ovl.Parent                 = container
		table.insert(_fadeOverlays, ovl)
	end
end

-- Start (or restart) per-overlay fade loops.
-- Overlays are created once by ensureFadeOverlays; this just drives the tweens.
local function startCoinsBgAnim()
	if not coinsBgArt or not coinsBgArt.Parent then return end
	ensureFadeOverlays()
	if #_fadeOverlays == 0 then return end
	-- Stop any existing threads before launching new ones (idempotent restart)
	for _, t in ipairs(_fadeThreads) do pcall(task.cancel, t) end
	_fadeThreads = {}

	for i, ovl in ipairs(_fadeOverlays) do
		local capturedOvl = ovl
		local t = task.spawn(function()
			-- Stagger start so overlays are not synchronized
			task.wait(math.random(0, 30) / 10)  -- 0–3s initial delay per overlay

			while capturedOvl.Parent do
				local fadeDur  = math.random(22, 55) / 10        -- 2.2–5.5s per half-cycle
				local holdDur  = math.random(0, 15) / 10         -- 0–1.5s hold
				local minTrans = math.random(75, 88) / 100       -- 0.75–0.88 (slightly visible)
				local maxTrans = math.random(92, 98) / 100       -- 0.92–0.98 (nearly invisible)

				local tIn = TweenService:Create(
					capturedOvl,
					TweenInfo.new(fadeDur, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
					{ ImageTransparency = minTrans }
				)
				tIn:Play()
				tIn.Completed:Wait()
				if not capturedOvl.Parent then break end

				if holdDur &gt; 0 then
					task.wait(holdDur)
					if not capturedOvl.Parent then break end
				end

				local tOut = TweenService:Create(
					capturedOvl,
					TweenInfo.new(fadeDur, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
					{ ImageTransparency = maxTrans }
				)
				tOut:Play()
				tOut.Completed:Wait()
				if not capturedOvl.Parent then break end
			end
		end)
		table.insert(_fadeThreads, t)
	end

	print(string.format("[PremiumShopBG] Fade overlays ready count=%d", #_fadeOverlays))
end

local function setCoinsBgVisible(visible_: boolean)
	if coinsBgArt then coinsBgArt.Visible = visible_ end
	if visible_ then
		startCoinsBgAnim()
	else
		stopCoinsBgAnim()
	end
end

-- ─── Crown tab animated background ────────────────────────────────

local function stopCrownBgAnim()
	_crownBgRunning = false
	if _crownBgThread then
		pcall(task.cancel, _crownBgThread)
		_crownBgThread = nil
	end
	for _, slot in ipairs(_crownSlots) do
		TweenService:Create(slot, TweenInfo.new(0), { ImageTransparency = 1 }):Play()
	end
end

local function startCrownBgAnim()
	if not crownBgFrame or not crownBgFrame.Parent then return end
	if #_crownBgImages == 0 or #_crownSlots == 0 then return end
	-- Idempotent: kill any running loop before starting a new one
	stopCrownBgAnim()
	_crownBgRunning = true

	local function shuffled(t: {string}): {string}
		local copy = table.clone(t)
		for i = #copy, 2, -1 do
			local j = math.random(1, i)
			copy[i], copy[j] = copy[j], copy[i]
		end
		return copy
	end

	_crownBgThread = task.spawn(function()
		local slotIdx  = 0
		local imgQueue = shuffled(_crownBgImages)
		local imgIdx   = 0

		while _crownBgRunning do
			-- Advance slot (round-robin through 3 slots)
			slotIdx = (slotIdx % #_crownSlots) + 1
			imgIdx  = imgIdx + 1
			if imgIdx &gt; #imgQueue then
				imgQueue = shuffled(_crownBgImages)
				imgIdx   = 1
			end

			local slot = _crownSlots[slotIdx]
			local img  = imgQueue[imgIdx]

			-- Assign new image and randomise placement before fade-in
			slot.Image            = img
			slot.ImageTransparency = 1
			slot.Position = UDim2.fromScale(
				math.random(20, 80) / 100,
				math.random(12, 88) / 100
			)
			slot.Rotation = math.random(-20, 20)

			-- Fade IN  (1.2 s)
			local targetTrans = math.random(94, 97) / 100   -- 0.94–0.97: very dark / barely visible
			local tIn = TweenService:Create(
				slot,
				TweenInfo.new(1.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
				{ ImageTransparency = targetTrans }
			)
			tIn:Play()
			tIn.Completed:Wait()
			if not _crownBgRunning then break end

			-- Hold (1.8–3.5 s)
			task.wait(math.random(18, 35) / 10)
			if not _crownBgRunning then break end

			-- Fire-and-forget fade OUT (1.2 s) — next iteration starts 0.5 s early
			-- creating a cross-fade overlap between two crown images.
			TweenService:Create(
				slot,
				TweenInfo.new(1.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
				{ ImageTransparency = 1 }
			):Play()

			-- Wait 0.7 s: the remaining 0.5 s of the fade-out overlaps the next fade-in
			task.wait(0.7)
			if not _crownBgRunning then break end
		end

		-- Final cleanup: hide all slots
		for _, s in ipairs(_crownSlots) do
			TweenService:Create(s, TweenInfo.new(0.3), { ImageTransparency = 1 }):Play()
		end
	end)
end

local function setCrownBgVisible(visible_: boolean)
	if crownBgFrame then crownBgFrame.Visible = visible_ end
	if visible_ then
		startCrownBgAnim()
	else
		stopCrownBgAnim()
	end
end

local _fateCoinImage: string = ""
do
	local entry = ItemCatalog.Get and ItemCatalog.Get("Currency", "FATE_COINS") or nil
	if entry and type(entry.image) == "string" and entry.image ~= "" then
		_fateCoinImage = entry.image
	end

	if _fateCoinImage ~= "" then
		print(string.format("[PremiumShop] Coins icon -&gt; type=Currency id=FATE_COINS image=%s", _fateCoinImage))
	else
		warn("[PremiumShop] Coins icon -&gt; type=Currency id=FATE_COINS image=&lt;EMPTY&gt;")
		if ItemCatalog.Currency and ItemCatalog.Currency.FATE_COINS then
			local directImg = ItemCatalog.Currency.FATE_COINS.image
			if directImg and type(directImg) == "string" and directImg ~= "" then
				_fateCoinImage = directImg
				print(string.format("[PremiumShop] Coins icon (direct fallback) -&gt; image=%s", _fateCoinImage))
			end
		end
		if _fateCoinImage == "" then
			warn("[PremiumShop] FATE_COINS image is EMPTY -- coin cards will show text fallback")
		end
	end
end

local _coinLayoutLogged = false

local function fixCoinCardLayout(card: Frame, imageId: string)
	local iconFrame = card:FindFirstChild("Icon")
	if not iconFrame then return end

	local imgLabel = iconFrame:FindFirstChild("ItemImage")
	if not imgLabel or not imgLabel:IsA("ImageLabel") then
		local letterLabel = iconFrame:FindFirstChild("Letter")
		if letterLabel then letterLabel.Visible = false end

		imgLabel = Instance.new("ImageLabel")
		imgLabel.Name = "ItemImage"
		imgLabel.ZIndex = 2
		imgLabel.Parent = iconFrame
	end

	imgLabel.BackgroundTransparency = 1
	imgLabel.ImageTransparency      = 0
	imgLabel.AnchorPoint            = Vector2.new(0.25, 0.25)
	imgLabel.Position               = UDim2.fromScale(0, 0)
	imgLabel.Size                   = UDim2.fromScale(2.1, 2.1)
	imgLabel.SizeConstraint         = Enum.SizeConstraint.RelativeXY
	imgLabel.Visible                = true

	if imgLabel.Image ~= imageId then
		imgLabel.Image = imageId
	end

	for _, child in ipairs(imgLabel:GetChildren()) do
		if child:IsA("UIAspectRatioConstraint") or child:IsA("UIScale") then
			child:Destroy()
		end
	end

	local letterLabel = iconFrame:FindFirstChild("Letter")
	if letterLabel then
		letterLabel.Visible = false
	end

	if not _coinLayoutLogged then
		_coinLayoutLogged = true
		print(string.format(
			"[PremiumShop] Coins ItemImage applied: AnchorPoint=0.25,0.25 Size=2.1x2.1 Image=%s",
			imageId
		))
	end
end

local function ensureViewportInCard(card: Frame, bgColor: Color3?): ViewportFrame?
	local existing = card:FindFirstChild("ModelPreview", true)
	if existing and existing:IsA("ViewportFrame") then
		return existing
	end

	local iconFrame = card:FindFirstChild("Icon")
	if not iconFrame then
		warn("[PremiumShop] Card has no Icon frame -- cannot create ViewportFrame")
		return nil
	end

	for _, child in ipairs(iconFrame:GetChildren()) do
		if child:IsA("TextLabel") or child:IsA("ImageLabel") then
			child:Destroy()
		end
	end

	local vpFrame = Instance.new("ViewportFrame")
	vpFrame.Name = "ModelPreview"
	vpFrame.Size = UDim2.fromScale(1, 1)
	vpFrame.BackgroundColor3 = bgColor or Color3.fromRGB(30, 32, 50)
	vpFrame.BackgroundTransparency = 0.3
	vpFrame.BorderSizePixel = 0
	vpFrame.Parent = iconFrame

	local vpCorner = Instance.new("UICorner")
	vpCorner.CornerRadius = UDim.new(0, 10)
	vpCorner.Parent = vpFrame

	return vpFrame
end

local function checkGamepassOwned(gamepassId: number): boolean
	local ok, owns = pcall(function()
		return MarketplaceService:UserOwnsGamePassAsync(LocalPlayer.UserId, gamepassId)
	end)
	return ok and owns == true
end

local function getOwnedSet(attrKey: string): {[string]: boolean}
	local out = {}
	local raw = LocalPlayer:GetAttribute(attrKey)
	if type(raw) ~= "string" or raw == "" then
		return out
	end
	local okDec, list = pcall(HttpService.JSONDecode, HttpService, raw)
	if okDec and type(list) == "table" then
		for _, id in ipairs(list) do
			out[id] = true
		end
	end
	return out
end

local function ensureGridLayout()
	for _, child in ipairs(contentFrame:GetChildren()) do
		if child:IsA("UIListLayout") then
			child:Destroy()
		end
	end
	if not contentFrame:FindFirstChildOfClass("UIGridLayout") then
		Components.AddGridLayout(contentFrame)
	end
end

local function setPetsBgVisible(visible_: boolean)
	if petsBgFrame then petsBgFrame.Visible = visible_ end
	if visible_ then
		if not petsBgFrame or not petsBgFrame.Parent then return end
		if #_petsBgSlots == 0 or #_petsBgImages == 0 then return end
		-- Preload once; safe to call repeatedly.
		pcall(function()
			ContentProvider:PreloadAsync(_petsBgImages)
		end)

		-- Idempotent restart.
		_petsBgRunning = false
		if _petsBgThread then
			pcall(task.cancel, _petsBgThread)
			_petsBgThread = nil
		end
		for _, slot in ipairs(_petsBgSlots) do
			TweenService:Create(slot, TweenInfo.new(0), { ImageTransparency = 1 }):Play()
		end

		_petsBgRunning = true
		local function shuffled(t: {string}): {string}
			local copy = table.clone(t)
			for i = #copy, 2, -1 do
				local j = math.random(1, i)
				copy[i], copy[j] = copy[j], copy[i]
			end
			return copy
		end

		_petsBgThread = task.spawn(function()
			local slotIdx = 0
			local imgQueue = shuffled(_petsBgImages)
			local imgIdx = 0
			while _petsBgRunning and petsBgFrame and petsBgFrame.Visible do
				slotIdx = (slotIdx % #_petsBgSlots) + 1
				imgIdx += 1
				if imgIdx &gt; #imgQueue then
					imgQueue = shuffled(_petsBgImages)
					imgIdx = 1
				end

				local slot = _petsBgSlots[slotIdx]
				if slot then
					slot.Image = imgQueue[imgIdx]
					slot.ImageTransparency = 1
					slot.Position = UDim2.fromScale(0.5, 0.5)
					slot.Size = UDim2.fromScale(1, 1)
					slot.Rotation = math.random(-2, 2)

					local targetTrans = math.random(76, 86) / 100 -- visible but subtle
					local fadeInDur = math.random(25, 45) / 10
					local holdDur = math.random(30, 70) / 10
					local fadeOutDur = math.random(25, 45) / 10

					local tIn = TweenService:Create(
						slot,
						TweenInfo.new(fadeInDur, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
						{ ImageTransparency = targetTrans }
					)
					tIn:Play()
					tIn.Completed:Wait()
					if not _petsBgRunning then break end

					task.wait(holdDur)
					if not _petsBgRunning then break end

					TweenService:Create(
						slot,
						TweenInfo.new(fadeOutDur, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
						{ ImageTransparency = 1 }
					):Play()

					-- Stagger starts so layers are unsynchronized.
					task.wait(math.random(10, 30) / 10)
				end
			end
			for _, s in ipairs(_petsBgSlots) do
				TweenService:Create(s, TweenInfo.new(0.3), { ImageTransparency = 1 }):Play()
			end
		end)
	else
		_petsBgRunning = false
		if _petsBgThread then
			pcall(task.cancel, _petsBgThread)
			_petsBgThread = nil
		end
		for _, s in ipairs(_petsBgSlots) do
			TweenService:Create(s, TweenInfo.new(0.2), { ImageTransparency = 1 }):Play()
		end
	end
end

local function resolvePremiumVisual(item, filterType: string)
	local catEntry = ItemCatalog.Get("Premium", item.id)
	if not catEntry and not _warnedMissing[item.id] then
		_warnedMissing[item.id] = true
		warn(string.format("[ShopPanel] No ItemCatalog.Premium entry for '%s' -- using placeholder", item.id))
	end

	local catalogImage: string
	local modelPath: string? = catEntry and catEntry.modelPath or nil
	local catalogIconText = catEntry and catEntry.iconText or nil
	if filterType == "Currency" then
		catalogImage = _fateCoinImage
	else
		local resolved = nil
		if (filterType == "ExclusiveCrown" or filterType == "ExclusivePet")
			and ItemCatalog.ResolveCrownOrPetImage
		then
			local kind = if filterType == "ExclusiveCrown" then "CROWN" else "PET"
			resolved = ItemCatalog.ResolveCrownOrPetImage(item.id, kind)
		end
		if resolved and resolved.mode == "STATIC" then
			catalogImage = resolved.image or ""
			modelPath = nil
		else
			catalogImage = catEntry and ItemCatalog.GetImage(catEntry) or ""
			if resolved and resolved.mode == "RENDERER" then
				modelPath = resolved.rendererKey
			end
		end
	end
	return catEntry, catalogImage, modelPath, catalogIconText
end

local FNAF_BANNER_IMAGE = "rbxassetid://72168519670720"
local FNAF_SINGLE_PRICE = 70000
local function formatCoinText(n: number): string
	local s = tostring(math.max(0, math.floor(n)))
	local k
	repeat
		s, k = string.gsub(s, "^(-?%d+)(%d%d%d)", "%1,%2")
	until k == 0
	return s
end

local function getFnafBundleQuote()
	local remotes = ReplicatedStorage:FindFirstChild("Remotes")
	local quoteRF = remotes and remotes:FindFirstChild("Shop_GetBundleQuote")
	if not quoteRF then
		return nil
	end
	local ok, result = pcall(quoteRF.InvokeServer, quoteRF, "fnaf_all")
	if not ok or type(result) ~= "table" then
		return nil
	end
	return result
end

local function populatePetsTab()
	clearCards()
	setCoinsBgVisible(false)
	setCrownBgVisible(false)
	setPetsBgVisible(true)
	local mobileLayout = isMobileTouchDevice()

	-- Rebuild pets content with ONE vertical UIListLayout:
	--   1) TopRow      (4 cards)
	--   2) FNAFSection (banner + controls)
	-- No spacer frames.
	for _, child in ipairs(contentFrame:GetChildren()) do
		child:Destroy()
	end

	contentFrame.AutomaticCanvasSize = Enum.AutomaticSize.Y
	contentFrame.CanvasSize = UDim2.fromScale(0, 0)
	contentFrame.ScrollBarThickness = 6
	contentFrame.ScrollingDirection = Enum.ScrollingDirection.Y

	local list = Instance.new("UIListLayout")
	list.Name = "PetsListLayout"
	list.SortOrder = Enum.SortOrder.LayoutOrder
	list.FillDirection = Enum.FillDirection.Vertical
	list.HorizontalAlignment = Enum.HorizontalAlignment.Center
	list.Padding = UDim.new(0, mobileLayout and 10 or 12)
	list.Parent = contentFrame

	local FNAF_H = 280

	-- ── Build item data ─────────────────────────────────────────────
	local allPets = ItemCatalog.GetAllPetsSorted and ItemCatalog.GetAllPetsSorted() or {}
	local fnafSet: {[string]: boolean} = {}
	local fnafPetIds = {}
	for _, pet in ipairs(allPets) do
		if pet.collection == "FNAF" then
			fnafSet[pet.id] = true
			table.insert(fnafPetIds, pet.id)
		end
	end

	local topPets = {}
	for _, item in ipairs(UIConfig.MockPremiumItems) do
		if item.type == "ExclusivePet" and not fnafSet[item.id] and #topPets &lt; 4 then
			table.insert(topPets, item)
		end
	end

	local ownedPets = getOwnedSet("OwnedPets")

	local function createPetCard(parent: Instance, item, layoutOrder: number, forceFateCoins: boolean, enablePreview: boolean)
		local petEntry = ItemCatalog.GetPet and ItemCatalog.GetPet(item.id) or nil
		local displayName = (petEntry and petEntry.name) or item.name
		local isFNAFPet = petEntry and petEntry.collection == "FNAF"
		local isGamepass = item.gamepassId and item.gamepassId &gt; 0
		if forceFateCoins then
			isGamepass = false
		end
		local isFateCoins = forceFateCoins or (item.fateCoins and item.fateCoins &gt; 0)
		local isOwned = _locallyOwned[item.id] == true or ownedPets[item.id] == true
		if isGamepass then
			-- Gamepass ownership checks can lag after purchase; inventory ownership is authoritative.
			isOwned = isOwned or checkGamepassOwned(item.gamepassId)
		end

		local actionText, actionColor
		if isOwned then
			actionText = "OWNED"
			actionColor = C.DisabledBtn
		elseif isFateCoins then
			actionText = string.format("%dK F", math.floor(FNAF_SINGLE_PRICE / 1000))
			actionColor = Color3.fromRGB(255, 200, 30)
		else
			actionText = string.format("%d ROBUX", item.robux or 0)
			actionColor = C.RobuxButton
		end

		local _, catalogImage, modelPath, catalogIconText = resolvePremiumVisual(item, "ExclusivePet")
		-- Enforce shared image resolver rules directly from authoritative pet entry.
		if ItemCatalog.ResolveCrownOrPetImage then
			local resolvedPet = ItemCatalog.ResolveCrownOrPetImage(item.id, "PET")
			if resolvedPet and resolvedPet.mode == "STATIC" then
				catalogImage = resolvedPet.image or ""
				modelPath = nil
			elseif resolvedPet and resolvedPet.mode == "RENDERER" then
				catalogImage = ""
				modelPath = resolvedPet.rendererKey
			end
		end
		local card = Components.CreateItemCard(parent, {
			name       = displayName,
			rarity     = item.rarity or "Rare",
			iconColor  = item.iconColor,
			iconText   = catalogIconText,
			image      = catalogImage,
			modelPath  = modelPath,
			tag        = item.tag,
			actionText = actionText,
			actionColor= actionColor,
			onAction = function()
				if isOwned then return end
				if isGamepass then
					MarketplaceService:PromptGamePassPurchase(LocalPlayer, item.gamepassId)
					return
				end
				local remotes = ReplicatedStorage:FindFirstChild("Remotes")
				local buyRF   = remotes and remotes:FindFirstChild("Shop_BuyWithCoins")
				if not buyRF then return end
				local ok, result = pcall(buyRF.InvokeServer, buyRF, item.id, "ExclusivePet")
				if ok and result and result.success then
					_locallyOwned[item.id] = true
					local btn = card:FindFirstChild("ActionBtn")
					if btn and btn:IsA("TextButton") then
						btn.Text = "OWNED"
						btn.BackgroundColor3 = C.DisabledBtn
						btn.Active = false
					end
				end
			end,
		})
		card.Name = "ItemCard_" .. item.id
		card.LayoutOrder = layoutOrder

		if modelPath and catalogImage == "" and not isFNAFPet then
			local vpFrame = ensureViewportInCard(card, item.iconColor)
			if vpFrame then
				ThumbnailRenderer.RenderItemToViewport(vpFrame, {
					modelPath = modelPath, id = item.id,
					name = item.name, type = "ExclusivePet",
				})
			end
		end

		if enablePreview and _BundlePanel and _BundlePanel.ShowItemPreviewIn then
			local iconFrame = card:FindFirstChild("Icon")
			if iconFrame and iconFrame:IsA("Frame") then
				local click = Instance.new("TextButton")
				click.Name = "PreviewClick"
				click.Size = UDim2.fromScale(1, 1)
				click.BackgroundTransparency = 1
				click.Text = ""
				click.ZIndex = 10
				click.Parent = iconFrame
				click.MouseButton1Click:Connect(function()
					SoundUtil.Click()
					_BundlePanel.ShowItemPreviewIn(canvas, {
						name = displayName,
						image = catalogImage,
						modelPath = modelPath,
					})
				end)
			end
		end
	end

	-- Top row section
	-- IMPORTANT: do not hardcode 2 rows; on wider panels these 4 cards render as 1 row.
	-- If we reserve 2-row height unconditionally, it creates a giant blank gap below cards.
	local topH = S.CardHeight
	local topSection = Instance.new("Frame")
	topSection.Name             = "TopRow"
	topSection.Size             = UDim2.new(1, 0, 0, topH)
	topSection.AutomaticSize    = Enum.AutomaticSize.None
	topSection.BackgroundTransparency = 1
	topSection.LayoutOrder      = 1
	topSection.Parent           = contentFrame

	local grid = Instance.new("UIGridLayout")
	local topCellW = mobileLayout and math.floor(S.CardWidth * 0.78) or S.CardWidth
	local topCellH = mobileLayout and math.floor(S.CardHeight * 0.9) or S.CardHeight
	local topCols = mobileLayout and 2 or 4
	grid.CellSize              = UDim2.fromOffset(topCellW, topCellH)
	grid.CellPadding           = UDim2.fromOffset(S.CardPad, S.CardPad)
	grid.SortOrder             = Enum.SortOrder.LayoutOrder
	grid.FillDirection         = Enum.FillDirection.Horizontal
	grid.FillDirectionMaxCells = topCols
	grid.HorizontalAlignment   = Enum.HorizontalAlignment.Center
	grid.Parent                = topSection

	for i, item in ipairs(topPets) do
		createPetCard(topSection, item, i, false, false)
	end

	-- Reserve a deterministic row band for top cards on mobile so the next
	-- section header never shares the same vertical space.
	local topRows = math.max(1, math.ceil(#topPets / topCols))
	local reservedTopH = topRows * topCellH + math.max(0, topRows - 1) * S.CardPad
	topSection.Size = UDim2.new(1, 0, 0, reservedTopH + (mobileLayout and 28 or 10))

	if mobileLayout then
		local topSpacer = Instance.new("Frame")
		topSpacer.Name = "TopToFNAFSpacer"
		topSpacer.Size = UDim2.new(1, 0, 0, 10)
		topSpacer.BackgroundTransparency = 1
		topSpacer.LayoutOrder = 2
		topSpacer.Parent = contentFrame
	end

	local fnafHeader = Instance.new("Frame")
	fnafHeader.Name = "FNAFHeader"
	fnafHeader.Size = UDim2.new(1, -16, 0, 26)
	fnafHeader.BackgroundColor3 = Color3.fromRGB(10, 12, 24)
	fnafHeader.BackgroundTransparency = 0.25
	fnafHeader.BorderSizePixel = 0
	fnafHeader.LayoutOrder = mobileLayout and 3 or 2
	fnafHeader.ZIndex = 8
	fnafHeader.Parent = contentFrame
	Instance.new("UICorner", fnafHeader).CornerRadius = UDim.new(0, 8)
	local headerStroke = Instance.new("UIStroke")
	headerStroke.Color = Color3.fromRGB(255, 208, 40)
	headerStroke.Thickness = 1.5
	headerStroke.Transparency = 0.35
	headerStroke.Parent = fnafHeader

	local headerLabel = Instance.new("TextLabel")
	headerLabel.Name = "Label"
	headerLabel.BackgroundTransparency = 1
	headerLabel.Position = UDim2.fromOffset(10, 0)
	headerLabel.Size = UDim2.new(1, -20, 1, 0)
	headerLabel.Font = Enum.Font.GothamBold
	headerLabel.Text = "Limited FNAF Pets"
	headerLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
	headerLabel.TextSize = 16
	headerLabel.TextXAlignment = Enum.TextXAlignment.Left
	headerLabel.ZIndex = 9
	headerLabel.Parent = fnafHeader
	local headerTextStroke = Instance.new("UIStroke")
	headerTextStroke.Color = Color3.fromRGB(0, 0, 0)
	headerTextStroke.Thickness = 1.6
	headerTextStroke.Transparency = 0.25
	headerTextStroke.Parent = headerLabel

	-- FNAF section: full-width banner, pet grid below, and buy-all button.
	local fnafPets = {}
	for _, pet in ipairs(allPets) do
		if pet.collection == "FNAF" then
			table.insert(fnafPets, pet)
		end
	end

	-- Slightly taller banner to reduce top-edge crop while keeping Crop fill.
	local BANNER_H = mobileLayout and 148 or 196
	local TILE_W = mobileLayout and 128 or 156
	local TILE_H = mobileLayout and 120 or 130
	local TILE_PAD = 10
	local BUY_ALL_H = mobileLayout and 40 or 42
	local INNER_PAD = mobileLayout and 10 or 8
	local SECTION_GAP = 12

	local fnafSection = Instance.new("Frame")
	fnafSection.Name = "FNAFSection"
	fnafSection.Size = UDim2.new(1, 0, 0, 0)
	fnafSection.AutomaticSize = Enum.AutomaticSize.Y
	fnafSection.BackgroundTransparency = 1
	fnafSection.LayoutOrder = mobileLayout and 4 or 3
	fnafSection.Parent = contentFrame

	local fnafPadding = Instance.new("UIPadding")
	fnafPadding.PaddingLeft = UDim.new(0, 8)
	fnafPadding.PaddingRight = UDim.new(0, 8)
	fnafPadding.PaddingBottom = UDim.new(0, INNER_PAD)
	fnafPadding.Parent = fnafSection

	local fnafLayout = Instance.new("UIListLayout")
	fnafLayout.FillDirection = Enum.FillDirection.Vertical
	fnafLayout.SortOrder = Enum.SortOrder.LayoutOrder
	fnafLayout.Padding = UDim.new(0, SECTION_GAP)
	fnafLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	fnafLayout.Parent = fnafSection

	local bannerContainer = Instance.new("Frame")
	bannerContainer.Name = "FNAFBanner"
	bannerContainer.Size = UDim2.new(1, 0, 0, BANNER_H)
	bannerContainer.BackgroundColor3 = Color3.fromRGB(10, 12, 24)
	bannerContainer.BorderSizePixel = 0
	bannerContainer.ClipsDescendants = true
	bannerContainer.LayoutOrder = 1
	bannerContainer.Parent = fnafSection
	Instance.new("UICorner", bannerContainer).CornerRadius = UDim.new(0, 10)
	local bannerStroke = Instance.new("UIStroke")
	bannerStroke.Color = Color3.fromRGB(255, 208, 40)
	bannerStroke.Thickness = 2
	bannerStroke.Transparency = 0.15
	bannerStroke.Parent = bannerContainer

	local bannerImage = Instance.new("ImageLabel")
	bannerImage.Name = "CoverImage"
	bannerImage.Size = UDim2.fromScale(1, 1)
	bannerImage.Position = UDim2.fromScale(0, 0)
	bannerImage.AnchorPoint = Vector2.new(0, 0)
	bannerImage.BackgroundTransparency = 1
	bannerImage.Image = FNAF_BANNER_IMAGE
	bannerImage.ScaleType = Enum.ScaleType.Crop
	bannerImage.Parent = bannerContainer

	local bannerTitle = Instance.new("TextLabel")
	bannerTitle.Name = "Title"
	bannerTitle.BackgroundTransparency = 1
	bannerTitle.Position = UDim2.fromOffset(12, 8)
	bannerTitle.Size = UDim2.new(1, -24, 0, 28)
	bannerTitle.Font = Enum.Font.GothamBold
	bannerTitle.Text = "FNAF Pets"
	bannerTitle.TextColor3 = Color3.fromRGB(255, 255, 255)
	bannerTitle.TextSize = mobileLayout and 26 or 32
	bannerTitle.TextXAlignment = Enum.TextXAlignment.Left
	bannerTitle.ZIndex = 2
	bannerTitle.Parent = bannerContainer
	local titleStroke = Instance.new("UIStroke")
	titleStroke.Color = Color3.fromRGB(0, 0, 0)
	titleStroke.Thickness = 2
	titleStroke.Transparency = 0.2
	titleStroke.Parent = bannerTitle

	local gridHost = Instance.new("Frame")
	gridHost.Name = "FNAFPetGrid"
	gridHost.BackgroundTransparency = 1
	gridHost.Size = UDim2.new(1, 0, 0, 0)
	gridHost.AutomaticSize = Enum.AutomaticSize.Y
	gridHost.LayoutOrder = 2
	gridHost.Parent = fnafSection

	local fnafGrid = Instance.new("UIGridLayout")
	fnafGrid.CellSize = UDim2.fromOffset(TILE_W, TILE_H)
	fnafGrid.CellPadding = UDim2.fromOffset(TILE_PAD, TILE_PAD)
	fnafGrid.FillDirection = Enum.FillDirection.Horizontal
	fnafGrid.FillDirectionMaxCells = mobileLayout and 2 or 4
	fnafGrid.SortOrder = Enum.SortOrder.LayoutOrder
	fnafGrid.HorizontalAlignment = Enum.HorizontalAlignment.Center
	fnafGrid.Parent = gridHost

	local remotes = ReplicatedStorage:FindFirstChild("Remotes")
	local buyRF = remotes and remotes:FindFirstChild("Shop_BuyWithCoins")
	for i, pet in ipairs(fnafPets) do
		local resolved = ItemCatalog.ResolveCrownOrPetImage and ItemCatalog.ResolveCrownOrPetImage(pet.id, "PET") or nil
		local imageId = (resolved and resolved.image) or ItemCatalog.GetImage(pet)
		local isOwned = _locallyOwned[pet.id] == true or ownedPets[pet.id] == true

		local tile = Instance.new("Frame")
		tile.Name = "FNAFTile_" .. pet.id
		tile.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
		tile.BorderSizePixel = 0
		tile.LayoutOrder = i
		tile.Parent = gridHost
		Instance.new("UICorner", tile).CornerRadius = UDim.new(0, 8)
		local tileStroke = Instance.new("UIStroke")
		tileStroke.Color = Color3.fromRGB(255, 208, 40)
		tileStroke.Thickness = 1.5
		tileStroke.Transparency = 0.28
		tileStroke.Parent = tile

		local icon = Instance.new("ImageLabel")
		icon.Name = "Icon"
		icon.BackgroundTransparency = 1
		icon.Position = UDim2.fromOffset(8, 6)
		icon.Size = UDim2.new(1, -16, 0, 70)
		icon.Image = imageId
		icon.ScaleType = Enum.ScaleType.Fit
		icon.Parent = tile
		if _BundlePanel and _BundlePanel.ShowItemPreviewIn then
			local previewClick = Instance.new("TextButton")
			previewClick.Name = "PreviewClick"
			previewClick.Size = UDim2.fromScale(1, 1)
			previewClick.Position = UDim2.fromScale(0, 0)
			previewClick.BackgroundTransparency = 1
			previewClick.Text = ""
			previewClick.ZIndex = 3
			previewClick.Parent = icon
			previewClick.MouseButton1Click:Connect(function()
				SoundUtil.Click()
				_BundlePanel.ShowItemPreviewIn(canvas, {
					name = pet.name,
					image = imageId,
					modelPath = pet.modelPath,
				})
			end)
		end

		local nameLbl = Instance.new("TextLabel")
		nameLbl.Name = "Name"
		nameLbl.BackgroundTransparency = 1
		nameLbl.Position = UDim2.fromOffset(6, 77)
		nameLbl.Size = UDim2.new(1, -12, 0, 18)
		nameLbl.Font = Enum.Font.GothamBold
		nameLbl.TextColor3 = C.TextWhite
		nameLbl.TextSize = 12
		nameLbl.Text = pet.name
		nameLbl.TextTruncate = Enum.TextTruncate.AtEnd
		nameLbl.Parent = tile

		local buyBtn = Instance.new("TextButton")
		buyBtn.Name = "BuyBtn"
		buyBtn.AnchorPoint = Vector2.new(0.5, 1)
		buyBtn.Position = UDim2.new(0.5, 0, 1, -6)
		buyBtn.Size = UDim2.new(1, -12, 0, 26)
		buyBtn.BackgroundColor3 = isOwned and C.DisabledBtn or Color3.fromRGB(255, 200, 30)
		buyBtn.BorderSizePixel = 0
		buyBtn.AutoButtonColor = not isOwned
		buyBtn.Text = isOwned and "OWNED" or "70K F"
		buyBtn.TextColor3 = isOwned and Color3.fromRGB(210, 215, 230) or Color3.fromRGB(35, 25, 0)
		buyBtn.Font = Enum.Font.GothamBold
		buyBtn.TextSize = 12
		buyBtn.Parent = tile
		Instance.new("UICorner", buyBtn).CornerRadius = UDim.new(0, 8)

		buyBtn.MouseButton1Click:Connect(function()
			if isOwned or not buyRF then
				return
			end
			local okBuy, result = pcall(buyRF.InvokeServer, buyRF, pet.id, "ExclusivePet")
			if okBuy and result and result.success then
				_locallyOwned[pet.id] = true
				isOwned = true
				buyBtn.Text = "OWNED"
				buyBtn.BackgroundColor3 = C.DisabledBtn
				buyBtn.TextColor3 = Color3.fromRGB(210, 215, 230)
				buyBtn.AutoButtonColor = false
			elseif okBuy and result and result.reason == "INSUFFICIENT_COINS" then
				local productId = tonumber(result.productId)
				if productId and productId &gt; 0 then
					MarketplaceService:PromptProductPurchase(LocalPlayer, productId)
				else
					warn("[ShopPanel] Missing top-up productId for insufficient FNAF item coins")
				end
			end
		end)
	end

	local buyAllBtn = Instance.new("TextButton")
	buyAllBtn.Name = "BuyAllFNAFBtn"
	buyAllBtn.BackgroundColor3 = Color3.fromRGB(255, 200, 30)
	buyAllBtn.BorderSizePixel = 0
	buyAllBtn.Size = UDim2.new(1, 0, 0, BUY_ALL_H)
	buyAllBtn.LayoutOrder = 3
	buyAllBtn.Text = "Buy All FNAF Pets — 150,000 Fate Coins"
	buyAllBtn.TextColor3 = Color3.fromRGB(20, 14, 0)
	buyAllBtn.Font = Enum.Font.GothamBold
	buyAllBtn.TextSize = mobileLayout and 15 or 18
	buyAllBtn.Parent = fnafSection
	Instance.new("UICorner", buyAllBtn).CornerRadius = UDim.new(0, 10)
	local buyAllStroke = Instance.new("UIStroke")
	buyAllStroke.Color = Color3.fromRGB(0, 0, 0)
	buyAllStroke.Thickness = 1.4
	buyAllStroke.Transparency = 0.35
	buyAllStroke.Parent = buyAllBtn
	local function applyBuyAllStateFromQuote(quote)
		if quote and quote.ok == false and quote.reason == "ALREADY_OWNED" then
			buyAllBtn.Text = "OWNED"
			buyAllBtn.BackgroundColor3 = C.DisabledBtn
			buyAllBtn.TextColor3 = Color3.fromRGB(210, 215, 230)
			buyAllBtn.AutoButtonColor = false
			buyAllBtn.Active = false
			return
		end
		local price = quote and tonumber(quote.price) or 150000
		buyAllBtn.Text = string.format("Buy All FNAF Pets — %s Fate Coins", formatCoinText(price))
		buyAllBtn.BackgroundColor3 = Color3.fromRGB(255, 200, 30)
		buyAllBtn.TextColor3 = Color3.fromRGB(20, 14, 0)
		buyAllBtn.AutoButtonColor = true
		buyAllBtn.Active = true
	end
	applyBuyAllStateFromQuote(getFnafBundleQuote())

	local buyAllBusy = false
	buyAllBtn.MouseButton1Click:Connect(function()
		if buyAllBusy then return end
		local preQuote = getFnafBundleQuote()
		applyBuyAllStateFromQuote(preQuote)
		if preQuote and preQuote.ok == false and preQuote.reason == "ALREADY_OWNED" then
			showShopToast("You already own all FNAF pets.")
			return
		end
		local remotes = ReplicatedStorage:FindFirstChild("Remotes")
		local buyRF = remotes and remotes:FindFirstChild("Shop_BuyWithCoins")
		if not buyRF then
			warn("[ShopPanel] Shop_BuyWithCoins remote not found for FNAF bundle")
			return
		end

		buyAllBusy = true
		buyAllBtn.AutoButtonColor = false

		local okBuy, result = pcall(buyRF.InvokeServer, buyRF, "fnaf_all", "Bundle")
		if okBuy and result and result.success then
			for _, petId in ipairs(fnafPetIds) do
				_locallyOwned[petId] = true
			end
			populatePetsTab()
		else
			local reason = (okBuy and result and result.reason) or "Purchase failed"
			if reason == "ALREADY_OWNED" then
				showShopToast("You already own all FNAF pets.")
				for _, petId in ipairs(fnafPetIds) do
					_locallyOwned[petId] = true
				end
				populatePetsTab()
			elseif reason == "INSUFFICIENT_COINS" then
				local productId = okBuy and result and tonumber(result.productId) or nil
				if productId and productId &gt; 0 then
					showShopToast("Not enough Fate Coins. Opening top-up...")
					MarketplaceService:PromptProductPurchase(LocalPlayer, productId)
				else
					RewardPopup.Show({
						title = "PURCHASE FAILED",
						name = "Not enough Fate Coins",
						itemType = "Currency",
						icon = "rbxassetid://72345557707985",
						okText = "OK",
					})
				end
			else
				RewardPopup.Show({
					title = "PURCHASE FAILED",
					name = tostring(reason),
					itemType = "Currency",
					icon = "rbxassetid://72345557707985",
					okText = "OK",
				})
			end
		end

		buyAllBusy = false
		buyAllBtn.AutoButtonColor = true
		applyBuyAllStateFromQuote(getFnafBundleQuote())
	end)
end

local function populateCards(filterType: string)
	if _isPopulating then return end
	_isPopulating = true
	clearCards()
	setCoinsBgVisible(filterType == "Currency")
	setCrownBgVisible(filterType == "ExclusiveCrown")
	setPetsBgVisible(filterType == "ExclusivePet")

	if filterType == "ExclusivePet" then
		populatePetsTab()
		_isPopulating = false
		return
	end

	ensureGridLayout()

	print(string.format("[PremiumShop] populateCards called -- filterType=%s", filterType))

	local bestValueCurrencyId: string? = nil
	if filterType == "Currency" then
		local bestRatio = -math.huge
		for _, entry in ipairs(UIConfig.MockPremiumItems) do
			if entry.type == "Currency" and (entry.robux or 0) &gt; 0 then
				local coinsAmount = tonumber(entry.coinsAmount) or 0
				local ratio = coinsAmount / entry.robux
				if ratio &gt; bestRatio then
					bestRatio = ratio
					bestValueCurrencyId = entry.id
				end
			end
		end
	end

	local order = 0
	for _, item in ipairs(UIConfig.MockPremiumItems) do
		if item.type == filterType then
			order += 1

			local isGamepass  = item.gamepassId and item.gamepassId &gt; 0
			local isProduct   = item.productId and item.productId &gt; 0
			local isFateCoins = item.fateCoins and item.fateCoins &gt; 0

			-- Ownership check (server-confirmed inventory state + local optimistic cache).
			local isOwned = false
			if isGamepass or isFateCoins then
				local attrKey = (filterType == "ExclusiveCrown") and "OwnedCrowns" or "OwnedPets"
				local ownedSet = getOwnedSet(attrKey)
				isOwned = (_locallyOwned[item.id] == true) or (ownedSet[item.id] == true)
			end
			local actionText
			local actionColor
			if isOwned then
				actionText = "OWNED"
				actionColor = C.DisabledBtn
			elseif isFateCoins then
				local fmt = item.fateCoins &gt;= 1000
					and string.format("%dK F", math.floor(item.fateCoins / 1000))
					or string.format("%d F", item.fateCoins)
				actionText  = fmt
				actionColor = Color3.fromRGB(255, 200, 30)
			else
				actionText = string.format("%d ROBUX", item.robux or 0)
				actionColor = C.RobuxButton
			end

			local catEntry, catalogImage, modelPath, catalogIconText = resolvePremiumVisual(item, filterType)

			local hasExplicitImage = (catalogImage ~= "")
			local petEntry = (filterType == "ExclusivePet" and ItemCatalog.GetPet and ItemCatalog.GetPet(item.id)) or nil
			local isFNAFPet = petEntry and petEntry.collection == "FNAF"
			local wantsThumbnail = (not hasExplicitImage) and modelPath
				and (filterType == "ExclusivePet" or filterType == "ExclusiveCrown")
				and not isFNAFPet

			local cardData = {
				name = item.name,
				rarity = item.rarity or "Rare",
				iconColor = item.iconColor,
				thumbnailBgColor = catEntry and catEntry.thumbnailBgColor or nil,
				iconText = catalogIconText,
				image = catalogImage,
				modelPath = modelPath,
				tag = (filterType == "Currency" and (
					(item.id == "coins_500" and "POPULAR")
					or (item.id == bestValueCurrencyId and "BEST VALUE")
					or ""
				)) or item.tag,
				actionText = actionText,
				actionColor = actionColor,
			onAction = function()
				if isOwned then return end

				if isGamepass then
					MarketplaceService:PromptGamePassPurchase(LocalPlayer, item.gamepassId)
				elseif isProduct then
					MarketplaceService:PromptProductPurchase(LocalPlayer, item.productId)
				elseif isFateCoins then
					local remotes = ReplicatedStorage:FindFirstChild("Remotes")
					local buyRF = remotes and remotes:FindFirstChild("Shop_BuyWithCoins")
					if not buyRF then
						warn("[ShopPanel] Shop_BuyWithCoins remote not found")
						return
					end
					local ok, result = pcall(buyRF.InvokeServer, buyRF, item.id, item.type)
					if ok and result and result.success then
						-- Record locally so ownership check is immediate on next rebuild
						_locallyOwned[item.id] = true
						-- Surgically update ONLY this card's ActionBtn — no full rebuild,
						-- no card-clear flash, no layout shift.
						local cardFrame = contentFrame:FindFirstChild("ItemCard_" .. item.id)
						if cardFrame then
							local actionBtn = cardFrame:FindFirstChild("ActionBtn")
							if actionBtn then
								actionBtn.Text = "OWNED"
								actionBtn.BackgroundColor3 = C.DisabledBtn
								actionBtn.Active = false
								local grad = actionBtn:FindFirstChildOfClass("UIGradient")
								if grad then grad:Destroy() end
							end
						else
							-- Card not found by ID (e.g. first open): fall back to full rebuild
							populateCards(CATEGORIES[activeTab].filter)
						end
					elseif ok and result then
						warn(string.format("[ShopPanel] Purchase failed for %s: %s", item.name, tostring(result.reason)))
					else
						warn("[ShopPanel] Remote error:", tostring(result))
					end
				else
					print(string.format("[ShopPanel] No purchase ID for: %s", item.name))
				end
			end,
			}

			local card = Components.CreateItemCard(contentFrame, cardData)
			card.Name        = "ItemCard_" .. item.id   -- ID tag for surgical update
			card.LayoutOrder = order

			if wantsThumbnail then
				local vpFrame = ensureViewportInCard(card, item.iconColor)
				if vpFrame then
					ThumbnailRenderer.RenderItemToViewport(vpFrame, {
						modelPath = modelPath,
						id = item.id,
						name = item.name,
						type = filterType,
					})
				end
			end

			if filterType == "Currency" and catalogImage ~= "" then
				fixCoinCardLayout(card, catalogImage)
			end
		end
	end
	_isPopulating = false
end

local function ensureTabBarPinned()
	if not _tabBarRef or not _tabBarRef.Parent then return end
	if not _tabBarHostRef or not _tabBarHostRef.Parent then return end
	if not contentFrame or not contentFrame.Parent then return end

	if _tabBarRef:IsDescendantOf(contentFrame) then
		_tabBarRef.Parent = _tabBarHostRef
		_tabBarRef.AnchorPoint = Vector2.new(0.5, 0)
		_tabBarRef.Position = UDim2.new(0.5, 0, 0, 0)
		_tabBarRef.Size = UDim2.new(1, 0, 0, S.TabHeight + 8)
		warn("[TabBarDebug] TabBar was inside scrolling content; reparented to fixed host")
	end
end

function ShopPanel.Init(screenGui: ScreenGui, onClose: () -&gt; ())
	closeCallback = onClose

	overlay = Components.CreateDimOverlay(screenGui, function()
		ShopPanel.Hide()
	end)

	local content, closeBtn
	canvas, uiScale, content, closeBtn = Components.CreatePanel(screenGui, "PREMIUM SHOP", C.HeaderShop, "Shop")
	contentFrame = content

	closeBtn.MouseButton1Click:Connect(function()
		SoundUtil.Close()
		ShopPanel.Hide()
	end)

	if not _inventoryUpdatedConn then
		task.spawn(function()
			local remotes = ReplicatedStorage:WaitForChild("Remotes", 10)
			local invUpdate = remotes and remotes:FindFirstChild("InventoryUpdated")
			if invUpdate and invUpdate:IsA("RemoteEvent") then
				_inventoryUpdatedConn = invUpdate.OnClientEvent:Connect(function()
					if not visible then return end
					local tab = CATEGORIES[activeTab]
					if tab and tab.filter ~= "Bundle" then
						populateCards(tab.filter)
					end
				end)
			end
		end)
	end

	local tabTitles = {}
	for _, cat in ipairs(CATEGORIES) do
		table.insert(tabTitles, { label = cat.label })
	end

	local setActiveTab: ((number) -&gt; ())?
	local tabBar
	tabBar, setActiveTab = Components.CreateTabBar(canvas, tabTitles, function(idx)
		activeTab = idx
		if setActiveTab then
			setActiveTab(idx)
		end
		if CATEGORIES[idx].filter == "Bundle" then
			clearCards()
			setCoinsBgVisible(false)
			setCrownBgVisible(false)
			setPetsBgVisible(false)
			if _BundlePanel and _BundlePanel.PopulateInto then
				_BundlePanel.PopulateInto(contentFrame)
			end
			return
		end
		if _BundlePanel and _BundlePanel.ClearContent then
			_BundlePanel.ClearContent()
		end
		populateCards(CATEGORIES[idx].filter)
	end)
	tabBar.AnchorPoint = Vector2.new(0.5, 0)
	tabBar.Position = UDim2.new(0.5, 0, 0, S.PanelHeaderHeight + 4)
	tabBar.Size = UDim2.new(1, -20, 0, S.TabHeight + 8)

	content.Position = UDim2.new(0, 12, 0, S.PanelHeaderHeight + S.TabHeight + 18)
	content.Size = UDim2.new(1, -24, 1, -(S.PanelHeaderHeight + S.TabHeight + 28))

	-- Coins tab decorative background -- sits behind card grid, fixed (not scrollable)
	coinsBgArt = Instance.new("ImageLabel")
	coinsBgArt.Name = "BackgroundArt"
	coinsBgArt.AnchorPoint = Vector2.new(0, 0)
	coinsBgArt.Position = content.Position
	coinsBgArt.Size = content.Size
	coinsBgArt.BackgroundTransparency = 1
	coinsBgArt.Image = "rbxassetid://92371827400252"
	coinsBgArt.ImageTransparency = 0.55
	coinsBgArt.ScaleType = Enum.ScaleType.Crop  -- cover-fill, no distortion
	coinsBgArt.ZIndex = 4                   -- below contentFrame (ZIndex 5)
	coinsBgArt.Visible = true               -- Coins is the default tab
	coinsBgArt.Parent = canvas

	-- Crowns tab animated background (cross-fading crown images)
	-- Created once here; startCrownBgAnim/stopCrownBgAnim drive the tweens.
	if #_crownBgImages &gt; 0 then
		local cbf = Instance.new("Frame")
		cbf.Name                  = "CrownBackground"
		cbf.AnchorPoint           = Vector2.new(0, 0)
		cbf.Position              = UDim2.fromScale(0, 0)   -- full canvas
		cbf.Size                  = UDim2.fromScale(1, 1)   -- full canvas
		cbf.BackgroundColor3      = Color3.fromRGB(5, 3, 18)  -- very dark purple-black
		cbf.BackgroundTransparency = 0.35                   -- 65% opaque dark tint
		cbf.BorderSizePixel       = 0
		cbf.ClipsDescendants      = true
		cbf.ZIndex                = 4      -- behind contentFrame (ZIndex 5)
		cbf.Active                = false
		cbf.Selectable            = false
		cbf.Visible               = false
		cbf.Parent                = canvas
		crownBgFrame              = cbf
		_crownSlots               = {}

		for i = 1, 3 do
			local lbl              = Instance.new("ImageLabel")
			lbl.Name               = "CrownSlot" .. i
			lbl.AnchorPoint        = Vector2.new(0.5, 0.5)
			lbl.Position           = UDim2.fromScale(0.5, 0.5)
			lbl.Size               = UDim2.fromScale(0.55, 0.88)
			lbl.BackgroundTransparency = 1
			lbl.Image              = ""
			lbl.ScaleType          = Enum.ScaleType.Fit
			lbl.ImageTransparency  = 1
			lbl.ZIndex             = 4
			lbl.Active             = false
			lbl.Selectable         = false
			lbl.Parent             = cbf
			table.insert(_crownSlots, lbl)
		end
	end

	-- Pets tab background (matches Crowns panel styling)
	do
		local pbf = Instance.new("Frame")
		pbf.Name                  = "PetsBackground"
		pbf.AnchorPoint           = Vector2.new(0, 0)
		pbf.Position              = UDim2.fromScale(0, 0)
		pbf.Size                  = UDim2.fromScale(1, 1)
		pbf.BackgroundColor3      = Color3.fromRGB(5, 3, 18)
		pbf.BackgroundTransparency = 0.35
		pbf.BorderSizePixel       = 0
		pbf.ZIndex                = 4
		pbf.Active                = false
		pbf.Selectable            = false
		pbf.Visible               = false
		pbf.Parent                = canvas
		petsBgFrame               = pbf

		-- Pets tab slideshow root (behind content, non-interactive)
		local slideRoot = Instance.new("Frame")
		slideRoot.Name = "PetsBackgroundSlideshow"
		slideRoot.Size = UDim2.fromScale(1, 1)
		slideRoot.Position = UDim2.fromScale(0, 0)
		slideRoot.BackgroundTransparency = 1
		slideRoot.BorderSizePixel = 0
		slideRoot.ZIndex = 4
		slideRoot.Active = false
		slideRoot.Selectable = false
		slideRoot.ClipsDescendants = true
		slideRoot.Parent = pbf
		_petsBgSlidesRoot = slideRoot
		_petsBgSlots = {}

		for i = 1, 3 do
			local lbl = Instance.new("ImageLabel")
			lbl.Name = "PetsBgSlot" .. i
			lbl.AnchorPoint = Vector2.new(0.5, 0.5)
			lbl.Position = UDim2.fromScale(0.5, 0.5)
			lbl.Size = UDim2.fromScale(1, 1)
			lbl.BackgroundTransparency = 1
			lbl.Image = ""
			lbl.ScaleType = Enum.ScaleType.Crop
			lbl.ImageTransparency = 1
			lbl.ZIndex = 4
			lbl.Active = false
			lbl.Selectable = false
			lbl.Parent = slideRoot
			table.insert(_petsBgSlots, lbl)
		end

		local shade = Instance.new("Frame")
		shade.Name = "PetsBackgroundShade"
		shade.Size = UDim2.fromScale(1, 1)
		shade.Position = UDim2.fromScale(0, 0)
		shade.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
		shade.BackgroundTransparency = 0.72
		shade.BorderSizePixel = 0
		shade.ZIndex = 4
		shade.Active = false
		shade.Selectable = false
		shade.Parent = slideRoot
	end

	_setActiveTab = setActiveTab

	Components.AddGridLayout(contentFrame)
	setActiveTab(1)
	startCoinsBgAnim()
	populateCards(CATEGORIES[1].filter)
end

function ShopPanel.ActivateBundleTab(bundleId: string?)
	local BUNDLE_TAB = 4
	activeTab = BUNDLE_TAB
	if _setActiveTab then _setActiveTab(BUNDLE_TAB) end
	-- Prompt-open path can bypass tab callback; force-clear stale tab backgrounds.
	setCoinsBgVisible(false)
	setCrownBgVisible(false)
	setPetsBgVisible(false)
	print("[BundlePanel] source=GameBun coinBgHidden=true")
	clearCards()
	if _BundlePanel and _BundlePanel.ClearContent then
		_BundlePanel.ClearContent()
	end
	if _BundlePanel and _BundlePanel.PopulateInto then
		_BundlePanel.PopulateInto(contentFrame)
	end
	if bundleId and _BundlePanel and _BundlePanel.SelectBundle then
		_BundlePanel.SelectBundle(bundleId)
	end
	print("[BundlePanel] openStateClean=true")
end

function ShopPanel.Show()
	if visible then return end
	if LocalPlayer:GetAttribute("PlayerState") == "InMatch" then
		print("[ShopPanel] Blocked Show while InMatch")
		return
	end
	visible = true
	overlay.Visible = true
	SoundUtil.Open()
	AnimUtil.OpenPanel(canvas, uiScale)
	-- Restart crown bg animation if Crowns tab is currently active
	if CATEGORIES[activeTab] and CATEGORIES[activeTab].filter == "ExclusiveCrown" then
		setCrownBgVisible(true)
	end
end

function ShopPanel.Hide()
	if not visible then return end
	visible = false
	overlay.Visible = false
	stopCoinsBgAnim()
	stopCrownBgAnim()
	setPetsBgVisible(false)
	local t = AnimUtil.ClosePanel(canvas, uiScale)
	task.spawn(function()
		t.Completed:Wait()
		canvas.Visible = false
	end)
	if closeCallback then closeCallback() end
end

-- Refresh cards after a gamepass purchase completes
MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(a, b, c)
	local gamepassId: number? = nil
	local wasPurchased: boolean? = nil
	if typeof(a) == "Instance" and a:IsA("Player") then
		gamepassId = tonumber(b)
		wasPurchased = (c == true)
	else
		gamepassId = tonumber(a)
		wasPurchased = (b == true)
	end
	print(string.format("[GamePassClient] finished gamepassId=%s purchased=%s",
		tostring(gamepassId), tostring(wasPurchased)))
	if wasPurchased then
		task.wait(0.5)
		local verifyRF = ReplicatedStorage:FindFirstChild("Remotes")
			and ReplicatedStorage.Remotes:FindFirstChild("VerifyGamepassPurchase")
		if verifyRF and gamepassId and gamepassId &gt; 0 then
			pcall(function() verifyRF:InvokeServer(gamepassId) end)
		end
		if visible and activeTab and CATEGORIES[activeTab] and CATEGORIES[activeTab].filter ~= "Bundle" then
			populateCards(CATEGORIES[activeTab].filter)
		end
	end
end)

MarketplaceService.PromptProductPurchaseFinished:Connect(function(_userId, _productId, wasPurchased)
	if wasPurchased and visible then
		task.wait(1)
		if activeTab and CATEGORIES[activeTab] and CATEGORIES[activeTab].filter == "Currency" then
			populateCards("Currency")
		end
	end
end)

function ShopPanel.IsVisible(): boolean
	return visible
end

function ShopPanel.Toggle()
	if visible then ShopPanel.Hide() else ShopPanel.Show() end
end

return ShopPanel</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="129">
            <Properties>
              <string name="Name">SoundUtil</string>
              <string name="Source"><![CDATA[--[[
	SoundUtil
	Manages all UI sound effects.  Creates Sound objects once at Init,
	then exposes one-liner Play functions.

	Gracefully skips sounds that fail to load.
	Clone-plays to avoid overlapping cancellation.

	Used by: Components, HUDPanel, ShopPanel, FateCrownsPanel,
	         PetsPanel, CrateShopPanel, IndexPanel, UIController
]]

local SoundService = game:GetService("SoundService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local UIConfig = require(Shared:WaitForChild("UIConfig"))

local sounds: { [string]: Sound } = {}
local initialized = false

local SoundUtil = {}

-- ───────────────────────────────────────────────
-- INIT
-- ───────────────────────────────────────────────

function SoundUtil.Init()
	if initialized then return end
	initialized = true

	local folder = Instance.new("Folder")
	folder.Name = "UISounds"
	folder.Parent = SoundService

	for key, data in pairs(UIConfig.Sounds) do
		local s = Instance.new("Sound")
		s.Name = "UI_" .. key
		s.SoundId = data.Id
		s.Volume = data.Volume or 0.25
		s.PlaybackSpeed = data.Speed or 1
		s.RollOffMode = Enum.RollOffMode.InverseTapered
		s.Parent = folder
		sounds[key] = s
	end
end

-- ───────────────────────────────────────────────
-- PLAY HELPERS
-- ───────────────────────────────────────────────

local function play(key: string)
	local s = sounds[key]
	if s then
		local clone = s:Clone()
		clone.Parent = s.Parent
		clone:Play()
		clone.Ended:Once(function()
			clone:Destroy()
		end)
		task.delay(3, function()
			if clone and clone.Parent then
				clone:Destroy()
			end
		end)
	end
end

function SoundUtil.Hover()       play("Hover") end
function SoundUtil.Click()       play("Click") end
function SoundUtil.Open()        play("Open") end
function SoundUtil.Close()       play("Close") end
function SoundUtil.CoinCollect() play("CoinCollect") end
function SoundUtil.Equip()       play("Equip") end

return SoundUtil
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="130">
            <Properties>
              <string name="Name">SpectatePanel</string>
              <string name="Source"><![CDATA[--[[
	SpectatePanel
	Spectate other players — select targets from a list or cycle with Next/Prev.

	• Only lists players with PlayerState == "InMatch" AND alive Humanoid
	• Auto-switches to next valid target when current dies / leaves match
	• Refreshes live on player state changes, joins, leaves, and deaths
	• Next / Prev / Stop buttons
	• Smooth open/close animation (matches other panels)
	• "No players to spectate" message when empty

	Close (X) = hide UI only, keep spectating.
	Stop      = revert camera + hide UI.

	Used by: UIController (sidebar "Spectate" button)
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local UIConfig = require(Shared:WaitForChild("UIConfig"))

local Client = script.Parent
local AnimUtil   = require(Client:WaitForChild("AnimUtil"))
local SoundUtil  = require(Client:WaitForChild("SoundUtil"))
local Components = require(Client:WaitForChild("Components"))

local C = UIConfig.Colors
local S = UIConfig.Sizes
local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

-- ─── STATE ───────────────────────────────────────────────────────────────────

local canvas: CanvasGroup = nil
local uiScale: UIScale = nil
local overlay: Frame = nil
local contentFrame: ScrollingFrame = nil
local visible = false
local closeCallback: (() -> ())? = nil

local spectateTargets: { Player } = {}
local currentTargetIndex: number = 0
local currentTargetPlayer: Player? = nil
local originalCameraSubject = nil

local noPlayersLabel: TextLabel = nil
local playerConns: { [Player]: { RBXScriptConnection } } = {}

local SpectatePanel = {}

-- ─── LOGGING ─────────────────────────────────────────────────────────────────

local function log(msg: string)
	print("[Spectate]", msg)
end

-- ─── ELIGIBILITY ─────────────────────────────────────────────────────────────

local function isSpectatable(player: Player): boolean
	if player == LocalPlayer then return false end
	if player:GetAttribute("PlayerState") ~= "InMatch" then return false end
	local char = player.Character
	if not char then return false end
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 then return false end
	return true
end

local function getSpectatablePlayers(): { Player }
	local result = {}
	for _, player in ipairs(Players:GetPlayers()) do
		if isSpectatable(player) then
			table.insert(result, player)
		end
	end
	return result
end

-- ─── CAMERA CONTROL ──────────────────────────────────────────────────────────

local function attachCamera(player: Player?)
	if not player then
		-- Revert to own character
		if originalCameraSubject then
			Camera.CameraSubject = originalCameraSubject
		else
			local myHum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
			if myHum then Camera.CameraSubject = myHum end
		end
		currentTargetIndex = 0
		currentTargetPlayer = nil
		originalCameraSubject = nil
		return
	end

	local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if hum then
		Camera.CameraSubject = hum
	end
	currentTargetPlayer = player
end

local function selectTarget(index: number)
	if #spectateTargets == 0 then
		attachCamera(nil)
		return
	end
	index = ((index - 1) % #spectateTargets) + 1
	currentTargetIndex = index
	attachCamera(spectateTargets[index])
end

-- ─── AUTO-SWITCH ─────────────────────────────────────────────────────────────

local function validateCurrentTarget()
	if not currentTargetPlayer then return end
	if isSpectatable(currentTargetPlayer) then return end

	-- Current target is no longer valid — auto-switch
	local candidates = getSpectatablePlayers()
	spectateTargets = candidates

	if #candidates > 0 then
		currentTargetIndex = 1
		attachCamera(candidates[1])
		log("Auto-switch → " .. candidates[1].Name)
	else
		attachCamera(nil)
		log("No valid targets → stopped")
	end
end

-- ─── UI BUILD ────────────────────────────────────────────────────────────────

local function clearContent()
	for _, child in ipairs(contentFrame:GetChildren()) do
		if child:IsA("Frame") or child:IsA("TextButton") then child:Destroy() end
	end
end

local function refresh()
	clearContent()
	spectateTargets = getSpectatablePlayers()

	-- Re-sync index to the actual player we're spectating
	if currentTargetPlayer then
		currentTargetIndex = 0
		for i, p in ipairs(spectateTargets) do
			if p == currentTargetPlayer then
				currentTargetIndex = i
				break
			end
		end
		if currentTargetIndex == 0 then
			currentTargetPlayer = nil
		end
	end

	if #spectateTargets == 0 then
		if noPlayersLabel then noPlayersLabel.Visible = true end
		return
	end
	if noPlayersLabel then noPlayersLabel.Visible = false end

	for i, player in ipairs(spectateTargets) do
		local isSelected = (currentTargetIndex == i)

		local btn = Instance.new("TextButton")
		btn.Name = "Target_" .. player.Name
		btn.Size = UDim2.new(1, -20, 0, 48)
		btn.BackgroundColor3 = isSelected and C.EquipButton or C.CardBg
		btn.BorderSizePixel = 0
		btn.AutoButtonColor = false
		btn.Font = Enum.Font.GothamBold
		btn.TextColor3 = isSelected and C.TextWhite or C.TextLight
		btn.TextSize = 18
		btn.Text = player.DisplayName
		btn.TextXAlignment = Enum.TextXAlignment.Left
		btn.LayoutOrder = i
		btn.Parent = contentFrame

		local co = Instance.new("UICorner")
		co.CornerRadius = UDim.new(0, S.BtnCorner)
		co.Parent = btn

		local st = Instance.new("UIStroke")
		st.Color = isSelected and C.Blue or C.CardStroke
		st.Thickness = S.PanelStroke
		st.Transparency = isSelected and 0.15 or 0.35
		st.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		st.Parent = btn

		-- Text stroke
		local ts = Instance.new("UIStroke")
		ts.Color = Color3.fromRGB(0, 0, 0)
		ts.Thickness = 1.5
		ts.Transparency = 0.22
		ts.Parent = btn

		AnimUtil.WireButton(btn, function()
			SoundUtil.Click()
			if not originalCameraSubject then
				originalCameraSubject = Camera.CameraSubject
			end
			selectTarget(i)
			if currentTargetPlayer then
				log("Spectating " .. currentTargetPlayer.DisplayName)
			end
			refresh()
		end)
	end
end

-- ─── DEBOUNCED LIVE REFRESH ──────────────────────────────────────────────────

local refreshQueued = false

local function queueRefresh()
	validateCurrentTarget()
	if refreshQueued then return end
	refreshQueued = true
	task.defer(function()
		refreshQueued = false
		if visible and contentFrame then
			refresh()
		end
	end)
end

-- ─── PLAYER EVENT WIRING ────────────────────────────────────────────────────

local function unwirePlayer(player: Player)
	local conns = playerConns[player]
	if conns then
		for _, c in ipairs(conns) do c:Disconnect() end
		playerConns[player] = nil
	end
end

local function wirePlayer(player: Player)
	if player == LocalPlayer then return end
	unwirePlayer(player)

	local conns = {}

	-- PlayerState attribute change (InMatch ↔ Lobby, etc.)
	table.insert(conns, player:GetAttributeChangedSignal("PlayerState"):Connect(queueRefresh))

	-- Character lifecycle → refresh + wire Humanoid.Died
	table.insert(conns, player.CharacterAdded:Connect(function(char)
		local hum = char:WaitForChild("Humanoid", 5)
		if hum then
			hum.Died:Connect(queueRefresh)
		end
		queueRefresh()
	end))

	table.insert(conns, player.CharacterRemoving:Connect(queueRefresh))

	-- Wire existing character's humanoid if already spawned
	if player.Character then
		local hum = player.Character:FindFirstChildOfClass("Humanoid")
		if hum then
			table.insert(conns, hum.Died:Connect(queueRefresh))
		end
	end

	playerConns[player] = conns
end

-- ─── INIT ────────────────────────────────────────────────────────────────────

function SpectatePanel.Init(screenGui: ScreenGui, onClose: () -> ())
	closeCallback = onClose

	overlay = Components.CreateDimOverlay(screenGui, function()
		SpectatePanel.Hide()
	end)

	local content, closeBtn
	canvas, uiScale, content, closeBtn = Components.CreatePanel(screenGui, "SPECTATE", C.HeaderSpectate, "Spectate")
	contentFrame = content

	-- List layout for player entries
	local list = Instance.new("UIListLayout")
	list.SortOrder = Enum.SortOrder.LayoutOrder
	list.Padding = UDim.new(0, 8)
	list.FillDirection = Enum.FillDirection.Vertical
	list.HorizontalAlignment = Enum.HorizontalAlignment.Center
	list.Parent = contentFrame

	local pad = Instance.new("UIPadding")
	pad.PaddingTop = UDim.new(0, 10)
	pad.PaddingBottom = UDim.new(0, 80)
	pad.PaddingLeft = UDim.new(0, 10)
	pad.PaddingRight = UDim.new(0, 10)
	pad.Parent = contentFrame

	-- "No players" label
	noPlayersLabel = Instance.new("TextLabel")
	noPlayersLabel.Name = "NoPlayers"
	noPlayersLabel.Size = UDim2.new(1, 0, 0, 60)
	noPlayersLabel.BackgroundTransparency = 1
	noPlayersLabel.Font = Enum.Font.GothamBold
	noPlayersLabel.TextColor3 = C.TextMuted
	noPlayersLabel.TextSize = 20
	noPlayersLabel.Text = "No players to spectate"
	noPlayersLabel.Visible = false
	noPlayersLabel.Parent = canvas
	noPlayersLabel.AnchorPoint = Vector2.new(0.5, 0.5)
	noPlayersLabel.Position = UDim2.fromScale(0.5, 0.5)

	-- Bottom bar with Next / Prev / Stop
	local bottomBar = Instance.new("Frame")
	bottomBar.Name = "BottomBar"
	bottomBar.AnchorPoint = Vector2.new(0.5, 1)
	bottomBar.Position = UDim2.new(0.5, 0, 1, -12)
	bottomBar.Size = UDim2.new(1, -24, 0, 52)
	bottomBar.BackgroundColor3 = C.PanelBg
	bottomBar.BackgroundTransparency = 0.3
	bottomBar.BorderSizePixel = 0
	bottomBar.ZIndex = 5
	bottomBar.Parent = canvas

	local bbCorner = Instance.new("UICorner")
	bbCorner.CornerRadius = UDim.new(0, S.BtnCorner)
	bbCorner.Parent = bottomBar

	local bbStroke = Instance.new("UIStroke")
	bbStroke.Color = C.CardStroke
	bbStroke.Thickness = S.PanelStroke
	bbStroke.Transparency = 0.4
	bbStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	bbStroke.Parent = bottomBar

	local bbLayout = Instance.new("UIListLayout")
	bbLayout.SortOrder = Enum.SortOrder.LayoutOrder
	bbLayout.FillDirection = Enum.FillDirection.Horizontal
	bbLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	bbLayout.VerticalAlignment = Enum.VerticalAlignment.Center
	bbLayout.Padding = UDim.new(0, 12)
	bbLayout.Parent = bottomBar

	local function makeBottomBtn(text: string, color: Color3, order: number, onClick: () -> ())
		local b = Instance.new("TextButton")
		b.Name = text
		b.Size = UDim2.fromOffset(110, 38)
		b.BackgroundColor3 = color
		b.BorderSizePixel = 0
		b.AutoButtonColor = false
		b.Font = Enum.Font.GothamBold
		b.TextColor3 = C.TextWhite
		b.TextSize = 16
		b.Text = text
		b.LayoutOrder = order
		b.ZIndex = 6
		b.Parent = bottomBar

		local bco = Instance.new("UICorner")
		bco.CornerRadius = UDim.new(0, S.BtnCorner)
		bco.Parent = b

		local bst = Instance.new("UIStroke")
		bst.Color = Color3.fromRGB(255, 255, 255)
		bst.Thickness = S.PanelStroke
		bst.Transparency = 0.4
		bst.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		bst.Parent = b

		-- Text stroke
		local bts = Instance.new("UIStroke")
		bts.Color = Color3.fromRGB(0, 0, 0)
		bts.Thickness = 1.5
		bts.Transparency = 0.2
		bts.Parent = b

		AnimUtil.WireButton(b, function()
			SoundUtil.Click()
			onClick()
		end)
		return b
	end

	makeBottomBtn("PREV", C.Blue, 1, function()
		if not originalCameraSubject then
			originalCameraSubject = Camera.CameraSubject
		end
		selectTarget(currentTargetIndex - 1)
		if currentTargetPlayer then
			log("Prev → " .. currentTargetPlayer.DisplayName)
		end
		refresh()
	end)

	makeBottomBtn("NEXT", C.Blue, 2, function()
		if not originalCameraSubject then
			originalCameraSubject = Camera.CameraSubject
		end
		selectTarget(currentTargetIndex + 1)
		if currentTargetPlayer then
			log("Next → " .. currentTargetPlayer.DisplayName)
		end
		refresh()
	end)

	makeBottomBtn("STOP", C.Red, 3, function()
		if currentTargetPlayer then
			log("Stopped spectating")
		end
		attachCamera(nil)
		SpectatePanel.Hide()
	end)

	-- X button → hide UI only (do NOT stop spectating)
	AnimUtil.WireButton(closeBtn, function()
		SoundUtil.Close()
		SpectatePanel.Hide()
	end)

	-- ── Wire live-update events for all current and future players ──
	for _, player in ipairs(Players:GetPlayers()) do
		wirePlayer(player)
	end
	Players.PlayerAdded:Connect(function(player)
		wirePlayer(player)
	end)
	Players.PlayerRemoving:Connect(function(player)
		unwirePlayer(player)
		queueRefresh()
	end)

	log("Initialized")
end

-- ─── SHOW / HIDE / TOGGLE ───────────────────────────────────────────────────

function SpectatePanel.Show()
	if visible then return end
	if LocalPlayer:GetAttribute("PlayerState") == "InMatch" then
		log("Blocked Show while InMatch")
		return
	end
	visible = true
	overlay.Visible = true
	refresh()
	SoundUtil.Open()
	AnimUtil.OpenPanel(canvas, uiScale)
end

function SpectatePanel.Hide()
	if not visible then return end
	visible = false
	overlay.Visible = false
	-- NOTE: Closing the panel only hides the UI; spectating continues.
	-- The Stop button is the only way to revert the camera.
	local t = AnimUtil.ClosePanel(canvas, uiScale)
	task.spawn(function()
		t.Completed:Wait()
		canvas.Visible = false
	end)
	if closeCallback then closeCallback() end
end

function SpectatePanel.IsVisible(): boolean
	return visible
end

function SpectatePanel.Toggle()
	if visible then SpectatePanel.Hide() else SpectatePanel.Show() end
end

return SpectatePanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="131">
            <Properties>
              <string name="Name">SpinWheelPanel</string>
              <string name="Source"><![CDATA[--[[
	SpinWheelPanel (Wrapper for imported SpinWheelGuiScripts)

	Controls the imported SpinWheel UI:
	  • Opens/closes the SpinWheel frame inside SpinWheelGuiScripts
	  • Handles blur, FOV, and background effects
	  • Wires close button (creates one if none exists)
	  • Hides orphaned navigation Buttons (from disabled AnimateFrames)
	  • Toggles ScreenGui.Enabled so nothing leaks when closed

	The actual spin logic is in SpinWheelGui/SpinWheelScript (client)
	and SpinWheelService (server).

	Used by: UIController (walk-up near SpinTheWheel + Press E)
]]

local TweenService = game:GetService("TweenService")
local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local UserInputService = game:GetService("UserInputService")

local SpinWheelPanel = {}

local visible = false
local closeCallback = nil

local spinFrame = nil
local bgEffect = nil
local bgEffectRainbow = nil
local spinGui = nil
local buttonsFrame = nil

local function log(...)
	print("[SpinWheelPanel]", ...)
end

----------------------------------------------------------------------------
-- CLOSE BUTTON FACTORY
-- Creates a small "✕" close button in the top-right of the spin frame
-- so the player has a clear way to exit besides ESC / walking away.
----------------------------------------------------------------------------
local function createCloseButton(parent)
	local btn = Instance.new("TextButton")
	btn.Name = "SpinWheelCloseBtn"
	btn.Text = "X"
	btn.Font = Enum.Font.GothamBold
	btn.TextSize = 26
	btn.TextColor3 = Color3.fromRGB(255, 255, 255)
	btn.TextStrokeTransparency = 0.2
	btn.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
	btn.BackgroundColor3 = Color3.fromRGB(200, 50, 60)
	btn.BackgroundTransparency = 0.05
	btn.Size = UDim2.fromOffset(44, 44)
	btn.Position = UDim2.new(1, -56, 0, 16)
	btn.AnchorPoint = Vector2.new(0.5, 0.5)
	btn.ZIndex = 100
	btn.AutoButtonColor = false
	btn.Parent = parent

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(1, 0)
	corner.Parent = btn

	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(255, 255, 255)
	stroke.Thickness = 2
	stroke.Transparency = 0.35
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent = btn

	local baseColor = btn.BackgroundColor3
	local hoverColor = Color3.fromRGB(240, 70, 80)
	local pressColor = Color3.fromRGB(160, 35, 45)

	btn.MouseEnter:Connect(function()
		TweenService:Create(btn, TweenInfo.new(0.15, Enum.EasingStyle.Quad), {
			BackgroundColor3 = hoverColor,
			Size = UDim2.fromOffset(48, 48),
		}):Play()
	end)
	btn.MouseLeave:Connect(function()
		TweenService:Create(btn, TweenInfo.new(0.15, Enum.EasingStyle.Quad), {
			BackgroundColor3 = baseColor,
			Size = UDim2.fromOffset(44, 44),
		}):Play()
	end)
	btn.MouseButton1Down:Connect(function()
		TweenService:Create(btn, TweenInfo.new(0.08, Enum.EasingStyle.Quad), {
			BackgroundColor3 = pressColor,
			Size = UDim2.fromOffset(40, 40),
		}):Play()
	end)
	btn.MouseButton1Up:Connect(function()
		TweenService:Create(btn, TweenInfo.new(0.12, Enum.EasingStyle.Quad), {
			BackgroundColor3 = hoverColor,
			Size = UDim2.fromOffset(48, 48),
		}):Play()
	end)

	return btn
end

----------------------------------------------------------------------------
-- HIDE/SHOW OVERLAPPING HUD ELEMENTS (Stats, Daily, Vote)
----------------------------------------------------------------------------
local function setOverlayUIVisible(show: boolean)
	local playerGui = Players.LocalPlayer:FindFirstChild("PlayerGui")
	if not playerGui then return end

	local hudGui = playerGui:FindFirstChild("HUDGui")
	if hudGui then
		local statsBtn = hudGui:FindFirstChild("StatsBtn")
		if statsBtn then statsBtn.Visible = show end
		local dailyBtn = hudGui:FindFirstChild("DailyBtn")
		if dailyBtn then dailyBtn.Visible = show end
		local questsBtn = hudGui:FindFirstChild("QuestsBtn")
		if questsBtn then questsBtn.Visible = show end
	end

	local modeVoteGui = playerGui:FindFirstChild("ModeVoteGui")
	if modeVoteGui then
		modeVoteGui.Enabled = show
	end
end

----------------------------------------------------------------------------
-- MOBILE: Wrap BuySpinsPanel content in a ScrollingFrame
----------------------------------------------------------------------------
local function applyMobileBuyScroll()
	if not UserInputService.TouchEnabled then return end
	local vp = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize
	if not vp or math.min(vp.X, vp.Y) >= 600 then return end
	if not spinFrame then return end

	local buyPanel = spinFrame:FindFirstChild("BuySpinsPanel", true)
	if not buyPanel then return end
	if buyPanel:FindFirstChild("MobileScroll") then return end

	local SCROLL_TOP = 96

	local scroll = Instance.new("ScrollingFrame")
	scroll.Name = "MobileScroll"
	scroll.Position = UDim2.new(0, 0, 0, SCROLL_TOP)
	scroll.Size = UDim2.new(1, 0, 1, -SCROLL_TOP - 28)
	scroll.BackgroundTransparency = 1
	scroll.BorderSizePixel = 0
	scroll.ScrollBarThickness = 4
	scroll.ScrollBarImageColor3 = Color3.fromRGB(100, 110, 150)
	scroll.ZIndex = 21
	scroll.CanvasSize = UDim2.fromOffset(0, 0)
	scroll.Parent = buyPanel

	local toMove = {}
	for _, child in ipairs(buyPanel:GetChildren()) do
		if child:IsA("GuiObject") and child ~= scroll and child.Name ~= "ErrorLabel" then
			if child.Position.Y.Offset >= SCROLL_TOP then
				table.insert(toMove, child)
			end
		end
	end

	local maxBottom = 0
	for _, child in ipairs(toMove) do
		local newY = child.Position.Y.Offset - SCROLL_TOP
		child.Position = UDim2.new(child.Position.X.Scale, child.Position.X.Offset, 0, newY)
		child.Parent = scroll
		local bottom = newY + child.Size.Y.Offset
		if bottom > maxBottom then maxBottom = bottom end
	end

	scroll.CanvasSize = UDim2.fromOffset(0, maxBottom + 12)
	log("Mobile BuySpinsPanel scroll applied (canvas=" .. tostring(maxBottom + 12) .. ")")
end

----------------------------------------------------------------------------
-- INIT
----------------------------------------------------------------------------
function SpinWheelPanel.Init(screenGui, onClose)
	log("Initializing SpinWheelPanel (imported wheel wrapper)...")
	closeCallback = onClose

	-- Find the imported SpinWheel frame inside SpinWheelGuiScripts
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
	spinGui = playerGui:WaitForChild("SpinWheelGuiScripts", 15)
	if not spinGui then
		warn("[SpinWheelPanel] SpinWheelGuiScripts not found in PlayerGui!")
		return
	end

	local handler = spinGui:WaitForChild("Handler", 10)
	if not handler then
		warn("[SpinWheelPanel] Handler not found in SpinWheelGuiScripts!")
		return
	end

	local framesFolder = handler:WaitForChild("Frames", 10)
	if not framesFolder then
		warn("[SpinWheelPanel] Frames not found in Handler!")
		return
	end

	spinFrame = framesFolder:WaitForChild("SpinWheel", 10)
	if not spinFrame then
		warn("[SpinWheelPanel] SpinWheel frame not found!")
		return
	end

	-- Get background effects
	bgEffect = handler:FindFirstChild("BackgroundEffects")
	bgEffectRainbow = handler:FindFirstChild("RainbowBackgroundEffect")

	-- ── MAKE ORPHANED BUTTONS INVISIBLE (preserve layout) ────────────
	-- The original AnimateFrames (disabled) used these for navigation.
	-- Their TextButtons have ZIndex=999999999 and Active=true, which
	-- intercepts mouse clicks on the left side of the screen.
	-- Instead of Visible=false (which removes from layout and causes
	-- UI shifting during animations), make all visual elements transparent
	-- and disable input while keeping the frames present for layout math.
	buttonsFrame = handler:FindFirstChild("Buttons", true)
	if buttonsFrame then
		-- Make the Buttons frame itself a passive layout placeholder
		buttonsFrame.BackgroundTransparency = 1
		buttonsFrame.Active = false

		for _, desc in ipairs(buttonsFrame:GetDescendants()) do
			if desc:IsA("TextButton") or desc:IsA("ImageButton") then
				desc.BackgroundTransparency = 1
				desc.Active = false
				desc.Selectable = false
				if desc:IsA("TextButton") then
					desc.TextTransparency = 1
				end
			elseif desc:IsA("ImageLabel") then
				desc.ImageTransparency = 1
				desc.BackgroundTransparency = 1
			elseif desc:IsA("TextLabel") then
				desc.TextTransparency = 1
				desc.BackgroundTransparency = 1
			elseif desc:IsA("Frame") then
				desc.BackgroundTransparency = 1
				desc.Active = false
				desc.Selectable = false
			end
			-- Make any UIStroke fully transparent
			if desc:IsA("UIStroke") then
				desc.Transparency = 1
			end
			for _, child in ipairs(desc:GetChildren()) do
				if child:IsA("UIStroke") then
					child.Transparency = 1
				end
			end
		end
		log("Made orphaned Buttons invisible (layout preserved, no click interception)")
	end

	-- Ensure spin frame starts hidden
	spinFrame.Visible = false

	-- ── DISABLE SCREENGUI WHEN NOT IN USE ──────────────────────────────
	-- Prevents any of the imported UI from rendering or intercepting input
	spinGui.Enabled = false
	log("Disabled ScreenGui (will enable on Show)")

	-- ── WIRE / CREATE CLOSE BUTTON ─────────────────────────────────────
	local foundClose = false
	for _, desc in ipairs(spinFrame:GetDescendants()) do
		if (desc:IsA("TextButton") or desc:IsA("ImageButton")) and desc.Name:match("[Cc]lose") then
			desc.MouseButton1Click:Connect(function()
				SpinWheelPanel.Hide()
			end)
			foundClose = true
			log("Wired existing close button:", desc:GetFullName())
		end
	end

	if not foundClose then
		-- No close button found → create one
		local closeBtn = createCloseButton(spinFrame)
		closeBtn.MouseButton1Click:Connect(function()
			SpinWheelPanel.Hide()
		end)
		log("Created close button (none found in imported UI)")
	end

	log("Initialized ✓ (imported wheel at: " .. spinFrame:GetFullName() .. ")")
end

----------------------------------------------------------------------------
-- SHOW
----------------------------------------------------------------------------
function SpinWheelPanel.Show()
	if visible or not spinFrame then return end
	visible = true

	-- Enable ScreenGui so it renders
	if spinGui then
		spinGui.Enabled = true
	end

	-- Make frame visible with open animation (matches imported AnimateFrames style)
	spinFrame.Visible = true
	spinFrame.Size = UDim2.new(0.8, 0, 0.8, 0)
	spinFrame.Position = UDim2.new(0.5, 0, 0.7, 0)

	spinFrame:TweenSize(UDim2.new(1, 0, 1, 0), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.4, true)
	spinFrame:TweenPosition(UDim2.new(0.5, 0, 0.5, 0), Enum.EasingDirection.Out, Enum.EasingStyle.Back, 0.5, true)

	-- ── Force full ancestor chain visible (fixes DailyTimerLabel hidden by parent) ──
	-- Walk up from spinFrame ensuring every GuiObject ancestor is Visible=true.
	task.defer(function()
		local current: Instance? = spinFrame
		while current do
			if current:IsA("GuiObject") then
				if not current.Visible then
					log("Force-showing hidden ancestor:", current.Name, current.ClassName)
					current.Visible = true
				end
			end
			current = current.Parent
		end

		-- Also ensure BuySpinsPanel (common timer host) is visible
		local buyPanel = spinFrame:FindFirstChild("BuySpinsPanel", true)
		if buyPanel and buyPanel:IsA("GuiObject") and not buyPanel.Visible then
			buyPanel.Visible = true
			log("Force-showed BuySpinsPanel")
		end

		-- Debug: log DailyTimerLabel state if it exists
		local timerLbl = spinFrame:FindFirstChild("DailyTimerLabel", true)
			or spinFrame:FindFirstChild("Timer", true)
		if timerLbl then
			log(string.format("Timer label found: %s Visible=%s Text='%s' AbsPos=(%.0f,%.0f) AbsSize=(%.0f,%.0f)",
				timerLbl:GetFullName(),
				tostring(timerLbl.Visible),
				tostring((timerLbl :: any).Text or "?"),
				timerLbl.AbsolutePosition.X, timerLbl.AbsolutePosition.Y,
				timerLbl.AbsoluteSize.X, timerLbl.AbsoluteSize.Y))

			-- Walk parent chain and log visibility
			local p: Instance? = timerLbl.Parent
			while p and p ~= spinGui do
				if p:IsA("GuiObject") then
					if not p.Visible then
						log("  HIDDEN ancestor:", p.Name, p.ClassName)
						p.Visible = true
						log("  -> forced Visible=true")
					end
				end
				p = p.Parent
			end
		end
	end)

	task.defer(applyMobileBuyScroll)

	-- Background effects
	if bgEffect and bgEffect:IsA("CanvasGroup") then
		bgEffect.GroupTransparency = 1
		TweenService:Create(bgEffect, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {GroupTransparency = 0.2}):Play()
	end

	-- Blur
	local blur = Lighting:FindFirstChild("Blur")
	if not blur then
		blur = Instance.new("BlurEffect")
		blur.Name = "Blur"
		blur.Size = 0
		blur.Parent = Lighting
	end
	TweenService:Create(blur, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = 16}):Play()

	-- FOV
	TweenService:Create(workspace.Camera, TweenInfo.new(0.2, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {FieldOfView = 92}):Play()

	setOverlayUIVisible(false)
	log("Opened")
end

----------------------------------------------------------------------------
-- HIDE
----------------------------------------------------------------------------
function SpinWheelPanel.Hide()
	if not visible or not spinFrame then return end
	visible = false

	-- Hide frame immediately
	spinFrame.Visible = false

	-- Reverse background effects
	if bgEffect and bgEffect:IsA("CanvasGroup") then
		TweenService:Create(bgEffect, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {GroupTransparency = 1}):Play()
	end

	-- Reverse blur
	local blur = Lighting:FindFirstChild("Blur")
	if blur then
		TweenService:Create(blur, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = 0}):Play()
	end

	-- Reverse FOV
	TweenService:Create(workspace.Camera, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {FieldOfView = 70}):Play()

	-- Disable ScreenGui after a short delay (allow fade-out tweens to finish)
	task.delay(0.5, function()
		if not visible and spinGui then
			spinGui.Enabled = false
		end
	end)

	setOverlayUIVisible(true)
	log("Closed")
	if closeCallback then closeCallback() end
end

----------------------------------------------------------------------------
-- UTILITY
----------------------------------------------------------------------------
function SpinWheelPanel.IsVisible()
	return visible
end

function SpinWheelPanel.Toggle()
	if visible then SpinWheelPanel.Hide() else SpinWheelPanel.Show() end
end

return SpinWheelPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="132">
            <Properties>
              <string name="Name">StatsPanel</string>
              <string name="Source"><![CDATA[--[[
	StatsPanel
	Player profile stats panel — shows lifetime stats in a clean vertical list.

	Stats displayed:
	  - Time Played (hh:mm:ss)
	  - Wins
	  - Crowns Obtained
	  - Coins Earned (lifetime)
	  - Pets Obtained
	  - Deaths

	All data comes from server-replicated player attributes.
	Refreshes every 0.5s while open (for live time-played ticking).

	API:
	  Init(screenGui, onClose)
	  Show() / Hide() / IsVisible() / Toggle()

	Used by: UIController (sidebar "Stats" button)
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local UIConfig = require(Shared:WaitForChild("UIConfig"))

local Client = script.Parent
local AnimUtil   = require(Client:WaitForChild("AnimUtil"))
local SoundUtil  = require(Client:WaitForChild("SoundUtil"))
local Components = require(Client:WaitForChild("Components"))

local C = UIConfig.Colors
local S = UIConfig.Sizes

local LocalPlayer = Players.LocalPlayer

local function isMobileTouchDevice(): boolean
	return UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
end

local canvas: CanvasGroup = nil
local uiScale: UIScale = nil
local overlay: Frame = nil
local visible = false
local closeCallback: (() -> ())? = nil

local _refreshConn = nil
local _valueLabels: { [string]: TextLabel } = {}

local StatsPanel = {}

-- ═══════════════════════════════════════════════════════════════════
-- THEME
-- ═══════════════════════════════════════════════════════════════════

local HEADER_COLOR  = C.HeaderStats or Color3.fromRGB(48, 210, 190)
local ROW_BG_DARK   = Color3.fromRGB(18, 24, 46)
local ROW_BG_LIGHT  = Color3.fromRGB(24, 32, 56)
local LABEL_COLOR   = Color3.fromRGB(160, 180, 220)
local VALUE_COLOR   = Color3.fromRGB(255, 255, 255)
local ACCENT_COLORS = {
	Color3.fromRGB(80, 255, 200),   -- Time Played
	Color3.fromRGB(255, 220, 60),   -- Wins
	Color3.fromRGB(188, 62, 255),   -- Crowns
	Color3.fromRGB(255, 200, 60),   -- Coins
	Color3.fromRGB(252, 158, 35),   -- Pets
	Color3.fromRGB(255, 80, 100),   -- Deaths
}

-- ═══════════════════════════════════════════════════════════════════
-- HELPERS
-- ═══════════════════════════════════════════════════════════════════

local function formatTime(totalSeconds: number): string
	totalSeconds = math.floor(totalSeconds)
	local h = math.floor(totalSeconds / 3600)
	local m = math.floor((totalSeconds % 3600) / 60)
	local s = totalSeconds % 60
	return string.format("%02d:%02d:%02d", h, m, s)
end

local function formatNumber(n: number): string
	if n >= 1000000 then return string.format("%.1fM", n / 1000000) end
	if n >= 10000 then return string.format("%.1fK", n / 1000) end
	return tostring(n)
end

local function countJsonArray(jsonStr: string?): number
	if not jsonStr or jsonStr == "" or jsonStr == "[]" then return 0 end
	local ok, arr = pcall(HttpService.JSONDecode, HttpService, jsonStr)
	if ok and type(arr) == "table" then return #arr end
	return 0
end

local function getStats(): { [string]: string }
	return {
		TimePlayed = formatTime(LocalPlayer:GetAttribute("TimePlayedSeconds") or 0),
		Wins       = formatNumber(LocalPlayer:GetAttribute("LifetimeWins") or 0),
		Crowns     = tostring(countJsonArray(LocalPlayer:GetAttribute("OwnedCrowns"))),
		Coins      = formatNumber(LocalPlayer:GetAttribute("LifetimeCoinsAchieved") or 0),
		Pets       = tostring(countJsonArray(LocalPlayer:GetAttribute("OwnedPets"))),
		Deaths     = formatNumber(LocalPlayer:GetAttribute("LifetimeDeaths") or 0),
	}
end

local function refreshValues()
	local stats = getStats()
	if _valueLabels.TimePlayed then _valueLabels.TimePlayed.Text = stats.TimePlayed end
	if _valueLabels.Wins       then _valueLabels.Wins.Text       = stats.Wins end
	if _valueLabels.Crowns     then _valueLabels.Crowns.Text     = stats.Crowns end
	if _valueLabels.Coins      then _valueLabels.Coins.Text      = stats.Coins end
	if _valueLabels.Pets       then _valueLabels.Pets.Text       = stats.Pets end
	if _valueLabels.Deaths     then _valueLabels.Deaths.Text     = stats.Deaths end
end

-- ═══════════════════════════════════════════════════════════════════
-- BUILD ROW
-- ═══════════════════════════════════════════════════════════════════

local function buildStatRow(parent: Frame, index: number, icon: string, label: string, key: string, value: string)
	local bgColor = (index % 2 == 0) and ROW_BG_LIGHT or ROW_BG_DARK
	local accentColor = ACCENT_COLORS[index] or LABEL_COLOR

	local row = Instance.new("Frame")
	row.Name = "Row_" .. key
	row.Size = UDim2.new(1, 0, 0, 52)
	row.BackgroundColor3 = bgColor
	row.BackgroundTransparency = 0.15
	row.BorderSizePixel = 0
	row.LayoutOrder = index
	row.ZIndex = 6
	row.Parent = parent
	Instance.new("UICorner", row).CornerRadius = UDim.new(0, 8)

	-- Icon
	local iconLbl = Instance.new("TextLabel")
	iconLbl.Size = UDim2.fromOffset(40, 40)
	iconLbl.Position = UDim2.fromOffset(10, 6)
	iconLbl.BackgroundTransparency = 1
	iconLbl.Font = Enum.Font.GothamBold
	iconLbl.TextSize = 22
	iconLbl.Text = icon
	iconLbl.TextColor3 = accentColor
	iconLbl.ZIndex = 7
	iconLbl.Parent = row

	-- Label
	local labelLbl = Instance.new("TextLabel")
	labelLbl.AnchorPoint = Vector2.new(0, 0.5)
	labelLbl.Position = UDim2.new(0, 56, 0.5, 0)
	labelLbl.Size = UDim2.new(0.5, -60, 0, 20)
	labelLbl.BackgroundTransparency = 1
	labelLbl.Font = Enum.Font.GothamSemibold
	labelLbl.TextColor3 = LABEL_COLOR
	labelLbl.TextSize = 15
	labelLbl.TextXAlignment = Enum.TextXAlignment.Left
	labelLbl.Text = label
	labelLbl.ZIndex = 7
	labelLbl.Parent = row

	-- Value
	local valueLbl = Instance.new("TextLabel")
	valueLbl.Name = "Value"
	valueLbl.AnchorPoint = Vector2.new(1, 0.5)
	valueLbl.Position = UDim2.new(1, -16, 0.5, 0)
	valueLbl.Size = UDim2.new(0.4, 0, 0, 24)
	valueLbl.BackgroundTransparency = 1
	valueLbl.Font = Enum.Font.GothamBold
	valueLbl.TextColor3 = VALUE_COLOR
	valueLbl.TextSize = 18
	valueLbl.TextXAlignment = Enum.TextXAlignment.Right
	valueLbl.Text = value
	valueLbl.ZIndex = 7
	valueLbl.Parent = row

	local valueStroke = Instance.new("UIStroke")
	valueStroke.Color = Color3.fromRGB(0, 0, 0)
	valueStroke.Thickness = 1.2
	valueStroke.Transparency = 0.3
	valueStroke.Parent = valueLbl

	_valueLabels[key] = valueLbl
	return row
end

-- ═══════════════════════════════════════════════════════════════════
-- PANEL LIFECYCLE
-- ═══════════════════════════════════════════════════════════════════

function StatsPanel.Init(screenGui: ScreenGui, onClose: () -> ())
	closeCallback = onClose

	overlay = Components.CreateDimOverlay(screenGui, function()
		StatsPanel.Hide()
	end)

	local content, closeBtn
	canvas, uiScale, content, closeBtn = Components.CreatePanel(screenGui, "PLAYER STATS", HEADER_COLOR, "Stats")

	AnimUtil.WireButton(closeBtn, function()
		SoundUtil.Close()
		StatsPanel.Hide()
	end)

	-- Override stud texture to Fate Beams asset (only this panel)
	do
		local stud = canvas:FindFirstChild("StudTexture")
		if stud then
			stud.Image = "rbxassetid://70851348312450"
			stud.TileSize = UDim2.fromOffset(96, 96)
			stud.ImageTransparency = 0.88
			stud.ImageColor3 = Color3.fromRGB(255, 255, 255)
		end
	end

	local mobileLayout = isMobileTouchDevice()
	if content then
		-- Mobile needs vertical scrolling to reach lower stat rows; desktop keeps fixed list behavior.
		content.ScrollingEnabled = mobileLayout
		content.AutomaticCanvasSize = mobileLayout and Enum.AutomaticSize.Y or Enum.AutomaticSize.None
		content.CanvasSize = UDim2.fromScale(0, 0)
		content.ScrollingDirection = Enum.ScrollingDirection.Y
		content.ScrollBarThickness = mobileLayout and 6 or 0
	end

	-- Inner content padding
	local listLayout = Instance.new("UIListLayout")
	listLayout.SortOrder = Enum.SortOrder.LayoutOrder
	listLayout.Padding = UDim.new(0, 6)
	listLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	listLayout.Parent = content

	local listPad = Instance.new("UIPadding")
	listPad.PaddingLeft = UDim.new(0, 10)
	listPad.PaddingRight = UDim.new(0, 10)
	listPad.PaddingTop = UDim.new(0, 12)
	listPad.PaddingBottom = UDim.new(0, mobileLayout and 14 or 0)
	listPad.Parent = content

	-- Build stat rows
	local stats = getStats()
	buildStatRow(content, 1, "",  "Time Played",      "TimePlayed", stats.TimePlayed)
	buildStatRow(content, 2, "", "Wins",           "Wins",       stats.Wins)
	buildStatRow(content, 3, "", "Crowns Obtained","Crowns",     stats.Crowns)
	buildStatRow(content, 4, "", "Coins Earned",   "Coins",      stats.Coins)
	buildStatRow(content, 5, "", "Pets Obtained",  "Pets",       stats.Pets)
	buildStatRow(content, 6, "", "Deaths",         "Deaths",     stats.Deaths)

	print("[StatsPanel] Initialized")
end

-- ═══════════════════════════════════════════════════════════════════
-- SHOW / HIDE / TOGGLE
-- ═══════════════════════════════════════════════════════════════════

function StatsPanel.Show()
	if visible then return end
	visible = true
	overlay.Visible = true
	SoundUtil.Open()
	AnimUtil.OpenPanel(canvas, uiScale)

	-- Immediate refresh
	refreshValues()

	-- Live refresh every 0.5s (for time played ticking)
	if _refreshConn then _refreshConn:Disconnect() end
	local elapsed = 0
	_refreshConn = RunService.Heartbeat:Connect(function(dt)
		if not visible then return end
		elapsed += dt
		if elapsed >= 0.5 then
			elapsed = 0
			refreshValues()
		end
	end)
end

function StatsPanel.Hide()
	if not visible then return end
	visible = false
	if _refreshConn then _refreshConn:Disconnect(); _refreshConn = nil end
	overlay.Visible = false
	local t = AnimUtil.ClosePanel(canvas, uiScale)
	task.spawn(function()
		t.Completed:Wait()
		canvas.Visible = false
	end)
	if closeCallback then closeCallback() end
end

function StatsPanel.IsVisible(): boolean
	return visible
end

function StatsPanel.Toggle()
	if visible then StatsPanel.Hide() else StatsPanel.Show() end
end

return StatsPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="133">
            <Properties>
              <string name="Name">ThumbnailRenderer</string>
              <string name="Source"><![CDATA[--[[
	ThumbnailRenderer  (v6 — registry-only, no VFX)
	Renders 3D item models into ViewportFrames using WorldModel.

	This is a FALLBACK renderer used only when an item has no explicit
	image id in ItemCatalog. Items with static screenshot images (which
	already include VFX baked in) bypass this module entirely.

	VFX proxy was removed in v6 — static images are the source of truth
	for items that need VFX in their thumbnails.

	RESOLUTION: ItemModelRegistry.Get(path) — single hash lookup.
	CACHING:    _renderCache[vpFrame] = normalizedKey — skip re-render.
	WARNINGS:   _warnedKeys[key] = true — warn once per missing key.
	KILL-SWITCH: Set DISABLE_THUMBNAILS BoolValue in ReplicatedStorage.Shared
	             to true → all calls return false immediately, no logs.

	API (unchanged for callers):
	  ThumbnailRenderer.RenderItemToViewport(vpFrame, itemDef, options?) -> boolean
	  ThumbnailRenderer.InvalidateCache(vpFrame)
	  ThumbnailRenderer.ClearCache()

	Used by: IndexPanel, ShopPanel, CrateShopPanel (fallback only)
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local TAG = "[ThumbnailRenderer]"
print(TAG, "LOADED FROM:", script:GetFullName())

local ThumbnailRenderer = {}

-- =====================================================================
-- DEPENDENCIES (registry only — NO Workspace anywhere in this module)
-- =====================================================================

local Shared = ReplicatedStorage:WaitForChild("Shared")
local ItemModelRegistry = require(Shared:WaitForChild("ItemModelRegistry"))

-- =====================================================================
-- KILL-SWITCH
-- =====================================================================

local _killSwitch: BoolValue? = Shared:FindFirstChild("DISABLE_THUMBNAILS") :: BoolValue?
if not _killSwitch then
	local bv = Instance.new("BoolValue")
	bv.Name = "DISABLE_THUMBNAILS"
	bv.Value = false
	bv.Parent = Shared
	_killSwitch = bv
end

local function isDisabled(): boolean
	return _killSwitch and _killSwitch.Value == true
end

-- =====================================================================
-- DEFAULTS
-- =====================================================================

local DEFAULT_CAMERA_ANGLE = Vector3.new(0.5, 0.35, 0.8)
local DEFAULT_FOV = 50
local DEFAULT_DISTANCE_MULT = 2.0
local DEFAULT_AMBIENT = Color3.fromRGB(180, 180, 200)
local DEFAULT_LIGHT_COLOR = Color3.fromRGB(255, 255, 255)
local DEFAULT_LIGHT_DIR = Vector3.new(-1, -1, -1)

-- Per-item thumbnail yaw correction (degrees).
-- Rotates the model in the ViewportFrame so its "face" points toward the camera.
-- Only affects thumbnails — does NOT change in-world orientation.
local THUMBNAIL_YAW_OFFSETS: { [string]: number } = {
	pet_dog = 180, -- Blender model faces +Z; thumbnail camera is on +Z side → flip
}

-- Explicit per-pet thumbnail offsets for plush/huggy set.
local THUMBNAIL_OFFSET_CFRAME: { [string]: CFrame } = {
	pet_foxy_plush = CFrame.Angles(0, math.rad(180), 0),
	pet_chica_plush = CFrame.Angles(0, math.rad(180), 0),
	pet_freddy_plush = CFrame.Angles(0, math.rad(180), 0),
	pet_bonnie_plush = CFrame.Angles(0, math.rad(180), 0),
	pet_fredbear_plush = CFrame.new(),
	pet_huggy_wuggy = CFrame.new(),
}

-- Per-item camera distance multiplier overrides (thumbnail only).
-- Higher value = smaller rendered model footprint in the card.
local THUMBNAIL_DISTANCE_MULT_OVERRIDES: { [string]: number } = {
	pet_fredbear_plush = 2.8,
}

local KEEP_CLASSES = {
	UICorner = true,
	UIStroke = true,
	UIGradient = true,
	UIListLayout = true,
	UIGridLayout = true,
	UIPadding = true,
	UIAspectRatioConstraint = true,
	UIScale = true,
}

-- (VFX proxy config removed in v6 — static images include VFX)

-- =====================================================================
-- WARN-ONCE + RENDER CACHE
-- =====================================================================

local _warnedKeys: { [string]: boolean } = {}
local _renderCache: { [ViewportFrame]: string } = {}

-- =====================================================================
-- INTERNALS (rendering helpers — no model resolution here)
-- =====================================================================

local function isInsideThumbnailVFX(part: Instance, root: Instance): boolean
	local parent = part.Parent
	while parent and parent ~= root do
		if parent:IsA("Folder") and parent.Name == "ThumbnailVFX" then return true end
		parent = parent.Parent
	end
	return false
end

local function getModelBounds(root: Instance): (Vector3, Vector3)
	-- Priority A: ThumbnailCameraTarget overrides everything
	local camTarget = root:FindFirstChild("ThumbnailCameraTarget", true)
	if camTarget and camTarget:IsA("BasePart") then
		local p, h = camTarget.Position, camTarget.Size / 2
		return
			Vector3.new(p.X - h.X, p.Y - h.Y, p.Z - h.Z),
			Vector3.new(p.X + h.X, p.Y + h.Y, p.Z + h.Z)
	end

	-- Priority B: PrimaryPart if model has one
	if root:IsA("Model") and root.PrimaryPart then
		local pp = root.PrimaryPart
		local p, h = pp.Position, pp.Size / 2
		return
			Vector3.new(p.X - h.X, p.Y - h.Y, p.Z - h.Z),
			Vector3.new(p.X + h.X, p.Y + h.Y, p.Z + h.Z)
	end

	-- Priority C: All visible BaseParts, excluding ThumbnailVFX contents
	local minB = Vector3.new(math.huge, math.huge, math.huge)
	local maxB = Vector3.new(-math.huge, -math.huge, -math.huge)
	local found = false
	local function proc(part: BasePart)
		found = true
		local p, h = part.Position, part.Size / 2
		minB = Vector3.new(math.min(minB.X, p.X-h.X), math.min(minB.Y, p.Y-h.Y), math.min(minB.Z, p.Z-h.Z))
		maxB = Vector3.new(math.max(maxB.X, p.X+h.X), math.max(maxB.Y, p.Y+h.Y), math.max(maxB.Z, p.Z+h.Z))
	end
	if root:IsA("BasePart") then proc(root) end
	for _, d in ipairs(root:GetDescendants()) do
		if d:IsA("BasePart") and not isInsideThumbnailVFX(d, root) then
			proc(d)
		end
	end
	if not found then return Vector3.zero, Vector3.new(2,2,2) end
	return minB, maxB
end

local function repositionToOrigin(clone: Instance)
	if clone:IsA("Model") and clone.PrimaryPart then
		clone:PivotTo(CFrame.new())
	elseif clone:IsA("BasePart") then
		clone.Position = Vector3.zero
	elseif clone:IsA("Model") then
		local fp = clone:FindFirstChildWhichIsA("BasePart", true)
		if fp then
			local off = fp.Position
			for _, d in ipairs(clone:GetDescendants()) do
				if d:IsA("BasePart") then d.Position = d.Position - off end
			end
		end
	end
end

local function clearViewport(vpFrame: ViewportFrame)
	for _, child in ipairs(vpFrame:GetChildren()) do
		if not KEEP_CLASSES[child.ClassName] then child:Destroy() end
	end
	vpFrame.CurrentCamera = nil
end

-- =====================================================================
-- SAFE CLONE (strips unsafe instances, anchors parts)
-- =====================================================================

local function safeClone(modelInstance: Instance): Instance?
	local ok, clone = pcall(modelInstance.Clone, modelInstance)
	if not ok or not clone then return nil end

	local descendants = clone:GetDescendants()
	for _, d in ipairs(descendants) do
		if d:IsA("Script") or d:IsA("LocalScript") or d:IsA("ModuleScript") then
			d:Destroy()
		elseif d:IsA("Humanoid") or d:IsA("Animator") or d:IsA("AnimationController") then
			d:Destroy()
		elseif d:IsA("BasePart") then
			d.Anchored = true
			d.CanCollide = false
		end
	end

	return clone
end

-- (VFX detection, proxy parts, and glow border removed in v6)

-- =====================================================================
-- PUBLIC API
-- =====================================================================

function ThumbnailRenderer.RenderItemToViewport(
	vpFrame: ViewportFrame,
	itemDef: {
		modelPath: string?,
		id: string?,
		name: string?,
		type: string?,
		rarity: string?,
	},
	options: { cameraAngle: Vector3?, fov: number?, distanceMultiplier: number? }?
): boolean
	-- Kill-switch: instant bail, no logs
	if isDisabled() then return false end

	-- Validate
	if not vpFrame or typeof(vpFrame) ~= "Instance" or not vpFrame:IsA("ViewportFrame") then
		return false
	end
	if not itemDef or not itemDef.modelPath or itemDef.modelPath == "" then
		return false
	end

	local rawPath = itemDef.modelPath
	local key = ItemModelRegistry.Normalize(rawPath)

	-- Cache hit: already rendered this exact model into this viewport
	if _renderCache[vpFrame] == key then
		return true
	end

	-- Resolve via registry ONLY
	local modelInstance = ItemModelRegistry.Get(rawPath)
	if not modelInstance then
		if not _warnedKeys[key] then
			_warnedKeys[key] = true
			warn(TAG, "MODEL NOT FOUND:", rawPath, "(key:", key .. ")")
		end
		return false
	end

	-- Safe clone: strips scripts/humanoids, anchors parts
	local clone = safeClone(modelInstance)
	if not clone then
		if not _warnedKeys["clone:" .. key] then
			_warnedKeys["clone:" .. key] = true
			warn(TAG, "CLONE FAILED:", rawPath)
		end
		return false
	end

	-- Build viewport scene
	clearViewport(vpFrame)
	vpFrame.Ambient = DEFAULT_AMBIENT
	vpFrame.LightColor = DEFAULT_LIGHT_COLOR
	vpFrame.LightDirection = DEFAULT_LIGHT_DIR

	local wm = Instance.new("WorldModel")
	wm.Name = "ItemWorldModel"
	wm.Parent = vpFrame

	repositionToOrigin(clone)

	-- Per-item thumbnail yaw rotation (rotate model so its face points at camera).
	-- Rotates every BasePart CFrame around the world origin so it works
	-- regardless of whether the Model has a PrimaryPart or not.
	local thumbYaw = THUMBNAIL_YAW_OFFSETS[itemDef.id or ""] or 0
	if thumbYaw ~= 0 then
		local rot = CFrame.Angles(0, math.rad(thumbYaw), 0)
		if clone:IsA("Model") then
			for _, d in ipairs(clone:GetDescendants()) do
				if d:IsA("BasePart") then
					d.CFrame = rot * d.CFrame
				end
			end
		elseif clone:IsA("BasePart") then
			clone.CFrame = rot * clone.CFrame
		end
	end

	local thumbOffset = THUMBNAIL_OFFSET_CFRAME[itemDef.id or ""]
	if thumbOffset then
		if clone:IsA("Model") then
			for _, d in ipairs(clone:GetDescendants()) do
				if d:IsA("BasePart") then
					d.CFrame = thumbOffset * d.CFrame
				end
			end
		elseif clone:IsA("BasePart") then
			clone.CFrame = thumbOffset * clone.CFrame
		end
	end

	clone.Parent = wm

	-- Camera framing
	local minB, maxB = getModelBounds(clone)
	local center = (minB + maxB) / 2
	local sz = maxB - minB
	local maxDim = math.max(sz.X, sz.Y, sz.Z, 1)
	local opts = options or {}
	local angle = opts.cameraAngle or DEFAULT_CAMERA_ANGLE
	local fov = opts.fov or DEFAULT_FOV
	local distanceMult = opts.distanceMultiplier or DEFAULT_DISTANCE_MULT
	local perItemDist = THUMBNAIL_DISTANCE_MULT_OVERRIDES[itemDef.id or ""]
	if perItemDist then
		distanceMult = perItemDist
	end
	local dist = distanceMult * maxDim

	local cam = Instance.new("Camera")
	cam.CameraType = Enum.CameraType.Scriptable
	cam.CFrame = CFrame.lookAt(center + angle.Unit * dist, center)
	cam.FieldOfView = fov
	cam.Parent = vpFrame
	vpFrame.CurrentCamera = cam

	-- Update cache
	_renderCache[vpFrame] = key
	return true
end

function ThumbnailRenderer.InvalidateCache(vpFrame: ViewportFrame)
	if vpFrame then _renderCache[vpFrame] = nil end
end

function ThumbnailRenderer.ClearCache()
	table.clear(_renderCache)
end

-- =====================================================================
-- SELF-TEST (runs once on require — proves registry works)
-- =====================================================================

task.defer(function()
	print(TAG, "v6 loaded | Registry-only | No VFX | kill-switch =", isDisabled())
	print(TAG, "Registry count:", ItemModelRegistry.GetCount())

	-- Spot-check known items
	local tests = {
		{ "ItemModels.Pets.Common.noob",       "Noob" },
		{ "ItemModels.Pets.Rare.ray fish",     "Ray fish" },
		{ "ItemModels.Pets.Common.parrot",     "Parrot" },
	}
	for _, t in ipairs(tests) do
		local inst = ItemModelRegistry.Get(t[1])
		local got = inst and inst.Name or "nil"
		local isOk = inst ~= nil
		print(TAG, string.format("  SELF-TEST: Get(\"%s\") -> %s %s", t[1], got, isOk and "OK" or "MISSING"))
	end
end)

return ThumbnailRenderer
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="134">
          <Properties>
            <string name="Name">UIController</string>
            <string name="Source">--[[
	UIController
	Central client-side UI orchestrator.

	Responsibilities:
	  * Creates ScreenGuis (HUD + Panels)
	  * Initialises sub-modules (HUD, Shop, FateCrowns, Pets, CrateShop, Index)
	  * Enforces "one panel at a time" rule
	  * ESC key closes the currently open panel
	  * Walk-up CrownPetShop: ProximityPrompt-based (reliable)
	    -&gt; Also falls back to distance polling if prompt fails
	  * Also listens for OpenCrateShop RemoteEvent as fallback

	FIX: CrownPetShop position detection is now much more robust:
	  1. Tries PrimaryPart
	  2. Tries GetPivot()
	  3. Tries any descendant BasePart
	  4. Tries GetBoundingBox()
	  5. Retries multiple times with delays

	FIX (SpinWheel):
	  * Auto-close now uses the PROMPT's parent Part position (not the model root)
	  * Grace period after opening before auto-close kicks in
	  * CLOSE_DISTANCE increased to 50 studs (player must clearly walk away)
	  * "Game starting in X" banner is hidden while SpinWheel is open

	FIX (CrateShop):
	  * Now uses ProximityPrompt for reliable walk-up detection
	  * Distance polling kept as secondary check for auto-close

	Called from Client init.client.luau via UIController.Init().
]]

local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local Shared = ReplicatedStorage:WaitForChild("Shared", 10)
if not Shared then
	warn("[UIController] Shared not found after 10s -- FAILED")
	return { Init = function() warn("[UIController] FAILED") end }
end

local okCfg, UIConfig = pcall(require, Shared:WaitForChild("UIConfig", 10))
if not okCfg or not UIConfig then
	local _children = {}
	for _, c in ipairs(Shared:GetChildren()) do table.insert(_children, c.Name.."("..c.ClassName..")") end
	warn("[UIController] require(UIConfig) FAILED:", UIConfig, "| Shared children:", table.concat(_children, ", "))
	return { Init = function() warn("[UIController] FAILED") end }
end

local Client = script.Parent
local UI = Client:WaitForChild("UI")

local SoundUtil         = require(UI:WaitForChild("SoundUtil"))
local Components        = require(UI:WaitForChild("Components"))
local HUDPanel          = require(UI:WaitForChild("HUDPanel"))

local PANEL_STUB = {
	Init = function() end, Show = function() end, Hide = function() end,
	IsVisible = function() return false end, Toggle = function() end,
}

local _failedPanels = {}

local SAFE_REQUIRE_RETRIES = { 0.25, 1.0 }

local function safeRequire(name)
	local moduleInstance = UI:WaitForChild(name, 10)
	if not moduleInstance then
		warn(string.format("[UIController] Module '%s' not found in UI folder after 10s", name))
		table.insert(_failedPanels, name)
		return PANEL_STUB
	end

	local ok, mod = pcall(require, moduleInstance)
	if ok and mod then return mod end

	warn(string.format("[UIController] Failed to load %s (path: %s): %s",
		name, moduleInstance:GetFullName(), tostring(mod)))

	for i, delay in ipairs(SAFE_REQUIRE_RETRIES) do
		task.wait(delay)
		warn(string.format("[UIController] Retry #%d for %s after %.2fs...", i, name, delay))
		ok, mod = pcall(require, moduleInstance)
		if ok and mod then
			print(string.format("[UIController] %s loaded OK on retry #%d", name, i))
			return mod
		end
		warn(string.format("[UIController] Retry #%d for %s FAILED: %s", i, name, tostring(mod)))
	end

	warn(string.format("[UIController] GIVING UP on %s after %d retries", name, #SAFE_REQUIRE_RETRIES))
	table.insert(_failedPanels, name)
	return PANEL_STUB
end

local ShopPanel         = safeRequire("ShopPanel")
local FateCrownsPanel   = safeRequire("FateCrownsPanel")
local PetsPanel         = safeRequire("PetsPanel")
local CrateShopPanel    = safeRequire("CrateShopPanel")
local IndexPanel        = safeRequire("IndexPanel")
local SpectatePanel     = safeRequire("SpectatePanel")
local SettingsPanel     = safeRequire("SettingsPanel")
local IconImagesPanel   = safeRequire("IconImagesPanel")
local SpinWheelPanel    = safeRequire("SpinWheelPanel")
local KillFeed          = safeRequire("KillFeed")
local MatchResultsPanel = safeRequire("MatchResultsPanel")
local DailyRewardsPanel = safeRequire("DailyRewardsPanel")
local StatsPanel        = safeRequire("StatsPanel")
local ModeVotePanel     = safeRequire("ModeVotePanel")
local QuestsPanel       = safeRequire("QuestsPanel")

local LocalPlayer = Players.LocalPlayer

local initialized = false
local currentPanel: string? = nil
local matchLocked = false

local MATCH_LOCKED_PANELS = { Shop = true, Crowns = true, Pets = true, Daily = true, Stats = true, Spectate = true }

local UIController = {}

UIController.CloseAllPanels = nil -- set after closeCurrentPanel is defined

local function log(...)
	if UIConfig.DebugLog then
		print("[UIController]", ...)
	end
end

local function closeCurrentPanel()
	if currentPanel == "Shop" and ShopPanel.IsVisible() then
		ShopPanel.Hide()
	elseif currentPanel == "Crowns" and FateCrownsPanel.IsVisible() then
		FateCrownsPanel.Hide()
	elseif currentPanel == "Pets" and PetsPanel.IsVisible() then
		PetsPanel.Hide()
	elseif currentPanel == "Index" and IndexPanel.IsVisible() then
		IndexPanel.Hide()
	elseif currentPanel == "CrateShop" and CrateShopPanel.IsVisible() then
		CrateShopPanel.Hide()
	elseif currentPanel == "Spectate" and SpectatePanel.IsVisible() then
		SpectatePanel.Hide()
	elseif currentPanel == "Settings" and SettingsPanel.IsVisible() then
		SettingsPanel.Hide()
	elseif currentPanel == "Icons" and IconImagesPanel.IsVisible() then
		IconImagesPanel.Hide()
	elseif currentPanel == "SpinWheel" and SpinWheelPanel.IsVisible() then
		SpinWheelPanel.Hide()
	elseif currentPanel == "Daily" and DailyRewardsPanel.IsVisible() then
		DailyRewardsPanel.Hide()
	elseif currentPanel == "Stats" and StatsPanel.IsVisible() then
		StatsPanel.Hide()
	elseif currentPanel == "Quests" and QuestsPanel.IsVisible() then
		QuestsPanel.Hide()
	end
	currentPanel = nil

	HUDPanel.SetBannerOverrideHidden(false)
end

UIController.CloseAllPanels = closeCurrentPanel

local function openPanel(name: string)
	if matchLocked and MATCH_LOCKED_PANELS[name] then
		log("Blocked opening " .. name .. " -- player is InMatch")
		return
	end

	if currentPanel == name then
		closeCurrentPanel()
		return
	end
	closeCurrentPanel()
	currentPanel = name

	if name == "Shop" then
		ShopPanel.Show()
	elseif name == "Crowns" then
		FateCrownsPanel.Show()
	elseif name == "Pets" then
		PetsPanel.Show()
	elseif name == "Index" then
		IndexPanel.Show()
	elseif name == "CrateShop" then
		CrateShopPanel.Show()
	elseif name == "Spectate" then
		SpectatePanel.Show()
	elseif name == "Settings" then
		SettingsPanel.Show()
	elseif name == "Icons" then
		IconImagesPanel.Show()
	elseif name == "SpinWheel" then
		SpinWheelPanel.Show()
	elseif name == "Daily" then
		DailyRewardsPanel.Show()
	elseif name == "Stats" then
		StatsPanel.Show()
	elseif name == "Quests" then
		QuestsPanel.Show()
	end

	HUDPanel.SetBannerOverrideHidden(true)

	log("Opened:", name)
end

local function getInstancePosition(instance: Instance): Vector3?
	if instance:IsA("BasePart") then
		return instance.Position
	end

	if instance:IsA("Model") then
		local primary = instance.PrimaryPart
		if primary then
			return primary.Position
		end

		local ok, pivot = pcall(function()
			return instance:GetPivot()
		end)
		if ok and pivot then
			return pivot.Position
		end

		local ok2, cf = pcall(function()
			local cframe, _ = instance:GetBoundingBox()
			return cframe
		end)
		if ok2 and cf then
			return cf.Position
		end
	end

	local part = instance:FindFirstChildWhichIsA("BasePart", true)
	if part then
		return part.Position
	end

	for _, child in ipairs(instance:GetChildren()) do
		if child:IsA("BasePart") then
			return child.Position
		end
		if child:IsA("Model") then
			local pos = getInstancePosition(child)
			if pos then return pos end
		end
	end

	return nil
end

function UIController.Init()
	if initialized then return end
	initialized = true

	pcall(function()
		local StarterGui = game:GetService("StarterGui")
		StarterGui.ScreenOrientation = Enum.ScreenOrientation.LandscapeSensor
	end)

	SoundUtil.Init()

	local hudOk, hudGui = pcall(Components.CreateScreenGui, "HUDGui", 1)
	if not hudOk or not hudGui then
		warn("[UIController] FAILED: Could not create HUD ScreenGui: " .. tostring(hudGui))
		return
	end
	local panelGui = Components.CreateScreenGui("PanelGui", 10)

	Components.SetupResponsiveScale(hudGui)
	Components.SetupResponsiveScale(panelGui)

	local function onPanelClosed()
		currentPanel = nil
		HUDPanel.SetBannerOverrideHidden(false)
	end

	local function safeInit(name, fn, ...)
		local args = {...}
		local ok, err = pcall(function()
			fn(table.unpack(args))
		end)
		if not ok then
			warn("[UIController] " .. name .. " Init FAILED: " .. tostring(err))
			if not table.find(_failedPanels, name) then
				table.insert(_failedPanels, name)
			end
		end
	end

	safeInit("ShopPanel", ShopPanel.Init, panelGui, onPanelClosed)
	safeInit("FateCrownsPanel", FateCrownsPanel.Init, panelGui, onPanelClosed)
	safeInit("PetsPanel", PetsPanel.Init, panelGui, onPanelClosed)
	safeInit("CrateShopPanel", CrateShopPanel.Init, panelGui, onPanelClosed)
	safeInit("IndexPanel", IndexPanel.Init, panelGui, onPanelClosed)
	safeInit("SpectatePanel", SpectatePanel.Init, panelGui, onPanelClosed)
	safeInit("SettingsPanel", SettingsPanel.Init, panelGui, onPanelClosed)
	safeInit("IconImagesPanel", IconImagesPanel.Init, panelGui, onPanelClosed)
	safeInit("SpinWheelPanel", SpinWheelPanel.Init, panelGui, onPanelClosed)
	safeInit("DailyRewardsPanel", DailyRewardsPanel.Init, panelGui, onPanelClosed)
	safeInit("StatsPanel", StatsPanel.Init, panelGui, onPanelClosed)
	safeInit("QuestsPanel", QuestsPanel.Init, panelGui, onPanelClosed)

	safeInit("ModeVotePanel", ModeVotePanel.Init)

	safeInit("KillFeed", KillFeed.Init, hudGui)

	safeInit("MatchResultsPanel", MatchResultsPanel.Init, hudGui)

	local hudInitOk, hudInitErr = pcall(function()
		HUDPanel.Init(hudGui, {
			onShop     = function() openPanel("Shop") end,
			onCrowns   = function() openPanel("Crowns") end,
			onPets     = function() openPanel("Pets") end,
			onIndex    = function() openPanel("Index") end,
			onSpectate = function() openPanel("Spectate") end,
			onSettings = function() openPanel("Settings") end,
			onIcons    = function() openPanel("Icons") end,
			onDaily    = function() openPanel("Daily") end,
			onStats    = function() openPanel("Stats") end,
			onQuests   = function() openPanel("Quests") end,
			onAFK      = function()
				task.spawn(function()
					local remotes = ReplicatedStorage:FindFirstChild("Remotes")
					if not remotes then return end
					local toggleAFK = remotes:FindFirstChild("ToggleAFK")
					if toggleAFK then
						toggleAFK:FireServer()
					end
				end)
			end,
		})
	end)

	if not hudInitOk then
		warn("[UIController] FAILED: HUD Init error: " .. tostring(hudInitErr))
		return
	end

	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed then return end
		if input.KeyCode == Enum.KeyCode.Escape and currentPanel then
			closeCurrentPanel()
		end
	end)

	local function onPlayerStateChanged()
		local state = LocalPlayer:GetAttribute("PlayerState")
		local wasLocked = matchLocked
		matchLocked = (state == "InMatch")

		if matchLocked and not wasLocked then
			log("Match started -- locking Pets/Crowns UI")
			if currentPanel and MATCH_LOCKED_PANELS[currentPanel] then
				log("Force-closing " .. currentPanel .. " (match started)")
				closeCurrentPanel()
			end
		elseif not matchLocked and wasLocked then
			log("Match ended -- unlocking Pets/Crowns UI")
		end
	end
	onPlayerStateChanged()
	LocalPlayer:GetAttributeChangedSignal("PlayerState"):Connect(onPlayerStateChanged)

	task.spawn(function()
		local crateShopModel = nil
		local MAX_RETRIES = 15
		local RETRY_DELAY = 2

		for attempt = 1, MAX_RETRIES do
			crateShopModel = workspace:FindFirstChild("CrownPetShop", true)
			if not crateShopModel then
				crateShopModel = workspace:FindFirstChild("CrownPetShop")
			end
			if crateShopModel then
				print(string.format("[UIController] CrownPetShop found on attempt %d: %s (class: %s)",
					attempt, crateShopModel:GetFullName(), crateShopModel.ClassName))
				break
			end
			if attempt &lt; MAX_RETRIES then
				if attempt == 1 then
					print("[UIController] Searching for CrownPetShop...")
				end
				task.wait(RETRY_DELAY)
			end
		end

		if not crateShopModel then
			warn("[UIController] CrownPetShop NOT FOUND after " .. MAX_RETRIES .. " attempts -- walk-up shop disabled")
			return
		end

		local refPart = nil
		if crateShopModel:IsA("Model") and crateShopModel.PrimaryPart then
			refPart = crateShopModel.PrimaryPart
		end
		if not refPart then
			refPart = crateShopModel:FindFirstChildWhichIsA("BasePart", true)
		end
		if not refPart then
			print("[UIController] CrownPetShop: waiting for BasePart to stream in...")
			local waitConn
			local found = false
			waitConn = crateShopModel.DescendantAdded:Connect(function(desc)
				if desc:IsA("BasePart") and not found then
					found = true
					refPart = desc
					if waitConn then waitConn:Disconnect() end
				end
			end)
			task.wait(8)
			if waitConn then pcall(function() waitConn:Disconnect() end) end
			if not refPart then
				refPart = crateShopModel:FindFirstChildWhichIsA("BasePart", true)
			end
		end

		if not refPart then
			warn("[UIController] CrownPetShop has NO BasePart -- walk-up disabled")
			return
		end

		print(string.format("[UIController] CrownPetShop refPart: %s at (%.1f, %.1f, %.1f)",
			refPart:GetFullName(), refPart.Position.X, refPart.Position.Y, refPart.Position.Z))

		local prompt: ProximityPrompt? = nil
		for _, desc in ipairs(crateShopModel:GetDescendants()) do
			if desc:IsA("ProximityPrompt") then
				prompt = desc
				break
			end
		end

		local OPEN_DISTANCE = 15
		local CLOSE_DISTANCE = 22
		local crateOpenTime = 0

		if not prompt then
			local anchor = Instance.new("Part")
			anchor.Name = "CrateShopPromptAnchor"
			anchor.Size = Vector3.new(2, 2, 2)
			anchor.Position = Vector3.new(refPart.Position.X, refPart.Position.Y + 3, refPart.Position.Z)
			anchor.Anchored = true
			anchor.CanCollide = false
			anchor.CanQuery = false
			anchor.CanTouch = false
			anchor.Transparency = 1
			anchor.Parent = crateShopModel

			prompt = Instance.new("ProximityPrompt")
			prompt.Name = "CrateShopPrompt"
			prompt.ActionText = "Open Shop"
			prompt.ObjectText = "Crate Shop"
			prompt.KeyboardKeyCode = Enum.KeyCode.E
			prompt.HoldDuration = 0
			prompt.MaxActivationDistance = OPEN_DISTANCE
			prompt.RequiresLineOfSight = false
			prompt.Parent = anchor

			print("[UIController] Created CrateShopPrompt on anchor at", anchor.Position)
		else
			print("[UIController] Found existing ProximityPrompt in CrownPetShop:", prompt:GetFullName())
		end

		local promptPart = prompt.Parent

		prompt.Triggered:Connect(function(playerWhoTriggered)
			if playerWhoTriggered ~= LocalPlayer then return end
			print("[UIController] CrateShop prompt triggered")
			crateOpenTime = tick()
			openPanel("CrateShop")
		end)

		local GRACE_PERIOD = 3
		RunService.Heartbeat:Connect(function()
			if currentPanel ~= "CrateShop" then return end
			if (tick() - crateOpenTime) &lt; GRACE_PERIOD then return end

			local char = LocalPlayer.Character
			if not char then return end
			local root = char:FindFirstChild("HumanoidRootPart")
			if not root then return end

			local shopPos = nil
			if promptPart and promptPart:IsA("BasePart") then
				shopPos = promptPart.Position
			else
				shopPos = getInstancePosition(crateShopModel)
			end
			if not shopPos then return end

			local dist = (root.Position - shopPos).Magnitude
			if dist &gt; CLOSE_DISTANCE then
				closeCurrentPanel()
			end
		end)
	end)

	task.spawn(function()
		local remotes = ReplicatedStorage:WaitForChild("Remotes", 15)
		if not remotes then return end

		local openCrateShopEvent = remotes:WaitForChild("OpenCrateShop", 15)
		if openCrateShopEvent then
			openCrateShopEvent.OnClientEvent:Connect(function()
				openPanel("CrateShop")
			end)
		end
	end)

	task.spawn(function()
		local okSWC, SpinWheelCfg = pcall(require, Shared:WaitForChild("SpinWheelConfig", 10))
		if not okSWC or not SpinWheelCfg then
			warn("[UIController] SpinWheelConfig not available -- spin wheel walk-up disabled")
			return
		end

		local spinModel = nil
		local MAX_RETRIES = 10
		local RETRY_DELAY = 2

		for attempt = 1, MAX_RETRIES do
			spinModel = workspace:FindFirstChild("SpinTheWheel", true)
			if not spinModel then
				spinModel = workspace:FindFirstChild("SpinTheWheel")
			end
			if spinModel then
				log("[SpinWheel] Model found on attempt " .. attempt)
				break
			end
			if attempt &lt; MAX_RETRIES then
				task.wait(RETRY_DELAY)
			end
		end

		if not spinModel then
			log("[SpinWheel] NOT FOUND -- spin wheel disabled")
			return
		end

		local prompt: ProximityPrompt? = nil
		for _, desc in ipairs(spinModel:GetDescendants()) do
			if desc:IsA("ProximityPrompt") then
				prompt = desc
				break
			end
		end

		if not prompt then
			local waitStart = tick()
			local MAX_WAIT = 20
			local foundEvent = Instance.new("BindableEvent")
			local conn = spinModel.DescendantAdded:Connect(function(desc)
				if desc:IsA("ProximityPrompt") then
					prompt = desc
					foundEvent:Fire()
				end
			end)
			task.spawn(function()
				while not prompt and (tick() - waitStart) &lt; MAX_WAIT do
					task.wait(1)
					for _, desc in ipairs(spinModel:GetDescendants()) do
						if desc:IsA("ProximityPrompt") then
							prompt = desc
							foundEvent:Fire()
							return
						end
					end
				end
				foundEvent:Fire()
			end)
			if not prompt then
				foundEvent.Event:Wait()
			end
			conn:Disconnect()
			foundEvent:Destroy()
		end

		if not prompt then
			local refPart = spinModel:FindFirstChildWhichIsA("BasePart", true)
			if not refPart then return end

			local anchor = Instance.new("Part")
			anchor.Name = "SpinWheelPromptAnchor"
			anchor.Size = Vector3.new(2, 2, 2)
			anchor.Position = Vector3.new(refPart.Position.X, 5, refPart.Position.Z)
			anchor.Anchored = true
			anchor.CanCollide = false
			anchor.CanQuery = false
			anchor.CanTouch = false
			anchor.Transparency = 1
			anchor.Parent = spinModel

			prompt = Instance.new("ProximityPrompt")
			prompt.Name = "SpinWheelPrompt"
			prompt.ActionText = "Spin"
			prompt.ObjectText = "Spin The Wheel"
			prompt.KeyboardKeyCode = Enum.KeyCode.E
			prompt.HoldDuration = 0
			prompt.MaxActivationDistance = SpinWheelCfg.OPEN_DISTANCE
			prompt.RequiresLineOfSight = false
			prompt.Parent = anchor
		end

		local promptPart = prompt.Parent
		local spinOpenTime = 0

		prompt.Triggered:Connect(function(playerWhoTriggered)
			if playerWhoTriggered ~= LocalPlayer then return end
			spinOpenTime = tick()
			openPanel("SpinWheel")
		end)

		local CLOSE_DIST = SpinWheelCfg.CLOSE_DISTANCE
		local GRACE_PERIOD = SpinWheelCfg.OPEN_GRACE_PERIOD or 3

		RunService.Heartbeat:Connect(function()
			if currentPanel ~= "SpinWheel" then return end
			if (tick() - spinOpenTime) &lt; GRACE_PERIOD then return end

			local char = LocalPlayer.Character
			if not char then return end
			local root = char:FindFirstChild("HumanoidRootPart")
			if not root then return end

			local promptPos = nil
			if promptPart and promptPart:IsA("BasePart") then
				promptPos = promptPart.Position
			else
				promptPos = getInstancePosition(spinModel)
			end
			if not promptPos then return end

			local dist = (root.Position - promptPos).Magnitude
			if dist &gt; CLOSE_DIST then
				closeCurrentPanel()
			end
		end)
	end)

	-- ═══════════════════════════════════════════════════════════════════
	-- WALK-UP: Brainrot Bundle Display
	-- ═══════════════════════════════════════════════════════════════════
	task.spawn(function()
		local BUNDLE_OPEN_DISTANCE = 15
		local BUNDLE_CLOSE_DISTANCE = 30
		local bundleOpenTime = 0
		local lastPromptOpenAt = 0
		local promptOpenCooldown = 0.75
		local openedByFnafPrompt = false

		local brainrotFolder = nil
		for attempt = 1, 300 do
			brainrotFolder = workspace:FindFirstChild("Brainrot Game Bun")
			if brainrotFolder then break end
			task.wait(1)
		end

		if not brainrotFolder then
			log("[BrainrotBundle] Folder not found -- walk-up disabled")
			return
		end

		local function findBrainrotAnchorPart(folder: Instance): BasePart?
			-- Deterministic anchor rule: use one explicit stand/root only.
			local standPart = folder:FindFirstChild("Part")
			if standPart and standPart:IsA("BasePart") then
				return standPart
			end
			return nil
		end

		local posterPart = nil
		local delayedForAnchor = false
		for attempt = 1, 300 do
			posterPart = findBrainrotAnchorPart(brainrotFolder)
			if posterPart then break end
			delayedForAnchor = true
			task.wait(1)
		end

		if not posterPart then
			log("[BrainrotBundle] No poster BasePart -- walk-up disabled")
			return
		end
		log(string.format(
			"[BrainrotPrompt] anchorFound=%s initDelayedUntilAnchor=%s placementSource=BrainrotStandPart finalY=%.2f",
			posterPart:GetFullName(),
			tostring(delayedForAnchor),
			posterPart.Position.Y
		))

		local prompt: ProximityPrompt? = nil
		for _, desc in ipairs(brainrotFolder:GetDescendants()) do
			if desc:IsA("ProximityPrompt") then
				prompt = desc
				break
			end
		end

		if not prompt then
			prompt = Instance.new("ProximityPrompt")
			prompt.Name = "BrainrotBundlePrompt"
			prompt.ActionText = "Buy"
			prompt.ObjectText = "Brainrot Bundle"
			prompt.KeyboardKeyCode = Enum.KeyCode.E
			prompt.HoldDuration = 0
			prompt.MaxActivationDistance = BUNDLE_OPEN_DISTANCE
			prompt.RequiresLineOfSight = false
			prompt.Parent = posterPart

			log("[BrainrotBundle] Prompt parented directly to poster at " .. tostring(posterPart.Position))
		end
		prompt.Enabled = true

		prompt.Triggered:Connect(function(playerWhoTriggered)
			if playerWhoTriggered ~= LocalPlayer then return end
			bundleOpenTime = tick()
			openPanel("Shop")
			if ShopPanel.ActivateBundleTab then
				ShopPanel.ActivateBundleTab("brainrot_bundle")
			end
		end)

		-- Keep Brainrot prompt visible/enabled if assets stream or hierarchy refreshes.
		task.spawn(function()
			while true do
				if not brainrotFolder.Parent then
					break
				end
				if not posterPart or not posterPart.Parent then
					posterPart = findBrainrotAnchorPart(brainrotFolder)
				end
				if posterPart and posterPart.Parent then
					if not prompt or not prompt.Parent then
						prompt = Instance.new("ProximityPrompt")
						prompt.Name = "BrainrotBundlePrompt"
						prompt.ActionText = "Buy"
						prompt.ObjectText = "Brainrot Bundle"
						prompt.KeyboardKeyCode = Enum.KeyCode.E
						prompt.HoldDuration = 0
						prompt.MaxActivationDistance = BUNDLE_OPEN_DISTANCE
						prompt.RequiresLineOfSight = false
						prompt.Parent = posterPart
						prompt.Triggered:Connect(function(playerWhoTriggered)
							if playerWhoTriggered ~= LocalPlayer then return end
							bundleOpenTime = tick()
							openPanel("Shop")
							if ShopPanel.ActivateBundleTab then
								ShopPanel.ActivateBundleTab("brainrot_bundle")
							end
						end)
						log("[BrainrotBundle] Prompt recreated on poster")
					else
						if prompt.Parent ~= posterPart then
							prompt.Parent = posterPart
						end
						prompt.Enabled = true
					end
				end
				task.wait(6)
			end
		end)

		local GRACE_PERIOD = 3
		RunService.Heartbeat:Connect(function()
			if currentPanel ~= "Shop" then return end
			if (tick() - bundleOpenTime) &lt; GRACE_PERIOD then return end
			if bundleOpenTime == 0 then return end

			local char = LocalPlayer.Character
			if not char then return end
			local root = char:FindFirstChild("HumanoidRootPart")
			if not root then return end

			local dist = (root.Position - posterPart.Position).Magnitude
			if dist &gt; BUNDLE_CLOSE_DISTANCE then
				bundleOpenTime = 0
				closeCurrentPanel()
			end
		end)
	end)

	-- ═══════════════════════════════════════════════════════════════════
	-- WALK-UP: FNAF Bundle Display
	-- ═══════════════════════════════════════════════════════════════════
	task.spawn(function()
		local BUNDLE_OPEN_DISTANCE = 15
		local BUNDLE_CLOSE_DISTANCE = 30
		local bundleOpenTime = 0

		local function findFnafFolder(): Instance?
			local exact = workspace:FindFirstChild("FNAFGameBun") or workspace:FindFirstChild("FNAF Game Bun")
			if exact then return exact end
			for _, d in ipairs(workspace:GetDescendants()) do
				local n = string.lower(d.Name)
				if string.find(n, "fnaf", 1, true) and string.find(n, "bun", 1, true) then
					return d
				end
			end
			return nil
		end

		local fnafFolder = nil
		for attempt = 1, 300 do
			fnafFolder = findFnafFolder()
			if fnafFolder then break end
			task.wait(1)
		end

		if not fnafFolder then
			log("[FNAFBundle] Folder not found -- walk-up disabled")
			return
		end

		local promptPart: BasePart? = nil
		for attempt = 1, 6 do
			local posterModel = fnafFolder:FindFirstChild("Poster")
			if posterModel then
				promptPart = posterModel:FindFirstChildWhichIsA("BasePart")
			end
			if promptPart then break end
			task.wait(2)
		end
		if not promptPart then
			promptPart = fnafFolder:FindFirstChildWhichIsA("BasePart", true)
		end

		if not promptPart then
			log("[FNAFBundle] No poster BasePart -- walk-up disabled")
			return
		end
		log("[FNAFBundle] Poster part found: " .. promptPart:GetFullName() .. " at " .. tostring(promptPart.Position))

		local prompt: ProximityPrompt? = nil
		for _, desc in ipairs(fnafFolder:GetDescendants()) do
			if desc:IsA("ProximityPrompt") then
				prompt = desc
				break
			end
		end

		if not prompt then
			prompt = Instance.new("ProximityPrompt")
			prompt.Name = "FNAFBundlePrompt"
			prompt.ActionText = "Buy"
			prompt.ObjectText = "FNAF Bundle"
			prompt.KeyboardKeyCode = Enum.KeyCode.E
			prompt.HoldDuration = 0
			prompt.MaxActivationDistance = BUNDLE_OPEN_DISTANCE
			prompt.RequiresLineOfSight = false
			prompt.Parent = promptPart
			log("[FNAFBundle] Prompt parented directly to poster at " .. tostring(promptPart.Position))
		end
		print(string.format("[BundleIndicator] bundle=fnaf visible=true part=%s", promptPart:GetFullName()))

		prompt.Triggered:Connect(function(playerWhoTriggered)
			if playerWhoTriggered ~= LocalPlayer then return end
			local now = tick()
			if (now - lastPromptOpenAt) &lt; promptOpenCooldown then
				return
			end
			lastPromptOpenAt = now
			bundleOpenTime = tick()
			openedByFnafPrompt = true
			print("[ShopOpen] source=FNAFPrompt action=OPEN")
			if currentPanel ~= "Shop" then
				openPanel("Shop")
			else
				ShopPanel.Show()
			end
			if ShopPanel.ActivateBundleTab then
				ShopPanel.ActivateBundleTab("fnaf_pets_bundle")
			end
		end)

		local GRACE_PERIOD = 3
		RunService.Heartbeat:Connect(function()
			if currentPanel ~= "Shop" then return end
			if (tick() - bundleOpenTime) &lt; GRACE_PERIOD then return end
			if bundleOpenTime == 0 then return end

			local char = LocalPlayer.Character
			if not char then return end
			local root = char:FindFirstChild("HumanoidRootPart")
			if not root then return end

			local dist = (root.Position - promptPart.Position).Magnitude
			if dist &gt; BUNDLE_CLOSE_DISTANCE then
				bundleOpenTime = 0
				if openedByFnafPrompt and currentPanel == "Shop" then
					print(string.format("[ShopOpen] source=FNAFPrompt action=CLOSE reason=DISTANCE_%.1f", dist))
					openedByFnafPrompt = false
				end
				closeCurrentPanel()
			end
		end)
	end)

	if #_failedPanels &gt; 0 then
		warn("[UIController] DEGRADED: panels failed: " .. table.concat(_failedPanels, ", "))
	else
		print("[UIController] READY")
	end

	if DailyRewardsPanel and DailyRewardsPanel.TryAutoShow then
		DailyRewardsPanel.TryAutoShow(function()
			openPanel("Daily")
		end)
	end

	task.spawn(function()
		local ContentProvider = game:GetService("ContentProvider")
		local PRELOAD_ASSETS = {
			UIConfig.StudTexture.AssetId,
			"rbxassetid://71121412594159",
			"rbxassetid://125632977173073",
			"rbxassetid://74957106349993",
			"rbxassetid://96348372111632",
			"rbxassetid://140333135289717",
			"rbxassetid://130563974863986",
			"rbxassetid://70371140256856",
		}
		local preloadInstances = {}
		for _, assetId in ipairs(PRELOAD_ASSETS) do
			local img = Instance.new("ImageLabel")
			img.Image = assetId
			table.insert(preloadInstances, img)
		end
		local preloadOk, preloadErr = pcall(function()
			ContentProvider:PreloadAsync(preloadInstances)
		end)
		if preloadOk then
			print("[UIController] Asset preload complete --", #PRELOAD_ASSETS, "assets loaded successfully")
		else
			warn("[UIController] Asset preload FAILED:", preloadErr)
		end
		for _, inst in ipairs(preloadInstances) do
			inst:Destroy()
		end
	end)
end

return UIController</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="135">
          <Properties>
            <string name="Name">UIScalingController</string>
            <string name="Source">local UserInputService = game:GetService("UserInputService")
local Players = game:GetService("Players")

local UIScalingController = {}

local SCALE_PRESETS = {
	Phone   = 0.78,
	Tablet  = 1.00,
	Desktop = 0.90,
}

local SCALED_GUI_NAMES = {
	HUDGui = true,
	PanelGui = true,
	ModeVoteGui = true,
	MatchResultsGui = true,
}

local DAILY_PANEL_NAME = "DAILYREWARDSPanel"

local PHONE_SIDEBAR_SCALE = 0.65
local PHONE_SIDEBAR_TOP_INSET = -16
local PHONE_CELL_H_MULT = 0.88
local PHONE_PAD_Y_MULT = 0.6
local ORIG_CELL_H = 86
local ORIG_PAD_Y = 8

local DESKTOP_SIDEBAR_Y_OFFSET = 75

local PHONE_INTERMISSION_Y = -28
local PHONE_INTERMISSION_SCALE = 0.78
local PHONE_SIDEBAR_X_SHIFT = 6
local PHONE_COIN_SCALE = 0.55
local PHONE_COIN_Y_SHIFT = -6

local Camera = workspace.CurrentCamera
local deviceClass: string = "Desktop"
local trackedScales: { UIScale } = {}
local _sidebarPhoneTuned = false
local _sidebarDesktopOffset = false
local _intermissionPhoneTuned = false
local _coinPhoneTuned = false
local _origIntermissionY: number? = nil
local _origSidebarBgAlpha: number? = nil
local _origSidebarBgStrokeAlpha: number? = nil
local _origSidebarStudAlpha: number? = nil
local _playerGui: Instance? = nil

local function classify(): string
	local keyboard = UserInputService.KeyboardEnabled
	local touch = UserInputService.TouchEnabled

	if keyboard and not touch then
		return "Desktop"
	end

	if touch then
		local vp = Camera.ViewportSize
		local shortSide = math.min(vp.X, vp.Y)
		if shortSide &lt; 600 then
			return "Phone"
		else
			return "Tablet"
		end
	end

	return "Desktop"
end

local function trackGui(screenGui: ScreenGui)
	local existing = screenGui:FindFirstChild("ResponsiveScale")
	if existing and existing:IsA("UIScale") then
		for _, s in ipairs(trackedScales) do
			if s == existing then return end
		end
		table.insert(trackedScales, existing)
		existing.Scale = SCALE_PRESETS[deviceClass] or 1
		print(string.format("[UIScaling] Tracked existing GUI: %s (scale=%.2f)", screenGui.Name, existing.Scale))
		return
	end

	local s = Instance.new("UIScale")
	s.Name = "ResponsiveScale"
	s.Scale = SCALE_PRESETS[deviceClass] or 1
	s.Parent = screenGui
	table.insert(trackedScales, s)
	print(string.format("[UIScaling] Tracked new GUI: %s (scale=%.2f)", screenGui.Name, s.Scale))
end

local function applyScale()
	local newClass = classify()
	local vp = Camera.ViewportSize
	local changed = newClass ~= deviceClass
	deviceClass = newClass

	local scale = SCALE_PRESETS[deviceClass] or 1
	for _, uiScale in ipairs(trackedScales) do
		if uiScale and uiScale.Parent then
			uiScale.Scale = scale
		end
	end

	if changed then
		print(string.format(
			"[UI] DeviceClass = %s (viewport %dx%d) scale=%.2f",
			deviceClass, math.floor(vp.X), math.floor(vp.Y), scale
		))
	end
end

local function applyPhonePopupClamp(panel: GuiObject, maxWFrac: number, maxHFrac: number)
	if panel:FindFirstChild("PhoneSizeConstraint") then return end
	local vp = Camera.ViewportSize
	local scale = SCALE_PRESETS.Phone or 0.78
	local maxW = math.floor(vp.X * maxWFrac / scale)
	local maxH = math.floor(vp.Y * maxHFrac / scale)
	local constraint = Instance.new("UISizeConstraint")
	constraint.Name = "PhoneSizeConstraint"
	constraint.MaxSize = Vector2.new(maxW, maxH)
	constraint.Parent = panel
end

local function removePhoneClamp(panel: GuiObject)
	local existing = panel and panel:FindFirstChild("PhoneSizeConstraint")
	if existing then existing:Destroy() end
end

local function applyDailyRewardsPhoneConstraint()
	if deviceClass ~= "Phone" then return end
	if not _playerGui then return end
	local panelGui = _playerGui:FindFirstChild("PanelGui")
	if not panelGui then return end
	local dailyPanel = panelGui:FindFirstChild(DAILY_PANEL_NAME)
	if not dailyPanel then return end

	applyPhonePopupClamp(dailyPanel, 0.85, 0.80)

	for _, desc in ipairs(dailyPanel:GetDescendants()) do
		if desc.Name == "CardsArea" and desc:IsA("Frame") then
			desc.ClipsDescendants = true
			break
		end
	end

	print("[UI] DailyRewards applied phone constraints")
end

local function removeDailyRewardsPhoneConstraint()
	if not _playerGui then return end
	local panelGui = _playerGui:FindFirstChild("PanelGui")
	if not panelGui then return end
	local dailyPanel = panelGui:FindFirstChild(DAILY_PANEL_NAME)
	if not dailyPanel then return end
	removePhoneClamp(dailyPanel)
end

local function applyModeVotePhoneClamp()
	if deviceClass ~= "Phone" then return end
	if not _playerGui then return end
	local mvGui = _playerGui:FindFirstChild("ModeVoteGui")
	if not mvGui then return end
	local votePanel = mvGui:FindFirstChild("VotePanel")
	if not votePanel then return end
	applyPhonePopupClamp(votePanel, 0.85, 0.80)
	print("[UI] ModeVotePanel applied phone constraints")
end

local function removeModeVotePhoneClamp()
	if not _playerGui then return end
	local mvGui = _playerGui:FindFirstChild("ModeVoteGui")
	if not mvGui then return end
	local votePanel = mvGui:FindFirstChild("VotePanel")
	if votePanel then removePhoneClamp(votePanel) end
end

local function applyLeftStackPhoneTuning()
	if _sidebarPhoneTuned then return end

	local playerGui = Players.LocalPlayer and Players.LocalPlayer:FindFirstChild("PlayerGui")
	if not playerGui then return end
	local hudGui = playerGui:FindFirstChild("HUDGui")
	if not hudGui then return end

	local sidebarBg = hudGui:FindFirstChild("SidebarBg")
	local sidebar = hudGui:FindFirstChild("Sidebar")
	if not sidebarBg and not sidebar then return end

	if sidebarBg and not sidebarBg:FindFirstChild("PhoneSidebarScale") then
		local s = Instance.new("UIScale")
		s.Name = "PhoneSidebarScale"
		s.Scale = PHONE_SIDEBAR_SCALE
		s.Parent = sidebarBg

		local p = sidebarBg.Position
		sidebarBg.Position = UDim2.new(p.X.Scale, p.X.Offset + PHONE_SIDEBAR_X_SHIFT, p.Y.Scale, p.Y.Offset + PHONE_SIDEBAR_TOP_INSET)

		_origSidebarBgAlpha = sidebarBg.BackgroundTransparency
		sidebarBg.BackgroundTransparency = 1
		local bgStroke = sidebarBg:FindFirstChildWhichIsA("UIStroke")
		if bgStroke then
			_origSidebarBgStrokeAlpha = bgStroke.Transparency
			bgStroke.Transparency = 1
		end
		local bgStud = sidebarBg:FindFirstChild("StudTexture")
		if bgStud and bgStud:IsA("ImageLabel") then
			_origSidebarStudAlpha = bgStud.ImageTransparency
			bgStud.ImageTransparency = 1
		end
	end

	if sidebar and not sidebar:FindFirstChild("PhoneSidebarScale") then
		local s = Instance.new("UIScale")
		s.Name = "PhoneSidebarScale"
		s.Scale = PHONE_SIDEBAR_SCALE
		s.Parent = sidebar

		local p = sidebar.Position
		sidebar.Position = UDim2.new(p.X.Scale, p.X.Offset + PHONE_SIDEBAR_X_SHIFT, p.Y.Scale, p.Y.Offset + PHONE_SIDEBAR_TOP_INSET)

		local grid = sidebar:FindFirstChildWhichIsA("UIGridLayout")
		if grid then
			local cellX = grid.CellSize.X.Offset
			local padX = grid.CellPadding.X.Offset
			grid.CellSize = UDim2.fromOffset(cellX, math.floor(ORIG_CELL_H * PHONE_CELL_H_MULT))
			grid.CellPadding = UDim2.fromOffset(padX, math.max(3, math.floor(ORIG_PAD_Y * PHONE_PAD_Y_MULT)))
		end
	end

	_sidebarPhoneTuned = true

	local eff = (SCALE_PRESETS.Phone or 0.78) * PHONE_SIDEBAR_SCALE
	print(string.format(
		"[UI] DeviceClass=Phone -&gt; applying LeftStack phone tuning (sidebarScale=%.2f, inset=%d, effective=%.2f)",
		PHONE_SIDEBAR_SCALE, PHONE_SIDEBAR_TOP_INSET, eff
	))
end

local function removeLeftStackPhoneTuning()
	if not _sidebarPhoneTuned then return end

	local playerGui = Players.LocalPlayer and Players.LocalPlayer:FindFirstChild("PlayerGui")
	if not playerGui then return end
	local hudGui = playerGui:FindFirstChild("HUDGui")
	if not hudGui then return end

	for _, name in ipairs({"SidebarBg", "Sidebar"}) do
		local frame = hudGui:FindFirstChild(name)
		if frame then
			local ps = frame:FindFirstChild("PhoneSidebarScale")
			if ps then ps:Destroy() end

			local p = frame.Position
			frame.Position = UDim2.new(p.X.Scale, p.X.Offset - PHONE_SIDEBAR_X_SHIFT, p.Y.Scale, p.Y.Offset - PHONE_SIDEBAR_TOP_INSET)
		end
	end

	local sidebarBg = hudGui:FindFirstChild("SidebarBg")
	if sidebarBg then
		if _origSidebarBgAlpha ~= nil then
			sidebarBg.BackgroundTransparency = _origSidebarBgAlpha
			_origSidebarBgAlpha = nil
		end
		local bgStroke = sidebarBg:FindFirstChildWhichIsA("UIStroke")
		if bgStroke and _origSidebarBgStrokeAlpha ~= nil then
			bgStroke.Transparency = _origSidebarBgStrokeAlpha
			_origSidebarBgStrokeAlpha = nil
		end
		local bgStud = sidebarBg:FindFirstChild("StudTexture")
		if bgStud and bgStud:IsA("ImageLabel") and _origSidebarStudAlpha ~= nil then
			bgStud.ImageTransparency = _origSidebarStudAlpha
			_origSidebarStudAlpha = nil
		end
	end

	local sidebar = hudGui:FindFirstChild("Sidebar")
	if sidebar then
		local grid = sidebar:FindFirstChildWhichIsA("UIGridLayout")
		if grid then
			grid.CellSize = UDim2.fromOffset(86, ORIG_CELL_H)
			grid.CellPadding = UDim2.fromOffset(8, ORIG_PAD_Y)
		end
	end

	_sidebarPhoneTuned = false
end

local function applyDesktopLeftStackOffset()
	if _sidebarDesktopOffset then return end
	if not _playerGui then return end
	local hudGui = _playerGui:FindFirstChild("HUDGui")
	if not hudGui then return end

	for _, name in ipairs({"SidebarBg", "Sidebar"}) do
		local frame = hudGui:FindFirstChild(name)
		if frame then
			local p = frame.Position
			frame.Position = UDim2.new(p.X.Scale, p.X.Offset, p.Y.Scale, p.Y.Offset + DESKTOP_SIDEBAR_Y_OFFSET)
		end
	end

	_sidebarDesktopOffset = true
	print(string.format("[UI] Desktop detected -&gt; applying LeftStack Y offset (+%dpx)", DESKTOP_SIDEBAR_Y_OFFSET))
end

local function removeDesktopLeftStackOffset()
	if not _sidebarDesktopOffset then return end
	if not _playerGui then return end
	local hudGui = _playerGui:FindFirstChild("HUDGui")
	if not hudGui then return end

	for _, name in ipairs({"SidebarBg", "Sidebar"}) do
		local frame = hudGui:FindFirstChild(name)
		if frame then
			local p = frame.Position
			frame.Position = UDim2.new(p.X.Scale, p.X.Offset, p.Y.Scale, p.Y.Offset - DESKTOP_SIDEBAR_Y_OFFSET)
		end
	end

	_sidebarDesktopOffset = false
end

local function applyIntermissionPhoneTuning()
	if _intermissionPhoneTuned then return end
	if not _playerGui then return end
	local hudGui = _playerGui:FindFirstChild("HUDGui")
	if not hudGui then return end
	local bar = hudGui:FindFirstChild("IntermissionBar")
	if not bar then return end
	_origIntermissionY = bar.Position.Y.Offset
	bar.Position = UDim2.new(bar.Position.X.Scale, bar.Position.X.Offset, 0, PHONE_INTERMISSION_Y)

	if not bar:FindFirstChild("PhoneIntermissionScale") then
		local s = Instance.new("UIScale")
		s.Name = "PhoneIntermissionScale"
		s.Scale = PHONE_INTERMISSION_SCALE
		s.Parent = bar
	end

	_intermissionPhoneTuned = true
	print(string.format("[UI] Phone -&gt; IntermissionBar moved higher (Y=%d) scaled %.2f", PHONE_INTERMISSION_Y, PHONE_INTERMISSION_SCALE))
end

local function removeIntermissionPhoneTuning()
	if not _intermissionPhoneTuned then return end
	if not _playerGui then return end
	local hudGui = _playerGui:FindFirstChild("HUDGui")
	if not hudGui then return end
	local bar = hudGui:FindFirstChild("IntermissionBar")
	if bar then
		local ps = bar:FindFirstChild("PhoneIntermissionScale")
		if ps then ps:Destroy() end
		if _origIntermissionY ~= nil then
			bar.Position = UDim2.new(bar.Position.X.Scale, bar.Position.X.Offset, 0, _origIntermissionY)
			_origIntermissionY = nil
		end
	end
	_intermissionPhoneTuned = false
end

local function applyCoinFramePhoneTuning()
	if _coinPhoneTuned then return end
	if not _playerGui then return end
	local hudGui = _playerGui:FindFirstChild("HUDGui")
	if not hudGui then return end
	local coinFrame = hudGui:FindFirstChild("CoinFrame")
	if not coinFrame then return end

	if not coinFrame:FindFirstChild("PhoneCoinScale") then
		local s = Instance.new("UIScale")
		s.Name = "PhoneCoinScale"
		s.Scale = PHONE_COIN_SCALE
		s.Parent = coinFrame
	end

	local shadow = coinFrame:FindFirstChild("Shadow")
	if shadow then
		shadow.Size = UDim2.new(1, 4, 1, 4)
	end

	local p = coinFrame.Position
	coinFrame.Position = UDim2.new(p.X.Scale, p.X.Offset, p.Y.Scale, p.Y.Offset + PHONE_COIN_Y_SHIFT)

	_coinPhoneTuned = true
	print(string.format("[UI] Phone -&gt; CoinFrame scaled to %.2f, Y shifted %d, shadow shrunk", PHONE_COIN_SCALE, PHONE_COIN_Y_SHIFT))
end

local function removeCoinFramePhoneTuning()
	if not _coinPhoneTuned then return end
	if not _playerGui then return end
	local hudGui = _playerGui:FindFirstChild("HUDGui")
	if not hudGui then return end
	local coinFrame = hudGui:FindFirstChild("CoinFrame")
	if coinFrame then
		local ps = coinFrame:FindFirstChild("PhoneCoinScale")
		if ps then ps:Destroy() end
		local shadow = coinFrame:FindFirstChild("Shadow")
		if shadow then
			shadow.Size = UDim2.new(1, 12, 1, 12)
		end
		local p = coinFrame.Position
		coinFrame.Position = UDim2.new(p.X.Scale, p.X.Offset, p.Y.Scale, p.Y.Offset - PHONE_COIN_Y_SHIFT)
	end
	_coinPhoneTuned = false
end

local function applyPhoneTuning()
	applyLeftStackPhoneTuning()
	applyDailyRewardsPhoneConstraint()
	applyModeVotePhoneClamp()
	applyIntermissionPhoneTuning()
	applyCoinFramePhoneTuning()
end

local function removePhoneTuning()
	removeLeftStackPhoneTuning()
	removeDailyRewardsPhoneConstraint()
	removeModeVotePhoneClamp()
	removeIntermissionPhoneTuning()
	removeCoinFramePhoneTuning()
end

local function onViewportChanged()
	local oldClass = deviceClass
	applyScale()
	if deviceClass == "Desktop" then
		removePhoneTuning()
		applyDesktopLeftStackOffset()
	elseif deviceClass == "Phone" then
		removeDesktopLeftStackOffset()
		applyPhoneTuning()
	else
		removeDesktopLeftStackOffset()
		removePhoneTuning()
		print("[UI] Tablet -&gt; no LeftStack offset applied")
	end
end

local function runUIAudit()
	if not _playerGui then return end

	local auditTargets = {
		{ name = "DailyRewards",  guiName = "PanelGui",         frameName = DAILY_PANEL_NAME },
		{ name = "ModeVote",      guiName = "ModeVoteGui",      frameName = "VotePanel" },
		{ name = "PremiumShop",   guiName = "PanelGui",         frameName = "PREMIUMSHOPPanel" },
		{ name = "FateCrowns",    guiName = "PanelGui",         frameName = "FATECROWNSPanel" },
		{ name = "MatchResults",  guiName = "MatchResultsGui",  frameName = "ResultsPanel" },
		{ name = "RewardPopup",   guiName = "RewardPopupGui",   frameName = "RewardFrame" },
		{ name = "BrainrotPopup", guiName = "BrainrotPickupGui",frameName = "PopupFrame" },
	}

	for _, target in ipairs(auditTargets) do
		local gui = _playerGui:FindFirstChild(target.guiName)
		local frame = gui and gui:FindFirstChild(target.frameName)
		local scaleCount = 0
		local hasAspect = false

		if gui then
			for _, d in ipairs(gui:GetDescendants()) do
				if d:IsA("UIScale") then scaleCount += 1 end
				if d:IsA("UIAspectRatioConstraint") then hasAspect = true end
			end
		end

		local path = "NOT_FOUND"
		if frame then
			path = frame:GetFullName()
		elseif gui then
			path = gui:GetFullName() .. ".&lt;" .. target.frameName .. " missing&gt;"
		end

		print(string.format(
			"[UIAudit] %s path=%s | UIScales=%d | HasAspect=%s",
			target.name, path, scaleCount, tostring(hasAspect)
		))
	end
end

function UIScalingController.Init()
	local playerGui = Players.LocalPlayer and Players.LocalPlayer:WaitForChild("PlayerGui", 10)
	if not playerGui then
		warn("[UI] PlayerGui not found -- scaling disabled")
		return
	end
	_playerGui = playerGui

	for _, child in ipairs(playerGui:GetChildren()) do
		if child:IsA("ScreenGui") and SCALED_GUI_NAMES[child.Name] then
			trackGui(child)
		end
	end

	playerGui.ChildAdded:Connect(function(child)
		if child:IsA("ScreenGui") and SCALED_GUI_NAMES[child.Name] then
			trackGui(child)
			if deviceClass == "Phone" then
				task.defer(function()
					applyModeVotePhoneClamp()
				end)
			end
		end
	end)

	if #trackedScales == 0 then
		warn("[UI] No ResponsiveScale instances found -- scaling disabled")
		return
	end

	applyScale()

	local vp = Camera.ViewportSize
	print(string.format(
		"[UI] DeviceClass = %s (viewport %dx%d) scale=%.2f  tracked=%d",
		deviceClass, math.floor(vp.X), math.floor(vp.Y),
		SCALE_PRESETS[deviceClass] or 1, #trackedScales
	))

	if deviceClass == "Desktop" then
		applyDesktopLeftStackOffset()
	elseif deviceClass == "Phone" then
		applyPhoneTuning()
	else
		print("[UI] Tablet -&gt; no LeftStack offset applied")
	end

	runUIAudit()

	Camera:GetPropertyChangedSignal("ViewportSize"):Connect(onViewportChanged)
end

function UIScalingController.GetDeviceClass(): string
	return deviceClass
end

return UIScalingController</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="136">
          <Properties>
            <string name="Name">WorldIndicators</string>
            <string name="Source"><![CDATA[--[[
	WorldIndicators
	Creates small floating badge labels above key lobby objects:
	  • "SPIN THE WHEEL" above game.Workspace.SpinTheWheel
	  • "CRATE SHOP" above game.Workspace.CrownPetShop
	  • "BRAINROT BUNDLE" above game.Workspace.Brainrot Game Bun

	ANCHORING: For each target, computes the bounding box of ALL
	descendant BaseParts, then creates an invisible anchor Part at
	the true top-center (centerX, topY + padding, centerZ).
	The BillboardGui adorns this anchor with StudsOffset=(0,0,0).

	Badges are pill-shaped, compact, high-contrast, with subtle gradient.
	Duplicate-safe: reuses existing anchors and checks for existing billboards.

	Called from: init.client.luau via WorldIndicators.Init()
]]

local TweenService = game:GetService("TweenService")

local WorldIndicators = {}

-- ═══════════════════════════════════════════════════════════════════
-- CONFIG
-- ═══════════════════════════════════════════════════════════════════

local INDICATORS = {
	{
		targetName   = "SpinTheWheel",
		text         = "SPIN THE WHEEL",
		extraPadding = 4,
	},
	{
		targetName   = "CrownPetShop",
		text         = "CRATE SHOP",
		extraPadding = 3,
	},
	{
		targetName   = "JJK Game Bun",
		text         = "COMING SOON",
		extraPadding = 4,
	},
	{
		targetName   = "Brainrot Game Bun",
		text         = "BRAINROT BUNDLE",
		extraPadding = 4,
		pulse        = true,
	},
	{
		targetName   = "FNAFGameBun",
		text         = "FNAF BUNDLE",
		extraPadding = 4,
		pulse        = true,
		retries      = 120,
	},
	{
		targetName   = "FNAF Game Bun",
		text         = "FNAF BUNDLE",
		extraPadding = 4,
		pulse        = true,
		retries      = 120,
	},
}

local BILLBOARD_SIZE      = UDim2.fromOffset(150, 34)
local MAX_TEXT_SIZE       = 14
local MIN_TEXT_SIZE       = 8
local ICON_SIZE           = 22
local MAX_DISTANCE        = 100

local BG_COLOR            = Color3.fromRGB(16, 20, 38)
local BG_TRANSPARENCY     = 0.08
local STROKE_COLOR        = Color3.fromRGB(180, 200, 255)
local STROKE_THICKNESS    = 1.2
local STROKE_TRANSPARENCY = 0.45
local CORNER_RADIUS       = UDim.new(0, 17)
local TEXT_COLOR           = Color3.fromRGB(255, 255, 255)
local TEXT_STROKE_COLOR    = Color3.fromRGB(0, 0, 0)
local TEXT_STROKE_THICK    = 1.5
local GRAD_TOP             = Color3.fromRGB(30, 36, 64)
local GRAD_BOT             = Color3.fromRGB(12, 14, 28)

local ANCHOR_PREFIX = "WorldIndicatorAnchor_"

-- ═══════════════════════════════════════════════════════════════════
-- HELPERS
-- ═══════════════════════════════════════════════════════════════════

local function log(...)
	print("[WorldIndicators]", ...)
end

local function findTargetByNameHint(targetName: string): Instance?
	local exactTop = workspace:FindFirstChild(targetName)
	if exactTop then return exactTop end

	local exact = workspace:FindFirstChild(targetName, true)
	if exact then return exact end
	local lowerTarget = string.lower(targetName)
	if targetName == "Brainrot Game Bun" then
		local best: Instance? = nil
		local bestParts = -1
		for _, d in ipairs(workspace:GetDescendants()) do
			if d.Name == targetName and (d:IsA("Model") or d:IsA("Folder")) then
				local parts = 0
				for _, p in ipairs(d:GetDescendants()) do
					if p:IsA("BasePart") then
						parts += 1
					end
				end
				if parts > bestParts then
					best = d
					bestParts = parts
				end
			end
		end
		if best then
			return best
		end
	end
	if string.find(lowerTarget, "fnaf", 1, true) and string.find(lowerTarget, "bun", 1, true) then
		for _, d in ipairs(workspace:GetDescendants()) do
			local n = string.lower(d.Name)
			if string.find(n, "fnaf", 1, true) and string.find(n, "bun", 1, true) then
				return d
			end
		end
	end
	return nil
end

local function cleanupDuplicateIndicators(text: string, keepAnchor: BasePart)
	local keepGui = "WorldIndicator_" .. text:gsub("%s+", "")
	for _, d in ipairs(workspace:GetDescendants()) do
		if d:IsA("BillboardGui") then
			if d.Name == keepGui then
				local label = d:FindFirstChild("Badge")
				label = label and label:FindFirstChild("Label")
				local sameText = label and label:IsA("TextLabel") and label.Text == text
				local sameAnchor = (d.Parent == keepAnchor)
				if sameText and not sameAnchor then
					d:Destroy()
				end
			end
		end
	end
end

--- Compute axis-aligned bounding box from ALL descendant BaseParts.
--- Returns centerX, centerZ, topY, bboxSize  OR  nil x4 if no parts found.
local function computeBounds(instance: Instance): (number?, number?, number?, Vector3?)
	local minX, minY, minZ =  math.huge,  math.huge,  math.huge
	local maxX, maxY, maxZ = -math.huge, -math.huge, -math.huge
	local found = false

	for _, desc in ipairs(instance:GetDescendants()) do
		if desc:IsA("BasePart") then
			found = true
			local pos = desc.Position
			local half = desc.Size * 0.5
			minX = math.min(minX, pos.X - half.X)
			maxX = math.max(maxX, pos.X + half.X)
			minY = math.min(minY, pos.Y - half.Y)
			maxY = math.max(maxY, pos.Y + half.Y)
			minZ = math.min(minZ, pos.Z - half.Z)
			maxZ = math.max(maxZ, pos.Z + half.Z)
		end
	end

	if not found then return nil, nil, nil, nil end
	local size = Vector3.new(maxX - minX, maxY - minY, maxZ - minZ)
	return (minX + maxX) / 2, (minZ + maxZ) / 2, maxY, size
end

local function computeAnchorPosition(target: Instance, padding: number): (Vector3?, Vector3?)
	local cx, cz, topY, bboxSize = computeBounds(target)
	if not cx then
		return nil, nil
	end
	return Vector3.new(cx, topY + padding, cz), bboxSize
end

local function findBrainrotAnchorPart(target: Instance): BasePart?
	-- Deterministic Brainrot anchor rule:
	-- use one explicit stable display part only, never generic/floor/top-extents fallback.
	-- This keeps the badge above/on the visible Brainrot bun (matching Crate/Spin style).
	local displayPart = target:FindFirstChild("Steve Harrington Icon Image")
	if displayPart and displayPart:IsA("BasePart") then
		return displayPart
	end
	return nil
end

--- Find or create an invisible anchor Part at the bounding-box top-center.
--- Reuses existing anchor if already present (streaming/respawn safe).
local function getOrCreateAnchor(target: Instance, targetName: string, padding: number): BasePart?
	local anchorName = ANCHOR_PREFIX .. targetName

	local anchorPos, bboxSize
	if targetName == "Brainrot Game Bun" then
		local brainrotPart = findBrainrotAnchorPart(target)
		if not brainrotPart then
			return nil
		end
		local topY = brainrotPart.Position.Y + brainrotPart.Size.Y * 0.5
		anchorPos = Vector3.new(brainrotPart.Position.X, topY + padding, brainrotPart.Position.Z)
		bboxSize = brainrotPart.Size
	else
		-- Always recompute desired position from LIVE bounds so streaming cannot leave a stale anchor.
		anchorPos, bboxSize = computeAnchorPosition(target, padding)
		if not anchorPos then return nil end
	end

	-- Reuse existing anchor, but refresh position to live bounds.
	local existing = target:FindFirstChild(anchorName)
	if existing and existing:IsA("BasePart") then
		-- Keep a single authoritative placement source; always snap to its live value.
		existing.Position = anchorPos
		return existing
	end

	local anchor = Instance.new("Part")
	anchor.Name = anchorName
	anchor.Size = Vector3.new(0.5, 0.5, 0.5)
	anchor.Position = anchorPos
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.CanTouch = false
	anchor.Transparency = 1
	anchor.Parent = target

	log(string.format("%s anchor at (%.1f, %.1f, %.1f) bboxSize=(%.1f, %.1f, %.1f)",
		targetName, anchorPos.X, anchorPos.Y, anchorPos.Z,
		bboxSize.X, bboxSize.Y, bboxSize.Z))

	return anchor
end

-- ═══════════════════════════════════════════════════════════════════
-- CREATE BADGE
-- ═══════════════════════════════════════════════════════════════════

local function createBadge(adornee: BasePart, text: string)
	local billboard = Instance.new("BillboardGui")
	billboard.Name = "WorldIndicator_" .. text:gsub("%s+", "")
	billboard.Adornee = adornee
	billboard.Size = BILLBOARD_SIZE
	billboard.StudsOffset = Vector3.new(0, 0, 0)
	billboard.AlwaysOnTop = true
	billboard.MaxDistance = MAX_DISTANCE
	billboard.LightInfluence = 0
	billboard.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	billboard.Parent = adornee

	local bg = Instance.new("Frame")
	bg.Name = "Badge"
	bg.Size = UDim2.fromScale(1, 1)
	bg.BackgroundColor3 = BG_COLOR
	bg.BackgroundTransparency = BG_TRANSPARENCY
	bg.BorderSizePixel = 0
	bg.Parent = billboard

	Instance.new("UICorner", bg).CornerRadius = CORNER_RADIUS

	local grad = Instance.new("UIGradient")
	grad.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, GRAD_TOP),
		ColorSequenceKeypoint.new(1, GRAD_BOT),
	})
	grad.Rotation = 90
	grad.Parent = bg

	local bgStroke = Instance.new("UIStroke")
	bgStroke.Color = STROKE_COLOR
	bgStroke.Thickness = STROKE_THICKNESS
	bgStroke.Transparency = STROKE_TRANSPARENCY
	bgStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	bgStroke.Parent = bg

	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0, 8)
	pad.PaddingRight = UDim.new(0, 8)
	pad.Parent = bg

	local label = Instance.new("TextLabel")
	label.Name = "Label"
	label.AnchorPoint = Vector2.new(0.5, 0.5)
	label.Position = UDim2.new(0.5, 0, 0.5, 0)
	label.Size = UDim2.new(1, -16, 0, 20)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBold
	label.TextColor3 = TEXT_COLOR
	label.TextSize = MAX_TEXT_SIZE
	label.TextScaled = true
	label.TextXAlignment = Enum.TextXAlignment.Center
	label.Text = text
	label.Parent = bg

	local textConstraint = Instance.new("UITextSizeConstraint")
	textConstraint.MaxTextSize = MAX_TEXT_SIZE
	textConstraint.MinTextSize = MIN_TEXT_SIZE
	textConstraint.Parent = label

	local textStroke = Instance.new("UIStroke")
	textStroke.Color = TEXT_STROKE_COLOR
	textStroke.Thickness = TEXT_STROKE_THICK
	textStroke.Transparency = 0.15
	textStroke.Parent = label

	return billboard
end

local function startPulse(billboard: BillboardGui)
	local bg = billboard:FindFirstChild("Badge")
	if not bg then return end
	local uiScale = Instance.new("UIScale")
	uiScale.Scale = 1
	uiScale.Parent = bg

	task.spawn(function()
		local tweenUp = TweenService:Create(uiScale,
			TweenInfo.new(0.8, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
			{ Scale = 1.06 })
		local tweenDown = TweenService:Create(uiScale,
			TweenInfo.new(0.8, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
			{ Scale = 1.0 })
		while uiScale and uiScale.Parent do
			tweenUp:Play()
			tweenUp.Completed:Wait()
			tweenDown:Play()
			tweenDown.Completed:Wait()
		end
	end)
end

-- ═══════════════════════════════════════════════════════════════════
-- INIT
-- ═══════════════════════════════════════════════════════════════════

function WorldIndicators.Init()
	local successCount = 0

	for _, cfg in ipairs(INDICATORS) do
		task.spawn(function()
			-- Find target with retries (streaming)
			local target = nil
			local retries = cfg.retries or 12
			local initDelayedUntilAnchor = false
			for attempt = 1, retries do
				target = findTargetByNameHint(cfg.targetName)
				if target then break end
				log(cfg.targetName .. " not ready — retrying...")
				task.wait(1)
			end
			if not target then
				warn("[WorldIndicators] " .. cfg.targetName .. " not found after retries — skipped")
				return
			end

			-- Wait for descendant BaseParts to stream in, then create anchor
			local anchor = nil
			if cfg.targetName == "Brainrot Game Bun" then
				local anchorPart = nil
				for attempt = 1, 120 do
					anchorPart = findBrainrotAnchorPart(target)
					if anchorPart then break end
					initDelayedUntilAnchor = true
					log("[BrainrotPrompt] anchorFound=false placementSource=BrainrotDisplayPart initDelayedUntilAnchor=true")
					task.wait(1)
				end
				if anchorPart then
					log(string.format("[BrainrotPrompt] anchorFound=%s placementSource=BrainrotDisplayPart initDelayedUntilAnchor=%s",
						anchorPart:GetFullName(), tostring(initDelayedUntilAnchor)))
				end
				anchor = getOrCreateAnchor(target, cfg.targetName, cfg.extraPadding or 3)
			else
				for attempt = 1, 10 do
					anchor = getOrCreateAnchor(target, cfg.targetName, cfg.extraPadding or 3)
					if anchor then break end
					log(cfg.targetName .. " not ready — retrying...")
					task.wait(1)
				end
			end
			if not anchor then
				warn("[WorldIndicators] " .. cfg.targetName .. " missing BasePart — skipped")
				return
			end

			-- Duplicate guard
			local indicatorName = "WorldIndicator_" .. cfg.text:gsub("%s+", "")
			if anchor:FindFirstChild(indicatorName) then
				log(cfg.targetName .. ": indicator already exists, skipping")
				return
			end

			local billboard = createBadge(anchor, cfg.text, cfg.icon)
			cleanupDuplicateIndicators(cfg.text, anchor)
			if cfg.pulse then
				startPulse(billboard)
			end
			-- Brainrot indicator is fixed-anchor only (no runtime re-position loop).
			if cfg.targetName == "Brainrot Game Bun" then
				log(string.format("[BrainrotPrompt] finalY=%.2f placementSource=BrainrotDisplayPart", anchor.Position.Y))
			end
			successCount += 1
			log(string.format("Created: %s above %s", cfg.text, cfg.targetName))
		end)
	end

	log("Initialized OK")
end

return WorldIndicators
