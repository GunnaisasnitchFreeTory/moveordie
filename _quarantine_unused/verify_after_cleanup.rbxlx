      <Item class="Script" referent="71">
        <Properties>
          <string name="Name">PlayerDataBootstrap</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--[[
	PlayerDataBootstrap
	Initializes the persistence + equip + crate + level crown systems and wires player events.

	Runs once on server start. Must run EARLY (before MatchBootstrap).

	Systems initialized:
	  * PlayerDataService  (DataStore load / save)
	  * InventoryService   (equip / unequip validation)
	  * StatService         (stat calculation)
	  * CrateService        (crate opening logic)
	  * LevelCrownService   (wins milestone crown granting)
	  * RemoteEvents/Functions for client equip + crate actions
	  * Leaderboard seed-on-join (via GlobalLeaderboardService)
]]

local Players             = game:GetService("Players")
local ServerScriptService = game:GetService("ServerScriptService")
local ReplicatedStorage   = game:GetService("ReplicatedStorage")
local RunService          = game:GetService("RunService")

local Server = ServerScriptService:WaitForChild("Server")

local PlayerDataService   = require(Server:WaitForChild("PlayerDataService"))
local InventoryService    = require(Server:WaitForChild("InventoryService"))
local StatService         = require(Server:WaitForChild("StatService"))
local CrateService        = require(Server:WaitForChild("CrateService"))
local LevelCrownService   = require(Server:WaitForChild("LevelCrownService"))
local CrownAttachService  = require(Server:WaitForChild("CrownAttachService"))
local DailyRewardService  = require(Server:WaitForChild("DailyRewardService"))

local PlayerStateService  = require(Server:WaitForChild("PlayerStateService"))

local Shared      = ReplicatedStorage:WaitForChild("Shared")
local PlayerState = require(Shared:WaitForChild("PlayerState"))
local ItemCatalog = require(Shared:WaitForChild("ItemCatalog"))

local IS_STUDIO = RunService:IsStudio()

-- =====================================================================
-- BUILD_ID + SERVER IDENTITY  (visible in-game for version verification)
-- =====================================================================
local BUILD_ID = os.date("!%Y%m%d_%H%M", os.time())
local BUILD_LABEL = string.format("v%s | Place:%s | Game:%s",
	BUILD_ID, tostring(game.PlaceId), tostring(game.GameId))

warn("[BUILD] " .. BUILD_LABEL)

do
	local buildVal = ReplicatedStorage:FindFirstChild("BUILD_ID")
	if not buildVal then
		buildVal = Instance.new("StringValue")
		buildVal.Name = "BUILD_ID"
		buildVal.Parent = ReplicatedStorage
	end
	buildVal.Value = BUILD_LABEL
end

if ItemCatalog.ValidateAcquisitionLabels then
	ItemCatalog.ValidateAcquisitionLabels()
end

-- =====================================================================
-- STUDIO DEBUG: Grant all crowns + pets on join  (set to false to disable)
-- STUDIO_RESET_STATS: Reset ALL stats to 0 on join so testing starts fresh
-- =====================================================================
local STUDIO_GRANT_ALL   = false
local STUDIO_RESET_STATS = false

local function stripFNAFRigging()
	local function getOrCreateRoot(model: Model): BasePart?
		local root = model:FindFirstChild("Root")
		if root and root:IsA("BasePart") then
			model.PrimaryPart = root
			return root
		end
		local primary = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart", true)
		if not primary then
			return nil
		end
		primary.Name = "Root"
		model.PrimaryPart = primary
		return primary
	end

	local function ensureUnifiedAssembly(model: Model, root: BasePart)
		local connected = { [root] = true }
		for _, part in ipairs(root:GetConnectedParts(true)) do
			connected[part] = true
		end
		for _, d in ipairs(model:GetDescendants()) do
			if d:IsA("BasePart") then
				if not connected[d] and d ~= root then
					local weld = Instance.new("WeldConstraint")
					weld.Part0 = root
					weld.Part1 = d
					weld.Parent = d
				end
				d.CanCollide = false
				d.CanQuery = false
				d.CanTouch = false
				d.Massless = true
			end
		end
	end

	local function cleanupContainer(container: Instance?)
		if not container then return end
		for _, model in ipairs(container:GetChildren()) do
			if model:IsA("Model") then
				local root = getOrCreateRoot(model)
				for _, d in ipairs(model:GetDescendants()) do
					if d:IsA("Motor6D")
						or d:IsA("AnimationController")
						or d:IsA("Animator")
						or (d:IsA("Folder") and (d.Name == "Rig" or d.Name == "Motors"))
						or (d:IsA("Script") and string.find(string.lower(d.Name), "rig", 1, true))
					then
						d:Destroy()
					end
				end
				if root then
					ensureUnifiedAssembly(model, root)
				end
			end
		end
	end

	local petsRoot = ReplicatedStorage:FindFirstChild("Pets")
	local fnafDirect = petsRoot and petsRoot:FindFirstChild("Epic") and petsRoot.Epic:FindFirstChild("FNAF")
	cleanupContainer(fnafDirect)

	local itemModels = ReplicatedStorage:FindFirstChild("ItemModels")
	local fnafCatalog = itemModels
		and itemModels:FindFirstChild("Pets")
		and itemModels.Pets:FindFirstChild("Epic")
		and itemModels.Pets.Epic:FindFirstChild("FNAF")
	cleanupContainer(fnafCatalog)
end

-- Initialize services
PlayerDataService.Init()
InventoryService.Init()
StatService.Init()
CrateService.Init()
LevelCrownService.Init()
CrownAttachService.Init()
DailyRewardService.Init()
stripFNAFRigging()

-- =====================================================================
-- LAZY-LOAD GLBS (avoid circular require; GLBS may not be init yet)
-- =====================================================================
local _GLBS = nil
local function getGLBS()
	if _GLBS ~= nil then return _GLBS end
	local ok, mod = pcall(function()
		return require(Server:WaitForChild("GlobalLeaderboardService", 10))
	end)
	if ok and mod then
		_GLBS = mod
	else
		_GLBS = false
		warn("[PlayerDataBootstrap] GLBS not available:", tostring(mod))
	end
	return _GLBS
end

local function isValidUserId(userId: number): boolean
	if type(userId) ~= "number" then return false end
	if userId == 0 then return false end
	if userId > 0 then return true end
	return IS_STUDIO
end

-- =====================================================================
-- REMOTE EVENTS FOR EQUIP / UNEQUIP
-- =====================================================================

local remotesFolder = ReplicatedStorage:FindFirstChild("Remotes")
if not remotesFolder then
	remotesFolder = Instance.new("Folder")
	remotesFolder.Name = "Remotes"
	remotesFolder.Parent = ReplicatedStorage
end

local function ensureRemote(name: string): RemoteEvent
	local event = remotesFolder:FindFirstChild(name)
	if not event then
		event = Instance.new("RemoteEvent")
		event.Name = name
		event.Parent = remotesFolder
	end
	return event
end

local function ensureRemoteFunction(name: string): RemoteFunction
	local func = remotesFolder:FindFirstChild(name)
	if not func then
		func = Instance.new("RemoteFunction")
		func.Name = name
		func.Parent = remotesFolder
	end
	return func
end

local equipEvent      = ensureRemote("EquipItem")
local unequipEvent    = ensureRemote("UnequipItem")
local inventoryUpdate = ensureRemote("InventoryUpdated")
local openCrateFunc   = ensureRemoteFunction("OpenCrate")
local buyCrateFunc    = ensureRemoteFunction("BuyCrate")
local getCratesFunc   = ensureRemoteFunction("GetOwnedCrates")
local openOwnedCratesFunc = ensureRemoteFunction("OpenOwnedCrates")

equipEvent.OnServerEvent:Connect(function(player, category, id)
	if type(category) ~= "string" or type(id) ~= "string" then return end
	if not PlayerDataService.IsLoaded(player) then
		warn("[PlayerDataBootstrap] Equip rejected -- data not loaded for", player.Name)
		return
	end

	local state = PlayerStateService.GetState(player)
	if state == PlayerState.States.InMatch then
		warn(string.format("[PlayerDataBootstrap] Equip rejected -- %s is InMatch (cannot change %s/%s)",
			player.Name, category, id))
		return
	end

	local result = InventoryService.EquipItem(player, category, id)
	if result.success then
		StatService.RecalculateStats(player)
	else
		warn(string.format("[PlayerDataBootstrap] Equip failed %s: %s/%s -- %s",
			player.Name, category, id, result.reason or "unknown"))
	end
end)

unequipEvent.OnServerEvent:Connect(function(player, category)
	if type(category) ~= "string" then return end
	if not PlayerDataService.IsLoaded(player) then return end

	local state = PlayerStateService.GetState(player)
	if state == PlayerState.States.InMatch then
		warn(string.format("[PlayerDataBootstrap] Unequip rejected -- %s is InMatch (cannot change %s)",
			player.Name, category))
		return
	end

	local result = InventoryService.UnequipItem(player, category)
	if result.success then
		StatService.RecalculateStats(player)
	end
end)

-- =====================================================================
-- CRATE OPENING (RemoteFunction -- client needs the result back)
-- =====================================================================

openCrateFunc.OnServerInvoke = function(player, crateId, quantity)
	if not PlayerDataService.IsLoaded(player) then
		return { results = {}, success = false, error = "Data not loaded" }
	end

	local result = CrateService.OpenCrate(player, crateId, quantity)

	if result.success and #result.results > 0 then
		inventoryUpdate:FireClient(player, "CrateOpened", result.results)
	end

	return result
end

buyCrateFunc.OnServerInvoke = function(player, crateId, quantity, currencyCode)
	print(string.format("[CrateBuy] START player=%s crateType=%s qty=%s currency=%s",
		player.Name, tostring(crateId), tostring(quantity), tostring(currencyCode)))
	if not PlayerDataService.IsLoaded(player) then
		print("[CrateBuy] FAIL reason=Data not loaded")
		return { success = false, reason = "Data not loaded" }
	end
	if type(currencyCode) ~= "string" then
		print("[CrateBuy] FAIL reason=Invalid currency")
		return { success = false, reason = "Invalid currency" }
	end
	if currencyCode ~= "Coins" then
		print("[CrateBuy] FAIL reason=Robux must use product prompt")
		return { success = false, reason = "Robux must use product prompt" }
	end

	local result = CrateService.BuyCrateWithCoins(player, crateId, quantity)
	if result.success then
		local counts = CrateService.GetCrateCounts(player)
		inventoryUpdate:FireClient(player, "CrateBalance", {
			crateId = crateId,
			newCount = result.newCount,
			counts = counts,
			qty = quantity,
		})
		print(string.format("[CrateBuy] SUCCESS player=%s crateType=%s qty=%s newCount=%s",
			player.Name, tostring(crateId), tostring(quantity), tostring(result.newCount)))
	else
		print(string.format("[CrateBuy] FAIL reason=%s", tostring(result.reason)))
	end
	return result
end

getCratesFunc.OnServerInvoke = function(player)
	if not PlayerDataService.IsLoaded(player) then
		return {}
	end
	return CrateService.GetCrateCounts(player)
end

openOwnedCratesFunc.OnServerInvoke = function(player, crateId, quantity)
	print(string.format("[CrateOpen] START player=%s crateType=%s qty=%s",
		player.Name, tostring(crateId), tostring(quantity)))
	if not PlayerDataService.IsLoaded(player) then
		print("[CrateOpen] FAIL reason=Data not loaded")
		return { results = {}, success = false, error = "Data not loaded" }
	end
	local result = CrateService.OpenOwnedCrates(player, crateId, quantity)
	if result.success then
		local counts = CrateService.GetCrateCounts(player)
		inventoryUpdate:FireClient(player, "CrateBalance", {
			crateId = crateId,
			newCount = result.newCount,
			counts = counts,
		})
		inventoryUpdate:FireClient(player, "CrateOpened", result.results)
		local rewardsCount = type(result.results) == "table" and #result.results or 0
		print(string.format("[CrateOpen] RESULT player=%s crateType=%s qty=%s rewards=%d",
			player.Name, tostring(crateId), tostring(quantity), rewardsCount))
	else
		print(string.format("[CrateOpen] FAIL reason=%s", tostring(result.error)))
	end
	return result
end

-- =====================================================================
-- PLAYER LIFECYCLE
-- =====================================================================

local function onPlayerAdded(player: Player)
	local data = PlayerDataService.LoadPlayer(player)

	if STUDIO_GRANT_ALL and data then
		local granted = 0
		if ItemCatalog.Crowns then
			for crownId, _ in pairs(ItemCatalog.Crowns) do
				if not InventoryService.OwnsItem(player, "Crowns", crownId) then
					InventoryService.GrantItem(player, "Crowns", crownId)
					granted += 1
				end
			end
		end
		if ItemCatalog.Pets then
			for petId, _ in pairs(ItemCatalog.Pets) do
				if not InventoryService.OwnsItem(player, "Pets", petId) then
					InventoryService.GrantItem(player, "Pets", petId)
					granted += 1
				end
			end
		end
		if ItemCatalog.IconImages then
			for iconId, _ in pairs(ItemCatalog.IconImages) do
				if not InventoryService.OwnsItem(player, "IconImages", iconId) then
					InventoryService.GrantItem(player, "IconImages", iconId)
					granted += 1
				end
			end
		end
		if (data.Coins or 0) < 50000 then
			data.Coins = 50000
			PlayerDataService.SetField(player, "Coins", 50000)
		end
		PlayerDataService.SetField(player, "LastDailyRewardTime", 0)
		PlayerDataService.SetField(player, "DailyStreak", 0)
		print("[DEBUG] Daily rewards RESET for", player.Name, "(Studio testing)")

		if granted > 0 then
			print(string.format("[DEBUG] Granted %d items to %s (Studio grant-all)", granted, player.Name))
		end
	end

	if STUDIO_RESET_STATS and data then
		local statsToZero = {
			"LifetimeWins", "WeeklyWins", "LifetimeCoinsAchieved",
			"WeeklyCoinsAchieved", "LifetimeDeaths", "TimePlayedSeconds",
		}
		for _, key in ipairs(statsToZero) do
			data[key] = 0
			PlayerDataService.SetField(player, key, 0)
		end
		data.Coins = 0
		PlayerDataService.SetField(player, "Coins", 0)
		data.OwnedCrowns = {}
		PlayerDataService.SetField(player, "OwnedCrowns", {})
		data.EquippedCrown = nil
		PlayerDataService.SetField(player, "EquippedCrown", nil)
		data.OwnedPets = {}
		PlayerDataService.SetField(player, "OwnedPets", {})
		data.EquippedPet = nil
		PlayerDataService.SetField(player, "EquippedPet", nil)
		data.OwnedIcons = {}
		PlayerDataService.SetField(player, "OwnedIcons", {})
		data.EquippedIcon = nil
		PlayerDataService.SetField(player, "EquippedIcon", nil)
		data.OwnedIconImages = {}
		PlayerDataService.SetField(player, "OwnedIconImages", {})
		data.EquippedIconImage = nil
		PlayerDataService.SetField(player, "EquippedIconImage", nil)
		data.LastDailyRewardTime = 0
		PlayerDataService.SetField(player, "LastDailyRewardTime", 0)
		data.DailyStreak = 0
		PlayerDataService.SetField(player, "DailyStreak", 0)
		print(string.format("[DEBUG] All stats RESET to 0 for %s (Studio clean testing)", player.Name))
	end

	StatService.RecalculateStats(player)

	task.spawn(function()
		local milestoneResult = LevelCrownService.CheckMilestones(player)
		if milestoneResult.granted and #milestoneResult.granted > 0 then
			inventoryUpdate:FireClient(player, "LevelCrowns", milestoneResult.granted)
			StatService.RecalculateStats(player)
		end
	end)

	player:GetAttributeChangedSignal("LifetimeWins"):Connect(function()
		if not PlayerDataService.IsLoaded(player) then return end
		local milestoneResult = LevelCrownService.CheckMilestones(player)
		if milestoneResult.granted and #milestoneResult.granted > 0 then
			inventoryUpdate:FireClient(player, "LevelCrowns", milestoneResult.granted)
			StatService.RecalculateStats(player)
		end
	end)

	if data and isValidUserId(player.UserId) then
		task.spawn(function()
			task.wait(1.5)

			local GLBS = getGLBS()
			if GLBS and GLBS ~= false and type(GLBS.SeedPlayerBoardsFromSavedData) == "function" then
				warn(string.format("[PlayerDataBootstrap] Seeding leaderboard for %s (userId=%d, studio=%s)", player.Name, player.UserId, tostring(IS_STUDIO)))

				if type(GLBS.Init) == "function" then
					pcall(GLBS.Init)
				end

				GLBS.SeedPlayerBoardsFromSavedData(player.UserId, data)

				task.delay(3, function()
					if GLBS and type(GLBS.RefreshAll) == "function" then
						warn("[PlayerDataBootstrap] Post-seed RefreshAll for " .. player.Name)
						pcall(GLBS.RefreshAll)
					end
				end)
			else
				warn("[PlayerDataBootstrap] GLBS.SeedPlayerBoardsFromSavedData not available -- skipping seed")
			end
		end)
	end

	player.CharacterAdded:Connect(function()
		task.wait(0.1)
		StatService.RecalculateStats(player)
	end)
end

local function onPlayerRemoving(player: Player)
	PlayerDataService.SavePlayer(player)
	StatService.OnPlayerRemoving(player)
	PlayerDataService.UnloadPlayer(player)
end

Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(onPlayerRemoving)

for _, player in ipairs(Players:GetPlayers()) do
	task.spawn(function()
		onPlayerAdded(player)
	end)
end

game:BindToClose(function()
	PlayerDataService.SaveAll()
end)

-- =====================================================================
-- TIME PLAYED TRACKING
-- =====================================================================
task.spawn(function()
	while true do
		task.wait(1)
		for _, player in ipairs(Players:GetPlayers()) do
			if PlayerDataService.IsLoaded(player) then
				local secs = (PlayerDataService.GetField(player, "TimePlayedSeconds") or 0) + 1
				PlayerDataService.SetField(player, "TimePlayedSeconds", secs)
			end
		end
	end
end)

-- =====================================================================
-- CREATOR-ONLY ADMIN COMMANDS (works in both Studio + Live)
--   !wipe             -- wipe own profile + own leaderboard entries
--   !wipeid <userId>  -- wipe a specific userId (profile + boards)
--   !wipeall          -- wipe ALL profiles on server + clear ALL boards
--   !boards           -- dump full leaderboard state for debugging
--   !setcoins <n>     -- set own coins
--   !shutdown          -- kick all + save
--   !purge             -- remove negative userId entries from ODS
--   !season            -- show current leaderboard season
--   !buildid           -- show build + season info
-- =====================================================================
local CREATOR_ID = game.CreatorId

local function isCreator(player: Player): boolean
	if game.CreatorType == Enum.CreatorType.User then
		return player.UserId == CREATOR_ID
	end
	return player:GetRankInGroup(CREATOR_ID) >= 255
end

local function wipePlayerProfile(targetPlayer: Player)
	local defaults = require(Shared:WaitForChild("PlayerData")).GetDefaults()
	for key, val in pairs(defaults) do
		PlayerDataService.SetField(targetPlayer, key, val)
	end
	PlayerDataService.SavePlayer(targetPlayer)
	StatService.RecalculateStats(targetPlayer)
end

local function wipeOfflineUserId(targetId: number)
	local DataStoreService = game:GetService("DataStoreService")
	local PlayerDataModule = require(Shared:WaitForChild("PlayerData"))
	local storeName = PlayerDataModule.STORE_NAME
	local key = PlayerDataModule.KEY_PREFIX .. tostring(targetId)
	local defaults = PlayerDataModule.GetDefaults()

	local ok, err = pcall(function()
		local store = DataStoreService:GetDataStore(storeName)
		store:SetAsync(key, defaults)
	end)
	if ok then
		warn(string.format("[ADMIN] Wiped offline userId=%d DataStore (%s / %s)", targetId, storeName, key))
	else
		warn(string.format("[ADMIN] FAILED to wipe offline userId=%d: %s", targetId, tostring(err)))
	end
	return ok
end

local function removeFromLeaderboards(targetId: number)
	local GLBS = getGLBS()
	if GLBS and GLBS ~= false then
		if type(GLBS.RemovePlayerEntries) == "function" then
			GLBS.RemovePlayerEntries(targetId)
			warn(string.format("[ADMIN] Leaderboard entries removed for userId=%d", targetId))
		else
			warn("[ADMIN] GLBS.RemovePlayerEntries not available!")
		end
		if type(GLBS.ClearSeedFlag) == "function" then
			GLBS.ClearSeedFlag(targetId)
		end
	else
		warn("[ADMIN] GLBS not loaded — cannot remove leaderboard entries")
	end
end

local function handleAdminCommand(player: Player, message: string)
	if not isCreator(player) then return end
	local args = string.split(string.lower(message), " ")
	local cmd = args[1]

	if cmd == "!wipe" then
		wipePlayerProfile(player)
		warn(string.format("[ADMIN] %s (userId=%d) wiped OWN profile — defaults restored, saved", player.Name, player.UserId))
		removeFromLeaderboards(player.UserId)
		warn(string.format("[ADMIN] !wipe affects only YOUR userId=%d. Use !wipeid <id> for alts, or !wipeall to nuke everything.", player.UserId))

	elseif cmd == "!wipeid" then
		local targetId = tonumber(args[2])
		if not targetId then
			warn("[ADMIN] Usage: !wipeid <userId>")
			return
		end
		targetId = math.floor(targetId)
		warn(string.format("[ADMIN] %s requested wipe of userId=%d", player.Name, targetId))

		local targetPlayer = nil
		for _, p in ipairs(Players:GetPlayers()) do
			if p.UserId == targetId then
				targetPlayer = p
				break
			end
		end

		if targetPlayer then
			wipePlayerProfile(targetPlayer)
			warn(string.format("[ADMIN] Wiped in-server player %s (userId=%d)", targetPlayer.Name, targetId))
		else
			wipeOfflineUserId(targetId)
		end

		removeFromLeaderboards(targetId)

	elseif cmd == "!wipeall" then
		warn(string.format("[ADMIN] %s requested FULL WIPE — all profiles + all boards", player.Name))

		for _, p in ipairs(Players:GetPlayers()) do
			if PlayerDataService.IsLoaded(p) then
				wipePlayerProfile(p)
				warn(string.format("[ADMIN] Wiped profile: %s (userId=%d)", p.Name, p.UserId))
			end
		end

		local GLBS = getGLBS()
		if GLBS and GLBS ~= false then
			if type(GLBS.ClearAllBoards) == "function" then
				GLBS.ClearAllBoards()
				warn("[ADMIN] All leaderboard boards CLEARED + refreshed")
			else
				for _, p in ipairs(Players:GetPlayers()) do
					removeFromLeaderboards(p.UserId)
				end
			end
		end

	elseif cmd == "!boards" then
		warn(string.format("[ADMIN] %s requested board state dump", player.Name))
		local GLBS = getGLBS()
		if GLBS and GLBS ~= false and type(GLBS.DumpBoardState) == "function" then
			GLBS.DumpBoardState()
		else
			warn("[ADMIN] GLBS.DumpBoardState not available")
		end

	elseif cmd == "!setcoins" then
		local amount = tonumber(args[2])
		if not amount then return end
		amount = math.clamp(math.floor(amount), 0, 9999999)
		PlayerDataService.SetField(player, "Coins", amount)
		warn(string.format("[ADMIN] %s set coins to %d", player.Name, amount))

	elseif cmd == "!shutdown" then
		warn(string.format("[ADMIN] %s requested server shutdown", player.Name))
		task.defer(function()
			for _, p in ipairs(Players:GetPlayers()) do
				p:Kick("Server restarting -- please rejoin for the latest version.")
			end
			task.wait(1)
			PlayerDataService.SaveAll()
		end)

	elseif cmd == "!purge" then
		warn(string.format("[ADMIN] %s requested test entry purge", player.Name))
		task.spawn(function()
			local GLBS = getGLBS()
			if GLBS and GLBS ~= false and type(GLBS.PurgeTestEntries) == "function" then
				GLBS.PurgeTestEntries()
			end
		end)

	elseif cmd == "!season" then
		local GLBS = getGLBS()
		local season = (GLBS and GLBS ~= false and GLBS.SEASON) or "?"
		warn(string.format("[ADMIN] Leaderboard season: %s  (bump LEADERBOARD_SEASON in GlobalLeaderboardService to reset all boards)", season))

	elseif cmd == "!buildid" then
		local GLBS = getGLBS()
		local season = (GLBS and GLBS ~= false and GLBS.SEASON) or "?"
		warn(string.format("[ADMIN] BUILD_ID for %s: %s  SEASON=%s", player.Name, BUILD_LABEL, season))
	end
end

Players.PlayerAdded:Connect(function(player)
	player.Chatted:Connect(function(msg)
		if string.sub(msg, 1, 1) == "!" then
			handleAdminCommand(player, msg)
		end
	end)
end)
for _, player in ipairs(Players:GetPlayers()) do
	player.Chatted:Connect(function(msg)
		if string.sub(msg, 1, 1) == "!" then
			handleAdminCommand(player, msg)
		end
	end)
end

print("[PlayerDataBootstrap] Persistence + equip + crate + level crowns + daily rewards + leaderboard seed + stats tracking + admin commands ready")
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="72">
        <Properties>
          <string name="Name">PlayerDataService</string>
          <string name="Source">--[[
	PlayerDataService
	Server-authoritative persistent player data.

	Loads from DataStore on PlayerAdded, saves on PlayerRemoving and
	server shutdown.  In-memory cache for fast access.  Replicates key
	fields to client via player attributes.

	API:
		Init()
		LoadPlayer(player)        -&gt; data table
		SavePlayer(player)        -&gt; boolean
		UnloadPlayer(player)
		GetData(player)           -&gt; data table | nil
		IsLoaded(player)          -&gt; boolean
		SetField(player, key, v)  -&gt; boolean
		GetField(player, key)     -&gt; value
		SaveAll()
]]

local DataStoreService  = game:GetService("DataStoreService")
local Players           = game:GetService("Players")
local HttpService       = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService        = game:GetService("RunService")

local IS_STUDIO = RunService:IsStudio()

local Shared     = ReplicatedStorage:WaitForChild("Shared")
local PlayerData = require(Shared:WaitForChild("PlayerData"))

local PlayerDataService = {}

local dataStore: DataStore? = nil
local playerCache: { [number]: { [string]: any } } = {}
local loadedPlayers: { [number]: boolean } = {}
local initialized = false

local DEBUG_LOG          = true
local RETRY_ATTEMPTS     = 3
local RETRY_DELAY        = 1
local AUTO_SAVE_INTERVAL = 300

local function log(...)
	if DEBUG_LOG then print("[PlayerDataService]", ...) end
end

-- =====================================================================
-- ATTRIBUTE REPLICATION
-- =====================================================================

local function replicateToClient(player: Player, data: { [string]: any })
	local A = PlayerData.Attributes

	player:SetAttribute(A.Coins,         data.Coins or 0)
	player:SetAttribute(A.LifetimeWins,  data.LifetimeWins or 0)
	player:SetAttribute(A.CoinMultiplier, 1)

	player:SetAttribute(A.LifetimeCoinsAchieved, data.LifetimeCoinsAchieved or 0)
	player:SetAttribute(A.WeeklyWins,             data.WeeklyWins or 0)
	player:SetAttribute(A.WeeklyCoinsAchieved,    data.WeeklyCoinsAchieved or 0)

	player:SetAttribute(A.EquippedPet,   data.EquippedPet or "")
	player:SetAttribute(A.EquippedCrown, data.EquippedCrown or "")
	player:SetAttribute(A.EquippedIcon,  data.EquippedIcon or "")

	player:SetAttribute(A.OwnedPets,   HttpService:JSONEncode(data.OwnedPets or {}))
	player:SetAttribute(A.OwnedCrowns, HttpService:JSONEncode(data.OwnedCrowns or {}))
	player:SetAttribute(A.OwnedIcons,  HttpService:JSONEncode(data.OwnedIcons or {}))

	player:SetAttribute(A.EquippedIconImage, data.EquippedIconImage or "")
	player:SetAttribute(A.OwnedIconImages,   HttpService:JSONEncode(data.OwnedIconImages or {}))
	player:SetAttribute(A.OwnedCrates,       HttpService:JSONEncode(data.OwnedCrates or {}))

	player:SetAttribute(A.LifetimeDeaths,    data.LifetimeDeaths or 0)
	player:SetAttribute(A.TimePlayedSeconds, data.TimePlayedSeconds or 0)
end

local function replicateField(player: Player, key: string, value: any)
	local A = PlayerData.Attributes

	if key == "Coins" then
		player:SetAttribute(A.Coins, value or 0)
	elseif key == "LifetimeWins" then
		player:SetAttribute(A.LifetimeWins, value or 0)
	elseif key == "LifetimeCoinsAchieved" then
		player:SetAttribute(A.LifetimeCoinsAchieved, value or 0)
	elseif key == "WeeklyWins" then
		player:SetAttribute(A.WeeklyWins, value or 0)
	elseif key == "WeeklyCoinsAchieved" then
		player:SetAttribute(A.WeeklyCoinsAchieved, value or 0)
	elseif key == "EquippedPet" then
		player:SetAttribute(A.EquippedPet, value or "")
	elseif key == "EquippedCrown" then
		player:SetAttribute(A.EquippedCrown, value or "")
	elseif key == "EquippedIcon" then
		player:SetAttribute(A.EquippedIcon, value or "")
	elseif key == "OwnedPets" then
		player:SetAttribute(A.OwnedPets, HttpService:JSONEncode(value or {}))
	elseif key == "OwnedCrowns" then
		player:SetAttribute(A.OwnedCrowns, HttpService:JSONEncode(value or {}))
	elseif key == "OwnedIcons" then
		player:SetAttribute(A.OwnedIcons, HttpService:JSONEncode(value or {}))
	elseif key == "EquippedIconImage" then
		player:SetAttribute(A.EquippedIconImage, value or "")
	elseif key == "OwnedIconImages" then
		player:SetAttribute(A.OwnedIconImages, HttpService:JSONEncode(value or {}))
	elseif key == "OwnedCrates" then
		player:SetAttribute(A.OwnedCrates, HttpService:JSONEncode(value or {}))
	elseif key == "LifetimeDeaths" then
		player:SetAttribute(A.LifetimeDeaths, value or 0)
	elseif key == "TimePlayedSeconds" then
		player:SetAttribute(A.TimePlayedSeconds, value or 0)
	end
end

-- =====================================================================
-- DATASTORE OPERATIONS
-- =====================================================================

local function getKey(userId: number): string
	return PlayerData.KEY_PREFIX .. tostring(userId)
end

local function loadFromStore(userId: number): { [string]: any }?
	if not dataStore then return nil end

	local key = getKey(userId)
	for attempt = 1, RETRY_ATTEMPTS do
		local ok, result = pcall(function()
			return dataStore:GetAsync(key)
		end)
		if ok then return result end
		warn(string.format("[PlayerDataService] Load attempt %d/%d failed for userId %d: %s",
			attempt, RETRY_ATTEMPTS, userId, tostring(result)))
		if attempt &lt; RETRY_ATTEMPTS then task.wait(RETRY_DELAY) end
	end
	warn(string.format("[PlayerDataService] All load attempts failed for userId %d", userId))
	return nil
end

local function saveToStore(userId: number, data: { [string]: any }): boolean
	if not dataStore then return false end

	local key = getKey(userId)
	for attempt = 1, RETRY_ATTEMPTS do
		local ok, err = pcall(function()
			dataStore:SetAsync(key, data)
		end)
		if ok then return true end
		warn(string.format("[PlayerDataService] Save attempt %d/%d failed for userId %d: %s",
			attempt, RETRY_ATTEMPTS, userId, tostring(err)))
		if attempt &lt; RETRY_ATTEMPTS then task.wait(RETRY_DELAY) end
	end
	warn(string.format("[PlayerDataService] All save attempts failed for userId %d", userId))
	return false
end

-- =====================================================================
-- PUBLIC API
-- =====================================================================

function PlayerDataService.Init()
	if initialized then
		warn("[PlayerDataService] Already initialized")
		return
	end
	initialized = true

	local ok, store = pcall(function()
		return DataStoreService:GetDataStore(PlayerData.STORE_NAME)
	end)
	if ok then
		dataStore = store
		log("DataStore connected:", PlayerData.STORE_NAME)
	else
		warn("[PlayerDataService] DataStore unavailable:", tostring(store))
	end

	task.spawn(function()
		while true do
			task.wait(AUTO_SAVE_INTERVAL)
			PlayerDataService.SaveAll()
		end
	end)

	log("Initialized")
end

function PlayerDataService.LoadPlayer(player: Player): { [string]: any }
	local userId = player.UserId
	if playerCache[userId] then
		log(player.Name, "already loaded -- returning cached data")
		return playerCache[userId]
	end

	local rawData = loadFromStore(userId)
	local data: { [string]: any }

	if rawData and type(rawData) == "table" then
		data = PlayerData.Validate(rawData)
		log(string.format("%s loaded from DataStore (Coins=%d Pets=%d Crowns=%d Wins=%d)",
			player.Name, data.Coins, #data.OwnedPets, #data.OwnedCrowns, data.LifetimeWins))
	else
		data = PlayerData.GetDefaults()
		log(string.format("%s -- new player, using defaults", player.Name))
	end

	playerCache[userId]  = data
	loadedPlayers[userId] = true

	replicateToClient(player, data)
	return data
end

function PlayerDataService.SavePlayer(player: Player): boolean
	local userId = player.UserId
	local data = playerCache[userId]
	if not data then
		log(player.Name, "-- no cached data to save")
		return false
	end
	local success = saveToStore(userId, data)
	if success then log(player.Name, "saved") end
	return success
end

function PlayerDataService.UnloadPlayer(player: Player)
	local userId = player.UserId
	playerCache[userId]   = nil
	loadedPlayers[userId] = nil
end

function PlayerDataService.GetData(player: Player): { [string]: any }?
	return playerCache[player.UserId]
end

function PlayerDataService.IsLoaded(player: Player): boolean
	return loadedPlayers[player.UserId] == true
end

function PlayerDataService.SetField(player: Player, key: string, value: any): boolean
	local data = playerCache[player.UserId]
	if not data then
		warn("[PlayerDataService] SetField failed -- data not loaded for", player.Name)
		return false
	end
	data[key] = value
	replicateField(player, key, value)
	return true
end

function PlayerDataService.GetField(player: Player, key: string): any
	local data = playerCache[player.UserId]
	if not data then return nil end
	return data[key]
end

function PlayerDataService.SaveAll()
	local count = 0
	for userId, data in pairs(playerCache) do
		local success = saveToStore(userId, data)
		if success then count += 1 end
	end
	if count &gt; 0 then
		log(string.format("Saved %d player(s)", count))
	end
end

return PlayerDataService</string>
        </Properties>
      </Item>
      <Item class="Script" referent="73">
        <Properties>
          <string name="Name">PlayerStateBootstrap</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--[[
	PlayerStateBootstrap
	Wires PlayerStateService to player join/leave events.
	
	This is the entry point for player state tracking.
	Runs once on server start.
]]

local Players = game:GetService("Players")
local ServerScriptService = game:GetService("ServerScriptService")

local Server = ServerScriptService:WaitForChild("Server")
local PlayerStateService = require(Server:WaitForChild("PlayerStateService"))

-- Initialize the service
PlayerStateService.Init()

-- Handle players already in game (for Studio testing with "Run" instead of "Play")
for _, player in ipairs(Players:GetPlayers()) do
	PlayerStateService.RegisterPlayer(player)
end

-- Wire up join/leave
Players.PlayerAdded:Connect(function(player)
	PlayerStateService.RegisterPlayer(player)
end)

Players.PlayerRemoving:Connect(function(player)
	PlayerStateService.RemovePlayer(player)
end)

]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="74">
        <Properties>
          <string name="Name">PlayerStateService</string>
          <string name="Source"><![CDATA[--[[
	PlayerStateService
	Server-authoritative player state tracking.
	
	API:
		Init()                        → Initialize the service
		GetState(player)              → State
		SetState(player, state)       → boolean (success)
		IsAFK(player)                 → boolean
		SetAFK(player, isAFK)         → boolean (success)
		GetPlayersInState(state)      → { Player }
		RemovePlayer(player)          → void (cleanup)
	
	States: Lobby, Waiting, InMatch, Spectating, AFK
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local PlayerState = require(Shared:WaitForChild("PlayerState"))

-- Config
local DEBUG_LOG = true -- Set false to disable state change logging

-- Internal state
local playerStates: { [Player]: string } = {}
local previousStates: { [Player]: string } = {} -- For AFK toggle to restore previous state
local initialized = false

-- Removal callbacks: fired BEFORE state is cleared in RemovePlayer
-- Signature: fn(player: Player, oldState: string?)
local removalCallbacks: { (Player, string?) -> () } = {}

local PlayerStateService = {}

--[[ 
	Initialize the service.
	Call once from bootstrap.
]]
function PlayerStateService.Init()
	if initialized then
		warn("[PlayerStateService] Already initialized")
		return
	end
	initialized = true
	
	if DEBUG_LOG then
		print("[PlayerStateService] Initialized")
	end
end

--[[
	Get current state for a player.
	Returns nil if player is not tracked.
]]
function PlayerStateService.GetState(player: Player): string?
	return playerStates[player]
end

--[[
	Set state for a player.
	Returns false if state is invalid.
]]
function PlayerStateService.SetState(player: Player, state: string): boolean
	if not PlayerState.IsValid(state) then
		warn("[PlayerStateService] Invalid state:", state)
		return false
	end
	
	local oldState = playerStates[player]
	
	-- Don't log if state hasn't changed
	if oldState == state then
		return true
	end
	
	playerStates[player] = state
	
	-- Replicate to client via attribute (used by StormFXController, etc.)
	player:SetAttribute("PlayerState", state)
	
	if DEBUG_LOG then
		print(string.format("[PlayerStateService] %s: %s → %s", 
			player.Name, 
			oldState or "nil", 
			state
		))
	end
	
	return true
end

--[[
	Check if player is AFK.
]]
function PlayerStateService.IsAFK(player: Player): boolean
	return playerStates[player] == PlayerState.States.AFK
end

--[[
	Toggle AFK state.
	When going AFK: stores previous state
	When leaving AFK: restores previous state (defaults to Lobby)
]]
function PlayerStateService.SetAFK(player: Player, isAFK: boolean): boolean
	local currentState = playerStates[player]
	
	if isAFK then
		-- Going AFK
		if currentState == PlayerState.States.AFK then
			return true -- Already AFK
		end
		
		-- Can't go AFK while in match
		if currentState == PlayerState.States.InMatch then
			if DEBUG_LOG then
				print(string.format("[PlayerStateService] %s cannot go AFK while InMatch", player.Name))
			end
			return false
		end
		
		-- Store previous state and set AFK
		previousStates[player] = currentState
		return PlayerStateService.SetState(player, PlayerState.States.AFK)
	else
		-- Leaving AFK
		if currentState ~= PlayerState.States.AFK then
			return true -- Not AFK, nothing to do
		end
		
		-- Restore previous state or default to Lobby
		local restoreTo = previousStates[player] or PlayerState.DEFAULT
		previousStates[player] = nil
		return PlayerStateService.SetState(player, restoreTo)
	end
end

--[[
	Get all players currently in a specific state.
]]
function PlayerStateService.GetPlayersInState(state: string): { Player }
	if not PlayerState.IsValid(state) then
		warn("[PlayerStateService] Invalid state for query:", state)
		return {}
	end
	
	local result = {}
	for player, playerState in pairs(playerStates) do
		if playerState == state then
			table.insert(result, player)
		end
	end
	return result
end

--[[
	Register a new player (call on PlayerAdded).
	Sets default state to Lobby.
]]
function PlayerStateService.RegisterPlayer(player: Player)
	if playerStates[player] then
		warn("[PlayerStateService] Player already registered:", player.Name)
		return
	end
	
	playerStates[player] = PlayerState.DEFAULT
	
	-- Replicate to client via attribute (used by StormFXController, etc.)
	player:SetAttribute("PlayerState", PlayerState.DEFAULT)
	
	if DEBUG_LOG then
		print(string.format("[PlayerStateService] %s joined → %s", player.Name, PlayerState.DEFAULT))
	end
end

--[[
	Register a callback that fires BEFORE a player's state is cleared on removal.
	Use this to react to player disconnects (e.g., elimination tracking).
	Callback signature: fn(player: Player, oldState: string?)
]]
function PlayerStateService.OnPlayerRemoval(fn: (Player, string?) -> ())
	table.insert(removalCallbacks, fn)
end

--[[
	Remove a player (call on PlayerRemoving).
	Fires removal callbacks BEFORE clearing state, then cleans up.
]]
function PlayerStateService.RemovePlayer(player: Player)
	local state = playerStates[player]
	
	-- Fire removal callbacks BEFORE clearing state (so listeners can read old state)
	for _, fn in ipairs(removalCallbacks) do
		local ok, err = pcall(fn, player, state)
		if not ok then
			warn(string.format("[PlayerStateService] Removal callback error: %s", tostring(err)))
		end
	end
	
	playerStates[player] = nil
	previousStates[player] = nil
	
	if DEBUG_LOG and state then
		print(string.format("[PlayerStateService] %s left (was %s)", player.Name, state))
	end
end

--[[
	Get count of players in each state (debug utility).
]]
function PlayerStateService.GetStateCounts(): { [string]: number }
	local counts = {}
	for _, state in pairs(PlayerState.GetAll()) do
		counts[state] = 0
	end
	
	for _, state in pairs(playerStates) do
		counts[state] = (counts[state] or 0) + 1
	end
	
	return counts
end

return PlayerStateService

]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="75">
        <Properties>
          <string name="Name">RoundCoinService</string>
          <string name="Source">--[[
	RoundCoinService
	Server-side collectible coin spawning during Normal rounds.

	Spawns 4-5 coins per round inside the barrier.
	- "Fate Coin" (+20)  — always available
	- "More Fate Coin" (+50) — 40% chance, only when Round &gt;= 6

	Coins use Touched for collection (server-authoritative).
	Reuses Brainrot-style glow (Highlight) and sets attributes so
	the client CoinPickupController can animate hover/rotation.

	API:
		Init()
		OnRoundStart(roundNumber: number)
		OnRoundEnd()
]]

local ReplicatedStorage  = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")
local Workspace          = game:GetService("Workspace")
local Players            = game:GetService("Players")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Server = ServerScriptService:WaitForChild("Server")

local EconomyService = require(Server:WaitForChild("EconomyService"))
local MapManager     = require(Server:WaitForChild("MapManager"))

local COIN_FOLDER_NAME = "RoundCoins"
local SPAWN_Y_OFFSET   = 3.0
local EDGE_MARGIN      = 6
local RAYCAST_HEIGHT   = 80

local COIN_DEFS = {
	["Fate Coin"]      = { value = 20,  minRound = 1, weight = 60 },
	["More Fate Coin"] = { value = 50,  minRound = 6, weight = 40 },
}

local COLLECT_SOUND_ID = "rbxassetid://135303694517645"
local COLLECT_SOUND_VOLUME = 0.5

local GLOW_FILL_COLOR        = Color3.fromRGB(255, 215, 0)
local GLOW_FILL_TRANSPARENCY = 0.7
local GLOW_OUTLINE_COLOR     = Color3.fromRGB(255, 255, 255)
local GLOW_OUTLINE_TRANSPARENCY = 0.3

local RoundCoinService = {}

local initialized = false
local coinsFolder: Folder? = nil
local touchConnections: { RBXScriptConnection } = {}

local function log(...)
	print("[RoundCoins]", ...)
end

local function getCoinsFolder(): Folder
	if coinsFolder and coinsFolder.Parent then
		return coinsFolder
	end
	local existing = Workspace:FindFirstChild(COIN_FOLDER_NAME)
	if existing then
		coinsFolder = existing
		return existing
	end
	local folder = Instance.new("Folder")
	folder.Name = COIN_FOLDER_NAME
	folder.Parent = Workspace
	coinsFolder = folder
	return folder
end

local function clearCoinsFolder()
	local folder = Workspace:FindFirstChild(COIN_FOLDER_NAME)
	if folder then
		folder:Destroy()
		coinsFolder = nil
	end
end

local function disconnectTouched()
	for _, conn in ipairs(touchConnections) do
		if conn.Connected then
			conn:Disconnect()
		end
	end
	touchConnections = {}
end

local function getRandomArenaPosition(): Vector3?
	local bounds = MapManager.GetActiveBounds()
	if not bounds then
		warn("[RoundCoins] No active bounds available")
		return nil
	end

	local centerX = bounds.cframe.Position.X
	local centerZ = bounds.cframe.Position.Z
	local topY = bounds.topY

	local halfX = (bounds.sizeX / 2) - EDGE_MARGIN
	local halfZ = (bounds.sizeZ / 2) - EDGE_MARGIN
	halfX = math.max(halfX, 2)
	halfZ = math.max(halfZ, 2)

	local x = centerX + (math.random() * 2 - 1) * halfX
	local z = centerZ + (math.random() * 2 - 1) * halfZ

	local rayOrigin = Vector3.new(x, topY + RAYCAST_HEIGHT, z)
	local rayDir = Vector3.new(0, -(RAYCAST_HEIGHT * 2), 0)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local folder = Workspace:FindFirstChild(COIN_FOLDER_NAME)
	if folder then
		params.FilterDescendantsInstances = { folder }
	end

	local result = Workspace:Raycast(rayOrigin, rayDir, params)
	local y = result and (result.Position.Y + SPAWN_Y_OFFSET) or (topY + SPAWN_Y_OFFSET)
	return Vector3.new(x, y, z)
end

local function chooseCoinType(roundNumber: number): string
	if roundNumber &lt; 6 then
		return "Fate Coin"
	end
	return (math.random(1, 100) &lt;= 40) and "More Fate Coin" or "Fate Coin"
end

local function getPlayerFromCharacter(character: Instance): Player?
	for _, p in ipairs(Players:GetPlayers()) do
		if p.Character == character then
			return p
		end
	end
	return nil
end

local function spawnCoin(coinName: string)
	local template = nil
	local assets = ReplicatedStorage:FindFirstChild("Assets")
	if assets then
		local coinModels = assets:FindFirstChild("CoinModels")
		if coinModels then
			template = coinModels:FindFirstChild(coinName)
		end
	end
	if not template then
		warn("[RoundCoins] Model not found:", coinName)
		return nil
	end

	local spawnPos = getRandomArenaPosition()
	if not spawnPos then return nil end

	local def = COIN_DEFS[coinName]
	local clone = template:Clone()
	clone.Name = "RoundCoin_" .. coinName
	clone:SetAttribute("CoinType", coinName)
	clone:SetAttribute("CoinValue", def.value)
	clone:SetAttribute("Collected", false)

	local targetCF = CFrame.new(spawnPos)
		* CFrame.Angles(0, math.rad(math.random(0, 360)), 0)
		* CFrame.Angles(math.rad(90), 0, 0)

	if clone:IsA("Model") then
		local refPart = clone.PrimaryPart or clone:FindFirstChildWhichIsA("BasePart", true)
		if refPart then
			local refInv = refPart.CFrame:Inverse()
			for _, desc in ipairs(clone:GetDescendants()) do
				if desc:IsA("BasePart") then
					desc.CFrame = targetCF * (refInv * desc.CFrame)
				end
			end
		end
	elseif clone:IsA("BasePart") then
		clone.CFrame = targetCF
	end

	for _, desc in ipairs(clone:GetDescendants()) do
		if desc:IsA("BasePart") then
			desc.Anchored = true
			desc.CanCollide = false
		end
	end
	if clone:IsA("BasePart") then
		clone.Anchored = true
		clone.CanCollide = false
	end

	local highlight = Instance.new("Highlight")
	highlight.Name = "CoinGlow"
	highlight.Adornee = clone
	highlight.FillColor = GLOW_FILL_COLOR
	highlight.FillTransparency = GLOW_FILL_TRANSPARENCY
	highlight.OutlineColor = GLOW_OUTLINE_COLOR
	highlight.OutlineTransparency = GLOW_OUTLINE_TRANSPARENCY
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.Parent = clone

	local touchParts = {}
	if clone:IsA("BasePart") then
		table.insert(touchParts, clone)
	end
	for _, desc in ipairs(clone:GetDescendants()) do
		if desc:IsA("BasePart") then
			table.insert(touchParts, desc)
		end
	end

	for _, part in ipairs(touchParts) do
		local conn = part.Touched:Connect(function(hit)
			if clone:GetAttribute("Collected") then return end

			local character = hit.Parent
			if not character then return end
			local humanoid = character:FindFirstChildOfClass("Humanoid")
			if not humanoid or humanoid.Health &lt;= 0 then return end

			local player = getPlayerFromCharacter(character)
			if not player then return end

			clone:SetAttribute("Collected", true)

			local coinValue = clone:GetAttribute("CoinValue") or def.value
			EconomyService.AwardCoins(player, coinValue, "RoundCoin:" .. coinName)
			EconomyService.TrackMatchCoins(player, coinValue)
			log(string.format("%s collected %s → +%d coins", player.Name, coinName, coinValue))

			local hrp = character:FindFirstChild("HumanoidRootPart")
			if hrp then
				local sfx = Instance.new("Sound")
				sfx.SoundId = COLLECT_SOUND_ID
				sfx.Volume = COLLECT_SOUND_VOLUME
				sfx.RollOffMaxDistance = 50
				sfx.Parent = hrp
				sfx:Play()
				task.delay(3, function()
					if sfx and sfx.Parent then sfx:Destroy() end
				end)
			end

			clone:Destroy()
		end)
		table.insert(touchConnections, conn)
	end

	clone.Parent = getCoinsFolder()
	log(string.format("Spawned %s (%d) at (%.0f, %.0f, %.0f)", coinName, def.value, spawnPos.X, spawnPos.Y, spawnPos.Z))
	return clone
end

function RoundCoinService.Init()
	if initialized then return end
	initialized = true
	log("Initialized")
end

function RoundCoinService.OnRoundStart(roundNumber: number)
	clearCoinsFolder()
	disconnectTouched()

	local spawnCount = math.random(4, 5)
	log(string.format("Round %d: Spawning %d coins", roundNumber, spawnCount))

	for _ = 1, spawnCount do
		local coinType = chooseCoinType(roundNumber)
		spawnCoin(coinType)
	end
end

function RoundCoinService.OnRoundEnd()
	clearCoinsFolder()
	disconnectTouched()
	log("Round cleanup complete")
end

return RoundCoinService</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="76">
        <Properties>
          <string name="Name">RoundManager</string>
          <string name="Source">--[[
	RoundManager
	Server-side round loop controller.
	
	Runs during Playing phase only.
	Loop: FreeMove → Telegraph → BeamWarning → Strike → Recovery → repeat
	
	Telegraph tiles pulse BEFORE beams appear. When beams spawn,
	tile warnings are removed so the player only sees beams during the strike window.
	
	API:
		Init()              → Initialize the manager
		StartRoundLoop()    → Begin round cycling (only during Playing)
		StopRoundLoop()     → Cancel loop safely
		IsRunning()         → boolean
		GetCurrentRound()   → number
		GetCurrentPhase()   → string | nil
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Server = ServerScriptService:WaitForChild("Server")

local RoundConfig = require(Shared:WaitForChild("RoundConfig"))
local PlayerState = require(Shared:WaitForChild("PlayerState"))
local PlayerStateService = require(Server:WaitForChild("PlayerStateService"))
local HazardManager = require(Server:WaitForChild("HazardManager"))
local MapManager = require(Server:WaitForChild("MapManager"))
local BrainrotModeService    = require(Server:WaitForChild("BrainrotModeService"))
local RoundCoinService       = require(Server:WaitForChild("RoundCoinService"))
local SwordSpawnService      = require(Server:WaitForChild("SwordSpawnService"))
local TungTungSahurService   = require(Server:WaitForChild("TungTungSahurService"))

--[[ PHASE CONSTANTS ]]
local Phase = {
	FreeMove = "FreeMove",
	Telegraph = "Telegraph",
	BeamWarning = "BeamWarning",
	Strike = "Strike",
	Recovery = "Recovery",
}

--[[ MATCH END REASONS ]]
local MatchEndReason = {
	Winner = "Winner",
	NoWinners = "NoWinners",
	CapReached = "CapReached",
	Cancelled = "Cancelled",
}

--[[ INTERNAL STATE ]]
local initialized = false
local running = false
local currentRound = 0
local currentPhase: string? = nil
local matchEndReason: string? = nil
local winner: Player? = nil

-- Match tracking
local matchStartTime: number = 0
local initialAliveCount: number = 0
local matchMode: string = "Normal"

-- Freeze state storage (player -&gt; original values)
local frozenPlayers: { [Player]: { WalkSpeed: number, JumpPower: number, JumpHeight: number } } = {}
local freezeRemote: RemoteEvent = nil

local RoundManager = {}

local _DQS = nil
local function getDQS()
	if _DQS ~= nil then return _DQS end
	local ok, mod = pcall(require, Server:FindFirstChild("DailyQuestService"))
	if ok and mod then _DQS = mod else _DQS = false end
	return _DQS
end

--[[ HELPERS ]]

local function log(...)
	if RoundConfig.DebugLog then
		print("[RoundManager]", ...)
	end
end

--[[
	Get all players currently InMatch.
]]
local function getInMatchPlayers(): { Player }
	return PlayerStateService.GetPlayersInState(PlayerState.States.InMatch)
end

--[[
	Freeze a single player (store original values, set to 0).
]]
local function freezePlayer(player: Player)
	local character = player.Character
	if not character then return end
	
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then return end
	
	-- Store original values
	frozenPlayers[player] = {
		WalkSpeed = humanoid.WalkSpeed,
		JumpPower = humanoid.JumpPower,
		JumpHeight = humanoid.JumpHeight,
	}
	
	-- Freeze
	humanoid.WalkSpeed = 0
	humanoid.JumpPower = 0
	humanoid.JumpHeight = 0
end

--[[
	Unfreeze a single player (restore original values).
]]
local function unfreezePlayer(player: Player)
	local stored = frozenPlayers[player]
	if not stored then return end
	
	local character = player.Character
	if character then
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			humanoid.WalkSpeed = stored.WalkSpeed
			humanoid.JumpPower = stored.JumpPower
			humanoid.JumpHeight = stored.JumpHeight
		end
	end
	
	frozenPlayers[player] = nil
end

--[[
	Freeze all InMatch players.
]]
local function freezeAllPlayers()
	local players = getInMatchPlayers()
	for _, player in ipairs(players) do
		freezePlayer(player)
	end
	if freezeRemote then
		for _, player in ipairs(players) do
			freezeRemote:FireClient(player, "Freeze", RoundConfig.FreezeSeconds)
		end
	end
	log(string.format("Froze %d players", #players))
	TungTungSahurService.OnFreezeBegin()
end

--[[
	Unfreeze all frozen players.
]]
local function unfreezeAllPlayers()
	local count = 0
	local toNotify = {}
	for player, _ in pairs(frozenPlayers) do
		table.insert(toNotify, player)
		unfreezePlayer(player)
		count = count + 1
	end
	frozenPlayers = {}
	if freezeRemote then
		for _, player in ipairs(toNotify) do
			if player.Parent then
				freezeRemote:FireClient(player, "Unfreeze")
			end
		end
	end
	TungTungSahurService.OnFreezeEnd()
	if count &gt; 0 then
		log(string.format("Unfroze %d players", count))
	end
end

--[[
	Check if match time limit has been exceeded.
]]
local function isMatchTimeExceeded(): boolean
	if RoundConfig.MaxMatchSeconds &lt;= 0 then
		return false -- No limit
	end
	return (tick() - matchStartTime) &gt;= RoundConfig.MaxMatchSeconds
end

--[[
	Check if match should end based on alive player count or limits.
	Returns true if match should end, sets matchEndReason and winner.
]]
local function checkMatchEnd(): boolean
	local alivePlayers = PlayerStateService.GetPlayersInState(PlayerState.States.InMatch)
	local aliveCount = #alivePlayers
	
	-- No one survived
	if aliveCount == 0 then
		winner = nil
		matchEndReason = MatchEndReason.NoWinners
		log("No winners - all players eliminated")
		return true
	end
	
	-- Winner: only if we started with 2+ players and now have 1
	if aliveCount == 1 and initialAliveCount &gt;= RoundConfig.MinPlayersForWinner then
		winner = alivePlayers[1]
		matchEndReason = MatchEndReason.Winner
		log(string.format("WINNER: %s!", winner.Name))
		return true
	end
	
	-- Check max rounds cap
	if RoundConfig.MaxRoundsPerMatch &gt; 0 and currentRound &gt;= RoundConfig.MaxRoundsPerMatch then
		-- Award top survivor(s) for now, just log
		if aliveCount == 1 then
			winner = alivePlayers[1]
		else
			winner = nil
		end
		matchEndReason = MatchEndReason.CapReached
		log(string.format("Max rounds reached (%d), %d players remaining", currentRound, aliveCount))
		return true
	end
	
	-- Check max time cap
	if isMatchTimeExceeded() then
		if aliveCount == 1 then
			winner = alivePlayers[1]
		else
			winner = nil
		end
		matchEndReason = MatchEndReason.CapReached
		log(string.format("Max time reached (%.0fs), %d players remaining", 
			tick() - matchStartTime, aliveCount))
		return true
	end
	
	return false
end

--[[
	Safely wait for duration, checking cancellation AND match-end conditions.
	Polls every 0.1s so mid-phase eliminations (OOB, hazards) are detected
	within ~0.1s instead of waiting for the next explicit checkMatchEnd() call.
	Returns true if completed, false if cancelled or match ended.
]]
local function safeWait(seconds: number): boolean
	local elapsed = 0
	local step = 0.1
	
	while elapsed &lt; seconds do
		if not running then
			return false -- Cancelled externally
		end
		
		-- Check if match should end mid-phase (e.g., solo player OOB-eliminated)
		if checkMatchEnd() then
			running = false
			log("Match end detected mid-phase — aborting immediately")
			return false
		end
		
		task.wait(math.min(step, seconds - elapsed))
		elapsed = elapsed + step
	end
	
	return true
end

--[[
	Run a single phase.
	Returns false if cancelled.
]]
local function runPhase(phaseName: string, duration: number): boolean
	if not running then return false end
	
	currentPhase = phaseName
	log(string.format("Round %d: %s (%.2fs)", currentRound, phaseName, duration))
	
	return safeWait(duration)
end

--[[
	Cleanup mode-specific spawns (brainrot pickups, coins, swords) on any round exit.
]]
local function cleanupModeRound()
	if matchMode == "Brainrot" then BrainrotModeService.OnRoundEnd() end
	if matchMode == "Normal" then RoundCoinService.OnRoundEnd() end
	SwordSpawnService.OnRoundEnd()
	-- Pass currentRound so TTS only despawns on round 6, not earlier rounds
	TungTungSahurService.OnRoundEnd(currentRound)
end

--[[
	Run a single round cycle: FreeMove → Telegraph → BeamWarning → Strike → Recovery
	Returns false if cancelled.
	
	Key flow:
	  - Freeze players
	  - ShowTelegraph (tile warnings pulse — no beams yet)
	  - HideTelegraph + SpawnBeams (tiles vanish, beams appear)
	  - Strike (damage check)
	  - ClearBeams + unfreeze
	  
	Every failure path calls HazardManager.Cleanup() so nothing lingers.
]]
local function runRoundCycle(): boolean
	currentRound = currentRound + 1
	log(string.format("=== Round %d starting ===", currentRound))

	-- Replicate round number for client UI
	local matchStatus = ReplicatedStorage:FindFirstChild("MatchStatus")
	if matchStatus then
		local rv = matchStatus:FindFirstChild("Round")
		if rv then rv.Value = currentRound end
	end
	
	-- Notify MapManager of round start (handles shrinking)
	MapManager.OnRoundStart(currentRound)

	-- Brainrot mode: spawn pickups at round start
	if matchMode == "Brainrot" then
		BrainrotModeService.OnRoundStart(currentRound)
	end

	-- TungTungSahur hazard (Brainrot mode, rounds 2–6)
	TungTungSahurService.OnRoundStart(currentRound, matchMode)

	-- Normal mode: spawn collectible coins
	if matchMode == "Normal" then
		RoundCoinService.OnRoundStart(currentRound)
	end

	-- Sword spawns (both modes, rounds 1-7 only)
	SwordSpawnService.OnRoundStart(currentRound)
	
	-- Check caps before round starts
	if checkMatchEnd() then
		cleanupModeRound()
		running = false
		return false
	end
	
	-- Phase 1: FreeMove (players can reposition)
	if not runPhase(Phase.FreeMove, RoundConfig.FreeMoveSeconds) then
		HazardManager.Cleanup()
		cleanupModeRound()
		return false
	end
	
	-- Select unsafe zones and show telegraph BEFORE freezing (grace window)
	HazardManager.SelectUnsafeZones(currentRound)
	HazardManager.ShowTelegraph()

	-- Grace window: telegraph is visible but players can still move
	local graceTime = RoundConfig.TelegraphGraceSeconds or 0
	if graceTime &gt; 0 then
		log(string.format("Round %d: Telegraph grace window (%.2fs — players can still move)", currentRound, graceTime))
		if not safeWait(graceTime) then
			unfreezeAllPlayers()
			HazardManager.Cleanup()
			cleanupModeRound()
			return false
		end
	end

	-- Freeze players after grace ends
	freezeAllPlayers()
	log(string.format("Round %d: Grace ended — players frozen", currentRound))
	
	-- Phase 2: Telegraph remainder (tile warnings continue — NO beams yet)
	local remainingTelegraph = math.max(0, RoundConfig.TelegraphSeconds - graceTime)
	if not runPhase(Phase.Telegraph, remainingTelegraph) then
		unfreezeAllPlayers()
		HazardManager.Cleanup()
		cleanupModeRound()
		return false
	end
	
	-- Phase 3: BeamWarning (tile warnings vanish instantly, beams appear)
	HazardManager.HideTelegraph()
	HazardManager.SpawnBeams()
	local beamWarningTime = math.max(0, RoundConfig.FreezeSeconds - RoundConfig.TelegraphSeconds)
	if not runPhase(Phase.BeamWarning, beamWarningTime) then
		unfreezeAllPlayers()
		HazardManager.Cleanup()
		cleanupModeRound()
		return false
	end
	
	-- Phase 4: Strike (beam fires, eliminate players in unsafe zones)
	HazardManager.Strike()
	if not runPhase(Phase.Strike, RoundConfig.StrikeSeconds) then
		unfreezeAllPlayers()
		HazardManager.Cleanup()
		cleanupModeRound()
		return false
	end
	unfreezeAllPlayers()
	
	-- Check for winner after Strike
	if checkMatchEnd() then
		HazardManager.Cleanup()
		cleanupModeRound()
		running = false  -- Stop the loop
		return false
	end
	
	-- Phase 5: Recovery (brief pause, cleanup beams)
	HazardManager.ClearBeams()
	if not runPhase(Phase.Recovery, RoundConfig.RecoverySeconds) then
		HazardManager.Cleanup()
		cleanupModeRound()
		return false
	end

	cleanupModeRound()

	-- Notify DailyQuestService: all still-alive (InMatch) players survived this round
	local dqs = getDQS()
	if dqs and dqs.OnRoundSurvived then
		local survivors = PlayerStateService.GetPlayersInState(PlayerState.States.InMatch)
		for _, p in ipairs(survivors) do
			pcall(dqs.OnRoundSurvived, p)
		end
	end

	return true
end

--[[ PUBLIC API ]]

function RoundManager.Init()
	if initialized then
		warn("[RoundManager] Already initialized")
		return
	end
	
	-- Initialize HazardManager (depends on MapManager being ready)
	HazardManager.Init()

	local remotesFolder = ReplicatedStorage:FindFirstChild("Remotes")
	if not remotesFolder then
		remotesFolder = Instance.new("Folder")
		remotesFolder.Name = "Remotes"
		remotesFolder.Parent = ReplicatedStorage
	end
	local existingFreeze = remotesFolder:FindFirstChild("FreezeIndicator")
	if not existingFreeze then
		freezeRemote = Instance.new("RemoteEvent")
		freezeRemote.Name = "FreezeIndicator"
		freezeRemote.Parent = remotesFolder
	else
		freezeRemote = existingFreeze
	end
	
	initialized = true
	log("Initialized")
	
	-- Clean up frozen players if they leave
	Players.PlayerRemoving:Connect(function(player)
		if frozenPlayers[player] then
			frozenPlayers[player] = nil
		end
	end)
end

function RoundManager.IsRunning(): boolean
	return running
end

function RoundManager.GetCurrentRound(): number
	return currentRound
end

function RoundManager.GetCurrentPhase(): string?
	return currentPhase
end

function RoundManager.GetMatchEndReason(): string?
	return matchEndReason
end

function RoundManager.GetWinner(): Player?
	return winner
end

function RoundManager.StartRoundLoop(mode: string?)
	if running then
		warn("[RoundManager] Loop already running")
		return
	end

	matchMode = mode or "Normal"
	running = true
	currentRound = 0
	currentPhase = nil
	matchEndReason = nil
	winner = nil
	
	-- Track match start for time limit
	matchStartTime = tick()
	
	-- Track initial player count for winner detection
	local alivePlayers = PlayerStateService.GetPlayersInState(PlayerState.States.InMatch)
	initialAliveCount = #alivePlayers
	
	log(string.format("Round loop started with %d players", initialAliveCount))
	
	task.spawn(function()
		while running do
			-- Run a round cycle
			local completed = runRoundCycle()
			
			if not completed then
				break -- Cancelled or match ended
			end
		end
		
		-- Cleanup
		unfreezeAllPlayers()
		HazardManager.Cleanup()
		currentPhase = nil
		running = false
		log("Round loop ended")
	end)
end

function RoundManager.StopRoundLoop()
	if not running then
		return
	end
	
	log("Stopping round loop...")
	running = false
	-- The loop will detect this and exit on next safeWait check
end

return RoundManager</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="77">
        <Properties>
          <string name="Name">ShopService</string>
          <string name="Source"><![CDATA[--[[
	ShopService
	Handles in-game Fate Coins purchases from the Shop UI.

	API:
		Init()
		BuyWithCoins(player, itemId, itemType) → { success, reason? }
]]

local ReplicatedStorage  = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")
local HttpService = game:GetService("HttpService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Server = ServerScriptService:WaitForChild("Server")

local ItemCatalog = require(Shared:WaitForChild("ItemCatalog"))
local BundleCatalog = require(Shared:WaitForChild("BundleCatalog"))
local UIConfig = require(Shared:WaitForChild("UIConfig"))

local ShopService = {}
local initialized = false

local _EconomyService   = nil
local _InventoryService = nil
local _GrantService = nil
local _bundleBuyInFlight: { [number]: boolean } = {}

local function getEconomy()
	if _EconomyService then return _EconomyService end
	local ok, mod = pcall(require, Server:WaitForChild("EconomyService", 10))
	if ok and mod then _EconomyService = mod end
	return _EconomyService
end

local function getInventory()
	if _InventoryService then return _InventoryService end
	local ok, mod = pcall(require, Server:WaitForChild("InventoryService", 10))
	if ok and mod then _InventoryService = mod end
	return _InventoryService
end

local function getGrant()
	if _GrantService then return _GrantService end
	local ok, mod = pcall(require, Server:WaitForChild("GrantService", 10))
	if ok and mod then _GrantService = mod end
	return _GrantService
end

-- Map shop item type → catalog category
local TYPE_TO_CATEGORY = {
	ExclusiveCrown = "Crowns",
	ExclusivePet   = "Pets",
}

local BUNDLE_ALIASES: { [string]: string } = {
	fnaf_all = "fnaf_pets_bundle",
	fnaf_pets_bundle = "fnaf_pets_bundle",
	brainrot_all = "brainrot_bundle",
	brainrot_bundle = "brainrot_bundle",
}

local COIN_BUNDLE_CONFIG: { [string]: { requestId: string, logId: string, basePrice: number, perOwnedDiscount: number, successName: string } } = {
	fnaf_pets_bundle = {
		requestId = "fnaf_all",
		logId = "fnaf_all",
		basePrice = 150000,
		perOwnedDiscount = 0.10,
		successName = "All FNAF pets unlocked",
	},
	brainrot_bundle = {
		requestId = "brainrot_all",
		logId = "brainrot",
		basePrice = 150000,
		perOwnedDiscount = 0.10,
		successName = "Brainrot Bundle",
	},
}
local BRAINROT_BUNDLE_ID = "brainrot_bundle"
local BRAINROT_ITEM_PRICE = 75000

local function toGrantType(category: string): string?
	if category == "Pets" then return "Pet" end
	if category == "Crowns" then return "Crown" end
	if category == "IconImages" then return "IconImage" end
	return nil
end

local function findTopUpProduct(shortage: number): (number?, number?)
	local bestProductId: number? = nil
	local bestAmount: number? = nil
	for _, entry in ipairs(UIConfig.MockPremiumItems or {}) do
		if entry.type == "Currency" and type(entry.productId) == "number" and entry.productId > 0 then
			local amount = tonumber(entry.coinsAmount) or 0
			if amount >= shortage then
				if bestAmount == nil or amount < (bestAmount :: number) then
					bestAmount = amount
					bestProductId = entry.productId
				end
			end
		end
	end
	return bestProductId, bestAmount
end

local function getCoinBundleQuote(player: Player, bundleId: string): { ok: boolean, reason: string?, price: number, ownedCount: number, totalCount: number, missingCount: number }
	local cfg = COIN_BUNDLE_CONFIG[bundleId]
	local bundle = BundleCatalog.Get(bundleId)
	if not cfg or not bundle then
		return { ok = false, reason = "BUNDLE_NOT_SUPPORTED", price = 0, ownedCount = 0, totalCount = 0, missingCount = 0 }
	end

	local IS = getInventory()
	if not IS then
		local total = #(bundle.includes or {})
		return { ok = false, reason = "InventoryService unavailable", price = cfg.basePrice, ownedCount = 0, totalCount = total, missingCount = total }
	end

	local ownedCount = 0
	local totalCount = 0
	for _, inc in ipairs(bundle.includes or {}) do
		local grantType = toGrantType(inc.category)
		if grantType and inc.itemId then
			totalCount += 1
			if IS.OwnsItem(player, inc.category, inc.itemId) then
				ownedCount += 1
			end
		end
	end
	local missingCount = math.max(0, totalCount - ownedCount)
	if missingCount == 0 then
		print(string.format("[BundleQuote] bundle=%s owned=%d/%d price=0", cfg.logId, ownedCount, totalCount))
		return {
			ok = false,
			reason = "ALREADY_OWNED",
			price = 0,
			ownedCount = ownedCount,
			totalCount = totalCount,
			missingCount = missingCount,
		}
	end

	local discountPercent = ownedCount * cfg.perOwnedDiscount
	local finalPrice = math.floor(cfg.basePrice * (1 - discountPercent))
	finalPrice = math.max(0, finalPrice)

	print(string.format("[BundleQuote] bundle=%s owned=%d/%d price=%d", cfg.logId, ownedCount, totalCount, finalPrice))
	return {
		ok = true,
		price = finalPrice,
		ownedCount = ownedCount,
		totalCount = totalCount,
		missingCount = missingCount,
	}
end

function ShopService.GetBundleQuote(player: Player, requestBundleId: string)
	local bundleId = BUNDLE_ALIASES[requestBundleId] or requestBundleId
	if COIN_BUNDLE_CONFIG[bundleId] then
		return getCoinBundleQuote(player, bundleId)
	end
	return { ok = false, reason = "BUNDLE_NOT_SUPPORTED", price = 0, ownedCount = 0, totalCount = 0, missingCount = 0 }
end

local function buyBundleWithCoins(player: Player, requestBundleId: string): { success: boolean, reason: string?, grantedCount: number?, grantedItemIds: {string}?, productId: number?, shortage: number?, recommendedCoins: number? }
	local bundleId = BUNDLE_ALIASES[requestBundleId] or requestBundleId
	local cfg = COIN_BUNDLE_CONFIG[bundleId]
	local bundle = BundleCatalog.Get(bundleId)
	if not bundle or not cfg then
		return { success = false, reason = "Bundle is not available for Fate Coins" }
	end

	local inFlightKey = player.UserId
	if _bundleBuyInFlight[inFlightKey] then
		return { success = false, reason = "Purchase in progress" }
	end
	_bundleBuyInFlight[inFlightKey] = true

	local ES = getEconomy()
	local IS = getInventory()
	local GS = getGrant()
	if not ES or not IS or not GS then
		_bundleBuyInFlight[inFlightKey] = nil
		return { success = false, reason = "Shop services unavailable" }
	end

	local quote = getCoinBundleQuote(player, bundleId)
	local ownedCount = quote.ownedCount
	local totalCount = quote.totalCount
	local missingCount = quote.missingCount
	local finalCost = quote.price
	if not quote.ok then
		print(string.format("[BundleBuy] bundle=%s cost=%d result=FAIL reason=%s",
			cfg.logId, finalCost, tostring(quote.reason)))
		_bundleBuyInFlight[inFlightKey] = nil
		return {
			success = false,
			reason = quote.reason or "ALREADY_OWNED",
			finalCost = finalCost,
			missingCount = missingCount,
			ownedCount = ownedCount,
			totalCount = totalCount,
		}
	end

	local toGrant = {}
	for _, inc in ipairs(bundle.includes or {}) do
		local grantType = toGrantType(inc.category)
		if grantType and inc.itemId and not IS.OwnsItem(player, inc.category, inc.itemId) then
			table.insert(toGrant, inc)
		end
	end
	if #toGrant == 0 then
		print(string.format("[BundleBuy] bundle=%s cost=%d result=FAIL reason=ALREADY_OWNED",
			cfg.logId, finalCost))
		_bundleBuyInFlight[inFlightKey] = nil
		return { success = false, reason = "ALREADY_OWNED" }
	end

	local balance = ES.GetCoins(player)
	if balance < finalCost then
		local shortage = finalCost - balance
		local productId, recommendedCoins = findTopUpProduct(shortage)
		print(string.format("[BundleBuy] bundle=%s cost=%d result=FAIL reason=INSUFFICIENT_COINS",
			cfg.logId, finalCost))
		print(string.format("[BundleBuy] insufficient coins shortage=%d suggestedProductId=%s",
			shortage, tostring(productId)))
		_bundleBuyInFlight[inFlightKey] = nil
		return {
			success = false,
			reason = "INSUFFICIENT_COINS",
			productId = productId,
			shortage = shortage,
			recommendedCoins = recommendedCoins,
			finalCost = finalCost,
			missingCount = missingCount,
			ownedCount = ownedCount,
			totalCount = totalCount,
		}
	end

	local deducted = ES.DeductCoins(player, finalCost, "BundlePurchase:" .. bundleId)
	if not deducted then
		_bundleBuyInFlight[inFlightKey] = nil
		return { success = false, reason = "Failed to deduct coins" }
	end

	local grantedCount = 0
	local grantedItemIds = {}
	for _, inc in ipairs(toGrant) do
		local grantType = toGrantType(inc.category)
		if grantType then
			local grantRes = GS.GrantItem(player, grantType, inc.itemId, "Bundle", {
				fireReward = false,
				idempotencyKey = string.format("bundle:%s:%s:%s", tostring(player.UserId), bundleId, inc.itemId),
			})
			if grantRes.success then
				grantedCount += 1
				table.insert(grantedItemIds, inc.itemId)
			end
		end
	end

	if grantedCount == 0 then
		ES.AwardCoins(player, finalCost, "BundleRefund:" .. bundleId, true)
		_bundleBuyInFlight[inFlightKey] = nil
		print(string.format("[BundleBuy] bundle=%s cost=%d result=FAIL reason=FAILED_TO_GRANT",
			cfg.logId, finalCost))
		return { success = false, reason = "Failed to grant bundle items" }
	end

	print(string.format("[BundleBuy] bundle=%s cost=%d result=SUCCESS", cfg.logId, finalCost))
	GS.EmitBundlePurchaseConfirmed(player, cfg.requestId, {
		token = HttpService:GenerateGUID(false),
		title = "PURCHASED!",
		name = cfg.successName,
		itemType = "Bundle",
		itemId = cfg.requestId,
		rarityText = (cfg.logId == "brainrot") and "Legendary" or "Common",
		icon = bundle.coverImage,
		okText = "NICE!",
	})
	_bundleBuyInFlight[inFlightKey] = nil
	return {
		success = true,
		grantedCount = grantedCount,
		grantedItemIds = grantedItemIds,
		finalCost = finalCost,
		missingCount = missingCount,
		ownedCount = ownedCount,
		totalCount = totalCount,
	}
end

local function getBundleInclude(bundleId: string, itemId: string)
	local bundle = BundleCatalog.Get(bundleId)
	if not bundle then return nil end
	for _, inc in ipairs(bundle.includes or {}) do
		if inc.itemId == itemId then
			return inc
		end
	end
	return nil
end

function ShopService.BuyBrainrotItem(player: Player, itemId: string): { success: boolean, reason: string?, productId: number?, shortage: number?, recommendedCoins: number? }
	if type(itemId) ~= "string" or itemId == "" then
		return { success = false, reason = "Invalid item" }
	end
	local include = getBundleInclude(BRAINROT_BUNDLE_ID, itemId)
	if not include then
		return { success = false, reason = "Item not in brainrot bundle" }
	end

	local grantType = toGrantType(include.category)
	if not grantType then
		return { success = false, reason = "Unsupported bundle item category" }
	end

	local ES = getEconomy()
	local IS = getInventory()
	local GS = getGrant()
	if not ES or not IS or not GS then
		return { success = false, reason = "Shop services unavailable" }
	end

	if IS.OwnsItem(player, include.category, itemId) then
		print(string.format("[ItemBuy] bundle=brainrot item=%s cost=%d result=FAIL reason=ALREADY_OWNED", itemId, BRAINROT_ITEM_PRICE))
		return { success = false, reason = "ALREADY_OWNED" }
	end

	local balance = ES.GetCoins(player)
	if balance < BRAINROT_ITEM_PRICE then
		local shortage = BRAINROT_ITEM_PRICE - balance
		local productId, recommendedCoins = findTopUpProduct(shortage)
		print(string.format("[ItemBuy] bundle=brainrot item=%s cost=%d result=FAIL reason=INSUFFICIENT_COINS", itemId, BRAINROT_ITEM_PRICE))
		return {
			success = false,
			reason = "INSUFFICIENT_COINS",
			productId = productId,
			shortage = shortage,
			recommendedCoins = recommendedCoins,
		}
	end

	local deducted = ES.DeductCoins(player, BRAINROT_ITEM_PRICE, "BundleItemPurchase:" .. itemId)
	if not deducted then
		print(string.format("[ItemBuy] bundle=brainrot item=%s cost=%d result=FAIL reason=DEDUCT_FAILED", itemId, BRAINROT_ITEM_PRICE))
		return { success = false, reason = "Failed to deduct coins" }
	end

	local grantRes = GS.GrantItem(player, grantType, itemId, "BundleItem", {
		fireReward = false,
		idempotencyKey = string.format("bundleitem:%s:%s", tostring(player.UserId), itemId),
	})
	if not grantRes.success then
		ES.AwardCoins(player, BRAINROT_ITEM_PRICE, "BundleItemRefund:" .. itemId, true)
		print(string.format("[ItemBuy] bundle=brainrot item=%s cost=%d result=FAIL reason=%s", itemId, BRAINROT_ITEM_PRICE, tostring(grantRes.reason)))
		return { success = false, reason = tostring(grantRes.reason or "Grant failed") }
	end
	if grantRes.payload and type(GS.EmitPurchaseGranted) == "function" then
		GS.EmitPurchaseGranted(player, grantRes.payload)
	end

	print(string.format("[ItemBuy] bundle=brainrot item=%s cost=%d result=SUCCESS", itemId, BRAINROT_ITEM_PRICE))
	return { success = true }
end

function ShopService.BuyWithCoins(player: Player, itemId: string, itemType: string): { success: boolean, reason: string?, productId: number?, shortage: number?, recommendedCoins: number? }
	if not itemId or not itemType then
		return { success = false, reason = "Invalid request" }
	end

	if itemType == "Bundle" then
		return buyBundleWithCoins(player, itemId)
	end

	-- Resolve premium entry for price
	local premiumEntry = ItemCatalog.Get("Premium", itemId)
	if not premiumEntry then
		return { success = false, reason = "Item not found in shop" }
	end

	local price = premiumEntry.fateCoins
	if not price or price <= 0 then
		return { success = false, reason = "Item is not available for Fate Coins" }
	end

	local category = TYPE_TO_CATEGORY[itemType]
	if not category then
		return { success = false, reason = "Invalid item type: " .. tostring(itemType) }
	end

	local IS = getInventory()
	local GS = getGrant()
	if not IS or not GS then
		return { success = false, reason = "Grant services unavailable" }
	end

	-- Already owned?
	if IS.OwnsItem(player, category, itemId) then
		return { success = false, reason = "Already owned" }
	end

	-- Check and deduct coins
	local ES = getEconomy()
	if not ES then
		return { success = false, reason = "EconomyService unavailable" }
	end

	local balance = ES.GetCoins(player)
	if balance < price then
		local shortage = price - balance
		local productId, recommendedCoins = findTopUpProduct(shortage)
		return {
			success = false,
			reason = "INSUFFICIENT_COINS",
			productId = productId,
			shortage = shortage,
			recommendedCoins = recommendedCoins,
		}
	end

	local deducted = ES.DeductCoins(player, price, "ShopPurchase:" .. itemId)
	if not deducted then
		return { success = false, reason = "Failed to deduct coins" }
	end

	local grantType = (category == "Crowns") and "Crown" or "Pet"
	local grantRes = GS.GrantItem(player, grantType, itemId, "Shop", {
		fireReward = false,
		idempotencyKey = string.format("shop:%s:%s:%s", tostring(player.UserId), category, itemId),
	})
	if not grantRes.success then
		-- Refund on grant failure
		ES.AwardCoins(player, price, "ShopRefund:" .. itemId, true)
		return { success = false, reason = "Failed to grant item: " .. tostring(grantRes.reason) }
	end
	if grantRes.payload and type(GS.EmitPurchaseGranted) == "function" then
		GS.EmitPurchaseGranted(player, grantRes.payload)
	end

	print(string.format("[ShopService] %s purchased %s/%s for %d Fate Coins", player.Name, category, itemId, price))
	return { success = true }
end

function ShopService.Init()
	if initialized then return end
	initialized = true

	-- Create RemoteFunction
	local remotes = ReplicatedStorage:FindFirstChild("Remotes")
	if not remotes then
		remotes = Instance.new("Folder")
		remotes.Name   = "Remotes"
		remotes.Parent = ReplicatedStorage
	end

	local buyRF = remotes:FindFirstChild("Shop_BuyWithCoins")
	if not buyRF then
		buyRF = Instance.new("RemoteFunction")
		buyRF.Name   = "Shop_BuyWithCoins"
		buyRF.Parent = remotes
	end

	local quoteRF = remotes:FindFirstChild("Shop_GetBundleQuote")
	if not quoteRF then
		quoteRF = Instance.new("RemoteFunction")
		quoteRF.Name = "Shop_GetBundleQuote"
		quoteRF.Parent = remotes
	end
	local buyBrainrotItemRF = remotes:FindFirstChild("BuyBrainrotItem")
	if not buyBrainrotItemRF then
		buyBrainrotItemRF = Instance.new("RemoteFunction")
		buyBrainrotItemRF.Name = "BuyBrainrotItem"
		buyBrainrotItemRF.Parent = remotes
	end

	buyRF.OnServerInvoke = function(player: Player, itemId: string, itemType: string)
		local ok, result = pcall(ShopService.BuyWithCoins, player, itemId, itemType)
		if ok then return result end
		warn("[ShopService] BuyWithCoins error:", result)
		return { success = false, reason = "Internal error" }
	end

	quoteRF.OnServerInvoke = function(player: Player, requestBundleId: string)
		local ok, result = pcall(ShopService.GetBundleQuote, player, requestBundleId)
		if ok then return result end
		warn("[ShopService] GetBundleQuote error:", result)
		return { ok = false, reason = "Internal error", price = 0, ownedCount = 0, totalCount = 0, missingCount = 0 }
	end
	buyBrainrotItemRF.OnServerInvoke = function(player: Player, itemId: string)
		local ok, result = pcall(ShopService.BuyBrainrotItem, player, itemId)
		if ok then return result end
		warn("[ShopService] BuyBrainrotItem error:", result)
		return { success = false, reason = "Internal error" }
	end

	print("[ShopService] Initialized")
end

return ShopService
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="78">
        <Properties>
          <string name="Name">SpecialPetMotorRig</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local HttpService = game:GetService("HttpService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local ItemCatalog = require(Shared:WaitForChild("ItemCatalog"))
local ItemModelRegistry = require(Shared:WaitForChild("ItemModelRegistry"))

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local EquipRemote = Remotes:WaitForChild("EquipWalkerPet")
local UnequipRemote = Remotes:WaitForChild("UnequipWalkerPet")

local TAG = "[SpecialPetMotorRig]"
local ROOT_FOLDER_NAME = "_EquippedPetsMotor"
local DEBUG_SPECIAL_PET_RIG = RunService:IsStudio()
local TARGET_MAX_DIM = 3.0
local SCALE_HARD_MAX = 5.0

local PET_SCALE_MULTIPLIER: { [string]: number } = {
	pet_pink_butterfly = 1.5,
	pet_glitched_dragon = 1.8,
	pet_dark_winged_dragon = 1.6, -- Music Winged Dragon
	pet_dark_falcon = 1.4, -- Dark Goblem
}

local TARGET_PETS: { [string]: boolean } = {
	pet_pink_butterfly = true,
	pet_glitched_dragon = true,
	pet_dark_winged_dragon = true, -- Music Winged Dragon
	pet_dark_falcon = true, -- Dark Goblem
}

-- Pets in this set should keep spawn/orbit/weld behavior but never create animated Motor6D joints.
local STATIC_SPECIAL_PETS_NO_MOTOR: { [string]: boolean } = {
	pet_dark_falcon = true, -- Dark Goblem
}

local ORBIT_PETS: { [string]: boolean } = {
	pet_pink_butterfly = true,
	pet_glitched_dragon = true,
	pet_dark_winged_dragon = true,
}

local YAW_OVERRIDE_RAD: { [string]: number } = {
	pet_pink_butterfly = math.rad(-90),
	pet_glitched_dragon = math.rad(90),
	pet_dark_winged_dragon = 0,
	pet_dark_falcon = math.rad(180),
}

local PINK_BUTTERFLY_FLAP_SPEED = 8.0
local PINK_BUTTERFLY_FLAP_AMP_RAD = math.rad(35)
local DARK_GOBLEM_BOB_AMP = 0.55
local DARK_GOBLEM_BOB_SPEED = 2.4
local DARK_GOBLEM_SWAY_AMP = 0.22
local DARK_GOBLEM_SWAY_SPEED = 1.6
local DARK_GOBLEM_YAW_BOB_AMP_RAD = math.rad(6)

type MotorInfo = {
	motor: Motor6D,
	baseC0: CFrame,
	mode: "wing_h" | "wing_v" | "arm",
	sign: number,
	wingRole: "primary" | "secondary" | nil,
}

type ActiveEntry = {
	player: Player,
	petId: string,
	model: Model,
	root: BasePart,
	rootWeld: Weld,
	motors: { MotorInfo },
	orbitEnabled: boolean,
	t0: number,
	phase: number,
	animDebugLogged: boolean,
}

local _active: { [Player]: ActiveEntry } = {}
local _scaleApplyCountByModel: { [string]: number } = {}
local _spawnLoopCountByPlayer: { [number]: number } = {}

local function normalizedName(name: string): string
	return string.lower((string.gsub(name, "^%s*(.-)%s*$", "%1")))
end

local function isAnimatedTargetPart(petId: string, part: BasePart): boolean
	local name = normalizedName(part.Name)
	if petId == "pet_pink_butterfly" then
		return name == "butterflywing"
	elseif petId == "pet_glitched_dragon" then
		return name == "wingsfloatdrag"
	elseif petId == "pet_dark_winged_dragon" then
		return name == "wingsfloat"
	elseif petId == "pet_dark_falcon" then
		return string.find(name, "arm", 1, true) ~= nil
	end
	return false
end

local function getRootFolder(): Folder
	local root = Workspace:FindFirstChild(ROOT_FOLDER_NAME)
	if root and root:IsA("Folder") then
		return root
	end
	root = Instance.new("Folder")
	root.Name = ROOT_FOLDER_NAME
	root.Parent = Workspace
	return root
end

local function getPlayerFolder(player: Player): Folder
	local root = getRootFolder()
	local key = tostring(player.UserId)
	local folder = root:FindFirstChild(key)
	if folder and folder:IsA("Folder") then
		return folder
	end
	folder = Instance.new("Folder")
	folder.Name = key
	folder.Parent = root
	return folder
end

local function chooseRoot(model: Model): BasePart?
	local preferred = { "HumanoidRootPart", "Root", "RootPart", "Handle", "UpperTorso", "Torso", "LowerTorso" }
	for _, name in ipairs(preferred) do
		local p = model:FindFirstChild(name, true)
		if p and p:IsA("BasePart") then
			model.PrimaryPart = p
			return p
		end
	end

	local best: BasePart? = nil
	local bestVolume = -1
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			local n = normalizedName(d.Name)
			if n == "butterflywing" or n == "wingsfloatdrag" or n == "wingsfloat" then
				continue
			end
			local v = d.Size.X * d.Size.Y * d.Size.Z
			if v > bestVolume then
				bestVolume = v
				best = d
			end
		end
	end
	if best then
		model.PrimaryPart = best
	end
	return best
end

local function sanitizeParts(model: Model)
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			d.Anchored = false
			d.CanCollide = false
			d.CanQuery = false
			d.CanTouch = false
			d.Massless = true
		elseif d:IsA("Script") or d:IsA("LocalScript") then
			d:Destroy()
		end
	end
end

local function removePartJoints(model: Model, part: BasePart)
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("Motor6D") or d:IsA("Weld") or d:IsA("WeldConstraint") then
			local p0 = (d :: any).Part0
			local p1 = (d :: any).Part1
			if p0 == part or p1 == part then
				d:Destroy()
			end
		end
	end
end

local function hasJointForPart(model: Model, part: BasePart): boolean
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("Motor6D") or d:IsA("Weld") or d:IsA("WeldConstraint") then
			local p0 = (d :: any).Part0
			local p1 = (d :: any).Part1
			if p0 == part or p1 == part then
				return true
			end
		end
	end
	return false
end

local function ensureStaticWelds(model: Model, root: BasePart, skipParts: { [BasePart]: boolean })
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") and d ~= root and not skipParts[d] then
			if not hasJointForPart(model, d) then
				local wc = Instance.new("WeldConstraint")
				wc.Name = "_PetStaticWeld"
				wc.Part0 = root
				wc.Part1 = d
				wc.Parent = root
			end
		end
	end
end

local function enforceDarkGoblemFullAssembly(model: Model, root: BasePart)
	-- Dark Goblem is a static special pet now; force a rigid root assembly
	-- so no body chunks are left disconnected by legacy intra-model joints.
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") and d ~= root then
			removePartJoints(model, d)
			d.Anchored = false
			d.CanCollide = false
			d.CanQuery = false
			d.CanTouch = false
			d.Massless = true

			local wc = Instance.new("WeldConstraint")
			wc.Name = "_DarkGoblemFullBodyWeld"
			wc.Part0 = root
			wc.Part1 = d
			wc.Parent = root
		end
	end
end

local function getPartNameCounts(inst: Instance?): { [string]: number }
	local counts: { [string]: number } = {}
	if not inst then
		return counts
	end
	for _, d in ipairs(inst:GetDescendants()) do
		if d:IsA("BasePart") then
			counts[d.Name] = (counts[d.Name] or 0) + 1
		end
	end
	return counts
end

local function countParts(inst: Instance?): number
	local n = 0
	if not inst then
		return n
	end
	for _, d in ipairs(inst:GetDescendants()) do
		if d:IsA("BasePart") then
			n += 1
		end
	end
	return n
end

local function darkGoblemMissingParts(sourceInst: Instance?, equippedModel: Model): string
	local src = getPartNameCounts(sourceInst)
	local eq = getPartNameCounts(equippedModel)
	local missing: { string } = {}
	for name, sourceCount in pairs(src) do
		local equippedCount = eq[name] or 0
		if equippedCount < sourceCount then
			table.insert(missing, string.format("%s x%d", name, sourceCount - equippedCount))
		end
	end
	table.sort(missing)
	return (#missing > 0) and table.concat(missing, ", ") or "none"
end

local function getMaxDim(model: Model): number
	local _, size = model:GetBoundingBox()
	return math.max(size.X, size.Y, size.Z, 0.01)
end

local function ensurePinkButterflyVfxAttachment(model: Model, root: BasePart)
	if model:GetAttribute("_pinkVfxFixed") == true then
		return
	end

	local function asPath(inst: Instance?): string
		if not inst then
			return "nil"
		end
		local ok, full = pcall(function()
			return inst:GetFullName()
		end)
		return (ok and full) and full or inst.Name
	end

	local function isValidLocalAttachment(att: Attachment?): boolean
		if not att then
			return false
		end
		local parent = att.Parent
		return parent ~= nil and parent:IsA("BasePart") and att:IsDescendantOf(model)
	end

	local function findAttachmentCandidate(name: string?): Attachment?
		if type(name) ~= "string" or name == "" then
			return nil
		end
		for _, d in ipairs(model:GetDescendants()) do
			if d:IsA("Attachment") and d.Name == name and isValidLocalAttachment(d) then
				return d
			end
		end
		return nil
	end

	local function logPinkBeam(beam: Beam, valid: boolean, action: string)
		print(string.format(
			"[PinkButterflyBeam] beamValid=%s attachment0=%s attachment1=%s action=%s beam=%s",
			tostring(valid),
			asPath(beam.Attachment0),
			asPath(beam.Attachment1),
			action,
			asPath(beam)
		))
	end

	local anchor = root:FindFirstChild("VFX_Attachment")
	if anchor and not anchor:IsA("Attachment") then
		anchor:Destroy()
		anchor = nil
	end
	if not anchor then
		local newAnchor = Instance.new("Attachment")
		newAnchor.Name = "VFX_Attachment"
		-- Keep the effect attached near the butterfly body (not on ground).
		newAnchor.Position = Vector3.new(0, -0.35, -0.45)
		newAnchor.Parent = root
		anchor = newAnchor
	end

	-- Move invalid/orphan VFX under a rig-bound Attachment so it follows the pet.
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("Attachment") then
			local parent = d.Parent
			if not (parent and parent:IsA("BasePart")) then
				local hasVfxChild = false
				for _, child in ipairs(d:GetChildren()) do
					if child:IsA("ParticleEmitter") or child:IsA("Beam") or child:IsA("Trail") then
						hasVfxChild = true
						break
					end
				end
				if hasVfxChild then
					pcall(function()
						d.Parent = root
					end)
				end
			end
		elseif d:IsA("ParticleEmitter") then
			local hostPart = d:FindFirstAncestorWhichIsA("BasePart")
			local hostAttachment = d:FindFirstAncestorWhichIsA("Attachment")
			if not hostPart and not hostAttachment then
				pcall(function()
					d.Parent = anchor
				end)
			end
		end
	end

	-- Pink Butterfly only: strict beam validation/rebinding on the LIVE clone.
	for _, d in ipairs(model:GetDescendants()) do
		if not d:IsA("Beam") then
			continue
		end
		local beam = d
		local wantedEnabled = beam.Enabled
		beam.Enabled = false

		local action = "kept"
		local a0 = beam.Attachment0
		local a1 = beam.Attachment1
		local originalA0 = a0
		local originalA1 = a1

		if not isValidLocalAttachment(a0) then
			local rebound = findAttachmentCandidate(a0 and a0.Name or nil)
			if rebound then
				beam.Attachment0 = rebound
			end
		end
		if not isValidLocalAttachment(a1) then
			local rebound = findAttachmentCandidate(a1 and a1.Name or nil)
			if rebound then
				beam.Attachment1 = rebound
			end
		end

		a0 = beam.Attachment0
		a1 = beam.Attachment1
		if (a0 ~= originalA0) or (a1 ~= originalA1) then
			action = "rebound"
		end

		local validNow = isValidLocalAttachment(a0) and isValidLocalAttachment(a1)
		if not validNow then
			logPinkBeam(beam, false, "destroyed")
			beam:Destroy()
		else
			beam.Enabled = wantedEnabled
			logPinkBeam(beam, true, action)

			local alive = true
			local function enforceRuntime()
				if not alive or not beam.Parent then
					alive = false
					return
				end
				local ok = isValidLocalAttachment(beam.Attachment0) and isValidLocalAttachment(beam.Attachment1)
				if not ok then
					logPinkBeam(beam, false, "destroyed")
					alive = false
					beam:Destroy()
				end
			end
			beam:GetPropertyChangedSignal("Attachment0"):Connect(enforceRuntime)
			beam:GetPropertyChangedSignal("Attachment1"):Connect(enforceRuntime)
			if beam.Attachment0 then
				beam.Attachment0.AncestryChanged:Connect(enforceRuntime)
			end
			if beam.Attachment1 then
				beam.Attachment1.AncestryChanged:Connect(enforceRuntime)
			end
			beam.AncestryChanged:Connect(enforceRuntime)
		end
	end

	model:SetAttribute("_pinkVfxFixed", true)
end

local function getRigInstanceId(model: Model): string
	local existing = model:GetAttribute("RigInstanceGuid")
	if type(existing) == "string" and existing ~= "" then
		return existing
	end

	local guid: string? = nil
	local ok, generated = pcall(HttpService.GenerateGUID, HttpService, false)
	if ok and type(generated) == "string" and generated ~= "" then
		guid = generated
	else
		-- Fallback is runtime-safe and avoids plugin-only APIs.
		guid = string.format("%s|%s", model.Name, tostring(model))
	end

	pcall(function()
		model:SetAttribute("RigInstanceGuid", guid)
	end)
	return guid
end

local function applyDeterministicScale(model: Model, petId: string)
	local baselineScale = model:GetAttribute("_baselineScale")
	if type(baselineScale) ~= "number" then
		baselineScale = model:GetScale()
		model:SetAttribute("_baselineScale", baselineScale)
	end

	local baselineMaxDim = model:GetAttribute("_baselineMaxDim")
	if type(baselineMaxDim) ~= "number" then
		baselineMaxDim = getMaxDim(model)
		model:SetAttribute("_baselineMaxDim", baselineMaxDim)
	end

	local normalizeMul = TARGET_MAX_DIM / math.max(baselineMaxDim, 0.01)
	local finalMul = normalizeMul * (PET_SCALE_MULTIPLIER[petId] or 1.0)
	finalMul = math.clamp(finalMul, 0.05, SCALE_HARD_MAX)

	local targetScale = (baselineScale :: number) * finalMul
	targetScale = math.clamp(targetScale, 0.01, SCALE_HARD_MAX)

	model:ScaleTo(targetScale)
	model:SetAttribute("_appliedScale", targetScale)
	model:SetAttribute("_scaleAppliedOnce", true)

	local key = getRigInstanceId(model)
	_scaleApplyCountByModel[key] = (_scaleApplyCountByModel[key] or 0) + 1

	if DEBUG_SPECIAL_PET_RIG and TARGET_PETS[petId] then
		pcall(function()
			local _, box = model:GetBoundingBox()
			local primarySize = model.PrimaryPart and model.PrimaryPart.Size or Vector3.zero
			print(string.format(
				"[PetScaleDbg] pet=%s guid=%s scale=%.3f primarySize=<%.2f,%.2f,%.2f> bounds=<%.2f,%.2f,%.2f> appliedCount=%d",
				tostring(petId),
				key,
				targetScale,
				primarySize.X, primarySize.Y, primarySize.Z,
				box.X, box.Y, box.Z,
				_scaleApplyCountByModel[key]
			))
		end)
	end
end

local function motorFromRoot(root: BasePart, part: BasePart, name: string): Motor6D
	local m = Instance.new("Motor6D")
	m.Name = name
	m.Part0 = root
	m.Part1 = part
	m.C0 = root.CFrame:ToObjectSpace(part.CFrame)
	m.C1 = CFrame.new()
	m.Parent = root
	return m
end

local function findDarkGoblemHead(model: Model): BasePart?
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			local n = normalizedName(d.Name)
			if string.find(n, "head", 1, true) then
				return d
			end
			if d:FindFirstChild("Eyes") then
				return d
			end
		end
	end
	return nil
end

local function ensureDarkGoblemHead(model: Model, root: BasePart): BasePart?
	local head = findDarkGoblemHead(model)
	if not head then
		return nil
	end
	head.Transparency = math.min(head.Transparency, 0)
	head.Anchored = false

	local hasRootJoint = false
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("Weld") or d:IsA("WeldConstraint") or d:IsA("Motor6D") then
			local p0 = (d :: any).Part0
			local p1 = (d :: any).Part1
			if (p0 == root and p1 == head) or (p0 == head and p1 == root) then
				hasRootJoint = true
				break
			end
		end
	end
	if not hasRootJoint then
		local wc = Instance.new("WeldConstraint")
		wc.Name = "_PetHeadWeld"
		wc.Part0 = root
		wc.Part1 = head
		wc.Parent = root
	end
	return head
end

local function collectAnimatedParts(model: Model, petId: string): ({ BasePart }, { MotorInfo })
	local parts: { BasePart } = {}
	local motors: { MotorInfo } = {}
	local root = model.PrimaryPart
	if not root then
		return parts, motors
	end
	if STATIC_SPECIAL_PETS_NO_MOTOR[petId] then
		return parts, motors
	end

	local function addPart(part: BasePart, mode: "wing_h" | "wing_v" | "arm")
		if part == root then
			return
		end
		removePartJoints(model, part)
		part.Anchored = false
		local localPos = root.CFrame:PointToObjectSpace(part.Position)
		local sign = localPos.X >= 0 and 1 or -1
		local m = motorFromRoot(root, part, "_PetAnimMotor_" .. part.Name)
		pcall(function()
			m:SetAttribute("MotionRole", mode)
			m:SetAttribute("MotionTargetPart", part.Name)
		end)
		table.insert(parts, part)
		table.insert(motors, {
			motor = m,
			baseC0 = m.C0,
			mode = mode,
			sign = sign,
			wingRole = nil,
		})
	end

	local wantedMode: "wing_h" | "wing_v" | "arm" = "wing_h"
	if petId == "pet_glitched_dragon" or petId == "pet_dark_winged_dragon" then
		wantedMode = "wing_v"
	elseif petId == "pet_dark_falcon" then
		wantedMode = "arm"
	end

	local found = 0
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") and isAnimatedTargetPart(petId, d) then
			addPart(d, wantedMode)
			found += 1
		end
	end

	if found == 0 then
		if petId == "pet_pink_butterfly" then
			warn("[PetRigWarn] pet=Pink Butterfly missingPart=ButterFlyWing*")
		elseif petId == "pet_glitched_dragon" then
			warn("[PetRigWarn] pet=Glitched Dragon missingPart=WingsFloatDrag*")
		elseif petId == "pet_dark_winged_dragon" then
			warn("[PetRigWarn] pet=Music Winged Dragon missingPart=WingsFloat*")
		elseif petId == "pet_dark_falcon" then
			warn("[PetRigWarn] pet=Dark Goblem missingPart=*arm*")
		end
	end

	-- Pink Butterfly: motorsCreated=8 is too broad to animate as independent flappers.
	-- Mark one primary motor per side; all others are secondary followers.
	if petId == "pet_pink_butterfly" and #motors > 0 then
		local leftPrimary: MotorInfo? = nil
		local rightPrimary: MotorInfo? = nil
		local leftDist = -1
		local rightDist = -1
		for _, info in ipairs(motors) do
			local part = info.motor.Part1
			if part then
				local localPos = root.CFrame:PointToObjectSpace(part.Position)
				local lateral = math.abs(localPos.X)
				if info.sign < 0 then
					if lateral > leftDist then
						leftDist = lateral
						leftPrimary = info
					end
				else
					if lateral > rightDist then
						rightDist = lateral
						rightPrimary = info
					end
				end
			end
		end
		for _, info in ipairs(motors) do
			info.wingRole = "secondary"
		end
		if leftPrimary then
			leftPrimary.wingRole = "primary"
		end
		if rightPrimary then
			rightPrimary.wingRole = "primary"
		end
	end

	return parts, motors
end

local function debugLogWingRigDiagnostics(petId: string, motors: { MotorInfo })
	if not DEBUG_SPECIAL_PET_RIG then
		return
	end
	if petId ~= "pet_pink_butterfly" and petId ~= "pet_glitched_dragon" then
		return
	end
	local jointInfo: { string } = {}
	for _, info in ipairs(motors) do
		local m = info.motor
		local p0Name = m.Part0 and m.Part0.Name or "nil"
		local p1Name = m.Part1 and m.Part1.Name or "nil"
		local target = m.Part1 and isAnimatedTargetPart(petId, m.Part1) or false
		local attachedAtRest = false
		if m.Part0 and m.Part1 then
			local expected = (m.Part0.CFrame * m.C0 * m.Transform * m.C1:Inverse()).Position
			attachedAtRest = (expected - m.Part1.Position).Magnitude <= 0.2
		end
		table.insert(jointInfo, string.format(
			"%s parent=%s p0=%s p1=%s mode=%s target=%s restAttached=%s C0=%s C1=%s",
			m.Name,
			m.Parent and m.Parent.Name or "nil",
			p0Name,
			p1Name,
			info.mode,
			tostring(target),
			tostring(attachedAtRest),
			tostring(m.C0),
			tostring(m.C1)
		))
	end
	print(string.format("[PetWingRigDbg] pet=%s movingJoints=%d", petId, #motors))
	if #jointInfo > 0 then
		print("[PetWingRigDbg] joints:", table.concat(jointInfo, " | "))
	end
	if petId == "pet_glitched_dragon" then
		print("[PetWingRigDbg] glitchedMovingJointsChosen=true")
	end
end

local function ensurePinkFaceAttachment(model: Model, root: BasePart)
	local face = model:FindFirstChild("AnimatedFace", true)
	if not (face and face:IsA("BasePart")) then
		return
	end

	-- Ensure the face/body piece remains rigidly attached to the pet root.
	removePartJoints(model, face)
	local wc = Instance.new("WeldConstraint")
	wc.Name = "_PetPinkFaceWeld"
	wc.Part0 = root
	wc.Part1 = face
	wc.Parent = root
end

local function debugLogRigAssembly(
	model: Model,
	petId: string,
	motors: { MotorInfo },
	orientationApplied: boolean,
	headExists: boolean
)
	if not DEBUG_SPECIAL_PET_RIG or not TARGET_PETS[petId] then
		return
	end
	if model:GetAttribute("_rigAssemblyLogged") == true then
		return
	end

	local basePartList: { string } = {}
	local motorList: { string } = {}
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			table.insert(basePartList, d.Name .. "@" .. d:GetFullName())
		elseif d:IsA("Motor6D") then
			local p0 = d.Part0 and d.Part0.Name or "nil"
			local p1 = d.Part1 and d.Part1.Name or "nil"
			table.insert(motorList, string.format("%s p0=%s p1=%s parent=%s", d.Name, p0, p1, d.Parent and d.Parent.Name or "nil"))
		end
	end

	local resolvedMotors: { string } = {}
	for _, info in ipairs(motors) do
		local m = info.motor
		local p0 = m.Part0 and m.Part0.Name or "nil"
		local p1 = m.Part1 and m.Part1.Name or "nil"
		table.insert(resolvedMotors, string.format("%s(%s) p0=%s p1=%s", m.Name, info.mode, p0, p1))
	end

	pcall(function()
		print(string.format(
			"[PetRigDbg] pet=%s orientationApplied=%s headExists=%s resolvedMovingJoints=%d",
			petId,
			tostring(orientationApplied),
			tostring(headExists),
			#resolvedMotors
		))
		print("[PetRigDbg] movingJoints:", table.concat(resolvedMotors, " | "))
		print("[PetRigDbg] baseParts:", table.concat(basePartList, " | "))
		print("[PetRigDbg] motors:", table.concat(motorList, " | "))
	end)
	model:SetAttribute("_rigAssemblyLogged", true)
end

local function petDisplayName(petId: string): string
	local petDef = ItemCatalog.Pets and ItemCatalog.Pets[petId]
	if petDef and type(petDef.name) == "string" and petDef.name ~= "" then
		return petDef.name
	end
	return petId
end

local function resolveSource(petId: string): Instance?
	local petDef = ItemCatalog.Pets and ItemCatalog.Pets[petId]
	if not petDef then
		return nil
	end

	if type(petDef.modelPath) == "string" and petDef.modelPath ~= "" then
		local byPath = ItemModelRegistry.Get(petDef.modelPath)
		if byPath then
			return byPath
		end
	end

	if type(petDef.modelName) == "string" and petDef.modelName ~= "" then
		local byName = ItemModelRegistry.GetByExactName(petDef.modelName)
		if byName then
			return byName
		end
		local byAlias = ItemModelRegistry.Get(petDef.modelName)
		if byAlias then
			return byAlias
		end
	end

	return nil
end

local function destroyFor(player: Player)
	local entry = _active[player]
	if not entry then
		return
	end
	if entry.model and entry.model.Parent then
		entry.model:Destroy()
	end
	_active[player] = nil
end

local function makeRootWeld(ownerHrp: BasePart, root: BasePart): Weld
	local weld = Instance.new("Weld")
	weld.Name = "_PetRootWeld"
	weld.Part0 = ownerHrp
	weld.Part1 = root
	weld.C1 = CFrame.new()
	weld.C0 = CFrame.new(3, 2.8, 2)
	weld.Parent = ownerHrp
	return weld
end

local function spawnFor(player: Player, petId: string)
	if not TARGET_PETS[petId] then
		destroyFor(player)
		return
	end
	local existing = _active[player]
	if existing and existing.petId == petId and existing.model and existing.model.Parent then
		return
	end

	local char = player.Character
	local ownerHrp = char and char:FindFirstChild("HumanoidRootPart")
	if not ownerHrp or not ownerHrp:IsA("BasePart") then
		return
	end

	local source = resolveSource(petId)
	if not source then
		warn(TAG, "source not found for", petId)
		return
	end

	destroyFor(player)

	local cloneInst = source:Clone()
	local model: Model
	if cloneInst:IsA("Model") then
		model = cloneInst
	elseif cloneInst:IsA("BasePart") then
		model = Instance.new("Model")
		model.Name = cloneInst.Name
		cloneInst.Parent = model
		model.PrimaryPart = cloneInst
	else
		local firstPart = cloneInst:FindFirstChildWhichIsA("BasePart", true)
		if not firstPart then
			cloneInst:Destroy()
			return
		end
		model = Instance.new("Model")
		model.Name = cloneInst.Name
		cloneInst.Parent = model
		model.PrimaryPart = firstPart
	end

	model.Name = "_MotorPet_" .. player.Name
	model:SetAttribute("IsPet", true)
	model:SetAttribute("_petId", petId)
	model:SetAttribute("_owner", player.Name)
	model:SetAttribute("_serverMotorRig", true)
	model.Parent = getPlayerFolder(player)

	sanitizeParts(model)

	local root = chooseRoot(model)
	if not root then
		model:Destroy()
		return
	end
	model.PrimaryPart = root
	pcall(function() root:SetNetworkOwner(nil) end)

	applyDeterministicScale(model, petId)

	local animatedParts, motors = collectAnimatedParts(model, petId)
	local skip: { [BasePart]: boolean } = {}
	for _, p in ipairs(animatedParts) do
		skip[p] = true
	end
	if petId == "pet_pink_butterfly" then
		ensurePinkFaceAttachment(model, root)
	end
	ensureStaticWelds(model, root, skip)
	if petId == "pet_dark_falcon" then
		enforceDarkGoblemFullAssembly(model, root)
	end
	if petId == "pet_pink_butterfly" then
		ensurePinkButterflyVfxAttachment(model, root)
	end
	local head = if petId == "pet_dark_falcon" then ensureDarkGoblemHead(model, root) else nil

	local rootWeld = makeRootWeld(ownerHrp, root)
	root.CFrame = ownerHrp.CFrame * rootWeld.C0

	print(string.format("[PetRig] pet=%s root=%s motorsCreated=%d",
		petDisplayName(petId),
		root:GetFullName(),
		#motors))
	print(string.format("[PetAnim] pet=%s loopRunning=true", petDisplayName(petId)))
	print(string.format("[PetOrbit] pet=%s orbitEnabled=%s attachType=weld",
		petDisplayName(petId),
		tostring(ORBIT_PETS[petId] == true)))
	if petId == "pet_dark_falcon" then
		local sourceParts = countParts(source)
		local equippedParts = countParts(model)
		local missing = darkGoblemMissingParts(source, model)
		local result = if missing == "none" then "SUCCESS" else "FAIL"
		print(string.format("[DarkGoblemBuild] sourceParts=%d", sourceParts))
		print(string.format("[DarkGoblemBuild] equippedParts=%d", equippedParts))
		print(string.format("[DarkGoblemBuild] missingParts=%s", missing))
		print(string.format("[DarkGoblemBuild] result=%s", result))
	end
	if petId == "pet_glitched_dragon" then
		print("[PetAnimCfg] pet=pet_glitched_dragon flapDisabled=true")
	end
	debugLogRigAssembly(model, petId, motors, YAW_OVERRIDE_RAD[petId] ~= nil, head ~= nil)
	debugLogWingRigDiagnostics(petId, motors)

	_active[player] = {
		player = player,
		petId = petId,
		model = model,
		root = root,
		rootWeld = rootWeld,
		motors = motors,
		orbitEnabled = ORBIT_PETS[petId] == true,
		t0 = tick(),
		phase = (player.UserId % 37) * 0.17,
		animDebugLogged = false,
	}

	_spawnLoopCountByPlayer[player.UserId] = (_spawnLoopCountByPlayer[player.UserId] or 0) + 1
	if DEBUG_SPECIAL_PET_RIG then
		print(string.format(
			"[PetSpawnDbg] pet=%s loopsCreated=%d motors=%d orbit=%s",
			petDisplayName(petId),
			_spawnLoopCountByPlayer[player.UserId],
			#motors,
			tostring(ORBIT_PETS[petId] == true)
		))
	end
end

local function updateEntry(entry: ActiveEntry, dt: number)
	local player = entry.player
	local char = player.Character
	local ownerHrp = char and char:FindFirstChild("HumanoidRootPart")
	if not ownerHrp or not ownerHrp:IsA("BasePart") then
		return
	end
	if not entry.model.Parent or not entry.root.Parent then
		return
	end
	if not entry.rootWeld.Parent then
		return
	end

	local t = tick() - entry.t0

	local yaw = YAW_OVERRIDE_RAD[entry.petId] or 0
	if entry.orbitEnabled then
		local radius = 4.2
		local orbitSpeed = 0.9
		local bobAmp = 0.9
		local bobSpeed = 2.1
		local theta = t * orbitSpeed + entry.phase
		local x = math.cos(theta) * radius
		local z = math.sin(theta) * radius
		local y = 2.6 + math.sin(t * bobSpeed + entry.phase) * bobAmp
		entry.rootWeld.C0 = CFrame.new(x, y, z) * CFrame.Angles(0, yaw, 0)
	else
		if entry.petId == "pet_dark_falcon" then
			-- Dark Goblem: floating/bobbling idle at a fixed follow offset (no orbit).
			local sx = math.sin(t * DARK_GOBLEM_SWAY_SPEED + entry.phase) * DARK_GOBLEM_SWAY_AMP
			local sy = math.sin(t * DARK_GOBLEM_BOB_SPEED + entry.phase) * DARK_GOBLEM_BOB_AMP
			local sz = math.cos(t * (DARK_GOBLEM_SWAY_SPEED * 0.9) + entry.phase) * (DARK_GOBLEM_SWAY_AMP * 0.7)
			local yawBob = math.sin(t * 1.2 + entry.phase) * DARK_GOBLEM_YAW_BOB_AMP_RAD
			entry.rootWeld.C0 = CFrame.new(3 + sx, 2.8 + sy, 2 + sz) * CFrame.Angles(0, yaw + yawBob, 0)
		else
			entry.rootWeld.C0 = CFrame.new(3, 2.8, 2) * CFrame.Angles(0, yaw, 0)
		end
	end

	local applied = 0
	for _, info in ipairs(entry.motors) do
		if not info.motor.Parent or not info.motor.Part0 or not info.motor.Part1 then
			continue
		end
		if not info.motor.Part1:IsDescendantOf(entry.model) or info.motor.Part1.Anchored then
			continue
		end
		if not isAnimatedTargetPart(entry.petId, info.motor.Part1) then
			continue
		end
		if info.mode == "wing_h" then
			if entry.petId == "pet_pink_butterfly" then
				-- Pink Butterfly: explicit assembly groups, same direction sync.
				local flap = math.sin(t * PINK_BUTTERFLY_FLAP_SPEED) * PINK_BUTTERFLY_FLAP_AMP_RAD
				local ampMul = if info.wingRole == "secondary" then 0.55 else 1.0
				info.motor.C0 = CFrame.Angles(0, flap * ampMul, 0) * info.baseC0
			else
				local flap = math.sin(t * 8.0) * math.rad(35)
				info.motor.C0 = info.baseC0 * CFrame.Angles(0, flap, 0)
			end
			applied += 1
		elseif info.mode == "wing_v" then
			-- Music Winged Dragon reference behavior; Glitched Dragon shares this exactly.
			if entry.petId == "pet_glitched_dragon" then
				-- Explicit no-flap rule: keep orbit/spawn/orientation but no wing/arm motion updates.
				info.motor.C0 = info.baseC0
				continue
			end
			local flap = math.sin(t * 7.0) * math.rad(30)
			info.motor.C0 = info.baseC0 * CFrame.Angles(flap * info.sign, 0, 0)
			applied += 1
		elseif info.mode == "arm" then
			local sway = math.sin(t * 3.8 + info.sign * 0.2) * math.rad(18)
			info.motor.C0 = info.baseC0 * CFrame.Angles(0, 0, sway * info.sign)
			applied += 1
		end
	end

	if DEBUG_SPECIAL_PET_RIG and not entry.animDebugLogged and TARGET_PETS[entry.petId] then
		entry.animDebugLogged = true
		print(string.format(
			"[PetAnimDbg] pet=%s animationLoopStarted=true movingJoints=%d appliedThisTick=%d",
			entry.petId,
			#entry.motors,
			applied
		))
	end
end

local function syncFor(player: Player)
	local petId = player:GetAttribute("EquippedPet")
	if type(petId) ~= "string" or petId == "" then
		destroyFor(player)
		return
	end
	if not TARGET_PETS[petId] then
		destroyFor(player)
		return
	end

	local active = _active[player]
	if active and active.petId == petId and active.model.Parent then
		return
	end
	spawnFor(player, petId)
end

EquipRemote.OnServerEvent:Connect(function(player: Player, petId: string)
	if type(petId) ~= "string" then
		return
	end
	if not TARGET_PETS[petId] then
		return
	end
	if player:GetAttribute("EquippedPet") ~= petId then
		return
	end
	spawnFor(player, petId)
end)

UnequipRemote.OnServerEvent:Connect(function(player: Player)
	local equipped = player:GetAttribute("EquippedPet")
	if type(equipped) ~= "string" or equipped == "" or not TARGET_PETS[equipped] then
		destroyFor(player)
	end
end)

Players.PlayerAdded:Connect(function(player)
	player:GetAttributeChangedSignal("EquippedPet"):Connect(function()
		syncFor(player)
	end)
	player.CharacterAdded:Connect(function()
		task.wait(0.25)
		syncFor(player)
	end)
	player.CharacterRemoving:Connect(function()
		destroyFor(player)
	end)
	task.defer(function()
		syncFor(player)
	end)
end)

Players.PlayerRemoving:Connect(function(player)
	destroyFor(player)
end)

for _, player in ipairs(Players:GetPlayers()) do
	task.defer(function()
		syncFor(player)
	end)
	player:GetAttributeChangedSignal("EquippedPet"):Connect(function()
		syncFor(player)
	end)
	player.CharacterAdded:Connect(function()
		task.wait(0.25)
		syncFor(player)
	end)
	player.CharacterRemoving:Connect(function()
		destroyFor(player)
	end)
end

RunService.Heartbeat:Connect(function(dt)
	for player, entry in pairs(_active) do
		if not player.Parent then
			destroyFor(player)
		else
			updateEntry(entry, dt)
		end
	end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="79">
        <Properties>
          <string name="Name">SpinWheelBootstrap</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--[[
	SpinWheelBootstrap
	Server script that initializes the Spin The Wheel system.

	Creates:
	  • RemoteFunction: SpinWheel_GetData
	  • RemoteFunction: SpinWheel_RequestSpin
	  • RemoteFunction: SpinWheel_BuySpins
	  • ProximityPrompt on a ground-level invisible anchor near SpinTheWheel

	Also:
	  • Removes ClickDetectors from SpinTheWheel (no click-to-spin)
	  • Removes/disables embedded Scripts/LocalScripts (bad sound assets, old logic)
	  • Handles MarketplaceService.ProcessReceipt for Robux spin purchases

	FIX: ProximityPrompt is now on a dedicated invisible anchor Part at ground level
	     so the "Press E" UI is visible from all angles and distance measurements
	     are consistent between the prompt trigger and the auto-close check.

	Wires player join/leave for data persistence.
]]

local Players = game:GetService("Players")
local ServerScriptService = game:GetService("ServerScriptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local MarketplaceService = game:GetService("MarketplaceService")
local RunService = game:GetService("RunService")

-- Ensure Remotes folder
local remotesFolder = ReplicatedStorage:FindFirstChild("Remotes")
if not remotesFolder then
	remotesFolder = Instance.new("Folder")
	remotesFolder.Name = "Remotes"
	remotesFolder.Parent = ReplicatedStorage
end
local purchaseGrantedRE = remotesFolder:FindFirstChild("PurchaseGranted")
if not purchaseGrantedRE then
	purchaseGrantedRE = Instance.new("RemoteEvent")
	purchaseGrantedRE.Name = "PurchaseGranted"
	purchaseGrantedRE.Parent = remotesFolder
end

-- Create RemoteFunctions
local function ensureRemoteFunc(name: string): RemoteFunction
	local rf = remotesFolder:FindFirstChild(name)
	if not rf then
		rf = Instance.new("RemoteFunction")
		rf.Name = name
		rf.Parent = remotesFolder
	end
	return rf
end

local getDataRF    = ensureRemoteFunc("SpinWheel_GetData")
local requestSpinRF = ensureRemoteFunc("SpinWheel_RequestSpin")
local buySpinsRF    = ensureRemoteFunc("SpinWheel_BuySpins")

-- Load service + config
local Server = ServerScriptService:WaitForChild("Server")
local SpinWheelService = require(Server:WaitForChild("SpinWheelService"))

local Shared = ReplicatedStorage:WaitForChild("Shared")
local SpinWheelConfig = require(Shared:WaitForChild("SpinWheelConfig"))
local UIConfig = require(Shared:WaitForChild("UIConfig"))

SpinWheelService.Init()

-- Wire RemoteFunctions
getDataRF.OnServerInvoke = function(player)
	print("[SpinWheelBootstrap] GetData requested by", player.Name)
	return SpinWheelService.GetPlayerData(player)
end

requestSpinRF.OnServerInvoke = function(player)
	print("[SpinWheelBootstrap] RequestSpin from", player.Name)
	local result = SpinWheelService.RequestSpin(player)
	print("[SpinWheelBootstrap] RequestSpin result:", result.success, result.rewardName or result.reason or "")
	return result
end

buySpinsRF.OnServerInvoke = function(player, packageIndex)
	if type(packageIndex) ~= "number" then return { success = false, reason = "Invalid input" } end
	print("[SpinWheelBootstrap] BuySpins from", player.Name, "package:", packageIndex)
	return SpinWheelService.BuySpins(player, packageIndex)
end

-- Wire player events
Players.PlayerAdded:Connect(function(player)
	SpinWheelService.OnPlayerJoined(player)
end)

-- Handle players already in game (Studio)
for _, player in ipairs(Players:GetPlayers()) do
	task.spawn(function()
		SpinWheelService.OnPlayerJoined(player)
	end)
end

Players.PlayerRemoving:Connect(function(player)
	SpinWheelService.OnPlayerLeaving(player)
end)

-- Save all on shutdown
game:BindToClose(function()
	SpinWheelService.SaveAll()
end)

-- ═══════════════════════════════════════════════════════════════════
-- SHARED SERVICE REFERENCES (lazy-loaded)
-- ═══════════════════════════════════════════════════════════════════

local _InventoryService, _EconomyService, _CrateService, _ItemCatalog, _PlayerDataService, _GrantService
local _BundleCatalog

local function getInventoryService()
	if not _InventoryService then
		_InventoryService = require(Server:WaitForChild("InventoryService", 5))
	end
	return _InventoryService
end

local function getEconomyService()
	if not _EconomyService then
		_EconomyService = require(Server:WaitForChild("EconomyService", 5))
	end
	return _EconomyService
end

local function getCrateService()
	if not _CrateService then
		_CrateService = require(Server:WaitForChild("CrateService", 5))
	end
	return _CrateService
end

local function getPlayerDataService()
	if not _PlayerDataService then
		_PlayerDataService = require(Server:WaitForChild("PlayerDataService", 5))
	end
	return _PlayerDataService
end

local function getGrantService()
	if not _GrantService then
		_GrantService = require(Server:WaitForChild("GrantService", 5))
	end
	return _GrantService
end

local function getItemCatalog()
	if not _ItemCatalog then
		local SharedMod = ReplicatedStorage:FindFirstChild("Shared")
		if SharedMod then
			local mod = SharedMod:FindFirstChild("ItemCatalog")
			if mod then _ItemCatalog = require(mod) end
		end
	end
	return _ItemCatalog
end

local function getBundleCatalog()
	if not _BundleCatalog then
		local SharedMod = ReplicatedStorage:FindFirstChild("Shared")
		if SharedMod then
			local mod = SharedMod:FindFirstChild("BundleCatalog")
			if mod then _BundleCatalog = require(mod) end
		end
	end
	return _BundleCatalog
end

local function notifyClient(player: Player, reason: string, data: any?)
	local remotes = ReplicatedStorage:FindFirstChild("Remotes")
	local invUpdate = remotes and remotes:FindFirstChild("InventoryUpdated")
	if invUpdate then
		invUpdate:FireClient(player, reason, data)
	end
end

local function toRewardTypeFromCategory(category: string): string
	if category == "Crowns" then return "Crown" end
	if category == "Pets" then return "Pet" end
	if category == "IconImages" then return "IconImage" end
	return "Pet"
end

local function emitShopPurchaseGranted(player: Player, gamepassId: number, reward: { [string]: any })
	if reward.type == "Bundle" then
		return
	end
	local itemCatalog = getItemCatalog()
	local category = tostring(reward.category or "")
	local itemId = tostring(reward.itemId or "")
	local entry = itemCatalog and itemCatalog.Get and itemCatalog.Get(category, itemId) or nil
	local payload = {
		type = toRewardTypeFromCategory(category),
		id = itemId,
		category = category,
		name = entry and entry.name or tostring(reward.label or itemId),
		rarity = entry and entry.rarity or "Common",
		imageAssetId = entry and entry.image or "",
		source = "GamePass",
		gamepassId = gamepassId,
	}
	print(string.format("[ShopGrant] type=%s id=%s passId=%d result=SUCCESS",
		tostring(payload.type), itemId, tonumber(gamepassId) or 0))
	if purchaseGrantedRE then
		purchaseGrantedRE:FireClient(player, payload)
	end
end

-- ═══════════════════════════════════════════════════════════════════
-- CENTRAL PRODUCT_REWARD_MAP (Developer Products → rewards)
--
-- All Developer Product IDs and their reward logic in one table.
-- ProcessReceipt looks up productId here before falling back.
-- ═══════════════════════════════════════════════════════════════════

local PRODUCT_REWARD_MAP: { [number]: { type: string, [string]: any } } = {
	-- Spins (auto-populated from SpinWheelConfig below)

	-- Crate Bundles (6x each, uses CrateService.RollCrateFree)
	[3539706736] = { type = "Crate", crateId = "crate_crown",      quantity = 6, label = "6 Crown Crates" },
	[3539709447] = { type = "Crate", crateId = "crate_pet_common", quantity = 6, label = "6 Common Pet Crates" },
	[3539710049] = { type = "Crate", crateId = "crate_pet_rare",   quantity = 6, label = "6 Rare Pet Crates" },
	[3539710471] = { type = "Crate", crateId = "crate_pet_epic",   quantity = 6, label = "6 Epic Pet Crates" },
}

-- Auto-populate Fate Coin developer products from UIConfig (single source for shop UI + receipts)
for _, item in ipairs(UIConfig.MockPremiumItems or {}) do
	if item.type == "Currency" and type(item.productId) == "number" and item.productId > 0 then
		local amount = tonumber(item.coinsAmount) or 0
		if amount > 0 then
			PRODUCT_REWARD_MAP[item.productId] = {
				type = "Coins",
				amount = amount,
				label = tostring(item.name or (tostring(amount) .. " Fate Coins")),
			}
		end
	end
end

-- Auto-populate spin products from config
for _, pkg in ipairs(SpinWheelConfig.SpinPrices) do
	if pkg.productId and pkg.productId > 0 then
		PRODUCT_REWARD_MAP[pkg.productId] = { type = "Spins", amount = pkg.spins, label = pkg.label }
	end
end

print(string.format("[PurchaseSystem] PRODUCT_REWARD_MAP built: %d entries", (function()
	local n = 0; for _ in pairs(PRODUCT_REWARD_MAP) do n += 1 end; return n
end)()))

local function validateConfiguredRobuxProducts()
	-- Coins from shop config
	for _, entry in ipairs(UIConfig.MockPremiumItems or {}) do
		if entry.type == "Currency" and type(entry.productId) == "number" and entry.productId > 0 then
			if not PRODUCT_REWARD_MAP[entry.productId] then
				warn(string.format("[ReceiptMap] Missing mapping for coin productId=%d (%s)",
					entry.productId, tostring(entry.id)))
			end
		end
	end

	-- Crates from crate shop config
	for _, crate in ipairs(UIConfig.MockCrates or {}) do
		for _, price in ipairs(crate.prices or {}) do
			if price.currency == "Robux" and type(price.productId) == "number" and price.productId > 0 then
				if not PRODUCT_REWARD_MAP[price.productId] then
					warn(string.format("[ReceiptMap] Missing mapping for crate productId=%d (%s)",
						price.productId, tostring(crate.id)))
				end
			end
		end
	end

	-- Spins from spin config
	for _, pkg in ipairs(SpinWheelConfig.SpinPrices or {}) do
		if type(pkg.productId) == "number" and pkg.productId > 0 then
			if not PRODUCT_REWARD_MAP[pkg.productId] then
				warn(string.format("[ReceiptMap] Missing mapping for spin productId=%d (%s)",
					pkg.productId, tostring(pkg.label)))
			end
		end
	end
end

validateConfiguredRobuxProducts()

