-- ═══════════════════════════════════════════════════════════════════
-- NAME -&gt; ID MAPPING  (for SpinWheel compatibility)
-- ═══════════════════════════════════════════════════════════════════

ItemCatalog.NameToId = {}
-- Build automatically from Pets + Crowns
do
	for id, pet in pairs(ItemCatalog.Pets) do
		ItemCatalog.NameToId[pet.name] = { category = "Pets", id = id }
	end
	for id, crown in pairs(ItemCatalog.Crowns) do
		ItemCatalog.NameToId[crown.name] = { category = "Crowns", id = id }
	end
end

-- ═══════════════════════════════════════════════════════════════════
-- HELPER FUNCTIONS
-- ═══════════════════════════════════════════════════════════════════

local TABLES = {
	Pets     = ItemCatalog.Pets,
	Crowns   = ItemCatalog.Crowns,
	Premium  = ItemCatalog.Premium,
	Crates   = ItemCatalog.Crates,
	Icons    = ItemCatalog.Icons,
	Currency = ItemCatalog.Currency,
}

function ItemCatalog.Get(category: string, id: string)
	local tbl = TABLES[category]
	if tbl and id then
		return tbl[id]
	end
	return nil
end

function ItemCatalog.GetPet(id: string)
	return ItemCatalog.Pets[id]
end

function ItemCatalog.GetItem(itemType: string, id: string)
	if itemType == "Pet" then
		return ItemCatalog.Pets[id]
	end
	return ItemCatalog.Get(itemType, id)
end

function ItemCatalog.GetImage(itemOrPet)
	if itemOrPet and type(itemOrPet) == "table" then
		local img = itemOrPet.image
		if img and type(img) == "string" and img ~= "" then
			return img
		end
	end
	return ItemCatalog.FALLBACK_IMAGE
end

function ItemCatalog.GetImageById(category: string, id: string): string
	local entry = ItemCatalog.Get(category, id)
	return ItemCatalog.GetImage(entry)
end

function ItemCatalog.GetByName(displayName: string)
	local mapping = ItemCatalog.NameToId[displayName]
	if mapping then
		return ItemCatalog.Get(mapping.category, mapping.id)
	end
	return nil
end

function ItemCatalog.GetRarityColor(rarity: string): Color3
	local colors = {
		Common    = Color3.fromRGB(170, 178, 200),
		Uncommon  = Color3.fromRGB(58, 225, 62),
		Rare      = Color3.fromRGB(38, 150, 255),
		Epic      = Color3.fromRGB(178, 42, 255),
		Legendary = Color3.fromRGB(255, 198, 18),
		Exclusive = Color3.fromRGB(255, 58, 58),
	}
	return colors[rarity] or colors.Common
end

local RARITY_ORDER = { Common = 1, Uncommon = 2, Rare = 3, Epic = 4, Legendary = 5, Exclusive = 6 }

function ItemCatalog.GetAllPetsSorted(): { any }
	local list = {}
	for _, pet in pairs(ItemCatalog.Pets) do
		table.insert(list, pet)
	end
	table.sort(list, function(a, b)
		local ra = RARITY_ORDER[a.rarity] or 0
		local rb = RARITY_ORDER[b.rarity] or 0
		if ra ~= rb then return ra &lt; rb end
		return a.name &lt; b.name
	end)
	return list
end

function ItemCatalog.GetAllCrownsSorted(): { any }
	local list = {}
	for _, crown in pairs(ItemCatalog.Crowns) do
		table.insert(list, crown)
	end
	-- Sort: Level first, then Findable, then Exclusive; within group by rarity then name
	local SOURCE_ORDER = { Level = 1, Findable = 2, Exclusive = 3 }
	table.sort(list, function(a, b)
		local sa = SOURCE_ORDER[a.source] or 99
		local sb = SOURCE_ORDER[b.source] or 99
		if sa ~= sb then return sa &lt; sb end
		local ra = RARITY_ORDER[a.rarity] or 0
		local rb = RARITY_ORDER[b.rarity] or 0
		if ra ~= rb then return ra &lt; rb end
		return a.name &lt; b.name
	end)
	return list
end

function ItemCatalog.GetAllIconsSorted(): { any }
	local list = {}
	for _, iconId in ipairs(ItemCatalog._iconOrder) do
		local entry = ItemCatalog.Icons[iconId]
		if entry then
			table.insert(list, entry)
		end
	end
	return list
end

--- Get all pets of a specific rarity
function ItemCatalog.GetPetsByRarity(rarity: string): { any }
	local list = {}
	for _, pet in pairs(ItemCatalog.Pets) do
		if pet.rarity == rarity then
			table.insert(list, pet)
		end
	end
	return list
end

--- Get all crowns with a specific source
function ItemCatalog.GetCrownsBySource(source: string): { any }
	local list = {}
	for _, crown in pairs(ItemCatalog.Crowns) do
		if crown.source == source then
			table.insert(list, crown)
		end
	end
	return list
end

--- Resolve a model path to a ReplicatedStorage instance (via ItemModelRegistry)
function ItemCatalog.ResolveModelPath(modelPath: string): Instance?
	if not modelPath or modelPath == "" then return nil end
	local Shared = game:GetService("ReplicatedStorage"):FindFirstChild("Shared")
	if not Shared then return nil end
	local regModule = Shared:FindFirstChild("ItemModelRegistry")
	if not regModule then return nil end
	local ok, Registry = pcall(require, regModule)
	if ok and Registry and Registry.Get then
		return Registry.Get(modelPath)
	end
	return nil
end

--- Get the milestone wins required for a level crown (nil if not a level crown)
function ItemCatalog.GetMilestoneWins(crownId: string): number?
	for _, m in ipairs(ItemCatalog.LevelCrownMilestones) do
		if m.crownId == crownId then
			return m.wins
		end
	end
	return nil
end

return ItemCatalog</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="25">
        <Properties>
          <string name="Name">ItemModelRegistry</string>
          <string name="Source"><![CDATA[--[[
	ItemModelRegistry
	Single source of truth for item model lookup.

	Scans ReplicatedStorage.ItemModels ONCE on first require and builds
	a flat dictionary: normalizedKey -> Instance.

	Normalization (applied to both index keys AND lookup queries):
	  1. tostring
	  2. lowercase
	  3. trim leading/trailing whitespace
	  4. collapse multiple spaces into one
	  5. convert "\" and "." into "/"
	  6. collapse multiple "/" into one
	  7. strip leading "itemmodels/" prefix
	  8. strip trailing "/"

	Key examples (all resolve to same key):
	  "ItemModels.Pets.Common.noob"   -> "pets/common/noob"
	  "pets/common/Noob"              -> "pets/common/noob"
	  "Pets  /  Common /  NOOB"       -> "pets/common/noob"

	Indexes: Model, MeshPart, Part (any BasePart or Model under ItemModels).

	API:
	  ItemModelRegistry.Normalize(s)  -> string
	  ItemModelRegistry.Get(keyOrPath) -> Instance?
	  ItemModelRegistry.GetCount()     -> number
	  ItemModelRegistry.DumpKeys()     -- debug: prints all keys
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local TAG = "[ItemModelRegistry]"
print(TAG, "LOADED FROM:", script:GetFullName())

local ItemModelRegistry = {}

local _registry: { [string]: Instance } = {}
local _fuzzyRegistry: { [string]: Instance } = {} -- stripped spaces/underscores for fallback
local _exactNameRegistry: { [string]: Instance } = {} -- exact child.Name match (case-sensitive)
local _initialized = false
local _count = 0
local _duplicateWarned: { [string]: boolean } = {}
local _duplicateExactNameWarned: { [string]: boolean } = {}

-- =====================================================================
-- NORMALIZATION
-- =====================================================================

function ItemModelRegistry.Normalize(s: any): string
	local str = tostring(s or "")
	str = string.lower(str)
	str = string.match(str, "^%s*(.-)%s*$") or str   -- trim
	str = string.gsub(str, "%s+", " ")                 -- collapse spaces
	str = string.gsub(str, "\\", "/")                  -- backslash -> slash
	str = string.gsub(str, "%.", "/")                   -- dot -> slash
	str = string.gsub(str, "/+", "/")                   -- collapse slashes
	str = string.gsub(str, "^/", "")                    -- strip leading /
	str = string.gsub(str, "/$", "")                    -- strip trailing /
	-- strip leading "itemmodels/" prefix
	if string.sub(str, 1, 11) == "itemmodels/" then
		str = string.sub(str, 12)
	elseif str == "itemmodels" then
		str = ""
	end
	return str
end

--- Generate a fuzzy key by stripping spaces, underscores, and hyphens from each segment
local function toFuzzyKey(normalizedKey: string): string
	return string.gsub(normalizedKey, "[%s_%-]", "")
end

local Normalize = ItemModelRegistry.Normalize

-- =====================================================================
-- SCANNING
-- =====================================================================

local function scanFolder(folder: Instance, pathSegments: { string })
	for _, child in ipairs(folder:GetChildren()) do
		local seg = Normalize(child.Name)
		-- Build path for this child
		local childPath = {}
		for _, s in ipairs(pathSegments) do
			table.insert(childPath, s)
		end
		table.insert(childPath, seg)

		local isRenderable = child:IsA("Model") or child:IsA("BasePart") or child:IsA("Accessory")
		local isContainer = child:IsA("Folder")

		if isRenderable then
			local key = table.concat(childPath, "/")
			if not _registry[key] then
				_registry[key] = child
				_count += 1
				-- Also register fuzzy key for fallback matching
				local fuzzy = toFuzzyKey(key)
				if not _fuzzyRegistry[fuzzy] then
					_fuzzyRegistry[fuzzy] = child
				end
				-- Exact-name index (used for name-based lookups without folder assumptions).
				if not _exactNameRegistry[child.Name] then
					_exactNameRegistry[child.Name] = child
				elseif not _duplicateExactNameWarned[child.Name] then
					_duplicateExactNameWarned[child.Name] = true
					warn(TAG, "Duplicate exact-name key:", child.Name, "(using first match)")
				end
			elseif not _duplicateWarned[key] then
				_duplicateWarned[key] = true
				warn(TAG, "Duplicate key:", key)
			end
		end

		-- Recurse into Folders only (not into Models/Parts to avoid sub-part noise)
		if isContainer then
			scanFolder(child, childPath)
		end
	end
end

local function doInit()
	if _initialized then return end
	_initialized = true

	local itemModels = ReplicatedStorage:WaitForChild("ItemModels", 10)
	if not itemModels then
		warn(TAG, "ReplicatedStorage.ItemModels not found after 10s")
		return
	end

	scanFolder(itemModels, {})
	print(TAG, string.format("Ready: %d models indexed from ReplicatedStorage.ItemModels", _count))
end

-- =====================================================================
-- PUBLIC API
-- =====================================================================

--- Look up a model by any path format. Returns the source Instance or nil.
--- Falls back to fuzzy matching (strips spaces/underscores/hyphens) on miss.
function ItemModelRegistry.Get(keyOrPath: string): Instance?
	if not _initialized then doInit() end
	if not keyOrPath or keyOrPath == "" then return nil end

	local key = Normalize(keyOrPath)

	-- Exact match
	local result = _registry[key]
	if result then return result end

	-- Fuzzy fallback: strip spaces, underscores, hyphens
	local fuzzyKey = toFuzzyKey(key)
	result = _fuzzyRegistry[fuzzyKey]
	if result then return result end

	return nil
end

--- Look up by exact Instance.Name under ReplicatedStorage.ItemModels.
--- Case-sensitive and folder-agnostic.
function ItemModelRegistry.GetByExactName(modelName: string): Instance?
	if not _initialized then doInit() end
	if not modelName or modelName == "" then return nil end
	return _exactNameRegistry[modelName]
end

-- Alias for backward compat
ItemModelRegistry.GetByPath = ItemModelRegistry.Get

function ItemModelRegistry.GetCount(): number
	if not _initialized then doInit() end
	return _count
end

function ItemModelRegistry.DumpKeys()
	if not _initialized then doInit() end
	local keys = {}
	for k in pairs(_registry) do
		table.insert(keys, k)
	end
	table.sort(keys)
	print(TAG, string.format("=== %d keys ===", _count))
	for _, k in ipairs(keys) do
		print(TAG, " ", k, "->", _registry[k]:GetFullName())
	end
end

-- Auto-init on require
doInit()

return ItemModelRegistry
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="26">
        <Properties>
          <string name="Name">MatchState</string>
          <string name="Source"><![CDATA[--[[
	MatchState
	Shared constants for match lifecycle states.
	
	Used by: MatchManager, UI (future)
]]

export type State = "Intermission" | "Playing" | "Ending"

local MatchState = {}

-- All valid match states
MatchState.States = {
	Intermission = "Intermission",  -- Waiting for next match, collecting players
	Playing = "Playing",            -- Match is active
	Ending = "Ending",              -- Match ended, showing results
}

-- Validate if a string is a valid state
function MatchState.IsValid(state: string): boolean
	return MatchState.States[state] ~= nil
end

-- Get all state names as array
function MatchState.GetAll(): { State }
	return { "Intermission", "Playing", "Ending" }
end

return MatchState

]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="27">
        <Properties>
          <string name="Name">PetVisualConfig</string>
          <string name="Source"><![CDATA[-- Shared per-pet visual overrides for spawn/follow presentation only.
-- Does not modify source assets in ReplicatedStorage.

local PetVisualConfig = {}

local DEFAULT_FNAF_SCALE = 2.4

type VisualOverride = {
	scale: number?,
	rotation: CFrame?,
	rotDeg: Vector3?,
	debugTag: boolean?,
}

-- Per-pet rotation correction applied every follow frame via visual.rotation.
-- Yaw offsets (180°) for backwards-facing models.
-- Add pitch/roll corrections here if a model is inherently tilted.
local OVERRIDES: { [string]: VisualOverride } = {
	pet_steve = {
		rotation = CFrame.new(),
		rotDeg   = Vector3.zero,
		debugTag = true,
	},
	pet_the_puppet = {
		rotation = CFrame.Angles(0, math.rad(180), 0),
		rotDeg   = Vector3.new(0, 180, 0),
		debugTag = true,
	},
	pet_chica = {
		scale = 2.9,
	},
}

function PetVisualConfig.Get(petId: string, petDef)
	local override = OVERRIDES[petId]
	local isFNAF = petDef and petDef.collection == "FNAF"

	local scale = 1
	if isFNAF then
		scale = DEFAULT_FNAF_SCALE
	end
	if override and override.scale then
		scale = override.scale
	end

	local rotation = (override and override.rotation) or CFrame.new()
	local rotDeg = (override and override.rotDeg) or Vector3.zero
	local hasOverride = (scale ~= 1) or (rotDeg.Magnitude > 0)

	return {
		scale = scale,
		rotation = rotation,
		rotDeg = rotDeg,
		hasOverride = hasOverride,
		isFNAF = isFNAF,
		debugTag = override and override.debugTag == true,
	}
end

return PetVisualConfig
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="28">
        <Properties>
          <string name="Name">PlayerData</string>
          <string name="Source">--[[
	PlayerData
	Shared data schema for persistent player progression.

	Used by: PlayerDataService (server), client UI (via attributes)

	VERSION HISTORY:
	  1 -- Initial: Coins, Owned/Equipped pets/crowns/icons, LifetimeWins
	  2 -- Added: LifetimeCoinsAchieved, WeeklyWins, WeeklyCoinsAchieved, WeeklyResetId
	  3 -- Added: LifetimeDeaths, TimePlayedSeconds
]]

local PlayerData = {}

PlayerData.VERSION = 4

-- DataStore key — Studio uses a separate namespace to prevent leaking test data into production
local RunService = game:GetService("RunService")
PlayerData.STORE_NAME = RunService:IsStudio() and "PlayerData_v1_STUDIO" or "PlayerData_v1"
PlayerData.KEY_PREFIX = "Player_"

-- Attribute names (replicated to client via player attributes)
PlayerData.Attributes = {
	Coins                 = "Coins",
	OwnedPets             = "OwnedPets",
	EquippedPet           = "EquippedPet",
	OwnedCrowns           = "OwnedCrowns",
	EquippedCrown         = "EquippedCrown",
	OwnedIcons            = "OwnedIcons",
	EquippedIcon          = "EquippedIcon",
	OwnedIconImages       = "OwnedIconImages",
	EquippedIconImage     = "EquippedIconImage",
	OwnedCrates           = "OwnedCrates",
	LifetimeWins          = "LifetimeWins",
	CoinMultiplier        = "CoinMultiplier",
	LifetimeCoinsAchieved = "LifetimeCoinsAchieved",
	WeeklyWins            = "WeeklyWins",
	WeeklyCoinsAchieved   = "WeeklyCoinsAchieved",
	LastDailyRewardTime   = "LastDailyRewardTime",
	DailyStreak           = "DailyStreak",
	LifetimeDeaths        = "LifetimeDeaths",
	TimePlayedSeconds     = "TimePlayedSeconds",
	DailyQuestData        = "DailyQuestData",
}

--- Compute current UTC week identifier.
function PlayerData.GetCurrentWeekId(): string
	return os.date("!%Y_W%W")
end

--- Default data for new players.
function PlayerData.GetDefaults(): { [string]: any }
	return {
		Version               = PlayerData.VERSION,
		Coins                 = 0,
		OwnedPets             = {},
		EquippedPet           = nil,
		OwnedCrowns           = {},
		EquippedCrown         = nil,
		OwnedIcons            = {},
		EquippedIcon          = nil,
		OwnedIconImages       = {},
		EquippedIconImage     = nil,
		OwnedCrates           = {},
		LifetimeWins          = 0,
		LifetimeCoinsAchieved = 0,
		WeeklyWins            = 0,
		WeeklyCoinsAchieved   = 0,
		WeeklyResetId         = "",
		LastDailyRewardTime   = 0,
		DailyStreak           = 0,
		LifetimeDeaths        = 0,
		TimePlayedSeconds     = 0,
		DailyQuestData        = "",
		ProcessedReceipts     = {},
		ProcessedGrants       = {},
	}
end

--- Validate and migrate loaded data. Fills missing fields with defaults.
function PlayerData.Validate(data: { [string]: any }): { [string]: any }
	local defaults = PlayerData.GetDefaults()

	for key, defaultValue in pairs(defaults) do
		if data[key] == nil then
			data[key] = defaultValue
		end
	end

	if type(data.Coins) ~= "number" then data.Coins = 0 end
	if data.Coins &lt; 0 then data.Coins = 0 end
	if type(data.OwnedPets) ~= "table" then data.OwnedPets = defaults.OwnedPets end
	if type(data.OwnedCrowns) ~= "table" then data.OwnedCrowns = defaults.OwnedCrowns end
	if type(data.OwnedIcons) ~= "table" then data.OwnedIcons = defaults.OwnedIcons end
	if type(data.OwnedIconImages) ~= "table" then data.OwnedIconImages = defaults.OwnedIconImages end
	if type(data.OwnedCrates) ~= "table" then data.OwnedCrates = defaults.OwnedCrates end
	if type(data.LifetimeWins) ~= "number" then data.LifetimeWins = 0 end
	if type(data.LifetimeCoinsAchieved) ~= "number" then data.LifetimeCoinsAchieved = 0 end
	if type(data.WeeklyWins) ~= "number" then data.WeeklyWins = 0 end
	if type(data.WeeklyCoinsAchieved) ~= "number" then data.WeeklyCoinsAchieved = 0 end
	if type(data.WeeklyResetId) ~= "string" then data.WeeklyResetId = "" end
	if type(data.LastDailyRewardTime) ~= "number" then data.LastDailyRewardTime = 0 end
	if type(data.DailyStreak) ~= "number" then data.DailyStreak = 0 end
	if type(data.LifetimeDeaths) ~= "number" then data.LifetimeDeaths = 0 end
	if type(data.TimePlayedSeconds) ~= "number" then data.TimePlayedSeconds = 0 end
	if type(data.DailyQuestData) ~= "string" then data.DailyQuestData = "" end
	if type(data.ProcessedReceipts) ~= "table" then data.ProcessedReceipts = {} end
	if type(data.ProcessedGrants) ~= "table" then data.ProcessedGrants = {} end

	if data.EquippedPet ~= nil and type(data.EquippedPet) ~= "string" then
		data.EquippedPet = nil
	end
	if data.EquippedCrown ~= nil and type(data.EquippedCrown) ~= "string" then
		data.EquippedCrown = nil
	end
	if data.EquippedIcon ~= nil and type(data.EquippedIcon) ~= "string" then
		data.EquippedIcon = nil
	end
	if data.EquippedIconImage ~= nil and type(data.EquippedIconImage) ~= "string" then
		data.EquippedIconImage = nil
	end

	-- Weekly reset: if stored week doesn't match current week, zero weekly stats
	local currentWeek = PlayerData.GetCurrentWeekId()
	if data.WeeklyResetId ~= currentWeek then
		data.WeeklyWins            = 0
		data.WeeklyCoinsAchieved   = 0
		data.WeeklyResetId         = currentWeek
	end

	data.Version = PlayerData.VERSION
	return data
end

return PlayerData</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="29">
        <Properties>
          <string name="Name">PlayerState</string>
          <string name="Source"><![CDATA[--[[
	PlayerState
	Shared constants for player state tracking.
	
	Used by: PlayerStateService, MatchManager (future), UI (future)
]]

export type State = "Lobby" | "Waiting" | "InMatch" | "Spectating" | "AFK"

local PlayerState = {}

-- All valid player states
PlayerState.States = {
	Lobby = "Lobby",         -- In lobby, available for next match
	Waiting = "Waiting",     -- Match is active, waiting to join next one
	InMatch = "InMatch",     -- Currently playing in a match
	Spectating = "Spectating", -- Eliminated or observing
	AFK = "AFK",             -- Away from keyboard, skip for matchmaking
}

-- Default state for new players
PlayerState.DEFAULT = PlayerState.States.Lobby

-- Validate if a string is a valid state
function PlayerState.IsValid(state: string): boolean
	return PlayerState.States[state] ~= nil
end

-- Get all state names as array
function PlayerState.GetAll(): { State }
	return { "Lobby", "Waiting", "InMatch", "Spectating", "AFK" }
end

return PlayerState

]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="30">
        <Properties>
          <string name="Name">QuestRewardIconResolver</string>
          <string name="Source"><![CDATA[-- Shared quest reward icon mapping.
-- This is the single source of truth for Daily Quest reward icons.

local QuestRewardIconResolver = {}

local COIN_ICON = "rbxassetid://72345557707985"
local CRATE_ICON = "rbxassetid://108812530080296"
local SPIN_ICON = "rbxassetid://112640795485396"

function QuestRewardIconResolver.GetQuestRewardIcon(reward): string?
	if type(reward) ~= "table" then
		return nil
	end

	local rewardType = string.upper(tostring(reward.type or ""))

	if rewardType == "COINS" or rewardType == "FATECOINS" or rewardType == "FATE_COINS" then
		return COIN_ICON
	end

	if rewardType == "CRATE" or rewardType == "CRATES" or reward.crateId ~= nil then
		return CRATE_ICON
	end

	if rewardType == "SPIN"
		or rewardType == "SPINS"
		or rewardType == "FREE_SPIN"
		or rewardType == "FREESPIN"
		or reward.spinCount ~= nil
	then
		return SPIN_ICON
	end

	return nil
end

return QuestRewardIconResolver
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="31">
        <Properties>
          <string name="Name">RigNormalizer</string>
          <string name="Source"><![CDATA[--[[
	RigNormalizer
	Walker-pet rig normalization helpers.
]]

local RigNormalizer = {}

local function findFirstBasePart(model: Model): BasePart?
	return model:FindFirstChildWhichIsA("BasePart", true)
end

local function findTorsoRoot(model: Model): BasePart?
	local lower = model:FindFirstChild("LowerTorso", true)
	if lower and lower:IsA("BasePart") then
		return lower
	end
	local upper = model:FindFirstChild("UpperTorso", true)
	if upper and upper:IsA("BasePart") then
		return upper
	end
	return nil
end

function RigNormalizer.EnsureHumanoidRootPart(model: Model): BasePart?
	local existing = model:FindFirstChild("HumanoidRootPart", true)
	if existing and existing:IsA("BasePart") then
		model.PrimaryPart = existing
		return existing
	end

	local torso = findTorsoRoot(model)
	local rootRef = torso or model.PrimaryPart or findFirstBasePart(model)
	if not rootRef then
		return nil
	end

	local hrp = Instance.new("Part")
	hrp.Name = "HumanoidRootPart"
	hrp.Size = Vector3.new(2, 2, 1)
	hrp.Transparency = 1
	hrp.CanCollide = false
	hrp.CanQuery = false
	hrp.CanTouch = false
	hrp.Massless = false
	hrp.Anchored = false
	hrp.CFrame = rootRef.CFrame
	hrp.Parent = model

	local jointTarget = torso or rootRef
	local rootJoint = Instance.new("Motor6D")
	rootJoint.Name = "RootJoint"
	rootJoint.Part0 = hrp
	rootJoint.Part1 = jointTarget
	rootJoint.C0 = CFrame.new()
	rootJoint.C1 = jointTarget.CFrame:ToObjectSpace(hrp.CFrame)
	rootJoint.Parent = hrp

	model.PrimaryPart = hrp
	return hrp
end

return RigNormalizer
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="32">
        <Properties>
          <string name="Name">RoundConfig</string>
          <string name="Source"><![CDATA[--[[
	RoundConfig
	Shared configuration for round timing and behavior.
	
	Round cycle: FreeMove → Telegraph → BeamWarning → Strike → Recovery
	
	Used by: RoundManager
]]

local RoundConfig = {}

-- Phase durations (seconds)
RoundConfig.FreeMoveSeconds = 7.1     -- Players can reposition freely (~5% faster)
RoundConfig.TelegraphGraceSeconds = 0.55 -- Grace: telegraph visible but players can still move (~8% faster)
RoundConfig.TelegraphSeconds = 1.9    -- Tile warning pulse (BEFORE beams appear) (~5% faster)
RoundConfig.FreezeSeconds = 5.7       -- Total freeze time (telegraph + beam warning) (~5% faster)
RoundConfig.StrikeSeconds = 0.25      -- Beam fires
RoundConfig.RecoverySeconds = 0.55    -- Brief pause before next round (~8% faster)

-- Match limits (caps to prevent infinite matches)
RoundConfig.MaxRoundsPerMatch = 20    -- 0 = unlimited
RoundConfig.MaxMatchSeconds = 180     -- 3 minutes max, 0 = unlimited

-- Winner detection
RoundConfig.MinPlayersForWinner = 2   -- Need at least 2 players to declare a winner
                                       -- Solo player matches run until cap or death

-- Debug
RoundConfig.DebugLog = true

return RoundConfig
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="33">
        <Properties>
          <string name="Name">ShrinkConfig</string>
          <string name="Source"><![CDATA[--[[
	ShrinkConfig
	Configuration for arena shrinking difficulty.
	
	The active play area shrinks each round, making beams spawn
	in a smaller area and forcing players together.
	
	Shrink accelerates each round (incremental per round):
	  Step i = BaseStepStuds + (i - 1) * StepGrowthStuds
	  Capped at MaxStepStuds, with slowdown near MinBounds.
	
	Example with BaseStep=20, StepGrowth=5, MaxStep=35:
	  Step 1: 20  → total: 20
	  Step 2: 25  → total: 45
	  Step 3: 30  → total: 75
	  Step 4: 35  → total: 110  (hits MaxStep cap)
	  Step 5: 35  → (but slowdown kicks in near MinBounds)
	
	Used by: MapManager, HazardManager, StormFXConfig
]]

local ShrinkConfig = {}

-- Enable/disable shrinking
ShrinkConfig.Enabled = true

-- Shrink timing
ShrinkConfig.StartsAtRound = 2        -- First round to apply shrink (1 = from start)

-- Shrink step tuning (accelerating shrink to prevent prolonged matches)
ShrinkConfig.BaseStepStuds = 20       -- Base shrink amount (studs) for the first shrink round
ShrinkConfig.StepGrowthStuds = 5      -- Additional studs per subsequent shrink round

-- Step clamping + slowdown (prevent sudden "slam" to tiny arena)
ShrinkConfig.MaxStepStuds = 35         -- Per-round step never exceeds this (hard cap)
ShrinkConfig.SlowdownNearMinStuds = 80 -- When within 80 studs of MinBounds, scale step down proportionally

-- Minimum bounds (hard stop — never shrink smaller than this)
ShrinkConfig.MinSizeX = 80            -- Minimum X dimension (studs)
ShrinkConfig.MinSizeZ = 80            -- Minimum Z dimension (studs)

-- OOB grace window (players are NOT killed for this long after a shrink)
ShrinkConfig.OOBGraceSeconds = 0.75   -- Gives players time to move inward after bounds change

-- Visual indicator (storm wall around active area)
ShrinkConfig.ShowBoundsVisual = true  -- Show storm boundary
ShrinkConfig.BoundsColor = Color3.fromRGB(255, 140, 50)  -- Warm orange sunset tone
ShrinkConfig.BoundsTransparency = 0.7  -- See-through but visible
ShrinkConfig.BoundsHeight = 500        -- Massive storm walls (never see the top)

-- Debug (default false — quiet in production)
ShrinkConfig.DebugLog = false

return ShrinkConfig
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="34">
        <Properties>
          <string name="Name">SpawnConfig</string>
          <string name="Source"><![CDATA[--[[
	SpawnConfig
	Shared configuration for player spawning and teleportation.
	
	Used by: MapManager, MatchManager
]]

local SpawnConfig = {}

-- Arena spawn settings
SpawnConfig.ArenaSpawnYOffset = 6           -- Studs above platform top surface
SpawnConfig.ArenaSpawnSpreadRadius = 30     -- Random spread radius from center
SpawnConfig.ArenaSpawnMinDistance = 5       -- Min distance between spawn points

-- Lobby spawn settings
SpawnConfig.LobbySpawnPosition = Vector3.new(0, 10, -80)  -- Fallback if no SpawnLocation
SpawnConfig.ReturnToLobbyOnEnd = true       -- Teleport players back when match ends

-- Teleport safety
SpawnConfig.TeleportRetryDelay = 0.5        -- Seconds to wait if character not ready
SpawnConfig.MaxTeleportRetries = 3          -- Max retries per player

-- Debug
SpawnConfig.DebugLog = true

return SpawnConfig

]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="35">
        <Properties>
          <string name="Name">SpinWheelConfig</string>
          <string name="Source"><![CDATA[--[[
	SpinWheelConfig
	Shared configuration for the Spin The Wheel system.

	Defines:
	  • Wheel segments (rewards, chances, colors)
	  • Spin purchase prices (Fate Coins + Robux Developer Products)
	  • Timing constants

	Segments include coin rewards, pet rewards, and crown rewards.
	Pet/Crown segments reference ItemCatalog IDs so the server can grant the
	correct item and the client can look up the matching image.

	Used by: SpinWheelPanel (client), SpinWheelService (server), SpinWheelScript (client)
]]

local SpinWheelConfig = {}

SpinWheelConfig.NUM_SEGMENTS = 8
SpinWheelConfig.SEGMENT_ANGLE = 360 / 8 -- 45°

-- DEV / TESTING
-- In Studio, the server will treat spins as unlimited automatically.
-- If you need unlimited spins outside Studio (private test server), set this true.
SpinWheelConfig.DEBUG_UNLIMITED_SPINS = false

-- ═══════════════════════════════════════════
-- WHEEL SEGMENTS (8 slices)
--
-- Weight-based odds (weights don't need to sum to 100):
--   HIGH   chance: 100–200 Coins, Common Pets
--   LOW    chance: 500–1000 Coins
--   V.LOW  chance: 4000 Coins (jackpot)
--
-- reward types:
--   "Coins"  → grant coin amount
--   "Pet"    → grant pet from ItemCatalog (catalogId field)
--   "Crown"  → grant crown from ItemCatalog (catalogId field)
--
-- wheelImage = "rbxassetid://..."
--   Explicit wheel-only icon for this segment.
--   The wheel renderer uses ONLY this field (no ItemCatalog lookups).
--   If nil/empty, the wheel shows a "?" placeholder and warns.
-- ═══════════════════════════════════════════

SpinWheelConfig.Segments = {
	-- Segment 1: 100 Fate Coins (HIGH)
	{
		name       = "100 Coins",
		icon = "",
		reward     = "Coins",
		amount     = 100,
		weight     = 25,
		rarity     = "Common",
		color      = Color3.fromRGB(72, 180, 255),   -- sky blue
		modelPath  = nil,
	},
	-- Segment 2: Dog Pet (HIGH)
	{
		name       = "Dog Pet",
		icon = "",
		reward     = "Pet",
		catalogId  = "pet_dog",
		wheelImage = "rbxassetid://81462451441223",
		amount     = 0,
		weight     = 20,
		rarity     = "Common",
		color      = Color3.fromRGB(68, 198, 68),     -- green
		modelPath  = "ItemModels.Pets.Common.Dog",
	},
	-- Segment 3: 200 Fate Coins (HIGH)
	{
		name       = "200 Coins",
		icon = "",
		reward     = "Coins",
		amount     = 200,
		weight     = 15,
		rarity     = "Uncommon",
		color      = Color3.fromRGB(85, 215, 130),    -- green
		modelPath  = nil,
	},
	-- Segment 4: Noob Pet (MEDIUM)
	{
		name       = "Noob Pet",
		icon = "",
		reward     = "Pet",
		catalogId  = "pet_noob",
		wheelImage = "rbxassetid://81702684827965",
		amount     = 0,
		weight     = 12,
		rarity     = "Rare",
		color      = Color3.fromRGB(38, 150, 255),    -- blue
		modelPath  = "ItemModels.Pets.Common.Noob",
	},
	-- Segment 5: Sparkle Crown (MEDIUM)
	{
		name       = "Sparkle Crown",
		icon = "",
		reward     = "Crown",
		catalogId  = "crown_sparkle",
		wheelImage = "rbxassetid://123657387753624",
		amount     = 0,
		weight     = 10,
		rarity     = "Rare",
		color      = Color3.fromRGB(185, 68, 235),    -- purple
		modelPath  = "ItemModels.Crowns.Findable.Sparkle Crown",
	},
	-- Segment 6: 500 Fate Coins (LOW)
	{
		name       = "500 Coins",
		icon = "",
		reward     = "Coins",
		amount     = 500,
		weight     = 6,
		rarity     = "Rare",
		color      = Color3.fromRGB(175, 85, 255),    -- purple
		modelPath  = nil,
	},
	-- Segment 7: Penguin Pet (LOW)
	{
		name       = "Penguin Pet",
		icon = "",
		reward     = "Pet",
		catalogId  = "pet_penguin",
		wheelImage = "rbxassetid://115903577500727",
		amount     = 0,
		weight     = 4,
		rarity     = "Epic",
		color      = Color3.fromRGB(178, 42, 255),    -- deep purple
		modelPath  = "ItemModels.Pets.Common.Penguin",
	},
	-- Segment 8: 4000 Coins — JACKPOT (VERY LOW)
	{
		name       = "4000 Coins",
		icon       = "\226\173\144",
		reward     = "Coins",
		amount     = 4000,
		weight     = 2,
		rarity     = "Legendary",
		color      = Color3.fromRGB(255, 65, 85),     -- red/gold
		modelPath  = nil,
	},
}

-- ═══════════════════════════════════════════
-- SPIN PURCHASE OPTIONS
--
-- Each entry supports:
--   • coins:     Fate Coin price (deducted server-side)
--   • robux:     display price (actual price set in Developer Product)
--   • productId: Roblox Developer Product ID for Robux purchase
--                Set to 0 = not yet created (button shows "Setup needed")
--                CREATE products in Game Settings → Monetization → Developer Products
--                then paste the real IDs here.
-- ═══════════════════════════════════════════

SpinWheelConfig.SpinPrices = {
	{ spins = 1,  coins = 100,  robux = 10,  productId = 3539703395, label = "1 Spin"   },
	{ spins = 3,  coins = 250,  robux = 30,  productId = 3539705825, label = "3 Spins"  },
	{ spins = 10, coins = 750,  robux = 90,  productId = 3539706154, label = "10 Spins" },
}

-- ═══════════════════════════════════════════
-- TIMING
-- ═══════════════════════════════════════════

SpinWheelConfig.FREE_SPIN_COOLDOWN = 86400 -- 24 hours in seconds
SpinWheelConfig.SPIN_DURATION      = 5     -- animation duration in seconds
SpinWheelConfig.MIN_FULL_SPINS     = 5     -- minimum full rotations
SpinWheelConfig.MAX_FULL_SPINS     = 8     -- maximum full rotations

-- ═══════════════════════════════════════════
-- PROXIMITY
-- ═══════════════════════════════════════════

SpinWheelConfig.OPEN_DISTANCE     = 14  -- studs to show "Press E" prompt
SpinWheelConfig.CLOSE_DISTANCE    = 50  -- studs to auto-close (generous)
SpinWheelConfig.OPEN_GRACE_PERIOD = 3   -- seconds after opening before auto-close checks start

return SpinWheelConfig
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="36">
        <Properties>
          <string name="Name">StormFXConfig</string>
          <string name="Source"><![CDATA[--[[
	StormFXConfig
	Shared configuration for storm visual effects.
	
	Client FX logic (StormFXController):
	  shouldStorm = (cameraOutside OR playerOutside)
	  - cameraOutside: camera XZ position is past arena bounds + CamOutsideMargin
	  - playerOutside: HumanoidRootPart XZ position is past arena bounds
	  Both checks use POSITION only — no look-vector, no FOV, no pitch dependency.
	
	Effects are screen-space ONLY (Atmosphere + CC + Bloom).
	No particles are attached to the player character.
	
	ON  transition: tween Atmosphere (smooth 0.15s), enable CC + Bloom
	OFF transition: INSTANT SNAP Atmosphere to original, disable CC + Bloom
	                (no tween on OFF — prevents stuck/dark lighting states)
	
	Particle factory (CreateStormParticles) is server-side only,
	used by MapManager (barrier walls) and HazardManager (beams).
	
	Storm color single source of truth: ShrinkConfig.BoundsColor
]]

local ShrinkConfig = require(script.Parent:WaitForChild("ShrinkConfig"))

local StormFXConfig = {}

---------- STORM COLOR (single source of truth) ----------

StormFXConfig.StormColor = ShrinkConfig.BoundsColor

---------- MASTER SWITCH ----------

StormFXConfig.Enabled = true

---------- TRIGGER THRESHOLDS ----------

-- Camera: ON when camera XZ is >= CamOutsideMargin studs outside the arena bounds
StormFXConfig.CameraOutsideMarginStuds = 5

---------- HYSTERESIS (anti-flicker enter/exit band) ----------
-- Camera: ON at +CamOutMargin (5), OFF at +(CamOutMargin - Hyst) (0 = edge)
-- Player: ON at 0 (just outside),   OFF at -Hyst (-5 = 5 studs back inside)
-- Band is small enough to feel instant, large enough to prevent flicker.
-- Response is immediate once a threshold is crossed — no time-based delay.

StormFXConfig.HysteresisStuds = 5

---------- UPDATE RATE ----------

StormFXConfig.MinUpdateInterval = 0.05  -- 20 Hz evaluation; feels instant, saves CPU

---------- BOUNDS CACHE ----------

StormFXConfig.BoundsCacheInterval = 0.5  -- Refresh wall positions (walls only move on shrink)

---------- ATMOSPHERE OVERLAY (screen-space) ----------

StormFXConfig.AtmosphereDensity = 0.3
StormFXConfig.AtmosphereHaze = 6
StormFXConfig.AtmosphereColor = Color3.fromRGB(255, 180, 130)
StormFXConfig.AtmosphereDecay = Color3.fromRGB(120, 100, 80)

---------- COLOR CORRECTION (screen-space) ----------

StormFXConfig.CCTintColor = Color3.fromRGB(255, 230, 200)  -- Warm tint
StormFXConfig.CCBrightness = -0.02   -- Slight dimming
StormFXConfig.CCContrast = 0.05      -- Slight contrast boost
StormFXConfig.CCSaturation = -0.1    -- Slight desaturation (storm feel)

---------- BLOOM (screen-space) ----------

StormFXConfig.BloomIntensity = 0.3
StormFXConfig.BloomSize = 24
StormFXConfig.BloomThreshold = 2

---------- TRANSITION ----------

StormFXConfig.TweenDuration = 0.15  -- ON tween duration (smooth entry). OFF is instant snap.

---------- DEBUG ----------

StormFXConfig.DebugLogs = false      -- ON/OFF state-change logs (one line per change)
StormFXConfig.DebugTickLogs = false  -- Periodic distance/state dump (~1/s when enabled)

---------- STORM PARTICLE FACTORY (shared, server-side only) ----------

--[[
	Factory: Create storm mist + spark emitters on a parent BasePart.
	Used by MapManager (barrier walls) and HazardManager (beams).
	NOT used by StormFXController (client uses screen-space effects only).
	
	rateMultiplier: Scale emission rates (e.g. 0.5 for beams, 1.0 for walls).
	Returns: mistEmitter, sparksEmitter
]]
function StormFXConfig.CreateStormParticles(parent: BasePart, rateMultiplier: number?): (ParticleEmitter, ParticleEmitter)
	local mult = rateMultiplier or 1
	local stormColor = StormFXConfig.StormColor

	-- Main rising mist particles
	local mist = Instance.new("ParticleEmitter")
	mist.Name = "StormMist"
	mist.Enabled = true
	mist.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 180, 100)),
		ColorSequenceKeypoint.new(0.5, stormColor),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 100, 30)),
	})
	mist.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 3),
		NumberSequenceKeypoint.new(0.5, 8),
		NumberSequenceKeypoint.new(1, 12),
	})
	mist.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.4),
		NumberSequenceKeypoint.new(0.3, 0.3),
		NumberSequenceKeypoint.new(0.7, 0.5),
		NumberSequenceKeypoint.new(1, 1),
	})
	mist.Lifetime = NumberRange.new(2, 4)
	mist.Rate = math.max(1, math.floor(25 * mult))
	mist.Speed = NumberRange.new(8, 20)
	mist.SpreadAngle = Vector2.new(20, 60)
	mist.Rotation = NumberRange.new(0, 360)
	mist.RotSpeed = NumberRange.new(-60, 60)
	mist.Drag = 0.5
	mist.LightEmission = 0.6
	mist.LightInfluence = 0.3
	mist.Acceleration = Vector3.new(0, 5, 0)
	mist.Parent = parent

	-- Sparkle/energy particles for visibility
	local sparks = Instance.new("ParticleEmitter")
	sparks.Name = "StormSparks"
	sparks.Enabled = true
	sparks.Color = ColorSequence.new(Color3.fromRGB(255, 220, 150))
	sparks.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.5),
		NumberSequenceKeypoint.new(0.5, 2),
		NumberSequenceKeypoint.new(1, 0),
	})
	sparks.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.2),
		NumberSequenceKeypoint.new(0.5, 0.4),
		NumberSequenceKeypoint.new(1, 1),
	})
	sparks.Lifetime = NumberRange.new(1, 2.5)
	sparks.Rate = math.max(1, math.floor(10 * mult))
	sparks.Speed = NumberRange.new(5, 15)
	sparks.SpreadAngle = Vector2.new(40, 40)
	sparks.LightEmission = 1
	sparks.LightInfluence = 0
	sparks.Parent = parent

	return mist, sparks
end

return StormFXConfig
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="37">
        <Properties>
          <string name="Name">UIConfig</string>
          <string name="Source">--[[
	UIConfig
	Shared configuration for the client UI system.

	REFINED + MODERN theme — front-page Roblox quality:
	  • Dark, clean panel backgrounds with subtle depth
	  • Thin refined borders (NOT heavy/thick outlines)
	  • Smooth gradients, soft shadows
	  • VISIBLE stud texture overlay (lighter, more opaque)
	  • Per-panel unique animations (via UIStyle)
	  • High-contrast white text with dark strokes
	  • Consistent corner radius and spacing
	  • BRIGHTER, more vibrant accent colors

	Used by every UI module.
]]

local UIConfig = {}

-- Global debug logging controls (kept OFF by default to avoid output spam).
UIConfig.DebugLogs = false
UIConfig.LogRateSeconds = 20

-- ═══════════════════════════════════════════════════════════════════
-- COLOURS (brighter, more vivid accents)
-- ═══════════════════════════════════════════════════════════════════

UIConfig.Colors = {
	-- Panel chrome — matched to Crown panel dark purple-black
	PanelBg         = Color3.fromRGB(5,  3,  18),
	PanelBgInner    = Color3.fromRGB(9,  6,  26),
	CardBg          = Color3.fromRGB(14, 10, 36),
	CardBgLighter   = Color3.fromRGB(22, 16, 52),
	CardBgDark      = Color3.fromRGB(6,  4,  20),
	CardStroke      = Color3.fromRGB(60, 45, 110),
	Overlay         = Color3.fromRGB(0, 0, 0),
	OverlayTransparency = 0.4,

	-- Per-panel accent (header gradient base) — +20% saturation
	HeaderShop    = Color3.fromRGB(255, 35, 62),
	HeaderCrowns  = Color3.fromRGB(172, 28, 252),
	HeaderPets    = Color3.fromRGB(255, 132, 12),
	HeaderIndex   = Color3.fromRGB(22, 218, 48),
	HeaderCrate   = Color3.fromRGB(255, 162, 8),
	HeaderSpin    = Color3.fromRGB(38, 185, 255),

	-- Accents (+15-20% saturation, no brightness loss)
	Gold   = Color3.fromRGB(255, 205, 18),
	Blue   = Color3.fromRGB(38, 178, 255),
	Green  = Color3.fromRGB(38, 238, 55),
	Red    = Color3.fromRGB(255, 32, 38),
	Pink   = Color3.fromRGB(255, 72, 145),
	Orange = Color3.fromRGB(255, 142, 18),
	Cyan   = Color3.fromRGB(22, 238, 238),
	Purple = Color3.fromRGB(188, 52, 255),

	-- Text hierarchy — bright white, no washed-out greys
	TextWhite = Color3.fromRGB(255, 255, 255),
	TextLight = Color3.fromRGB(218, 224, 248),
	TextMuted = Color3.fromRGB(165, 175, 218),
	TextDark  = Color3.fromRGB(12, 12, 28),

	-- Buttons (+20% saturation, brighter face for contrast)
	BuyButton        = Color3.fromRGB(32, 228, 48),
	BuyButtonHover   = Color3.fromRGB(55, 252, 72),
	EquipButton      = Color3.fromRGB(32, 178, 255),
	EquipButtonHover = Color3.fromRGB(65, 205, 255),
	RobuxButton      = Color3.fromRGB(28, 215, 82),
	RobuxButtonHover = Color3.fromRGB(45, 242, 105),
	CloseBtn         = Color3.fromRGB(252, 28, 45),
	CloseBtnHover    = Color3.fromRGB(255, 55, 72),
	DisabledBtn      = Color3.fromRGB(62, 68, 98),

	-- HUD — more vivid so readable against bright sky
	HudCoinBg  = Color3.fromRGB(22, 32, 72),
	HudRoundBg = Color3.fromRGB(255, 158, 22),

	-- Sidebar
	SidebarBg      = Color3.fromRGB(38, 45, 82),
	SidebarBgAlpha = 0.08,

	-- Sidebar button colors (+20% saturation, Settings de-greyed to indigo)
	SideShop     = Color3.fromRGB(255, 42, 65),
	SideCrowns   = Color3.fromRGB(198, 48, 255),
	SidePets     = Color3.fromRGB(255, 148, 22),
	SideIndex    = Color3.fromRGB(32, 228, 62),
	SideSpectate = Color3.fromRGB(32, 182, 255),
	SideSettings = Color3.fromRGB(108, 128, 218),
	SideAFK      = Color3.fromRGB(255, 198, 28),
	SideIcons    = Color3.fromRGB(255, 78, 182),
	SideDaily    = Color3.fromRGB(38, 188, 255),
	SideStats    = Color3.fromRGB(28, 222, 198),

	-- Extra panel header accents
	HeaderSpectate = Color3.fromRGB(32, 182, 255),
	HeaderSettings = Color3.fromRGB(108, 128, 218),
	HeaderIcons    = Color3.fromRGB(255, 72, 178),

	-- Rarity palette (+15-20% saturation, Common de-greyed)
	Common    = Color3.fromRGB(158, 172, 225),
	Uncommon  = Color3.fromRGB(38, 242, 55),
	Rare      = Color3.fromRGB(22, 162, 255),
	Epic      = Color3.fromRGB(192, 28, 255),
	Legendary = Color3.fromRGB(255, 192, 8),
	Exclusive = Color3.fromRGB(255, 42, 42),

	-- Tab pills
	TabActive       = Color3.fromRGB(255, 255, 255),
	TabInactive     = Color3.fromRGB(55, 62, 105),
	TabTextActive   = Color3.fromRGB(12, 12, 28),
	TabTextInactive = Color3.fromRGB(188, 198, 228),

	-- Intermission
	IntermissionBg     = Color3.fromRGB(22, 168, 255),
	IntermissionBg2    = Color3.fromRGB(62, 202, 255),
	IntermissionText   = Color3.fromRGB(255, 255, 255),
	IntermissionStroke = Color3.fromRGB(8, 85, 195),
}

-- ═══════════════════════════════════════════════════════════════════
-- SIZES  (panel stroke thickened to 2.0 for sharper panel edges)
-- ═══════════════════════════════════════════════════════════════════

UIConfig.Sizes = {
	PanelWidth        = 0.64,
	PanelHeight       = 0.80,
	PanelCorner       = 14,
	PanelStroke       = 2.0,
	PanelHeaderHeight = 56,

	CardWidth  = 142,
	CardHeight = 185,
	CardCorner = 12,
	CardPad    = 10,

	CrateSectionHeight = 225,

	BtnHeight   = 48,
	BtnCorner   = 10,
	SmBtnCorner = 10,

	HudCoinW  = 172,
	HudCoinH  = 50,
	HudRoundW = 190,
	HudRoundH = 46,
	HudCorner = 12,

	SideBtnW = 86,
	SideBtnH = 86,
	SideBtnGap = 8,
	SideBtnCorner = 12,

	CloseBtnSize = 46,

	TabHeight = 42,
	TabCorner = 21,

	IntermissionW = 380,
	IntermissionH = 52,
	IntermissionCorner = 26,
}

-- ═══════════════════════════════════════════════════════════════════
-- STUD TEXTURE  (more visible — lower transparency, brighter tint)
-- ═══════════════════════════════════════════════════════════════════

UIConfig.StudTexture = {
	AssetId      = "rbxassetid://14861368908",
	TileSize     = UDim2.fromOffset(64, 64),
	Transparency = 0.46,
	Color        = Color3.fromRGB(92, 108, 168),
}

-- ═══════════════════════════════════════════════════════════════════
-- ANIMATION  (smooth, stable — no overshoot)
-- ═══════════════════════════════════════════════════════════════════

UIConfig.Anim = {
	OpenDuration   = 0.26,
	CloseDuration  = 0.18,
	OpenStartScale = 0.92,
	OpenEase       = Enum.EasingStyle.Quad,
	CloseEase      = Enum.EasingStyle.Quad,

	HoverScale     = 1.04,
	HoverDuration  = 0.12,
	ClickScale     = 0.92,
	ClickDuration  = 0.05,
	BounceDuration = 0.20,
	BtnEase        = Enum.EasingStyle.Quad,

	CoinBumpScale    = 1.15,
	CoinBumpDuration = 0.24,

	RoundSlideDuration = 0.28,

	SunburstSpeed = 9,

	PopupOpenStartScale = 0.92,
	PopupOpenDuration   = 0.15,
	PopupOpenEase       = Enum.EasingStyle.Quad,
	PopupCloseDuration    = 0.15,
	PopupCloseEase        = Enum.EasingStyle.Quad,
	PopupCloseTargetScale = 0.9,
	PopupDestroyDelay     = 0.20,
}

-- ═══════════════════════════════════════════════════════════════════
-- SOUNDS
-- ═══════════════════════════════════════════════════════════════════

UIConfig.Sounds = {
	Hover       = { Id = "rbxassetid://9119713951", Volume = 0.10, Speed = 1.6 },
	Click       = { Id = "rbxassetid://9119713951", Volume = 0.28, Speed = 1.1 },
	Open        = { Id = "rbxassetid://9119713951", Volume = 0.24, Speed = 0.60 },
	Close       = { Id = "rbxassetid://9119713951", Volume = 0.18, Speed = 1.30 },
	CoinCollect = { Id = "rbxassetid://9119713951", Volume = 0.32, Speed = 1.80 },
	Equip       = { Id = "rbxassetid://9119713951", Volume = 0.25, Speed = 1.40 },
}

-- ═══════════════════════════════════════════════════════════════════
-- RARITY
-- ═══════════════════════════════════════════════════════════════════

UIConfig.RarityOrder = { "Common", "Uncommon", "Rare", "Epic", "Legendary" }

UIConfig.RarityInfo = {
	Common    = { color = UIConfig.Colors.Common,    label = "Common" },
	Uncommon  = { color = UIConfig.Colors.Uncommon,  label = "Uncommon" },
	Rare      = { color = UIConfig.Colors.Rare,      label = "Rare" },
