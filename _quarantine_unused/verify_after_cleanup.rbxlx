        <Item class="ModuleScript" referent="97">
          <Properties>
            <string name="Name">IconFollowerController</string>
            <string name="Source">--[[
	IconFollowerController
	Client-side Icon Image follower -- spawns equipped icon image models
	for ALL visible players, with smooth follow + bobble animation.

	Mirrors PetFollowerController but uses the OPPOSITE side offset
	so pet and icon image can coexist without overlapping.

	Pet uses +X (right side), Icon Image uses -X (left side).

	Reads: player:GetAttribute("EquippedIconImage")
	Catalog: ItemCatalog.IconImages[iconId]
	Registry: ItemModelRegistry.Get(modelPath)

	API:
	  IconFollowerController.Init()
]]

local Players           = game:GetService("Players")
local RunService        = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared            = ReplicatedStorage:WaitForChild("Shared")
local ItemCatalog       = require(Shared:WaitForChild("ItemCatalog"))
local ItemModelRegistry = require(Shared:WaitForChild("ItemModelRegistry"))

local TAG = "[IconFollower]"
local ICON_INSTANCE_NAME = "_EquippedIconImage"

local IconFollowerController = {}

-- =====================================================================
-- FOLLOW TUNING  (mirrors pet but on opposite X side)
-- =====================================================================

local ICON_OFFSET         = CFrame.new(-3, 2.5, 2)  -- left side (pet is +3)
local LERP_ALPHA          = 0.08
local BOBBLE_SPEED        = 3.0
local BOBBLE_AMPLITUDE    = 0.4
local YAW_WOBBLE_SPEED    = 1.5
local YAW_WOBBLE_AMP      = 5
local ROLL_WOBBLE_SPEED   = 2.0
local ROLL_WOBBLE_AMP     = 3

-- =====================================================================
-- SIZE NORMALIZATION
-- =====================================================================

local TARGET_MAX_DIM = 3.0
local SCALE_FLOOR    = 0.02
local SCALE_CEIL     = 1.0

-- =====================================================================
-- STATE (per-player icon tracking)
-- =====================================================================

local _activeIcons: { [Player]: {
	icon: Instance,
	conn: RBXScriptConnection?,
	cf: CFrame,
	t0: number,
} } = {}

local _playerConns: { [Player]: { RBXScriptConnection } } = {}

local function log(...)
	print(TAG, ...)
end

local function ensureValidBeam(beam: Beam): boolean
	local function invalidate()
		if beam.Parent then
			beam:Destroy()
		end
	end
	local function isAttachmentValid(att: Attachment?): boolean
		return att ~= nil and att.Parent ~= nil and att:IsDescendantOf(game)
	end
	local function validateNow()
		if not beam.Parent then
			return false
		end
		local a0 = beam.Attachment0
		local a1 = beam.Attachment1
		if not isAttachmentValid(a0) or not isAttachmentValid(a1) then
			invalidate()
			return false
		end
		return true
	end

	if not validateNow() then
		return false
	end

	beam:GetPropertyChangedSignal("Attachment0"):Connect(validateNow)
	beam:GetPropertyChangedSignal("Attachment1"):Connect(validateNow)
	local a0 = beam.Attachment0
	local a1 = beam.Attachment1
	if a0 then
		a0.AncestryChanged:Connect(validateNow)
	end
	if a1 then
		a1.AncestryChanged:Connect(validateNow)
	end
	beam.AncestryChanged:Connect(function()
		if beam.Parent then
			validateNow()
		end
	end)

	return true
end

-- =====================================================================
-- HELPERS
-- =====================================================================

local function getBBoxSize(inst: Instance): Vector3?
	if inst:IsA("Model") then
		local ok, _, sz = pcall(inst.GetBoundingBox, inst)
		if ok and typeof(sz) == "Vector3" then return sz end
		local ok2, ext = pcall(inst.GetExtentsSize, inst)
		if ok2 and typeof(ext) == "Vector3" then return ext end
		return nil
	elseif inst:IsA("BasePart") then
		return inst.Size
	end
	return nil
end

local function applyScale(inst: Instance, factor: number): boolean
	if factor == 1 then return true end
	if inst:IsA("Model") then
		local ok = pcall(function()
			local cur = inst:GetScale()
			inst:ScaleTo(cur * factor)
		end)
		if ok then return true end
		for _, d in ipairs(inst:GetDescendants()) do
			if d:IsA("BasePart") then
				d.Size = d.Size * factor
			elseif d:IsA("DataModelMesh") then
				d.Scale = d.Scale * factor
				if d:FindFirstAncestorWhichIsA("BasePart") then
					d.Offset = d.Offset * factor
				end
			elseif d:IsA("Attachment") then
				d.Position = d.Position * factor
			end
		end
		return true
	elseif inst:IsA("BasePart") then
		inst.Size = inst.Size * factor
		for _, d in ipairs(inst:GetDescendants()) do
			if d:IsA("DataModelMesh") then
				d.Scale = d.Scale * factor
				d.Offset = d.Offset * factor
			elseif d:IsA("Attachment") then
				d.Position = d.Position * factor
			end
		end
		return true
	end
	return false
end

local function yawOnly(cf: CFrame): number
	local _, ry, _ = cf:ToEulerAnglesYXZ()
	return ry
end

-- =====================================================================
-- ICON SPAWN / DESTROY
-- =====================================================================

local function getIconDef(iconId: string)
	if not iconId or iconId == "" then return nil end
	return ItemCatalog.IconImages and ItemCatalog.IconImages[iconId]
end

local function destroyIconFor(player: Player)
	local entry = _activeIcons[player]
	if not entry then return end
	if entry.conn then entry.conn:Disconnect() end
	if entry.icon and entry.icon.Parent then entry.icon:Destroy() end
	_activeIcons[player] = nil
end

local function spawnIconFor(player: Player, iconId: string)
	local existing = _activeIcons[player]
	if existing and existing.icon and existing.icon.Parent then
		if existing.icon:GetAttribute("_iconImageId") == iconId then return end
	end

	destroyIconFor(player)

	if not iconId or iconId == "" then return end

	local iconDef = getIconDef(iconId)
	if not iconDef then
		warn(TAG, "Icon image not in catalog:", iconId)
		return
	end

	local modelPath = iconDef.modelPath
	if not modelPath or modelPath == "" then
		warn(TAG, "No modelPath for icon image:", iconId,
			"| catalogEntry:", iconDef.name or "?", "rarity:", iconDef.rarity or "?",
			"| image:", iconDef.image or "nil", "| modelName:", iconDef.modelName or "nil")
		return
	end

	log("Resolving model for", iconId, "| modelPath:", modelPath, "| registry count:", ItemModelRegistry.GetCount())
	local sourceModel = ItemModelRegistry.Get(modelPath)
	if not sourceModel then
		warn(TAG, "modelPath exists but model NOT FOUND in registry:", modelPath,
			"| iconId:", iconId, "| Try checking ReplicatedStorage.ItemModels hierarchy")
		log("Dumping registry keys for debug:")
		ItemModelRegistry.DumpKeys()
		return
	end
	log("Model resolved OK:", sourceModel:GetFullName(), "for icon:", iconId)

	local character = player.Character
	local rootPart = character and character:FindFirstChild("HumanoidRootPart")
	if not rootPart then return end

	log("Spawning icon image for", player.Name .. ":", iconId, "path:", modelPath)

	local clone = sourceModel:Clone()

	-- Unwrap Accessory
	if clone:IsA("Accessory") then
		local wrapper = Instance.new("Model")
		wrapper.Name = clone.Name
		local handle = clone:FindFirstChild("Handle")
		for _, child in ipairs(clone:GetChildren()) do
			child.Parent = wrapper
		end
		if handle and handle:IsA("BasePart") then
			wrapper.PrimaryPart = handle
		else
			local firstPart = wrapper:FindFirstChildWhichIsA("BasePart", true)
			if firstPart then wrapper.PrimaryPart = firstPart end
		end
		clone:Destroy()
		clone = wrapper
	end

	-- Wrap bare BaseParts into a Model
	if clone:IsA("BasePart") and not clone:IsA("Model") then
		local wrapper = Instance.new("Model")
		wrapper.Name = clone.Name
		clone.Parent = wrapper
		wrapper.PrimaryPart = clone
		clone = wrapper
	end

	-- Make all parts non-interactive and anchored
	local function prepPart(part: BasePart)
		part.Anchored = true
		part.CanCollide = false
		part.CanQuery = false
		part.CanTouch = false
		part.Massless = true
	end

	if clone:IsA("BasePart") then prepPart(clone) end
	for _, d in ipairs(clone:GetDescendants()) do
		if d:IsA("BasePart") then prepPart(d) end
	end

	-- Enable VFX
	for _, d in ipairs(clone:GetDescendants()) do
		if d:IsA("ParticleEmitter") or d:IsA("Fire") or d:IsA("Sparkles")
			or d:IsA("Smoke") or d:IsA("Beam") or d:IsA("Trail") then
			if d:IsA("Beam") then
				if ensureValidBeam(d) then
					d.Enabled = true
				end
			else
				d.Enabled = true
			end
		elseif d:IsA("Script") or d:IsA("LocalScript") then
			d:Destroy()
		end
	end

	-- SIZE NORMALIZATION
	local preBBox = getBBoxSize(clone)
	local iconScale = 1

	do
		if preBBox then
			local maxDim = math.max(preBBox.X, preBBox.Y, preBBox.Z, 0.01)
			if maxDim &gt; TARGET_MAX_DIM then
				iconScale = TARGET_MAX_DIM / maxDim
			end
		end

		iconScale = math.clamp(iconScale, SCALE_FLOOR, SCALE_CEIL)

		if iconScale &lt; 1 then
			applyScale(clone, iconScale)
		end

		-- Post-scale verification
		local postBBox = getBBoxSize(clone)
		if postBBox then
			local postMax = math.max(postBBox.X, postBBox.Y, postBBox.Z)
			if postMax &gt; TARGET_MAX_DIM then
				local correction = (TARGET_MAX_DIM / postMax) * 0.95
				correction = math.max(correction, SCALE_FLOOR)
				applyScale(clone, correction)
				iconScale = iconScale * correction
				log("Post-scale correction for", iconId,
					string.format("extra %.3fx (was %.1f studs)", correction, postMax))
			end
		end
	end

	log("Scaled icon image", iconId, string.format("%.3fx", iconScale),
		preBBox and string.format("(pre-bbox: %.1f x %.1f x %.1f)", preBBox.X, preBBox.Y, preBBox.Z) or "(no bbox)")

	-- FOLLOW OFFSET (scaled to icon size)
	local offsetMul = 0.4 + 0.6 * iconScale
	local iconOffset = CFrame.new(
		ICON_OFFSET.X * offsetMul,
		ICON_OFFSET.Y * offsetMul,
		ICON_OFFSET.Z * offsetMul
	)
	local iconBobbleAmp = BOBBLE_AMPLITUDE * math.max(iconScale, 0.4)

	-- INITIAL POSITION
	local hrpYaw = yawOnly(rootPart.CFrame)
	local startPos = (rootPart.CFrame * iconOffset).Position
	local startCF = CFrame.new(startPos) * CFrame.Angles(0, hrpYaw, 0)

	if clone:IsA("Model") then
		clone:PivotTo(startCF)
	elseif clone:IsA("BasePart") then
		clone.CFrame = startCF
	end

	clone.Name = ICON_INSTANCE_NAME
	clone:SetAttribute("_iconImageId", iconId)
	clone:SetAttribute("_owner", player.Name)
	clone.Parent = workspace

	-- FOLLOW + BOBBLE LOOP
	local currentCF = startCF
	local t0 = tick()

	local followConn = RunService.Heartbeat:Connect(function()
		if not clone or not clone.Parent then
			destroyIconFor(player)
			return
		end
		local char = player.Character
		if not char then return end
		local hrp = char:FindFirstChild("HumanoidRootPart")
		if not hrp then return end

		local t = tick() - t0

		local targetPos = (hrp.CFrame * iconOffset).Position
		local bobbleY = math.sin(t * BOBBLE_SPEED) * iconBobbleAmp
		targetPos = targetPos + Vector3.new(0, bobbleY, 0)

		local playerYaw = yawOnly(hrp.CFrame)

		local yawW = math.sin(t * YAW_WOBBLE_SPEED) * math.rad(YAW_WOBBLE_AMP)
		local rollW = math.sin(t * ROLL_WOBBLE_SPEED) * math.rad(ROLL_WOBBLE_AMP)
		local finalYaw = playerYaw + yawW

		local targetCF = CFrame.new(targetPos) * CFrame.Angles(0, finalYaw, rollW)

		currentCF = currentCF:Lerp(targetCF, LERP_ALPHA)

		if clone:IsA("Model") then
			clone:PivotTo(currentCF)
		elseif clone:IsA("BasePart") then
			clone.CFrame = currentCF
		end
	end)

	_activeIcons[player] = {
		icon = clone,
		conn = followConn,
		cf = currentCF,
		t0 = t0,
	}

	log("Icon image spawned for", player.Name .. ":", iconId)
end

-- =====================================================================
-- PER-PLAYER LIFECYCLE
-- =====================================================================

local function updateIconFor(player: Player)
	local iconId = player:GetAttribute("EquippedIconImage")
	log("updateIconFor", player.Name, "| EquippedIconImage attr =", tostring(iconId))
	if iconId and iconId ~= "" then
		spawnIconFor(player, iconId)
	else
		log("No equipped icon image for", player.Name, "-- destroying any active icon")
		destroyIconFor(player)
	end
end

local function setupPlayer(player: Player)
	local conns: { RBXScriptConnection } = {}

	table.insert(conns, player:GetAttributeChangedSignal("EquippedIconImage"):Connect(function()
		local newVal = player:GetAttribute("EquippedIconImage")
		log("EquippedIconImage CHANGED for", player.Name, "-&gt;", tostring(newVal))
		updateIconFor(player)
	end))

	table.insert(conns, player.CharacterAdded:Connect(function(character)
		character:WaitForChild("HumanoidRootPart", 10)
		task.wait(0.5)
		updateIconFor(player)
	end))

	table.insert(conns, player.CharacterRemoving:Connect(function()
		destroyIconFor(player)
	end))

	_playerConns[player] = conns

	if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
		task.spawn(function()
			task.wait(0.3)
			updateIconFor(player)
		end)
	end
end

local function cleanupPlayer(player: Player)
	destroyIconFor(player)
	if _playerConns[player] then
		for _, conn in ipairs(_playerConns[player]) do
			conn:Disconnect()
		end
		_playerConns[player] = nil
	end
end

-- =====================================================================
-- PUBLIC API
-- =====================================================================

function IconFollowerController.Init()
	log("Initializing...")

	Players.PlayerAdded:Connect(setupPlayer)
	Players.PlayerRemoving:Connect(cleanupPlayer)

	for _, player in ipairs(Players:GetPlayers()) do
		task.spawn(setupPlayer, player)
	end

	log("Ready -- tracking icon images for all players")
end

return IconFollowerController</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="98">
          <Properties>
            <string name="Name">LocomotionController</string>
            <string name="Source"><![CDATA[--[[
	LocomotionController
	Reusable Humanoid + Animator movement controller copied from the TungTungSahur
	chase pipeline in `src/server/TungTungSahurService.luau`.

	TungTung parity points:
	  - Target loop cadence: `ChaseInterval = 0.2`
	  - MoveTo repath gate: `RepathInterval = 0.45`
	  - Repath on target movement: `RepathTargetMoveDelta = 4.0`
	  - Animator loading flow: Animator -> LoadAnimation -> Loop -> Play
]]

local LocomotionController = {}
LocomotionController.__index = LocomotionController

local DEFAULTS = {
	WalkSpeed = 14,
	HipHeight = 2.0,
	RepathInterval = 0.18,
	RepathTargetMoveDelta = 1.5,
	WalkAnimId = "rbxassetid://507777826", -- TungTung walk
	IdleAnimId = "rbxassetid://507766666", -- default Roblox idle
}

local function ensureRoot(model: Model): BasePart?
	local root = model:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		model.PrimaryPart = root
		return root
	end

	local primary = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart", true)
	if not primary then
		return nil
	end

	-- Create a lightweight HumanoidRootPart and weld it to existing primary.
	local hrp = Instance.new("Part")
	hrp.Name = "HumanoidRootPart"
	hrp.Size = Vector3.new(2, 2, 1)
	hrp.Transparency = 1
	hrp.CanCollide = true
	hrp.CanQuery = false
	hrp.CanTouch = false
	hrp.Massless = false
	hrp.Anchored = false
	hrp.CFrame = primary.CFrame
	hrp.Parent = model

	local weld = Instance.new("WeldConstraint")
	weld.Part0 = hrp
	weld.Part1 = primary
	weld.Parent = hrp

	model.PrimaryPart = hrp
	return hrp
end

local function ensureHumanoid(model: Model, root: BasePart?, walkSpeed: number, hipHeight: number): Humanoid?
	local hum = model:FindFirstChildOfClass("Humanoid")
	if not hum then
		hum = Instance.new("Humanoid")
		hum.Name = "Humanoid"
		hum.Parent = model
	end
	hum.WalkSpeed = walkSpeed
	local minHip = 2.0
	if root then
		minHip = math.max(2.0, (root.Size.Y * 0.5) + 0.5)
	end
	hum.HipHeight = math.max(hipHeight, minHip)
	hum.AutoRotate = true
	hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	hum.BreakJointsOnDeath = false
	hum.RequiresNeck = false
	hum.PlatformStand = false
	hum.MaxHealth = math.max(hum.MaxHealth, 1000)
	hum.Health = hum.MaxHealth
	pcall(function()
		hum:ChangeState(Enum.HumanoidStateType.Running)
	end)
	return hum
end

local function ensureAnimator(humanoid: Humanoid): Animator
	local animator = humanoid:FindFirstChildOfClass("Animator")
	if animator then return animator end
	animator = Instance.new("Animator")
	animator.Parent = humanoid
	return animator
end

local function tryLoadTrack(animator: Animator, animId: string): AnimationTrack?
	if animId == "" then return nil end
	local anim = Instance.new("Animation")
	anim.AnimationId = animId
	local ok, track = pcall(function()
		return animator:LoadAnimation(anim)
	end)
	anim:Destroy()
	if ok and track then
		track.Looped = true
		return track
	end
	return nil
end

local function resolveAnimId(model: Model, wanted: string, fallbackId: string): string
	if typeof(wanted) == "string" and wanted ~= "" then
		return wanted
	end
	local wantedLower = string.lower(fallbackId)
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("Animation") then
			local n = string.lower(d.Name)
			local p = d.Parent and string.lower(d.Parent.Name) or ""
			if string.find(n, wantedLower, 1, true) or string.find(p, wantedLower, 1, true) then
				if d.AnimationId and d.AnimationId ~= "" then
					return d.AnimationId
				end
			end
		end
	end
	return ""
end

function LocomotionController.new(model: Model, opts)
	local self = setmetatable({}, LocomotionController)
	opts = opts or {}
	self._model = model
	self._cfg = {
		WalkSpeed = opts.WalkSpeed or DEFAULTS.WalkSpeed,
		HipHeight = opts.HipHeight or DEFAULTS.HipHeight,
		RepathInterval = opts.RepathInterval or DEFAULTS.RepathInterval,
		RepathTargetMoveDelta = opts.RepathTargetMoveDelta or DEFAULTS.RepathTargetMoveDelta,
		WalkAnimId = opts.WalkAnimId or DEFAULTS.WalkAnimId,
		IdleAnimId = opts.IdleAnimId or DEFAULTS.IdleAnimId,
	}

	self._root = ensureRoot(model)
	if not self._root then
		return self
	end
	if self._root then
		self._root.Anchored = false
		self._root.CanCollide = true
		self._root.Massless = false
	end
	self._humanoid = ensureHumanoid(model, self._root, self._cfg.WalkSpeed, self._cfg.HipHeight)
	self._animator = self._humanoid and ensureAnimator(self._humanoid) or nil
	local walkAnimId = resolveAnimId(model, self._cfg.WalkAnimId, "walk")
	local idleAnimId = resolveAnimId(model, self._cfg.IdleAnimId, "idle")
	self._walkTrack = self._animator and tryLoadTrack(self._animator, walkAnimId) or nil
	self._idleTrack = self._animator and tryLoadTrack(self._animator, idleAnimId) or nil
	self._moving = false
	self._lastMoveToAt = 0
	self._lastMoveTarget = nil
	self._runConn = nil
	if self._humanoid then
		self._runConn = self._humanoid.Running:Connect(function(speed)
			self:_setMoving(speed > 0.1)
		end)
	end
	self:_setMoving(false)
	return self
end

function LocomotionController:_setMoving(moving: boolean)
	if self._moving == moving then return end
	self._moving = moving
	if moving then
		if self._idleTrack then pcall(function() self._idleTrack:Stop() end) end
		if self._walkTrack then pcall(function() self._walkTrack:Play() end) end
	else
		if self._walkTrack then pcall(function() self._walkTrack:Stop() end) end
		if self._idleTrack then pcall(function() self._idleTrack:Play() end) end
	end
end

function LocomotionController:GetPosition(): Vector3?
	if self._root and self._root.Parent then
		return self._root.Position
	end
	if self._model and self._model.PrimaryPart then
		return self._model.PrimaryPart.Position
	end
	return nil
end

function LocomotionController:MoveTo(targetPos: Vector3)
	if not self._humanoid or not self._root then return end
	local now = tick()
	local lastTarget = self._lastMoveTarget
	local shouldRepath = false
	if (now - self._lastMoveToAt) >= self._cfg.RepathInterval then
		shouldRepath = true
	elseif lastTarget and (targetPos - lastTarget).Magnitude >= self._cfg.RepathTargetMoveDelta then
		shouldRepath = true
	elseif not lastTarget then
		shouldRepath = true
	end
	if not shouldRepath then return end
	self._humanoid:MoveTo(targetPos)
	self._lastMoveToAt = now
	self._lastMoveTarget = targetPos
end

function LocomotionController:Stop()
	if not self._humanoid then return end
	local pos = self:GetPosition()
	if pos then
		self._humanoid:MoveTo(pos)
	end
	self:_setMoving(false)
end

function LocomotionController:Teleport(targetCF: CFrame)
	if not self._model then return end
	self._model:PivotTo(targetCF)
	self:Stop()
end

function LocomotionController:Destroy()
	self:Stop()
	if self._walkTrack then pcall(function() self._walkTrack:Stop() end) end
	if self._idleTrack then pcall(function() self._idleTrack:Stop() end) end
	if self._runConn then
		self._runConn:Disconnect()
		self._runConn = nil
	end
	self._walkTrack = nil
	self._idleTrack = nil
	self._animator = nil
	self._humanoid = nil
	self._root = nil
end

function LocomotionController:IsWalkAnimLoaded(): boolean
	return self._walkTrack ~= nil
end

function LocomotionController:IsIdleAnimLoaded(): boolean
	return self._idleTrack ~= nil
end

return LocomotionController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="99">
          <Properties>
            <string name="Name">MusicController</string>
            <string name="Source">--[[
	MusicController
	Centralized client-side music &amp; SFX system.

	CROSSFADE enforcement: on context switch the new track begins fading in
	while the old track is simultaneously fading out.  Both overlap during
	the crossfade window so there is never a silent gap.

	Music:
	  • Lobby  — 70% original track / 30% alt track
	  • Map    — single track, starts at 32s, looped

	SFX (layered, does NOT replace music):
	  • Win / ObbyComplete via PlaySFX RemoteEvent
	  • Intermission 5-second countdown warning

	Integrates with SettingsPanel via SoundGroup "BGM" in SoundService.

	Called from: init.client.luau via MusicController.Init()
]]

local SoundService      = game:GetService("SoundService")
local TweenService      = game:GetService("TweenService")
local RunService        = game:GetService("RunService")
local Players           = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local LocalPlayer = Players.LocalPlayer
local Shared = ReplicatedStorage:WaitForChild("Shared")
local PlayerState = require(Shared:WaitForChild("PlayerState"))

local MusicController = {}

-- ═══════════════════════════════════════════════════════════════════
-- CONFIG
-- ═══════════════════════════════════════════════════════════════════

-- Lobby track A: original lobby music (10%)
local LOBBY_TRACK_A_ID      = "rbxassetid://132796863583176"
local LOBBY_TRACK_A_START   = 0
local LOBBY_TRACK_A_VOLUME  = 0.35
local LOBBY_TRACK_A_CHANCE  = 0.10

-- Lobby track B: alt lobby music (90%)
local LOBBY_TRACK_B_ID      = "rbxassetid://100199384595840"
local LOBBY_TRACK_B_START   = 10
local LOBBY_TRACK_B_VOLUME  = 1.0

-- Map music (ONLY this track — no others)
local MAP_TRACK_ID          = "rbxassetid://79513722933054"
local MAP_TRACK_START       = 32
local MAP_TRACK_VOLUME      = 0.48

-- Crossfade transition (both tracks overlap — no silent gap)
local CROSSFADE_TIME        = 1.2

-- SFX
local SFX_VOLUME            = 0.8
local COUNTDOWN_VOLUME      = 0.24
local COUNTDOWN_THRESHOLD   = 5.0
local WIN_SFX_ID            = "rbxassetid://111217342629113"
local INTERMISSION_SFX_ID   = "rbxassetid://115128556144522"

-- Legacy sounds to purge (old map music + any leftovers)
local LEGACY_SOUND_IDS = {
	["rbxassetid://99521953914772"]  = true,  -- old MapMusicA
	["rbxassetid://140496937016968"] = true,  -- old MapMusicB
}
local LEGACY_SOUND_NAMES = {
	MapMusicA = true,
	MapMusicB = true,
}

-- ═══════════════════════════════════════════════════════════════════
-- INTERNAL STATE
-- ═══════════════════════════════════════════════════════════════════

local bgmGroup: SoundGroup       = nil
local activeSound: Sound?        = nil   -- the ONE playing music Sound
local activeFadeTween: Tween?    = nil
local currentContext: string?    = nil   -- "lobby" | "map"
local lastLoggedPlayerState: string? = nil
local intermissionWarned         = false
local _initialized               = false

-- SFX sounds (persistent, not part of single-channel)
local winSfx: Sound?             = nil
local intermissionSfx: Sound?    = nil

-- Hard-stop intermission countdown SFX and reset playback position
local function stopIntermissionSfx()
	if intermissionSfx and intermissionSfx.Playing then
		intermissionSfx:Stop()
		intermissionSfx.TimePosition = 0
	end
end

-- ═══════════════════════════════════════════════════════════════════
-- LOGGING
-- ═══════════════════════════════════════════════════════════════════

local function log(...)
	print("[MusicController]", ...)
end

local function logState()
	local id = activeSound and activeSound.SoundId or "none"
	local tp = activeSound and string.format("%.1f", activeSound.TimePosition) or "0"
	local vol = activeSound and string.format("%.3f", activeSound.Volume) or "0"
	local soundCount = 0
	for _, child in ipairs(SoundService:GetChildren()) do
		if child:IsA("Sound") then soundCount += 1 end
	end
	local groupCount = 0
	if bgmGroup then
		for _, child in ipairs(bgmGroup:GetChildren()) do
			if child:IsA("Sound") then groupCount += 1 end
		end
	end
	log(string.format("Context=%s nowPlaying=%s timePos=%s volume=%s | SoundService sounds=%d, BGM group sounds=%d",
		tostring(currentContext), id, tp, vol, soundCount, groupCount))
end

-- ═══════════════════════════════════════════════════════════════════
-- LEGACY CLEANUP
-- ═══════════════════════════════════════════════════════════════════

local function purgeLegacySounds()
	local containers = { SoundService, workspace }
	for _, container in ipairs(containers) do
		for _, child in ipairs(container:GetChildren()) do
			if child:IsA("Sound") then
				local isLegacy = LEGACY_SOUND_NAMES[child.Name] or LEGACY_SOUND_IDS[child.SoundId]
				if isLegacy then
					log(string.format("Removed legacy sound: %s %s", child.Name, child.SoundId))
					child:Stop()
					child:Destroy()
				end
			end
			-- Also check inside SoundGroups
			if child:IsA("SoundGroup") then
				for _, sub in ipairs(child:GetChildren()) do
					if sub:IsA("Sound") then
						local isLegacy = LEGACY_SOUND_NAMES[sub.Name] or LEGACY_SOUND_IDS[sub.SoundId]
						if isLegacy then
							log(string.format("Removed legacy sound (in group %s): %s %s", child.Name, sub.Name, sub.SoundId))
							sub:Stop()
							sub:Destroy()
						end
					end
				end
			end
		end
	end
end

-- ═══════════════════════════════════════════════════════════════════
-- CROSSFADE SOUND MANAGEMENT
-- New track fades in while old track fades out simultaneously.
-- Both overlap during the crossfade window → no silent gap.
-- ═══════════════════════════════════════════════════════════════════

local _fadeOutTween: Tween? = nil
local _fadingOutSound: Sound? = nil

local function killActiveSound()
	if activeFadeTween then
		activeFadeTween:Cancel()
		activeFadeTween = nil
	end
	if activeSound then
		activeSound:Stop()
		activeSound:Destroy()
		activeSound = nil
	end
end

local function killFadingOutSound()
	if _fadeOutTween then
		_fadeOutTween:Cancel()
		_fadeOutTween = nil
	end
	if _fadingOutSound then
		_fadingOutSound:Stop()
		_fadingOutSound:Destroy()
		_fadingOutSound = nil
	end
end

local function createMusicSound(name: string, soundId: string, looped: boolean): Sound
	local sound = Instance.new("Sound")
	sound.Name = name
	sound.SoundId = soundId
	sound.Looped = looped
	sound.Volume = 0
	sound.SoundGroup = bgmGroup
	sound.Parent = SoundService
	return sound
end

local function crossfadeTo(newName: string, newId: string, newStart: number, newVolume: number, looped: boolean)
	-- If there's already a sound fading out from a previous crossfade, kill it immediately
	killFadingOutSound()

	-- Cancel any in-progress fade-in on the current active sound
	if activeFadeTween then
		activeFadeTween:Cancel()
		activeFadeTween = nil
	end

	-- Move the current active sound to "fading out" slot
	local oldSound = activeSound
	activeSound = nil

	if oldSound and oldSound.Parent then
		_fadingOutSound = oldSound
		local fadeOut = TweenService:Create(oldSound, TweenInfo.new(CROSSFADE_TIME, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
			Volume = 0,
		})
		_fadeOutTween = fadeOut
		fadeOut:Play()

		local capturedSound = oldSound
		task.spawn(function()
			fadeOut.Completed:Wait()
			if capturedSound and capturedSound.Parent then
				capturedSound:Stop()
				capturedSound:Destroy()
			end
			if _fadingOutSound == capturedSound then
				_fadingOutSound = nil
				_fadeOutTween = nil
			end
		end)
	end

	-- Create and fade in the new sound immediately (overlaps with old fade-out)
	local newSound = createMusicSound(newName, newId, looped)
	newSound.TimePosition = newStart
	newSound.Volume = 0
	activeSound = newSound

	newSound:Play()

	local fadeIn = TweenService:Create(newSound, TweenInfo.new(CROSSFADE_TIME, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Volume = newVolume,
	})
	activeFadeTween = fadeIn
	fadeIn:Play()

	task.spawn(function()
		fadeIn.Completed:Wait()
		if activeFadeTween == fadeIn then
			activeFadeTween = nil
		end
	end)

	log(string.format("Crossfade → %s (%s at %.0fs vol=%.2f)", newName, newId, newStart, newVolume))
	logState()
end

-- ═══════════════════════════════════════════════════════════════════
-- LOBBY MUSIC
-- ═══════════════════════════════════════════════════════════════════

local function pickLobbyTrack(): (string, number, number)
	if math.random() &lt; LOBBY_TRACK_A_CHANCE then
		return LOBBY_TRACK_A_ID, LOBBY_TRACK_A_START, LOBBY_TRACK_A_VOLUME
	else
		return LOBBY_TRACK_B_ID, LOBBY_TRACK_B_START, LOBBY_TRACK_B_VOLUME
	end
end

local function startLobby()
	if currentContext == "lobby" then return end
	currentContext = "lobby"
	log("Context → lobby")

	local trackId, startPos, volume = pickLobbyTrack()
	crossfadeTo("LobbyMusic", trackId, startPos, volume, true)
end

-- ═══════════════════════════════════════════════════════════════════
-- MAP MUSIC
-- ═══════════════════════════════════════════════════════════════════

local function startMap()
	if currentContext == "map" then return end
	currentContext = "map"
	log("Context → map")

	crossfadeTo("MapMusic", MAP_TRACK_ID, MAP_TRACK_START, MAP_TRACK_VOLUME, true)
end

-- ═══════════════════════════════════════════════════════════════════
-- CONTEXT DETECTION
-- ═══════════════════════════════════════════════════════════════════

local function resolveContextFromPlayerState(state: string?): string
	if state == PlayerState.States.InMatch then
		return "map"
	end
	-- Lobby/Waiting/AFK/Spectating/default all route to lobby music.
	return "lobby"
end

local function updateContext()
	local state = LocalPlayer:GetAttribute("PlayerState")
	local targetContext = resolveContextFromPlayerState(state)
	if targetContext == "map" then
		startMap()
	else
		startLobby()
	end

	if state ~= lastLoggedPlayerState then
		lastLoggedPlayerState = state
		local activeTrack = if targetContext == "map" then "Map" else "Lobby"
		log(string.format(
			"[MusicState] player=%s state=%s activeTrack=%s",
			LocalPlayer.Name,
			tostring(state),
			activeTrack
		))
	end
end

-- ═══════════════════════════════════════════════════════════════════
-- SFX (persistent, not single-channel)
-- ═══════════════════════════════════════════════════════════════════

local function initSFX()
	-- Win SFX
	winSfx = SoundService:FindFirstChild("WinSFX")
	if not winSfx then
		winSfx = Instance.new("Sound")
		winSfx.Name = "WinSFX"
		winSfx.SoundId = WIN_SFX_ID
		winSfx.Looped = false
		winSfx.Volume = SFX_VOLUME
		winSfx.Parent = SoundService
	end

	-- Intermission countdown SFX
	intermissionSfx = SoundService:FindFirstChild("IntermissionSFX")
	if not intermissionSfx then
		intermissionSfx = Instance.new("Sound")
		intermissionSfx.Name = "IntermissionSFX"
		intermissionSfx.SoundId = INTERMISSION_SFX_ID
		intermissionSfx.Looped = false
		intermissionSfx.Volume = COUNTDOWN_VOLUME
		intermissionSfx.Parent = SoundService
	end

	-- PlaySFX remote
	task.spawn(function()
		local remotes = ReplicatedStorage:WaitForChild("Remotes", 15)
		if not remotes then return end
		local sfxRemote = remotes:WaitForChild("PlaySFX", 15)
		if not sfxRemote then return end

		sfxRemote.OnClientEvent:Connect(function(sfxType: string)
			if (sfxType == "Win" or sfxType == "ObbyComplete") and winSfx then
				winSfx.Volume = SFX_VOLUME
				winSfx:Stop()
				winSfx:Play()
				log("SFX → " .. sfxType)
			end
		end)
	end)
end

-- ═══════════════════════════════════════════════════════════════════
-- INIT
-- ═══════════════════════════════════════════════════════════════════

function MusicController.Init()
	if _initialized then return end
	_initialized = true

	-- 1. Create BGM SoundGroup (SettingsPanel finds this)
	bgmGroup = SoundService:FindFirstChild("BGM")
	if not bgmGroup then
		bgmGroup = Instance.new("SoundGroup")
		bgmGroup.Name = "BGM"
		bgmGroup.Volume = 1
		bgmGroup.Parent = SoundService
	end

	-- 2. Purge ALL legacy sounds (old map music, duplicates)
	purgeLegacySounds()

	-- 3. Init SFX (win + intermission — these are persistent, NOT single-channel)
	initSFX()

	-- 4. Listen for PlayerState changes (primary context signal)
	LocalPlayer:GetAttributeChangedSignal("PlayerState"):Connect(function()
		local state = LocalPlayer:GetAttribute("PlayerState")
		updateContext()
		-- Stop countdown SFX immediately when going AFK; do NOT reset
		-- intermissionWarned so it won't replay on the same intermission
		if state == "AFK" then
			stopIntermissionSfx()
		end
	end)

	-- 5. Listen for MatchStatus (secondary signal + intermission countdown)
	task.spawn(function()
		local matchStatus = ReplicatedStorage:FindFirstChild("MatchStatus")
		if not matchStatus then
			matchStatus = ReplicatedStorage:WaitForChild("MatchStatus", 15)
		end
		if not matchStatus then
			warn("[MusicController] MatchStatus not found — using PlayerState only")
			return
		end

		local stateVal    = matchStatus:WaitForChild("State", 10)
		local phaseEndVal = matchStatus:WaitForChild("PhaseEndTime", 10)

		if stateVal then
		stateVal.Changed:Connect(function()
			-- MatchStatus is global; do not drive per-player music from it.
			-- Re-evaluate using local authoritative PlayerState only.
			updateContext()
			-- Reset flag so the next intermission cycle can trigger the SFX
			intermissionWarned = false
			-- If leaving intermission, hard-stop any playing countdown SFX
			if stateVal.Value ~= "Intermission" then
				stopIntermissionSfx()
			end
		end)
		end

		-- Intermission 5-second countdown SFX
		if phaseEndVal and stateVal then
			RunService.Heartbeat:Connect(function()
				if intermissionWarned then return end
				if stateVal.Value ~= "Intermission" then return end
				if LocalPlayer:GetAttribute("PlayerState") == "AFK" then return end
				local remaining = phaseEndVal.Value - workspace:GetServerTimeNow()
				if remaining &lt;= COUNTDOWN_THRESHOLD and remaining &gt; 0.5 then
					intermissionWarned = true
					if intermissionSfx then
						intermissionSfx.Volume = COUNTDOWN_VOLUME
						intermissionSfx:Stop()
						intermissionSfx:Play()
					end
				end
			end)
		end
	end)

	-- 6. Start with correct context immediately
	updateContext()

	log("Initialized — legacy sounds purged, crossfade active")
	logState()
end

return MusicController</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="100">
          <Properties>
            <string name="Name">PetFollowController</string>
            <string name="Source"><![CDATA[--[[
	PetFollowController
	Owner-follow brain that reuses LocomotionController (TungTung-style MoveTo flow).
]]

local RunService = game:GetService("RunService")
local LocomotionController = require(script.Parent:WaitForChild("LocomotionController"))

local PetFollowController = {}

local DEFAULTS = {
	FollowDistance = 5,
	SideOffset = 0,
	BackOffset = 0,
	StopDistance = 3.0,
	RepathThreshold = 1.5,
	UpdateInterval = 0.15,
	TeleportDistance = 60,
	WalkSpeed = 14,
	HipHeight = 2.0,
}

export type FollowHandle = {
	Destroy: (self: FollowHandle) -> (),
	IsWalkAnimLoaded: (self: FollowHandle) -> boolean,
	IsIdleAnimLoaded: (self: FollowHandle) -> boolean,
}

function PetFollowController.Start(model: Model, owner: Player, petId: string, opts): FollowHandle?
	if not model or not owner then return nil end
	opts = opts or {}

	local cfg = {
		FollowDistance = opts.FollowDistance or DEFAULTS.FollowDistance,
		SideOffset = opts.SideOffset or DEFAULTS.SideOffset,
		BackOffset = opts.BackOffset or DEFAULTS.BackOffset,
		StopDistance = opts.StopDistance or DEFAULTS.StopDistance,
		RepathThreshold = opts.RepathThreshold or DEFAULTS.RepathThreshold,
		UpdateInterval = opts.UpdateInterval or DEFAULTS.UpdateInterval,
		TeleportDistance = opts.TeleportDistance or DEFAULTS.TeleportDistance,
		WalkSpeed = opts.WalkSpeed or DEFAULTS.WalkSpeed,
		HipHeight = opts.HipHeight or DEFAULTS.HipHeight,
		WalkAnimId = opts.WalkAnimId,
		IdleAnimId = opts.IdleAnimId,
	}

	local loco = LocomotionController.new(model, cfg)
	local acc = 0

	local conn = RunService.Heartbeat:Connect(function(dt)
		acc += dt
		if acc < cfg.UpdateInterval then
			return
		end
		acc = 0

		if not model.Parent then
			return
		end

		local char = owner.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		if not hrp or not hrp:IsA("BasePart") then
			loco:Stop()
			return
		end

		local followPos =
			hrp.Position
			+ (hrp.CFrame.LookVector * -cfg.FollowDistance)
			+ (hrp.CFrame.RightVector * cfg.SideOffset)
			+ Vector3.new(0, 0, cfg.BackOffset)

		local petPos = loco:GetPosition()
		if not petPos then
			return
		end

		local dist = (followPos - petPos).Magnitude
		if dist > cfg.TeleportDistance or petPos.Y < -50 then
			loco:Teleport(CFrame.new(followPos))
			return
		end

		if dist > cfg.StopDistance then
			-- TungTung-style pipeline: brain requests target at interval;
			-- locomotion controller handles repath throttling and target-move delta.
			loco:MoveTo(followPos)
		else
			loco:Stop()
		end
	end)

	local handle = {}
	function handle:Destroy()
		if conn then conn:Disconnect() end
		if loco then loco:Destroy() end
	end
	function handle:IsWalkAnimLoaded(): boolean
		return loco and loco:IsWalkAnimLoaded() or false
	end
	function handle:IsIdleAnimLoaded(): boolean
		return loco and loco:IsIdleAnimLoaded() or false
	end
	return handle
end

return PetFollowController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="101">
          <Properties>
            <string name="Name">PetFollowerController</string>
            <string name="Source">--[[
	PetFollowerController
	Client-side pet follower — spawns equipped pet models for ALL visible
	players, with smooth follow + bobble animation.

	Each client renders pets for every player (reads their EquippedPet
	attribute). This keeps movement smooth while remaining server-authoritative
	for what is equipped.

	Follow behavior:
	  - Position = HumanoidRootPart * scaled offset + vertical bobble
	  - Orientation = HRP yaw (so pet faces same direction as player)
	  - Per-pet YawOffset for models whose forward axis differs
	  - Lerp each frame for smooth motion

	Pet models:
	  - Cloned from ItemModelRegistry (same source as thumbnails)
	  - All parts Anchored, CanCollide/CanQuery/CanTouch = false
	  - VFX (ParticleEmitters etc.) kept enabled (they work in Workspace)
	  - Forced to a max bounding-box size at spawn (smaller than player)

	Handles:
	  - Equip / unequip / swap (only one pet per player)
	  - Character respawn (re-spawns pet after respawn)
	  - Player leaving (cleans up pet)

	API:
	  PetFollowerController.Init()
]]

local Players           = game:GetService("Players")
local RunService        = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared            = ReplicatedStorage:WaitForChild("Shared")
local UIConfig          = require(Shared:WaitForChild("UIConfig"))
local ItemCatalog       = require(Shared:WaitForChild("ItemCatalog"))
local ItemModelRegistry = require(Shared:WaitForChild("ItemModelRegistry"))
local PetVisualConfig   = require(Shared:WaitForChild("PetVisualConfig"))
local ItemModelsFolder  = ReplicatedStorage:WaitForChild("ItemModels")

-- Walker pet remotes — server owns all physics/animation for walkers.
local _remotes       = ReplicatedStorage:WaitForChild("Remotes")
local _equipRemote   = _remotes:WaitForChild("EquipWalkerPet")
local _unequipRemote = _remotes:WaitForChild("UnequipWalkerPet")

local TAG = "[PetFollower]"
local PET_INSTANCE_NAME = "_EquippedPet"

local PetFollowerController = {}

-- =====================================================================
-- FOLLOW TUNING
-- =====================================================================

local PET_OFFSET          = CFrame.new(3, 2.5, 2)   -- offset from HumanoidRootPart
local LERP_ALPHA          = 0.08                      -- interpolation speed per frame
local BOBBLE_SPEED        = 3.0                       -- vertical sine frequency
local BOBBLE_AMPLITUDE    = 0.4                       -- vertical sine amplitude (studs)
local YAW_WOBBLE_SPEED    = 1.5
local YAW_WOBBLE_AMP      = 5                         -- degrees
local ROLL_WOBBLE_SPEED   = 2.0
local ROLL_WOBBLE_AMP     = 3                         -- degrees

-- =====================================================================
-- PER-PET OVERRIDES
-- =====================================================================

-- Yaw correction (degrees) for models whose local "face" points the wrong way.
-- When a pet looks backwards while the player faces the camera, add 180 here.
-- When sideways, add 90 or -90, etc.  Default (absent) = 0.
-- Most Blender-exported models face +Z; Roblox forward is -Z → 180° flip.
local PET_YAW_OFFSET_DEG: { [string]: number } = {
	pet_dog              = 180,
	pet_crocodile        = 180,
	pet_rabbit           = 180,
	pet_eagle            = 180,
	pet_scorpion         = 180,
	pet_shark            = -90,  -- faces along X-axis, not Z
	pet_bat              = 180,
	pet_dolphin          = 180,
	pet_pink_butterfly   = -90,  -- faces along X-axis, not Z
	-- Steve rig forward axis requires inverse yaw to face forward in float mode.
	pet_steve            = -90,
	-- Chica float rig forward axis differs; lock with explicit yaw correction.
	pet_chica            = -90,
	-- NOTE: pet_the_puppet rotation handled via PetVisualConfig.OVERRIDES
}

-- Pets that should not receive roll wobble (keeps large/rigged models visually stable).
local PET_NO_ROLL_WOBBLE: { [string]: boolean } = {
	pet_chica            = true,
	pet_foxy             = true,
	pet_bonnie           = true,
	pet_freddy_fazbear   = true,
	pet_golden_freddy    = true,
	pet_the_puppet       = true,
	pet_cupcake          = true,
}

-- Scale override: bypasses auto-scaling for models that need special treatment.
-- Value is used as a raw multiplier on the model's original scale.
local PET_SCALE_OVERRIDES: { [string]: number } = {
	-- Keep base normalization path unchanged for these; massive scaling is applied
	-- later at final spawn stage so it cannot be re-normalized back down.
	pet_huggy_wuggy = 1.0,
	pet_glitched_dragon = 1.0,
	pet_dark_falcon = 1.0,        -- Dark Goblem
	pet_pink_butterfly = 1.0,
	pet_dark_winged_dragon = 1.0, -- Music Winged Dragon
}

local PET_MASSIVE_SCALE_TARGETS: { [string]: boolean } = {
	pet_glitched_dragon = true,
	pet_dark_falcon = true,
	pet_pink_butterfly = true,
	pet_dark_winged_dragon = true,
}

local PET_FINAL_SPAWN_SCALE_MULTIPLIER: { [string]: number } = {
	pet_huggy_wuggy = 1.8,
	pet_glitched_dragon = 3.5, -- slight shrink only
	pet_dark_falcon = 2.8,        -- Dark Goblem
	pet_pink_butterfly = 2.6,
	pet_dark_winged_dragon = 2.8, -- Music Winged Dragon
}

local MOVEMENT_HOVER = "HOVER"
local MOVEMENT_WALKER = "WALKER_R15"
local MOVEMENT_SERVER_MOTOR = "SERVER_MOTOR_RIG"

local SERVER_MOTOR_PET_IDS: { [string]: boolean } = {
	pet_pink_butterfly = true,
	pet_glitched_dragon = true,
	pet_dark_winged_dragon = true, -- Music Winged Dragon
	pet_dark_falcon = true, -- Dark Goblem
}

local PET_MOVEMENT_TYPE: { [string]: string } = {
	-- Reverted to floating/bobble path
	Bonnie = MOVEMENT_HOVER,
	Chica = MOVEMENT_HOVER,
	Foxy = MOVEMENT_HOVER,
	FreddyFazbear = MOVEMENT_HOVER,

	-- HOVERS (must remain existing bobble path)
	GoldenFreddy = MOVEMENT_HOVER,
	ThePuppet = MOVEMENT_HOVER,
	Cupcake = MOVEMENT_HOVER,
}

-- FNAF pets explicitly reverted to floating companions.
local FNAF_REVERTED_FLOAT_IDS: { [string]: boolean } = {
	pet_bonnie = true,
	pet_chica = true,
	pet_foxy = true,
}

-- Final follow-transform rotation fixes for hover-only path.
local PET_ROTATION_FIX: { [string]: CFrame } = {
	-- Chica tilt is lateral in float mode; correct on roll axis.
	pet_chica = CFrame.Angles(0, 0, math.rad(14)),
}

-- Explicit equip offsets for outlier models only.
-- Mirrors the existing "finalCF = uprightCF * perPetOffset" pattern.
local PET_EQUIP_OFFSET_CFRAME: { [string]: CFrame } = {
	-- Huggy also needs a small vertical settle to avoid appearing offset.
	pet_huggy_wuggy = CFrame.new(0, -0.35, 0) * CFrame.Angles(0, math.rad(180), 0),
}

-- Deterministic orientation target list (ONLY these pets).
local DETERMINISTIC_PET_IDS: { [string]: boolean } = {
	pet_crocodile = true,
	pet_shark = true,
	pet_dog = true,
	pet_parrot = true,
	pet_penguin = true,
	pet_rabbit = true,
	pet_eagle = true,
	pet_ray_fish = true,
	pet_scorpion = true,
	pet_spider = true,
	pet_axolotl = true,
	pet_bat = true,
	pet_fredbear_plush = true,
	pet_steve = true,
	pet_huggy_wuggy = true,
	pet_glitched_dragon = true,
	pet_dark_falcon = true,
	pet_pink_butterfly = true,
	pet_dark_winged_dragon = true,
}

-- Per-pet deterministic rotation overrides (identity by default).
-- Only listed pets are allowed here.
local PET_DETERMINISTIC_ROTATION_OVERRIDES: { [string]: CFrame } = {
	pet_crocodile = CFrame.new(),
	pet_shark = CFrame.new(),
	pet_dog = CFrame.new(),
	pet_parrot = CFrame.new(),
	pet_penguin = CFrame.new(),
	pet_rabbit = CFrame.new(),
	pet_eagle = CFrame.new(),
	pet_ray_fish = CFrame.new(),
	pet_scorpion = CFrame.Angles(0, math.rad(180), 0),
	pet_spider = CFrame.new(),
	pet_axolotl = CFrame.new(),
	pet_bat = CFrame.new(),
	pet_fredbear_plush = CFrame.Angles(0, math.rad(-90), 0),
	pet_steve = CFrame.new(),
	pet_huggy_wuggy = CFrame.Angles(0, math.rad(180), 0),
	pet_glitched_dragon = CFrame.Angles(0, math.rad(90), 0),
	pet_dark_falcon = CFrame.Angles(0, math.rad(180), 0),
	pet_pink_butterfly = CFrame.new(),
	pet_dark_winged_dragon = CFrame.new(),
}

-- =====================================================================
-- SIZE NORMALIZATION
-- =====================================================================

local TARGET_MAX_DIM = 3.0   -- max bounding-box dimension (studs); player is ~5
local SCALE_FLOOR    = 0.02  -- never scale below this (prevents invisible pets)
local SCALE_CEIL     = 1.0   -- never scale above original size

-- =====================================================================
-- STATE (per-player pet tracking)
-- =====================================================================

local _activePets: { [Player]: {
	pet: Instance?,
	conn: RBXScriptConnection?,
	pos: Vector3,
	t0: number,
	mover: any?,
	_isWalker: boolean?,
	_walkerPetId: string?,
	_isServerMotor: boolean?,
	_serverMotorPetId: string?,
} } = {}

local _playerConns: { [Player]: { RBXScriptConnection } } = {}

local DEBUG_LOGS = RunService:IsStudio() and UIConfig.DebugLogs == true
local LOG_RATE_SECONDS = tonumber(UIConfig.LogRateSeconds) or 20
local _lastLogByKey: { [string]: number } = {}
local _countByKey: { [string]: number } = {}

local function shouldLog(key: string, everySeconds: number?, everyN: number?): boolean
	if not DEBUG_LOGS then
		return false
	end
	local now = tick()
	local minInterval = everySeconds or LOG_RATE_SECONDS
	local last = _lastLogByKey[key] or 0
	if now - last &gt;= minInterval then
		_lastLogByKey[key] = now
		_countByKey[key] = (_countByKey[key] or 0) + 1
		return true
	end
	if everyN and everyN &gt; 0 then
		local count = (_countByKey[key] or 0) + 1
		_countByKey[key] = count
		if count % everyN == 0 then
			_lastLogByKey[key] = now
			return true
		end
	end
	return false
end

local function log(key: string, ...)
	if shouldLog(key) then
		print(TAG, ...)
	end
end

-- =====================================================================
-- HELPERS
-- =====================================================================

--- Get the bounding-box size of a model (or BasePart).
--- Returns nil on failure.
local function getBBoxSize(inst: Instance): Vector3?
	if inst:IsA("Model") then
		local ok, _, sz = pcall(inst.GetBoundingBox, inst)
		if ok and typeof(sz) == "Vector3" then return sz end
		-- Fallback to GetExtentsSize
		local ok2, ext = pcall(inst.GetExtentsSize, inst)
		if ok2 and typeof(ext) == "Vector3" then return ext end
		return nil
	elseif inst:IsA("BasePart") then
		return inst.Size
	end
	return nil
end

--- Apply uniform scale to a model or part.  Returns true on success.
--- For Models: prefers ScaleTo, falls back to manual descendant scaling.
--- For BaseParts: scales Size + SpecialMesh.Scale + Attachment positions.
local function applyScale(inst: Instance, factor: number): boolean
	if factor == 1 then return true end
	if inst:IsA("Model") then
		local ok = pcall(function()
			local cur = inst:GetScale()
			inst:ScaleTo(cur * factor)
		end)
		if ok then return true end
		-- Fallback: scale descendants manually
		for _, d in ipairs(inst:GetDescendants()) do
			if d:IsA("BasePart") then
				d.Size = d.Size * factor
			elseif d:IsA("DataModelMesh") then
				d.Scale = d.Scale * factor
				if d:FindFirstAncestorWhichIsA("BasePart") then
					d.Offset = d.Offset * factor
				end
			elseif d:IsA("Attachment") then
				d.Position = d.Position * factor
			end
		end
		return true
	elseif inst:IsA("BasePart") then
		inst.Size = inst.Size * factor
		-- Also scale child meshes (SpecialMesh etc.) and attachments
		for _, d in ipairs(inst:GetDescendants()) do
			if d:IsA("DataModelMesh") then
				d.Scale = d.Scale * factor
				d.Offset = d.Offset * factor
			elseif d:IsA("Attachment") then
				d.Position = d.Position * factor
			end
		end
		return true
	end
	return false
end

--- Extract yaw-only (Y-axis rotation) from a CFrame.
local function yawOnly(cf: CFrame): number
	local _, ry, _ = cf:ToEulerAnglesYXZ()
	return ry
end

-- =====================================================================
-- PET SPAWN / DESTROY
-- =====================================================================

local function getPetDef(petId: string)
	if not petId or petId == "" then return nil end
	return ItemCatalog.Pets and ItemCatalog.Pets[petId]
end

local function getConfiguredPetModelName(petId: string, petDef): string
	if petDef and typeof(petDef.modelName) == "string" and petDef.modelName ~= "" then
		return petDef.modelName
	end
	if petDef and typeof(petDef.name) == "string" and petDef.name ~= "" then
		return petDef.name
	end
	return petId
end

local function getMovementType(petId: string, petDef): string
	if SERVER_MOTOR_PET_IDS[petId] then
		return MOVEMENT_SERVER_MOTOR
	end
	local modelName = getConfiguredPetModelName(petId, petDef)
	local explicit = PET_MOVEMENT_TYPE[modelName]
	if explicit then return explicit end
	if petDef and petDef.collection == "FNAF" then
		-- Explicit safety: unspecified FNAF defaults to hover, not walker.
		return MOVEMENT_HOVER
	end
	return MOVEMENT_HOVER
end

local function useWalkingFollower(petId: string, petDef): boolean
	return getMovementType(petId, petDef) == MOVEMENT_WALKER
end

local function shouldUseExactNameLookup(modelName: string): boolean
	-- Reverted FNAF float pets must resolve via explicit modelPath to avoid
	-- exact-name collisions with unrelated large world/NPC assets.
	if modelName == "Bonnie"
		or modelName == "Chica"
		or modelName == "Foxy"
		or modelName == "FreddyFazbear"
	then
		return false
	end
	return PET_MOVEMENT_TYPE[modelName] ~= nil
end

local function findHumanoidInModel(model: Model): Humanoid?
	local direct = model:FindFirstChildOfClass("Humanoid")
	if direct then
		return direct
	end
	local nested = model:FindFirstChild("Humanoid", true)
	if nested and nested:IsA("Humanoid") then
		return nested
	end
	return nil
end

local function findHrpInModel(model: Model): BasePart?
	local hrp = model:FindFirstChild("HumanoidRootPart", true)
	if hrp and hrp:IsA("BasePart") then
		return hrp
	end
	return nil
end

local ROOT_NAME_PRIORITY = {
	"HumanoidRootPart",
	"Root",
	"RootPart",
	"Handle",
	"UpperTorso",
	"LowerTorso",
	"Torso",
}

local function ensureDeterministicPrimaryPart(model: Model): BasePart?
	local current = model.PrimaryPart
	if current and current:IsA("BasePart") then
		return current
	end

	for _, name in ipairs(ROOT_NAME_PRIORITY) do
		local candidate = model:FindFirstChild(name, true)
		if candidate and candidate:IsA("BasePart") then
			model.PrimaryPart = candidate
			return candidate
		end
	end

	local allParts = {}
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			table.insert(allParts, d)
		end
	end
	table.sort(allParts, function(a, b)
		return a:GetFullName() &lt; b:GetFullName()
	end)
	local first = allParts[1]
	if first then
		model.PrimaryPart = first
		return first
	end
	return nil
end

local function pickDeterministicVisualRoot(model: Model): BasePart?
	for _, name in ipairs({ "Root", "Handle", "HumanoidRootPart" }) do
		local part = model:FindFirstChild(name, true)
		if part and part:IsA("BasePart") then
			model.PrimaryPart = part
			return part
		end
	end

	local best: BasePart? = nil
	local bestVolume = -math.huge
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			local v = d.Size.X * d.Size.Y * d.Size.Z
			if v &gt; bestVolume then
				bestVolume = v
				best = d
			end
		end
	end
	if best then
		model.PrimaryPart = best
		return best
	end
	return nil
end

local function ensureInternalWeldsToRoot(model: Model, root: BasePart)
	local hasInternalJoints = false
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("WeldConstraint") or d:IsA("Motor6D") then
			hasInternalJoints = true
			break
		end
	end
	if hasInternalJoints then
		return
	end
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") and d ~= root then
			local weld = Instance.new("WeldConstraint")
			weld.Name = "_PetInternalWeld"
			weld.Part0 = root
			weld.Part1 = d
			weld.Parent = root
		end
	end
end

local function moveModelByRootDelta(model: Model, targetRootCF: CFrame): boolean
	local root = model.PrimaryPart
	if not root then
		return false
	end
	local delta = targetRootCF * root.CFrame:Inverse()
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			d.CFrame = delta * d.CFrame
		end
	end
	return true
end

local function findWalkerRootPart(model: Model, humanoid: Humanoid?): (BasePart?, boolean)
	local hrp = findHrpInModel(model)
	if hrp then
		return hrp, true
	end
	if humanoid and humanoid.RootPart then
		return humanoid.RootPart, false
	end
	if model.PrimaryPart then
		return model.PrimaryPart, false
	end
	local anyPart = model:FindFirstChildWhichIsA("BasePart", true)
	if anyPart then
		return anyPart, false
	end
	return nil, false
end

local function ensureWalkerHumanoid(model: Model): Humanoid
	local hum = findHumanoidInModel(model)
	if hum then
		return hum
	end
	hum = Instance.new("Humanoid")
	hum.Name = "Humanoid"
	hum.Parent = model
	return hum
end

local function ensureWalkerHrp(model: Model, humanoid: Humanoid?): BasePart?
	local existing = findHrpInModel(model)
	if existing then
		return existing
	end

	local base = nil :: BasePart?
	if humanoid and humanoid.RootPart then
		base = humanoid.RootPart
	elseif model.PrimaryPart then
		base = model.PrimaryPart
	else
		base = model:FindFirstChildWhichIsA("BasePart", true)
	end
	if not base then
		return nil
	end

	local hrp = Instance.new("Part")
	hrp.Name = "HumanoidRootPart"
	hrp.Size = Vector3.new(2, 2, 1)
	hrp.Transparency = 1
	hrp.CanCollide = true
	hrp.CanQuery = false
	hrp.CanTouch = false
	hrp.Massless = false
	hrp.Anchored = false
	hrp.CFrame = base.CFrame
	hrp.Parent = model

	local weld = Instance.new("WeldConstraint")
	weld.Part0 = hrp
	weld.Part1 = base
	weld.Parent = hrp

	model.PrimaryPart = hrp
	return hrp
end

local function destroyPetFor(player: Player)
	local entry = _activePets[player]
	if not entry then return end

	-- Walker pets live on the server; notify it to clean up.
	if entry._isWalker or entry._isServerMotor then
		if player == Players.LocalPlayer then
			pcall(function() _unequipRemote:FireServer() end)
		end
		_activePets[player] = nil
		return
	end

	if entry.conn then entry.conn:Disconnect() end
	if entry.mover and entry.mover.Destroy then
		pcall(function() entry.mover:Destroy() end)
	end
	if entry.pet and entry.pet.Parent then entry.pet:Destroy() end
	_activePets[player] = nil
end

local function spawnPetFor(player: Player, petId: string)
	-- Already tracking this pet? Skip (handles both hover model and walker sentinel).
	local existing = _activePets[player]
	if existing then
		if existing._isWalker and existing._walkerPetId == petId then return end
		if existing._isServerMotor and existing._serverMotorPetId == petId then return end
		if not existing._isWalker and existing.pet and existing.pet.Parent
			and existing.pet:GetAttribute("_petId") == petId then return end
	end

	destroyPetFor(player)

	if not petId or petId == "" then return end

	local petDef = getPetDef(petId)
	if not petDef then
		warn(TAG, "Pet not in catalog:", petId)
		return
	end

	local movementType = getMovementType(petId, petDef)
	local character = player.Character
	local rootPart = character and character:FindFirstChild("HumanoidRootPart")
	if not rootPart then
		return
	end

	local modelName = getConfiguredPetModelName(petId, petDef)
	local sourceModel: Instance? = nil
	if shouldUseExactNameLookup(modelName) then
		sourceModel = ItemModelRegistry.GetByExactName(modelName)
	else
		if petDef.modelPath and petDef.modelPath ~= "" then
			sourceModel = ItemModelRegistry.Get(petDef.modelPath)
		end
		if not sourceModel and modelName ~= "" then
			sourceModel = ItemModelRegistry.Get(modelName)
		end
	end
	if DEBUG_LOGS and shouldLog("pet_spawn_lookup_" .. petId, 20) then
		local registryPath = sourceModel and sourceModel:GetFullName() or ItemModelsFolder:GetFullName()
		print(string.format("[PetSpawn] petName=%s modelFound=%s registry=%s", modelName, tostring(sourceModel ~= nil), registryPath))
	end
	if not sourceModel then
		warn(TAG, "Model not found for pet:", petId, "| modelName:", modelName, "| modelPath:", tostring(petDef.modelPath))
		return
	end

	log("spawn_begin", "Spawning pet for", player.Name .. ":", petId, "modelName:", modelName)
	local movementType = getMovementType(petId, petDef)

	-- ── WALKER PETS ────────────────────────────────────────────────────────────
	if movementType == MOVEMENT_WALKER then
		-- Non-Freddy walker fallback (currently unused): server-owned path.
		if DEBUG_LOGS and shouldLog("walker_pet_client_equip_" .. petId, 20) then
			print(string.format("[WalkerPetCL] equip petId=%s modelName=%s → firing server", petId, modelName))
		end
		_equipRemote:FireServer(petId)
		_activePets[player] = {
			pet          = nil,
			conn         = nil,
			pos          = rootPart.Position,
			t0           = tick(),
			mover        = nil,
			_isWalker    = true,
			_walkerPetId = petId,
		}
		return
	end

	-- ── SERVER MOTOR-RIG PETS (special 4 only) ────────────────────────────────
	if movementType == MOVEMENT_SERVER_MOTOR then
		if player == Players.LocalPlayer then
			_equipRemote:FireServer(petId)
		end
		_activePets[player] = {
			pet              = nil,
			conn             = nil,
			pos              = rootPart.Position,
			t0               = tick(),
			mover            = nil,
			_isServerMotor   = true,
			_serverMotorPetId = petId,
		}
		return
	end

	local clone = sourceModel:Clone()
	local deterministicTarget = DETERMINISTIC_PET_IDS[petId] == true

	-- Unwrap Accessory → extract children into a Model wrapper
	if clone:IsA("Accessory") then
		local wrapper = Instance.new("Model")
		wrapper.Name = clone.Name
		local handle = clone:FindFirstChild("Handle")
		for _, child in ipairs(clone:GetChildren()) do
			child.Parent = wrapper
		end
		if handle and handle:IsA("BasePart") then
			wrapper.PrimaryPart = handle
		else
			local firstPart = wrapper:FindFirstChildWhichIsA("BasePart", true)
			if firstPart then wrapper.PrimaryPart = firstPart end
		end
		clone:Destroy()
		clone = wrapper
	end

	-- Wrap bare BaseParts into a Model so ScaleTo / PivotTo work uniformly.
	if clone:IsA("BasePart") and not clone:IsA("Model") then
		local wrapper = Instance.new("Model")
		wrapper.Name = clone.Name
		clone.Parent = wrapper
		wrapper.PrimaryPart = clone
		clone = wrapper
	end

	-- Ensure consistent pivot behavior for per-pet offsets.
	if clone:IsA("Model") then
		if deterministicTarget then
			local root = pickDeterministicVisualRoot(clone) or ensureDeterministicPrimaryPart(clone)
			if root then
				ensureInternalWeldsToRoot(clone, root)
			end
		elseif not clone.PrimaryPart then
			local preferredRoot = clone:FindFirstChild("HumanoidRootPart", true)
			if preferredRoot and preferredRoot:IsA("BasePart") then
				clone.PrimaryPart = preferredRoot
			else
				local firstPart = clone:FindFirstChildWhichIsA("BasePart", true)
				if firstPart then
					clone.PrimaryPart = firstPart
				end
			end
		end
	end
	local spawnBoundsBeforeStr: string? = nil
	local spawnPrimaryPartName: string = "nil"
	if PET_MASSIVE_SCALE_TARGETS[petId] then
		local b = getBBoxSize(clone)
		spawnBoundsBeforeStr = b and string.format("%.2f,%.2f,%.2f", b.X, b.Y, b.Z) or "nil"
		spawnPrimaryPartName = (clone:IsA("Model") and clone.PrimaryPart and clone.PrimaryPart.Name) or "nil"
	end

	local useUnanchoredFloat = FNAF_REVERTED_FLOAT_IDS[petId] == true

	-- Hover pets: default anchored; reverted FNAF floats are unanchored.
	local function prepPart(part: BasePart)
		part.Anchored   = not useUnanchoredFloat
		part.CanCollide = false
		part.CanQuery   = false
		part.CanTouch   = false
		part.Massless   = true
	end

	if clone:IsA("BasePart") then prepPart(clone) end
	for _, d in ipairs(clone:GetDescendants()) do
		if d:IsA("BasePart") then prepPart(d) end
	end

	-- Enable VFX; destroy embedded scripts (hover pets need no scripting).
	for _, d in ipairs(clone:GetDescendants()) do
		if d:IsA("ParticleEmitter") or d:IsA("Fire") or d:IsA("Sparkles")
			or d:IsA("Smoke") or d:IsA("Beam") or d:IsA("Trail") then
			d.Enabled = true
		elseif d:IsA("Script") or d:IsA("LocalScript") then
			d:Destroy()
		end
	end

	-- ── SIZE NORMALIZATION ─────────────────────────────────────────
	-- Goal: every pet ends up with max bounding-box dim &lt;= TARGET_MAX_DIM.
	local preBBox = getBBoxSize(clone)
	local petScale = 1

	do
		local scaleOverride = PET_SCALE_OVERRIDES[petId]

		if scaleOverride then
			-- Use the explicit override
			petScale = scaleOverride
		elseif preBBox then
			local maxDim = math.max(preBBox.X, preBBox.Y, preBBox.Z, 0.01)
			if maxDim &gt; TARGET_MAX_DIM then
				petScale = TARGET_MAX_DIM / maxDim
			end
		end

		local scaleCeil = SCALE_CEIL
		if scaleOverride and scaleOverride &gt; SCALE_CEIL then
			scaleCeil = scaleOverride
		end
		petScale = math.clamp(petScale, SCALE_FLOOR, scaleCeil)

		-- Apply the primary scale
		if petScale &lt; 1 then
			applyScale(clone, petScale)
		end

		-- POST-SCALE VERIFICATION: re-measure and correct if still too big
		local postBBox = getBBoxSize(clone)
		if postBBox then
			local postMax = math.max(postBBox.X, postBBox.Y, postBBox.Z)
			if postMax &gt; TARGET_MAX_DIM then
				local correction = (TARGET_MAX_DIM / postMax) * 0.95 -- 5% safety margin
				correction = math.max(correction, SCALE_FLOOR)
				applyScale(clone, correction)
				petScale = petScale * correction
				log("post_scale", "Post-scale correction for", petId,
					string.format("extra %.3fx (was %.1f studs)", correction, postMax))
			end
		end
		if PET_MASSIVE_SCALE_TARGETS[petId] then
			local beforeStr = preBBox and string.format("%.2f,%.2f,%.2f", preBBox.X, preBBox.Y, preBBox.Z) or "nil"
			local after = getBBoxSize(clone)
			local afterStr = after and string.format("%.2f,%.2f,%.2f", after.X, after.Y, after.Z) or "nil"
			print(string.format("[PetScale] pet=%s appliedScale=%.2f bounds=%s/%s",
				tostring(petDef and petDef.name or petId),
				petScale,
				beforeStr,
				afterStr))
		end
	end

	log("scaled_pet", "Scaled pet", petId, string.format("%.3fx", petScale),
		preBBox and string.format("(pre-bbox: %.1f x %.1f x %.1f)", preBBox.X, preBBox.Y, preBBox.Z) or "(no bbox)")

	local visual = PetVisualConfig.Get(petId, petDef)

	-- Apply visual scale ONCE per spawn (never in follow loop).
	if visual.scale ~= 1 then
		applyScale(clone, visual.scale)
		petScale = petScale * visual.scale
	end

	if RunService:IsStudio() and visual.debugTag and shouldLog("pet_visual_fix_" .. petId, 20) then
		print(string.format(
			"[PetVisualFix] pet=%s appliedRot=&lt;%.1f,%.1f,%.1f&gt;",
			petId,
			visual.rotDeg.X,
			visual.rotDeg.Y,
			visual.rotDeg.Z
		))
	end

	-- ── FOLLOW OFFSET (scaled to pet size) ─────────────────────────
	local offsetMul = 0.4 + 0.6 * petScale
	local petOffset = CFrame.new(
		PET_OFFSET.X * offsetMul,
		PET_OFFSET.Y * offsetMul,
		PET_OFFSET.Z * offsetMul
	)
	local petBobbleAmp = BOBBLE_AMPLITUDE * math.max(petScale, 0.4)

	-- Per-pet yaw offset in radians (from table + PetVisualConfig rotation).
	-- PetVisualConfig.rotation is a pure-yaw CFrame for backwards-facing models.
	local petYawRad = math.rad(PET_YAW_OFFSET_DEG[petId] or 0)
	do
		-- Extract additional yaw from visual.rotation (ignore any pitch/roll).
		local _, vy, _ = visual.rotation:ToEulerAnglesYXZ()
		petYawRad = petYawRad + vy
	end

	if RunService:IsStudio() and shouldLog("pet_upright_" .. petId, 20) then
		print(string.format("[PetUpright] petId=%s yawOffsetDeg=%.0f",
			petId, math.deg(petYawRad)))
	end

	clone.Name = PET_INSTANCE_NAME
	clone:SetAttribute("IsPet", true)
	clone:SetAttribute("_petId", petId)
	clone:SetAttribute("_owner", player.Name)
	clone.Parent = workspace

	-- Final in-game scale pass for the four tiny legendary pets.
	-- Runs AFTER normalization and parent, BEFORE final attach transform.
	local finalSpawnMult = PET_FINAL_SPAWN_SCALE_MULTIPLIER[petId]
	if finalSpawnMult and finalSpawnMult &gt; 1 then
		print(string.format("[PetSpawnModel] pet=%s modelPath=%s primaryPart=%s boundsBefore=%s",
			tostring(petDef and petDef.name or petId),
			tostring(clone:GetFullName()),
			tostring(spawnPrimaryPartName),
			tostring(spawnBoundsBeforeStr or "nil")))
		applyScale(clone, finalSpawnMult)
		petScale = petScale * finalSpawnMult
		local after = getBBoxSize(clone)
		local afterStr = after and string.format("%.2f,%.2f,%.2f", after.X, after.Y, after.Z) or "nil"
		print(string.format("[PetScaleApplied] pet=%s multiplier=%.2f boundsAfter=%s",
			tostring(petDef and petDef.name or petId),
			finalSpawnMult,
			afterStr))
	end

	-- ── INITIAL POSITION ───────────────────────────────────────────
	local startPos = (rootPart.CFrame * petOffset).Position
	local look0 = rootPart.CFrame.LookVector
	local yaw0  = math.atan2(-look0.X, -look0.Z) + petYawRad
	local startCF = CFrame.new(startPos) * CFrame.Angles(0, yaw0, 0)
	local deterministicOverride = deterministicTarget and (PET_DETERMINISTIC_ROTATION_OVERRIDES[petId] or CFrame.new()) or CFrame.new()
	local attachCF = startCF
		* (PET_EQUIP_OFFSET_CFRAME[petId] or CFrame.new())
		* (PET_ROTATION_FIX[petId] or CFrame.new())
		* deterministicOverride

	if deterministicTarget and clone:IsA("Model") then
		task.wait()
		local root = pickDeterministicVisualRoot(clone) or ensureDeterministicPrimaryPart(clone)
		if not root then
			clone:PivotTo(attachCF)
		else
			ensureInternalWeldsToRoot(clone, root)
			if not moveModelByRootDelta(clone, attachCF) then
				clone:PivotTo(attachCF)
			end
		end
	elseif clone:IsA("Model") then
		clone:PivotTo(attachCF)
	elseif clone:IsA("BasePart") then
		clone.CFrame = attachCF
	end

	if deterministicTarget then
		local rootPath = "nil"
		if clone:IsA("Model") and clone.PrimaryPart then
			rootPath = clone.PrimaryPart:GetFullName()
		elseif clone:IsA("BasePart") then
			rootPath = clone:GetFullName()
		end
		local parts = 0
		local anchored = 0
		local transparent = 0
		local ltmNonZero = 0
		local samplePos = Vector3.new(0, 0, 0)
		for _, d in ipairs(clone:GetDescendants()) do
			if d:IsA("BasePart") then
				parts += 1
				if d.Anchored then anchored += 1 end
				if d.Transparency &gt;= 1 then transparent += 1 end
				if d.LocalTransparencyModifier &gt; 0 then ltmNonZero += 1 end
				samplePos = d.Position
			end
		end
		print(string.format(
			"[PetAttach] pet=%s root=%s parts=%d anchored=%d transparent=%d ltmNonZero=%d samplePos=&lt;%.2f,%.2f,%.2f&gt; finalLook=&lt;%.3f,%.3f,%.3f&gt; finalUp=&lt;%.3f,%.3f,%.3f&gt; overrideApplied=%s",
			tostring(petDef and petDef.name or petId),
			tostring(rootPath),
			parts, anchored, transparent, ltmNonZero,
			samplePos.X, samplePos.Y, samplePos.Z,
			attachCF.LookVector.X, attachCF.LookVector.Y, attachCF.LookVector.Z,
			attachCF.UpVector.X, attachCF.UpVector.Y, attachCF.UpVector.Z,
			tostring(PET_DETERMINISTIC_ROTATION_OVERRIDES[petId] ~= nil)
		))
	end

	-- ── FOLLOW + BOBBLE LOOP ───────────────────────────────────────
	-- Position is lerped for smooth motion; orientation is rebuilt fresh
	-- every frame from the player's LookVector so pitch/roll are ALWAYS 0.
	local currentPos = startPos
	local t0 = tick()

	local followConn = RunService.Heartbeat:Connect(function()
		if not clone or not clone.Parent then
			destroyPetFor(player)
			return
		end
		local char = player.Character
		if not char then return end
		local hrp = char:FindFirstChild("HumanoidRootPart")
		if not hrp then return end

		local t = tick() - t0

		-- 1) Target position: offset from HRP + vertical bobble (position only, no rotation)
		local rawTarget = (hrp.CFrame * petOffset).Position
		local bobbleY   = math.sin(t * BOBBLE_SPEED) * petBobbleAmp
		local targetPos = Vector3.new(rawTarget.X, rawTarget.Y + bobbleY, rawTarget.Z)

		-- 2) Lerp position only (no lerp on rotation — orientation is always fresh)
		currentPos = currentPos:Lerp(targetPos, LERP_ALPHA)

		-- 3) Compute yaw from player LookVector — guaranteed pitch=0, roll=0
		local lookVec = hrp.CFrame.LookVector
		local yaw = math.atan2(-lookVec.X, -lookVec.Z) + petYawRad
		-- Small yaw wobble (wobble is yaw-only, no tilt introduced)
		yaw = yaw + math.sin(t * YAW_WOBBLE_SPEED) * math.rad(YAW_WOBBLE_AMP)

		-- 4) Upright CFrame: ONLY yaw rotation, pitch=0, roll=0 always
		local uprightCF = CFrame.new(currentPos) * CFrame.Angles(0, yaw, 0)
		local finalCF = uprightCF
			* (PET_EQUIP_OFFSET_CFRAME[petId] or CFrame.new())
			* (PET_ROTATION_FIX[petId] or CFrame.new())
		if deterministicTarget then
			finalCF = finalCF * (PET_DETERMINISTIC_ROTATION_OVERRIDES[petId] or CFrame.new())
		end

		-- 5) Apply
		if deterministicTarget and clone:IsA("Model") then
			local root = clone.PrimaryPart or pickDeterministicVisualRoot(clone) or ensureDeterministicPrimaryPart(clone)
			if not root then
				clone:PivotTo(finalCF)
			elseif not moveModelByRootDelta(clone, finalCF) then
				clone:PivotTo(finalCF)
			end
		elseif clone:IsA("Model") then
			clone:PivotTo(finalCF)
		elseif clone:IsA("BasePart") then
			clone.CFrame = finalCF
		end
	end)

	_activePets[player] = {
		pet = clone,
		conn = followConn,
		pos = currentPos,
		t0 = t0,
		mover = nil,
	}

	log("spawn_done", "Pet spawned for", player.Name .. ":", petId)
end

-- =====================================================================
-- PER-PLAYER LIFECYCLE
-- =====================================================================

local function updatePetFor(player: Player)
	local petId = player:GetAttribute("EquippedPet")
	if petId and petId ~= "" then
		spawnPetFor(player, petId)
	else
		destroyPetFor(player)
	end
end

local function setupPlayer(player: Player)
	local conns: { RBXScriptConnection } = {}

	table.insert(conns, player:GetAttributeChangedSignal("EquippedPet"):Connect(function()
		updatePetFor(player)
	end))

	table.insert(conns, player.CharacterAdded:Connect(function(character)
		character:WaitForChild("HumanoidRootPart", 10)
		task.wait(0.5)
		updatePetFor(player)
	end))

	table.insert(conns, player.CharacterRemoving:Connect(function()
		destroyPetFor(player)
	end))

	_playerConns[player] = conns

	if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
		task.spawn(function()
			task.wait(0.3)
			updatePetFor(player)
		end)
	end
end

local function cleanupPlayer(player: Player)
	destroyPetFor(player)
	if _playerConns[player] then
		for _, conn in ipairs(_playerConns[player]) do
			conn:Disconnect()
		end
		_playerConns[player] = nil
	end
end

-- =====================================================================
-- PUBLIC API
-- =====================================================================

function PetFollowerController.Init()
	log("init", "Initializing...")

	Players.PlayerAdded:Connect(setupPlayer)
	Players.PlayerRemoving:Connect(cleanupPlayer)

	for _, player in ipairs(Players:GetPlayers()) do
		task.spawn(setupPlayer, player)
	end

	log("ready", "Ready — tracking pets for all players")
end

return PetFollowerController</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="102">
          <Properties>
            <string name="Name">PetNpcFollower</string>
            <string name="Source"><![CDATA[-- Thin client-side resolver for walker follower implementation.
-- Prefers ReplicatedStorage.Pets.PetNpcFollower when available; falls back
-- to legacy client walker follow so pet spawning never hard-blocks.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local function tryRequireNpcFollower()
	local petsFolder = ReplicatedStorage:FindFirstChild("Pets")
	if not petsFolder then
		return nil
	end
	local moduleInst = petsFolder:FindFirstChild("PetNpcFollower")
	if not moduleInst then
		return nil
	end
	local ok, mod = pcall(function()
		return require(moduleInst)
	end)
	if ok then
		return mod
	end
	return nil
end

local remoteImpl = tryRequireNpcFollower()
if remoteImpl and typeof(remoteImpl.Start) == "function" then
	return remoteImpl
end

local Legacy = require(script.Parent:WaitForChild("PetWalkerFollowController"))

local Fallback = {}
function Fallback.Start(model: Model, owner: Player, opts)
	-- PetFollowController signature includes petId in arg3; it is not used.
	return Legacy.Start(model, owner, "", opts)
end

return Fallback
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="103">
          <Properties>
            <string name="Name">PetWalkerFollowController</string>
            <string name="Source"><![CDATA[-- Wrapper module for explicit walker-follow routing.
-- Keeps naming aligned with the walker-only behavior used by FNAF walker pets.
return require(script.Parent:WaitForChild("PetFollowController"))
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="104">
          <Properties>
            <string name="Name">RewardGrantListener</string>
            <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")

local RewardGrantListener = {}
local initialized = false
local shownBundleTokens: { [string]: number } = {}
local shownBundleCooldownSeconds = 10

local function getRewardPopup()
	local ui = script.Parent:FindFirstChild("UI")
	if not ui then return nil end
	local mod = ui:FindFirstChild("RewardPopup")
	if not mod then return nil end
	local ok, result = pcall(require, mod)
	if ok then return result end
	return nil
end

local function mapSinglePayload(payload)
	local rewardType = tostring(payload.type or "")
	if rewardType == "Currency" then
		local amount = tonumber(payload.amount) or 0
		return {
			title = "PURCHASED!",
			name = string.format("+%d Fate Coins", amount),
			itemType = "Coins",
			itemId = "fate_coins",
			rarityText = "Common",
			icon = payload.popupImageOverride or "rbxassetid://72345557707985",
			okText = "NICE!",
			popupSource = tostring(payload.source or ""),
		}
	elseif rewardType == "Spin" then
		local amount = tonumber(payload.amount) or 0
		return {
			title = "PURCHASED!",
			name = string.format("+%d Spins", amount),
			itemType = "Spin",
			itemId = "spin_purchased",
			rarityText = "Rare",
			icon = payload.popupImageOverride or "",
			okText = "NICE!",
			popupSource = tostring(payload.source or ""),
		}
	end
	local iconAsset = payload.imageAssetId or payload.popupImageOverride or ""
	return {
		title = "PURCHASED!",
		name = payload.name or payload.id or "Reward",
		itemType = rewardType,
		itemId = payload.id or "",
		category = payload.category or "",
		rarityText = payload.rarity or "Common",
		icon = iconAsset,
		okText = "NICE!",
		popupSource = tostring(payload.source or ""),
	}
end

function RewardGrantListener.Init()
	if initialized then return end
	initialized = true

	local remotes = ReplicatedStorage:WaitForChild("Remotes", 15)
	local rewardRE = remotes and remotes:WaitForChild("RewardGranted", 15)
	local bundleConfirmedRE = remotes and remotes:WaitForChild("BundlePurchaseConfirmed", 15)
	local purchaseGrantedRE = remotes and remotes:FindFirstChild("PurchaseGranted")
	if not rewardRE or not rewardRE:IsA("RemoteEvent") then
		warn("[RewardGrantListener] RewardGranted remote missing")
		return
	end

	rewardRE.OnClientEvent:Connect(function(payload)
		local RewardPopup = getRewardPopup()
		if not RewardPopup then
			warn("[RewardGrantListener] RewardPopup unavailable")
			return
		end
		if type(payload) ~= "table" then
			return
		end
		if tostring(payload.type or "") == "Bundle" then
			print("[BundlePopup] BLOCKED reason=INIT_OR_OWNED_STATE")
			return
		end
		local source = tostring(payload.source or "")
		local pType = tostring(payload.type or payload.grantType or "")
		if (source == "Shop" or source == "GamePass" or source == "DevProduct")
			and (pType == "Crown" or pType == "Pet" or pType == "IconImage")
		then
			print(string.format("[ShopGrantPopup] type=%s id=%s image=%s rarity=%s",
				pType,
				tostring(payload.id or ""),
				tostring(payload.imageAssetId or payload.popupImageOverride or ""),
				tostring(payload.rarity or "Common")))
		end

		if type(payload.batchItems) == "table" and #payload.batchItems > 0 then
			local items = {}
			for _, item in ipairs(payload.batchItems) do
				table.insert(items, mapSinglePayload(item))
			end
			RewardPopup.ShowBatch(items)
		else
			RewardPopup.Show(mapSinglePayload(payload))
		end
	end)

	local purchaseListenerConnected = false
	local function connectPurchaseGranted(remote: Instance?)
		if purchaseListenerConnected then
			return
		end
		if not remote or not remote:IsA("RemoteEvent") then
			return
		end
		purchaseListenerConnected = true
		remote.OnClientEvent:Connect(function(payload)
			local RewardPopup = getRewardPopup()
			if not RewardPopup then
				warn("[RewardGrantListener] RewardPopup unavailable")
				return
			end
			if type(payload) ~= "table" then
				return
			end
			local pType = tostring(payload.type or payload.grantType or "")
			if pType ~= "Crown" and pType ~= "Pet" and pType ~= "IconImage" then
				return
			end
			if not payload.source or payload.source == "" then
				payload.source = "Shop"
			end
			print(string.format("[ShopGrantPopup] type=%s id=%s image=%s",
				pType,
				tostring(payload.id or ""),
				tostring(payload.imageAssetId or payload.popupImageOverride or "")))
			RewardPopup.Show(mapSinglePayload(payload))
		end)
	end

	connectPurchaseGranted(purchaseGrantedRE)
	if remotes then
		remotes.ChildAdded:Connect(function(child)
			if child.Name == "PurchaseGranted" then
				connectPurchaseGranted(child)
			end
		end)
	end

	if not bundleConfirmedRE or not bundleConfirmedRE:IsA("RemoteEvent") then
		warn("[RewardGrantListener] BundlePurchaseConfirmed remote missing")
		return
	end

	bundleConfirmedRE.OnClientEvent:Connect(function(bundleId, payload)
		local RewardPopup = getRewardPopup()
		if not RewardPopup then
			warn("[RewardGrantListener] RewardPopup unavailable")
			return
		end
		local bundleKey = tostring(bundleId or "")
		local data = (type(payload) == "table") and payload or {}
		local token = tostring(data.token or bundleKey)
		local now = os.clock()
		local prior = shownBundleTokens[token]
		if prior and (now - prior) <= shownBundleCooldownSeconds then
			return
		end
		shownBundleTokens[token] = now
		print(string.format("[BundlePopup] SHOW bundle=%s reason=SERVER_CONFIRMED", bundleKey))
		RewardPopup.Show({
			title = tostring(data.title or "PURCHASED!"),
			name = tostring(data.name or "Bundle purchase completed"),
			itemType = tostring(data.itemType or "Bundle"),
			itemId = tostring(data.itemId or bundleKey),
			rarityText = tostring(data.rarityText or "Common"),
			icon = data.icon or "",
			okText = tostring(data.okText or "NICE!"),
		})
	end)
end

return RewardGrantListener
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="105">
          <Properties>
            <string name="Name">RigNormalizer</string>
            <string name="Source"><![CDATA[-- Client-side resolver for RigNormalizer.
-- Uses ReplicatedStorage.Pets.RigNormalizer when available.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local function tryRemote()
	local petsFolder = ReplicatedStorage:FindFirstChild("Pets")
	if not petsFolder then
		return nil
	end
	local moduleInst = petsFolder:FindFirstChild("RigNormalizer")
	if not moduleInst then
		return nil
	end
	local ok, mod = pcall(function()
		return require(moduleInst)
	end)
	if ok then
		return mod
	end
	return nil
end

local remote = tryRemote()
if remote and typeof(remote.EnsureHumanoidRootPart) == "function" then
	return remote
end

local Fallback = {}

local function findFirstBasePart(model: Model): BasePart?
	return model:FindFirstChildWhichIsA("BasePart", true)
end

local function findTorsoRoot(model: Model): BasePart?
	local lower = model:FindFirstChild("LowerTorso", true)
	if lower and lower:IsA("BasePart") then
		return lower
	end
	local upper = model:FindFirstChild("UpperTorso", true)
	if upper and upper:IsA("BasePart") then
		return upper
	end
	return nil
end

function Fallback.EnsureHumanoidRootPart(model: Model): BasePart?
	local existing = model:FindFirstChild("HumanoidRootPart", true)
	if existing and existing:IsA("BasePart") then
		model.PrimaryPart = existing
		return existing
	end

	local torso = findTorsoRoot(model)
	local rootRef = torso or model.PrimaryPart or findFirstBasePart(model)
	if not rootRef then
		return nil
	end

	local hrp = Instance.new("Part")
	hrp.Name = "HumanoidRootPart"
	hrp.Size = Vector3.new(2, 2, 1)
	hrp.Transparency = 1
	hrp.CanCollide = false
	hrp.CanQuery = false
	hrp.CanTouch = false
	hrp.Massless = false
	hrp.Anchored = false
	hrp.CFrame = rootRef.CFrame
	hrp.Parent = model

	local jointTarget = torso or rootRef
	local rootJoint = Instance.new("Motor6D")
	rootJoint.Name = "RootJoint"
	rootJoint.Part0 = hrp
	rootJoint.Part1 = jointTarget
	rootJoint.C0 = CFrame.new()
	rootJoint.C1 = jointTarget.CFrame:ToObjectSpace(hrp.CFrame)
	rootJoint.Parent = hrp

	model.PrimaryPart = hrp
	return hrp
end

return Fallback
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="106">
          <Properties>
            <string name="Name">SpectateController</string>
            <string name="Source"><![CDATA[--[[
	SpectateController
	Client-side camera control for spectating.
	
	When player is eliminated:
	- Server fires SpectateTarget with target UserId
	- Client attaches camera to target's character
	- When target is nil (no one alive), reverts to own character
	
	Future: Add next/prev cycling keybinds
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

-- Wait for remotes
local Remotes = ReplicatedStorage:WaitForChild("Remotes", 10)
if not Remotes then
	warn("[SpectateController] Remotes folder not found — spectating disabled")
	return {} -- Must return a value (ModuleScript requirement)
end

local SpectateTarget = Remotes:WaitForChild("SpectateTarget", 5)
if not SpectateTarget then
	warn("[SpectateController] SpectateTarget remote not found — spectating disabled")
	return {} -- Must return a value (ModuleScript requirement)
end

-- State
local isSpectating = false
local currentTarget: Player? = nil
local originalCameraSubject = nil

--[[ HELPERS ]]

local function log(...)
	print("[SpectateController]", ...)
end

local function getHumanoid(player: Player): Humanoid?
	local character = player.Character
	if not character then return nil end
	return character:FindFirstChildOfClass("Humanoid")
end

local function attachCameraToTarget(target: Player?)
	if not target then
		-- Revert to own character
		if originalCameraSubject then
			Camera.CameraSubject = originalCameraSubject
		else
			local myHumanoid = getHumanoid(LocalPlayer)
			if myHumanoid then
				Camera.CameraSubject = myHumanoid
			end
		end
		currentTarget = nil
		isSpectating = false
		log("Stopped spectating - camera reverted")
		return
	end
	
	local targetHumanoid = getHumanoid(target)
	if targetHumanoid then
		Camera.CameraSubject = targetHumanoid
		currentTarget = target
		isSpectating = true
		log("Now spectating:", target.Name)
	else
		-- Target has no humanoid yet, wait and retry
		task.spawn(function()
			for _ = 1, 10 do
				task.wait(0.2)
				local humanoid = getHumanoid(target)
				if humanoid then
					Camera.CameraSubject = humanoid
					currentTarget = target
					isSpectating = true
					log("Now spectating:", target.Name)
					return
				end
			end
			log("Failed to find target humanoid for:", target.Name)
		end)
	end
end

--[[ EVENT HANDLERS ]]

SpectateTarget.OnClientEvent:Connect(function(targetUserId: number?)
	-- Store original camera subject if not already spectating
	if not isSpectating and not originalCameraSubject then
		originalCameraSubject = Camera.CameraSubject
	end
	
	if not targetUserId then
		-- No target - revert camera
		attachCameraToTarget(nil)
		return
	end
	
	-- Find player by UserId
	local target = Players:GetPlayerByUserId(targetUserId)
	if target then
		attachCameraToTarget(target)
	else
		log("Target player not found for UserId:", targetUserId)
		attachCameraToTarget(nil)
	end
end)

-- Handle target leaving
Players.PlayerRemoving:Connect(function(player)
	if currentTarget == player then
		log("Spectate target left, finding new target...")
		-- Server should send new target, but as fallback revert
		task.delay(0.5, function()
			if currentTarget == player then
				attachCameraToTarget(nil)
			end
		end)
	end
end)

-- Reset on respawn
LocalPlayer.CharacterAdded:Connect(function(character)
	if isSpectating then
		-- Keep spectating if we were spectating
		return
	end
	
	-- Reset original camera subject
	local humanoid = character:WaitForChild("Humanoid", 5)
	if humanoid then
		originalCameraSubject = humanoid
	end
end)

log("Initialized")

return {} -- ModuleScript must return exactly one value
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="107">
          <Properties>
            <string name="Name">StormFXController</string>
            <string name="Source"><![CDATA[--[[
	StormFXController
	Client-side storm atmosphere when camera or player is outside the barrier.
	
	Decision:
	  shouldStorm = (cameraOutside OR playerOutside)
	  - cameraOutside: camera XZ position past arena bounds + CamOutsideMargin
	  - playerOutside: HumanoidRootPart XZ position past arena bounds
	  Both use POSITION only — no look-vector, FOV, pitch, or zoom distance.
	
	Effects (screen-space, no character particles):
	  ON  → tween Atmosphere to storm values (0.15s smooth entry), enable CC + Bloom
	  OFF → INSTANT SNAP Atmosphere to original, disable CC + Bloom
	        Snap-OFF ensures no stuck/dark/half-tween lighting states.
	
	Evaluated at 20 Hz (MinUpdateInterval = 0.05s) via RenderStepped.
	Uses hysteresis enter/exit band to prevent flicker — no time delay.
	
	InMatch only. Lobby/spectators: no effects.
	
	Logging:
	  - Init/Destroy: always print (one-time)
	  - ON/OFF state changes: only when DebugLogs = true (with reason + distances)
	  - Periodic state dump (~1/s): only when DebugTickLogs = true
	
	API:
		Init()      → Start the controller (call once from client bootstrap)
		Destroy()   → Stop and clean up everything
]]

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local StormFXConfig = require(Shared:WaitForChild("StormFXConfig"))

local LocalPlayer = Players.LocalPlayer

--[[ INTERNAL STATE ]]
local initialized = false
local fxEnabled = false

-- Effects (created once at Init, destroyed at Destroy)
local colorCorrection: ColorCorrectionEffect? = nil
local bloom: BloomEffect? = nil

-- Atmosphere
local atmosphere: Atmosphere? = nil
local origAtmoValues: {
	Density: number,
	Haze: number,
	Color: Color3,
	Decay: Color3,
	Offset: number,
	Glare: number,
}? = nil
local activeTween: Tween? = nil

-- Connections
local renderConnection: RBXScriptConnection? = nil
local characterRemovingConnection: RBXScriptConnection? = nil

-- Hysteresis (per-trigger boolean)
local hystCameraOutside: boolean = false
local hystPlayerOutside: boolean = false

-- Timing
local lastUpdate: number = 0
local lastDebugLog: number = 0

-- Bounds cache (refreshed periodically — walls only move on shrink)
local cachedBounds: {
	centerX: number,
	centerZ: number,
	halfX: number,
	halfZ: number,
}? = nil
local lastBoundsRefresh: number = 0

local StormFXController = {}

--[[ HELPERS ]]

local function debugLog(...)
	if StormFXConfig.DebugLogs then
		print("[StormFX]", ...)
	end
end

--[[
	Remove any stale StormFX_* instances from the local player's character.
	Safety net for old code versions that attached particles to HumanoidRootPart.
]]
local function cleanupStaleCharacterFX()
	local character = LocalPlayer.Character
	if not character then return end

	local cleaned = 0
	for _, descendant in ipairs(character:GetDescendants()) do
		if typeof(descendant) == "Instance" and string.find(descendant.Name, "StormFX_") then
			descendant:Destroy()
			cleaned += 1
		end
	end

	if cleaned > 0 then
		print(string.format("[StormFX] Cleaned %d stale StormFX_ instances from character", cleaned))
	end
end

--[[
	Remove duplicate StormFX effects from Lighting (hot-reload safety).
]]
local function cleanupStaleLightingFX()
	local cleaned = 0
	for _, child in ipairs(Lighting:GetChildren()) do
		if child.Name == "StormFX_CC" or child.Name == "StormFX_Bloom" then
			child:Destroy()
			cleaned += 1
		end
	end
	if cleaned > 0 then
		print(string.format("[StormFX] Cleaned %d stale effects from Lighting", cleaned))
	end
end

--[[
	Refresh cached bounds from the replicated StormWall parts.
	Called every BoundsCacheInterval seconds (not every evaluation).
]]
local function refreshBoundsCache()
	local arenaEffects = Workspace:FindFirstChild("ArenaEffects")
	if not arenaEffects then
		cachedBounds = nil
		return
	end

	local bounds = arenaEffects:FindFirstChild("Bounds")
	if not bounds then
		cachedBounds = nil
		return
	end

	local north, south, east, west = nil, nil, nil, nil

	for _, wall in ipairs(bounds:GetChildren()) do
		if not wall:IsA("BasePart") then continue end
		if wall.Name == "StormWall_North" then north = wall
		elseif wall.Name == "StormWall_South" then south = wall
		elseif wall.Name == "StormWall_East" then east = wall
		elseif wall.Name == "StormWall_West" then west = wall
		end
	end

	if not (north and south and east and west) then
		cachedBounds = nil
		return
	end

	-- Inner faces define the active play rectangle
	local maxZ = north.Position.Z - north.Size.Z / 2
	local minZ = south.Position.Z + south.Size.Z / 2
	local maxX = east.Position.X - east.Size.X / 2
	local minX = west.Position.X + west.Size.X / 2

	cachedBounds = {
		centerX = (minX + maxX) / 2,
		centerZ = (minZ + maxZ) / 2,
		halfX = (maxX - minX) / 2,
		halfZ = (maxZ - minZ) / 2,
	}
end

--[[
	Signed distance from a point (XZ only) to the arena bounds edge.
	Positive = outside bounds by that many studs.
	Negative = inside bounds by that many studs.
	Returns -math.huge if bounds unavailable.
]]
local function getSignedDistanceToBounds(x: number, z: number): number
	if not cachedBounds then return -math.huge end
	local b = cachedBounds
	local dx = math.abs(x - b.centerX) - b.halfX
	local dz = math.abs(z - b.centerZ) - b.halfZ
	return math.max(dx, dz)
end

--[[
	Camera signed distance to bounds edge (XZ plane).
	Positive = camera is OUTSIDE bounds.
]]
local function getCameraOutsideDistance(): number
	local cam = Workspace.CurrentCamera
	if not cam then return -math.huge end
	local p = cam.CFrame.Position
	return getSignedDistanceToBounds(p.X, p.Z)
end

--[[
	Player signed distance to bounds edge (XZ plane).
	Positive = player is OUTSIDE bounds.
]]
local function getPlayerOutsideDistance(): number
	local character = LocalPlayer.Character
	if not character then return -math.huge end
	local rootPart = character:FindFirstChild("HumanoidRootPart")
	if not rootPart then return -math.huge end
	local p = rootPart.Position
	return getSignedDistanceToBounds(p.X, p.Z)
end

--[[
	Tween atmosphere toward target values (used for ON transition only).
	Cancels any previously running atmosphere tween first.
]]
local function tweenAtmosphereOn(targetProps: { Density: number, Haze: number, Color: Color3 })
	if not atmosphere then return end
	if activeTween then activeTween:Cancel(); activeTween = nil end

	activeTween = TweenService:Create(
		atmosphere,
		TweenInfo.new(StormFXConfig.TweenDuration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		targetProps
	)
	activeTween:Play()
end

--[[
	Snap atmosphere to exact values INSTANTLY (no tween).
	Used for OFF and forceReset to guarantee no stuck half-state.
]]
local function snapAtmosphereToOriginal()
	if activeTween then activeTween:Cancel(); activeTween = nil end

	if atmosphere and origAtmoValues then
		atmosphere.Density = origAtmoValues.Density
		atmosphere.Haze = origAtmoValues.Haze
		atmosphere.Color = origAtmoValues.Color
	end
end

--[[
	Enable storm FX (smooth ON).
	Tweens atmosphere to storm values, enables CC + Bloom.
]]
local function enableFX(reason: string, camDist: number, plyDist: number)
	if fxEnabled then return end
	fxEnabled = true
	debugLog(string.format("ON  reason=%s camDist=%.1f plyDist=%.1f", reason, camDist, plyDist))

	-- Smooth tween atmosphere to storm overlay
	if origAtmoValues then
		tweenAtmosphereOn({
			Density = math.max(origAtmoValues.Density, StormFXConfig.AtmosphereDensity),
			Haze = math.max(origAtmoValues.Haze, StormFXConfig.AtmosphereHaze),
			Color = StormFXConfig.AtmosphereColor,
		})
	end

	-- Enable post-processing instantly
	if colorCorrection then colorCorrection.Enabled = true end
	if bloom then bloom.Enabled = true end
end

--[[
	Disable storm FX (INSTANT OFF).
	Snaps atmosphere to original values, disables CC + Bloom.
	No tween — no risk of competing tweens or half-states.
]]
local function disableFX(camDist: number, plyDist: number)
	if not fxEnabled then return end
	fxEnabled = false
	debugLog(string.format("OFF reason=BothInside camDist=%.1f plyDist=%.1f", camDist, plyDist))

	-- SNAP atmosphere to exact original values — no tween, no drift
	snapAtmosphereToOriginal()

	-- Disable post-processing instantly
	if colorCorrection then colorCorrection.Enabled = false end
	if bloom then bloom.Enabled = false end
end

--[[
	Force OFF + reset all hysteresis (used on state exit, character remove, etc.).
	Also cleans up any stale character particles.
]]
local function forceReset()
	snapAtmosphereToOriginal()

	if colorCorrection then colorCorrection.Enabled = false end
	if bloom then bloom.Enabled = false end

	cleanupStaleCharacterFX()

	fxEnabled = false
	hystCameraOutside = false
	hystPlayerOutside = false
end

--[[
	Main evaluation loop — runs on RenderStepped, throttled to MinUpdateInterval.
	
	Two-trigger system:
	  1. Camera outside arena bounds (position-based, pitch-independent)
	  2. Player outside arena bounds (position-based)
	  shouldStorm = (1) OR (2)
	
	Hysteresis is a clean enter/exit band per trigger:
	  Camera: ON at +Margin, OFF at +(Margin - Hyst)
	  Player: ON at 0,       OFF at -Hyst
]]
local function onRenderStep()
	-- Throttle: skip if called faster than MinUpdateInterval
	local now = tick()
	if now - lastUpdate < StormFXConfig.MinUpdateInterval then return end
	lastUpdate = now

	-- Master switch
	if not StormFXConfig.Enabled then
		if fxEnabled then forceReset() end
		return
	end

	-- InMatch only — lobby/spectators get nothing
	local state = LocalPlayer:GetAttribute("PlayerState")
	if state ~= "InMatch" then
		if fxEnabled or hystCameraOutside or hystPlayerOutside then
			forceReset()
		end
		return
	end

	-- Refresh bounds cache periodically (walls only move on shrink)
	if now - lastBoundsRefresh >= StormFXConfig.BoundsCacheInterval then
		refreshBoundsCache()
		lastBoundsRefresh = now
	end

	if not cachedBounds then
		if fxEnabled then forceReset() end
		return
	end

	-- Compute signed distances: positive = outside bounds, negative = inside
	local camDist = getCameraOutsideDistance()
	local plyDist = getPlayerOutsideDistance()

	local margin = StormFXConfig.CameraOutsideMarginStuds
	local hyst = StormFXConfig.HysteresisStuds

	----------- HYSTERESIS: Camera outside bounds -----------
	-- ON  when camDist >= margin          (camera is 5+ studs past edge)
	-- OFF when camDist <  margin - hyst   (camera is back at edge or inside)
	if hystCameraOutside then
		if camDist < (margin - hyst) then
			hystCameraOutside = false
		end
	else
		if camDist >= margin then
			hystCameraOutside = true
		end
	end

	----------- HYSTERESIS: Player outside bounds -----------
	-- ON  when plyDist >= 0       (player just crossed outside)
	-- OFF when plyDist <  -hyst   (player is 5+ studs back inside)
	if hystPlayerOutside then
		if plyDist < -hyst then
			hystPlayerOutside = false
		end
	else
		if plyDist >= 0 then
			hystPlayerOutside = true
		end
	end

	-- Single authoritative decision
	local shouldStorm = hystCameraOutside or hystPlayerOutside

	----------- TOGGLE -----------
	if shouldStorm and not fxEnabled then
		local reasons = {}
		if hystCameraOutside then table.insert(reasons, "CameraOutside") end
		if hystPlayerOutside then table.insert(reasons, "PlayerOutside") end
		enableFX(table.concat(reasons, "+"), camDist, plyDist)
	elseif not shouldStorm and fxEnabled then
		disableFX(camDist, plyDist)
	end

	----------- PERIODIC DEBUG LOG (every ~1s, only if enabled) -----------
	if StormFXConfig.DebugTickLogs and now - lastDebugLog >= 1 then
		lastDebugLog = now
		print(string.format(
			"[StormFX:state] camDist=%.1f plyDist=%.1f hystCam=%s hystPly=%s fx=%s",
			camDist, plyDist,
			tostring(hystCameraOutside), tostring(hystPlayerOutside),
			tostring(fxEnabled)
		))
	end
end

--[[ PUBLIC API ]]

function StormFXController.Init()
	if initialized then return end

	if not StormFXConfig.Enabled then
		print("[StormFX] Disabled via config")
		return
	end

	-- Safety: clean up stale effects from previous code versions / hot-reloads
	cleanupStaleCharacterFX()
	cleanupStaleLightingFX()

	-- Find or create Atmosphere
	atmosphere = Lighting:FindFirstChildOfClass("Atmosphere")
	if atmosphere then
		origAtmoValues = {
			Density = atmosphere.Density,
			Haze = atmosphere.Haze,
			Color = atmosphere.Color,
			Decay = atmosphere.Decay,
			Offset = atmosphere.Offset,
			Glare = atmosphere.Glare,
		}
	else
		atmosphere = Instance.new("Atmosphere")
		atmosphere.Name = "StormFX_Atmosphere"
		atmosphere.Density = 0
		atmosphere.Haze = 0
		atmosphere.Offset = 0
		atmosphere.Color = Color3.fromRGB(199, 170, 107)
		atmosphere.Decay = Color3.fromRGB(92, 60, 13)
		atmosphere.Glare = 0
		atmosphere.Parent = Lighting
		origAtmoValues = {
			Density = 0,
			Haze = 0,
			Color = atmosphere.Color,
			Decay = atmosphere.Decay,
			Offset = 0,
			Glare = 0,
		}
	end

	-- Create ColorCorrection (starts disabled)
	colorCorrection = Instance.new("ColorCorrectionEffect")
	colorCorrection.Name = "StormFX_CC"
	colorCorrection.Enabled = false
	colorCorrection.TintColor = StormFXConfig.CCTintColor
	colorCorrection.Brightness = StormFXConfig.CCBrightness
	colorCorrection.Contrast = StormFXConfig.CCContrast
	colorCorrection.Saturation = StormFXConfig.CCSaturation
	colorCorrection.Parent = Lighting

	-- Create Bloom (starts disabled)
	bloom = Instance.new("BloomEffect")
	bloom.Name = "StormFX_Bloom"
	bloom.Enabled = false
	bloom.Intensity = StormFXConfig.BloomIntensity
	bloom.Size = StormFXConfig.BloomSize
	bloom.Threshold = StormFXConfig.BloomThreshold
	bloom.Parent = Lighting

	-- Evaluate on RenderStepped (throttled to MinUpdateInterval inside handler)
	renderConnection = RunService.RenderStepped:Connect(onRenderStep)

	-- Force-reset on character removed (death / respawn)
	characterRemovingConnection = LocalPlayer.CharacterRemoving:Connect(function()
		forceReset()
	end)

	initialized = true
	print(string.format(
		"[StormFX] Init — CamMargin=%d Hyst=%d Tween=%.2fs EvalHz=%.0f",
		StormFXConfig.CameraOutsideMarginStuds,
		StormFXConfig.HysteresisStuds,
		StormFXConfig.TweenDuration,
		1 / StormFXConfig.MinUpdateInterval
	))
end

function StormFXController.Destroy()
	forceReset()

	if renderConnection then
		renderConnection:Disconnect()
		renderConnection = nil
	end

	if characterRemovingConnection then
		characterRemovingConnection:Disconnect()
		characterRemovingConnection = nil
	end

	if colorCorrection then
		colorCorrection:Destroy()
		colorCorrection = nil
	end

	if bloom then
		bloom:Destroy()
		bloom = nil
	end

	if atmosphere and atmosphere.Name == "StormFX_Atmosphere" then
		atmosphere:Destroy()
	end
	atmosphere = nil
	origAtmoValues = nil

	initialized = false
	cachedBounds = nil

	print("[StormFX] Destroyed")
end

return StormFXController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="108">
          <Properties>
            <string name="Name">SwordPickupController</string>
            <string name="Source">--[[
	SwordPickupController
	Client-side hover animation + spawn announcement for sword pickups.

	Watches Workspace.SwordPickups for models with "SwordPickup" attribute.
	Animates hover + rotation identical to CoinPickupController / BrainrotPickupController.
	Shows "A SWORD HAS RANDOMLY SPAWNED" announcement + plays sound cue on remote.

	API:
		Init()
]]

local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local PlayerState = require(Shared:WaitForChild("PlayerState"))

local SwordPickupController = {}

local initialized = false

local FOLDER_NAME = "SwordPickups"
local BOB_AMPLITUDE = 0.4
local BOB_SPEED = 2.5
local ROTATION_SPEED = 25

local activeAnimations = {}

local function startAnimation(model)
	if activeAnimations[model] then return end

	local allParts = {}
	if model:IsA("BasePart") then
		if not model:GetAttribute("NoAnimate") then
			table.insert(allParts, model)
		end
	else
		for _, desc in ipairs(model:GetDescendants()) do
			if desc:IsA("BasePart") and not desc:GetAttribute("NoAnimate") then
				table.insert(allParts, desc)
			end
		end
	end

	if #allParts == 0 then return end

	local refPart = allParts[1]
	local refCF = refPart.CFrame
	local refInv = refCF:Inverse()

	local relatives = {}
	for _, part in ipairs(allParts) do
		relatives[part] = refInv * part.CFrame
	end

	local basePos = refCF.Position
	local baseTilt = refCF.Rotation

	local startTime = tick()

	local conn = RunService.Heartbeat:Connect(function()
		if not model or not model.Parent then return end

		local elapsed = tick() - startTime
		local bobY = math.sin(elapsed * BOB_SPEED) * BOB_AMPLITUDE
		local rotAngle = elapsed * ROTATION_SPEED

		local newRefCF = CFrame.new(basePos + Vector3.new(0, bobY, 0))
			* CFrame.Angles(0, math.rad(rotAngle), 0)
			* baseTilt

		for _, part in ipairs(allParts) do
			if part and part.Parent then
				part.CFrame = newRefCF * relatives[part]
			end
		end
	end)

	activeAnimations[model] = {
		connection = conn,
		startTime = startTime,
	}
end

local function stopAnimation(model)
	local anim = activeAnimations[model]
	if anim then
		if anim.connection and anim.connection.Connected then
			anim.connection:Disconnect()
		end
		activeAnimations[model] = nil
	end
end

local function onModelAdded(model)
	if not model:GetAttribute("SwordPickup") then return end
	task.defer(function()
		if model and model.Parent then
			startAnimation(model)
		end
	end)
end

local function onModelRemoved(model)
	stopAnimation(model)
end

local function watchFolder(folder)
	for _, child in ipairs(folder:GetChildren()) do
		onModelAdded(child)
	end
	folder.ChildAdded:Connect(onModelAdded)
	folder.ChildRemoved:Connect(onModelRemoved)
end

local function showAnnouncement(data)
	local player = Players.LocalPlayer
	local playerGui = player:FindFirstChild("PlayerGui")
	if not playerGui then return end

	local sound = Instance.new("Sound")
	sound.SoundId = data.soundId or ""
	sound.Volume = 0.4
	sound.PlayOnRemove = false
	sound.Parent = playerGui
	sound:Play()
	task.delay(5, function()
		if sound and sound.Parent then sound:Destroy() end
	end)

	local sg = Instance.new("ScreenGui")
	sg.Name = "SwordAnnouncement"
	sg.ResetOnSpawn = false
	sg.DisplayOrder = 50
	sg.IgnoreGuiInset = true
	sg.Parent = playerGui

	local label = Instance.new("TextLabel")
	label.Name = "AnnouncementLabel"
	label.Size = UDim2.new(1, 0, 0, 40)
	label.Position = UDim2.new(0.5, 0, 0, 150)
	label.AnchorPoint = Vector2.new(0.5, 0)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBold
	label.TextSize = 22
	label.TextColor3 = Color3.fromRGB(255, 80, 80)
	label.TextStrokeColor3 = Color3.fromRGB(50, 0, 0)
	label.TextStrokeTransparency = 0.3
	label.Text = "A SWORD HAS RANDOMLY SPAWNED"
	label.TextTransparency = 0
	label.Parent = sg

	task.delay(2, function()
		if not label or not label.Parent then return end
		local tween = TweenService:Create(
			label,
			TweenInfo.new(1, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
			{ TextTransparency = 1, TextStrokeTransparency = 1 }
		)
		tween:Play()
		tween.Completed:Wait()
		if sg and sg.Parent then sg:Destroy() end
	end)
end

local function isLocalPlayerInMatch(): boolean
	return Players.LocalPlayer:GetAttribute("PlayerState") == PlayerState.States.InMatch
end

local function showDeniedMessage()
	local player = Players.LocalPlayer
	local playerGui = player:FindFirstChild("PlayerGui")
	if not playerGui then return end

	local sg = Instance.new("ScreenGui")
	sg.Name = "SwordDenied"
	sg.ResetOnSpawn = false
	sg.DisplayOrder = 50
	sg.IgnoreGuiInset = true
	sg.Parent = playerGui

	local lbl = Instance.new("TextLabel")
	lbl.Name = "DeniedLabel"
	lbl.Size = UDim2.new(1, 0, 0, 30)
	lbl.Position = UDim2.new(0.5, 0, 0, 150)
	lbl.AnchorPoint = Vector2.new(0.5, 0)
	lbl.BackgroundTransparency = 1
	lbl.Font = Enum.Font.GothamBold
	lbl.TextSize = 16
	lbl.TextColor3 = Color3.fromRGB(255, 200, 80)
	lbl.TextStrokeColor3 = Color3.fromRGB(50, 30, 0)
	lbl.TextStrokeTransparency = 0.3
	lbl.Text = "You already have a sword!"
	lbl.Parent = sg

	task.delay(1.5, function()
		if not lbl or not lbl.Parent then return end
		local tween = TweenService:Create(
			lbl,
			TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
			{ TextTransparency = 1, TextStrokeTransparency = 1 }
		)
		tween:Play()
		tween.Completed:Wait()
		if sg and sg.Parent then sg:Destroy() end
	end)
end

function SwordPickupController.Init()
	if initialized then return end
	initialized = true

	task.spawn(function()
		local folder = Workspace:FindFirstChild(FOLDER_NAME)
		if folder then
			watchFolder(folder)
		end

		Workspace.ChildAdded:Connect(function(child)
			if child.Name == FOLDER_NAME and child:IsA("Folder") then
				watchFolder(child)
			end
		end)
	end)

	task.spawn(function()
		local remotes = ReplicatedStorage:WaitForChild("Remotes", 15)
		if not remotes then return end
		local remote = remotes:WaitForChild("SwordSpawned", 15)
		if not remote then return end

		remote.OnClientEvent:Connect(function(data)
			if type(data) == "table" then
				if data.denied then
					showDeniedMessage()
				else
					if data.matchOnly and not isLocalPlayerInMatch() then
						return
					end
					showAnnouncement(data)
				end
			end
		end)
	end)

	print("[SwordPickupController] Initialized")
end

return SwordPickupController</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="109">
          <Properties>
            <string name="Name">TungTungSahurController</string>
            <string name="Source"><![CDATA[--[[
	TungTungSahurController
	Client-side UI for TungTungSahur hazard.

	Styled to match sword announcement exactly:
	  - IgnoreGuiInset = true (absolute screen coordinates)
	  - No box/pill backgrounds — plain text only
	  - Font GothamBold, TextSize 22, red #FF5050 + dark stroke

	Layout (absolute Y from screen top, IgnoreGuiInset=true):
	  Y=8:   TTS countdown text  (ABOVE round badge ~Y52)
	  Y=150: Sword announcement  (unchanged, this script does NOT touch it)
	  Y=195: TTS spawn text      (BELOW sword, no overlap)

	Survival text: center-screen, text-only, green — no box.

	Remote events received from TungTungSahurEvent:
	  "Spawn",   durationSeconds        -> show banner + start countdown
	  "Despawn", showSurvival:boolean   -> hide UI; if true + player alive -> popup
]]

local Players           = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService      = game:GetService("TweenService")
local Shared            = ReplicatedStorage:WaitForChild("Shared")
local PlayerState       = require(Shared:WaitForChild("PlayerState"))

local ANNOUNCEMENT_HOLD      = 3.0    -- seconds banner stays solid
local FADE_TIME              = 0.35
local STACK_DISPLAY_ORDER    = 85
local SURVIVAL_DISPLAY_ORDER = 90

-- Absolute Y positions (IgnoreGuiInset = true)
local TIMER_Y    = 8    -- above round badge (~Y52 absolute)
local ANNOUNCE_Y = 195  -- below sword (sword: Y150, height 40 → bottom at Y190)

-- Sword-matching text style
local TEXT_COLOR   = Color3.fromRGB(255, 80, 80)
local STROKE_COLOR = Color3.fromRGB(50, 0, 0)
local TEXT_FONT    = Enum.Font.GothamBold
local TEXT_SIZE    = 22

-- --- STATE -------------------------------------------------------------------
local localPlayer              = Players.LocalPlayer
local stackGui: ScreenGui?     = nil
local countdownLabel: TextLabel? = nil
local announceLabel: TextLabel?  = nil
local survivalGui: ScreenGui?  = nil
local survivalLabel: TextLabel?  = nil

local countdownThread: thread? = nil
local announceThread: thread?  = nil

local TungTungSahurController = {}

-- --- HELPERS -----------------------------------------------------------------

local function cancelThread(t: thread?)
	if t then pcall(task.cancel, t) end
end

local function checkDisableGui()
	if countdownLabel and countdownLabel.Visible then return end
	if announceLabel  and announceLabel.Visible  then return end
	if stackGui then stackGui.Enabled = false end
end

local function makeSwordLabel(parent: Instance, text: string, yPos: number): TextLabel
	local lbl = Instance.new("TextLabel")
	lbl.Name                   = "TTSLabel"
	lbl.Size                   = UDim2.new(1, 0, 0, 28)
	lbl.Position               = UDim2.new(0.5, 0, 0, yPos)
	lbl.AnchorPoint            = Vector2.new(0.5, 0)
	lbl.BackgroundTransparency = 1
	lbl.Font                   = TEXT_FONT
	lbl.Text                   = text
	lbl.TextColor3             = TEXT_COLOR
	lbl.TextSize               = TEXT_SIZE
	lbl.TextScaled             = false
	lbl.TextXAlignment         = Enum.TextXAlignment.Center
	lbl.TextTransparency       = 1  -- hidden until shown
	lbl.Visible                = false
	lbl.Parent                 = parent

	local stroke = Instance.new("UIStroke")
	stroke.Color          = STROKE_COLOR
	stroke.Thickness      = 2
	stroke.Transparency   = 1  -- synced with TextTransparency
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
	stroke.Parent         = lbl

	return lbl
end

local function showLabel(lbl: TextLabel?)
	if not lbl then return end
	lbl.Visible = true
	lbl.TextTransparency = 0
	local s = lbl:FindFirstChildOfClass("UIStroke")
	if s then s.Transparency = 0.3 end
end

local function hideLabel(lbl: TextLabel?)
	if not lbl then return end
	lbl.Visible = false
end

local function fadeOutLabel(lbl: TextLabel?, onDone: (() -> ())?)
	if not lbl then if onDone then onDone() end return end
	local info = TweenInfo.new(FADE_TIME, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	TweenService:Create(lbl, info, { TextTransparency = 1 }):Play()
	local s = lbl:FindFirstChildOfClass("UIStroke")
	if s then TweenService:Create(s, info, { Transparency = 1 }):Play() end
	task.delay(FADE_TIME + 0.05, function()
		lbl.Visible = false
		if onDone then onDone() end
	end)
end

-- --- GUI BUILD ---------------------------------------------------------------

local function buildStackGui()
	local playerGui = localPlayer:WaitForChild("PlayerGui", 10)
	if not playerGui then return end

	local old = playerGui:FindFirstChild("TungTungStatusStack")
	if old then old:Destroy() end

	stackGui = Instance.new("ScreenGui")
	stackGui.Name           = "TungTungStatusStack"
	stackGui.ResetOnSpawn   = false
	stackGui.DisplayOrder   = STACK_DISPLAY_ORDER
	stackGui.IgnoreGuiInset = true   -- absolute coords, same as sword announcement
	stackGui.Enabled        = false
	stackGui.Parent         = playerGui

	countdownLabel = makeSwordLabel(stackGui, "TUNGTUNGSAHUR: 30", TIMER_Y)
	countdownLabel.Name = "CountdownText"

	announceLabel = makeSwordLabel(stackGui, "TUNGTUNGSAHUR HAS SPAWNED", ANNOUNCE_Y)
	announceLabel.Name = "AnnounceText"

	print("[TTS UI] TopCenterStack mounted -- TimerY=" .. TIMER_Y
		.. " AnnounceY=" .. ANNOUNCE_Y .. " IgnoreGuiInset=true (no boxes)")
end

local function buildSurvivalGui()
	local playerGui = localPlayer:WaitForChild("PlayerGui", 10)
	if not playerGui then return end

	local old = playerGui:FindFirstChild("TungTungSurvivalGui")
	if old then old:Destroy() end

	survivalGui = Instance.new("ScreenGui")
	survivalGui.Name           = "TungTungSurvivalGui"
	survivalGui.ResetOnSpawn   = false
	survivalGui.DisplayOrder   = SURVIVAL_DISPLAY_ORDER
	survivalGui.IgnoreGuiInset = true
	survivalGui.Enabled        = false
	survivalGui.Parent         = playerGui

	-- Text-only survival message, no background box
	survivalLabel = Instance.new("TextLabel")
	survivalLabel.Name                   = "SurvivalText"
	survivalLabel.AnchorPoint            = Vector2.new(0.5, 0.5)
	survivalLabel.Position               = UDim2.new(0.5, 0, 0.45, 0)
	survivalLabel.Size                   = UDim2.new(0.9, 0, 0, 34)
	survivalLabel.BackgroundTransparency = 1
	survivalLabel.Font                   = Enum.Font.GothamBold
	survivalLabel.Text                   = "YOU HAVE SURVIVED TUNGTUNGSAHUR!"
	survivalLabel.TextColor3             = Color3.fromRGB(80, 255, 80)
	survivalLabel.TextSize               = 22
	survivalLabel.TextScaled             = false
	survivalLabel.TextWrapped            = true
	survivalLabel.TextXAlignment         = Enum.TextXAlignment.Center
	survivalLabel.TextTransparency       = 1
	survivalLabel.Parent                 = survivalGui

	local stroke = Instance.new("UIStroke")
	stroke.Color          = Color3.fromRGB(0, 50, 0)
	stroke.Thickness      = 2
	stroke.Transparency   = 1
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
	stroke.Parent         = survivalLabel
end

-- --- SHOW / HIDE -------------------------------------------------------------

local function showCountdown()
	if stackGui then stackGui.Enabled = true end
	showLabel(countdownLabel)
end

local function hideCountdown()
	hideLabel(countdownLabel)
	checkDisableGui()
end

local function showAnnounce()
	if stackGui then stackGui.Enabled = true end
	showLabel(announceLabel)
end

local function hideAnnounce()
	hideLabel(announceLabel)
	checkDisableGui()
end

local function startCountdown(duration: number)
	hideCountdown()
	cancelThread(countdownThread)
	if not countdownLabel then return end

	showCountdown()

	countdownThread = task.spawn(function()
		local startTime = tick()
		while true do
			local elapsed   = tick() - startTime
			local remaining = math.max(0, math.ceil(duration - elapsed))
			if countdownLabel then
				countdownLabel.Text = string.format("TUNGTUNGSAHUR: %d", remaining)
			end
			if remaining <= 0 then
				hideCountdown()
				countdownThread = nil
				return
			end
			task.wait(0.25)
		end
	end)
end

local function runShowAnnouncement()
	cancelThread(announceThread)
	if not announceLabel then return end

	showAnnounce()

	announceThread = task.spawn(function()
		task.wait(ANNOUNCEMENT_HOLD)
		fadeOutLabel(announceLabel, function()
			hideAnnounce()
			announceThread = nil
		end)
	end)
end

local function showSurvivalPopup()
	if not survivalGui or not survivalLabel then return end

	local char = localPlayer.Character
	if char then
		local hum = char:FindFirstChildOfClass("Humanoid")
		if not hum or hum.Health <= 0 then return end
	end

	survivalGui.Enabled = true
	survivalLabel.TextTransparency = 1
	local stroke = survivalLabel:FindFirstChildOfClass("UIStroke")
	if stroke then stroke.Transparency = 1 end

	local inInfo = TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	TweenService:Create(survivalLabel, inInfo, { TextTransparency = 0 }):Play()
	if stroke then TweenService:Create(stroke, inInfo, { Transparency = 0.3 }):Play() end

	task.delay(3.5, function()
		if not survivalGui or not survivalGui.Parent then return end
		local outInfo = TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		TweenService:Create(survivalLabel, outInfo, { TextTransparency = 1 }):Play()
		if stroke then TweenService:Create(stroke, outInfo, { Transparency = 1 }):Play() end
		task.wait(0.6)
		survivalGui.Enabled = false
	end)
end

local function onDespawn(showSurvival: boolean)
	cancelThread(countdownThread)
	cancelThread(announceThread)
	countdownThread = nil
	announceThread  = nil
	hideCountdown()
	hideAnnounce()
	if stackGui then stackGui.Enabled = false end

	if showSurvival then
		showSurvivalPopup()
	end
end

local function isLocalPlayerInMatch(): boolean
	return localPlayer:GetAttribute("PlayerState") == PlayerState.States.InMatch
end

-- --- INIT --------------------------------------------------------------------

function TungTungSahurController.Init()
	buildStackGui()
	buildSurvivalGui()

	local remotes = ReplicatedStorage:WaitForChild("Remotes", 10)
	if not remotes then
		warn("[TungTungSahurController] Remotes folder not found")
		return
	end

	local remote = remotes:WaitForChild("TungTungSahurEvent", 10)
	if not remote then
		warn("[TungTungSahurController] TungTungSahurEvent remote not found")
		return
	end

	remote.OnClientEvent:Connect(function(action: string, extraArg)
		if action == "Spawn" then
			if not isLocalPlayerInMatch() then
				return
			end
			local dur = (type(extraArg) == "number") and extraArg or 30
			runShowAnnouncement()
			startCountdown(dur)
		elseif action == "Despawn" then
			if not isLocalPlayerInMatch() then
				onDespawn(false)
				return
			end
			local showSurvival = extraArg == true
			onDespawn(showSurvival)
		end
	end)

	-- Safety: if local player leaves InMatch (results/lobby transition), force-hide any
	-- lingering TTS UI immediately even if a despawn packet was missed.
	localPlayer:GetAttributeChangedSignal("PlayerState"):Connect(function()
		if not isLocalPlayerInMatch() then
			onDespawn(false)
		end
	end)
end

return TungTungSahurController
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="110">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="ModuleScript" referent="111">
            <Properties>
              <string name="Name">AnimUtil</string>
              <string name="Source"><![CDATA[--[[
	AnimUtil
	Reusable tween / animation helpers for the UI system.

	Every visual interaction (open, close, hover, click, bump) is
	funnelled through this module so timing and easing stay consistent.

	RULES:
	  • NEVER use Tween:Wait() — always use tween.Completed:Wait()
	  • Returns tweens so callers can yield if needed

	POLISH:
	  • WireButton now includes BackgroundColor3 brightness feedback:
	    hover = brighten 12% toward white, press = darken 10% toward black.
	    Transparent buttons (BackgroundTransparency > 0.9) are skipped.

	Used by: HUDPanel, ShopPanel, FateCrownsPanel, PetsPanel,
	         CrateShopPanel, IndexPanel, Components
]]

local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local UIConfig = require(Shared:WaitForChild("UIConfig"))

local cfg = UIConfig.Anim

-- Lazy-loaded reference to SoundUtil (avoids circular dependency)
local _SoundUtil = nil
local function getSoundUtil()
	if not _SoundUtil then
		local ok, mod = pcall(function()
			return require(script.Parent:WaitForChild("SoundUtil", 2))
		end)
		if ok then _SoundUtil = mod end
	end
	return _SoundUtil
end

local AnimUtil = {}

-- ───────────────────────────────────────────────
-- CORE TWEEN
-- ───────────────────────────────────────────────

--[[
	Generic tween wrapper.  Returns the Tween so callers can
	yield on it via tween.Completed:Wait().
]]
function AnimUtil.Tween(
	instance: Instance,
	props: { [string]: any },
	duration: number,
	style: Enum.EasingStyle?,
	direction: Enum.EasingDirection?
): Tween
	style = style or Enum.EasingStyle.Quad
	direction = direction or Enum.EasingDirection.Out
	local info = TweenInfo.new(duration, style, direction)
	local tween = TweenService:Create(instance, info, props)
	tween:Play()
	return tween
end

-- ───────────────────────────────────────────────
-- PANEL OPEN / CLOSE
-- ───────────────────────────────────────────────

--[[
	Animate a panel open.
	`canvas`  – the CanvasGroup (or Frame) root of the panel
	`uiScale` – UIScale child used for the scale pop effect
]]
function AnimUtil.OpenPanel(canvas: CanvasGroup, uiScale: UIScale)
	-- Starting state
	canvas.GroupTransparency = 1
	uiScale.Scale = cfg.OpenStartScale
	canvas.Visible = true

	-- Tween in (fade + scale)
	AnimUtil.Tween(canvas, { GroupTransparency = 0 }, cfg.OpenDuration, Enum.EasingStyle.Quad)
	AnimUtil.Tween(uiScale, { Scale = 1 }, cfg.OpenDuration, cfg.OpenEase)
end

--[[
	Animate a panel closed.  Returns the closing tween so the caller can
	yield via tween.Completed:Wait() before setting Visible = false.
]]
function AnimUtil.ClosePanel(canvas: CanvasGroup, uiScale: UIScale): Tween
	AnimUtil.Tween(uiScale, { Scale = cfg.OpenStartScale }, cfg.CloseDuration, cfg.CloseEase, Enum.EasingDirection.In)
	local t = AnimUtil.Tween(canvas, { GroupTransparency = 1 }, cfg.CloseDuration, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	return t
end

-- ───────────────────────────────────────────────
-- BUTTON EFFECTS  (hover, click, hover SFX, color feedback)
-- ───────────────────────────────────────────────

--[[
	Call once per button to wire up hover + click animations + hover sound
	+ BackgroundColor3 brightness feedback.
	`btn` – any GuiButton
	`onClick` – optional callback fired after click animation
]]
function AnimUtil.WireButton(btn: GuiButton, onClick: (() -> ())?)
	-- Ensure a UIScale exists for animation
	local scale = btn:FindFirstChildOfClass("UIScale")
	if not scale then
		scale = Instance.new("UIScale")
		scale.Parent = btn
	end

	-- Skip color changes for transparent buttons (overlays, invisible hit areas)
	local skipColor = btn.BackgroundTransparency > 0.9

	-- IMPORTANT:
	-- Buttons like toggles/tabs change BackgroundColor3 over time.
	-- So we must not cache "origColor" once, otherwise MouseLeave snaps
	-- back to the wrong state color.
	local baseColor = btn.BackgroundColor3
	local hoverColor = baseColor
	local pressColor = baseColor

	local function recomputeColors()
		baseColor = btn.BackgroundColor3
		hoverColor = baseColor:Lerp(Color3.new(1, 1, 1), 0.12)
		pressColor = baseColor:Lerp(Color3.new(0, 0, 0), 0.10)
	end

	recomputeColors()

	btn.MouseEnter:Connect(function()
		AnimUtil.Tween(scale, { Scale = cfg.HoverScale }, cfg.HoverDuration, cfg.BtnEase)
		if not skipColor then
			recomputeColors()
			AnimUtil.Tween(btn, { BackgroundColor3 = hoverColor }, cfg.HoverDuration, cfg.BtnEase)
		end
		local su = getSoundUtil()
		if su then su.Hover() end
	end)

	btn.MouseLeave:Connect(function()
		AnimUtil.Tween(scale, { Scale = 1 }, cfg.HoverDuration, cfg.BtnEase)
		if not skipColor then
			-- Restore to the current "base" color for this interaction.
			AnimUtil.Tween(btn, { BackgroundColor3 = baseColor }, cfg.HoverDuration, cfg.BtnEase)
		end
	end)

	btn.MouseButton1Down:Connect(function()
		AnimUtil.Tween(scale, { Scale = cfg.ClickScale }, cfg.ClickDuration, cfg.BtnEase, Enum.EasingDirection.Out)
		if not skipColor then
			recomputeColors()
			AnimUtil.Tween(btn, { BackgroundColor3 = pressColor }, cfg.ClickDuration, cfg.BtnEase)
		end
	end)

	btn.MouseButton1Up:Connect(function()
		AnimUtil.Tween(scale, { Scale = cfg.HoverScale }, cfg.BounceDuration, Enum.EasingStyle.Back)
		if not skipColor then
			-- Defer so if the click handler changes BackgroundColor3 (tabs/toggles),
			-- we recompute from the NEW state color and don't snap back.
			task.defer(function()
				if not btn or not btn.Parent then return end
				recomputeColors()
				AnimUtil.Tween(btn, { BackgroundColor3 = hoverColor }, cfg.BounceDuration, Enum.EasingStyle.Back)
			end)
		end
	end)

	if onClick then
		btn.MouseButton1Click:Connect(onClick)
	end
end

-- ───────────────────────────────────────────────
-- MODAL POPUP OPEN / CLOSE  (Brainrot-style)
-- ───────────────────────────────────────────────

--[[
	Animate a modal popup card open via UIScale.
	Creates a UIScale child if one doesn't already exist.
	Returns the UIScale instance for callers that need it later.

	The card's AnchorPoint + Position must already be set before calling.
]]
function AnimUtil.PopupOpen(card: GuiObject): UIScale
	local sc = card:FindFirstChildOfClass("UIScale")
	if not sc then
		sc = Instance.new("UIScale")
		sc.Parent = card
	end
	sc.Scale = cfg.PopupOpenStartScale
	AnimUtil.Tween(sc, { Scale = 1 }, cfg.PopupOpenDuration, cfg.PopupOpenEase, Enum.EasingDirection.Out)
	return sc
end

--[[
	Animate a modal popup card closed, then destroy the given container
	(usually the overlay ScreenGui/Frame that holds the card).
	`container` – the instance to :Destroy() after the tween; pass nil to skip.

	Scales down subtly (0.9) instead of shrinking to zero, avoiding jank.
	Position is never touched — stays locked at AnchorPoint center.
]]
function AnimUtil.PopupClose(card: GuiObject, container: Instance?)
	local sc = card:FindFirstChildOfClass("UIScale")
	if sc then
		local tween = AnimUtil.Tween(sc, { Scale = cfg.PopupCloseTargetScale }, cfg.PopupCloseDuration, cfg.PopupCloseEase, Enum.EasingDirection.In)
		AnimUtil.Tween(card, { BackgroundTransparency = 1 }, cfg.PopupCloseDuration, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		task.spawn(function()
			tween.Completed:Wait()
			card.Visible = false
			if container and container.Parent then container:Destroy() end
		end)
	elseif container then
		task.delay(cfg.PopupDestroyDelay, function()
			if container and container.Parent then container:Destroy() end
		end)
	end
end

-- ───────────────────────────────────────────────
-- UTILITY ANIMATIONS
-- ───────────────────────────────────────────────

--[[
	Quick scale "bump" (e.g. coin counter update).
	Scales up then back to a caller-defined rest scale.
]]
function AnimUtil.Bump(uiScale: UIScale, peakScale: number?, duration: number?, restScale: number?)
	peakScale = peakScale or cfg.CoinBumpScale
	duration = duration or cfg.CoinBumpDuration
	restScale = restScale or 1

	local half = duration * 0.4
	local t = AnimUtil.Tween(uiScale, { Scale = peakScale }, half, Enum.EasingStyle.Back)
	task.spawn(function()
		t.Completed:Wait()
		AnimUtil.Tween(uiScale, { Scale = restScale }, duration - half, Enum.EasingStyle.Quad)
	end)
end

--[[
	Fade-slide in a frame from an offset (e.g. round badge).
	`frame` – target frame
	`finalPos` – final UDim2 position
	`offsetY` – starting Y offset in pixels
]]
function AnimUtil.SlideIn(frame: GuiObject, finalPos: UDim2, offsetY: number?)
	offsetY = offsetY or -30
	frame.Position = UDim2.new(finalPos.X.Scale, finalPos.X.Offset, finalPos.Y.Scale, finalPos.Y.Offset + offsetY)
	AnimUtil.Tween(frame, { Position = finalPos }, cfg.RoundSlideDuration, Enum.EasingStyle.Back)
end

--[[
	Smooth frame appear (scale + fade for intermission UI etc.)
]]
function AnimUtil.PopIn(frame: GuiObject, uiScale: UIScale?)
	if uiScale then
		uiScale.Scale = 0.85
		AnimUtil.Tween(uiScale, { Scale = 1 }, 0.35, Enum.EasingStyle.Back)
	end
	if frame:IsA("CanvasGroup") then
		frame.GroupTransparency = 1
		AnimUtil.Tween(frame, { GroupTransparency = 0 }, 0.25, Enum.EasingStyle.Quad)
	end
	frame.Visible = true
end

function AnimUtil.PopOut(frame: GuiObject, uiScale: UIScale?): Tween?
	if uiScale then
		AnimUtil.Tween(uiScale, { Scale = 0.85 }, 0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	end
	if frame:IsA("CanvasGroup") then
		return AnimUtil.Tween(frame, { GroupTransparency = 1 }, 0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	end
	return nil
end

return AnimUtil
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="112">
            <Properties>
              <string name="Name">BundlePanel</string>
              <string name="Source">--[[
	BundlePanel
	Hero-style bundle content rendered INSIDE ShopPanel's content area.

	Not a standalone panel — populates into a parent ScrollingFrame when
	the Bundles tab is selected, and clears itself when another tab is chosen.
	This keeps the ShopPanel tab bar visible and clickable at all times.

	Layout:
	  * Left 68%: Hero cover art + title overlay + View/Buy buttons
	  * Right 30%: Vertical selector strip listing all bundles
	  * Detail View: Replaces hero area with item grid on "View" click

	Data-driven via BundleCatalog — supports future bundles automatically.

	API:
	  BundlePanel.Init()                    — no-op (modules loaded at require time)
	  BundlePanel.PopulateInto(parent)      — build bundle UI inside parent
	  BundlePanel.ClearContent()            — destroy bundle UI, restore parent
	  BundlePanel.Show/Hide/IsVisible/Toggle — stubs for compatibility
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ContentProvider = game:GetService("ContentProvider")
local HttpService = game:GetService("HttpService")

local STUB = {
	Init = function() end,
	PopulateInto = function() end,
	ClearContent = function() end,
	Show = function() end,
	Hide = function() end,
	IsVisible = function() return false end,
	Toggle = function() end,
}

local Shared = ReplicatedStorage:WaitForChild("Shared", 60)
if not Shared then
	warn("[BundlePanel] Shared not found after 60s -- disabled")
	return STUB
end

local CDPModule = Shared:WaitForChild("ClientDepsProvider", 60)
if not CDPModule then
	warn("[BundlePanel] ClientDepsProvider MISSING")
	return STUB
end

local ok, Deps = pcall(require, CDPModule)
if not ok or not Deps then
	warn("[BundlePanel] require(ClientDepsProvider) FAILED:", Deps)
	return STUB
end

local UIConfig = Deps.UIConfig
local ItemCatalog = Deps.ItemCatalog

local BundleCatalogModule = Shared:WaitForChild("BundleCatalog", 10)
if not BundleCatalogModule then
	warn("[BundlePanel] BundleCatalog not found in Shared")
	return STUB
end
local BundleCatalog = require(BundleCatalogModule)

local ItemModelRegistryModule = Shared:WaitForChild("ItemModelRegistry", 10)
local ItemModelRegistry = ItemModelRegistryModule and require(ItemModelRegistryModule) or nil

local Client = script.Parent
local AnimUtil   = require(Client:WaitForChild("AnimUtil"))
local SoundUtil  = require(Client:WaitForChild("SoundUtil"))
local Components = require(Client:WaitForChild("Components"))

local C = UIConfig.Colors
local S = UIConfig.Sizes

local LocalPlayer = Players.LocalPlayer
local COIN_BUNDLE_REQUEST_IDS: { [string]: string } = {
	fnaf_pets_bundle = "fnaf_all",
	brainrot_bundle = "brainrot_all",
}
local FNAF_BUNDLE_ID = "fnaf_pets_bundle"
local BRAINROT_BUNDLE_ID = "brainrot_bundle"
local FNAF_ITEM_PRICE = 70000
local BRAINROT_ITEM_PRICE = 75000
local COIN_BUNDLE_BASE_COST = 150000
local COIN_BUNDLE_PER_OWNED_DISCOUNT = 0.10

local ACCENT_COLOR   = Color3.fromRGB(245, 48, 72)
local SELECTED_GLOW  = Color3.fromRGB(255, 210, 50)
local BG_DARK        = Color3.fromRGB(22, 24, 42)
local BG_LIGHTER     = Color3.fromRGB(36, 40, 64)
local COVER_BG       = Color3.fromRGB(10, 12, 24)
local STRIP_BG       = Color3.fromRGB(18, 20, 38)
local ENTRY_SELECTED = Color3.fromRGB(44, 48, 78)

local contentParent: ScrollingFrame? = nil
local bundleContainer: Frame? = nil
local selectedBundleId: string = ""
local _bundleOwnedLocal: { [string]: boolean } = {}
local inDetailView = false

local coverImage: ImageLabel? = nil
local fnafCreditLabel: TextLabel? = nil
local titleLabel: TextLabel? = nil
local viewBtn: TextButton? = nil
local buyBtn: TextButton? = nil
local heroFrame: Frame? = nil
local detailFrame: Frame? = nil
local selectorStrip: ScrollingFrame? = nil
local selectorEntries: { [string]: Frame } = {}

local previewOverlay: Frame? = nil
local previewRotConn: RBXScriptConnection? = nil
local externalPreviewHost: Instance? = nil
local panelOptions: {[string]: any}? = nil

local function getOwnedSetFromAttribute(attributeName: string): { [string]: boolean }
	local raw = LocalPlayer:GetAttribute(attributeName)
	if type(raw) ~= "string" or raw == "" then
		return {}
	end
	local okDecode, list = pcall(HttpService.JSONDecode, HttpService, raw)
	if not okDecode or type(list) ~= "table" then
		return {}
	end
	local set = {}
	for _, id in ipairs(list) do
		if type(id) == "string" then
			set[id] = true
		end
	end
	return set
end

local function getOwnedSetForCategory(category: string): { [string]: boolean }
	if category == "Pets" then
		return getOwnedSetFromAttribute("OwnedPets")
	elseif category == "Crowns" then
		return getOwnedSetFromAttribute("OwnedCrowns")
	elseif category == "IconImages" then
		return getOwnedSetFromAttribute("OwnedIconImages")
	end
	return {}
end

local function getCoinBundleState(bundle): { totalCount: number, ownedCount: number, missingCount: number, finalCost: number, coins: number }
	local totalCount = 0
	local ownedCount = 0
	local ownedByCategory: { [string]: { [string]: boolean } } = {}

	for _, inc in ipairs(bundle.includes or {}) do
		if inc.category and inc.itemId and COIN_BUNDLE_REQUEST_IDS[bundle.id] then
			if not ownedByCategory[inc.category] then
				ownedByCategory[inc.category] = getOwnedSetForCategory(inc.category)
			end
			totalCount += 1
			if ownedByCategory[inc.category][inc.itemId] == true then
				ownedCount += 1
			end
		end
	end

	local missingCount = math.max(0, totalCount - ownedCount)
	local finalCost = math.floor(COIN_BUNDLE_BASE_COST * (1 - (ownedCount * COIN_BUNDLE_PER_OWNED_DISCOUNT)))
	finalCost = math.max(0, finalCost)
	local coins = tonumber(LocalPlayer:GetAttribute("Coins")) or 0

	return {
		totalCount = totalCount,
		ownedCount = ownedCount,
		missingCount = missingCount,
		finalCost = math.max(0, math.floor(finalCost)),
		coins = math.max(0, math.floor(coins)),
	}
end

local function getBundlesForPanel()
	local bundles = BundleCatalog.GetAll()
	if not panelOptions or not panelOptions.bundleIds then
		return bundles
	end
	local allow = {}
	for _, id in ipairs(panelOptions.bundleIds) do
		allow[id] = true
	end
	local filtered = {}
	for _, bundle in ipairs(bundles) do
		if allow[bundle.id] then
			table.insert(filtered, bundle)
		end
	end
	return filtered
end

local function createStyledButton(parent: Instance, text: string, color: Color3, size: UDim2, position: UDim2): TextButton
	local btn = Instance.new("TextButton")
	btn.Name = text:gsub("%s", "") .. "Btn"
	btn.Size = size
	btn.Position = position
	btn.BackgroundColor3 = color
	btn.Font = Enum.Font.GothamBold
	btn.TextColor3 = Color3.fromRGB(255, 255, 255)
	btn.TextTransparency = 0
	btn.TextSize = 18
	btn.Text = text
	btn.BorderSizePixel = 0
	btn.AutoButtonColor = false
	btn.ZIndex = 8
	btn.Parent = parent

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 8)
	corner.Parent = btn

	local borderStroke = Instance.new("UIStroke")
	borderStroke.Color = Color3.fromRGB(255, 255, 255)
	borderStroke.Thickness = 1.5
	borderStroke.Transparency = 0.35
	borderStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	borderStroke.Parent = btn

	local textStroke = Instance.new("UIStroke")
	textStroke.Color = Color3.fromRGB(0, 0, 0)
	textStroke.Thickness = 2
	textStroke.Transparency = 0.05
	textStroke.Parent = btn

	return btn
end

local function updateSelectorHighlight()
	for id, entry in pairs(selectorEntries) do
		local entryStroke = entry:FindFirstChildOfClass("UIStroke")
		if id == selectedBundleId then
			if entryStroke then
				entryStroke.Color = SELECTED_GLOW
				entryStroke.Thickness = 2.5
				entryStroke.Transparency = 0
			end
			entry.BackgroundColor3 = ENTRY_SELECTED
		else
			if entryStroke then
				entryStroke.Color = C.CardStroke
				entryStroke.Thickness = 1.5
				entryStroke.Transparency = 0.3
			end
			entry.BackgroundColor3 = C.CardBg
		end
	end
end

local function selectBundle(bundleId: string)
	local bundle = BundleCatalog.Get(bundleId)
	if not bundle then return end

	selectedBundleId = bundleId

	if coverImage then
		if bundle.coverImage and bundle.coverImage ~= "" then
			coverImage.Image = bundle.coverImage
			coverImage.Visible = true
		else
			coverImage.Image = ""
			coverImage.Visible = false
		end
	end

	if fnafCreditLabel then
		fnafCreditLabel.Visible = (bundle.id == FNAF_BUNDLE_ID) and (coverImage and coverImage.Visible == true)
	end

	if titleLabel then
		titleLabel.Text = bundle.displayName
	end

	if buyBtn then
		local isCoinBundle = COIN_BUNDLE_REQUEST_IDS[bundle.id] ~= nil
		local isOwned = _bundleOwnedLocal[bundle.id] == true
		if bundle.gamepassId and not isCoinBundle then
			local okChk, ownsChk = pcall(function()
				return MarketplaceService:UserOwnsGamePassAsync(LocalPlayer.UserId, bundle.gamepassId)
			end)
			isOwned = okChk and ownsChk == true
		end

		if isOwned then
			buyBtn.Text = "OWNED"
			buyBtn.BackgroundColor3 = C.DisabledBtn
			buyBtn.Active = false
		elseif not bundle.isAvailable then
			buyBtn.Text = "COMING SOON"
			buyBtn.BackgroundColor3 = C.DisabledBtn
			buyBtn.Active = false
		else
			if isCoinBundle then
				local state = getCoinBundleState(bundle)
				if state.missingCount &lt;= 0 then
					buyBtn.Text = "OWNED"
					buyBtn.BackgroundColor3 = C.DisabledBtn
					buyBtn.Active = false
				elseif bundle.id ~= BRAINROT_BUNDLE_ID and state.coins &lt; state.finalCost then
					buyBtn.Text = "GET MORE FATE COINS"
					buyBtn.BackgroundColor3 = Color3.fromRGB(255, 170, 55)
					buyBtn.Active = true
				else
					buyBtn.Text = string.format("BUY - %d F", state.finalCost)
					buyBtn.BackgroundColor3 = Color3.fromRGB(255, 200, 30)
					buyBtn.Active = true
				end
			else
				buyBtn.Text = string.format("BUY - %d ROBUX", bundle.priceRobux)
				buyBtn.BackgroundColor3 = C.BuyButton
				buyBtn.Active = true
			end
		end
	end

	if viewBtn then
		local canView = bundle.isAvailable and #bundle.includes &gt; 0
		viewBtn.Active = canView
		viewBtn.BackgroundColor3 = canView and C.Blue or C.DisabledBtn
	end

	updateSelectorHighlight()

	if inDetailView then
		if heroFrame then heroFrame.Visible = true end
		if detailFrame then detailFrame.Visible = false end
		inDetailView = false
	end
end

local function clearDetailGrid()
	if not detailFrame then return end
	for _, child in ipairs(detailFrame:GetChildren()) do
		if child:IsA("ScrollingFrame") then
			child:Destroy()
		end
	end
end

-- ═══════════════════════════════════════════════════════════════════
-- VIEWPORT PREVIEW HELPERS
-- ═══════════════════════════════════════════════════════════════════

local MIN_CAM_DIST = 4
local CAM_FOV = 50

local function cloneForViewport(modelInstance: Instance): Instance
	local clone = modelInstance:Clone()
	for _, d in ipairs(clone:GetDescendants()) do
		if d:IsA("Script") or d:IsA("LocalScript") or d:IsA("ModuleScript") then
			d:Destroy()
		elseif d:IsA("Humanoid") or d:IsA("Animator") or d:IsA("AnimationController") then
			d:Destroy()
		elseif d:IsA("ParticleEmitter") then
			d.Enabled = false
		elseif d:IsA("Trail") then
			d.Enabled = false
		elseif d:IsA("Beam") then
			d.Enabled = false
		elseif d:IsA("BasePart") then
			d.Anchored = true
			d.CanCollide = false
		end
	end
	if clone:IsA("BasePart") then
		clone.Anchored = true
		clone.CanCollide = false
	end
	return clone
end

local function getVisibleBounds(root: Instance): (Vector3, Vector3, number)
	local minB = Vector3.new(math.huge, math.huge, math.huge)
	local maxB = Vector3.new(-math.huge, -math.huge, -math.huge)
	local count = 0
	local function addPart(p: BasePart)
		if p.Transparency &gt;= 1 then return end
		count += 1
		local cf = p.CFrame
		local sz = p.Size
		for _, sxm in ipairs({-0.5, 0.5}) do
			for _, sym in ipairs({-0.5, 0.5}) do
				for _, szm in ipairs({-0.5, 0.5}) do
					local corner = cf:PointToWorldSpace(Vector3.new(sz.X * sxm, sz.Y * sym, sz.Z * szm))
					minB = Vector3.new(math.min(minB.X, corner.X), math.min(minB.Y, corner.Y), math.min(minB.Z, corner.Z))
					maxB = Vector3.new(math.max(maxB.X, corner.X), math.max(maxB.Y, corner.Y), math.max(maxB.Z, corner.Z))
				end
			end
		end
	end
	if root:IsA("BasePart") then addPart(root) end
	for _, d in ipairs(root:GetDescendants()) do
		if d:IsA("BasePart") then addPart(d) end
	end
	if count == 0 then
		return Vector3.zero, Vector3.new(2, 2, 2), 0
	end
	return minB, maxB, count
end

local function pivotToOrigin(root: Instance)
	local minB, maxB = getVisibleBounds(root)
	local center = (minB + maxB) / 2
	if center.Magnitude &lt; 0.001 then return end
	if root:IsA("BasePart") then
		root.CFrame = root.CFrame - center
	end
	for _, d in ipairs(root:GetDescendants()) do
		if d:IsA("BasePart") then
			d.CFrame = d.CFrame - center
		end
	end
end

local function setupPreviewCamera(viewport: ViewportFrame, model: Instance)
	local minB, maxB = getVisibleBounds(model)
	local center = (minB + maxB) / 2
	local extents = maxB - minB
	local maxDim = math.max(extents.X, extents.Y, extents.Z, 0.1)
	local distance = math.max(maxDim * 1.8, MIN_CAM_DIST)
	local camPos = center + Vector3.new(distance * 0.5, distance * 0.35, distance * 0.8)

	local cam = Instance.new("Camera")
	cam.CameraType = Enum.CameraType.Scriptable
	cam.CFrame = CFrame.lookAt(camPos, center)
	cam.FieldOfView = CAM_FOV
	cam.Parent = viewport
	viewport.CurrentCamera = cam
end

-- ═══════════════════════════════════════════════════════════════════
-- ITEM PREVIEW OVERLAY
-- ═══════════════════════════════════════════════════════════════════

local function closeItemPreview()
	if previewRotConn then
		previewRotConn:Disconnect()
		previewRotConn = nil
	end
	if previewOverlay then
		previewOverlay:Destroy()
		previewOverlay = nil
	end
end

local function showFallbackPreview(card: Frame, itemData)
	local fallbackImg = Instance.new("ImageLabel")
	fallbackImg.Name = "FallbackImage"
	fallbackImg.Size = UDim2.new(0.7, 0, 0.7, 0)
	fallbackImg.AnchorPoint = Vector2.new(0.5, 0.5)
	fallbackImg.Position = UDim2.new(0.5, 0, 0.5, 10)
	fallbackImg.BackgroundTransparency = 1
	fallbackImg.ScaleType = Enum.ScaleType.Fit
	fallbackImg.ZIndex = 53
	fallbackImg.Parent = card

	if itemData.image and itemData.image ~= "" then
		fallbackImg.Image = itemData.image
	else
		fallbackImg.Visible = false
		local noLbl = Instance.new("TextLabel")
		noLbl.Size = UDim2.new(0.8, 0, 0, 30)
		noLbl.AnchorPoint = Vector2.new(0.5, 0.5)
		noLbl.Position = UDim2.fromScale(0.5, 0.55)
		noLbl.BackgroundTransparency = 1
		noLbl.Font = Enum.Font.GothamBold
		noLbl.TextColor3 = Color3.fromRGB(130, 140, 170)
		noLbl.TextSize = 16
		noLbl.Text = "Preview unavailable"
		noLbl.ZIndex = 53
		noLbl.Parent = card
	end
end

local function showItemPreview(itemData)
	closeItemPreview()
	local previewHost = bundleContainer or externalPreviewHost
	if not previewHost then return end

	local itemName = itemData.name or "unknown"
	local modelPath = itemData.modelPath

	warn(string.format("[BundlePanel:Preview] item='%s' modelPath=%s registry=%s",
		itemName, tostring(modelPath), tostring(ItemModelRegistry ~= nil)))

	local modelInstance = nil
	if modelPath and ItemModelRegistry then
		modelInstance = ItemModelRegistry.Get(modelPath)
		if modelInstance then
			warn(string.format("[BundlePanel:Preview] Resolved: class=%s name='%s' descendants=%d",
				modelInstance.ClassName, modelInstance.Name, #modelInstance:GetDescendants()))
		else
			warn(string.format("[BundlePanel:Preview] Registry returned nil for '%s'", modelPath))
		end
	end

	previewOverlay = Instance.new("Frame")
	previewOverlay.Name = "ItemPreviewOverlay"
	previewOverlay.Size = UDim2.fromScale(1, 1)
	previewOverlay.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
	previewOverlay.BackgroundTransparency = 0.35
	previewOverlay.BorderSizePixel = 0
	previewOverlay.ZIndex = 50
	previewOverlay.Parent = previewHost

	local dimBtn = Instance.new("TextButton")
	dimBtn.Name = "DimClose"
	dimBtn.Size = UDim2.fromScale(1, 1)
	dimBtn.BackgroundTransparency = 1
	dimBtn.Text = ""
	dimBtn.ZIndex = 50
	dimBtn.Parent = previewOverlay
	dimBtn.MouseButton1Click:Connect(function()
		SoundUtil.Close()
		closeItemPreview()
	end)

	local card = Instance.new("Frame")
	card.Name = "PreviewCard"
	card.AnchorPoint = Vector2.new(0.5, 0.5)
	card.Size = UDim2.new(0.55, 0, 0.8, 0)
	card.Position = UDim2.fromScale(0.5, 0.5)
	card.BackgroundColor3 = Color3.fromRGB(22, 24, 42)
	card.BackgroundTransparency = 0
	card.BorderSizePixel = 0
	card.ZIndex = 52
	card.Parent = previewOverlay

	local cardCorner = Instance.new("UICorner")
	cardCorner.CornerRadius = UDim.new(0, 14)
	cardCorner.Parent = card

	local cardStroke = Instance.new("UIStroke")
	cardStroke.Color = SELECTED_GLOW
	cardStroke.Thickness = 2
	cardStroke.Transparency = 0.1
	cardStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	cardStroke.Parent = card

	local header = Instance.new("Frame")
	header.Name = "Header"
	header.Size = UDim2.new(1, 0, 0, 44)
	header.BackgroundTransparency = 1
	header.BorderSizePixel = 0
	header.ZIndex = 53
	header.Parent = card

	local nameLabel = Instance.new("TextLabel")
	nameLabel.Name = "ItemName"
	nameLabel.Size = UDim2.new(1, -60, 0, 36)
	nameLabel.Position = UDim2.fromOffset(14, 4)
	nameLabel.BackgroundTransparency = 1
	nameLabel.Font = Enum.Font.GothamBold
	nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
	nameLabel.TextTransparency = 0
	nameLabel.TextSize = 20
	nameLabel.TextXAlignment = Enum.TextXAlignment.Left
	nameLabel.TextTruncate = Enum.TextTruncate.AtEnd
	nameLabel.Text = itemName
	nameLabel.ZIndex = 54
	nameLabel.Parent = header

	local nameStroke = Instance.new("UIStroke")
	nameStroke.Color = Color3.fromRGB(0, 0, 0)
	nameStroke.Thickness = 2
	nameStroke.Transparency = 0.1
	nameStroke.Parent = nameLabel

	local closeBtn = createStyledButton(
		header, "X", C.CloseBtn,
		UDim2.fromOffset(36, 36),
		UDim2.new(1, -42, 0, 4)
	)
	closeBtn.ZIndex = 55
	closeBtn.TextSize = 16
	AnimUtil.WireButton(closeBtn, function()
		SoundUtil.Close()
		closeItemPreview()
	end)

	local hasCoinPurchase = panelOptions
		and panelOptions.itemCoinPrice
		and itemData.itemId
		and itemData.itemType

	local purchaseBtn: TextButton? = nil
	if hasCoinPurchase then
		purchaseBtn = createStyledButton(
			card,
			string.format("BUY - %dK F", math.floor(panelOptions.itemCoinPrice / 1000)),
			Color3.fromRGB(255, 200, 30),
			UDim2.new(1, -20, 0, 42),
			UDim2.new(0, 10, 1, -50)
		)
		purchaseBtn.ZIndex = 55

		local function isOwned(): boolean
			local attrKey = (itemData.itemType == "ExclusivePet") and "OwnedPets" or "OwnedCrowns"
			local raw = LocalPlayer:GetAttribute(attrKey)
			if type(raw) ~= "string" or raw == "" then return false end
			local okDec, list = pcall(HttpService.JSONDecode, HttpService, raw)
			if not okDec or type(list) ~= "table" then return false end
			for _, id in ipairs(list) do
				if id == itemData.itemId then return true end
			end
			return false
		end

		local function refreshPurchaseState()
			if not purchaseBtn then return end
			if isOwned() then
				purchaseBtn.Text = "OWNED"
				purchaseBtn.BackgroundColor3 = C.DisabledBtn
				purchaseBtn.Active = false
			else
				purchaseBtn.Text = string.format("BUY - %dK F", math.floor(panelOptions.itemCoinPrice / 1000))
				purchaseBtn.BackgroundColor3 = Color3.fromRGB(255, 200, 30)
				purchaseBtn.Active = true
			end
		end

		refreshPurchaseState()
		AnimUtil.WireButton(purchaseBtn, function()
			if not purchaseBtn or not purchaseBtn.Active then return end
			SoundUtil.Click()
			local remotes = ReplicatedStorage:FindFirstChild("Remotes")
			local buyRF = remotes and remotes:FindFirstChild("Shop_BuyWithCoins")
			if not buyRF then return end
			local okBuy, result = pcall(buyRF.InvokeServer, buyRF, itemData.itemId, itemData.itemType)
			if okBuy and result and result.success then
				refreshPurchaseState()
				if panelOptions and panelOptions.onItemPurchased then
					pcall(panelOptions.onItemPurchased, itemData.itemId)
				end
			end
		end)
	end

	if not modelInstance then
		warn("[BundlePanel:Preview] No model — showing fallback for", itemName)
		showFallbackPreview(card, itemData)
		return
	end

	local clone = cloneForViewport(modelInstance)

	if clone:IsA("Accessory") then
		warn("[BundlePanel:Preview] Unwrapping Accessory")
		local wrapper = Instance.new("Model")
		wrapper.Name = clone.Name
		for _, child in ipairs(clone:GetChildren()) do
			child.Parent = wrapper
		end
		local handle = wrapper:FindFirstChild("Handle")
		if handle and handle:IsA("BasePart") then
			wrapper.PrimaryPart = handle
		end
		clone:Destroy()
		clone = wrapper
	end

	pivotToOrigin(clone)

	local minB, maxB, partCount = getVisibleBounds(clone)
	warn(string.format("[BundlePanel:Preview] Clone ready: %d visible BaseParts, bounds min=%s max=%s",
		partCount, tostring(minB), tostring(maxB)))

	if partCount == 0 then
		warn("[BundlePanel:Preview] No visible BaseParts — showing fallback")
		showFallbackPreview(card, itemData)
		clone:Destroy()
		return
	end

	local vpFrame = Instance.new("ViewportFrame")
	vpFrame.Name = "ModelPreview"
	vpFrame.Size = hasCoinPurchase and UDim2.new(1, -20, 1, -110) or UDim2.new(1, -20, 1, -54)
	vpFrame.Position = UDim2.fromOffset(10, 48)
	vpFrame.BackgroundColor3 = Color3.fromRGB(14, 16, 32)
	vpFrame.BackgroundTransparency = 0
	vpFrame.BorderSizePixel = 0
	vpFrame.ZIndex = 53
	vpFrame.Parent = card

	local vpCorner = Instance.new("UICorner")
	vpCorner.CornerRadius = UDim.new(0, 10)
	vpCorner.Parent = vpFrame

	local worldModel = Instance.new("WorldModel")
	worldModel.Parent = vpFrame

	clone.Parent = worldModel
	setupPreviewCamera(vpFrame, clone)

	task.spawn(function()
		ContentProvider:PreloadAsync(clone:GetDescendants())
	end)

	local center = (minB + maxB) / 2
	local extents = maxB - minB
	local maxDim = math.max(extents.X, extents.Y, extents.Z, 0.1)
	local baseDist = math.max(maxDim * 1.8, MIN_CAM_DIST)
	local angle = 0

	previewRotConn = RunService.RenderStepped:Connect(function(dt)
		angle = angle + dt * 30
		local rad = math.rad(angle)
		local camPos = center + Vector3.new(
			math.sin(rad) * baseDist * 0.8,
			baseDist * 0.35,
			math.cos(rad) * baseDist * 0.8
		)
		local cam = vpFrame.CurrentCamera
		if cam then
			cam.CFrame = CFrame.lookAt(camPos, center)
		end
	end)
end

-- ═══════════════════════════════════════════════════════════════════
-- DETAIL VIEW
-- ═══════════════════════════════════════════════════════════════════

local function showDetailView()
	local bundle = BundleCatalog.Get(selectedBundleId)
	if not bundle or #bundle.includes == 0 then return end

	inDetailView = true
	if heroFrame then heroFrame.Visible = false end
	if detailFrame then
		clearDetailGrid()
		detailFrame.Visible = true
	end

	local gridFrame = Instance.new("ScrollingFrame")
	gridFrame.Name = "IncludesGrid"
	gridFrame.Size = UDim2.new(1, 0, 1, -50)
	gridFrame.Position = UDim2.fromOffset(0, 46)
	gridFrame.BackgroundTransparency = 1
	gridFrame.BorderSizePixel = 0
	gridFrame.ScrollBarThickness = 4
	gridFrame.ScrollBarImageColor3 = Color3.fromRGB(75, 82, 108)
	gridFrame.CanvasSize = UDim2.fromScale(0, 0)
	gridFrame.AutomaticCanvasSize = Enum.AutomaticSize.Y
	gridFrame.ScrollingDirection = Enum.ScrollingDirection.Y
	gridFrame.ZIndex = 12
	gridFrame.Parent = detailFrame

	Components.AddGridLayout(gridFrame, Vector2.new(S.CardWidth, S.CardHeight), S.CardPad)
	local isFnafBundle = (bundle.id == FNAF_BUNDLE_ID)
	local isBrainrotBundle = (bundle.id == BRAINROT_BUNDLE_ID)
	local hasPerItemCoinBuy = isFnafBundle or isBrainrotBundle
	local ownedByCategory: { [string]: { [string]: boolean } } = {}

	for i, inc in ipairs(bundle.includes) do
		local itemData = ItemCatalog.Get(inc.category, inc.itemId)
		if not itemData then
			warn("[BundlePanel] Missing catalog entry:", inc.category, inc.itemId)
			continue
		end
		if not ownedByCategory[inc.category] then
			ownedByCategory[inc.category] = getOwnedSetForCategory(inc.category)
		end
		local isOwned = ownedByCategory[inc.category][inc.itemId] == true
		if isBrainrotBundle then
			print(string.format("[BrainrotCard] Render item=%s owned=%s", tostring(inc.itemId), tostring(isOwned)))
		end
		local actionText = nil
		local actionColor = nil
		local onAction = nil
		if isBrainrotBundle then
			if isOwned then
				actionText = "OWNED"
				actionColor = C.DisabledBtn
			else
				actionText = "BUY - 75,000 F"
				actionColor = Color3.fromRGB(255, 200, 30)
				onAction = function()
					print(string.format("[BrainrotCard] ClickBuy item=%s", tostring(inc.itemId)))
					local remotes = ReplicatedStorage:FindFirstChild("Remotes")
					local buyRF = remotes and remotes:FindFirstChild("BuyBrainrotItem")
					if not buyRF then
						warn("[BundlePanel] BuyBrainrotItem remote missing")
						return
					end
					local okBuy, result = pcall(buyRF.InvokeServer, buyRF, inc.itemId)
					if okBuy and result and result.success then
						selectBundle(selectedBundleId)
						showDetailView()
					elseif okBuy and result and result.reason == "INSUFFICIENT_COINS" then
						local productId = tonumber(result.productId)
						if productId and productId &gt; 0 then
							MarketplaceService:PromptProductPurchase(LocalPlayer, productId)
						else
							warn("[BundlePanel] Missing top-up productId for insufficient bundle item coins")
						end
					elseif okBuy and result and result.reason == "ALREADY_OWNED" then
						selectBundle(selectedBundleId)
						showDetailView()
					end
				end
			end
		elseif isFnafBundle and inc.category == "Pets" then
			if isOwned then
				actionText = "OWNED"
				actionColor = C.DisabledBtn
			else
				actionText = "BUY - 70,000 F"
				actionColor = Color3.fromRGB(255, 200, 30)
				onAction = function()
					local remotes = ReplicatedStorage:FindFirstChild("Remotes")
					local buyRF = remotes and remotes:FindFirstChild("Shop_BuyWithCoins")
					if not buyRF then
						warn("[BundlePanel] Shop_BuyWithCoins remote missing for FNAF item buy")
						return
					end
					local okBuy, result = pcall(buyRF.InvokeServer, buyRF, inc.itemId, "ExclusivePet")
					if okBuy and result and result.success then
						selectBundle(selectedBundleId)
						showDetailView()
					elseif okBuy and result and result.reason == "INSUFFICIENT_COINS" then
						local productId = tonumber(result.productId)
						if productId and productId &gt; 0 then
							MarketplaceService:PromptProductPurchase(LocalPlayer, productId)
						else
							warn("[BundlePanel] Missing top-up productId for insufficient FNAF item coins")
						end
					elseif okBuy and result and tostring(result.reason or "") == "Already owned" then
						selectBundle(selectedBundleId)
						showDetailView()
					end
				end
			end
		end

		local cardData = {
			name = itemData.name or inc.itemId,
			rarity = itemData.rarity or "Common",
			iconColor = itemData.iconColor,
			iconText = itemData.iconText,
			image = ItemCatalog.GetImage and ItemCatalog.GetImage(itemData) or itemData.image or "",
			modelPath = itemData.modelPath,
			locked = nil,
			owned = hasPerItemCoinBuy and isOwned or nil,
			actionText = actionText,
			actionColor = actionColor,
			onAction = onAction,
			itemId = inc.itemId,
			itemType = panelOptions and panelOptions.itemType or nil,
			coinPrice = panelOptions and panelOptions.itemCoinPrice or nil,
		}

		local card = Components.CreateItemCard(gridFrame, cardData)
		card.LayoutOrder = i

		-- Preview is always available regardless of ownership.
		-- For Brainrot, keep overlay off CTA row so BUY remains clickable.
		local clickOverlay = Instance.new("TextButton")
		clickOverlay.Name = "PreviewClick"
		clickOverlay.Size = if hasPerItemCoinBuy then UDim2.new(1, 0, 1, -50) else UDim2.fromScale(1, 1)
		clickOverlay.BackgroundTransparency = 1
		clickOverlay.Text = ""
		clickOverlay.ZIndex = 20
		clickOverlay.Parent = card
		clickOverlay.MouseButton1Click:Connect(function()
			if isBrainrotBundle then
				print(string.format("[BrainrotCard] ClickPreview item=%s", tostring(inc.itemId)))
			end
			SoundUtil.Click()
			showItemPreview(cardData)
		end)

		if hasPerItemCoinBuy and isOwned then
			local btn = card:FindFirstChild("ActionBtn")
			if btn and btn:IsA("TextButton") then
				btn.Active = false
				btn.AutoButtonColor = false
			end
		end
	end
end

local function hideDetailView()
	inDetailView = false
	if heroFrame then heroFrame.Visible = true end
	if detailFrame then detailFrame.Visible = false end
end

local BundlePanel = {}

function BundlePanel.Init()
end

function BundlePanel.PopulateInto(parent: ScrollingFrame, options)
	BundlePanel.ClearContent()
	contentParent = parent
	panelOptions = options or nil

	for _, child in ipairs(parent:GetChildren()) do
		if child:IsA("UIGridLayout") then
			child:Destroy()
		end
	end

	parent.AutomaticCanvasSize = Enum.AutomaticSize.None
	parent.CanvasSize = UDim2.fromScale(0, 0)
	parent.ScrollBarThickness = 0
	parent.ScrollingDirection = Enum.ScrollingDirection.XY

	bundleContainer = Instance.new("Frame")
	bundleContainer.Name = "BundleContent"
	bundleContainer.Size = UDim2.fromScale(1, 1)
	bundleContainer.BackgroundColor3 = BG_DARK
	bundleContainer.BackgroundTransparency = 0.1
	bundleContainer.BorderSizePixel = 0
	bundleContainer.ZIndex = 4
	bundleContainer.Parent = parent

	local containerCorner = Instance.new("UICorner")
	containerCorner.CornerRadius = UDim.new(0, 10)
	containerCorner.Parent = bundleContainer

	local bgGrad = Instance.new("UIGradient")
	bgGrad.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, BG_DARK),
		ColorSequenceKeypoint.new(1, BG_LIGHTER),
	})
	bgGrad.Rotation = 110
	bgGrad.Parent = bundleContainer

	heroFrame = Instance.new("Frame")
	heroFrame.Name = "HeroArea"
	heroFrame.Size = UDim2.new(0.68, -8, 1, -8)
	heroFrame.Position = UDim2.fromOffset(4, 4)
	heroFrame.BackgroundTransparency = 1
	heroFrame.BorderSizePixel = 0
	heroFrame.ZIndex = 5
