      <Item class="ModuleScript" referent="57">
        <Properties>
          <string name="Name">EconomyService</string>
          <string name="Source">--[[
	EconomyService
	Server-authoritative coin management.

	Coins are persisted via PlayerDataService (DataStore).
	Falls back to player attributes if PlayerDataService is unavailable.

	CoinMultiplier from StatService is automatically applied to AwardCoins
	UNLESS skipMultiplier is true (used by fixed-reward systems like DailyReward, SpinWheel).

	Tracks LifetimeCoinsAchieved and WeeklyCoinsAchieved for leaderboards.

	Leaderboard updates are sent via DIRECT MODULE CALL to
	GlobalLeaderboardService.ReportStatById() — no BindableEvent.

	API:
		Init()
		GetCoins(player)                                  → number
		AwardCoins(player, amount, reason, skipMultiplier) → (boolean, finalAmount)
		DeductCoins(player, amount, reason)                → boolean
		SetCoins(player, amount)                           → boolean
		ResetMatchCoins()
		TrackMatchCoins(player, amount)
		GetMatchCoins(player)                              → number
]]

local Players             = game:GetService("Players")
local ReplicatedStorage   = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")
local RunService          = game:GetService("RunService")

local IS_STUDIO = RunService:IsStudio()

local Shared = ReplicatedStorage:WaitForChild("Shared")
local CoinConfig = require(Shared:WaitForChild("CoinConfig"))

local ATTRIBUTE_NAME = "Coins"

local EconomyService = {}
local initialized = false
local matchCoinsEarned: { [number]: number } = {}

local _PlayerDataService = nil
local _StatService = nil
local _GLBS = nil

local ACHIEVED_DEBUG = true

local function log(...)
	if CoinConfig.DebugLog then
		print("[EconomyService]", ...)
	end
end

local function achievedLog(...)
	if ACHIEVED_DEBUG then
		warn("[EconomyService:Achieved]", ...)
	end
end

local function getPDS()
	if _PlayerDataService ~= nil then return _PlayerDataService end
	local ok, mod = pcall(function()
		local Server = ServerScriptService:WaitForChild("Server", 5)
		if Server then
			return require(Server:WaitForChild("PlayerDataService", 5))
		end
		return nil
	end)
	if ok and mod then
		_PlayerDataService = mod
	else
		_PlayerDataService = false
	end
	return _PlayerDataService
end

local function getStatService()
	if _StatService ~= nil then return _StatService end
	local ok, mod = pcall(function()
		local Server = ServerScriptService:WaitForChild("Server", 5)
		if Server then
			return require(Server:WaitForChild("StatService", 5))
		end
		return nil
	end)
	if ok and mod then
		_StatService = mod
	else
		_StatService = false
	end
	return _StatService
end

local function getGLBS()
	if _GLBS ~= nil then return _GLBS end
	local ok, mod = pcall(function()
		return require(script.Parent:WaitForChild("GlobalLeaderboardService", 10))
	end)
	if ok and mod then
		_GLBS = mod
		warn("[EconomyService] GLBS loaded via direct require — ReportStatById available")
	else
		_GLBS = false
		warn("[EconomyService] GLBS not available:", tostring(mod))
	end
	return _GLBS
end

local function reportStats(userId: number, username: string, updates: { [string]: number })
	local GLBS = getGLBS()
	if not GLBS or GLBS == false then
		achievedLog("reportStats SKIPPED — GLBS not available")
		return
	end

	for statKey, value in pairs(updates) do
		local callOk, callErr = pcall(function()
			GLBS.ReportStatById(userId, statKey, value)
		end)
		if callOk then
			achievedLog(string.format("DIRECT CALL OK: ReportStatById(%d, '%s', %d)", userId, statKey, value))
		else
			warn(string.format("[EconomyService] DIRECT CALL FAILED: ReportStatById(%d, '%s', %d) err=%s",
				userId, statKey, value, tostring(callErr)))
		end
	end
end

local function registerPlayer(player: Player)
	if player:GetAttribute(ATTRIBUTE_NAME) == nil then
		player:SetAttribute(ATTRIBUTE_NAME, 0)
	end
end

function EconomyService.Init()
	if initialized then
		warn("[EconomyService] Already initialized")
		return
	end
	initialized = true

	task.spawn(function()
		getGLBS()
	end)

	task.spawn(function()
		local PDS = getPDS()
		local mode = (PDS and PDS ~= false) and "DATASTORE_MODE" or "ATTRIBUTE_FALLBACK"
		warn(string.format("[EconomyService] Data authority: IS_STUDIO=%s, mode=%s", tostring(IS_STUDIO), mode))
	end)

	for _, player in ipairs(Players:GetPlayers()) do
		registerPlayer(player)
	end

	Players.PlayerAdded:Connect(function(player)
		registerPlayer(player)
	end)

	warn(string.format("[EconomyService] Initialized — IS_STUDIO=%s, leaderboard updates via direct GLBS calls",
		tostring(IS_STUDIO)))
end

function EconomyService.GetCoins(player: Player): number
	local PDS = getPDS()
	if PDS then
		local data = PDS.GetData(player)
		if data then
			return data.Coins or 0
		end
	end
	return player:GetAttribute(ATTRIBUTE_NAME) or 0
end

function EconomyService.GetMultipliedAmount(player: Player, baseAmount: number): number
	local SS = getStatService()
	local multiplier = 1
	if SS and type(SS.GetCoinMultiplier) == "function" then
		multiplier = SS.GetCoinMultiplier(player)
	else
		multiplier = player:GetAttribute("CoinMultiplier") or 1
	end
	return math.floor(baseAmount * multiplier)
end

function EconomyService.AwardCoins(player: Player, amount: number, reason: string?, skipMultiplier: boolean?): (boolean, number)
	if amount &lt;= 0 then return true, 0 end

	if not player.Parent then
		log(string.format("Skipped award for %s (left game) — %d coins (%s)",
			player.Name, amount, reason or "unknown"))
		return false, 0
	end

	local multiplier = 1
	if not skipMultiplier then
		local SS = getStatService()
		if SS and type(SS.GetCoinMultiplier) == "function" then
			multiplier = SS.GetCoinMultiplier(player)
		else
			multiplier = player:GetAttribute("CoinMultiplier") or 1
		end
	end
	local finalAmount = math.floor(amount * multiplier)
	if finalAmount &lt;= 0 then return true, 0 end

	local PDS = getPDS()
	if PDS then
		local data = PDS.GetData(player)
		if data then
			local oldCoins = data.Coins or 0
			local newTotal = oldCoins + finalAmount
			PDS.SetField(player, "Coins", newTotal)

			local oldLifetime = data.LifetimeCoinsAchieved or 0
			local oldWeekly   = data.WeeklyCoinsAchieved or 0

			local lifetimeEarned = oldLifetime + finalAmount
			PDS.SetField(player, "LifetimeCoinsAchieved", lifetimeEarned)

			local weeklyEarned = oldWeekly + finalAmount
			PDS.SetField(player, "WeeklyCoinsAchieved", weeklyEarned)

			warn(string.format(
				"[COIN_AUDIT] player=%s userId=%d | +%d (base=%d mult=%.2fx skip=%s) reason=%s | %d -&gt; %d | t=%d",
				player.Name, player.UserId, finalAmount, amount, multiplier,
				tostring(skipMultiplier or false), reason or "?",
				oldCoins, newTotal, os.time()
			))

			reportStats(player.UserId, player.Name, {
				WeeklyCoins  = weeklyEarned,
				LifetimeCoins = lifetimeEarned,
			})

			return true, finalAmount
		else
			achievedLog(string.format(
				"%s PDS.GetData returned nil — using attribute fallback (achieved stats SKIPPED)",
				player.Name
			))
		end
	else
		achievedLog(string.format(
			"%s PDS not available — using attribute fallback (achieved stats SKIPPED)",
			player.Name
		))
	end

	local current = player:GetAttribute(ATTRIBUTE_NAME) or 0
	local newTotal = current + finalAmount
	player:SetAttribute(ATTRIBUTE_NAME, newTotal)
	warn(string.format(
		"[COIN_AUDIT] player=%s userId=%d | +%d (base=%d mult=%.2fx skip=%s) reason=%s | %d -&gt; %d [attr] | t=%d",
		player.Name, player.UserId, finalAmount, amount, multiplier,
		tostring(skipMultiplier or false), reason or "?",
		current, newTotal, os.time()
	))
	return true, finalAmount
end

function EconomyService.DeductCoins(player: Player, amount: number, reason: string?): boolean
	if amount &lt;= 0 then return true end

	local current = EconomyService.GetCoins(player)
	if current &lt; amount then
		log(string.format("%s deduct failed: need %d, have %d (%s)",
			player.Name, amount, current, reason or "unknown"))
		return false
	end

	local newTotal = current - amount

	local PDS = getPDS()
	if PDS then
		local data = PDS.GetData(player)
		if data then
			PDS.SetField(player, "Coins", newTotal)
			warn(string.format(
				"[COIN_AUDIT] player=%s userId=%d | -%d reason=%s | %d -&gt; %d | t=%d",
				player.Name, player.UserId, amount, reason or "?",
				current, newTotal, os.time()
			))
			return true
		end
	end

	player:SetAttribute(ATTRIBUTE_NAME, newTotal)
	warn(string.format(
		"[COIN_AUDIT] player=%s userId=%d | -%d reason=%s | %d -&gt; %d [attr] | t=%d",
		player.Name, player.UserId, amount, reason or "?",
		current, newTotal, os.time()
	))
	return true
end

function EconomyService.SetCoins(player: Player, amount: number): boolean
	if amount &lt; 0 then
		warn("[EconomyService] Cannot set negative coins")
		return false
	end

	local PDS = getPDS()
	if PDS then
		local data = PDS.GetData(player)
		if data then
			PDS.SetField(player, "Coins", amount)
			return true
		end
	end

	player:SetAttribute(ATTRIBUTE_NAME, amount)
	return true
end

function EconomyService.ResetMatchCoins()
	matchCoinsEarned = {}
end

function EconomyService.TrackMatchCoins(player: Player, amount: number)
	local key = player.UserId
	matchCoinsEarned[key] = (matchCoinsEarned[key] or 0) + amount
end

function EconomyService.GetMatchCoins(player: Player): number
	return matchCoinsEarned[player.UserId] or 0
end

return EconomyService</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="58">
        <Properties>
          <string name="Name">EliminationTracker</string>
          <string name="Source"><![CDATA[--[[
	EliminationTracker
	Records eliminations during a match and builds placement rankings at match end.
	
	Standalone module (no circular deps) — required by HazardManager,
	MapManager, and MatchManager.
	
	API:
		Reset(matchPlayers)                           → Clear data for new match
		RecordElimination(player, round, reason)      → Log an elimination
		BuildRankings(survivors)                       → { PlacementGroup }
		GetEliminations()                              → Raw elimination list
		GetMatchId()                                   → Current match counter
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local CoinConfig = require(Shared:WaitForChild("CoinConfig"))

--[[ TYPES ]]
export type EliminationRecord = {
	player: Player?,       -- May be nil if player left after elimination
	playerName: string,
	playerId: number,
	eliminationTime: number,
	roundNumber: number,
	reason: string,        -- "Beam", "OOB", "Sword", "Disconnect", etc.
	killerName: string?,   -- Set for player-attributed eliminations (e.g. Sword)
	killerId: number?,
}

export type PlayerEntry = {
	player: Player?,
	playerName: string,
	playerId: number,
}

export type PlacementGroup = {
	placement: number,
	players: { PlayerEntry },
	coins: number,
	reason: string,        -- "Survived" or "Eliminated"
}

--[[ INTERNAL STATE ]]
local eliminations: { EliminationRecord } = {}
local matchPlayerIds: { [number]: boolean } = {}  -- userId set for validation
local eliminatedByPlayerId: { [number]: EliminationRecord } = {}
local matchId: number = 0
local awarded: boolean = false

local EliminationTracker = {}

--[[ HELPERS ]]

local function log(...)
	if CoinConfig.DebugLog then
		print("[EliminationTracker]", ...)
	end
end

-- Lazy-load PlayerDataService for death tracking (avoids tight coupling)
local _PlayerDataService = nil
local function getPDS()
	if _PlayerDataService then return _PlayerDataService end
	pcall(function()
		local Server = game:GetService("ServerScriptService"):FindFirstChild("Server")
		if Server then
			local pds = Server:FindFirstChild("PlayerDataService")
			if pds then _PlayerDataService = require(pds) end
		end
	end)
	return _PlayerDataService
end

--[[ PUBLIC API ]]

--[[
	Reset tracker for a new match.
	Call at the start of Playing phase with all InMatch players.
]]
function EliminationTracker.Reset(players: { Player })
	eliminations = {}
	matchPlayerIds = {}
	eliminatedByPlayerId = {}
	awarded = false
	matchId = matchId + 1
	
	for _, player in ipairs(players) do
		matchPlayerIds[player.UserId] = true
	end
	
	log(string.format("Reset for match #%d — %d players", matchId, #players))
end

--[[
	Record a player elimination.
	Idempotent: ignores duplicate calls for the same player.
]]
function EliminationTracker.RecordElimination(player: Player, roundNumber: number, reason: string, killer: Player?)
	-- Ignore if player wasn't in this match
	if not matchPlayerIds[player.UserId] then
		return
	end
	
	-- Prevent duplicate recording for same player
	if eliminatedByPlayerId[player.UserId] then
		return
	end
	
	local record: EliminationRecord = {
		player = player,
		playerName = player.Name,
		playerId = player.UserId,
		eliminationTime = os.clock(),
		roundNumber = roundNumber,
		reason = reason,
		killerName = if killer then killer.Name else nil,
		killerId = if killer then killer.UserId else nil,
	}
	
	table.insert(eliminations, record)
	eliminatedByPlayerId[player.UserId] = record
	log(string.format("Recorded: %s eliminated (round %d, %s) — #%d this match",
		player.Name, roundNumber, reason, #eliminations))

	-- Increment lifetime death counter (persistent)
	local PDS = getPDS()
	if PDS and PDS.IsLoaded(player) then
		local deaths = (PDS.GetField(player, "LifetimeDeaths") or 0) + 1
		PDS.SetField(player, "LifetimeDeaths", deaths)
	end

	-- Broadcast to all clients for Kill Feed UI
	local remotes = ReplicatedStorage:FindFirstChild("Remotes")
	if remotes then
		local killFeedEvent = remotes:FindFirstChild("KillFeedEvent")
		if killFeedEvent then
			if reason == "Sword" and record.killerName and record.killerName ~= "" then
				killFeedEvent:FireAllClients(player.Name, record.killerName)
			else
				killFeedEvent:FireAllClients(player.Name, reason)
			end
		end
	end
end

function EliminationTracker.IsEliminated(player: Player): boolean
	return eliminatedByPlayerId[player.UserId] ~= nil
end

--[[
	Build placement rankings from elimination data + surviving players.
	
	Algorithm:
	  1. Survivors (still InMatch at match end) form the top group
	  2. Eliminated players sorted by eliminationTime descending (latest = better)
	  3. Players within SimultaneousWindow of each other share a placement
	  4. Small match (2–4 players): use SmallMatchPayouts table (last > 0)
	     Normal match (5+ players): standard tiers, last = 0
	  5. If only 1 group total → everyone gets FirstPlace
	
	Returns an ordered list of PlacementGroups from best to worst.
	May only be called ONCE per match (enforced by awarded flag).
]]
function EliminationTracker.BuildRankings(survivors: { Player }): { PlacementGroup }
	if awarded then
		warn("[EliminationTracker] Rankings already built for this match — skipping")
		return {}
	end
	awarded = true
	
	local groups: { PlacementGroup } = {}
	
	-- Survivors form the top group (if any)
	if #survivors > 0 then
		local entries: { PlayerEntry } = {}
		for _, p in ipairs(survivors) do
			table.insert(entries, {
				player = p,
				playerName = p.Name,
				playerId = p.UserId,
			})
		end
		table.insert(groups, {
			placement = 0, -- assigned below
			players = entries,
			coins = 0,
			reason = "Survived",
		})
	end
	
	-- Sort eliminations by time DESCENDING (last eliminated = best)
	local sorted = table.clone(eliminations)
	table.sort(sorted, function(a, b)
		return a.eliminationTime > b.eliminationTime
	end)
	
	-- Group by time proximity
	local currentEntries: { PlayerEntry }? = nil
	local currentTime: number = 0
	
	for _, record in ipairs(sorted) do
		if currentEntries == nil or (currentTime - record.eliminationTime) > CoinConfig.SimultaneousWindow then
			-- Flush previous group
			if currentEntries and #currentEntries > 0 then
				table.insert(groups, {
					placement = 0,
					players = currentEntries,
					coins = 0,
					reason = "Eliminated",
				})
			end
			currentEntries = {}
			currentTime = record.eliminationTime
		end
		
		table.insert(currentEntries, {
			player = record.player,
			playerName = record.playerName,
			playerId = record.playerId,
		})
	end
	
	-- Flush final group
	if currentEntries and #currentEntries > 0 then
		table.insert(groups, {
			placement = 0,
			players = currentEntries,
			coins = 0,
			reason = "Eliminated",
		})
	end
	
	-- Determine total match player count (for small-match payout rule)
	local totalMatchPlayers = 0
	for _ in pairs(matchPlayerIds) do totalMatchPlayers += 1 end
	local isSmallMatch = totalMatchPlayers <= CoinConfig.SmallMatchMaxPlayers

	-- Resolve small-match payout table (if applicable)
	local smallPayouts = nil
	if isSmallMatch and CoinConfig.SmallMatchPayouts then
		smallPayouts = CoinConfig.SmallMatchPayouts[totalMatchPlayers]
	end

	-- Assign placements and coin rewards
	local totalGroups = #groups
	
	for i, group in ipairs(groups) do
		group.placement = i
		
		if totalGroups == 1 then
			-- Everyone shares 1st (solo player, everyone died at once, etc.)
			group.coins = CoinConfig.FirstPlace
		elseif smallPayouts then
			-- Small match (2–4 players): use scaled payout table
			-- Index by placement; fallback to Participation if more groups than entries
			group.coins = smallPayouts[i] or CoinConfig.Participation
		else
			-- Normal match (5+ players): standard tiers, last = 0
			if i == totalGroups then
				group.coins = CoinConfig.LastPlace
			elseif i == 1 then
				group.coins = CoinConfig.FirstPlace
			elseif i == 2 then
				group.coins = CoinConfig.SecondPlace
			elseif i == 3 then
				group.coins = CoinConfig.ThirdPlace
			else
				group.coins = CoinConfig.Participation
			end
		end
	end
	
	-- Log summary
	local parts = {}
	for _, group in ipairs(groups) do
		local names = {}
		for _, p in ipairs(group.players) do
			table.insert(names, p.playerName)
		end
		table.insert(parts, string.format(
			"#%d(%d coins): %s",
			group.placement, group.coins, table.concat(names, ",")
		))
	end
	
	if totalGroups > 0 then
		log(string.format("[MatchEnd] playerCount=%d isSmallMatch=%s payoutTable=%s Rankings — %s",
			totalMatchPlayers, tostring(isSmallMatch),
			smallPayouts and "SmallMatchPayouts["..totalMatchPlayers.."]" or "Standard",
			table.concat(parts, " | ")))
	else
		log("[MatchEnd] No players to rank")
	end
	
	-- Log last place explicitly
	if totalGroups > 1 then
		local lastGroup = groups[totalGroups]
		local lastNames = {}
		for _, p in ipairs(lastGroup.players) do
			table.insert(lastNames, p.playerName)
		end
		log(string.format("[MatchEnd] Last place (%d coins, smallMatch=%s): %s",
			lastGroup.coins, tostring(isSmallMatch), table.concat(lastNames, ",")))
	end
	
	return groups
end

--[[
	Get raw elimination records (for debugging).
]]
function EliminationTracker.GetEliminations(): { EliminationRecord }
	return eliminations
end

--[[
	Get current match counter.
]]
function EliminationTracker.GetMatchId(): number
	return matchId
end

return EliminationTracker
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="59">
        <Properties>
          <string name="Name">FreddyPetBootstrap</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- Freddy pet uses the standard client float/bobble pet pipeline.
-- Intentionally not starting FreddyPetServerController.

]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="60">
        <Properties>
          <string name="Name">FreddyPetServerController</string>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local PathfindingService = game:GetService("PathfindingService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local ItemCatalog = require(Shared:WaitForChild("ItemCatalog"))
local ItemModelRegistry = require(Shared:WaitForChild("ItemModelRegistry"))
local AnimateTemplate = Shared:WaitForChild("AnimateR15_NPC")

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local EquipRemote = Remotes:WaitForChild("EquipFreddyPet")
local UnequipRemote = Remotes:WaitForChild("UnequipFreddyPet")

local TAG = "[FreddyPetSV]"
local PET_ID = "pet_freddy_fazbear"
local FOLLOW_DISTANCE = 5
local STOP_DISTANCE = 3
local LOOP_INTERVAL = 0.1
local WALK_SPEED = 26
local REPATH_INTERVAL = 0.5

type ActiveEntry = {
	model: Model,
	thread: thread,
}

local _active: {[Player]: ActiveEntry} = {}

local function log(...)
	print(TAG, ...)
end

local function getRootFolder(): Folder
	local root = Workspace:FindFirstChild("_EquippedPets")
	if root and root:IsA("Folder") then
		return root
	end
	root = Instance.new("Folder")
	root.Name = "_EquippedPets"
	root.Parent = Workspace
	return root
end

local function getPlayerFolder(player: Player): Folder
	local root = getRootFolder()
	local name = tostring(player.UserId)
	local f = root:FindFirstChild(name)
	if f and f:IsA("Folder") then
		return f
	end
	f = Instance.new("Folder")
	f.Name = name
	f.Parent = root
	return f
end

local function despawnFor(player: Player, reason: string?)
	local entry = _active[player]
	if not entry then
		if reason then
			log(string.format("despawn skip owner=%s reason=%s (no active)", player.Name, reason))
		end
		return
	end
	log(string.format("despawn owner=%s reason=%s model=%s", player.Name, tostring(reason), entry.model:GetFullName()))
	pcall(function() task.cancel(entry.thread) end)
	if entry.model and entry.model.Parent then
		entry.model:Destroy()
	end
	_active[player] = nil
end

local function isAnimateScript(inst: Instance): boolean
	local name = string.lower(inst.Name)
	return name == "animate"
end

local function isFreddyNativeAnimationDriver(inst: Instance): boolean
	if not inst:IsA("Script") then
		return false
	end
	if isAnimateScript(inst) then
		return true
	end
	-- Baseplate Freddy uses a script named "Script" with animation data.
	if inst.Name == "Script" then
		if inst:FindFirstChild("AnimSaves") then
			return true
		end
		local animCount = 0
		for _, d in ipairs(inst:GetDescendants()) do
			if d:IsA("Animation") then
				animCount += 1
				if animCount >= 2 then
					return true
				end
			end
		end
	end
	return false
end

local function hasTransformMover(model: Model): boolean
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BodyMover")
			or d:IsA("AlignPosition")
			or d:IsA("AlignOrientation")
			or d:IsA("LinearVelocity")
			or d:IsA("VectorForce")
			or d:IsA("LineForce")
			or d:IsA("Torque")
			or d:IsA("AngularVelocity")
			or d:IsA("RocketPropulsion")
		then
			return true
		end
	end
	return false
end

local function getAnimator(hum: Humanoid): Animator?
	local animator = hum:FindFirstChildOfClass("Animator")
	if animator then
		return animator
	end
	local found = hum:FindFirstChild("Animator")
	if found and found:IsA("Animator") then
		return found
	end
	return nil
end

local function getPlayingTrackSnapshot(animator: Animator?): (number, string)
	if not animator then
		return 0, "none"
	end
	local tracks = animator:GetPlayingAnimationTracks()
	local n = #tracks
	if n == 0 then
		return 0, "none"
	end
	local items = {}
	for i, t in ipairs(tracks) do
		if i > 4 then break end
		local aid = ""
		local anim = t.Animation
		if anim and anim.AnimationId then
			aid = anim.AnimationId
		end
		table.insert(items, (t.Name or "?") .. ":" .. aid)
	end
	return n, table.concat(items, ",")
end

local function computeFollowTarget(ownerHrp: BasePart): Vector3
	-- Keep Freddy behind and slightly to the side to avoid overlap with owner.
	return ownerHrp.Position
		- ownerHrp.CFrame.LookVector * FOLLOW_DISTANCE
		+ ownerHrp.CFrame.RightVector * 1.5
end

local function ensureAnimateScript(model: Model): string
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("Script") and isFreddyNativeAnimationDriver(d) then
			d.Disabled = false
			return "native:" .. d.Name
		end
	end
	local existing = model:FindFirstChild("Animate")
	if existing and existing:IsA("Script") then
		existing:Destroy()
	end
	local s = AnimateTemplate:Clone()
	s.Name = "Animate"
	s.Parent = model
	s.Disabled = false
	return "template_fallback"
end

local function resolveFreddySource(): Instance?
	local petDef = ItemCatalog.Pets and ItemCatalog.Pets[PET_ID]
	if petDef and typeof(petDef.modelPath) == "string" and petDef.modelPath ~= "" then
		local byPath = ItemModelRegistry.Get(petDef.modelPath)
		if byPath then
			log("source found by path:", petDef.modelPath, "=>", byPath:GetFullName())
			return byPath
		end
		log("source miss by path:", petDef.modelPath)
	end
	local byName = ItemModelRegistry.GetByExactName("FreddyFazbear")
	if byName then
		log("source fallback by exact name =>", byName:GetFullName())
	else
		log("source miss by exact name: FreddyFazbear")
	end
	return byName
end

local function ensureFreddyRootPart(model: Model, hum: Humanoid): BasePart?
	-- 1) Prefer an actual HumanoidRootPart if present.
	local existing = model:FindFirstChild("HumanoidRootPart", true)
	if existing and existing:IsA("BasePart") then
		model.PrimaryPart = existing
		return existing
	end

	-- 2) Prefer Humanoid.RootPart if it's not UpperTorso.
	if hum.RootPart and hum.RootPart.Name ~= "UpperTorso" then
		model.PrimaryPart = hum.RootPart
		return hum.RootPart
	end

	-- 3) Try common alternate root names before creating a new HRP.
	for _, altName in ipairs({ "RootPart", "Root", "TorsoRoot", "HumanoidRoot" }) do
		local alt = model:FindFirstChild(altName, true)
		if alt and alt:IsA("BasePart") then
			model.PrimaryPart = alt
			return alt
		end
	end

	-- 4) Create a dedicated HumanoidRootPart and attach to rig root.
	local attachTo = hum.RootPart or model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart", true)
	if not attachTo then
		return nil
	end

	local hrp = Instance.new("Part")
	hrp.Name = "HumanoidRootPart"
	hrp.Size = Vector3.new(2, 2, 1)
	hrp.Transparency = 1
	hrp.CanCollide = false
	hrp.CanQuery = false
	hrp.CanTouch = false
	hrp.Anchored = false
	hrp.Massless = false
	hrp.CFrame = attachTo.CFrame
	hrp.Parent = model

	local existingRootJoint = hrp:FindFirstChild("RootJoint")
	if existingRootJoint then
		existingRootJoint:Destroy()
	end
	local rootJoint = Instance.new("Motor6D")
	rootJoint.Name = "RootJoint"
	rootJoint.Part0 = hrp
	rootJoint.Part1 = attachTo
	rootJoint.C0 = CFrame.new()
	rootJoint.C1 = attachTo.CFrame:ToObjectSpace(hrp.CFrame)
	rootJoint.Parent = hrp

	model.PrimaryPart = hrp
	return hrp
end

local function limbHasMotor(model: Model, limbName: string): boolean
	local limb = model:FindFirstChild(limbName, true)
	if not limb or not limb:IsA("BasePart") then
		return false
	end
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("Motor6D") and (d.Part0 == limb or d.Part1 == limb) then
			return true
		end
	end
	return false
end

local function auditRigJoints(model: Model): (number, number, number, string)
	local motorCount = 0
	local weldCount = 0
	local anchoredCount = 0
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("Motor6D") then
			motorCount += 1
		elseif d:IsA("WeldConstraint") then
			weldCount += 1
		elseif d:IsA("BasePart") and d.Anchored then
			anchoredCount += 1
		end
	end
	local limbReport = string.format(
		"ll=%s rl=%s la=%s ra=%s",
		tostring(limbHasMotor(model, "LeftLowerLeg")),
		tostring(limbHasMotor(model, "RightLowerLeg")),
		tostring(limbHasMotor(model, "LeftUpperArm")),
		tostring(limbHasMotor(model, "RightUpperArm"))
	)
	return motorCount, weldCount, anchoredCount, limbReport
end

local function startFollowLoop(model: Model, owner: Player, hum: Humanoid, hrp: BasePart): thread
	return task.spawn(function()
		local path = PathfindingService:CreatePath({
			AgentRadius = 2,
			AgentHeight = 5,
			AgentCanJump = true,
		})
		local waypoints: { PathWaypoint } = {}
		local waypointIndex = 1
		local lastRepath = 0
		local lastProofLog = 0
		local baseMotorCount, _, _, _ = auditRigJoints(model)

		while model.Parent do
			local char = owner.Character
			local ownerHrp = char and char:FindFirstChild("HumanoidRootPart")
			if ownerHrp and ownerHrp:IsA("BasePart") and hum.Health > 0 and model.PrimaryPart then
				local target = computeFollowTarget(ownerHrp)
				local petPos = hrp.Position
				local dist = (target - petPos).Magnitude
				local now = tick()

				if dist > STOP_DISTANCE and (now - lastRepath >= REPATH_INTERVAL or waypointIndex > #waypoints) then
					lastRepath = now
					local ok = pcall(function()
						path:ComputeAsync(petPos, target)
					end)
					if ok and path.Status == Enum.PathStatus.Success then
						waypoints = path:GetWaypoints()
						waypointIndex = 2 -- 1 is current position
					else
						waypoints = {}
						waypointIndex = 1
					end
				end

				local moveTarget = target
				if waypointIndex <= #waypoints then
					moveTarget = waypoints[waypointIndex].Position
					if (moveTarget - petPos).Magnitude <= 2.5 then
						waypointIndex += 1
					end
				end

				if dist > STOP_DISTANCE then
					-- True humanoid locomotion: navigation via MoveTo + input vector via Move.
					hum:MoveTo(moveTarget)
					local moveVec = moveTarget - petPos
					if moveVec.Magnitude > 0.05 then
						hum:Move(moveVec.Unit, false)
					end
				else
					hum:Move(Vector3.zero, false)
				end

				if now - lastProofLog >= 1.0 then
					lastProofLog = now
					local stateName = tostring(hum:GetState())
					local moveMag = hum.MoveDirection.Magnitude
					local moverFound = hasTransformMover(model)
					local motorCount, weldCount, anchoredCount, limbReport = auditRigJoints(model)
					if motorCount < baseMotorCount then
						warn(TAG, string.format(
							"joint regression owner=%s motors=%d->%d welds=%d anchored=%d",
							owner.Name, baseMotorCount, motorCount, weldCount, anchoredCount
						))
					end
					local animator = getAnimator(hum)
					local trackCount, trackInfo = getPlayingTrackSnapshot(animator)
					local stationary = dist <= STOP_DISTANCE + 0.25
					local idleWhileStill = stationary and trackCount > 0
					log(string.format(
						"proof owner=%s state=%s moveDirMag=%.3f transformFollowRan=%s dist=%.2f animator=%s tracks=%d idleWhileStill=%s trackInfo=%s motors=%d welds=%d anchored=%d limbs=%s",
						owner.Name,
						stateName,
						moveMag,
						tostring(moverFound),
						dist,
						tostring(animator ~= nil),
						trackCount,
						tostring(idleWhileStill),
						trackInfo,
						motorCount,
						weldCount,
						anchoredCount,
						limbReport
					))
				end
			end
			task.wait(LOOP_INTERVAL)
		end
	end)
end

local function spawnFor(player: Player)
	log("spawn begin owner=", player.Name)
	despawnFor(player, "respawn")

	local source = resolveFreddySource()
	if not source then
		warn(TAG, "spawn abort: Freddy source model not found")
		return
	end
	local clone = source:Clone()
	log("clone created:", clone:GetFullName(), "class=", clone.ClassName)
	if not clone:IsA("Model") then
		local wrapper = Instance.new("Model")
		wrapper.Name = clone.Name
		clone.Parent = wrapper
		clone = wrapper
		log("clone wrapped to Model:", clone:GetFullName())
	end

	clone:SetAttribute("IsPet", true)
	clone:SetAttribute("MovementMode", "Humanoid")
	clone:SetAttribute("HumanoidPet", true)
	log("attribute set IsPet=true")

	for _, d in ipairs(clone:GetDescendants()) do
		if d:IsA("BasePart") then
			d.Anchored = false
			d.CanCollide = false
			d.CanQuery = false
			d.CanTouch = false
		elseif d:IsA("BodyMover")
			or d:IsA("AlignPosition")
			or d:IsA("AlignOrientation")
			or d:IsA("LinearVelocity")
			or d:IsA("VectorForce")
			or d:IsA("LineForce")
			or d:IsA("Torque")
			or d:IsA("AngularVelocity")
			or d:IsA("RocketPropulsion")
		then
			-- Remove transform/body movers that cause glide-like non-humanoid motion.
			d:Destroy()
		elseif d:IsA("Script") or d:IsA("LocalScript") then
			-- Keep only Freddy's native animation driver; disable all others.
			if d:IsA("Script") then
				d.Disabled = not isFreddyNativeAnimationDriver(d)
			else
				d.Disabled = true
			end
		end
	end

	local hum = clone:FindFirstChildOfClass("Humanoid")
	if not hum then
		hum = clone:FindFirstChild("Humanoid", true)
	end
	if not hum or not hum:IsA("Humanoid") then
		hum = Instance.new("Humanoid")
		hum.Parent = clone
		log("humanoid created on clone")
	end
	local hrp = ensureFreddyRootPart(clone, hum)
	if not hrp or not hrp:IsA("BasePart") then
		warn(TAG, "spawn abort: Freddy pet missing root part")
		clone:Destroy()
		return
	end

	clone.PrimaryPart = hrp
	hum.WalkSpeed = math.max(hum.WalkSpeed, WALK_SPEED)
	hum.AutoRotate = true
	hum.PlatformStand = false
	hum.HipHeight = math.max(hum.HipHeight, 2.0)

	local char = player.Character
	local ownerHrp = char and char:FindFirstChild("HumanoidRootPart")
	if not ownerHrp or not ownerHrp:IsA("BasePart") then
		warn(TAG, "spawn abort: owner missing HumanoidRootPart")
		clone:Destroy()
		return
	end

	clone.Name = "_FreddyPet_" .. player.Name
	clone.Parent = getPlayerFolder(player)
	log("parent set:", clone:GetFullName())
	clone.Destroying:Connect(function()
		log("destroying:", clone.Name, "owner=", player.Name)
	end)
	clone.AncestryChanged:Connect(function(_, parent)
		if not parent then
			log("ancestry nil:", clone.Name, "owner=", player.Name)
		end
	end)

	-- Explicit post-parent placement so model appears beside owner immediately.
	local spawnPos = ownerHrp.Position - ownerHrp.CFrame.LookVector * FOLLOW_DISTANCE + ownerHrp.CFrame.RightVector * 2 + Vector3.new(0, 2.5, 0)
	clone:PivotTo(CFrame.new(spawnPos))

	-- Debug verification block requested by user.
	local modelPos = clone:GetPivot().Position
	local dist = (modelPos - ownerHrp.Position).Magnitude
	log(string.format("post-spawn root=%s modelPos=(%.1f, %.1f, %.1f) distFromOwner=%.1f",
		hrp.Name, modelPos.X, modelPos.Y, modelPos.Z, dist))

	-- Safety clamp for visibility during debugging.
	if dist > 40 or modelPos.Y < -20 or modelPos.Y > 1500 then
		local safePos = ownerHrp.Position + ownerHrp.CFrame.RightVector * 3 + Vector3.new(0, 2.5, 0)
		clone:PivotTo(CFrame.new(safePos))
		local clampedPos = clone:GetPivot().Position
		log(string.format("visibility clamp applied pos=(%.1f, %.1f, %.1f)",
			clampedPos.X, clampedPos.Y, clampedPos.Z))
	end

	pcall(function() hrp:SetNetworkOwner(nil) end)
	log("network owner set to server")
	local animateSource = ensureAnimateScript(clone)
	log("animate source:", animateSource)
	log("transform movers present after sanitize:", hasTransformMover(clone))
	local motorCount, weldCount, anchoredCount, limbReport = auditRigJoints(clone)
	log(string.format(
		"rig audit motors=%d welds=%d anchored=%d limbs=%s",
		motorCount, weldCount, anchoredCount, limbReport
	))
	local animatorAfterSpawn = getAnimator(hum)
	local trackCountAfterSpawn, trackInfoAfterSpawn = getPlayingTrackSnapshot(animatorAfterSpawn)
	log(string.format(
		"spawn anim-proof animator=%s tracks=%d trackInfo=%s",
		tostring(animatorAfterSpawn ~= nil),
		trackCountAfterSpawn,
		trackInfoAfterSpawn
	))
	hum.StateChanged:Connect(function(_, newState)
		log("state changed:", tostring(newState))
	end)
	hum.Running:Connect(function(speed)
		if speed > 0.5 then
			log(string.format("running speed=%.2f", speed))
		end
	end)
	local thread = startFollowLoop(clone, player, hum, hrp)
	_active[player] = { model = clone, thread = thread }
	log("spawn success owner=", player.Name, "model=", clone.Name)
end

local FreddyPetServerController = {}

function FreddyPetServerController.Init()
	EquipRemote.OnServerEvent:Connect(function(player: Player)
		log("equip remote from", player.Name)
		spawnFor(player)
	end)
	UnequipRemote.OnServerEvent:Connect(function(player: Player)
		log("unequip remote from", player.Name)
		despawnFor(player, "remote_unequip")
	end)
	Players.PlayerRemoving:Connect(function(player)
		despawnFor(player, "player_removing")
	end)
	log("initialized")
end

return FreddyPetServerController

]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="61">
        <Properties>
          <string name="Name">GlobalLeaderboardService</string>
          <string name="Source">--[[
	GlobalLeaderboardService
	Manages global Top-N leaderboards via OrderedDataStore.
	Renders SurfaceGuis on lobby boards in Workspace.LobbyStuff.

	Boards (storeKey -&gt; part):
	  "WeeklyWins"    -&gt; "Weekly Wins"
	  "LifetimeWins"  -&gt; "Lifetime Wins"
	  "WeeklyCoins"   -&gt; "Weekly Coins Achieved"
	  "LifetimeCoins" -&gt; "Lifetime Coins Achieved"
	  "CrownsFound"   -&gt; "Lifetime Crowns Found"

	Stat updates arrive via DIRECT MODULE CALLS from producer services
	(EconomyService, MatchManager, InventoryService).
	No BindableEvent pipeline -- just require() + function call.

	STUDIO MODE:
	  When RunService:IsStudio(), all leaderboard data is kept IN-MEMORY only.
	  No OrderedDataStore reads or writes happen. This ensures:
	    - No stale entries from previous test runs
	    - No ODS throttling in rapid test iterations
	    - Boards reflect ONLY the current server session
	  Production (non-studio) behavior is completely unchanged.

	API:
		Init()
		ReportStat(player, statKey, newValue)
		ReportStatById(userId, statKey, newValue)
		SeedPlayerBoardsFromSavedData(userId, savedData)
		RefreshAll()
		RefreshBoard(storeKey)
		GetWeekId() -&gt; string
		RemovePlayerEntries(userId)
		ClearSeedFlag(userId)
		ClearAllBoards()
		DumpBoardState()
		PurgeTestEntries()
]]

local DataStoreService    = game:GetService("DataStoreService")
local HttpService         = game:GetService("HttpService")
local Players             = game:GetService("Players")
local RunService          = game:GetService("RunService")

local IS_STUDIO = RunService:IsStudio()

local GlobalLeaderboardService = {}

-- =====================================================================
-- CONFIGURATION
-- =====================================================================

local LEADERBOARD_SEASON = "S2"

local TOP_N            = 10
local REFRESH_INTERVAL = 45
local DEBOUNCE_TIME    = 3
local PIXELS_PER_STUD  = 20

local BG_COLOR           = Color3.fromRGB(12, 12, 22)
local ROW_ALT_COLOR      = Color3.fromRGB(30, 30, 45)
local HEADER_TEXT_COLOR  = Color3.fromRGB(140, 140, 160)
local NAME_TEXT_COLOR    = Color3.fromRGB(255, 255, 255)

local RANK_COLORS = {
	[1] = Color3.fromRGB(255, 215, 0),
	[2] = Color3.fromRGB(200, 200, 220),
	[3] = Color3.fromRGB(205, 127, 50),
}
local DEFAULT_RANK_COLOR = Color3.fromRGB(180, 180, 195)

local BOARDS = {
	{
		partName = "Weekly Wins",
		storeKey = "WeeklyWins",
		weekly   = true,
		title    = "WEEKLY WINS",
		accent   = Color3.fromRGB(255, 200, 50),
	},
	{
		partName = "Lifetime Wins",
		storeKey = "LifetimeWins",
		weekly   = false,
		title    = "LIFETIME WINS",
		accent   = Color3.fromRGB(255, 140, 50),
	},
	{
		partName = "Weekly Coins Achieved",
		storeKey = "WeeklyCoins",
		weekly   = true,
		title    = "WEEKLY COINS EARNED",
		accent   = Color3.fromRGB(50, 220, 120),
	},
	{
		partName = "Lifetime Coins Achieved",
		storeKey = "LifetimeCoins",
		weekly   = false,
		title    = "LIFETIME COINS EARNED",
		accent   = Color3.fromRGB(50, 180, 255),
	},
	{
		partName = "Lifetime Crowns Found",
		storeKey = "CrownsFound",
		weekly   = false,
		title    = "CROWNS FOUND",
		accent   = Color3.fromRGB(220, 150, 255),
	},
}

local boardDefsByKey = {}
for _, bd in ipairs(BOARDS) do
	boardDefsByKey[bd.storeKey] = bd
end

-- =====================================================================
-- STATE
-- =====================================================================

local orderedStores = {}
local cachedEntries = {}
local boardParts    = {}
local initialized   = false

local lastWriteTime  = {}
local pendingWrites  = {}
local pendingTimers  = {}
local seededPlayers  = {}

local studioMemoryBoards = {}

-- =====================================================================
-- HELPERS
-- =====================================================================

local function isValidUserId(userId): boolean
	if type(userId) ~= "number" then return false end
	if math.floor(userId) ~= userId then return false end
	if userId == 0 then return false end
	if userId &gt; 0 then return true end
	return IS_STUDIO
end

local function resolveUsername(userId: number): string
	if userId &gt; 0 then
		local ok, name = pcall(function()
			return Players:GetNameFromUserIdAsync(userId)
		end)
		if ok and name then return name end
		task.wait(0.5)
		local ok2, name2 = pcall(function()
			return Players:GetNameFromUserIdAsync(userId)
		end)
		if ok2 and name2 then return name2 end
		warn(string.format("[GLBS] Username lookup failed for userId=%d after retry", userId))
		return "UserId:" .. tostring(userId)
	end

	local player = Players:GetPlayerByUserId(userId)
	if player then return player.Name end
	return "Player" .. tostring(math.abs(userId))
end

local function cancelPendingWritesForUser(userId: number)
	local uidStr = tostring(userId)
	for debounceKey, pending in pairs(pendingWrites) do
		if pending.userId == userId then
			pendingWrites[debounceKey] = nil
			warn(string.format("[GLBS] Cancelled pending write: %s for userId=%d", debounceKey, userId))
		end
	end
end

-- =====================================================================
-- WEEK ID
-- =====================================================================

function GlobalLeaderboardService.GetWeekId(): string
	return os.date("!%Y_W%W")
end

local function getFullStoreKey(boardDef): string
	local base = boardDef.storeKey
	if boardDef.weekly then
		base = base .. "_" .. GlobalLeaderboardService.GetWeekId()
	end
	return LEADERBOARD_SEASON .. "_" .. base
end

local function getOrderedStore(boardDef)
	local key = getFullStoreKey(boardDef)
	if orderedStores[key] then return orderedStores[key] end

	local ok, store = pcall(function()
		return DataStoreService:GetOrderedDataStore(key)
	end)
	if ok and store then
		orderedStores[key] = store
		return store
	end
	warn("[GLBS] Failed to get OrderedDataStore:", key, "err:", tostring(store))
	return nil
end

-- =====================================================================
-- FETCH
-- =====================================================================

local function fetchTopN(boardDef)
	if IS_STUDIO then
		local memBoard = studioMemoryBoards[boardDef.storeKey] or {}
		local results = {}
		for uidStr, val in pairs(memBoard) do
			local uid = tonumber(uidStr)
			if uid and type(val) == "number" and val &gt; 0 and isValidUserId(uid) then
				local name = resolveUsername(uid)
				table.insert(results, { userId = uid, name = name, value = val })
			end
		end
		table.sort(results, function(a, b) return a.value &gt; b.value end)
		while #results &gt; TOP_N do
			table.remove(results)
		end
		if #results &gt; 0 then
			warn(string.format("[GLBS:Studio] FetchTop key=%s entries=%d top1=%s:%d",
				boardDef.storeKey, #results, results[1].name, results[1].value))
		else
			warn(string.format("[GLBS:Studio] FetchTop key=%s entries=0 EMPTY", boardDef.storeKey))
		end
		return results
	end

	local fullKey = getFullStoreKey(boardDef)
	local store = getOrderedStore(boardDef)
	if not store then
		warn("[GLBS] FetchTop ABORTED: no store for key=" .. fullKey)
		return nil
	end

	local ok, pages = pcall(function()
		return store:GetSortedAsync(false, TOP_N)
	end)
	if not ok or not pages then
		warn("[GLBS] FetchTop FAILED key=" .. fullKey .. " err=" .. tostring(pages))
		return nil
	end

	local ok2, pageEntries = pcall(function()
		return pages:GetCurrentPage()
	end)
	if not ok2 or not pageEntries then
		warn("[GLBS] FetchTop GetCurrentPage FAILED key=" .. fullKey .. " err=" .. tostring(pageEntries))
		return nil
	end

	local results = {}
	for i, entry in ipairs(pageEntries) do
		local rawKey = entry.key
		local userId = tonumber(rawKey)
		local value  = entry.value
		warn(string.format("[GLBS] Entry %d: rawKey=%s userId=%s value=%s",
			i, tostring(rawKey), tostring(userId), tostring(value)))

		if not isValidUserId(userId) then
			warn(string.format("[GLBS] Skipping entry %d: invalid userId=%s (studio=%s)",
				i, tostring(rawKey), tostring(IS_STUDIO)))
			continue
		end

		if type(value) ~= "number" or value &lt;= 0 then
			warn(string.format("[GLBS] Skipping entry %d: invalid value=%s", i, tostring(value)))
			continue
		end

		local name = resolveUsername(userId)
		table.insert(results, { userId = userId, name = name, value = value })
	end

	if #results &gt; 0 then
		warn(string.format("[GLBS] FetchTop key=%s entries=%d top1=%s:%d",
			fullKey, #results, results[1].name, results[1].value))
	else
		warn(string.format("[GLBS] FetchTop key=%s entries=0 EMPTY", fullKey))
	end

	return results
end

-- =====================================================================
-- WRITE
-- =====================================================================

local function writeAndRefresh(boardDef, userId: number, intValue: number)
	task.spawn(function()
		if not isValidUserId(userId) then
			warn(string.format("[GLBS] Skipping write invalid userId: userId=%s value=%s (studio=%s)",
				tostring(userId), tostring(intValue), tostring(IS_STUDIO)))
			return
		end
		if type(intValue) ~= "number" or intValue &lt;= 0 then
			warn(string.format("[GLBS] Skipping write invalid value: userId=%s value=%s",
				tostring(userId), tostring(intValue)))
			return
		end

		if IS_STUDIO then
			if not studioMemoryBoards[boardDef.storeKey] then
				studioMemoryBoards[boardDef.storeKey] = {}
			end
			studioMemoryBoards[boardDef.storeKey][tostring(userId)] = intValue
			warn(string.format("[GLBS:Studio] MEM WRITE: key=%s userId=%d value=%d",
				boardDef.storeKey, userId, intValue))
			task.wait(0.1)
			GlobalLeaderboardService.RefreshBoard(boardDef.storeKey)
			return
		end

		local fullKey = getFullStoreKey(boardDef)
		local store = getOrderedStore(boardDef)
		if not store then
			warn("[GLBS] ODS WRITE ABORTED -- no store for key=" .. fullKey)
			return
		end

		warn(string.format("[GLBS] ODS WRITE ATTEMPT: key=%s userId=%d value=%d",
			fullKey, userId, intValue))

		local ok, err = pcall(function()
			store:SetAsync(tostring(userId), intValue)
		end)

		if ok then
			warn(string.format("[GLBS] ODS WRITE SUCCESS: key=%s userId=%d value=%d",
				fullKey, userId, intValue))
			task.wait(1)
			warn("[GLBS] Triggering targeted refresh for board: " .. boardDef.storeKey)
			GlobalLeaderboardService.RefreshBoard(boardDef.storeKey)
		else
			warn(string.format("[GLBS] ODS WRITE FAILED: key=%s userId=%d value=%d err=%s",
				fullKey, userId, intValue, tostring(err)))
		end
	end)
end

-- =====================================================================
-- REPORT STAT (PUBLIC API)
-- =====================================================================

function GlobalLeaderboardService.ReportStatById(userId: number, statKey: string, newValue: number)
	warn(string.format("[GLBS] ReportStatById CALLED: statKey=%s value=%s userId=%s",
		tostring(statKey), tostring(newValue), tostring(userId)))

	if not isValidUserId(userId) then
		warn(string.format("[GLBS] Skipping: invalid userId=%s (studio=%s)",
			tostring(userId), tostring(IS_STUDIO)))
		return
	end

	if type(newValue) ~= "number" or newValue &lt;= 0 then
		warn(string.format("[GLBS] Skipping: invalid value=%s userId=%s",
			tostring(newValue), tostring(userId)))
		return
	end

	local boardDef = boardDefsByKey[statKey]
	if not boardDef then
		warn("[GLBS] ReportStatById ABORTED: unknown statKey: " .. tostring(statKey))
		local keys = {}
		for k in pairs(boardDefsByKey) do table.insert(keys, k) end
		warn("[GLBS] Available storeKeys: " .. table.concat(keys, ", "))
		return
	end

	local intValue = math.floor(newValue)
	local debounceKey = tostring(userId) .. "_" .. statKey
	local now = tick()
	local lastTime = lastWriteTime[debounceKey] or 0
	local elapsed = now - lastTime

	if elapsed &gt;= DEBOUNCE_TIME then
		lastWriteTime[debounceKey] = now
		warn(string.format("[GLBS] IMMEDIATE write: %s=%d userId=%d elapsed=%.1fs",
			statKey, intValue, userId, elapsed))
		writeAndRefresh(boardDef, userId, intValue)
	else
		pendingWrites[debounceKey] = {
			boardDef = boardDef,
			userId   = userId,
			value    = intValue,
		}
		warn(string.format("[GLBS] QUEUED write: %s=%d userId=%d (%.1fs until flush)",
			statKey, intValue, userId, DEBOUNCE_TIME - elapsed))

		if not pendingTimers[debounceKey] then
			pendingTimers[debounceKey] = true
			local remaining = DEBOUNCE_TIME - elapsed
			task.delay(remaining + 0.1, function()
				pendingTimers[debounceKey] = nil
				local pending = pendingWrites[debounceKey]
				pendingWrites[debounceKey] = nil
				if pending then
					lastWriteTime[debounceKey] = tick()
					warn(string.format("[GLBS] DEFERRED write: %s=%d userId=%d",
						statKey, pending.value, pending.userId))
					writeAndRefresh(pending.boardDef, pending.userId, pending.value)
				end
			end)
		end
	end
end

function GlobalLeaderboardService.ReportStat(player: Player, statKey: string, newValue: number)
	if not player or not player.Parent then
		warn("[GLBS] ReportStat ABORTED: player nil or no parent")
		return
	end
	GlobalLeaderboardService.ReportStatById(player.UserId, statKey, newValue)
end

-- =====================================================================
-- SEED PLAYER BOARDS FROM SAVED DATA
-- =====================================================================

function GlobalLeaderboardService.SeedPlayerBoardsFromSavedData(userId: number, savedData: {[string]: any})
	if not isValidUserId(userId) then
		warn("[GLBS:Seed] ABORTED: invalid userId=" .. tostring(userId))
		return
	end
	if seededPlayers[userId] then
		warn("[GLBS:Seed] SKIPPED: userId=" .. tostring(userId) .. " already seeded this session")
		return
	end
	seededPlayers[userId] = true

	if not savedData or type(savedData) ~= "table" then
		warn("[GLBS:Seed] ABORTED: no savedData for userId=" .. tostring(userId))
		return
	end

	local crownsEarned = 0
	do
		local ownedCrowns = savedData.OwnedCrowns
		if type(ownedCrowns) == "table" then
			local starterCrowns = { ["crown_basic"] = true }
			for _, cid in ipairs(ownedCrowns) do
				if type(cid) == "string" and not starterCrowns[cid] then
					crownsEarned = crownsEarned + 1
				end
			end
		end
	end

	local statsToSeed = {
		{ key = "LifetimeWins",  value = savedData.LifetimeWins or 0 },
		{ key = "WeeklyWins",    value = savedData.WeeklyWins or 0 },
		{ key = "LifetimeCoins", value = savedData.LifetimeCoinsAchieved or 0 },
		{ key = "WeeklyCoins",   value = savedData.WeeklyCoinsAchieved or 0 },
		{ key = "CrownsFound",   value = crownsEarned },
	}

	warn(string.format("[GLBS:Seed] === SEEDING userId=%d (studio=%s) ===", userId, tostring(IS_STUDIO)))
	local seededCount = 0
	for _, stat in ipairs(statsToSeed) do
		if stat.value &gt; 0 then
			warn(string.format("[GLBS:Seed]   %s = %d (userId=%d)", stat.key, stat.value, userId))
			GlobalLeaderboardService.ReportStatById(userId, stat.key, stat.value)
			seededCount += 1
			task.wait(0.3)
		else
			warn(string.format("[GLBS:Seed]   %s = 0 (SKIP) (userId=%d)", stat.key, userId))
		end
	end

	if seededCount &gt; 0 then
		task.delay(2, function()
			warn("[GLBS:Seed] Post-seed RefreshAll for userId=" .. tostring(userId))
			GlobalLeaderboardService.RefreshAll()
		end)
		warn(string.format("[GLBS:Seed] === SEEDED %d stats for userId=%d (RefreshAll in 2s) ===", seededCount, userId))
	else
		warn(string.format("[GLBS:Seed] === NO stats to seed for userId=%d (all zero) ===", userId))
	end
end

Players.PlayerRemoving:Connect(function(player)
	seededPlayers[player.UserId] = nil
end)

-- =====================================================================
-- RENDER HELPERS
-- =====================================================================

local function formatNumber(n: number): string
	local s = tostring(math.floor(n))
	local formatted = s
	local k
	repeat
		formatted, k = string.gsub(formatted, "^(-?%d+)(%d%d%d)", "%1,%2")
	until k == 0
	return formatted
end

local function makeLabel(parent, props)
	local label = Instance.new("TextLabel")
	label.Name                = props.name or "Label"
	label.Size                = props.size or UDim2.fromScale(1, 1)
	label.Position            = props.position or UDim2.fromScale(0, 0)
	label.AnchorPoint         = props.anchor or Vector2.new(0, 0)
	label.BackgroundTransparency = 1
	label.Text                = props.text or ""
	label.TextColor3          = props.color or Color3.new(1, 1, 1)
	label.TextSize            = props.textSize or 20
	label.Font                = props.font or Enum.Font.GothamMedium
	label.TextXAlignment      = props.xAlign or Enum.TextXAlignment.Left
	label.TextYAlignment      = Enum.TextYAlignment.Center
	label.TextTruncate        = props.truncate or Enum.TextTruncate.None
	label.Parent              = parent

	local strokeT = props.strokeThickness
	if strokeT == nil then strokeT = 2 end
	if strokeT &gt; 0 then
		local stroke = Instance.new("UIStroke")
		stroke.Thickness    = strokeT
		stroke.Color        = Color3.fromRGB(0, 0, 0)
		stroke.Transparency = 0.1
		stroke.Parent       = label
	end

	return label
end

-- =====================================================================
-- RENDER BOARD
-- =====================================================================

local function renderBoard(boardDef, entries)
	local part = boardParts[boardDef.partName]
	if not part then return end

	local guiName = "LeaderboardGui"
	local old = part:FindFirstChild(guiName)
	if old then old:Destroy() end

	local gui = Instance.new("SurfaceGui")
	gui.Name              = guiName
	gui.Face              = Enum.NormalId.Front
	gui.AlwaysOnTop       = false
	gui.LightInfluence    = 0
	gui.ClipsDescendants  = true
	gui.ZOffset           = 1
	gui.SizingMode        = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud     = PIXELS_PER_STUD
	gui.ResetOnSpawn      = false
	gui.ZIndexBehavior    = Enum.ZIndexBehavior.Sibling
	gui.Parent            = part

	local canvasH    = part.Size.Y * PIXELS_PER_STUD
	local titleSize  = math.max(28, math.floor(canvasH * 0.048))
	local headerSize = math.max(16, math.floor(canvasH * 0.022))
	local rowSize    = math.max(18, math.floor(canvasH * 0.028))
	local rowBold    = math.max(20, math.floor(canvasH * 0.030))

	local accent = boardDef.accent

	local bg = Instance.new("Frame")
	bg.Name              = "Background"
	bg.Size              = UDim2.fromScale(1, 1)
	bg.BackgroundColor3  = BG_COLOR
	bg.BorderSizePixel   = 0
	bg.ClipsDescendants  = true
	bg.Parent            = gui

	local bar = Instance.new("Frame")
	bar.Name             = "AccentBar"
	bar.Size             = UDim2.new(1, 0, 0.006, 0)
	bar.Position         = UDim2.fromScale(0, 0)
	bar.BackgroundColor3 = accent
	bar.BorderSizePixel  = 0
	bar.Parent           = bg

	makeLabel(bg, {
		name = "Title", text = boardDef.title,
		size = UDim2.new(0.9, 0, 0.08, 0),
		position = UDim2.new(0.5, 0, 0.055, 0),
		anchor = Vector2.new(0.5, 0.5),
		color = accent, textSize = titleSize,
		font = Enum.Font.GothamBlack,
		xAlign = Enum.TextXAlignment.Center,
		strokeThickness = 2.5,
	})

	local divider = Instance.new("Frame")
	divider.Name = "Divider"
	divider.Size = UDim2.new(0.85, 0, 0, 2)
	divider.AnchorPoint = Vector2.new(0.5, 0)
	divider.Position = UDim2.new(0.5, 0, 0.1, 0)
	divider.BackgroundColor3 = accent
	divider.BackgroundTransparency = 0.5
	divider.BorderSizePixel = 0
	divider.Parent = bg

	local headerFrame = Instance.new("Frame")
	headerFrame.Name = "Header"
	headerFrame.Size = UDim2.new(0.9, 0, 0.035, 0)
	headerFrame.AnchorPoint = Vector2.new(0.5, 0)
	headerFrame.Position = UDim2.new(0.5, 0, 0.11, 0)
	headerFrame.BackgroundTransparency = 1
	headerFrame.Parent = bg

	makeLabel(headerFrame, { name = "HRank", text = "#", size = UDim2.fromScale(0.15, 1),
		color = HEADER_TEXT_COLOR, textSize = headerSize, font = Enum.Font.GothamBold,
		xAlign = Enum.TextXAlignment.Center, strokeThickness = 1.5 })
	makeLabel(headerFrame, { name = "HName", text = "PLAYER", size = UDim2.fromScale(0.55, 1),
		position = UDim2.fromScale(0.15, 0), color = HEADER_TEXT_COLOR, textSize = headerSize,
		font = Enum.Font.GothamBold, xAlign = Enum.TextXAlignment.Left, strokeThickness = 1.5 })
	makeLabel(headerFrame, { name = "HValue", text = "SCORE", size = UDim2.fromScale(0.3, 1),
		position = UDim2.fromScale(0.7, 0), color = HEADER_TEXT_COLOR, textSize = headerSize,
		font = Enum.Font.GothamBold, xAlign = Enum.TextXAlignment.Right, strokeThickness = 1.5 })

	local rowContainer = Instance.new("Frame")
	rowContainer.Name = "Rows"
	rowContainer.Size = UDim2.new(0.92, 0, 0.83, 0)
	rowContainer.AnchorPoint = Vector2.new(0.5, 0)
	rowContainer.Position = UDim2.new(0.5, 0, 0.155, 0)
	rowContainer.BackgroundTransparency = 1
	rowContainer.ClipsDescendants = true
	rowContainer.Parent = bg

	local rowLayout = Instance.new("UIListLayout")
	rowLayout.SortOrder = Enum.SortOrder.LayoutOrder
	rowLayout.Padding = UDim.new(0.005, 0)
	rowLayout.Parent = rowContainer

	if #entries == 0 then
		makeLabel(rowContainer, {
			name = "NoData", text = "No entries yet...",
			size = UDim2.fromScale(1, 0.15),
			color = Color3.fromRGB(100, 100, 120), textSize = rowSize,
			font = Enum.Font.GothamMedium, xAlign = Enum.TextXAlignment.Center,
		})
	else
		local rowHeightScale = 0.085
		for i, entry in ipairs(entries) do
			if i &gt; TOP_N then break end
			local row = Instance.new("Frame")
			row.Name = "Row" .. i
			row.Size = UDim2.new(1, 0, rowHeightScale, 0)
			row.LayoutOrder = i
			row.BorderSizePixel = 0
			row.Parent = rowContainer
			if i % 2 == 0 then
				row.BackgroundColor3 = ROW_ALT_COLOR
				row.BackgroundTransparency = 0.5
			else
				row.BackgroundTransparency = 1
			end
			local rc = Instance.new("UICorner")
			rc.CornerRadius = UDim.new(0, 4)
			rc.Parent = row

			local rankColor = RANK_COLORS[i] or DEFAULT_RANK_COLOR
			makeLabel(row, { name = "Rank", text = "#" .. i, size = UDim2.fromScale(0.15, 1),
				color = rankColor, textSize = rowBold, font = Enum.Font.GothamBold,
				xAlign = Enum.TextXAlignment.Center })
			makeLabel(row, { name = "Name", text = entry.name, size = UDim2.fromScale(0.55, 1),
				position = UDim2.fromScale(0.15, 0),
				color = (i &lt;= 3) and rankColor or NAME_TEXT_COLOR, textSize = rowSize,
				font = Enum.Font.GothamMedium, xAlign = Enum.TextXAlignment.Left,
				truncate = Enum.TextTruncate.AtEnd })
			makeLabel(row, { name = "Value", text = formatNumber(entry.value),
				size = UDim2.fromScale(0.3, 1), position = UDim2.fromScale(0.7, 0),
				color = accent, textSize = rowBold, font = Enum.Font.GothamBold,
				xAlign = Enum.TextXAlignment.Right })
		end
	end

	warn(string.format("[GLBS] Rendered '%s' with %d entries", boardDef.title, #entries))
end

-- =====================================================================
-- PUBLIC API
-- =====================================================================

function GlobalLeaderboardService.RefreshBoard(storeKey: string)
	local boardDef = boardDefsByKey[storeKey]
	if not boardDef then
		warn("[GLBS] RefreshBoard: unknown storeKey " .. tostring(storeKey))
		return
	end
	local entries = fetchTopN(boardDef)
	if entries then
		cachedEntries[boardDef.storeKey] = entries
	end
	renderBoard(boardDef, cachedEntries[boardDef.storeKey] or {})
end

function GlobalLeaderboardService.RefreshAll()
	warn("[GLBS] RefreshAll starting...")
	for _, boardDef in ipairs(BOARDS) do
		local entries = fetchTopN(boardDef)
		if entries then
			cachedEntries[boardDef.storeKey] = entries
		end
		renderBoard(boardDef, cachedEntries[boardDef.storeKey] or {})
	end
	warn("[GLBS] RefreshAll complete")
end

function GlobalLeaderboardService.RemovePlayerEntries(userId: number)
	if type(userId) ~= "number" or userId == 0 then return end

	warn(string.format("[GLBS] RemovePlayerEntries userId=%d (studio=%s)", userId, tostring(IS_STUDIO)))

	seededPlayers[userId] = nil
	cancelPendingWritesForUser(userId)

	if IS_STUDIO then
		local removedCount = 0
		for _, boardDef in ipairs(BOARDS) do
			local memBoard = studioMemoryBoards[boardDef.storeKey]
			if memBoard then
				if memBoard[tostring(userId)] ~= nil then
					memBoard[tostring(userId)] = nil
					removedCount += 1
					warn(string.format("[GLBS:Studio] MEM REMOVE: key=%s userId=%d", boardDef.storeKey, userId))
				end
			end
		end

		for key, _ in pairs(cachedEntries) do
			cachedEntries[key] = nil
		end

		warn(string.format("[GLBS] Removed %d entries for userId=%d — flushing cache + refreshing all boards", removedCount, userId))
		GlobalLeaderboardService.RefreshAll()
		return
	end

	if userId &lt;= 0 then return end

	for _, boardDef in ipairs(BOARDS) do
		local fullKey = getFullStoreKey(boardDef)
		local store = getOrderedStore(boardDef)
		if store then
			warn(string.format("[GLBS] RemoveAsync: store=%s userId=%d", fullKey, userId))
			local ok, err = pcall(function()
				store:RemoveAsync(tostring(userId))
			end)
			if ok then
				warn(string.format("[GLBS] Removed userId=%d from %s", userId, fullKey))
			else
				warn(string.format("[GLBS] RemoveAsync failed for userId=%d from %s: %s", userId, fullKey, tostring(err)))
			end
			task.wait(0.5)
		else
			warn(string.format("[GLBS] RemoveAsync SKIPPED: no store for %s", fullKey))
		end
	end

	for key, _ in pairs(cachedEntries) do
		cachedEntries[key] = nil
	end

	GlobalLeaderboardService.RefreshAll()
end

function GlobalLeaderboardService.ClearSeedFlag(userId: number)
	seededPlayers[userId] = nil
	warn(string.format("[GLBS] Cleared seed flag for userId=%d", userId))
end

function GlobalLeaderboardService.ClearAllBoards()
	warn("[GLBS] ClearAllBoards called — wiping ALL data")

	for key, _ in pairs(pendingWrites) do
		pendingWrites[key] = nil
	end

	for key, _ in pairs(seededPlayers) do
		seededPlayers[key] = nil
	end

	if IS_STUDIO then
		for _, boardDef in ipairs(BOARDS) do
			studioMemoryBoards[boardDef.storeKey] = {}
		end
		warn("[GLBS:Studio] All memory boards cleared")
	else
		for _, boardDef in ipairs(BOARDS) do
			local fullKey = getFullStoreKey(boardDef)
			local store = getOrderedStore(boardDef)
			if store then
				local ok, pages = pcall(function()
					return store:GetSortedAsync(false, 100)
				end)
				if ok and pages then
					local ok2, entries = pcall(function()
						return pages:GetCurrentPage()
					end)
					if ok2 and entries then
						for _, e in ipairs(entries) do
							pcall(function()
								store:RemoveAsync(e.key)
							end)
							task.wait(0.5)
						end
						warn(string.format("[GLBS] Cleared %d entries from %s", #entries, fullKey))
					end
				end
			end
		end
	end

	for key, _ in pairs(cachedEntries) do
		cachedEntries[key] = nil
	end

	GlobalLeaderboardService.RefreshAll()
	warn("[GLBS] ClearAllBoards complete — all boards refreshed")
end

function GlobalLeaderboardService.DumpBoardState()
	warn("[GLBS] === BOARD STATE DUMP ===")
	warn(string.format("[GLBS] IS_STUDIO=%s  SEASON=%s", tostring(IS_STUDIO), LEADERBOARD_SEASON))

	for _, boardDef in ipairs(BOARDS) do
		local key = boardDef.storeKey
		local fullKey = getFullStoreKey(boardDef)
		warn(string.format("[GLBS]   Board: %s  fullKey=%s", key, fullKey))

		if IS_STUDIO then
			local mem = studioMemoryBoards[key]
			if mem then
				local count = 0
				for uid, val in pairs(mem) do
					warn(string.format("[GLBS]     MEM: userId=%s value=%s", uid, tostring(val)))
					count += 1
				end
				if count == 0 then
					warn("[GLBS]     MEM: (empty)")
				end
			else
				warn("[GLBS]     MEM: (nil — never written)")
			end
		end

		local cached = cachedEntries[key]
		if cached then
			warn(string.format("[GLBS]     CACHE: %d entries", #cached))
			for i, e in ipairs(cached) do
				warn(string.format("[GLBS]       #%d %s (userId=%d) = %d", i, e.name, e.userId, e.value))
			end
		else
			warn("[GLBS]     CACHE: (nil)")
		end
	end

	local pendingCount = 0
	for k, v in pairs(pendingWrites) do
		warn(string.format("[GLBS]   PENDING WRITE: %s -&gt; userId=%d val=%d", k, v.userId, v.value))
		pendingCount += 1
	end
	if pendingCount == 0 then
		warn("[GLBS]   PENDING WRITES: (none)")
	end

	warn("[GLBS] === END DUMP ===")
end

function GlobalLeaderboardService.PurgeTestEntries()
	if IS_STUDIO then
		warn("[GLBS:Purge] Skipped (Studio mode)")
		return
	end

	warn("[GLBS:Purge] Scanning all boards for negative userId entries...")
	local totalRemoved = 0

	for _, boardDef in ipairs(BOARDS) do
		local fullKey = getFullStoreKey(boardDef)
		local okS, store = pcall(DataStoreService.GetOrderedDataStore, DataStoreService, fullKey)
		if not okS or not store then continue end

		local okP, pages = pcall(store.GetSortedAsync, store, false, 100)
		if not okP or not pages then continue end
		local okE, entries = pcall(pages.GetCurrentPage, pages)
		if not okE or not entries then continue end

		for _, e in ipairs(entries) do
			local uid = tonumber(e.key)
			if uid and uid &lt;= 0 then
				local okR, errR = pcall(function()
					store:RemoveAsync(e.key)
				end)
				if okR then
					totalRemoved += 1
					warn(string.format("[GLBS:Purge] Removed key=%s val=%s from %s", e.key, tostring(e.value), fullKey))
				else
					warn(string.format("[GLBS:Purge] RemoveAsync FAILED key=%s from %s: %s", e.key, fullKey, tostring(errR)))
				end
				task.wait(0.6)
			end
		end
	end

	if totalRemoved &gt; 0 then
		warn(string.format("[GLBS:Purge] Done -- removed %d test entries", totalRemoved))
		GlobalLeaderboardService.RefreshAll()
	else
		warn("[GLBS:Purge] Done -- no test entries found")
	end
end

function GlobalLeaderboardService.Init()
	if initialized then
		warn("[GLBS] Already initialized")
		return
	end
	initialized = true

	warn(string.format("[GLBS] Init (IS_STUDIO=%s, season=%s) -- %s",
		tostring(IS_STUDIO), LEADERBOARD_SEASON,
		IS_STUDIO and "IN-MEMORY MODE (no ODS reads/writes)" or "PRODUCTION MODE (OrderedDataStore)"))

	local lobbyStuff = workspace:FindFirstChild("LobbyStuff")
	if not lobbyStuff then
		warn("[GLBS] Workspace.LobbyStuff not found!")
		return
	end

	for _, boardDef in ipairs(BOARDS) do
		local part = lobbyStuff:FindFirstChild(boardDef.partName)
		if part and part:IsA("BasePart") then
			boardParts[boardDef.partName] = part
			warn(string.format("[GLBS] Found part '%s' size=%.0fx%.0f", boardDef.partName, part.Size.X, part.Size.Y))
		else
			warn(string.format("[GLBS] Part '%s' NOT FOUND", boardDef.partName))
		end
	end

	warn("[GLBS] === STORE KEY MAPPING ===")
	for _, bd in ipairs(BOARDS) do
		warn(string.format("[GLBS]   storeKey='%s' -&gt; part='%s' weekly=%s fullKey='%s'",
			bd.storeKey, bd.partName, tostring(bd.weekly), getFullStoreKey(bd)))
	end
	warn("[GLBS] =========================")

	for _, boardDef in ipairs(BOARDS) do
		renderBoard(boardDef, {})
	end

	task.spawn(function()
		task.wait(3)
		GlobalLeaderboardService.PurgeTestEntries()
		GlobalLeaderboardService.RefreshAll()

		while true do
			task.wait(REFRESH_INTERVAL)
			GlobalLeaderboardService.RefreshAll()
		end
	end)

	warn("[GLBS] Init complete -- refresh every " .. REFRESH_INTERVAL .. "s")
end

GlobalLeaderboardService.SEASON = LEADERBOARD_SEASON

return GlobalLeaderboardService</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="62">
        <Properties>
          <string name="Name">GrantService</string>
          <string name="Source"><![CDATA[--[[
	GrantService
	Central server-authoritative grant pipeline for all reward types.

	API:
	  Init()
	  GrantItem(player, itemType, itemIdOrAmount, source, meta) -> { success, reason?, alreadyProcessed?, alreadyOwned?, payload? }
	  EmitRewardGranted(player, payload)
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Server = ServerScriptService:WaitForChild("Server")

local ItemCatalog = require(Shared:WaitForChild("ItemCatalog"))

local GrantService = {}
local initialized = false

local _InventoryService = nil
local _EconomyService = nil
local _PlayerDataService = nil
local _SpinWheelService = nil
local _inventoryUpdatedRE: RemoteEvent? = nil
local _rewardGrantedRE: RemoteEvent? = nil
local _bundlePurchaseConfirmedRE: RemoteEvent? = nil
local _purchaseGrantedRE: RemoteEvent? = nil

local function getInventory()
	if _InventoryService then return _InventoryService end
	local ok, mod = pcall(require, Server:WaitForChild("InventoryService", 10))
	if ok and mod then _InventoryService = mod end
	return _InventoryService
end

local function getEconomy()
	if _EconomyService then return _EconomyService end
	local ok, mod = pcall(require, Server:WaitForChild("EconomyService", 10))
	if ok and mod then _EconomyService = mod end
	return _EconomyService
end

local function getPlayerData()
	if _PlayerDataService then return _PlayerDataService end
	local ok, mod = pcall(require, Server:WaitForChild("PlayerDataService", 10))
	if ok and mod then _PlayerDataService = mod end
	return _PlayerDataService
end

local function getSpinWheel()
	if _SpinWheelService then return _SpinWheelService end
	local ok, mod = pcall(require, Server:WaitForChild("SpinWheelService", 10))
	if ok and mod then _SpinWheelService = mod end
	return _SpinWheelService
end

local function ensureRemotes()
	local remotes = ReplicatedStorage:FindFirstChild("Remotes")
	if not remotes then
		remotes = Instance.new("Folder")
		remotes.Name = "Remotes"
		remotes.Parent = ReplicatedStorage
	end
	local inv = remotes:FindFirstChild("InventoryUpdated")
	if not inv then
		inv = Instance.new("RemoteEvent")
		inv.Name = "InventoryUpdated"
		inv.Parent = remotes
	end
	local reward = remotes:FindFirstChild("RewardGranted")
	if not reward then
		reward = Instance.new("RemoteEvent")
		reward.Name = "RewardGranted"
		reward.Parent = remotes
	end
	local bundleConfirmed = remotes:FindFirstChild("BundlePurchaseConfirmed")
	if not bundleConfirmed then
		bundleConfirmed = Instance.new("RemoteEvent")
		bundleConfirmed.Name = "BundlePurchaseConfirmed"
		bundleConfirmed.Parent = remotes
	end
	local purchaseGranted = remotes:FindFirstChild("PurchaseGranted")
	if not purchaseGranted then
		purchaseGranted = Instance.new("RemoteEvent")
		purchaseGranted.Name = "PurchaseGranted"
		purchaseGranted.Parent = remotes
	end
	_inventoryUpdatedRE = inv
	_rewardGrantedRE = reward
	_bundlePurchaseConfirmedRE = bundleConfirmed
	_purchaseGrantedRE = purchaseGranted
end

local function toCatalogCategory(itemType: string): string?
	if itemType == "Pet" then return "Pets" end
	if itemType == "Crown" then return "Crowns" end
	if itemType == "IconImage" then return "IconImages" end
	return nil
end

local function makeDefaultPayload(itemType: string, itemIdOrAmount: any, source: string)
	if itemType == "Currency" then
		return {
			type = "Currency",
			id = "fate_coins",
			amount = tonumber(itemIdOrAmount) or 0,
			source = source,
		}
	elseif itemType == "Spin" then
		return {
			type = "Spin",
			id = "spin_purchased",
			amount = tonumber(itemIdOrAmount) or 0,
			source = source,
		}
	else
		local category = toCatalogCategory(itemType)
		local entry = category and ItemCatalog.Get(category, tostring(itemIdOrAmount)) or nil
		return {
			type = itemType,
			grantType = itemType,
			id = tostring(itemIdOrAmount),
			category = category,
			name = entry and entry.name or tostring(itemIdOrAmount),
			rarity = entry and entry.rarity or "Common",
			popupImageOverride = entry and entry.image or nil,
			imageAssetId = entry and entry.image or nil,
			source = source,
		}
	end
end

local function getGrantAmount(itemType: string, itemIdOrAmount: any): number
	if itemType == "Currency" or itemType == "Spin" then
		return tonumber(itemIdOrAmount) or 0
	end
	return 1
end

function GrantService.EmitRewardGranted(player: Player, payload: any)
	if not _rewardGrantedRE then
		ensureRemotes()
	end
	if _rewardGrantedRE then
		_rewardGrantedRE:FireClient(player, payload)
	end
end

function GrantService.EmitBundlePurchaseConfirmed(player: Player, bundleId: string, payload: any?)
	if not _bundlePurchaseConfirmedRE then
		ensureRemotes()
	end
	if _bundlePurchaseConfirmedRE then
		_bundlePurchaseConfirmedRE:FireClient(player, bundleId, payload or {})
	end
end

function GrantService.EmitPurchaseGranted(player: Player, payload: any)
	if not _purchaseGrantedRE then
		ensureRemotes()
	end
	if _purchaseGrantedRE then
		_purchaseGrantedRE:FireClient(player, payload)
	end
end

function GrantService.Init()
	if initialized then return end
	initialized = true
	ensureRemotes()
end

function GrantService.GrantItem(player: Player, itemType: string, itemIdOrAmount: any, source: string, meta: { [string]: any }?): { success: boolean, reason: string?, alreadyProcessed: boolean?, alreadyOwned: boolean?, payload: any? }
	GrantService.Init()
	meta = meta or {}

	local itemIdText = tostring(itemIdOrAmount)
	print(string.format("[Grant] player=%s type=%s id=%s source=%s result=START", player.Name, tostring(itemType), itemIdText, tostring(source)))

	local PDS = getPlayerData()
	if not PDS or not PDS.IsLoaded(player) then
		local reason = "DATA_NOT_LOADED"
		print(string.format("[Grant] player=%s type=%s id=%s source=%s result=FAIL reason=%s", player.Name, tostring(itemType), itemIdText, tostring(source), reason))
		print(string.format("[Grant] FAIL reason=%s", reason))
		return { success = false, reason = reason }
	end

	local idemKey = meta.idempotencyKey
	local data = PDS.GetData(player)
	if type(idemKey) == "string" and idemKey ~= "" and data then
		local processed = data.ProcessedGrants
		if type(processed) == "table" and processed[idemKey] then
			local allowReplay = false
			if itemType == "Pet" or itemType == "Crown" or itemType == "IconImage" then
				local category = toCatalogCategory(itemType)
				local inv = getInventory()
				if category and inv and not inv.OwnsItem(player, category, itemIdText) then
					allowReplay = true
					print(string.format("[Grant] player=%s type=%s id=%s source=%s staleIdempotencyKey=%s -> replay",
						player.Name, tostring(itemType), itemIdText, tostring(source), idemKey))
				end
			end
			if not allowReplay then
				local payload = meta.payload or makeDefaultPayload(itemType, itemIdOrAmount, source)
				print(string.format("[Grant] player=%s type=%s id=%s source=%s result=SUCCESS alreadyProcessed=true", player.Name, tostring(itemType), itemIdText, tostring(source)))
				return { success = true, alreadyProcessed = true, payload = payload }
			end
		end
	end

	local success = false
	local alreadyOwned = false
	local reason = nil

	if itemType == "Pet" or itemType == "Crown" or itemType == "IconImage" then
		local category = toCatalogCategory(itemType)
		local itemId = tostring(itemIdOrAmount)
		local entry = category and ItemCatalog.Get(category, itemId) or nil
		if not entry then
			reason = "INVALID_CATALOG_ITEM"
		else
			local inv = getInventory()
			if not inv then
				reason = "INVENTORY_UNAVAILABLE"
			else
				if inv.OwnsItem(player, category, itemId) then
					alreadyOwned = true
					success = true
				else
					success = inv.GrantItem(player, category, itemId) == true
					if not success then
						reason = "INVENTORY_GRANT_FAILED"
					end
				end
			end
		end
	elseif itemType == "Spin" then
		local spinsToAdd = tonumber(itemIdOrAmount) or 0
		if spinsToAdd <= 0 then
			reason = "INVALID_AMOUNT"
		else
			local spin = getSpinWheel()
			if not spin or type(spin.GrantRobuxSpins) ~= "function" then
				reason = "SPIN_SERVICE_UNAVAILABLE"
			else
				success = spin.GrantRobuxSpins(player, spinsToAdd) == true
				if not success then
					reason = "SPIN_GRANT_FAILED"
				end
			end
		end
	elseif itemType == "Currency" then
		local amount = tonumber(itemIdOrAmount) or 0
		if amount <= 0 then
			reason = "INVALID_AMOUNT"
		else
			local econ = getEconomy()
			if not econ then
				reason = "ECONOMY_UNAVAILABLE"
			else
				local awarded = econ.AwardCoins(player, amount, "GrantService:" .. tostring(source), true)
				success = awarded == true
				if not success then
					reason = "CURRENCY_GRANT_FAILED"
				end
			end
		end
	else
		reason = "UNSUPPORTED_TYPE"
	end

	if not success then
		local failReason = tostring(reason or "UNKNOWN")
		print(string.format("[Grant] player=%s type=%s id=%s source=%s result=FAIL reason=%s", player.Name, tostring(itemType), itemIdText, tostring(source), failReason))
		print(string.format("[Grant] FAIL reason=%s", failReason))
		return { success = false, reason = failReason }
	end

	if type(idemKey) == "string" and idemKey ~= "" then
		local latest = PDS.GetData(player)
		local processed = latest and latest.ProcessedGrants
		if type(processed) ~= "table" then
			processed = {}
		end
		processed[idemKey] = os.time()
		PDS.SetField(player, "ProcessedGrants", processed)
	end

	local payload = meta.payload or makeDefaultPayload(itemType, itemIdOrAmount, source)
	if meta.fireReward ~= false and not alreadyOwned then
		GrantService.EmitRewardGranted(player, payload)
	end
	if _inventoryUpdatedRE then
		_inventoryUpdatedRE:FireClient(player, "GrantConfirmed", payload)
	end

	local amount = getGrantAmount(itemType, itemIdOrAmount)
	print(string.format("[Grant] player=%s type=%s id=%s source=%s result=SUCCESS", player.Name, tostring(itemType), itemIdText, tostring(source)))
	print(string.format("[Grant] SUCCESS type=%s id=%s amount=%d source=%s", tostring(itemType), itemIdText, amount, tostring(source)))
	return { success = true, alreadyOwned = alreadyOwned, payload = payload }
end

return GrantService
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="63">
        <Properties>
          <string name="Name">GroupSignBootstrap</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- Disabled: group join is now handled by the script inside the Group Sign model.
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="64">
        <Properties>
          <string name="Name">HazardManager</string>
          <string name="Source"><![CDATA[--[[
	HazardManager
	Server-side beam hazard system.
	
	Divides SquarePlatformMap into a grid, selects unsafe zones,
	shows telegraph warnings, spawns beams, and eliminates players on Strike.
	
	Telegraph → Beams flow:
	  1. ShowTelegraph()  — tile warning overlays pulse on unsafe cells
	  2. HideTelegraph()  — remove tile warnings (called before beams spawn)
	  3. SpawnBeams()     — beam columns appear above unsafe zones
	  4. Strike()         — eliminate players standing in beam zones
	  5. ClearBeams()     — remove beam columns
	
	Cleanup() is a bulletproof catch-all that hides telegraphs AND clears beams.
	
	API:
		Init()                      → Initialize the manager
		SelectUnsafeZones(round)    → Pick unsafe cells for this round (scales with difficulty)
		ShowTelegraph()             → Show tile warning overlays + pulse animation
		HideTelegraph()             → Remove all tile warning overlays immediately
		SpawnBeams()                → Create beam columns above unsafe zones
		Strike()                    → Eliminate players in unsafe zones
		ClearBeams()                → Remove all beam columns
		GetUnsafeZones()            → Current unsafe zone data
		Cleanup()                   → Full reset (HideTelegraph + ClearBeams + clear zones)
]]

local Workspace = game:GetService("Workspace")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Server = ServerScriptService:WaitForChild("Server")

local HazardConfig = require(Shared:WaitForChild("HazardConfig"))
local StormFXConfig = require(Shared:WaitForChild("StormFXConfig"))
local PlayerState = require(Shared:WaitForChild("PlayerState"))
local PlayerStateService = require(Server:WaitForChild("PlayerStateService"))
local MapManager = require(Server:WaitForChild("MapManager"))
local EliminationTracker = require(Server:WaitForChild("EliminationTracker"))

--[[ TYPES ]]
export type GridCell = {
	row: number,
	col: number,
	localCenter: Vector3,
	worldCenter: Vector3,
}

--[[ INTERNAL STATE ]]
local initialized = false
local effectsFolder: Folder? = nil
local currentUnsafeZones: { GridCell } = {}

-- Base platform data (never changes)
local basePlatformData: {
	cframe: CFrame,
	size: Vector3,
	topY: number,
}? = nil

-- Active platform data (changes with shrink)
local platformData: {
	cframe: CFrame,
	size: Vector3,
	cellSizeX: number,
	cellSizeZ: number,
	topY: number,
}? = nil

-- Selected cells lookup for spacing checks (row_col -> true)
local selectedCellsLookup: { [string]: boolean } = {}

-- Spawned beam references for accurate hit detection
local spawnedBeams: { Part } = {}

-- Tile warning overlays (floor danger flash during telegraph)
local spawnedTileWarnings: { Part } = {}
local tileWarningActive = false  -- Gate for pulse animation coroutine

-- Current round index (stored from SelectUnsafeZones for elimination tracking)
local currentRoundIndex: number = 0

local HazardManager = {}

--[[ HELPERS ]]

local function log(...)
	if HazardConfig.DebugLog then
		print("[HazardManager]", ...)
	end
end

local function cellKey(row: number, col: number): string
	return string.format("%d_%d", row, col)
end

--[[
	Convert local grid position to world position using platform CFrame.
]]
local function localToWorld(localPos: Vector3): Vector3
	if not platformData then
		error("[HazardManager] Platform data not initialized")
	end
	return platformData.cframe:PointToWorldSpace(localPos)
end

--[[
	Convert world position to local grid position.
]]
local function worldToLocal(worldPos: Vector3): Vector3
	if not platformData then
		error("[HazardManager] Platform data not initialized")
	end
	return platformData.cframe:PointToObjectSpace(worldPos)
end

--[[
	Compute grid cell data from row/col.
]]
local function getCellData(row: number, col: number): GridCell
	if not platformData then
		error("[HazardManager] Platform data not initialized")
	end
	
	local gridSize = HazardConfig.GridSize
	local halfSizeX = platformData.size.X / 2
	local halfSizeZ = platformData.size.Z / 2
	
	local localX = -halfSizeX + (col - 0.5) * platformData.cellSizeX
	local localZ = -halfSizeZ + (row - 0.5) * platformData.cellSizeZ
	local localY = platformData.size.Y / 2
	
	local localCenter = Vector3.new(localX, localY, localZ)
	local worldCenter = localToWorld(localCenter)
	
	return {
		row = row,
		col = col,
		localCenter = localCenter,
		worldCenter = worldCenter,
	}
end

--[[
	Get the grid cell a world position falls into.
]]
local function getGridCellAt(worldPosition: Vector3): (number?, number?)
	if not platformData then return nil, nil end
	
	local localPos = worldToLocal(worldPosition)
	local gridSize = HazardConfig.GridSize
	local halfSizeX = platformData.size.X / 2
	local halfSizeZ = platformData.size.Z / 2
	
	local col = math.floor((localPos.X + halfSizeX) / platformData.cellSizeX) + 1
	local row = math.floor((localPos.Z + halfSizeZ) / platformData.cellSizeZ) + 1
	
	if row < 1 or row > gridSize or col < 1 or col > gridSize then
		return nil, nil
	end
	
	return row, col
end

--[[
	Check if a grid cell is in the unsafe list.
]]
local function isCellUnsafe(row: number, col: number): boolean
	return selectedCellsLookup[cellKey(row, col)] == true
end

--[[
	Check if a cell has any selected neighbors within radius.
]]
local function hasSelectedNeighbor(row: number, col: number, radius: number): boolean
	local gridSize = HazardConfig.GridSize
	
	for dr = -radius, radius do
		for dc = -radius, radius do
			if dr == 0 and dc == 0 then continue end
			
			local nr = row + dr
			local nc = col + dc
			
			if nr >= 1 and nr <= gridSize and nc >= 1 and nc <= gridSize then
				if selectedCellsLookup[cellKey(nr, nc)] then
					return true
				end
			end
		end
	end
	
	return false
end

--[[
	Shuffle an array in place (Fisher-Yates).
]]
local function shuffle<T>(arr: { T }): { T }
	for i = #arr, 2, -1 do
		local j = math.random(1, i)
		arr[i], arr[j] = arr[j], arr[i]
	end
	return arr
end

--[[
	Get or create the effects folder.
]]
local function getEffectsFolder(): Folder
	if effectsFolder and effectsFolder.Parent then
		return effectsFolder
	end
	
	effectsFolder = Workspace:FindFirstChild(HazardConfig.EffectsFolderName)
	if not effectsFolder then
		effectsFolder = Instance.new("Folder")
		effectsFolder.Name = HazardConfig.EffectsFolderName
		effectsFolder.Parent = Workspace
	end
	
	return effectsFolder
end

--[[
	Get or create the beams folder.
]]
local function getBeamsFolder(): Folder
	local folder = getEffectsFolder()
	
	local beamsFolder = folder:FindFirstChild("TelegraphBeams")
	if not beamsFolder then
		beamsFolder = Instance.new("Folder")
		beamsFolder.Name = "TelegraphBeams"
		beamsFolder.Parent = folder
	end
	
	return beamsFolder
end

--[[
	Get or create the tile warnings folder.
]]
local function getTileWarningsFolder(): Folder
	local folder = getEffectsFolder()
	
	local twFolder = folder:FindFirstChild("TileWarnings")
	if not twFolder then
		twFolder = Instance.new("Folder")
		twFolder.Name = "TileWarnings"
		twFolder.Parent = folder
	end
	
	return twFolder
end

--[[
	Clear all tile warning overlays. Idempotent. Cancels any running pulse animation.
]]
local function clearTileWarnings()
	tileWarningActive = false  -- Stop any running pulse animation immediately
	
	if #spawnedTileWarnings == 0 then return end
	
	local folder = Workspace:FindFirstChild(HazardConfig.EffectsFolderName)
	if folder then
		local twFolder = folder:FindFirstChild("TileWarnings")
		if twFolder then
			twFolder:ClearAllChildren()
		end
	end
	
	local count = #spawnedTileWarnings
	spawnedTileWarnings = {}
	
	if HazardConfig.TileWarningDebugLogs then
		log(string.format("[TILE WARNING] Cleared %d tile warnings", count))
	end
end

--[[
	Spawn tile warning overlays on the floor for each unsafe zone and run pulse animation.
	Creates thin neon overlay Parts on the arena surface that pulse to indicate danger.
	Animation runs in a background coroutine, gated by tileWarningActive.
]]
local function spawnTileWarnings()
	if not HazardConfig.TileWarningEnabled then return end
	if not platformData then return end
	
	clearTileWarnings()  -- Clean any previous overlays
	tileWarningActive = true
	
	local twFolder = getTileWarningsFolder()
	local cfg = HazardConfig
	
	-- Create overlay parts for each unsafe zone cell
	for _, zone in ipairs(currentUnsafeZones) do
		local tile = Instance.new("Part")
		tile.Name = string.format("TileWarn_r%d_c%d", zone.row, zone.col)
		tile.Anchored = true
		tile.CanCollide = false
		tile.CastShadow = false
		-- Use BeamWidthStuds for telegraph size — single source of truth with beam footprint
		tile.Size = Vector3.new(cfg.BeamWidthStuds, cfg.TileWarningThickness, cfg.BeamWidthStuds)
		tile.Position = Vector3.new(
			zone.worldCenter.X,
			platformData.topY + cfg.TileWarningThickness / 2 + 0.01,  -- Just above floor surface
			zone.worldCenter.Z
		)
		tile.Color = cfg.TileWarningColor
		tile.Material = cfg.TileWarningMaterial
		tile.Transparency = cfg.TileWarningTranspStart
		tile.Parent = twFolder
		table.insert(spawnedTileWarnings, tile)
	end
	
	if cfg.TileWarningDebugLogs then
		log(string.format("[TILE WARNING] Spawned %d tile overlays", #spawnedTileWarnings))
	end
	
	-- Run pulse animation in background (non-blocking, self-cancels on clearTileWarnings)
	task.spawn(function()
		local fadeInInfo = TweenInfo.new(cfg.TileWarningPulseFadeIn, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		local fadeOutInfo = TweenInfo.new(cfg.TileWarningPulseFadeOut, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		
		for pulse = 1, cfg.TileWarningPulseCount do
			if not tileWarningActive then break end
			
			-- FADE IN: snap to dark (danger flash)
			for _, tile in ipairs(spawnedTileWarnings) do
				if tile.Parent then
					TweenService:Create(tile, fadeInInfo, { Transparency = cfg.TileWarningTranspPeak }):Play()
				end
			end
			task.wait(cfg.TileWarningPulseFadeIn)
			if not tileWarningActive then break end
			
			-- FADE OUT: ease back to subtle rest
			for _, tile in ipairs(spawnedTileWarnings) do
				if tile.Parent then
					TweenService:Create(tile, fadeOutInfo, { Transparency = cfg.TileWarningTranspRest }):Play()
				end
			end
			task.wait(cfg.TileWarningPulseFadeOut)
			if not tileWarningActive then break end
			
			-- Gap between pulses (skip after last pulse)
			if pulse < cfg.TileWarningPulseCount then
				task.wait(cfg.TileWarningPulseGap)
			end
		end
		
		if cfg.TileWarningDebugLogs and tileWarningActive then
			log("[TILE WARNING] Pulse animation complete — holding at rest transparency")
		end
	end)
end

--[[ PUBLIC API ]]

--[[
	Refresh platformData from MapManager's active bounds.
	Called at start of each round to account for shrinking.
]]
local function refreshPlatformData()
	local activeBounds = MapManager.GetActiveBounds()
	if not activeBounds or not basePlatformData then
		return false
	end
	
	local gridSize = HazardConfig.GridSize
	local cellSizeX = activeBounds.sizeX / gridSize
	local cellSizeZ = activeBounds.sizeZ / gridSize
	
	platformData = {
		cframe = activeBounds.cframe,
		size = Vector3.new(activeBounds.sizeX, basePlatformData.size.Y, activeBounds.sizeZ),
		cellSizeX = cellSizeX,
		cellSizeZ = cellSizeZ,
		topY = activeBounds.topY,
	}
	
	return true
end

function HazardManager.Init()
	if initialized then
		warn("[HazardManager] Already initialized")
		return
	end
	
	local arena = MapManager.GetArena()
	if not arena then
		error("[HazardManager] Arena not found, cannot initialize")
	end
	
	local arenaCFrame: CFrame
	local arenaSize: Vector3
	
	if arena:IsA("BasePart") then
		arenaCFrame = arena.CFrame
		arenaSize = arena.Size
	elseif arena:IsA("Model") then
		local primary = arena.PrimaryPart or arena:FindFirstChildWhichIsA("BasePart")
		if primary then
			arenaCFrame = primary.CFrame
			arenaSize = primary.Size
		else
			error("[HazardManager] Arena Model has no usable BasePart")
		end
	else
		error("[HazardManager] Arena is not a BasePart or Model")
	end
	
	-- Store base platform data (never changes)
	basePlatformData = {
		cframe = arenaCFrame,
		size = arenaSize,
		topY = arenaCFrame.Position.Y + arenaSize.Y / 2,
	}
	
	-- Initialize platformData with full size
	local gridSize = HazardConfig.GridSize
	local cellSizeX = arenaSize.X / gridSize
	local cellSizeZ = arenaSize.Z / gridSize
	
	platformData = {
		cframe = arenaCFrame,
		size = arenaSize,
		cellSizeX = cellSizeX,
		cellSizeZ = cellSizeZ,
		topY = arenaCFrame.Position.Y + arenaSize.Y / 2,
	}
	
	initialized = true
	log(string.format("Initialized — Grid %dx%d, cell size %.1fx%.1f", 
		gridSize, gridSize, cellSizeX, cellSizeZ))
end

--[[
	Select random unsafe zones for this round.
	roundIndex: Current round number (1-indexed). Affects difficulty.
]]
function HazardManager.SelectUnsafeZones(roundIndex: number)
	if not initialized then
		warn("[HazardManager] Not initialized")
		return
	end
	
	roundIndex = roundIndex or 1
	currentRoundIndex = roundIndex  -- Store for elimination tracking
	
	-- Refresh platform data from active bounds (handles shrink)
	refreshPlatformData()
	
	-- Clear previous
	currentUnsafeZones = {}
	selectedCellsLookup = {}
	
	-- Calculate unsafe percent based on round (difficulty ramp)
	local basePercent = HazardConfig.MinUnsafePercent
	local rampPerRound = HazardConfig.UnsafePercentPerRound
	local maxPercent = HazardConfig.MaxUnsafePercent
	
	local unsafePercent = math.clamp(
		basePercent + (roundIndex - 1) * rampPerRound,
		basePercent,
		maxPercent
	)
	
	-- Build list of all cells
	local gridSize = HazardConfig.GridSize
	local totalCells = gridSize * gridSize
	local allCells: { { row: number, col: number } } = {}
	
	for row = 1, gridSize do
		for col = 1, gridSize do
			table.insert(allCells, { row = row, col = col })
		end
	end
	
	shuffle(allCells)
	
	local targetCount = math.max(1, math.floor(totalCells * unsafePercent))
	local useSpacing = HazardConfig.UseSpacing
	local spacingRadius = HazardConfig.SpacingRadius
	local maxAttempts = HazardConfig.MaxSelectionAttempts
	
	-- Pass 1: Select cells with spacing constraint
	local attempts = 0
	local cellIndex = 1
	
	while #currentUnsafeZones < targetCount and attempts < maxAttempts do
		if cellIndex > #allCells then
			cellIndex = 1
			shuffle(allCells)  -- Reshuffle for another pass
		end
		
		local cell = allCells[cellIndex]
		local key = cellKey(cell.row, cell.col)
		
		-- Skip if already selected
		if not selectedCellsLookup[key] then
			local canSelect = true
			
			-- Check spacing constraint
			if useSpacing and hasSelectedNeighbor(cell.row, cell.col, spacingRadius) then
				canSelect = false
			end
			
			if canSelect then
				selectedCellsLookup[key] = true
				local cellData = getCellData(cell.row, cell.col)
				table.insert(currentUnsafeZones, cellData)
			end
		end
		
		cellIndex = cellIndex + 1
		attempts = attempts + 1
	end
	
	-- Pass 2: If we didn't reach target, relax spacing and fill
	if #currentUnsafeZones < targetCount then
		shuffle(allCells)
		for _, cell in ipairs(allCells) do
			if #currentUnsafeZones >= targetCount then break end
			
			local key = cellKey(cell.row, cell.col)
			if not selectedCellsLookup[key] then
				selectedCellsLookup[key] = true
				local cellData = getCellData(cell.row, cell.col)
				table.insert(currentUnsafeZones, cellData)
			end
		end
	end
	
	log(string.format("Round %d: Selected %d unsafe zones (%.0f%% of %d)", 
		roundIndex, #currentUnsafeZones, unsafePercent * 100, totalCells))
end

--[[
	Show tile warning overlays on unsafe zones. Tiles pulse to indicate danger.
	Call HideTelegraph() before SpawnBeams() to remove them.
]]
function HazardManager.ShowTelegraph()
	if not initialized or not platformData then
		warn("[HazardManager] Not initialized")
		return
	end
	
	spawnTileWarnings()
	log(string.format("Telegraph shown: %d", #spawnedTileWarnings))
end

--[[
	Hide all tile warning overlays immediately. Idempotent.
]]
function HazardManager.HideTelegraph()
	local count = #spawnedTileWarnings
	clearTileWarnings()
	if count > 0 then
		log(string.format("Telegraph hidden: %d", count))
	end
end

--[[
	Spawn beam columns above each unsafe zone. Call after HideTelegraph().
]]
function HazardManager.SpawnBeams()
	if not initialized or not platformData then
		warn("[HazardManager] Not initialized")
		return
	end
	
	local beamsFolder = getBeamsFolder()
	beamsFolder:ClearAllChildren()
	spawnedBeams = {}  -- Clear beam references
	
	local beamHeight = HazardConfig.BeamHeightStuds
	local beamWidth = HazardConfig.BeamWidthStuds
	
	for i, zone in ipairs(currentUnsafeZones) do
		local beam = Instance.new("Part")
		beam.Name = string.format("Beam_r%d_c%d", zone.row, zone.col)
		beam.Anchored = true
		beam.CanCollide = false
		beam.CastShadow = false
		
		-- Size: fixed width, very tall
		beam.Size = Vector3.new(beamWidth, beamHeight, beamWidth)
		
		-- Position: beam extends from platform surface upward
		local beamY = platformData.topY + beamHeight / 2
		beam.Position = Vector3.new(
			zone.worldCenter.X,
			beamY,
			zone.worldCenter.Z
		)
		
		-- Visual properties
		beam.Color = HazardConfig.BeamColor
		beam.Transparency = HazardConfig.BeamTransparency
		beam.Material = Enum.Material.Neon
		
		beam.Parent = beamsFolder
		table.insert(spawnedBeams, beam)  -- Track for hit detection
		
		-- Attach storm particles to beam (same style as barrier, lower rate)
		if HazardConfig.BeamParticlesEnabled then
			local mistE, sparksE = StormFXConfig.CreateStormParticles(beam, HazardConfig.BeamParticleRateMultiplier)
			
			-- Debug: log details for first 2 beams only (gated behind config)
			if i <= 2 and HazardConfig.BeamParticleDebugLogs then
				log(string.format(
					"[BEAM PARTICLE DEBUG] %s — Mist: Parent=%s Rate=%d Lifetime=%s Enabled=%s | Sparks: Parent=%s Rate=%d Enabled=%s",
					beam.Name,
					tostring(mistE.Parent and mistE.Parent.Name),
					mistE.Rate,
					tostring(mistE.Lifetime),
					tostring(mistE.Enabled),
					tostring(sparksE.Parent and sparksE.Parent.Name),
					sparksE.Rate,
					tostring(sparksE.Enabled)
				))
			end
		end
	end
	
	log(string.format("Beams spawned: %d (particles: %s)", 
		#currentUnsafeZones, tostring(HazardConfig.BeamParticlesEnabled)))
end

--[[
	Remove all beam columns. Idempotent (safe to call multiple times).
]]
function HazardManager.ClearBeams()
	local folder = Workspace:FindFirstChild(HazardConfig.EffectsFolderName)
	if not folder then 
		spawnedBeams = {}
		return 
	end
	
	local beamsFolder = folder:FindFirstChild("TelegraphBeams")
	if not beamsFolder then 
		spawnedBeams = {}
		return 
	end
	
	local count = #beamsFolder:GetChildren()
	beamsFolder:ClearAllChildren()
	spawnedBeams = {}
	
	if count > 0 then
		log(string.format("Beams cleared: %d", count))
	end
end

--[[
	Check if a single point is inside a beam's kill zone.
	Uses tiny buffer to prevent flicker edge deaths.
]]
local function isPointInBeam(point: Vector3, beam: Part): boolean
	local buffer = HazardConfig.KillZoneInnerBuffer
	local beamPos = beam.Position
	local beamSize = beam.Size
	
	-- Kill zone matches visual beam with tiny edge buffer
	local killHalfX = (beamSize.X / 2) * (1 - buffer)
	local killHalfZ = (beamSize.Z / 2) * (1 - buffer)
	
	local dx = math.abs(point.X - beamPos.X)
	local dz = math.abs(point.Z - beamPos.Z)
	
	return dx <= killHalfX and dz <= killHalfZ
end

--[[
	Check if ANY body part of a character intersects ANY beam.
	Returns (beamName, bodyPartName) if hit, (nil, nil) otherwise.
]]
local function getBodyPartBeamHit(character: Model): (string?, string?)
	for _, beam in ipairs(spawnedBeams) do
		-- Check all BaseParts in the character
		for _, part in ipairs(character:GetDescendants()) do
			if not part:IsA("BasePart") then continue end
			
			-- Get the part's bounding box corners for thorough check
			local partPos = part.Position
			local partSize = part.Size
			
			-- Check center point
			if isPointInBeam(partPos, beam) then
				return beam.Name, part.Name
			end
			
			-- Check corners for larger body parts (arms, legs, torso)
			local halfX = partSize.X / 2
			local halfZ = partSize.Z / 2
			
			local corners = {
				Vector3.new(partPos.X + halfX, partPos.Y, partPos.Z + halfZ),
				Vector3.new(partPos.X + halfX, partPos.Y, partPos.Z - halfZ),
				Vector3.new(partPos.X - halfX, partPos.Y, partPos.Z + halfZ),
				Vector3.new(partPos.X - halfX, partPos.Y, partPos.Z - halfZ),
			}
			
			for _, corner in ipairs(corners) do
				if isPointInBeam(corner, beam) then
					return beam.Name, part.Name
				end
			end
		end
	end
	
	return nil, nil
end

--[[
	Fallback: check if HumanoidRootPart position is inside any beam.
]]
local function getHRPBeamHit(position: Vector3): string?
	for _, beam in ipairs(spawnedBeams) do
		if isPointInBeam(position, beam) then
			return beam.Name
		end
	end
	return nil
end

--[[
	Execute the strike: eliminate players with ANY body part in unsafe zones.
	Uses limb-accurate detection for fair hit testing.
	Eliminated players are immediately sent to Lobby (no Spectating).
	Returns number of eliminated players.
]]
function HazardManager.Strike(): number
	if not initialized then
		warn("[HazardManager] Not initialized")
		return 0
	end
	
	-- Log unsafe zones for this strike
	log(string.format("[STRIKE] Checking %d unsafe zones: %s", 
		#currentUnsafeZones,
		table.concat(
			(function()
				local names = {}
				for _, zone in ipairs(currentUnsafeZones) do
					table.insert(names, string.format("r%dc%d", zone.row, zone.col))
				end
				return names
			end)(),
			", "
		)
	))
	
	local eliminatedPlayers: { Player } = {}
	local inMatchPlayers = PlayerStateService.GetPlayersInState(PlayerState.States.InMatch)
	
	local useBodyParts = HazardConfig.UseBodyPartCheck and #spawnedBeams > 0
	
	-- Check each player for beam intersection
	for _, player in ipairs(inMatchPlayers) do
		if EliminationTracker.IsEliminated(player) then
			log(string.format("[ElimSkip] player=%s skippedCause=Barrier reason=already_eliminated", player.Name))
			continue
		end

		local character = player.Character
		if not character then continue end
		
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if not humanoid or humanoid.Health <= 0 then continue end
		
		local hitBeam: string? = nil
		local hitPart: string? = nil
		
		if useBodyParts then
			-- Limb-accurate: check ALL body parts
			hitBeam, hitPart = getBodyPartBeamHit(character)
		else
			-- Fallback: HRP-only check
			local rootPart = character:FindFirstChild("HumanoidRootPart")
			if rootPart then
				hitBeam = getHRPBeamHit(rootPart.Position)
				hitPart = "HumanoidRootPart"
			end
		end
		
		if hitBeam then
			humanoid.Health = 0
			table.insert(eliminatedPlayers, player)
			log(string.format("[HAZARD KILL] %s — Beam: %s, BodyPart: %s", 
				player.Name, hitBeam, hitPart or "unknown"))
		end
	end
	
	-- Record eliminations BEFORE state change (so tracker sees them as InMatch)
	for _, player in ipairs(eliminatedPlayers) do
		EliminationTracker.RecordElimination(player, currentRoundIndex, "Beam")
	end
	
	-- Send eliminated players to Lobby
	for _, player in ipairs(eliminatedPlayers) do
		PlayerStateService.SetState(player, PlayerState.States.Lobby)
	end
	
	local survived = #inMatchPlayers - #eliminatedPlayers
	log(string.format("Strike complete: %d eliminated, %d survived", #eliminatedPlayers, survived))
	
	return #eliminatedPlayers
end

--[[
	Get current unsafe zones (for debugging/UI).
]]
function HazardManager.GetUnsafeZones(): { GridCell }
	return currentUnsafeZones
end

--[[
	Full cleanup (call on match end or cancel). Idempotent.
]]
function HazardManager.Cleanup()
	local hadData = #currentUnsafeZones > 0 or #spawnedTileWarnings > 0 or #spawnedBeams > 0
	
	-- Bulletproof: always hide telegraph AND clear beams
	HazardManager.HideTelegraph()
	HazardManager.ClearBeams()
	currentUnsafeZones = {}
	selectedCellsLookup = {}
	
	-- Only log if there was something to clean
	if hadData then
		log("Full cleanup complete")
	end
end

return HazardManager
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="65">
        <Properties>
          <string name="Name">InventoryService</string>
          <string name="Source">--[[
	InventoryService
	Server-side ownership + equip / unequip for pets, crowns, and icons.

	All actions validated against:
	  • PlayerDataService (ownership data)
	  • ItemCatalog (item existence)

	Leaderboard updates sent via DIRECT MODULE CALL to
	GlobalLeaderboardService.ReportStatById() — no BindableEvent.

	API:
		Init()
		OwnsItem(player, category, id)        → boolean
		GrantItem(player, category, id)        → boolean
		EquipItem(player, category, id)        → { success, reason? }
		UnequipItem(player, category)          → { success, reason? }
		GetEquipped(player, category)          → string?
]]

local ReplicatedStorage  = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Server = ServerScriptService:WaitForChild("Server")

local PlayerDataService = require(Server:WaitForChild("PlayerDataService"))

local ItemCatalogModule = Shared:WaitForChild("ItemCatalog", 10)
local ItemCatalog
if ItemCatalogModule then
	local ok, mod = pcall(require, ItemCatalogModule)
	if ok then ItemCatalog = mod else warn("[InventoryService] ItemCatalog failed:", mod) end
end
if not ItemCatalog then
	warn("[InventoryService] ItemCatalog not found — equip validation limited")
	ItemCatalog = { Get = function() return nil end }
end

local InventoryService = {}
local initialized = false

local DEBUG_LOG = true
local function log(...)
	if DEBUG_LOG then print("[InventoryService]", ...) end
end

-- ── GLBS direct call (lazy require, no BindableEvent) ──
local _GLBS = nil
local function getGLBS()
	if _GLBS ~= nil then return _GLBS end
	local ok, mod = pcall(function()
		return require(Server:WaitForChild("GlobalLeaderboardService", 10))
	end)
	if ok and mod then
		_GLBS = mod
		warn("[InventoryService] GLBS loaded via direct require")
	else
		_GLBS = false
		warn("[InventoryService] GLBS not available:", tostring(mod))
	end
	return _GLBS
end

local function reportStats(userId: number, username: string, updates: { [string]: number })
	local GLBS = getGLBS()
	if not GLBS or GLBS == false then return end

	for statKey, value in pairs(updates) do
		local callOk, callErr = pcall(function()
			GLBS.ReportStatById(userId, statKey, value)
		end)
		if callOk then
			log(string.format("DIRECT CALL OK: ReportStatById(%d, '%s', %d)", userId, statKey, value))
		else
			warn(string.format("[InventoryService] DIRECT CALL FAILED: ReportStatById(%d, '%s', %d) err=%s",
				userId, statKey, value, tostring(callErr)))
		end
	end
end

local CATEGORY_MAP = {
	Pets       = { ownedKey = "OwnedPets",       equippedKey = "EquippedPet",       catalogCategory = "Pets"       },
	Crowns     = { ownedKey = "OwnedCrowns",     equippedKey = "EquippedCrown",     catalogCategory = "Crowns"     },
	Icons      = { ownedKey = "OwnedIcons",      equippedKey = "EquippedIcon",      catalogCategory = "Icons"      },
	IconImages = { ownedKey = "OwnedIconImages", equippedKey = "EquippedIconImage", catalogCategory = "IconImages" },
}

function InventoryService.Init()
	if initialized then return end
	initialized = true

	-- Pre-warm GLBS reference (non-blocking)
	task.spawn(function()
		getGLBS()
	end)

	log("Initialized (leaderboard updates via direct GLBS calls)")
end

function InventoryService.OwnsItem(player: Player, category: string, id: string): boolean
	local mapping = CATEGORY_MAP[category]
	if not mapping then return false end

	local data = PlayerDataService.GetData(player)
	if not data then return false end

	local ownedList = data[mapping.ownedKey]
	if not ownedList then return false end

	for _, ownedId in ipairs(ownedList) do
		if ownedId == id then return true end
	end
	return false
end

function InventoryService.GrantItem(player: Player, category: string, id: string): boolean
	local mapping = CATEGORY_MAP[category]
	if not mapping then
		warn("[InventoryService] Invalid category:", category)
		return false
	end

	local catalogEntry = ItemCatalog.Get(mapping.catalogCategory, id)
	if not catalogEntry then
		warn(string.format("[InventoryService] Item not in catalog: %s/%s", category, id))
		return false
	end

	local data = PlayerDataService.GetData(player)
	if not data then
		warn("[InventoryService] Data not loaded for", player.Name)
		return false
	end

	local ownedList = data[mapping.ownedKey]
	if not ownedList then
		ownedList = {}
		data[mapping.ownedKey] = ownedList
	end

	for _, ownedId in ipairs(ownedList) do
		if ownedId == id then
			log(string.format("%s already owns %s/%s", player.Name, category, id))
			return true
		end
	end
	if category == "Pets" then
		table.insert(ownedList, id)
	else
		table.insert(ownedList, id)
	end

	PlayerDataService.SetField(player, mapping.ownedKey, ownedList)
	log(string.format("GRANTED %s/%s to %s (total %d)", category, id, player.Name, #ownedList))

	-- Report CrownsFound to global leaderboard via direct call
	if category == "Crowns" then
		reportStats(player.UserId, player.Name, {
			CrownsFound = #ownedList,
		})
	end

	return true
end

function InventoryService.EquipItem(player: Player, category: string, id: string): { success: boolean, reason: string? }
	local mapping = CATEGORY_MAP[category]
	if not mapping then
		return { success = false, reason = "Invalid category" }
	end

	if not InventoryService.OwnsItem(player, category, id) then
		return { success = false, reason = "Item not owned" }
	end

	local catalogEntry = ItemCatalog.Get(mapping.catalogCategory, id)
	if not catalogEntry then
		return { success = false, reason = "Item not in catalog" }
	end

	PlayerDataService.SetField(player, mapping.equippedKey, id)
	log(string.format("%s equipped %s/%s", player.Name, category, id))
	return { success = true }
end

function InventoryService.UnequipItem(player: Player, category: string): { success: boolean, reason: string? }
	local mapping = CATEGORY_MAP[category]
	if not mapping then
		return { success = false, reason = "Invalid category" }
	end

	PlayerDataService.SetField(player, mapping.equippedKey, nil)
	log(string.format("%s unequipped %s", player.Name, category))
	return { success = true }
end

function InventoryService.GetEquipped(player: Player, category: string): string?
	local mapping = CATEGORY_MAP[category]
	if not mapping then return nil end
	return PlayerDataService.GetField(player, mapping.equippedKey)
end

return InventoryService</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="66">
        <Properties>
          <string name="Name">LevelCrownService</string>
          <string name="Source"><![CDATA[--[[
	LevelCrownService
	Server-side wins-milestone crown granting.

	Checks player's LifetimeWins against ItemCatalog.LevelCrownMilestones
	and grants any earned but unowned crowns.

	Triggered:
	  • On player join (after data load) — catch up on missed milestones
	  • On wins increment — check if new milestone crossed

	API:
		Init()
		CheckMilestones(player) → { granted: { string } }
]]

local Players             = game:GetService("Players")
local ReplicatedStorage   = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Shared      = ReplicatedStorage:WaitForChild("Shared")
local Server      = ServerScriptService:WaitForChild("Server")
local ItemCatalog = require(Shared:WaitForChild("ItemCatalog"))

local LevelCrownService = {}
local initialized = false

-- ── Lazy loaders ──
local _InventoryService = nil
local _PlayerDataService = nil

local function getInventory()
	if _InventoryService then return _InventoryService end
	local ok, mod = pcall(require, Server:WaitForChild("InventoryService", 10))
	if ok and mod then _InventoryService = mod end
	return _InventoryService
end

local function getPDS()
	if _PlayerDataService then return _PlayerDataService end
	local ok, mod = pcall(require, Server:WaitForChild("PlayerDataService", 10))
	if ok and mod then _PlayerDataService = mod end
	return _PlayerDataService
end

local function log(...)
	print("[LevelCrownService]", ...)
end

-- ═══════════════════════════════════════════════════════════════════
-- MILESTONE CHECK
-- ═══════════════════════════════════════════════════════════════════

function LevelCrownService.CheckMilestones(player: Player): { granted: { string } }
	local granted = {}

	local pds = getPDS()
	if not pds or not pds.IsLoaded(player) then
		return { granted = granted }
	end

	local wins = pds.GetField(player, "LifetimeWins") or 0
	local inv = getInventory()
	if not inv then
		return { granted = granted }
	end

	for _, milestone in ipairs(ItemCatalog.LevelCrownMilestones) do
		if wins >= milestone.wins then
			if not inv.OwnsItem(player, "Crowns", milestone.crownId) then
				local success = inv.GrantItem(player, "Crowns", milestone.crownId)
				if success then
					table.insert(granted, milestone.crownId)
					local entry = ItemCatalog.Crowns[milestone.crownId]
					log(string.format("%s earned %s (%d wins milestone)",
						player.Name, entry and entry.name or milestone.crownId, milestone.wins))
				end
			end
		end
	end

	return { granted = granted }
end

-- ═══════════════════════════════════════════════════════════════════
-- INIT
-- ═══════════════════════════════════════════════════════════════════

function LevelCrownService.Init()
	if initialized then return end
	initialized = true
	log("Initialized")
end

return LevelCrownService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="67">
        <Properties>
          <string name="Name">MapManager</string>
          <string name="Source"><![CDATA[--[[
	MapManager
	Server-side arena registration, lifecycle hooks, spawn utilities,
	active bounds tracking, and out-of-bounds enforcement.
	
	The arena (SquarePlatformMap) is ALWAYS visible in the world.
	Active bounds shrink each round to increase difficulty.
	Players outside active bounds are eliminated (with post-shrink grace window).
	
	API:
		Init()                        → Initialize and locate arena
		GetArena()                    → Instance reference
		IsActive()                    → boolean (match in progress)
		OnMatchStart()                → Called when Playing phase begins
		OnMatchEnd()                  → Called when match ends
		OnRoundStart(roundIndex)      → Called at start of each round (handles shrink)
		GetArenaSpawnCFrames(count)   → { CFrame } for spawning on arena
		GetLobbySpawnCFrame()         → CFrame for returning to lobby
		GetActiveBounds()             → { cframe, sizeX, sizeZ, topY }
		GetBaseBounds()               → { cframe, size }
		ResetBounds()                 → Reset active bounds to full size
		IsPositionInBounds(pos)       → boolean
]]

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Server = ServerScriptService:WaitForChild("Server")

local SpawnConfig = require(Shared:WaitForChild("SpawnConfig"))
local ShrinkConfig = require(Shared:WaitForChild("ShrinkConfig"))
local StormFXConfig = require(Shared:WaitForChild("StormFXConfig"))
local PlayerState = require(Shared:WaitForChild("PlayerState"))
local PlayerStateService = require(Server:WaitForChild("PlayerStateService"))
local EliminationTracker = require(Server:WaitForChild("EliminationTracker"))

--[[ CONFIGURATION ]]
local Config = {
	ArenaName = "SquarePlatformMap",
	DebugLog = true,
	OutOfBoundsCheckInterval = 0.25, -- Seconds between OOB checks
}

--[[ INTERNAL STATE ]]
local arena: Instance? = nil
local arenaCFrame: CFrame? = nil
local arenaSize: Vector3? = nil
local isActive: boolean = false
local initialized: boolean = false

-- Active bounds (shrinks each round)
local activeSizeX: number = 0
local activeSizeZ: number = 0
local currentShrinkStep: number = 0

-- Visual boundary (storm wall)
local boundsFolder: Folder? = nil
local boundsWalls: { Part } = {}
local stormVolume: Part? = nil

-- Out-of-bounds checking
local oobCheckConnection: RBXScriptConnection? = nil
local lastOobCheck: number = 0

-- Shrink grace window
local lastShrinkTime: number = 0
local graceLoggedThisRound: boolean = false

-- Current round index (stored from OnRoundStart for elimination tracking)
local currentRound: number = 0

local MapManager = {}

--[[ HELPERS ]]

local function log(...)
	if Config.DebugLog then
		print("[MapManager]", ...)
	end
end

local function shrinkLog(...)
	if ShrinkConfig.DebugLog then
		print("[MapManager:Shrink]", ...)
	end
end

--[[
	Check if a world position is inside the active bounds.
]]
local function isPositionInsideBounds(worldPos: Vector3): boolean
	if not arenaCFrame then return true end
	
	-- Convert to local space relative to arena center
	local localPos = arenaCFrame:PointToObjectSpace(worldPos)
	
	local halfX = activeSizeX / 2
	local halfZ = activeSizeZ / 2
	
	return localPos.X >= -halfX and localPos.X <= halfX
		and localPos.Z >= -halfZ and localPos.Z <= halfZ
end

-- Storm particle creation delegated to shared StormFXConfig.CreateStormParticles()

--[[
	Create a single wall part for the storm boundary.
]]
local function createStormWall(name: string, parent: Instance): Part
	local wall = Instance.new("Part")
	wall.Name = name
	wall.Anchored = true
	wall.CanCollide = false
	wall.CastShadow = false
	wall.Material = Enum.Material.Neon  -- Glowing neon for visibility
	wall.Color = ShrinkConfig.BoundsColor
	wall.Transparency = ShrinkConfig.BoundsTransparency
	wall.Parent = parent
	
	-- Add particle effects (shared storm profile)
	StormFXConfig.CreateStormParticles(wall, 1)
	
	return wall
end

--[[
	Get or create the bounds folder.
]]
local function getBoundsFolder(): Folder
	if boundsFolder and boundsFolder.Parent then
		return boundsFolder
	end
	
	-- Get or create effects folder
	local effectsFolder = Workspace:FindFirstChild("ArenaEffects")
	if not effectsFolder then
		effectsFolder = Instance.new("Folder")
		effectsFolder.Name = "ArenaEffects"
		effectsFolder.Parent = Workspace
	end
	
	boundsFolder = effectsFolder:FindFirstChild("Bounds")
	if not boundsFolder then
		boundsFolder = Instance.new("Folder")
		boundsFolder.Name = "Bounds"
		boundsFolder.Parent = effectsFolder
	end
	
	return boundsFolder
end

--[[
	Create or update the storm boundary visuals.
]]
local function updateBoundsVisual()
	if not ShrinkConfig.ShowBoundsVisual then
		clearBoundsVisual()
		return
	end
	
	if not arenaCFrame or not arenaSize then return end
	
	local folder = getBoundsFolder()
	local wallThickness = 3
	local wallHeight = ShrinkConfig.BoundsHeight
	
	-- Create walls if needed (North, South, East, West)
	if #boundsWalls == 0 then
		table.insert(boundsWalls, createStormWall("StormWall_North", folder))
		table.insert(boundsWalls, createStormWall("StormWall_South", folder))
		table.insert(boundsWalls, createStormWall("StormWall_East", folder))
		table.insert(boundsWalls, createStormWall("StormWall_West", folder))
	end
	
	-- Create storm volume (faint vertical volume inside)
	if not stormVolume then
		stormVolume = Instance.new("Part")
		stormVolume.Name = "StormVolume"
		stormVolume.Anchored = true
		stormVolume.CanCollide = false
		stormVolume.CastShadow = false
		stormVolume.Material = Enum.Material.ForceField
		stormVolume.Color = ShrinkConfig.BoundsColor
		stormVolume.Transparency = 0.95 -- Very faint
		stormVolume.Parent = folder
	end
	
	-- Calculate positions
	local centerX = arenaCFrame.Position.X
	local centerZ = arenaCFrame.Position.Z
	local topY = arenaCFrame.Position.Y + arenaSize.Y / 2 + wallHeight / 2
	
	local halfSizeX = activeSizeX / 2
	local halfSizeZ = activeSizeZ / 2
	
	-- Update wall properties
	for _, wall in ipairs(boundsWalls) do
		wall.Color = ShrinkConfig.BoundsColor
		wall.Transparency = ShrinkConfig.BoundsTransparency
	end
	
	-- North wall (front, +Z)
	boundsWalls[1].Size = Vector3.new(activeSizeX + wallThickness * 2, wallHeight, wallThickness)
	boundsWalls[1].CFrame = CFrame.new(centerX, topY, centerZ + halfSizeZ + wallThickness / 2)
	
	-- South wall (back, -Z)
	boundsWalls[2].Size = Vector3.new(activeSizeX + wallThickness * 2, wallHeight, wallThickness)
	boundsWalls[2].CFrame = CFrame.new(centerX, topY, centerZ - halfSizeZ - wallThickness / 2)
	
	-- East wall (right, +X)
	boundsWalls[3].Size = Vector3.new(wallThickness, wallHeight, activeSizeZ)
	boundsWalls[3].CFrame = CFrame.new(centerX + halfSizeX + wallThickness / 2, topY, centerZ)
	
	-- West wall (left, -X)
	boundsWalls[4].Size = Vector3.new(wallThickness, wallHeight, activeSizeZ)
	boundsWalls[4].CFrame = CFrame.new(centerX - halfSizeX - wallThickness / 2, topY, centerZ)
	
	-- Update storm volume
	if stormVolume then
		stormVolume.Size = Vector3.new(activeSizeX, 0.1, activeSizeZ)
		stormVolume.CFrame = CFrame.new(centerX, topY + wallHeight / 2, centerZ)
		stormVolume.Transparency = 0.98
	end
end

local function clearBoundsVisual()
	for _, wall in ipairs(boundsWalls) do
		wall:Destroy()
	end
	boundsWalls = {}
	
	if stormVolume then
		stormVolume:Destroy()
		stormVolume = nil
	end
	
	if boundsFolder then
		boundsFolder:Destroy()
		boundsFolder = nil
	end
end

--[[
	Eliminate a player who is out of bounds.
]]
local function eliminateOutOfBounds(player: Player)
	if EliminationTracker.IsEliminated(player) then
		shrinkLog(string.format("[ElimSkip] player=%s skippedCause=Barrier reason=already_eliminated", player.Name))
		return
	end

	local character = player.Character
	if not character then return end
	
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid and humanoid.Health > 0 then
		humanoid.Health = 0
	end
	
	-- Record elimination BEFORE state change (so tracker sees them as InMatch)
	EliminationTracker.RecordElimination(player, currentRound, "OOB")
	
	-- Set to Lobby state
	PlayerStateService.SetState(player, PlayerState.States.Lobby)
	
	shrinkLog(string.format("Eliminated %s (OutOfBounds)", player.Name))
end

--[[
	Check all InMatch players for out-of-bounds violations.
	Respects post-shrink grace window (no instant kills after shrink).
]]
local function checkOutOfBounds()
	if not isActive then return end
	
	-- Grace window: skip OOB kills for a short time after each shrink
	if ShrinkConfig.OOBGraceSeconds > 0 and lastShrinkTime > 0 then
		local elapsed = os.clock() - lastShrinkTime
		if elapsed < ShrinkConfig.OOBGraceSeconds then
			-- Log once per grace window (avoid spam)
			if not graceLoggedThisRound then
				shrinkLog(string.format(
					"Grace active (%.1fs) — skipping OOB kills",
					ShrinkConfig.OOBGraceSeconds
				))
				graceLoggedThisRound = true
			end
			return
		else
			-- Grace expired → log once then resume normal OOB checking
			if graceLoggedThisRound then
				shrinkLog("Grace expired — OOB kills active")
				graceLoggedThisRound = false
			end
		end
	end
	
	local inMatchPlayers = PlayerStateService.GetPlayersInState(PlayerState.States.InMatch)
	
	for _, player in ipairs(inMatchPlayers) do
		local character = player.Character
		if not character then continue end
		
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if not humanoid or humanoid.Health <= 0 then continue end
		
		local rootPart = character:FindFirstChild("HumanoidRootPart")
		if not rootPart then continue end
		
		if not isPositionInsideBounds(rootPart.Position) then
			eliminateOutOfBounds(player)
		end
	end
end

--[[
	Start the out-of-bounds checking loop.
]]
local function startOobChecking()
	if oobCheckConnection then return end
	
	lastOobCheck = tick()
	
	oobCheckConnection = RunService.Heartbeat:Connect(function()
		local now = tick()
		if now - lastOobCheck >= Config.OutOfBoundsCheckInterval then
			lastOobCheck = now
			checkOutOfBounds()
		end
	end)
	
	log("Out-of-bounds checking started")
end

--[[
	Stop the out-of-bounds checking loop.
]]
local function stopOobChecking()
	if oobCheckConnection then
		oobCheckConnection:Disconnect()
		oobCheckConnection = nil
	end
	log("Out-of-bounds checking stopped")
end

--[[ PUBLIC API ]]

--[[
	Initialize the MapManager.
	Locates and validates the existing arena in Workspace.
]]
function MapManager.Init()
	if initialized then
		warn("[MapManager] Already initialized")
		return
	end
	
	-- Locate the arena
	local found = Workspace:FindFirstChild(Config.ArenaName)
	
	if not found then
		error(string.format("[MapManager] Arena '%s' not found in Workspace! Create it before running.", Config.ArenaName))
	end
	
	-- Get CFrame and Size
	if found:IsA("BasePart") then
		arenaCFrame = found.CFrame
		arenaSize = found.Size
	elseif found:IsA("Model") then
		local primary = found.PrimaryPart or found:FindFirstChildWhichIsA("BasePart")
		if primary then
			arenaCFrame = primary.CFrame
			arenaSize = primary.Size
		else
			error("[MapManager] Arena Model has no usable BasePart")
		end
	else
		error(string.format("[MapManager] Arena '%s' is not a BasePart or Model", Config.ArenaName))
	end
	
	arena = found
	initialized = true
	isActive = false
	
	-- Initialize active bounds to full size
	activeSizeX = arenaSize.X
	activeSizeZ = arenaSize.Z
	currentShrinkStep = 0
	
	log(string.format("Initialized — Arena '%s' registered (%s), Size: %.0fx%.0f", 
		Config.ArenaName, found.ClassName, arenaSize.X, arenaSize.Z))
end

--[[
	Get the arena reference.
]]
function MapManager.GetArena(): Instance?
	return arena
end

--[[
	Check if a match is currently active on the arena.
]]
function MapManager.IsActive(): boolean
	return isActive
end

--[[
	Check if a world position is inside the current active bounds.
]]
function MapManager.IsPositionInBounds(worldPos: Vector3): boolean
	return isPositionInsideBounds(worldPos)
end

--[[
	Called when a match starts (Playing phase begins).
	Resets bounds to full size and starts OOB checking.
]]
function MapManager.OnMatchStart()
	if not initialized then
		warn("[MapManager] Not initialized, cannot start match")
		return
	end
	
	isActive = true
	lastShrinkTime = 0 -- No shrink yet this match
	graceLoggedThisRound = false
	currentRound = 0
	
	-- Reset bounds at match start
	MapManager.ResetBounds()
	
	-- Show boundary visual immediately
	updateBoundsVisual()
	
	-- Start out-of-bounds checking
	startOobChecking()
	
	log("Match started — Arena active, OOB checking enabled")
end

--[[
	Called when a match ends.
	Stops OOB checking and clears visuals.
]]
function MapManager.OnMatchEnd()
	if not initialized then
		warn("[MapManager] Not initialized, cannot end match")
		return
	end
	
	isActive = false
	lastShrinkTime = 0
	graceLoggedThisRound = false
	
	-- Stop out-of-bounds checking
	stopOobChecking()
	
	clearBoundsVisual()
	log("Match ended — Arena idle")
end

--[[
	Called at the start of each round.
	Handles incremental shrinking with step cap + slowdown near MinBounds.
	Records shrink time for OOB grace window.
]]
function MapManager.OnRoundStart(roundIndex: number)
	if not initialized or not arenaSize then return end
	
	currentRound = roundIndex  -- Store for elimination tracking
	
	if not ShrinkConfig.Enabled then return end
	
	if roundIndex < ShrinkConfig.StartsAtRound then
		-- Update visual even if not shrinking yet
		updateBoundsVisual()
		return
	end
	
	-- Already at minimum? Nothing to do.
	local distToMinX = activeSizeX - ShrinkConfig.MinSizeX
	local distToMinZ = activeSizeZ - ShrinkConfig.MinSizeZ
	local distToMin = math.min(distToMinX, distToMinZ)
	
	if distToMin <= 0 then
		updateBoundsVisual()
		return
	end
	
	-- Calculate this round's step (incremental, not cumulative)
	local n = roundIndex - ShrinkConfig.StartsAtRound + 1
	local rawStep = ShrinkConfig.BaseStepStuds + (n - 1) * ShrinkConfig.StepGrowthStuds
	local thisStep = rawStep
	
	-- B4a: Cap to MaxStep
	thisStep = math.min(thisStep, ShrinkConfig.MaxStepStuds)
	
	-- B4b: Slowdown near MinBounds (scale factor clamped to [0.2, 1.0] — never zero)
	if distToMin > 0 and distToMin < ShrinkConfig.SlowdownNearMinStuds then
		local scale = math.clamp(distToMin / ShrinkConfig.SlowdownNearMinStuds, 0.2, 1.0)
		thisStep = thisStep * scale
	end
	
	-- Apply (clamp to MinBounds, no overshoot)
	local newSizeX = math.max(activeSizeX - thisStep, ShrinkConfig.MinSizeX)
	local newSizeZ = math.max(activeSizeZ - thisStep, ShrinkConfig.MinSizeZ)
	
	-- Only update + log if size actually changed
	if newSizeX ~= activeSizeX or newSizeZ ~= activeSizeZ then
		activeSizeX = newSizeX
		activeSizeZ = newSizeZ
		currentShrinkStep = n
		
		-- Record shrink time for OOB grace window
		lastShrinkTime = os.clock()
		graceLoggedThisRound = false
		
		shrinkLog(string.format(
			"Round %d shrink: step #%d = %.1f studs (raw %.0f, cap %.0f, distToMin was %.0f), bounds now %.0fx%.0f (min %.0fx%.0f)",
			roundIndex, n, thisStep, rawStep, ShrinkConfig.MaxStepStuds,
			distToMin, activeSizeX, activeSizeZ,
			ShrinkConfig.MinSizeX, ShrinkConfig.MinSizeZ
		))
	end
	
	updateBoundsVisual()
end

--[[
	Reset active bounds to full arena size.
]]
function MapManager.ResetBounds()
	if not arenaSize then return end
	
	activeSizeX = arenaSize.X
	activeSizeZ = arenaSize.Z
	currentShrinkStep = 0
	
	shrinkLog(string.format("Bounds reset to full size: %.0fx%.0f", activeSizeX, activeSizeZ))
end

--[[
	Get the current active bounds.
	Used by HazardManager to compute grid within shrunken area.
]]
function MapManager.GetActiveBounds(): { cframe: CFrame, sizeX: number, sizeZ: number, topY: number }?
	if not initialized or not arenaCFrame or not arenaSize then
		return nil
	end
	
	return {
		cframe = arenaCFrame,
		sizeX = activeSizeX,
		sizeZ = activeSizeZ,
		topY = arenaCFrame.Position.Y + arenaSize.Y / 2,
	}
end

--[[
	Get the base (full) arena bounds.
	Used for reference.
]]
function MapManager.GetBaseBounds(): { cframe: CFrame, size: Vector3 }?
	if not initialized or not arenaCFrame or not arenaSize then
		return nil
	end
	
	return {
		cframe = arenaCFrame,
		size = arenaSize,
	}
end

--[[
	Get spawn CFrames on the arena surface.
	Uses ACTIVE bounds (shrunk area) for spawning.
]]
function MapManager.GetArenaSpawnCFrames(count: number): { CFrame }
	if not initialized or not arenaCFrame or not arenaSize then
		warn("[MapManager] Not initialized, cannot get spawn CFrames")
		return {}
	end
	
	local spawns: { CFrame } = {}
	local yOffset = SpawnConfig.ArenaSpawnYOffset
	
	-- Use active bounds for spread
	local spreadRadius = math.min(
		SpawnConfig.ArenaSpawnSpreadRadius, 
		activeSizeX / 2 - 5, 
		activeSizeZ / 2 - 5
	)
	
	-- Top surface Y position
	local topY = arenaCFrame.Position.Y + arenaSize.Y / 2 + yOffset
	
	-- Generate spread spawn points
	for i = 1, count do
		local angle = (i / count) * math.pi * 2 + math.random() * 0.5
		local radius = spreadRadius * (0.3 + math.random() * 0.7)
		
		local offsetX = math.cos(angle) * radius
		local offsetZ = math.sin(angle) * radius
		
		local spawnPos = Vector3.new(
			arenaCFrame.Position.X + offsetX,
			topY,
			arenaCFrame.Position.Z + offsetZ
		)
		
		-- Face toward center
		local lookAt = Vector3.new(arenaCFrame.Position.X, topY, arenaCFrame.Position.Z)
		local spawnCFrame = CFrame.lookAt(spawnPos, lookAt)
		
		table.insert(spawns, spawnCFrame)
	end
	
	return spawns
end

--[[
	Get the lobby spawn CFrame.
	Prefers SpawnLocation in Workspace, falls back to config.
]]
function MapManager.GetLobbySpawnCFrame(): CFrame
	-- Try to find SpawnLocation in Workspace
	local spawnLocation = Workspace:FindFirstChildOfClass("SpawnLocation", true)
	
	-- Also check Lobby folder
	local lobbyFolder = Workspace:FindFirstChild("Lobby")
	if lobbyFolder then
		local lobbySpawn = lobbyFolder:FindFirstChildOfClass("SpawnLocation")
		if lobbySpawn then
			spawnLocation = lobbySpawn
		end
	end
	
	if spawnLocation then
		-- Spawn slightly above the SpawnLocation
		local pos = spawnLocation.Position + Vector3.new(0, 3, 0)
		return CFrame.new(pos)
	end
	
	-- Fallback to config
	return CFrame.new(SpawnConfig.LobbySpawnPosition)
end

return MapManager
]]></string>
